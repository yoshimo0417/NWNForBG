@97681 = ~“他的梦形成了我信仰的原则，使我和我的朝圣者们更接近我们的教化。通过他的梦境，我了解到了沉睡者的五个秘密……”~
@97682 = ~“他是谁？他从哪里来？他为什么离开？他在寻找谁？答案是什么？……所有想看到沉睡者的人必须先解开这五个秘密。”~
@97683 = ~“这个传说是从何处开始，又会到哪里结束呢？这无数的位面都是变化无穷的。这些都无法形容；他们肯定是活着的。”~
@97684 = ~“我出身的修道院位于混沌海，它漂浮在一个水球中，而水球绕着一个不断变化的大石块运转，石块上有着无尽生死往复着的森林。有什么词语能够清楚地描绘出来呢？”~
@97685 = ~“为什么我们这些人要远离家乡旅行到这里来？我想这可能就是沉睡者的第三个秘密。你必须要亲自来解答。”~
@97686 = ~“就像卡尼亚是许多魔鬼的家乡一样，它也是许多天使的家乡，比如从低阶的神使到强大的使徒、异界神侍乃至炽天神侍。”~
@97687 = ~“来自许多地方。有人说天使们就在我们的身边，即使在这个地方也有。而沉睡者来自哪里，是他的第二个秘密，你必须亲自解开它。”~
@97688 = ~“在新来的朝圣者能够看到沉睡者之前，他们必须要解开他的五个秘密：他是谁？他从哪里来？他为什么离开？他在寻找谁？答案是什么？”~
@97689 = ~“所有来看沉睡者的人，都可以说是生命旅程上的朝圣者。像他一样，我们在位面间旅行，不停地寻求解答。像他一样，我们总有一天会找到的。”~
@97690 = ~“那有无数条道路：法术，入口，漩涡，雾气和阴影间的转换。不过并不是在所有的地方都适用。在卡尼亚这个地方，只有两条道：传送门和冥河分支。”~
@97691 = ~“只要和收割者进行了绑定，传送门就可以通到任何地方。但是冥河分支一直往下流，通到巴托地狱的第九重，也就是最后一层——奈瑟斯。我没去过那里，也不想去那里。”~
@97692 = ~“我不能说，那超出界限了，就像靡菲斯特用真名把他和你的意志绑定在一起那样。也许沉睡者以前知道。但是当他梦到了答案的时候，我和我的朝圣者们已经被困在这里了，就像你一样。”~
@97693 = ~“沉睡者会梦见许多事情，这时，我就能看见在他思想表面上浮现着的那些梦境。对于他的秘密，我大多数是通过梦境了解到的。”~
@97694 = ~“他的梦形成了我信仰的原则，使我和我的朝圣者们更接近我们的教化。通过他的梦境，我了解到了沉睡者的五个秘密……”~
@97695 = ~“他是谁？他从哪里来？他为什么离开？他在寻找谁？答案是什么？……所有想看到沉睡者的人必须先解开这五个秘密。”~
@97696 = ~“这个传说是从何处开始，又会到哪里结束呢？这无数的位面都是变化无穷的。这些都无法形容；他们肯定是活着的。”~
@97697 = ~“我在边境位面的修道院漂浮在一个水球里，围绕着一个永不变化的大石头转动，石头上面是一个生生不息永不衰败的森林。怎么才能说得更简单一些？”~
@97698 = ~“曾经，很久以前，我们也差不多是人类。夺心魔建立了一个横跨所有位面的帝国。在他们的邪恶统治下，我们被奴役了无数个世纪。”~
@97699 = ~“逐渐地，我们适应了。我们的皮肤由于缺乏阳光而变得灰白还带有斑点，由于饱受毒打而变得坚硬。他们捕获了我们的心智并加以培养。久而久之，我们的心智也和他们的一样了。”~
@97700 = ~“慢慢地，我们学会了如何保护自己反抗他们的精神探测，并因此出现了一些由逃跑奴隶组成的小据点。一个叫吉斯的英雄站了出来并最终推翻了统治者的压迫。”~
@97701 = ~“同我们的兄弟们一起，吉斯彦克人，许多世代过去了，我们是起义者的子孙。吉斯彦克人同我们出现了一条裂缝，但那个故事我们等其他时间再讲。”~
@97702 = ~“吉斯彦克人占据了星界位面的多数地区，而我们修道院的吉斯泽莱人占据了混沌海位面。但是仍然有一些人，例如我自己，仍然在各处旅行。”~
@97703 = ~“有各种各样的方式：魔法，传送门，旋涡，烟雾或阴影。然而，并不是所有的方式都能在各种地方使用。在卡尼亚这里，只能通过大门和斯特克斯河的支流旅行。”~
@97704 = ~“大门几乎能通向任何地方，它提供了可以接受你出价的收割者。然而，斯特克斯河的支流，只能向下流淌到奈瑟斯，巴托的第九及最后一层。我从来没去过那里，也不打算去。”~
@97705 = ~“除了使用他的真名来让他服从你的意愿——就像靡菲斯特做的那样，我也不知道还有什么其他方法。也许沉睡者会知道。直到他能梦见答案为止，我的朝圣者和我都要被困在这里，像你现在一样。”~
@97706 = ~“沉睡者会梦到很多事情。当他做梦的时候，那些梦就会在他思想的表面上跳舞，从而可以让我看到。他的大多数谜语我都是从他的梦里获得的。”~
@97707 = ~“他的梦构成了我信心的原则，给我和我的朝圣者以启迪。通过他的梦我得以知道沉睡者的五个谜语……”~
@97708 = ~“他是谁？他从那里来？他为什么要走？他在找谁？答案是什么？……所有想看到沉睡者的人都必须获知五个谜语。”~
@97709 = ~“这个传说从那里开始到那里结束？位面就像它们的数量一样变化无穷。它们无法被描述；它们必须存在。”~
@97710 = ~“我在边境位面的修道院漂浮在一个水球里，围绕着一个永不变化的大石头转动，石头上面是一个生生不息永不衰败的森林。怎么才能说得更简单一些？”~
@97711 = ~“作为心智、肉体及灵魂的大师，我们的导师领导我们这些追随的吉斯泽莱人一起去追寻无尽的智慧，一起打败我们的敌人。在你们的语言中，我们被翻译成武僧，但是有很多东西都在翻译的时候被丢掉了。”~
@97712 = ~“我们吉斯泽莱人为了和平而反抗。在寻求和平的过程中我们从其他种族中分裂出来。”~
@97713 = ~“我们的兄弟们，吉斯彦克人，继续在猎杀我们，然而，我们还没有宽恕曾经奴役我们的夺心魔。也许是我们的敌人使我们变成了现在这样。”~
@97714 = ~“我们用来叫自己的名字只是很简单的事情，像风一样变化，像写在你的眉毛上让所有人都能看见。秘密藏在内心的名字上，真正的名字，刻在我们心中的名字。”~
@97715 = ~“知道一个人的真名就要知道一个人的自我。找到一个人就是要找到其他人。也许这就是沉睡者给你的答案。”~
@97716 = ~“在你的眉毛上，在你的每一个想法中，阅读你大脑中的每个活动。我是吉斯泽莱导师。我毕生都在训练自己来阅读我面前的那些人的思想。”~
@97717 = ~“很高兴可以看到一个那么具有好奇心的心灵。就像沉睡者教的那样，在你找到答案前，你必须要不停地询问。你现在想要知道什么？”~
@97718 = ~“曾经，很久以前，我们也差不多是人类。夺心魔建立了一个横跨所有位面的帝国。在他们的邪恶统治下，我们被奴役了无数个世纪。”~
@97719 = ~“逐渐地，我们适应了。我们的皮肤由于缺乏阳光而变得灰白还带有斑点，由于饱受毒打而变得坚硬。他们捕获了我们的心智并加以培养。久而久之，我们的心智也和他们的一样了。”~
@97720 = ~“慢慢地，我们学会了如何保护自己反抗他们的精神探测，并因此出现了一些由逃跑奴隶组成的小据点。一个叫吉斯的英雄站了出来并最终推翻了统治者的压迫。”~
@97721 = ~“同我们的兄弟们一起，吉斯彦克人，许多世代过去了，我们是起义者的子孙。吉斯彦克人同我们出现了一条裂缝，但那个故事我们等其他时间再讲。”~
@97722 = ~“吉斯彦克人占据了星界位面的多数地区，而我们修道院的吉斯泽莱人占据了混沌海位面。但是仍然有一些人，例如我自己，仍然在各处旅行。”~
@97723 = ~“有各种各样的方式：魔法，传送门，旋涡，烟雾或阴影。然而，并不是所有的方式都能在各种地方使用。在卡尼亚这里，只能通过大门和斯特克斯河的支流旅行。”~
@97724 = ~“大门几乎能通向任何地方，它提供了可以接受你出价的收割者。然而，斯特克斯河的支流，只能向下流淌到奈瑟斯，那是巴托的第九，也是最后一层。我从来没去过那里，也不打算去。”~
@97725 = ~“除了使用他的真名来让他服从你的意愿——就像靡菲斯特做的那样，我也不知道还有什么其他方法。也许沉睡者会知道。直到他能梦见答案为止，我的朝圣者和我都要被困在这里，像你一样。”~
@97726 = ~“沉睡者会梦到很多事情。当他做梦的时候，那些梦就会在他思想的表面上跳舞，从而可以让我看到。他的大多数谜语我都是从他的梦里获得的。”~
@97727 = ~“他的梦构成了我信心的原则，给我和我的朝圣者以启迪。通过他的梦我得以知道沉睡者的五个谜语……”~
@97728 = ~“他是谁？他从那里来？他为什么要走？他在找谁？答案是什么？……所有想看到沉睡者的人都必须获知五个谜语。”~
@97729 = ~“非常好。让我看看你准备好了没有……回答我，朝圣者：谁是沉睡者？”~
@97730 = ~“是的，这是一个没有任何骄傲、恶行或复仇痕迹的纯洁的灵魂。跟随他，我们接受他的善举……现在回答我，朝圣者：他从那儿来？”~
@97731 = ~“确实是这样的。极乐境是一个美丽和平完美的地方，然而他却转身离开了那里再没有回来，而选择在位面间流浪……那么告诉我，朝圣者：他为什么要离开？”~
@97732 = ~“他知道没有了激情我们活着毫无意义，因此他要旅行这么多年来寻找他的真爱。他的旅行让他来到了这里，卡尼亚的冰冻荒地……回答我，朝圣者：他在找谁？”~
@97733 = ~“在巴特祖将这个地方作为他们的地狱以前智者一直统治着这个位面。智慧的沉睡者一直在询问那里才能找到他的真爱……告诉我，朝圣者：答案是什么？”~
@97734 = ~“对不起，但是很显然你还没有准备好进入他休息的房间。花些时间仔细考虑一下他的五个谜语再到我这儿来。就像沉睡者传授的那样，为某些事等待是值得的。”~
@97735 = ~“因此他回到了这里-大门，坚信她肯定能找到他。由于旅途的疲倦，他睡着了。那已经是很久，很久以前的事了，但是他现在依然在这里等着，梦想着他的真爱。”~
@97736 = ~“你已经掌握了沉睡者的五个谜语，朝圣者。在你进入他的房间后，将这个护身符套在你的脖子上……这可以帮助你看到他的梦境。”~
@97737 = ~“很高兴可以看到一个那么具有好奇心的心灵。就像沉睡者教的那样，在你找到答案前，你必须要不停地询问。你现在想要知道什么？”~
@97738 = ~“这个传说从那里开始到那里结束？位面就像它们的数量一样变化无穷。它们无法被描述；它们必须存在。”~
@97739 = ~“我在边境位面的修道院漂浮在一个水球里，围绕着一个永不变化的大石头转动，石头上面是一个生生不息永不衰败的森林。怎么才能说得更简单一些？”~
@97740 = ~“作为心智、肉体及灵魂的大师，我们的导师领导我们这些追随的吉斯泽莱人一起去追寻无尽的智慧，一起打败我们的敌人。在你们的语言中，我们被翻译作和尚，但是有很多东西都在翻译的时候被丢掉了。”~
@97741 = ~“我们吉斯泽莱人为了和平而反抗。在寻求和平的过程中我们同其他人分裂出来。”~
@97742 = ~“我们的兄弟们，吉斯彦克人，继续在猎杀我们，然而，我们还没有宽恕曾经奴役我们的夺心魔。也许是我们的敌人使我们变成了现在这样。”~
@97743 = ~“你的心灵就像某种巨大的图书馆一样。我的才能可以让我的手指沿着书脊滑动。我可以阅读他们的标题并猜测他们的内容，但是我永远无法将他们拿下来彻底地阅读。”~
@97744 = ~“尽管有着诸多限制，这种才能使我可以一个标题接着一个标题，一个书脊接着一个书脊地了解沉睡者神秘的智慧，并用来了解他的梦境。”~
@97745 = ~你感到导师的心智在探测你自己，询问你的意图。如果你要撬开这把锁，你将不得不等到她的注意力转移到其他地方才行。~
@97746 = ~你又感到熟悉的导师心智的探测。她带着热切的微笑欢迎你回来。~
@97747 = ~“欢迎回来，朝圣者。沉睡者已经梦见你了。”~
@97748 = ~“太好了！你已经为我们打开了大门。我们可以通过这些门回到在边境位面的家了。我的朝圣者们现在都在传诵这件事。现在我们就要为我们即将踏上的返回家园的漫漫旅程向你说一声再见。”~
@97749 = ~“谢谢你，<CHARNAME>，为你所做的一切。我很满意在这个寺庙度过的这段时间，现在我要领导我的人民返回家园了。”~
@97750 = ~“他曾经梦见过你面对一个深埋在雪中的一个时钟。在冰冷的寒风中，你旁边恶魔与魔鬼之间的血战也已经渐渐平息了，战争的怒火已经完全消失了。”~
@97751 = ~“我仍然在试着判断这到底是什么意思，<CHARNAME>。他看上去很为你做的而自豪。”~
@97752 = ~“你已经？为什么，这是个奇迹……沉睡者的梦境变成了现实，他的预言实现了。快，你必须告诉我他是谁。”~
@97753 = ~“但是他唯一的真爱！为什么你不告诉我？我们中的人，也许甚至是我自己……如果我们能被爱的话，我们就能得到解救。如果天使们只能怜悯我们的话，那信心也是无用的……我不知道……”~
@97754 = ~“一个天使……我曾经希望那会是个人类。”~
@97755 = ~被靡菲斯特囚禁的那个人参加了莫里科洛斯起义？他曾经问到她被囚禁的地方，但是，他并没有意识到她就是他曾经的爱人，反而问到他的爱人在那里才能找到他！”~
@97756 = ~“诸界智者？为什么，她就是那个曾经告诉他在这里等待他的爱人的那个人。多么奇怪啊……他要为一个他已经认识的女人而在这里等待那么长的时间。”~
@97757 = ~“娜西拉？我简直无法相信！即使在梦里我也不敢相信在我还活着的时候爱情就已经降临到他身上了。在你的团队中有这么一个重要的伙伴你一定感到非常荣幸吧。”~
@97758 = ~“艾瑞贝丝？我简直无法相信！即使在梦里我也不敢相信在我还活着的时候爱情就已经降临到他身上了。能认识她真是太让我感到荣幸了。”~
@97759 = ~“对不起，我必须马上离开这里并考虑这件事的重要性。请将这个寺庙看作自己的家一样，我不会很快就能回来的。”~
@97760 = ~“艾瑞贝丝女士？灵魂？不，这怎么可能？她来这里学习了他的五个谜语，她看他睡觉！但是她随即成为了一个失落的……他的真爱永远地离开了……”~
@97761 = ~“我必须马上离开这里并考虑这件事的重要性，<CHARNAME>。他相信他的爱人会找到他并一起享受美好的生活。我的信心全都在他身上！如果他错了……”~
@97762 = ~“你，<CHARNAME>？我简直无法相信！即使在梦里我也不敢相信在我还活着的时候爱情就已经降临到他身上了。能见到你真是太让我感到荣幸了。”~
@97763 = ~“但是经过这么长时间的旅行你一定已经很疲惫了，而且也因为可以和爱人接近而感到兴奋。我现在要离开了，好让你们两个可以单独呆会儿。”~
@97764 = ~“不，不要告诉我，我不想知道。知道后就要面对使用它的诱惑，而使用后他的纯洁的意志就要被我不纯洁的意志而玷污。求你了，这是一个你必须要带到坟墓去的秘密。”~
@97765 = ~“如果那就是你想要的，朝圣者……”~
@97766 = ~“我很高兴你恢复理智了。我不知道你知道多少个其他的真名，但是我求你只使用你必须使用的那些。剩下的，你一定不能告诉任何一个灵魂……请带我到沉睡者那去吧。”~
@97767 = ~“谢谢你，<CHARNAME>。你比我想像的更富有智慧。现在，请让我和沉睡者呆在一起吧。”~
@97768 = ~“诅咒你，<CHARNAME>，我不想拥有那种力量。现在我必须带他一起到坟墓中去。我只能祷告我的意愿可以强到阻止我使用这种力量。现在，请让我和沉睡者呆在一起吧。”~
@97769 = ~“我相信我们都有权利决定我们自己的命运，<CHARNAME>。用某人的真名来反抗他们的做法亵渎了这种权利…… 收割者已经用他的真名来反抗他了。”~
@97770 = ~“在这种情况下，有时候你必须使用他的真名来解决问题。但是请注意不要越过这条模糊的界限，否则你就会变得和那个与你搏斗的魔鬼一模一样。”~
@97771 = ~“我……我的真名。我可以感觉到它……但是被误导了？不，不可能！请告诉我这不是真的……我的全部生命都建立在我对沉睡者的信心上。求你了，<CHARNAME>，作为一个朋友……”~
@97772 = ~导师似乎很高兴话题转移了。~
@97773 = ~“他的真爱？我就是他等的那个人？哦，我真傻，<CHARNAME>！我浪费了这么多年……不，我这么多年对他的爱没有浪费，但是尽管这样……我必须弄醒他，我必须……”~
@97774 = ~“与那个傻瓜一起？非常好，如果那就是你要我做的，那等你一走我就会做的。他的意图是好的但是他必须要意识到不是所有的事都能开玩笑的。还有什么事吗？”~
@97775 = ~“如何，<CHARNAME>？告诉我应该如何做。告诉我你是如何对我做的！没有信心，没有他，我一无所有……但是你让我毫无选择……永别了，<CHARNAME>，永别了我沉睡的爱人……”~
@97776 = ~“不！我的爱人！你怎么能这么对我们！我会找到她的，一定会的！”~
@97777 = ~“不，<CHARNAME>。不能打扰他……这没有用，不是吗？你对我下了命令因此我必须……非常好，尽管我想不出还有什么能比你让我做的事更恶毒了。”~
@97778 = ~在她走向沉睡者的时候，你能感到有一股能量流过你的心灵。她的眼泪像泪珠一样掉到他的脸颊上，她向他的耳边轻声说了什么，然后他就醒了。~
@97779 = ~“你们是谁？你们两个……我曾经在梦中见过你们……为什么你要叫醒我，女人？”~
@97780 = ~“很抱歉，我的主人，如果我能选择的话，你还要继续休息下去……但是那边的<MANWOMAN>控制了我，强迫我做违反我意愿的事。”~
@97781 = ~“这是个什么恶魔？用天界的力量，将这个女人从你那什么邪恶魔法中释放出来吧！”~
@97782 = ~“但是……但是我的主人，我是你唯一的真爱……<CHARNAME>，众名智者已经来了并发誓说这都是真的！”~
@97783 = ~“这是多么恶毒的谎言啊！？别让我看见你，女人！你不再是我的爱人了。你面前的<CHARNAME>告诉了我全部真相！”~
@97784 = ~导师眼睛里充满着泪水跑开了。沉睡者愤怒地瞪着你。“你去死吧。魔鬼……”~
@97785 = ~“就是你……我……我曾经在梦中见过你！我的爱人，我真正爱的人，你终于在卡尼亚之门旁找到了我……”~
@97786 = ~“你唯一真正爱的人？”~
@97787 = ~“没……没有关系吧，如果我那么叫你？”~
@97788 = ~“是的，我——有太多话想说了……是的，是的，一千个是的！除此之外我已经再无所求了，我的爱人，我的信徒，我的朝圣者，他们……他们需要我。”~
@97789 = ~“信徒能找到回去的路，我的爱人。他们有他们自己的生活。你也要有你自己的……”~
@97790 = ~一个女性吉斯泽莱导师（像僧侣一样的精神领导者）率领着城中的朝圣者们。可以在沉睡者的寺庙中找到他。~
@97791 = ~“当然，导师。”~
@97792 = ~“对不起，我好像把你给我的那个护身符给弄丢了。”~
@97793 = ~“如何才能使用你给我的那个护身符呢？”~
@97794 = ~“谢谢，导师。”~
@97795 = ~“你知道收割者的真名吗？”~
@97796 = ~“五个谜语？是什么东西？”~
@97797 = ~“你说的朝圣之旅是什么意思？”~
@97798 = ~“我们如何才能从一个位面旅行到另一个位面？”~
@97799 = ~“他们要到那儿去？”~
@97800 = ~“我如何才能让收割者听从我的命令？”~
@97801 = ~“你这句话是什么意思‘直到他梦见答案’？”~
@97802 = ~“你从他那学到了什么？”~
@97803 = ~“你能告诉我有关位面的什么信息？”~
@97804 = ~“我需要找到一条可以回家的路。”~
@97805 = ~“跟我说说这个沉睡者。~
@97806 = ~“还是问些其他问题吧。”~
@97807 = ~“你是怎么知道他这件事的全部经过的？”~
@97808 = ~“还是问些其他问题吧。”~
@97809 = ~“吉斯泽莱人是谁？”~
