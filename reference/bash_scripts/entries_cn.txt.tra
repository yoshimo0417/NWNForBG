@100764 = ~h4a_port_2_city~
@100765 = ~卡尼亚荒地深处~
@100766 = ~靡菲斯特开始~
@100767 = ~453_452~
@100768 = ~456_454~
@100769 = ~449_451~
@100770 = ~455_454~
@100771 = ~455_450~
@100772 = ~458_450~
@100773 = ~457_450~
@100774 = ~看起来你无法通过闪电障碍。~
@100775 = ~目标已经有这个影响！~
@100776 = ~这个东西不能给莱佛拉。~
@100777 = ~幽城魔影：第一章~
@100778 = ~幽城魔影：第二章~
@100779 = ~幽城魔影：第三章~
@100780 = ~奇怪的石堆~
@100781 = ~石堆在这里看起来很奇怪——似乎是别人故意堆起来的。~
@100782 = ~“在这里要小心说话。在立特米亚撒和先知的追随者以及麦维尔家族的卓尔之间存在着某种紧张的情绪。”~
@100783 = ~“小心点。我们正在进入幽暗地域的深处。”~
@100784 = ~“这里的黑暗经常充满了看不见的危险。当心那些影子。”~
@100785 = ~“瓦纱瑞丝有很多盟友，但是只要一看到她虚弱的迹象他们就会背弃它。这就是幽暗地域的处事方式。”~
@100786 = ~“那些住在托瑞尔地表的人们害怕卓尔，比我的人们在这里还要糟糕。”~
@100787 = ~“幽暗地域没有季节；没有黑夜白昼的循环。我看到的只是无尽的黑暗……真舒服。”~
@100788 = ~“在幽暗地域，你不是猎人就是猎物。不过通常你都是后者。”~
@100789 = ~“至少得说，那是一座壮丽的要塞。我怀疑里面的人看到我们可不会高兴。”~
@100790 = ~“这地方有点邪恶；闻起来有古代邪恶的气味。”~
@100791 = ~“看来卓尔不是唯一喜欢把奴隶投入深坑让他们互相战斗的种族。”~
@100792 = ~“你能感到吗？一股压力正在突破头骨的保护。注意保卫你的思想。”~
@100793 = ~“眼魔一定靠近了……我不相信她没有防卫。”~
@100794 = ~“这里的臭烟和灰都要让人吐出来了！”~
@100795 = ~“当心这个女人。我怀疑她比看起来复杂的多。”~
@100796 = ~“毫无疑问前面有很多陷阱和怪物……任何法师的城堡都一样。”~
@100797 = ~“一个没有观众的小丑……这个城市里还有什么有意义的东西吗？”~
@100798 = ~“城市消失了！难以想像让整个城镇消失的力量！”~
@100799 = ~“附近有灰矮人。空气中尽是他们的臭汗味。”~
@100800 = ~“这些傀儡和我以前见的都不一样！”~
@100801 = ~“当心。那些希望延长自己生命的法师经常把他们自己变成强大的不死生物。”~
@100802 = ~“这的寒冷可以冻结住你的思想。”~
@100803 = ~“即便在这里，你也能感到火焰的热。我们靠近些暖和一下吧。”~
@100804 = ~“我没想到这里还能如此温暖。”~
@100805 = ~“看那儿——一个女人，冻在了冰里。不，等一下……我想她是个精灵。”~
@100806 = ~“地狱里的小丑？好，我想如果有人需要被逗乐，看来就是这里被困的灵魂了。”~
@100807 = ~“一个拟态怪……但它看起来并不想进行攻击。似乎只是对发光的宝石感兴趣。”~
@100808 = ~“我没有看到桥。我们得找个办法渡过这条火焰之河。”~
@100809 = ~“一扇……闪电组成的门？看起来像是个陷阱——或者是测试。这些控制杆一定是关键。”~
@100810 = ~“瓦纱瑞丝直到她控制整个托瑞尔才会停手的。”~
@100811 = ~“先知相信你能把我们从瓦纱瑞丝那里拯救出来。我祈祷她是对的。”~
@100812 = ~“瓦纱瑞丝会派出她的刺客来追杀我们，但是我了解他们所有的伎俩。”~
@100813 = ~“幽暗地域的生物不会发出任何警告再开始攻击……我也一样。”~
@100814 = ~“先知看到了我们失利时的未来。瓦纱瑞丝会把整个托瑞尔都踏个粉碎。”~
@100815 = ~“我们卓尔在托瑞尔地面上并不受欢迎。先知告诉我即便是伊丽思璀的追随者都要面对迫害和偏见。”~
@100816 = ~“很容易就能擦去匕首边缘的鲜血，但是从手上擦去可没有那么容易了。”~
@100817 = ~“我很少用毒药来对付人；我宁愿用利刃或者魔法；这看起来更干净、更纯净。”~
@100818 = ~“我被教育要一直让我的利刃保持锋利，随时准备释放魔法。老兔子可不容易死。”~
@100819 = ~“一个聪明的法师知道释放魔法的时机和释放魔法的种类一样重要。战前的准备是战斗的关键所在。”~
@100820 = ~“作为一个刺客，我接受的训练就是杀人。这种杀戮在这个地方对我们很有帮助。”~
@100821 = ~“先知说托瑞尔的地面非常美丽。我希望有一天能亲自看看。”~
@100822 = ~“随时保持警惕，随后握紧利刃。那就是我作为刺客的座右铭，它也帮了我很多忙。”~
@100823 = ~“伊丽思璀是月光女神。我真想有一天可以来到托瑞尔的地面，亲眼看看月亮。”~
@100824 = ~“小心点。只要有脚步声，他们就会警告别人。”~
@100825 = ~“Vith usstan!我的背包乱成了一团！我的魔法物品混在一块了。唉，下次停下来的时候我又得给它们分类了。”~
@100826 = ~“停一下。我看到有些东西可以作为我魔法的物品……那儿呢。继续走吧。”~
@100827 = ~“如果你希望我在战斗前释放魔法，告诉我一下。”~
@100828 = ~“我知道的是人只能通过征服来生存；杀人或是被杀。现在它对我们很适用。”~
@100829 = ~“唉，我担心前面还有很多杀戮，我的心因为成千上万的屠杀而玷污了。”~
@100830 = ~“当我还是个孩子的时候我就杀了第一个人；一个惹我不高兴的男奴。我不知道他的名字。我也不知道我为什么到现在还会记得他？”~
@100831 = ~“当那些受害者死在我面前的时候，我总是看着他们的眼睛。那些眼睛烙印在我心里，直到现在都让我无法忘怀。”~
@100832 = ~“刺客必须无形，即便在明白的目光之下。那就是我很快掌握的教训……还要部分归功于我的魔法。”~
@100833 = ~“移动小心点。突然可以帮你赢得战斗；我们必须小心不让人发现。”~
@100834 = ~“我看这里处处都是发起对我们伏击的地方。我们在这里太容易受到攻击了，我们必须做好一切准备。”~
@100835 = ~“我有些感觉我属于这里；一个注定被宣判到这个地狱的灵魂。”~
@100836 = ~“我怜悯那些被困在这里的人。他们求生不得求死不能，没有逃脱的希望。”~
@100837 = ~“瓦纱瑞丝被打败了，但是现在我们在托瑞尔释放了更可怕的东西了。”~
@100838 = ~“靡菲斯特愚弄了我们！我们得找到办法来阻止他，我们必须做到！”~
@100839 = ~“卓尔要多糟有多糟了，托瑞尔的地面世界在魔鬼的统治下会更加可怕。”~
@100840 = ~<DEATH SCREAM AS HER SOUL IS RIPPED APART>~
@100841 = ~“你要和先知谈谈。相信我，她能解释所有东西。”~
@100842 = ~“那么现在你了解了一切……瓦纱瑞丝，我们是谁，为什么我们来这里，所有的一切。我们在这里要做的事情非常重要。”~
@100843 = ~“还有什么别的需要吗，<CHARNAME>？”~
@100844 = ~“当然，先知。”娜西拉点头表示接受，然后走上前开始说话。~
@100845 = ~“卓尔曾经在主母统治之下，她们是大家族的首领。瓦沙瑞斯是一个家族的主母，残忍而强大，但并不比其他的主母强多少。”~
@100846 = ~“但是罗丝，蜘蛛女王和卓尔的神，消失了……卓尔的社会陷入了全面的混乱。瓦纱瑞丝通过这个机会获取了权力。”~
@100847 = ~“一旦幽暗地域归于她的名下，她就把注意力转移到了地面。她认为自己是女王……用我们的话说就是瓦纱瑞丝……她的野心无穷无尽。”~
@100848 = ~“罗丝女祭司在她面前无能为力，卓尔大家族卑躬屈膝，像其他幽暗地域的种族一样被迫加入了她的队伍。”~
@100849 = ~“目前你阻止了她在山下地城的计划，但是她还会找到其他办法的。平静不会持续太久，但至少你给我们带来了一点喘息的时间。”~
@100850 = ~“不久之前，她奴役的魔鬼告诉她，有一个人会击败她。她命令进行一次占卜，而你的样子出现在了她的面前。”~
@100851 = ~“我……我不相信你。我还是不信。尽管先知预言了你的到来，但并不意味着我们对你有所了解。我必须谨慎。”~
@100852 = ~“而且我不知道海拉斯特会对你下诅咒或者把我们送下来。我的目标首先是在山下地城阻止瓦纱瑞丝，然后再考虑所有其他事情。”~
@100853 = ~伊丽思璀指引我的手！~
@100854 = ~为了先知！~
@100855 = ~你会输的！~
@100856 = ~你的生命已经结束了！~
@100857 = ~快！我的伤口需要治疗。~
@100858 = ~我需要帮助！~
@100859 = ~小心：敌人就在附近。~
@100860 = ~撤退！撤退！~
@100861 = ~你不敢。~
@100862 = ~保护我的侧面。~
@100863 = ~停。等一会。~
@100864 = ~不，我决不倒下！~
@100865 = ~阴影？靠近？~
@100866 = ~毒？哪种类型的毒？~
@100867 = ~我的魔法无效！~
@100868 = ~我的攻击无效！~
@100869 = ~跟着我。~
@100870 = ~就在这里。大伙看看这个东西。~
@100871 = ~我们得靠紧点。~
@100872 = ~闪边一点我才能过。~
@100873 = ~没什么锁能拦住我！~
@100874 = ~我们得仔细检查这个地方。~
@100875 = ~我会躲在阴影之中。~
@100876 = ~当然。~
@100877 = ~我不能。~
@100878 = ~工作完成了。~
@100879 = ~如果你在我这里塞满了各种装备，那么我对你就没有多少帮助了。~
@100880 = ~好吗？~
@100881 = ~欢迎。~
@100882 = ~是。~
@100883 = ~不。~
@100884 = ~停！等一下。~
@100885 = ~我们得休息一下恢复体力。~
@100886 = ~这种厌倦的情绪会使我们变得迟钝。~
@100887 = ~再会。~
@100888 = ~谢谢你。~
@100889 = ~Vith Usstan!~
@100890 = ~干得好。~
@100891 = ~我想和你谈谈。~
@100892 = ~一个绝妙的好主意。~
@100893 = ~我认为这会是一个错误？~
@100894 = ~只有笨蛋才敢和我作对！~
@100895 = ~你不能看这个生物的物品。~
@100896 = ~“现在还不到时候，地方也不合适……亲爱的。”明显地，她就是说不出那个字来。~
@100897 = ~“现在没时间谈话了。如果我们不能阻止他，靡菲斯特将会毁掉整个深水城。”~
@100898 = ~“我想我们可以在完成任务的过程中抽点时间来说说话，你想谈点什么？”~
@100899 = ~“我只是想要你知道我开始明白为什么瓦纱瑞丝会害怕你，为什么先知对你有如此大的信心。”~
@100900 = ~“当这一切都结束后，接下来你打算干什么？我是说……你将会回到地面上去，是这样吗？”~
@100901 = ~娜西拉轻轻地对你笑了笑。“你只是在逗我玩。拜托了，这是一件严肃的事。”~
@100902 = ~你的提议似乎一时让这个卓尔吃了一惊，但是他很快恢复了正常。“当然，你是在开玩笑。但是我的问题是严肃的。”~
@100903 = ~“我从没有到过托瑞尔，尽管我曾听先知和其他一些人说起过。告诉我……那里是什么样子？”~
@100904 = ~“是的，我想你迫切地希望和我们的事业脱离开来。但是在那之后，你就没有任何理由留在这里了。毫无疑问，你会回到地面上去。”~
@100905 = ~“考虑到我们所处的地方，这看起来有些奇怪。但是我不知道我们是否还能从这里出去，我想让你知道一些事情，万一……嗯，只是‘万一’。”~
@100906 = ~“是的，利用它来逃出去。这可能是最好的办法了。”~
@100907 = ~“我们相互认识的时间并不长，但是一起经历了很多事，我觉得和你非常……非常亲近。”~
@100908 = ~她恼怒地看着你。“求你了，我是认真的。”~
@100909 = ~她用怀疑的目光打量了一下你周围险恶的地形。“依我看这里并不浪漫。请听我说，我想跟你说明我对你的感觉。”~
@100910 = ~“在我的生命里曾认识过很多男人，但是没有一个放在我心上，我总是把他们看成低下的奴隶或仆人。考虑到黑暗精灵的社会风俗，这是可以预料的。”~
@100911 = ~“但是你改变了这一切。你和他们不一样。当我看着你的时候，我看到了一个平等的人，一个我尊敬的人。一个……一个……”~
@100912 = ~她喘息着那个字，然后自顾自地轻笑。“是的，就是这个字，爱，我爱你。”~
@100913 = ~“我……我当然还想为伊丽思璀做事。但是我想要你到我这边来和我一起干。我不知道怎样才能做到这点，但是我相信能够做到——如果你和我想的一样的话。”~
@100914 = ~“我……我很高兴。我原本有些害怕我俩的感情不一致。但是知道你也爱着我……”她的声音越说越小，脸上却洋溢着满足的笑容。~
@100915 = ~“我不知道。我想我们应该试着找出一条离开这个冰封王国的路来。我知道一定会成功的，我相信你，亲爱的。无论你怎么带路，我都跟着你。”~
@100916 = ~“当然，你是对的。但是我相信这一定会成功的。我对你有信心，亲爱的。无论你怎么带路，我都跟着你。”~
@100917 = ~娜西拉往后退了退，仿佛被人打了一巴掌，她的眼睛张得大大的，满是惊恐，但很快就恢复正常了。“我……我明白了。原谅我吧。我原以为我们之间还有些别的。”~
@100918 = ~“我现在明白了这是一个错误。别担心，我不会再提起的。让我们……让我们继续赶路吧。”~
@100919 = ~“我不喜欢这个地方。这里空旷而寒冷。很冷……很冷……”~
@100920 = ~“现在我们就要永远地把这个悲惨的世界留在身后了，但是我并不清楚自己是否注定要回到属于自己的世界里去。”~
@100921 = ~她突然揉搓着手臂，似乎感到有些冷，同时重重地叹息着说：“这是一个失落灵魂的家园；也许我就属于这里。我觉得自己陷在了过去和未来之间，没有目标，没有方向。”~
@100922 = ~“伊丽思璀已经昭示了我必须走的路。但是我在走下去的时候，不能不回头看看自己走过的每一个脚步，不能不看到自己在身后留下了什么。”~
@100923 = ~她悲伤地向你笑了笑。“我知道你会的，亲爱的。但是我不清楚你能帮上多少。虽然我可以依靠着你来寻求支持，但是承载我过去的人必须是自己。”~
@100924 = ~你可以通过制造技能的径向选项来选用制造陷阱，制造武器和制造铠甲的技能。~
@100925 = ~*混乱盾牌激活*~
@100926 = ~传说这件强力物品是由希瑞克神在动荡之年创造的，它使其在战斗中比对手对了一件强大的兵器，因为混乱盾牌跟别的盾牌不一样，它是一件真正的兵器。只要拿着它的人在战斗中被击中，这件盾牌就会产生各种强大的，让人丧失能力的招数来狠狠地反击那个不幸的对手，包括致盲，麻痹以及爆裂火球和闪电。~
@100927 = ~开启天空贴图~
@100928 = ~激活主控镜头~
@100929 = ~*作用区域被驱散*~
@100930 = ~*作用区域没有被驱散*~
@100932 = ~* 属性损失导致死亡 *~
@100934 = ~快逃！玛露恩主母已经死了！~
@100935 = ~快逃！主母已经倒下了！~
@100936 = ~在泽希尔回来之前快点跑吧！~
@100938 = ~记住：你可以把炽火胶用在近战武器上，这样可以暂时加带火性攻击。~
@100939 = ~火焰流~
@100940 = ~抛射出一串火焰流。~
@100942 = ~一个变形者如果变形为火矮人酋长，就能对单个敌人抛射出一串火焰流。如果这个变形者成功地对目标进行了远程接触攻击，那么他就能造成每职业等级1d4点的火性伤害，另外加上他的感知带来的修正值~
@100943 = ~使用接触攻击。~
@100944 = ~*只有近战武器才能覆上炼金士之火*~
@100945 = ~不知名的角色出现了。~
@100946 = ~你按下一个键，但是好像没起作用。~
@100947 = ~你按下一个键。火光开始在机器表面闪烁，但是你不清楚还产生了其他什么效果。~
@100948 = ~邪恶殿堂2(2x3)~
@100950 = ~小型金刚木护盾~
@100951 = ~大型金刚木护盾~
@100952 = ~金刚木塔盾~
@100954 = ~卓尔，红色姐妹1~
@100955 = ~卓尔，红色姐妹2~
@100956 = ~卓尔，战士2~
@100957 = ~卓尔，战士3~
@100958 = ~卓尔，战士4~
@100959 = ~卓尔巫师~
@100961 = ~金刚木法杖~
@100962 = ~金刚木棒~
@100963 = ~金刚木是一种极为耐用，然而又极为轻巧的木头，只能在最古老，最深邃的森林里才能找到。它具有让人惊叹的特性，但是被看作是没有魔法属性的材料。用金刚木制成的武器非常精准，并能提供+1的攻击检定。~
@100964 = ~火矮人，男性~
@100965 = ~火矮人，女性~
@100966 = ~啊啊啊啊！~
@100967 = ~*你的魅力值太低，不能使用这项特性！*~
@100968 = ~这个食人魔似乎画了一个美丽得让人炫目的女食人魔的画像，但是不知道什么原因，他重画了所有好看的部分。~
@100970 = ~魔法野兽~
@100972 = ~可怕的类人生物~
@100973 = ~爬行生物~
@100974 = ~某种力量阻止你在这里启动这件遗物。~
@100975 = ~门被一道魔法屏障封住了。~
@100976 = ~这个拟态怪死掉了。一扇星界之门出现在你的身后。~
@100977 = ~苍白之主之袍~
@100978 = ~闪耀法球（20）~
@100979 = ~球状闪电（20）~
@100981 = ~“别烦我，我没什么可对你说的。”~
@100982 = ~“以前的死亡让我觉得像个傻子。我很感激你愿意再给我一次机会。”瓦伦点点头，他那深蓝色的眼睛一直没有离开过你。“那么生活又重新开始了。我发誓站在你这一边，亲爱的，并永远保护着你直到生命的尽头……直到来世。”~
@100983 = ~瓦伦点点头，他热切的蓝眼睛直视着你。“那么又开始了。我发誓站在你这边，亲爱的，并且守卫着你，鞠躬尽瘁……死而后已。”~
@100984 = ~瓦伦点点头，突然深深地叹了口气。“那么又重新开始了。我们跳进了火焰之中……让那些挡住我们道路的人小心了。”~
@100985 = ~“我们可以谈谈吗？”~
@100986 = ~“先知似乎相信我方力量的存亡系于你的任务之上。我不知道这是否是真的，但是如果你需要我的帮助，我会再次和你在一起。”~
@100987 = ~“地狱对你我来说都是一个危险的地方。如果你需要一个战士和你一起战斗，那么我很乐意加入。”~
@100988 = ~“你需要我的帮助吗？”~
@100989 = ~“什么事，亲爱的？”~
@100990 = ~“我听候你的吩咐。”~
@100991 = ~“注意不要让自己卷入卓尔的争斗中去。即使是在反抗军之中，看来他们也更容易相互杀戮，而不是并肩战斗。”~
@100992 = ~“我听过一个关于幽暗地域的谚语：‘在它的暗影中等待冒失者的只有死亡。”~
@100993 = ~“我们必须留心瓦纱瑞丝的同党。如果他们想追踪我们……想追踪你，这个洞穴就是个好地方。”~
@100994 = ~“在这里每一步都要小心。即使看起来最友善的生物都可能带有足以放倒一头猛兽的毒药。”~
@100995 = ~“我一直认为幽暗地域与深渊魔域没有什么两样。至少在意图上如此。~
@100996 = ~“我知道离这不远有一个通向地面的出口。我们可以……寻找它，如果你愿意的话。”~
@100997 = ~“别在这里把自己弄丢了。一旦你在暗影中迷路了，想要找到自己的方位就不是那么简单了。”~
@100998 = ~“我想知道，什么样的生物会建造这样一个要塞？更想知道，它们的防护到底有多坚固？~
@100999 = ~“你难道感觉不到吗？我们已经接近这个可怕地盘的主人了。小心些。”~
@101000 = ~“我听说过这个地方，它叫做佐瓦柯穆……是灵吸怪奴役其他生物的一个哨所，根本不是什么定居点。”~
@101001 = ~“要想活着走过这个地方，我们必须用钢铁把我们的意志包起来才能。凭着他们的心灵能力，灵吸怪是这里最牛的欺诈者。”~
@101002 = ~“那么这就是那个眼魔暴君了。准备战斗！”~
@101003 = ~“这里烟灰的恶臭足以让人作呕！~
@101004 = ~“事情……事情有些不对劲，这里。我觉察到有陷阱。”~
@101005 = ~“如果这真是法师之塔，那么前面可能有很多魔法陷阱和召唤守卫。不过至少我能对付那些守卫。”~
@101006 = ~“那是我见过的最疯狂，样子最严肃的小丑。想想我们在这里找到的其他的东西，这是多么正常啊！”~
@101007 = ~“那么这个聚居地的人们已经迁回所来的地方了。现在苦难已经结束，希望他们能够找到和平。~
@101008 = ~“呒。在我看来他们好像是灰矮人商人。但是为什么会居住在如此偏远的岛屿上呢？”~
@101009 = ~“我想知道这些魔像在这里呆了多长时间了，他们是跟随着主人，还是单独行动？我觉得自己为他们感到难过，虽然这种感觉是如此的奇怪。”~
@101010 = ~“你可以嗅出潜留在空气里的魔法，就在这里。这些魔像的主人没有死……但是也没有活着。”~
@101011 = ~“我知道我们的所在。这里是卡尼亚，位于称为巴托的外层位面。一个冰封的地域，到处居住着魔鬼……我的恶魔血统使得我还没你受欢迎。”~
@101012 = ~“这里多独特啊，不像别的地域。这里的火焰把受难的人们吸引过来，给他们温暖，给他们保护。”~
@101013 = ~“离开这个寒冷的地方真好。虽然我比大多数人都能忍受极限温度，但还是感觉到冰冷难忍。”~
@101014 = ~“是不是是不是有一个女人封在了那块冰里？她看起来像是人类，可能吧……或者至少是类人生物。”~
@101015 = ~“噢，快看，我们真的来到地狱世界了，真是个笑话。”~
@101016 = ~“看起来好像某种生物装扮成了箱子的样子……一个吞噬宝石的箱子。多么奇怪啊！”~
@101017 = ~“呒。我们怎样才能度过这条熔岩之河呢？反正我觉得游过去不是答案。”~
@101018 = ~“毫无疑问那些操纵杠是通过这扇门的钥匙。这是另外一个谜题……欢迎来到地域。”~
@101019 = ~“如果需要的话，我们会开辟一条通过幽暗地域的鲜血之路。”~
@101020 = ~（哼哼声）~
@101021 = ~“他们说出生在印记城的少女会把她的心放在一个箱子里
而这箱子的钥匙
你难道不明白要花钱才能得到吗？
啦啦啦啦啦啦……”~
@101022 = ~灰矮人奴隶~
@101023 = ~清除资料列表……~
@101024 = ~载入资料列表……~
@101025 = ~既然传送门打开了，你对我们就没什么用了……除了作为食物！~
@101026 = ~“我想知道瓦纱瑞丝是怎样控制魔王的，这样的生物甚至比致命的深狱炼魔还要巨大，并且更加小心。”~
@101027 = ~“我有点奇怪为什么我们会纠缠在这件事情里面。我确信，先知将会在这里死去。”~
@101028 = ~“我不是一个信徒，我是世界中的一个阴影，
一个真实的私语，
一首唱给你的歌，
我的爱人的灵魂克制着……”~
@101032 = ~“死亡就是礼物，刀刃将会带来它。
死亡就是礼物，
刀刃将会唱出它。~
@101033 = ~改造武器：——没有装备武器或者武器现在不能被改造~
@101034 = ~改造铠甲：——没有装备铠甲或者铠甲现在不能被改造~
@101035 = ~你召唤的生物看着你等候命令。~
@101036 = ~“师傅的话浮现在我的脑海里：等待，并仔细考虑你的攻击。然后出手一击，狠狠的一击，这将是你唯一所需要的。”~
@101037 = ~“我曾经在只有区区几个恶魔相助的情况下面对一小队的恶魔，最后我是唯一离开战场的一个。”~
@101038 = ~“是不是在冒险旅途中所走的每一步都让我们离死亡更近了？”~
@101039 = ~“我不知道如果我死在你们的世界，结果会是怎样。我那恶魔的一部分会回到深渊魔域吗？我祈祷不会这样，因为我受够了那个地方。”~
@101040 = ~“我已经见识过太多的鲜血和死亡。但是我仍然留在这里，为先知而战斗并再次深深陷入其中。~
@101041 = ~“我凭自己的意志，自己的硬头锤活着。它的道路就是我的方向，它的长度就是我的伸展，它那雷霆攻击就是我温柔的吻。”~
@101042 = ~“呒。我一直在想我应该在离开之前给伊蒙罗更多的指示。不过不要紧。”~
@101043 = ~“我们在朝哪走？我更愿意在前面领路，而不是整天跟在你后面。”~
@101044 = ~“我的铠甲已经被玷污得让人难以置信。这就是生锈？！下次停下来的时候我一定要打磨打磨。”~
@101045 = ~“我不喜欢呆在地面下。即使是在深渊魔域我也不曾感觉到自己的头顶上如此……如此沉重。”~
@101046 = ~“这里的黑暗没有尽头，它比阴影还要可怕……它包围你的心灵，吞噬你的勇气。”~
@101047 = ~“我知道卓尔曾经生活在地表，后来被他们的表亲驱赶到地底。他们被放逐到那些阴暗洞穴里会是怎样的一番感受？”~
@101048 = ~“一只眼睛升起来，一只眼睛闭着，一只眼睛迷惑人类，一只眼睛迷惑野兽，
一只眼睛造成伤害，一只眼睛用来减速，
一只眼睛带来恐惧，一只眼睛让人石化
……呒，现在我忘记其他的了……”~
@101049 = ~“你确定你走的路是对的吗？我们之前没来过这里？”~
@101050 = ~“所有关于那些最伟大的冒险的古老传说都没提到这样一个事实，那就是大部分的冒险时间都花在了走路上，不是吗？”~
@101051 = ~“我记得当我们在跟大深狱炼魔领主战斗的时候，他用力量造成一道沟壑把我们和他隔开，然后嘲笑着说他永远也不会被打败……就在我们滑进那道沟壑之前。”~
@101052 = ~“我必须承认，杀死凡人比杀死恶魔要容易多了。如果你把恶魔的头移走，你还要和一个试图咬你脚踝的东西纠缠。”~
@101053 = ~“我不喜欢这里给人的感觉，好像我们在被监视一样。”~
@101054 = ~“我很想早点‘报答’那个魔王送我们到这里的‘好心’。”~
@101055 = ~“啊，是的，地狱位面，一个受难之所，我了解得很清楚。”~
@101056 = ~“这似乎方便一些……因为你很久以前找到的那个圣物是靡菲斯特的一部分。嗨，我想这就是你卷进来的原因，是不是？”~
@101057 = ~“啊，我感到我的恶魔血统在反对我出现在这里，血战正在召唤我！”~
@101058 = ~“地狱世界里一位魔王在你们的世界里已经自由自在了一段时间，他让人恐惧，但是自己却想要离开。这真是有趣。”~
@101059 = ~他充满思虑地揉着下巴，似乎不知道该如何继续。“我们现在随时可能死去，所以有些事情我想先吐出心胸。”~
@101060 = ~当他看着你的时候，他的表情已经变得生硬起来，眼睛里燃烧着信念的怒火。“不，这其中根本没有什么愚蠢的伤情，但是明显我该在你进一步污辱我之前把它做完整。”~
@101061 = ~他点点头，“你是对的。我应该把这件事情做完整。”~
@101062 = ~“我们相互认识还没多久。但是我想要你知道，在相处的这些短短的日子里，我……越来越和你觉得亲近。”~
@101063 = ~“我……我想我已经对你很了解了。我相信我们成了好伙伴，或许还不止这样。你……你也这样觉得吗？”~
@101064 = ~他害羞地笑了笑，向远处看了一会。当他的双眼转向你的时候，眼神是那样的明亮，充满感情。“我非常高兴听到这话，我的女士。”~
@101065 = ~“我的生活，”他缓缓地开口说道，“除了愤怒和失望以外什么都没有。即使在我见过先知以后，我仍然相信获得人性是我最大的渴望。”~
@101066 = ~“我不再有那样的感觉了。我相信我渴望更重要的一些事情。”他的眼睛热切地看着你。“我……我爱你，我的女士，用我全部的身心。”~
@101067 = ~接着，瓦伦害羞地笑着说：“我最大的希望就是你会回应我的感情，我的女士。没什么比这让我更高兴。”~
@101068 = ~他眼眺远处，咧着嘴笑着。“我不知道。我所知道的就是，你是我遇到的最迷人的女性。无论我们的未来如何，我都觉得很满足。”~
@101069 = ~“我知道。”他向下看着，笑得很是满足，“我坚信我们一定能够渡过这个难关。到那时……嗯，到那时我们再来谈。”~
@101070 = ~“他点点头，依然温柔地笑着，虽然受伤的骄傲在眼神后闪烁。“当然，我的女士。我……不再期望过多了。”~
@101071 = ~“也许等这事结束了，我们可以再来说它。”他停了停，转身离开，让这个问题停伫在空气中。“如果我让你觉得不安了，我……很抱歉，我的女士。可是我不得不说出来。”~
@101072 = ~“让我们继续前进吧。如果想逃离这个冰冻荒原的话，我们还有很多事可干。”~
@101073 = ~你的答案出乎意料，瓦伦显然看起来对此感到失望和不安。“唉，”他叹了口气，“我想我应该料到这点的。”~
@101074 = ~“把你当作朋友并没有错，这样做我更高兴。”他害羞地看着你，“当然还得要你原谅我的失礼才行。”~
@101075 = ~他缓缓点了点头，对此表示理解，“我知道了，”他非常尴尬地说，“那么我是个大傻瓜。”~
@101076 = ~痛苦的表情划过瓦伦的脸庞，他把目光移开了你。“我……我明白了。”一丝红晕突然涌上了它的面颊。“我想我原该了解得更加深入些。”~
@101077 = ~“我想……算了，我怎么想的并没有关系。我非常傻。我不会让自己的想法再麻烦你了，向你道歉。”他突然清了清嗓子，“就让我们……继续前进好了。”~
@101078 = ~他不安地咯咯作笑。“我是认真的，我的女士。我想和聊一聊，就我们两个。”~
@101079 = ~我……真的，我的女士！我根本不是这个意思！我只是……我只是想告诉你我对你的感觉。”~
@101080 = ~“我想表示对你的敬仰之情。我知道你是被海拉斯特强迫来帮助我们的，但是我想你所做的远远超过了要求。对此我非常感激。”~
@101081 = ~他开怀一笑。“好，我非常高兴。”他朝前移动着，“让我们继续前进吧，朋友。我们还有一个位面去征服，还有一个魔王去面对。胜利看起来不再十分遥远了。”~
@101082 = ~“跟先知说吧。他会解释一切的。”~
@101083 = ~这个泰夫林仔细打量着你。“先知相信你是我们预言中的救世主，是我们打败瓦纱瑞丝唯一的希望。但是我不相信预言。”~
@101084 = ~“当然，你显然是个自身能力不凡的人。如果我们想要赢得这场战争，我们需要所有可以得到的帮助。所以我愿意利用这个机会。”~
@101085 = ~瓦伦点了下头表示欢迎：“我怎样才能帮你？”~
@101086 = ~测试~
@101087 = ~他们挡不住我们！打倒他们！~
@101088 = ~你赢不了这场战斗！~
@101089 = ~我们跳进了火焰之中！~
@101090 = ~我受伤了！帮帮我！~
@101091 = ~我处在极度劣势之中！~
@101092 = ~我们再次遭到攻击。~
@101093 = ~撤退！我们必须重新组织！~
@101094 = ~我的鲜血渴望你的鲜血，它*将*会得到满足的。~
@101095 = ~我需要你站在我这一边。~
@101096 = ~停止！~
@101097 = ~啊哈！我绝不倒下的。~
@101098 = ~哈！我能感觉到这种剧毒！~
@101099 = ~我的魔法不起作用！~
@101100 = ~这件武器不起作用！~
@101101 = ~来吧，让我们走。~
@101102 = ~在这里我们能得到什么？~
@101103 = ~我们应该呆在一块。~
@101104 = ~让我过去。~
@101105 = ~我会试着打开它。~
@101106 = ~我会小心的。~
@101107 = ~悄然无声。~
@101108 = ~很好。~
@101109 = ~我不能。~
@101110 = ~搞定了。~
@101111 = ~确切地说，你打算想用多重的担子把我压垮？~
@101112 = ~听你的。~
@101113 = ~欢迎。~
@101114 = ~是。~
@101115 = ~不。~
@101116 = ~等一下。~
@101117 = ~我们都需要休息。~
@101118 = ~我们还必须无所事事多长时间？这样什么都完成不了。~
@101119 = ~再会。~
@101120 = ~谢谢你。~
@101121 = ~以地狱深渊的名义！~
@101122 = ~哈哈！是个好日子！~
@101123 = ~我有话要说。~
@101124 = ~一个出色的计划。~
@101125 = ~不，我不认为那样有用。~
@101126 = ~你现在就想死吗？这事我倒是可以安排妥贴。~
@101127 = ~你死在了地狱世界里，现在是永远地死亡了。~
@101129 = ~你突然觉得变弱了，好像你的武器在攫取你的生命力。~
@101130 = ~我们还会再见面的！~
@101131 = ~萨巴尔瞬移走了。~
@101132 = ~你拉了拉锁链，可是这次什么都没发生。~
@101134 = ~你在塔洛娜神殿被击败并永远地死亡了。你必须读取一个存档来继续游戏。~
@101137 = ~蜥人族皮鞭大师~
@101138 = ~你控制的这个生物看着你等候命令。~
@101139 = ~它在等候命令。~
@101140 = ~会意的点点头。~
@101141 = ~它会意的点点头。~
@101142 = ~它会意的点点头。~
@101143 = ~它怀疑这没有什么大的帮助，但是同意试一下。~
@101144 = ~它会意的点点头。~
@101145 = ~它会意的点点头。~
@101146 = ~它会意的点点头。~
@101147 = ~它会意的点点头。~
@101148 = ~它怀疑这没有什么大的帮助，但是同意试一下。~
@101149 = ~它想知道你要它呆在多远开外。~
@101150 = ~它会意的点点头。~
@101151 = ~它会意的点点头。~
@101152 = ~它会意的点点头。~
@101153 = ~这生物在等待进一步的命令。~
@101154 = ~这生物想知道它在向谁施展咒语。~
@101155 = ~就这样定了。~
@101156 = ~这生物在等待进一步的命令。~
@101157 = ~“你确定吗？”~
@101158 = ~“我要把它施展在谁的身上？”~
@101159 = ~“棒极了！”~
@101160 = ~你的动物伙伴一直对你心不在焉，直到你引起它的注意，示意你想要跟它说话。~
@101161 = ~你的凶暴鼠抽搐着鼻子，胡须不停的抖动，它蹦到你身边，围着你靴子上的一小块血嗅个不停。~
@101162 = ~这只凶暴狼耸起身子，显出强健的肌肉。，它大步走过来，留意着你的关爱。~
@101163 = ~你的蜘蛛有着纤细的肢体，它爬过来等你做出指示。~
@101164 = ~你的黑豹，，走过来用身子磨蹭着你，想要得到你的关注。~
@101165 = ~随着一声尖啸，你的老鹰飞过来在你的头边盘旋，想知道接下来你是否还想杀死什么。~
@101166 = ~随着一声咕噜和一声尖叫，，你的野猪跑过来嗅着你的靴子，想知道它是否让你高兴了。~
@101167 = ~你的熊，，步履蹒跚地向你走来，它感到非常疲惫，希望你能好好抓抓它的耳朵。~
@101168 = ~你的狼，，调皮地向你跳过来，头耷拉在一边，想知道它该怎样帮助你。~
@101169 = ~这只獾，，又抓又嗅地跑到你的腿边，似乎在以它那显著的暴躁性格责问你为什么要打搅它。~
@101170 = ~每次当你的手指靠近凶暴鼠的时候，它就会顽皮地咬着它们，当你抚摸着它那毛茸茸的脑袋时，它会兴奋地抖动着。显然它还不习惯这样友善的对待。~
@101171 = ~当你抚摸你的凶暴狼时，它机警地看着你，不能确定这样的宠爱是否体面。它想知道你是否对所拥有的其他动物伙伴也这样做。~
@101172 = ~这蜘蛛在你的抚摸下畏惧地向后退了退，然后明白了这动作的含义，高兴地叫起来。~
@101173 = ~不幸的是，当它的不利逐渐变得明显时，你的蜘蛛就吃掉这些碎片，然后宣告自己的胜利。~
@101174 = ~你的黑豹让你抚摸着它，当你抚摸完了以后它也会反过来抚摸你，有时候你真的会忘了那些爪子会有多重。~
@101175 = ~你的老鹰看着你的手指，仿佛觉得它们是可吃的食物，但是慢慢地它变得温顺起来，并且允许你抚摸它的羽毛。~
@101176 = ~野猪高兴地喷着鼻息，然后在你做完的时候，快乐地跳了几下奇怪的舞蹈。~
@101177 = ~熊嗅了嗅你的手指，在认定上面没有任何蜜浆后就失去了兴趣。~
@101178 = ~你的狼接受了你的抚……摸，并且反过来磨蹭着你，享受着这种关爱。~
@101179 = ~当你把手指移近的时候，你的獾轻轻地咬着它们，一点也没有心情*对你这个大伙伴表示友好*。~
@101180 = ~你的凶暴鼠不知从哪里拿出一幅纸牌，然后教了你几种它称之为*21点*的游戏的不同玩法。~
@101181 = ~你的凶暴狼对游戏没有什么兴趣，但是只要你抓抓它的耳朵背，它愿意和你探讨关于生命意义的哲学问题。~
@101182 = ~你和你的蜘蛛玩一种具有挑战性的网格游戏，用它吐的网作为板子，然后把昆虫像碎片一样打昏。~
@101183 = ~不幸的是，当它的不利逐渐变得明显时，你的蜘蛛就吃掉这些碎片，然后宣告自己的胜利。~
@101184 = ~你的黑豹唯一感兴趣的游戏是摔跤，以及一种它扑向你的脚，而你要想办法跳开的游戏。你很可能在这两种游戏中都会输掉，但是仍然要试一试。~
@101185 = ~你和老鹰进行了简短的“千里眼”的游戏，结果表明它的视力比你强太多。发现一千码以外的一只褐鼠是极其困难的一件事。~
@101186 = ~事情进行得很顺利，但是当你建议玩一个叫做“中间是猪”的游戏时，你的野猪大发脾气，并且拒绝继续玩下去。~
@101187 = ~你试图和你的熊玩一个有20个问题的游戏，但是不得不沮丧地放弃了，因为它能想起的只有鱼和蜂蜜。~
@101188 = ~你和狼玩了一会“不要靠近我”这个游戏，但是它那无穷无尽的精力最终让你疲惫不堪。你希望没人看见这个场面，否则你会得到“与狼共舞”这样一个愚蠢的绰号。~
@101189 = ~你和獾玩一种有趣的“拉锯战”的游戏，这个游戏以一小段绳子开始，以撕裂你的衣袖结束，然后獾嘴里叼着布条，骄傲地跑开了。~
@101190 = ~在你责备它的时候，凶暴鼠努力地想要集中注意力，但是不时被跳蚤的叮咬分神，最后你不得不因为恶心放弃了。~
@101191 = ~趴在你的脚边，头枕着爪子，悲伤地看着你。~
@101192 = ~蜘蛛眨着很多只眼睛，等待着你平静下来。~
@101193 = ~你的黑豹垂着头，狠狠地打着地面上的什么东西，感觉非常尴尬。~
@101194 = ~发出一声孤独的尖叫，不确定你怎么能够为了这样一个不幸的错误而责备它。~
@101195 = ~打着鼻息，转身背对着你，然后释放了一个恶臭难闻的回应。~
@101196 = ~失望地咆哮着，它虽然意识到了这让你不安，但是并不真正了解原因。~
@101197 = ~羞愧地低着头，然后转过身，开始用它的尾巴拍打你的腿，想要让你高兴起来。~
@101198 = ~用后腿支起身子，开始反过来数落你。显然它觉得如果你能给出更明确的指示的话，它就不会犯错了。~
@101199 = ~贪婪地抓起食物，狼吞虎咽地吃起来，一边吃一边留意有没有别的竞争者试图偷一点食物去。~
@101200 = ~快速地享用起刚杀死的猎物。它静静地分给了你一份，你对此表示感谢，但是拒绝接受。~
@101201 = ~蜘蛛拿起食物，先用网把它包裹起来，然后再用嘴咬，接着把它塞进自己的下颚，这个过程好像是在进行某种奇怪的进食仪式。~
@101202 = ~撕扯着你扔给它的食物，几口就把它吞下去了。~
@101203 = ~围绕着你的手盘旋，然后叼起一块鲜肉，撕裂后很快就吞了下去。~
@101204 = ~并不讲究，它把食物在污泥中打了几个翻，然后吞了下去。~
@101205 = ~嗅了嗅食物，然后失望地吃着已经死了的食物。它希望下次你能在上面放上一点蜂蜜。~
@101206 = ~撕扯着你扔给它的食物，几口就把它吞下去了。~
@101207 = ~咆哮着攻击你扔下的食物。经验已经告诉你不要赤手拿着食物喂它。~
@101208 = ~因为并不感到饥饿，所以它对食物漠不关心，只是等着你说重要的事。~
@101209 = ~你的动物朋友只是微微注意着你，直到你引起它的注意，并示意有话要说。~
@101210 = ~你的眼球浮在空中，用力盯着你，与你进行心灵感应。“已经准备好为你效劳了，陌生的<LADYLORD>。”~
@101211 = ~你的伪龙利索地拍打着翅膀，在你的面前停了下来。它一边像爬虫一样对你露齿一笑，一边用心灵感应跟你交流，“需要为你做什么，<LADYLORD>？”~
@101212 = ~你那调皮的仙女龙飞到你旁边，“噢，<CHARNAME>，亲爱的<LADYLORD>，迫不及待地想帮你，噢，噢，噢！”~
@101213 = ~你的乌鸦，，飞到你的面前，好奇地看着你，等待你的命令。~
@101214 = ~皮克精向你飞来，身上的仙尘画出一道轨迹，仙尘飘到你的脸上，差点让你打喷嚏。“噢，<LADYLORD>？需要帮忙吗？”~
@101215 = ~魔蝠飞到你身边，它身上散发出的寒意让你皮肤发麻。“我能为你做点什么，强大的君主？”~
@101216 = ~魔蝠飞到你身边，它身上散发出的热量刺痛着你的皮肤。“长官，地狱第一飞行员向你报告。”~
@101217 = ~你的小魔鬼扇动着翅膀。“你想要什么，<LADYLORD>？在这个讨厌的地狱般的世界里与你共同进退，相互依靠，这难道还不够吗？你非要不停的发问，纠缠不清吗？”~
@101218 = ~你的地域犬，，冲了过来，兴奋地希望你能要他煎炸一点什么。~
@101219 = ~你的黑豹，，走过来用身体顶着你，想要寻求一点关注。~
@101220 = ~你的蝙蝠，，飞过来在你的头边盘旋，等待你给它发布命令。~
@101221 = ~想要杀死更多的敌人，更多更多的敌人。它觉得你可能在所杀的敌人中占的份儿多了些，所以不会介意它多杀一点。~
@101222 = ~冷淡地送了耸肩。“可能会好些，也可能更糟。只是想活下来罢了，这是很基本的想法。”~
@101223 = ~“噢，是的，一切都进行得很顺利，非常棒，完美极了；除了那些危险的小细节以外。一点也不喜欢它们，不喜欢。”~
@101224 = ~摇晃着身子，然后发出一声粗鲁的噪声，掉下一堆粪便。显然它并不对这样的情形感到激动。~
@101225 = ~一边哈哈大笑着，一边快速地在四周飞舞，然后它尖叫着给出了一个回答，“很可爱。”~
@101226 = ~叹了口气，呼出一团冷雾。最后它耸了耸肩说，“我真的说不出来。这里暖和吗？”~
@101227 = ~以立正的姿势站着，“长官，你可以指派我去做任何你想要我做的事，但是不要指望我能有自己独到的想法，我并没有经受过思考的训练。”~
@101228 = ~“是，长官！”~
@101229 = ~“是，长官！就是现在，长官！明白，长官！”~
@101230 = ~怀疑的注视着你，“少说话……多杀人。一个建议而已。”~
@101231 = ~咆叫着，对于它要杀死并吞食这么多的生物感到极为高兴。~
@101232 = ~向你咆哮着，希望你能更加照顾好自己，不要再陷入危险的境地之中。~
@101233 = ~在四处飞来飞去，让你觉得它真得很喜欢你所探索的这个地方，唯一的希望就是它别非得老是送命了。~
@101234 = ~你的眼球兴奋地与你进行着对视比赛。你一直坚持着，直到它开始作弊，把一个小的霜球弹进你的眼里，让你眨了眨眼睛。~
@101235 = ~让你躺下的伪龙起来进行游戏花了不少的功夫，但是一旦它参与进来，它就不想停下了。游戏完了后，它会用尾巴高兴地卷着你的腿，缠紧，然后再飞走。~
@101236 = ~你的仙女龙很爱玩游戏，如果你给她时间，它会玩上几个小时。当你结束的时候，它会抱抱你的脖子，然后快乐的飞走。~
@101237 = ~你想哄你的乌鸦和你玩游戏，但是让人着恼的是，它总是说，“不要再劝了。”~
@101238 = ~没什么和皮克精挠痒痒这样的好游戏相像了。是的，这世界上没有别的事情跟这一样。~
@101239 = ~魔蝠似乎对任何需要思考和移动的游戏都不想参与，最后它建议打雪球，结果它轻而易举地赢了。~
@101240 = ~你和魔蝠玩激烈的“夺旗”游戏，但是当你连续赢了超过一场以后，它就生气了。~
@101241 = ~“为什么大家都认为小魔鬼们喜欢玩猜谜游戏呢？我问过你关于棺材，鱼或者河的问题吗？没有，我认为没有。但是……好吧……也许猜一个谜还可以吧。”~
@101242 = ~你把一个球仍过地域犬的头顶，然后大叫一声“叼回来！”，但是它只是走过去，用火把球吞没，然后恶作剧似地看着你。~
@101243 = ~你的黑豹唯一感兴趣的游戏是摔跤，以及一种它扑向你的脚，而你要想办法跳开的游戏。你很可能在这两种游戏中都会输掉，但是仍然要试一试。~
@101244 = ~你在空中挥舞着一根木棍，而你的蝙蝠则尽可能的靠近它，这是你的宠物最喜欢的游戏，这游戏很有趣，直到蝙蝠一头撞到木棍上，昏倒在地。~
@101245 = ~眼球开始大哭起来，流出大滴大滴的眼泪，湿润的泪珠直接滴在了地板上。接着它钻入空中，羞愧地低垂着，然后飞走了。~
@101246 = ~伪龙把它长长的舌头伸出嘴外，好像是有点不耐烦地说：“好的，明白了，你不必跟我说两遍。”~
@101247 = ~“噢，<LADYLORD>，只觉得很难受。它并不想犯这样的错误，是的，它不想这样。噢，说你会原谅干的坏事吧。”~
@101248 = ~乌鸦以一种尊严受到侵犯的姿态看着你，抖开羽毛，把它的喙对着天空，完全忽视你的存在。~
@101249 = ~皮克精大哭起来，她的身体因为哭泣而卷曲。看起来很难安慰她，后来地板上的某件东西吸引了她的主意，结果它完全忘记了你。~
@101250 = ~冰魔蝠身不由己地颤抖起来：“我让你失望了，噢，强大的嗜血君主！如果你要放逐我，我表示理解。”~
@101251 = ~火魔蝠向你行礼：“是，长官！我会努力不再重复这样的冒犯，长官！如果我犯了，我将受到惩罚，让纪律的荆条抽打我的后背。”~
@101252 = ~小魔鬼扬了扬眉毛说：“什么？要我在意你的想法？我应该趴在你脚下请求原谅？下次挑一个皮克精宠物把。他们比较敏感，并且做成汤的味道也不错。”~
@101253 = ~地狱犬咆哮着，警告你注意态度，并且保留自己的观点。~
@101254 = ~你的黑豹垂着头，狠狠地打着地面上的什么东西，感觉非常尴尬。~
@101255 = ~蝙蝠飞到你的脸边，用翅膀包住你的头，开始哭起来，同时还不停的用鼻子蹭着你的脸，请求原谅。这是非常让人不安的一种经历。~
@101256 = ~从你手里抓过肉去，匆忙地吞了下去。“呒……味道不错。”~
@101257 = ~把尸体撕开显出肉来，然后啜食起鲜血来，那鲜血顺着它的下巴往下流。“啊，感觉不错，谢谢。”~
@101258 = ~“噢，多爱吃啊，仁慈的<LADYLORD>，噢，是的，她真的很爱吃！”~
@101259 = ~一边从你的手上叼起鲜肉，吞下去，一边看着周围以确保没有别的生物会偷走食物。~
@101260 = ~欢快的笑着，舔走你手指上的碎屑，然后继续飞翔。~
@101261 = ~“噢，伟大的美食施与者，我谢谢你的宠爱。”~
@101262 = ~“长官，我要迅速吃掉我那份食物，然后回到任务中去。”~
@101263 = ~看着你提供的食物，大声地嗅着，“这就是你那精致的口味所认为的烹饪美食，是吗？”然后和以前一般无二的吃掉了它。~
@101264 = ~烧烤着你扔给它的食物，然后用白森森的牙齿撕扯它。~
@101265 = ~撕扯着你扔给它的食物，几口就把它吞下去了。~
@101266 = ~快速冲到你的头上，抓住你扔到空中的硬面包的碎屑和奶酪。~
@101267 = ~因为并不感到饥饿，所以宠物对食物漠不关心，只是等着你说重要的事。~
@101268 = ~它在等待指令。~
@101269 = ~会意的点点头。~
@101270 = ~不明白你想要说什么。~
@101271 = ~“我会让他们明白地狱是怎样万里冰封的，噢，伟大的毁灭之风！”~
@101272 = ~“是，所有的火焰都点燃，我明白，长官！”~
@101273 = ~“用一个火球把他们全送进地狱。我明白了。”~
@101274 = ~会意的点点头。~
@101275 = ~怀疑这没有什么大的帮助，但是同意试一下。~
@101276 = ~高兴地叫着，它喜欢好的陷阱带来的挑战。~
@101277 = ~会意的点点头。~
@101278 = ~会意的点点头。~
@101279 = ~会意的点点头。~
@101280 = ~会意的点点头。~
@101281 = ~怀疑这没有什么大的帮助，但是同意试一下。~
@101282 = ~高兴地叫着，它喜欢好的锁带来的挑战。~
@101283 = ~想知道你要它呆在多远开外。~
@101284 = ~会意的点点头。~
@101285 = ~会意的点点头。~
@101286 = ~会意的点点头。~
@101287 = ~在等待进一步的指令。~
@101288 = ~想知道它在向谁施展咒语。~
@101289 = ~就这样定了。~
@101290 = ~在等待进一步的指令。~
@101291 = ~“你确定吗？”~
@101292 = ~“我要把它施展在谁的身上？”~
@101293 = ~“棒极了！”~
@101294 = ~要召唤魔宠，只要点击你的人物进入放射状功能表，然后选择特殊能力这项即可。如果魔宠已经召唤出来，支配魔宠的选项就会出现在法师或术士的子功能表上。~
@101295 = ~当支配宠物的选项被选定后，你就可以立即控制你的宠物了。你的人物就会站在<HIMHER>原地不动。~
@101296 = ~当你完成后，使用相同放射性菜单上。在底下应该有个不支配宠物项物。这会让你直接回到你的控制角色中。~
@101297 = ~“没事了。”~
@101298 = ~“我想改变一下你的战术。”~
@101299 = ~“我现在不想改变任何东西。”~
@101300 = ~“我不希望你施放任何法术除非我要你这么做。”~
@101301 = ~“我要你前进并且给自己来个法术。”~
