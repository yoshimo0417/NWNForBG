@99809 = ~“一个不错的计划，让我印象深刻。”~
@99810 = ~“不，我决不会让你去的。”~
@99811 = ~“假如你能够离开卡尼亚……”~
@99812 = ~“你有什么目的？”~
@99813 = ~“为什么你几乎成了失魂者中的一员？”~
@99814 = ~“回答我其他的问题。”~
@99815 = ~“很高兴我能帮上忙。”~
@99816 = ~“没什么。”~
@99817 = ~“我都做了些什么？”~
@99818 = ~“成为灵魂会是什么样的？”~
@99819 = ~“回答我其他的问题。”~
@99820 = ~“我想你是疯了。”~
@99821 = ~“真恶心！”~
@99822 = ~“似乎不错……”~
@99823 = ~“无冬城里到底发生了什么事？”~
@99824 = ~“再见。”~
@99825 = ~“回答我其他的问题。”~
@99826 = ~“你怎么死的？最后怎么到这儿的？”~
@99827 = ~“可是他们打败了你……”~
@99828 = ~“但是为什么？是什么让你陷入这样的绝境？”~
@99829 = ~“难道你不爱范斯维克吗？”~
@99830 = ~“你带领的是谁的军队？”~
@99831 = ~“但是之前你曾住在那里，不是吗？”~
@99832 = ~“什么样的虚伪？”~
@99833 = ~“不是现在，艾瑞贝丝。热心地等着。”~
@99834 = ~“是的，我想要你和我再次一起冒险。”~
@99835 = ~“不是真的，我只是想揭揭你的老底。”~
@99836 = ~“一起来吧，但是请不要发表什么评论。”~
@99837 = ~“抱歉，现在不行，我们过会儿再谈。”~
@99838 = ~“怎么了，艾瑞贝丝？”~
@99839 = ~“再见”~
@99840 = ~“我可没工夫听你的宗教演说。”~
@99841 = ~“你就是专家，向我解释一下地狱的本质吧……”~
@99842 = ~“你是用惩罚来处理问题的吗？”~
@99843 = ~“地狱比我想像的要冷一些，这点确定无疑。”~
@99844 = ~“回答我其他的问题。”~
@99845 = ~“为什么是冰块和岩浆？这没什么含义。”~
@99846 = ~“靡菲斯特正要回来，是吗？”~
@99847 = ~“他为什么会放弃这个地方？”~
@99848 = ~“神殿训练？”~
@99849 = ~“再见。”~
@99850 = ~“把它们留给你自己吧。我没工夫听。”~
@99851 = ~“别提无冬城了！那只是一个愚人之城罢了。”~
@99852 = ~“什么回忆？”~
@99853 = ~“我想这些记忆并不让人愉快吧？”~
@99854 = ~“纳什尔领主为什么会受惊吓呢？”~
@99855 = ~“告诉我有关绞刑的事”~
@99856 = ~“告诉我有关范斯维克和德斯泽尔的事。”~
@99857 = ~“再见。”~
@99858 = ~“那将是我到时要承担的责任。”~
@99859 = ~“别担心。我们需要的只是守门人的真名。”~
@99860 = ~“如果那是用来在世间行善的话。”~
@99861 = ~“等一下，我们首先需要给她自由。”~
@99862 = ~“别给我上课了行不行？我应付得了它！”~
@99863 = ~“怎么回事？因为我可能知道你们的事情而受惊吗？”~
@99864 = ~“我会记住的。”~
@99865 = ~“你提了一个好建议，艾瑞贝丝，我会好好考虑它的。”~
@99866 = ~“再见。”~
@99867 = ~“你看出它是从哪里来的？~
@99868 = ~“无知？”~
@99869 = ~“你认为你爱他。”~
@99870 = ~“你还年轻。”~
@99871 = ~“但是你以前从没来过这里。”~
@99872 = ~“你看出这棵树是从那里来的？”~
@99873 = ~“我想，那时我们已经找到了熟悉这些地方的人。”~
@99874 = ~“别放弃你的希望”~
@99875 = ~“这只是一棵平常的树。”~
@99876 = ~“什么树？”~
@99877 = ~“再见。”~
@99878 = ~“是的，我正在为这只小野兽安排一个痛苦的结束……”~
@99879 = ~“并且我忍不住想看看你那长的很有意思的面孔”~
@99880 = ~“你也会感到震惊的。这里实在是太冷了。”~
@99881 = ~“手脚放干净些，幽灵。我没兴趣。”~
@99882 = ~“嗨，我原以为你是一个好人！”~
@99883 = ~“管好自己的事情……不要笑了”~
@99884 = ~“手脚放干净些，我没兴趣，”~
@99885 = ~“你在跟我调情吗？”~
@99886 = ~“期望？我原以为你是一个好人！”~
@99887 = ~“算了吧，我没兴趣。”~
