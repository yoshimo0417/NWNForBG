@96459 = ~“操纵死尸。”~
@96460 = ~“你刚才想说什么？”~
@96461 = ~“我们得停下来谈谈。”~
@96462 = ~“好了，已经讨论得够多的了。”~
@96463 = ~“你感觉怎么样？”~
@96464 = ~“所有这一切结束后你打算干什么？”~
@96465 = ~“请回到我的其他问题上来。”~
@96466 = ~“很周到的计划。令我印象很深，艾瑞贝丝。”~
@96467 = ~“不，我不会同意的。”~
@96468 = ~“假如你可以离开卡尼亚……”~
@96469 = ~“你有什么目的？”~
@96470 = ~“你为什么差点成为一个失魂者？”~
@96471 = ~“请回到我的其他问题上来。”~
@96472 = ~“九渊地狱对我们中的任何人都没有威胁。”~
@96473 = ~“不用客气，艾瑞贝丝。我很乐意帮忙。”~
@96474 = ~“唔。我本应该不去理会这些事情……”~
@96475 = ~“成为灵魂会怎么样？”~
@96476 = ~“请回到我的其他问题上来。”~
@96477 = ~“那么和我预料的一样。”~
@96478 = ~“对你来讲一定会很可怕！”~
@96479 = ~“可能会更糟……”~
@96480 = ~“无冬城究竟发生了什么？”~
@96481 = ~“再见。”~
@96482 = ~“请回到我的其他问题上来。”~
@96483 = ~“你是怎么死的？你最后又怎么来的这儿的？”~
@96484 = ~“但是他们击败了你。他们停止了你前进的步伐……”~
@96485 = ~“你为什么会这么做？”~
@96486 = ~“你带领的是谁的军队？”~
@96487 = ~“你侍奉的是谁？”~
@96488 = ~“但是在那以前，你曾经把这个城市当作家园。”~
@96489 = ~“为什么你想逃避这些？”~
@96490 = ~“不，那就是。”~
@96491 = ~“我想我们应该分开走。”~
@96492 = ~“好，那好吧。那么和我呆在一起吧。”~
@96493 = ~“留在这里等我回来。”~
@96494 = ~“你走。现在就走。”~
