@96601 = ~“不用客气。”~
@96602 = ~“我做了什么？”~
@96603 = ~“成为灵魂会怎么样？”~
@96604 = ~“请回到我的其他问题上来。”~
@96605 = ~“我想你疯了。”~
@96606 = ~“那真令人讨厌！”~
@96607 = ~“听起来很舒服……”~
@96608 = ~“无冬城究竟发生了什么？”~
@96609 = ~“再见。”~
@96610 = ~“请回到我的其他问题上来。”~
@96611 = ~“你是怎么死的？最后又怎么到这儿来的？”~
@96612 = ~“但是他们击败了你……”~
@96613 = ~“但是为什么？什么让你到了这样的地步？”~
@96614 = ~“你不爱范斯维克？”~
@96615 = ~“你带领的是谁的军队？”~
@96616 = ~“但是以前。你住在这里，不是吗？”~
@96617 = ~“什么虚伪？”~
@96618 = ~“现在不用，艾瑞贝丝。请时刻做好准备。”~
@96619 = ~“我希望你再次和我一起旅行。”~
@96620 = ~“应该说不是。我只是想揭一点你的疮疤而已。”~
@96621 = ~“把你的话留在肚子里跟我走吧。”~
@96622 = ~“对不起，现在不行。我们以后再谈。”~
@96623 = ~“怎么了，艾瑞贝丝？”~
@96624 = ~“再见。”~
@96625 = ~“好了，我没时间来听你的宗教传道。”~
@96626 = ~“你是专家。请解释一下九渊地狱的真相吧……”~
@96627 = ~“你对惩罚不同意么？”~
@96628 = ~“九渊地狱比我想像的要冷一些，那是肯定的。”~
@96629 = ~“请回到我的其他问题上来。”~
@96630 = ~“为什么是冰和熔岩？这没有意义。”~
@96631 = ~“靡菲斯特要回来了，不是吗？”~
@96632 = ~“他为什么会放弃这里？”~
@96633 = ~“神殿训练？”~
@96634 = ~“再见。”~
@96635 = ~“你别说了。我没时间听这些。”~
@96636 = ~“忘了无冬城吧！那不过是个充满傻瓜的城市。”~
@96637 = ~“什么回忆？”~
@96638 = ~“我猜是令人不快的回忆，是吗？”~
@96639 = ~“为什么领主纳什尔会感到恐慌？”~
@96640 = ~“告诉我他们怎么死的。”~
@96641 = ~“告诉我关于范斯维克和德斯泽尔的事。”~
@96642 = ~“再见。”~
@96643 = ~“那么就是我应该承担的责任。”~
@96644 = ~“别担心。我们需要的只是守门人的真名。”~
@96645 = ~“如果那是用来在世间行善的话。”~
@96646 = ~“等一下，我们首先需要给她自由。”~
@96647 = ~“别对我说教，好不好？我能干好！”~
@96648 = ~“怎么了？怕我学会你的本事？”~
@96649 = ~“我会留心的。”~
@96650 = ~“你的建议很好，艾瑞贝丝。我会留心的。”~
@96651 = ~“再见。”~
@96652 = ~“你怎么认出它的？”~
@96653 = ~“无知？”~
@96654 = ~“你认为你爱他。”~
@96655 = ~“你还小。”~
@96656 = ~“但是你以前从未来过。”~
@96657 = ~“你怎么认出这树的？”~
@96658 = ~“那么我觉得我们已找到了诸界智者。”~
@96659 = ~“别抱太大希望。”~
@96660 = ~“只是一棵老树而已。”~
@96661 = ~“什么树？”~
@96662 = ~“再见。”~
@96663 = ~“对，我正在计划怎样令这小兽痛苦地死去……”~
@96664 = ~“我忍不住想了解你为什么这么感兴趣……”~
@96665 = ~“你也会发抖的。这里实在是太冷了。”~
@96666 = ~“管好你自己吧，幽灵。我不感兴趣。”~
@96667 = ~“嗨，我原以为你已经变得善良了！”~
@96668 = ~“管好你自己吧……别笑了。”~
@96669 = ~“管好你自己就行了。我不感兴趣。”~
@96670 = ~“你在和我开玩笑吗？”~
@96671 = ~“期望？我原以为你很善良！”~
@96672 = ~“好吧，我不感兴趣，行了吧？”~
@96673 = ~“有点令人惊讶，但并不坏。”~
@96674 = ~“恋爱？”~
@96675 = ~“我……我只是觉得还没有准备好，艾瑞贝丝。”~
@96676 = ~“当它对死去的女孩起作用？对。绝对可怕。”~
@96677 = ~“可怕？应该说是恐怖！”~
@96678 = ~“不，我觉得我喜欢它……”~
@96679 = ~“喔唔，慢点。结婚？”~
@96680 = ~“再见。”~
@96681 = ~“我感觉到的只是时间和尘埃的重负。”~
@96682 = ~“对你来说是应该的，你这个叛徒……”~
@96683 = ~“好的，很高兴我不是唯一的一个。”~
@96684 = ~“很抱歉，我不是有意这么尖刻的。”~
@96685 = ~“是的，我感觉到了。感觉到了他的快乐。”~
@96686 = ~“好的，让我们好好研究一下。”~
@96687 = ~“看到你高兴真好。”~
@96688 = ~“你也是这样的，不是吗？”~
@96689 = ~“你想的就是这个。好了，别那么高兴了。”~
@96690 = ~“我只是想回家，艾瑞贝丝。”~
@96691 = ~“好的，我能感觉到它！但是你不能让我喜欢它……”~
@96692 = ~“希望能杀了你。”~
@96693 = ~“困在九渊地狱真是糟透了……”~
@96694 = ~“让我们把这事儿先放一放，好么？我们还有事要做。”~
@96695 = ~“你说的对，我需要放松一下。”~
@96696 = ~“我对道德说教不感兴趣，艾瑞贝丝。”~
@96697 = ~“再见。”~
@96698 = ~“那个通道后面除了复仇之外，就没有别的东西了。”~
@96699 = ~“没错，我必须心无邪念地去面对靡菲斯特。”~
@96700 = ~“希望没事。没关系。跟着走吧。”~
@96701 = ~“对于他们每个人来说。对我而言，这是复仇。”~
@96702 = ~“没错。我支持你。”~
@96703 = ~“我们心中都有个魔鬼，艾瑞贝丝。”~
@96704 = ~“我们走吧。”~
@96705 = ~[艾瑞贝丝]“双魂瓦达莉亚……”~
@96706 = ~“没事。别担心……”~
@96707 = ~“你不用对无冬城的事情感到愧疚。”~
@96708 = ~“你说的没错。我不会再向你提起那件事了。”~
@96709 = ~“你不知道吗？你这就是在赎罪……这不是很好吗……”~
@96710 = ~“我只是不想看到你这么难过。”~
@96711 = ~“是的，艾瑞贝丝。冰冷的死亡……”~
@96712 = ~“把你的灵魂交给我吧！”~
@96713 = ~“如果这意味着会失去你，那么我拒绝。”~
@96714 = ~“是的，我保证。”~
@96715 = ~[VFX.艾瑞贝丝变成冰冻状态。玩家获得对邪恶阵营的攻击加值]~
@96716 = ~“我命令你铲除邪恶，而不是打击正义。”~
@96717 = ~“我命令你……爱我……”~
@96718 = ~“就这些了，艾瑞贝丝。”~
@96719 = ~“那个通道通往未来，而不是过去。”~
@96720 = ~“我会去那边的。去到另外一边。”~
@96721 = ~“但是有人爱着你。”~
@96722 = ~“永远都不会太晚的，艾瑞贝丝。”~
@96723 = ~“你想让我去做吗？”~
@96724 = ~“不，艾瑞贝丝。我绝对不会。”~
@96725 = ~“嗯，虽然我们在一起觉得很愉快，不过我不认为那能称得上是爱情……”~
@96726 = ~“虽然这并不是我最佳的判断，不过恐怕我还是这么认为的。”~
@96727 = ~“是的。我是真心真意的。”~
@96728 = ~“你是我唯一的真爱。”~
@96729 = ~“留着以后再说吧，你这个幽灵。”~
@96730 = ~“有话尽管直说，艾瑞贝丝……”~
@96731 = ~“再见。”~
@96732 = ~“我已经没有时间听你在这里胡说八道了。”~
@96733 = ~“那么，以你专家的意见，你觉得这些地狱的天性是什么？”~
@96734 = ~“对于给你的惩罚，你没有争辩吗？”~
@96735 = ~“你觉得那怎么样？”~
@96736 = ~“回到我其他的问题上。”~
@96737 = ~“我觉得要暖和一些了，不过好像却变得更黑了？”~
@96738 = ~“计划一次突袭？”~
@96739 = ~“为什么他会放弃这个地方？”~
@96740 = ~“给定的选择？”~
@96741 = ~“再见。”~
@96742 = ~“那么你自己留心他们吧。”~
@96743 = ~“忘了无冬城！那只是个住满了白痴的城市。”~
@96744 = ~“什么回忆？”~
@96745 = ~“我想那会使你开心点儿。”~
@96746 = ~“为什么纳什尔领主会感到害怕？”~
@96747 = ~“告诉我他们是怎么死的。”~
@96748 = ~“告诉我范斯维克和德斯泽尔的事。”~
@96749 = ~“再见。”~
@96750 = ~“我很欣赏你的思考方式，艾瑞贝丝……”~
@96751 = ~“有什么令你困扰的吗？靡菲斯特已经把打败过他们一次了。”~
@96752 = ~“我对他们没什么兴趣……”~
@96753 = ~“太冒险了。不能太相信那些叛徒……”~
@96754 = ~“改过自新之人，那曲解了你的意思。”~
@96755 = ~“对不起。我不是那个意思，艾瑞贝丝。”~
@96756 = ~“那正是我要暗示的。我一直注视着你……”~
@96757 = ~“再见。”~
@96758 = ~“你认出它是来自哪里的了？”~
@96759 = ~“把它烧了？”~
@96760 = ~“你觉得你爱过他。”~
@96761 = ~“那时你还年轻。”~
@96762 = ~“但是你以前都没有来过这里。”~
@96763 = ~“你认出这树的来历了？”~
@96764 = ~“那么我想，我们找到诸界智者了。”~
@96765 = ~“别放弃希望。我们还有事情没做完。”~
@96766 = ~“这只是棵老树而已。”~
@96767 = ~“什么树？”~
@96768 = ~“再见。”~
@96769 = ~“实际上，我喜欢这样待着。这里真的是太自在了。”~
@96770 = ~“那么去别的地方享受吧。”~
@96771 = ~“这并不是你所享受到的所有东西……”~
@96772 = ~“如果你把这告诉了别的灵魂，我会把你的眼珠子挖出来的……”~
@96773 = ~“好吧。把这些钱拿去，给我闭上你的嘴。”~
@96774 = ~“你的生命？”~
@96775 = ~“你这个卑鄙的勒索者！”~
@96776 = ~“放手，你这个妓女。我才不会受你的诱惑呢。”~
@96777 = ~“亲爱的，真是针锋相对啊。现在轮到你了。”~
@96778 = ~“如果我知道你这么感兴趣的话……”~
@96779 = ~“再见。”~
@96780 = ~“你来应付它吧，公主……”~
@96781 = ~“是什么令你觉得这么难受？”~
@96782 = ~“我也不喜欢这里，但是我们需要他的帮助。”~
@96783 = ~“胡说。他很快就睡着了。”~
@96784 = ~“那么整个故事是怎样的？”~
@96785 = ~“我们走吧。”~
@96786 = ~“那个通道后面除了复仇之外，就没有别的东西了。”~
@96787 = ~“没错。我支持你。”~
@96788 = ~“我们心中都有个魔鬼，艾瑞贝丝。”~
@96789 = ~“我们走吧。”~
@96790 = ~[艾瑞贝丝]“双魂瓦达莉亚……”~
@96791 = ~“没事。别担心……”~
@96792 = ~“你不用对无冬城的事情感到愧疚。”~
@96793 = ~“把你的灵魂交给我吧！”~
@96794 = ~“如果这意味着会失去你，那么我拒绝。”~
@96795 = ~“是的，我保证。”~
@96796 = ~[VFX.艾瑞贝丝变成冰冻状态。玩家获得对邪恶阵营的攻击加值]~
@96797 = ~“我命令你铲除邪恶，而不是打击正义。”~
@96798 = ~“我命令你爱我！”~
@96799 = ~“就这些了，艾瑞贝丝。”~
@96800 = ~“那又有什么关系呢？”~
@96801 = ~“你想让我去做吗？”~
@96802 = ~“你打算怎么办？”~
@96803 = ~“不，艾瑞贝丝。我决不会那么干……”~
@96804 = ~“是的，虽然这并不是我最佳的判断，不过恐怕我还是这么认为的。”~
@96805 = ~“是的，以我心中所有的邪恶保证。”~
@96806 = ~“是的，你是我唯一的真爱。”~
@96807 = ~“不，艾瑞贝丝。我决不会那么干……”~
@96808 = ~“嗯，虽然我们在一起觉得很愉快，不过我不认为那能称得上是爱情……”~
@96809 = ~“虽然这并不是我最佳的判断，不过恐怕我还是这么认为的。”~
@96810 = ~“是的。以我心中所有的邪恶保证。”~
@96811 = ~“你是我唯一的真爱。”~
@96812 = ~“来，温柔的灵魂。结束我们的关系吧。”~
@96813 = ~“你在这里休息一会儿吧。我要独自上路了。”~
@96814 = ~“来，温柔的灵魂。结束我们的关系吧。”~
@96815 = ~“你想干什么就干什么。我对你已经没有利用价值了。”~
@96816 = ~“再见。”~
@96817 = ~“我知道你曾经挑战过靡菲斯特。”~
@96818 = ~“靡菲斯特的反应怎样？”~
@96819 = ~“你爱过他与否，为什么那么重要？”~
@96820 = ~“一旦你堕入邪恶，将难以自拔。”~
@96821 = ~“好的。泰尔选择了你做他的圣武士。难道你怀疑他的智慧吗？”~
@96822 = ~“那么继续以你心中的邪恶去追随它吧！”~
@96823 = ~“你正身处九渊地狱。现在再怀疑你的本性有点太晚了。”~
@96824 = ~“看起来你还是比较适于邪恶，艾瑞贝丝。”~
@96825 = ~“为了复仇，难道你不想变得更强大吗？”~
@96826 = ~“泰尔选择了你做他的圣武士。难道你怀疑他的智慧吗？”~
@96827 = ~“没错。一旦你堕入邪恶，将难以自拔。”~
@96828 = ~“你这么做是由于正义的信念。”~
@96829 = ~“让泰尔决定他是否愿意接纳你吧。”~
@96830 = ~“你不是在孤军奋战。”~
@96831 = ~“那么在这巴托地狱的深处，表现出正气来吧。”~
@96832 = ~“那么是泰尔的错误，和你无关。”~
@96833 = ~“如果不是因为爱，你为什么要那么做？”~
@96834 = ~“靡菲斯特想要你去感受一下。”~
@96835 = ~“你本来是要结婚的，你怎么又不爱他了？”~
@96836 = ~“靡菲斯特是在玩弄你的感情。”~
@96837 = ~“我也是按照自己的准则生活的。”~
@96838 = ~“但是你相信什么，善良还是邪恶？”~
@96839 = ~“我想我以前在什么地方见过你。”~
@96840 = ~“为什么你想要忘记它们？”~
@96841 = ~“我不会让那种事情发生的。”~
@96842 = ~“那么，我该关心什么？”~
@96843 = ~“我能理解。”~
@96844 = ~“你并不想那样。”~
@96845 = ~“你为什么攻击我？”~
@96846 = ~“我想我以前在什么地方见过你。”~
@96847 = ~“我想问你几个问题。”~
@96848 = ~“我相信你犯了个错误。”~
@96849 = ~“我要拷问你。”~
@96850 = ~“我需要你的帮助。”~
@96851 = ~“我感到很抱歉。”~
@96852 = ~“你全身冰凉，我想让你暖和些。”~
@96853 = ~“我正在寻找沉睡者的五个秘密。”~
@96854 = ~“回到我其他的问题上。”~
@96855 = ~“你知不知道问题的答案？”~
@96856 = ~“我亲爱的女士，你一定要帮帮我。”~
@96857 = ~“那么告诉我答案吧。”~
@96858 = ~“神祇怎么会怨恨你？”~
@96859 = ~“你爱着的这个男人是谁？”~
@96860 = ~离开。~
@96861 = ~用三个维洛克斯莓点个大火。~
@96862 = ~用两个维洛克斯莓点个中等规模的火。~
@96863 = ~用一个维洛克斯莓点个小火。~
@96864 = ~用燧石和火绒点火。~
@96865 = ~一道看起来很悲伤的微光停在你前面。它是个亡者的灵魂，从这里流放到卡尼亚。如果不是因为在它透明的身躯上结了一层冰，你怀疑自己根本就不可能看到它。~
@96866 = ~“在这外面很冷，总是冷得刺骨……如果你想用火来暖和你自己的话，还是省点力气吧……看见那些绿色的火光了没有？甚至连它们都不能够……你看，这只是个时间问题……”~
@96867 = ~“我能吗……我能吗……那些知道收割者真名的人都会命令他让你去很远很远的地方……据我所知，只有一个人知道这个答案……”~
@96868 = ~“靡菲斯特，我要诅咒这个名字……”~
@96869 = ~“欢迎来到亡魂之城，我们在卡尼亚冰冻荒地上破烂的营地……我们围绕着这些特别的门，在这里建造了它……我们是最近做的吗？……也许吧……这已经很难回想起来了……”~
@96870 = ~你面前的这个灵魂渐渐地消失，忽然又因为一层新的冰霜而又重新显现出来。~
@96871 = ~“你是第一次来到这个位面？……嗯，对于这个世界，你只能知道，这里只是多元宇宙无数个纠缠不清的次元和空间中的一个……”~
@96872 = ~“这个世界或者说位面，叫做卡尼亚，是结合在一起形成巴托地狱的少数几个位面之一……它也和其他许多类似的界域一起构成了外层位面，也就是死后灵魂去到的地方。”~
@96873 = ~“还有无数其他的位面和位面群，它们的数量太多，不胜其数……你需要自己去领会……”~
@96874 = ~“巴托地狱只有九重，魔王阿斯莫德斯居住在最深那层……而在恶魔居住的深渊魔域，据说有无数变化无穷的痛苦之地……”~
@96875 = ~“有人说他们间的区别其实微乎其微……尽管如此，他们是残酷的敌人，在永无休止的跨位面的血战中充分体现出了他们的邪恶……”~
@96876 = ~“但恶魔和魔鬼也有他们自己的等级制度，所以也许简单说来，所有炼狱生物的天性就是战斗……这些问题最好留给哲学家去解答，而不是我们这些亡者的灵魂……”~
@96877 = ~“当然，我们灵体的数量日渐减少……魔鬼们在这里也建了个前哨，卡尼亚远方的首都需要大量开采的冰块。”~
@96878 = ~“于是就有些吉斯泽莱朝圣者旅行到这里来看沉睡者，结果现在回不了家了……”~
@96879 = ~这个灵魂搓了搓自己的双手来取暖，一缕冻霜从它的手指间掉了下来。~
@96880 = ~“我只知道沉睡者在城市的西北部沉睡着，没人知道他那样有多久了……有人说他从创始之初开始就在那里了……”~
@96881 = ~“几十年前，一名吉斯泽莱女人在他周围建了一座神殿，从各个位面带领朝圣者来拜他……她知道的肯定更多……”~
@96882 = ~“大多数是僧侣和学者……他们现在在城镇南边的地狱气息酒馆里喝着麦酒、数着铜币来打发时光。”~
@96883 = ~“谁知道为什么魔鬼们要这么做？你最好问问采石场的老板戈鲁乌。”~
@96884 = ~“靡菲斯特在一个遥远的名叫托瑞尔的世界里统领着一支亡者大军，他把我们的本源吸出来，想要操纵它们……为此他毁灭了我们这么多人的灵魂，而且还要毁灭更多的……我们都像是白色的空气一样……”~
@96885 = ~“是的，关于城市的居民？”~
@96886 = ~“有一个人试过……她是我们中最大胆的一个，充满了生命的力量……她反抗靡菲斯特，而他出于愤怒，不知道对她干了什么……她成为失魂者只是时间问题了……”~
@96887 = ~“失魂者就是那些对生命不再眷恋的灵魂……他们是那些已经放弃了的人……冰块把他们消灭掉了，他们被吸收成了组成卡尼亚位面的绝望本源。”~
@96888 = ~“公证者就是在这里，把名字刻进这令人无法忘记的冰里的……在卡尼亚的传送门这个地方，灵魂们失去了回家的希望。”~
@96889 = ~“我们这些灵体在这里都不用名字……由于活着时发生的恐怖事情，我们死后被带到了卡尼亚……最好不要再管生前的事情……最好把那些都忘掉……”~
@96890 = ~“人所共知，只有当我们的名字刻在冰里的时候，我们才是失魂者……如果我们知道了这点，就不再被困扰了……”~
@96891 = ~“这是由一只叫做公证者的生物所完成的，但现在它的前任向导已经被靡菲斯特毁灭了……没人去引导公证者，谁也不知道将会发生什么事情。”~
@96892 = ~“我不太确定它究竟是人还是动物……从某些方面来说，它更像一只宠物，而不像个人……它的前任向导教过它一些简单的词语描述，所以也能说几句话……”~
@96893 = ~“但是，就这里任何人的记忆来说，公证者就是把失魂者的名字刻进冰里的那个生物……如果你靠近了看，就能发现冰块深处刻满了名字……这就是这座城市得名的原因……”~
@96894 = ~“只是像我们一样的亡魂……但是达布西是一个友善的种族，一生都献身于服务工作……他们天生就可以用将图像投射在头顶上的方式来交谈……”~
@96895 = ~“只是像我们一样的亡魂……但现在他只是被靡菲斯特毁灭的一个受害者……已经被夺走了很多东西……很多很多……”~
@96896 = ~“她来到这里，充满了愤怒、激情以及希望……她就是这冰原里的一个火堆，我们都被她的温暖吸引了过去……当靡菲斯特来传送门这里宣布开始毁灭的时候，她勇敢地站出来向他挑战……”~
@96897 = ~“不知道他做了什么，她的生命之火被吸干了……她不再说话，而是把自己关在城镇中心的那个洞穴里面……现在她还住在里面，慢慢地变得冰冷，就快要成为一名失魂者了……”~
@96898 = ~“是的……你能够拯救她可怜的灵魂……由于靡菲斯特的关系，她就要变成失魂者了……这只是时间问题……”~
@96899 = ~“要想帮她，得先帮助公证者……当公证者把她的名字刻进冰里面的那一刹那，她就会变成失魂者了……虽然这并不宁静，但比起受折磨要好多了……”~
@96900 = ~这个灵魂颤抖了一下，你不知道是因为恐惧还是因为突如其来的寒风。“这命运真是比死亡和坠入地狱还要糟糕……一个人的灵魂如果被毁灭了，就什么都没有了……”~
@96901 = ~“因为在那个位面上，邪恶的力量会变得非常强大，所以阿斯莫德斯禁止其他的地狱领主到那里去……但不知道靡菲斯特用了什么方法，使得他的力量可以不受束缚……”~
@96902 = ~“在城市各处的无数层冰块里刻着的就是失魂者的名字……但并不是没人知道的真名……这些是他们生前的名字……是便于我们记忆的……”~
@96903 = ~这个灵魂开始喋喋不休，那幽灵般的细语声可以算是他们最真实的东西了。~
@96904 = ~“失魂者就是那些对生命不再眷恋的灵魂……他们是那些已经放弃了的人……冰块把他们消灭掉了，他们被吸收成了组成卡尼亚位面的绝望本源。”~
@96905 = ~“公证者就在卡尼亚的传送门把名字刻进那令人无法忘记的冰里……我们当中有一个人敢于对抗靡菲斯特……现在她也快成为失魂者了……”~
@96906 = ~“她来到这里，充满了愤怒、激情以及希望……她就是这冰原里的一个火堆，我们都被她的温暖吸引了过去……当靡菲斯特来传送门这里宣布开始毁灭的时候，她勇敢地站出来向他挑战……”~
@96907 = ~“不知道他做了什么，她的生命之火被吸干了……她不再说话，而是把自己关在城镇中心的那个洞穴里面……现在她还住在里面，慢慢地变得冰冷，就快要成为一名失魂者了……”~
@96908 = ~“是的……你能够拯救她可怜的灵魂……由于靡菲斯特的关系，她就要变成失魂者了……这只是时间问题……”~
@96909 = ~“要想帮她，得先帮助公证者……当公证者把她的名字刻进冰里面的那一刹那，她就会变成失魂者了……虽然这并不宁静，但比起受折磨要好多了……”~
@96910 = ~“我不太确定它究竟是人还是动物……从某些方面来说，它更像一只宠物，而不像个人……它的前任向导教过它一些简单的词语描述，所以也能说几句话……”~
@96911 = ~“但是，就这里任何人的记忆来说，公证者就是把失魂者的名字刻进冰里的那个生物……如果你靠近了看，就能发现冰块深处刻满了名字……这就是这座城市得名的原因……”~
@96912 = ~“只是像我们一样的亡魂……但是达布西是一个友善的种族，一生都献身于服务工作……他们天生就可以用将图像投射在头顶上的方式来交谈……”~
@96913 = ~“只是像我们一样的亡魂……但现在他只是被靡菲斯特毁灭的一个受害者……已经被夺走了很多东西……很多很多……”~
@96914 = ~“这是由一只叫做公证者的生物所完成的，但现在它的前任向导已经被靡菲斯特毁灭了……没人去引导公证者，谁也不知道将会发生什么事情。”~
@96915 = ~“我不太确定它究竟是人还是动物……从某些方面来说，它更像一只宠物，而不像个人……它的前任向导教过它一些简单的词语描述，所以也能说几句话……”~
@96916 = ~“但是，就这里任何人的记忆来说，公证者就是把失魂者的名字刻进冰里的那个生物……如果你靠近了看，就能发现冰块深处刻满了名字……这就是这座城市得名的原因……”~
@96917 = ~“只是像我们一样的亡魂……但是达布西是一个友善的种族，一生都献身于服务工作……他们天生就可以用将图像投射在头顶上的方式来交谈……”~
@96918 = ~“只是像我们一样的亡魂……但现在他只是被靡菲斯特毁灭的一个受害者……已经被夺走了很多东西……很多很多……”~
@96919 = ~“它们层层相叠，盖住了这个城市里的每一面墙……没人知道那有多深……也没人记得……有人说自从沉睡者出现，公证者就开始雕刻它们了……”~
@96920 = ~“我不太确定它究竟是人还是动物……从某些方面来说，它更像一只宠物，而不像个人……它的前任向导教过它一些简单的词语描述，所以也能说几句话……”~
@96921 = ~“但是，就这里任何人的记忆来说，公证者就是把失魂者的名字刻进冰里的那个生物……如果你靠近了看，就能发现冰块深处刻满了名字……这就是这座城市得名的原因……”~
@96922 = ~“只是像我们一样的亡魂……但是达布西是一个友善的种族，一生都献身于服务工作……他们天生就可以用将图像投射在头顶上的方式来交谈……”~
@96923 = ~“只是像我们一样的亡魂……但现在他只是被靡菲斯特毁灭的一个受害者……已经被夺走了很多东西……很多很多……”~
@96924 = ~“是的，他在一个遥远的名叫托瑞尔的世界里统领着一支亡者大军，他把我们的本源吸出来，想要操纵它们……为此他毁灭了我们这么多人的灵魂，而且还要毁灭更多的……我们都像是白色的空气一样……”~
@96925 = ~这个灵魂点了点头，冰霜像雪一样落在它的脸上。~
@96926 = ~“有一个人试过……她是我们中最大胆的一个，充满了生命的力量……她反抗靡菲斯特，而他出于愤怒，不知道对她干了什么……她成为失魂者只是时间问题了……”~
@96927 = ~“失魂者就是那些对生命不再眷恋的灵魂……他们是那些已经放弃了的人……冰块把他们消灭掉了，他们被吸收成了组成卡尼亚位面的绝望本源。”~
@96928 = ~“公证者就在卡尼亚的传送门把名字刻进那令人无法忘记的冰里……我们当中有一个人敢于对抗靡菲斯特……现在她也快成为失魂者了……”~
@96929 = ~“她来到这里，充满了愤怒、激情以及希望……她就是这冰原里的一个火堆，我们都被她的温暖吸引了过去……当靡菲斯特来传送门这里宣布开始毁灭的时候，她勇敢地站出来向他挑战……”~
@96930 = ~“不知道他做了什么，她的生命之火被吸干了……她不再说话，而是把自己关在城镇中心的那个洞穴里面……现在她还住在里面，慢慢地变得冰冷，就快要成为一名失魂者了……”~
@96931 = ~“是的……你能够拯救她可怜的灵魂……由于靡菲斯特的关系，她就要变成失魂者了……这只是时间问题了……”~
@96932 = ~“要想帮她，得先帮助公证者……当公证者把她的名字刻进冰里面的那一刹那，她就会变成失魂者了……虽然这并不宁静，但比起受折磨要好多了……”~
@96933 = ~“我不太确定它究竟是人还是动物……从某些方面来说，它更像一只宠物，而不像个人……它的前任向导教过它一些简单的词语描述，所以也能说几句话……”~
@96934 = ~“但是，就这里任何人的记忆来说，公证者就是把失魂者的名字刻进冰里的那个生物……如果你靠近了看，就能发现冰块深处刻满了名字……这就是这座城市得名的原因……”~
@96935 = ~“只是像我们一样的亡魂……但是达布西是一个友善的种族，一生都献身于服务工作……他们天生就可以用将图像投射在头顶上的方式来交谈……”~
@96936 = ~“只是像我们一样的亡魂……但现在他只是被靡菲斯特毁灭的一个受害者……已经被夺走了很多东西……很多很多……”~
@96937 = ~“我们这些灵体在这里都不用名字……由于活着时发生的恐怖事情，我们死后被带到了卡尼亚……最好不要再管生前的事情……最好把那些都忘掉……”~
@96938 = ~“人所共知，只有当我们的名字刻在冰里的时候，我们才是失魂者……如果我们知道了这点，就不再被困扰了……”~
@96939 = ~“这是由一只叫做公证者的生物所完成的，但现在它的前任向导已经被靡菲斯特毁灭了……没人去引导公证者，谁也不知道将会发生什么事情。”~
@96940 = ~“我不太确定它究竟是人还是动物……从某些方面来说，它更像一只宠物，而不像个人……它的前任向导教过它一些简单的词语描述，所以也能说几句话……”~
@96941 = ~“但是，就这里任何人的记忆来说，公证者就是把失魂者的名字刻进冰里的那个生物……如果你靠近了看，就能发现冰块深处刻满了名字……这就是这座城市得名的原因……”~
@96942 = ~“只是像我们一样的亡魂……但是达布西是一个友善的种族，一生都献身于服务工作……他们天生就可以用将图像投射在头顶上的方式来交谈……”~
@96943 = ~“只是像我们一样的亡魂……但现在他只是被靡菲斯特毁灭的一个受害者……已经被夺走了很多东西……很多很多……”~
@96944 = ~“她来到这里，充满了愤怒、激情以及希望……她就是这冰原里的一个火堆，我们都被她的温暖吸引了过去……当靡菲斯特来传送门这里宣布开始毁灭的时候，她勇敢地站出来向他挑战……”~
@96945 = ~“不知道他做了什么，她的生命之火被吸干了……她不再说话，而是把自己关在城镇中心的那个洞穴里面……现在她还住在里面，慢慢地变得冰冷，就快要成为一名失魂者了……”~
@96946 = ~“是的……你能够拯救她可怜的灵魂……由于靡菲斯特的关系，她就要变成失魂者了……这只是时间问题……”~
@96947 = ~“要想帮她，得先帮助公证者……当公证者把她的名字刻进冰里面的那一刹那，她就会变成失魂者了……虽然这并不宁静，但比起受折磨要好多了……”~
@96948 = ~这个灵魂颤抖了一下，你不知道是因为恐惧还是因为突如其来的寒风。“这命运真是比死亡和坠入地狱还要糟糕……一个人的灵魂如果被毁灭了，就什么都没有了……”~
@96949 = ~“因为在那个位面上，邪恶的力量会变得非常强大，所以魔王阿斯莫德斯禁止其他的地狱领主到那里去……但不知道靡菲斯特用了什么方法，使得他的力量可以不受束缚……”~
@96950 = ~“我只知道沉睡者在城市的西北部沉睡着，没人知道他那样有多久了……有人说从他创始之初开始就在那里了……”~
@96951 = ~“几十年前，一名吉斯泽莱女人在他周围建了一座神殿，从各个位面带领朝圣者来拜他……她知道的肯定更多……”~
@96952 = ~“亡者的灵魂一旦成为失魂者，确实就会被卡尼亚吸收，转生成魔鬼……但他们生前的所有事情都会丢失，包括那令人厌烦的名字……”~
@96953 = ~“只有真名还存留着，那不是刻进城市墙壁里的那个名字……恐怕那里已经没什么能够帮得上你了……”~
@96954 = ~“我现在是谁？……一个幽灵，一名请求者，一个亡者的灵魂，一段已逝的记忆……我曾经是谁？……一个叛徒，一个杀人犯，还是个人贩？……我现在都已经忘记了……但这是有原因的……”~
@96955 = ~“善良是什么？……邪恶是什么？……也许我杀了我唯一的真爱……也许为了养活两个孩子而卖掉了另一个……也许我背叛了我并不信仰的某件事……也许还有别的事情，我也做错了……”~
@96956 = ~“不管是哪种都没关系……无论我生前做过什么都没关系，问题只是我选择来到这里，在这个破旧的帐篷里苟延残喘……现在我在这里，但迟早还是会消逝……”~
@96957 = ~“要么等靡菲斯特把我们的灵魂都毁掉，要么我们抵受不了寒冷而成为失魂者……我只是想活着，想回家……但那是不可能的了……”~
@96958 = ~这个灵魂沉闷地叹了口气，它幽灵般的呼吸结上了一层白霜。~
@96959 = ~“我们也都想那样，哪怕只有一小会儿……这就是我们聚集在此的原因，在亡魂之城等待、期望、梦想，然后逐渐失去热情……这只是迟早的问题……”~
@96960 = ~“靡菲斯特已经把传送门封上了，我们这些灵魂没法穿过了……至少以前我们还有机会可以到死去的地方出没一下，但现在不行了……从这里已经出不去了……”~
@96961 = ~“不，但很接近……你在那个地方可以闻也可以尝东西……你可以看见你所爱的和所赠的那些人的面孔……可以感觉到各种情绪，就像活着一样……”~
@96962 = ~“也许他不想被人跟着……而且，我也不认为他还会回来……他是托瑞尔世界的强者，每天都要毁灭我们很多灵魂……我们都像是白色的空气一样……”~
@96963 = ~“失魂者就是那些对生命不再眷恋的灵魂……他们是那些已经放弃了的人……冰块把他们消灭掉了，他们被吸收成了组成卡尼亚位面的绝望本源。”~
@96964 = ~“公证者就在卡尼亚的传送门把名字刻进那令人无法忘记的冰里……我们当中有一个人敢于对抗靡菲斯特……现在她也快成为失魂者了……”~
@96965 = ~“她来到这里，充满了愤怒、激情以及希望……她就是这冰原里的一个火堆，我们都被她的温暖吸引了过去……当靡菲斯特来传送门这里宣布开始毁灭的时候，她勇敢地站出来向他挑战……”~
@96966 = ~“不知道他做了什么，她的生命之火被吸干了……她不再说话，而是把自己关在城镇中心的那个洞穴里面……现在她还住在里面，慢慢地变得冰冷，就快要成为一名失魂者了……”~
@96967 = ~“是的……你能够拯救她可怜的灵魂……由于靡菲斯特的关系，她就要变成失魂者了……这只是时间问题……”~
@96968 = ~“要想帮她，得先帮助公证者……当公证者把她的名字刻进冰里面的那一刹那，她就会变成失魂者了……虽然这并不宁静，但比起受折磨要好多了……”~
@96969 = ~“我不太确定它究竟是人还是动物……从某些方面来说，它更像一只宠物，而不像个人……它的前任向导教过它一些简单的词语描述，所以也能说几句话……”~
@96970 = ~“但是，就这里任何人的记忆来说，公证者就是把失魂者的名字刻进冰里的那个生物……如果你靠近了看，就能发现冰块深处刻满了名字……这就是这座城市得名的原因……”~
@96971 = ~“只是像我们一样的亡魂……但是达布西是一个友善的种族，一生都献身于服务工作……他们天生就可以用将图像投射在头顶上的方式来交谈……”~
@96972 = ~“只是像我们一样的亡魂……但现在他只是被靡菲斯特毁灭的一个受害者……已经被夺走了很多东西……很多很多……”~
@96973 = ~“是的，他在一个遥远的名叫托瑞尔的世界里统领着一支亡者大军，他把我们的本源吸出来，想要操纵它们……为此他毁灭了我们这么多人的灵魂，而且还要毁灭更多的……我们都像是白色的空气一样……”~
@96974 = ~这个灵魂打了个冷战，等你继续说下去。~
@96975 = ~“有一个人试过……她是我们中最大胆的一个，充满了生命的力量……她反抗靡菲斯特，而他出于愤怒，不知道对她干了什么……她成为失魂者只是时间问题了……”~
@96976 = ~“失魂者就是那些对生命不再眷恋的灵魂……他们是那些已经放弃了的人……冰块把他们消灭掉了，他们被吸收成了组成卡尼亚位面的绝望本源。”~
@96977 = ~“公证者就是在这里，把名字刻进这令人无法忘记的冰里的……在卡尼亚的传送门这个地方，灵魂们失去了回家的希望。”~
@96978 = ~“我们这些灵体在这里都不用名字……由于活着时发生的恐怖事情，我们死后被带到了卡尼亚……最好不要再管生前的事情……最好把那些都忘掉……”~
@96979 = ~“人所共知，只有当我们的名字刻在冰里的时候，我们才是失魂者……如果我们知道了这点，就不再被困扰了……”~
@96980 = ~“这是由一只叫做公证者的生物所完成的，但现在它的前任向导已经被靡菲斯特毁灭了……没人去引导公证者，谁也不知道将会发生什么事情。”~
@96981 = ~“我不太确定它究竟是人还是动物……从某些方面来说，它更像一只宠物，而不像个人……它的前任向导教过它一些简单的词语描述，所以也能说几句话……”~
