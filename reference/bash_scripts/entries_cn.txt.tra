@88436 = ~“对使用。”~
@88437 = ~“对使用。”~
@88438 = ~“对使用。”~
@88439 = ~“对使用。”~
@88440 = ~“对使用。”~
@88441 = ~“对我的动物伙伴使用。”~
@88442 = ~“对我的魔宠使用。”~
@88443 = ~“对我使用。”~
@88444 = ~“对你自己使用。”~
@88445 = ~“祝福术。”~
@88446 = ~“操纵死尸。”~
@88447 = ~“强酸术。”~
@88448 = ~“你刚才想说什么？”~
@88449 = ~“等等，我们谈谈。”~
@88450 = ~“话都说完了。”~
@88451 = ~“没，没事。”~
@88452 = ~“我只是想了解你的情况。”~
@88453 = ~“我想谈谈你的训练。”~
@88454 = ~“随便你做什么吧，德金。”~
@88455 = ~“该做什么就做什么去吧。”~
@88456 = ~“努力做个红龙龙脉术士吧。”~
@88457 = ~“我希望你能成为一个吟游诗人。”~
@88458 = ~“我想知道……这次冒险结束后你想做什么？”~
@88459 = ~“是的，在那之后。”~
@88460 = ~“是的是的，那本书以后。”~
@88461 = ~“你真他妈应该多赚一笔。”~
@88462 = ~“你真的认为自己会那么做？”~
@88463 = ~“你为什么要回去？”~
@88464 = ~“你不想和我在一起吗？”~
@88465 = ~“那么做似乎很离谱。”~
@88466 = ~“你想把部落迁到文明社会？为什么？”~
@88467 = ~“不管你想做什么，自己疯去吧。”~
@88468 = ~“好吧……还是先把这次冒险完成再说吧。”~
@88469 = ~“不知我能不能帮上忙……”~
@88470 = ~“真是很崇高的理想。”~
@88471 = ~“你真的认为自己能改变他们？”~
@88472 = ~“讲个好听的故事如何？”~
@88473 = ~“你说我们完蛋了？”~
@88474 = ~“你真的有？什么时候的事？”~
@88475 = ~“你怎么不用正常一点的方式做？”~
@88476 = ~“你好像很走运。”~
@88477 = ~“然后呢？”~
@88478 = ~“最后你们离开了？”~
@88479 = ~“我很满意，德金。”~
@88480 = ~“好吧好吧好吧，我们继续。”~
@88481 = ~“你很想我？噢，德金……”~
@88482 = ~“你没法保护她？”~
@88483 = ~“很对不起，德金，太可怕了。”~
@88484 = ~“她在外面做什么？”~
@88485 = ~“不会和你遇上巨龙那次一样吧？”~
@88486 = ~“接着讲。”~
@88487 = ~“你忘了拿琴？”~
@88488 = ~“黑暗精灵？在深水城里？你确信？”~
@88489 = ~“听起来的确是黑暗精灵。”~
@88490 = ~“我听到过那阵尖叫声。”~
@88491 = ~“他放你走了？”~
@88492 = ~“他没把名字告诉你？”~
@88493 = ~“德里皮茨？听起来可不像黑暗精灵的名字。”~
@88494 = ~“真的？哪种龙？”~
@88495 = ~“在深水城里？”~
@88496 = ~“你怎么知道的？”~
@88497 = ~“他去山顶村吃馅饼？”~
@88498 = ~“那条金龙呢？他想做什么？”~
@88499 = ~“这就是你遇上另一条龙的故事？”~
@88500 = ~“呃……我发现你长出翅膀了……”~
@88501 = ~“你能飞吗？”~
@88502 = ~“长翅膀的狗头人，真有意思。”~
@88503 = ~“你不想这样吗？”~
@88504 = ~“你不喜欢翅膀？”~
@88505 = ~“*这*就是你的牢骚？”~
@88506 = ~“学着知足吧。”~
@88507 = ~“红色比白色有型多了。”~
@88508 = ~“比起刚见面的时候，你有点变了。”~
@88509 = ~“现在很奇怪？”~
@88510 = ~“你最好别有这个意思，狗头人。”~
@88511 = ~“尽量抵制这种欲望，德金。”~
@88512 = ~“呃……是啊……”~
@88513 = ~“如果这能让你变强，我很支持。”~
@88514 = ~“很高兴你对自己的成就感到满意。”~
@88515 = ~“老大也不想变成那样。”~
@88516 = ~“对我说什么？”~
@88517 = ~“你当然能变强……”~
@88518 = ~“的确有*一点*奇怪。”~
@88519 = ~“不。你认为它会导致什么结果？”~
@88520 = ~“如果你有那份能力，就尽量做个红龙龙脉术士吧。”~
@88521 = ~“实际上，我也欢迎吟游诗人。”~
@88522 = ~“我不能给你建议，德金。”~
@88523 = ~“上次分手之后你有什么遭遇？”~
@88524 = ~“为什么你没走远？”~
@88525 = ~“你知道你可以去找我的。”~
@88526 = ~“实际上你的书我也收了一本。”~
@88527 = ~“我们谈论的东西值多少钱？”~
@88528 = ~“其中一份应该是我的。”~
@88529 = ~“你应该多要一笔的。”~
@88530 = ~“唉。你要是稍微聪明一点也不会这样。”~
@88531 = ~“你就这么被宰了一刀？”~
@88532 = ~“你还想怎么样？你是个狗头人而已。”~
@88533 = ~“我不知道该说什么，可怕。”~
@88534 = ~“无论如何，就这么样吧。继续赶路吧，好吗？”~
@88535 = ~“我完全信任你，德金。”~
@88536 = ~“好吧，祝你好运。”~
@88537 = ~“我认为你很迷人，德金。”~
@88538 = ~“那么你要放弃？”~
@88539 = ~“你没教训他？你可不是软蛋。”~
@88540 = ~“你认为自己很弱？”~
@88541 = ~“小德金和我并肩抵抗强大的怪兽。”~
@88542 = ~“无论从哪个角度，你都是很强的诗人。”~
@88543 = ~“似乎你的日子也不好过。”~
@88544 = ~“是吗？我记得那本书相当畅销。”~
@88545 = ~“不错嘛。”~
@88546 = ~“你了解海拉斯特的事情吗？”~
@88547 = ~“也许我晚些还会问你。”~
@88548 = ~“那就把你知道的告诉我。”~
@88549 = ~“继续。”~
@88550 = ~“后来怎么样了？你知道吗？”~
@88551 = ~“深水城怎么会扩建到山下地城上方？”~
@88552 = ~“那么怪物都是从山下地城来的？”~
@88553 = ~“山下地城可不像是矮人的矿脉。”~
@88554 = ~“那些矮人怎么了？”~
@88555 = ~“他为什么跑到矿井里？”~
@88556 = ~“这是多久以前的事？”~
@88557 = ~“高塔？它还在深水城里吗？”~
@88558 = ~“他的徒弟们还活着？”~
@88559 = ~“好吧，我希望你学到了教训。”~
@88560 = ~“好吧。我暂时原谅你。”~
@88561 = ~“算了！我受够你了！”~
@88562 = ~“还不够！”[继续骂]~
@88563 = ~“现在还不行。留在这里吧。”~
@88564 = ~“好的，来吧。”~
@88565 = ~“现在不行，德金。”~
@88566 = ~“有事吗，德金？”~
@88567 = ~“明说了吧，狗头人，我们不是朋友。”~
@88568 = ~“真的？我认为你只是个佣兵而已。”~
@88569 = ~“噢……很高兴你这么说，德金。”~
@88570 = ~“好啊，我们走吧。”~
@88571 = ~“你赢得了与我并肩战斗的资格，德金。”~
@88572 = ~“还有谁能记载我的传奇？”~
@88573 = ~“当然，你很有趣。”~
@88574 = ~“你应该明白自己现在有多强大吧？”~
@88575 = ~“我也把你当成挚友。”~
@88576 = ~“不，继续……你刚才想说什么？”~
@88577 = ~“没关系，德金，你可以告诉我。”~
@88578 = ~“来吧德金，告诉我吧。”~
@88579 = ~“哦。这个……是的，继续……”~
@88580 = ~“那么好吧。”~
@88581 = ~“你一定有自己的想法。”~
@88582 = ~“为什么要问我？”~
@88583 = ~“不，我真的不在意。”~
@88584 = ~“出版商不会再用你的名字作书名吧？”~
@88585 = ~“叫《<CHARNAME>·<CHARNAME>大冒险》如何？”~
@88586 = ~“除了《幽城魔影》以外叫什么都行。”~
@88587 = ~“那就叫《幽城魔影》吧。”~
@88588 = ~“完成。”~
@88589 = ~“有事？”~
@88590 = ~“我真的不在意。”~
@88591 = ~“你怎么能擅自对我做评价？”~
@88592 = ~“你认为我很自负？”~
@88593 = ~“你认为我很敏感？”~
@88594 = ~“我实在不希望你把我写进书里。”~
@88595 = ~“随便你怎么写，别理我。”~
@88596 = ~“你现在怎么形容我的？”~
@88597 = ~“德金，把我写得越完美越好吧。”~
@88598 = ~“我认为保持原有风格就好。”~
@88599 = ~“你不用刻意美化我，实事求是吧。”~
@88600 = ~“我感觉不错。”~
@88601 = ~“我当然记得泰莫法拉。听说他还是老样子。”~
@88602 = ~“想不起来。”~
@88603 = ~“他提到你的时候带某种感情……”~
@88604 = ~“你想知道什么？”~
@88605 = ~“不。不过你能这样做的话更好。”~
@88606 = ~“他说你有龙的血统？真的吗？”~
@88607 = ~“也许真有可能，谁知道呢。”~
@88608 = ~“是的，我有注意到。”~
@88609 = ~“我真的想不起来。”~
@88610 = ~“对不起，德金，他没说过。”~
@88611 = ~“没，他没有。就当没这回事吧。”~
@88612 = ~“那是很久以前的事了，德金。”~
@88613 = ~“你想知道细节吗？”~
@88614 = ~“泰莫法拉？当然，我记得把他杀了。”~
@88615 = ~“呃……白龙？不……时间太久了。”~
@88616 = ~“你不喜欢深水城？”~
@88617 = ~“还有？”~
@88618 = ~“算了，悲伤的故事还是自己留着吧。”~
@88619 = ~“你抱怨他们太野蛮？”~
@88620 = ~“生活可不是那样的，小家伙。”~
@88621 = ~“很抱歉事情没办好，德金。”~
@88622 = ~“我对你不够好。”~
@88623 = ~“这是今天我所听到最让人难过的事了。”~
@88624 = ~“你勒索我，小杂种。”~
@88625 = ~“我猜我有。”~
@88626 = ~“好主意。”~
@88627 = ~“我想那在任何地方都可能发生。”~
@88628 = ~“你还想怎么样，德金？你只是个狗头人。”~
@88629 = ~“不，没那么多。”~
@88630 = ~“是的，不少。”~
@88631 = ~“现在不行，德金。”~
@88632 = ~“这个除外。”~
@88633 = ~“我不大了解。”~
@88634 = ~“德金。就算他们曾经是地表生物，现在也不是了。”~
@88635 = ~“可能因为他们看上去和藏身的阴影太像了吧。”~
@88636 = ~“因为他们是邪恶的，黑色的东西都是邪恶的。”~
@88637 = ~“邪恶的<RACE>一族必须穿成黑色。多数是黑袍或者黑帽。”~
@88638 = ~“你住在洞窟里却从没见过黑暗精灵？”~
@88639 = ~“非常好吃？真的？”~
@88640 = ~“唔……我不想知道这个……”~
@88641 = ~“确实如此。毕竟我是个精灵。”~
@88642 = ~“你知道黑暗精灵是一类精灵，是吧？”~
@88643 = ~“我真的不在乎。”~
@88644 = ~“够了，这个话题很无聊。”~
@88645 = ~“永远别那么做。”~
@88646 = ~“好吧，改成德金·德塞洛吧。”~
@88647 = ~“你想改名？”~
@88648 = ~“这是我听过最蠢的主意。”~
@88649 = ~“好主意，把名字改掉吧。”~
@88650 = ~“三思吧，我相信你会有新想法的。”~
@88651 = ~“呃……叫狗头人<CHARNAME>？”~
@88652 = ~“唐纳？听起来不错。”~
@88653 = ~“不，别那么干。求你了德金。”~
@88654 = ~“那是个什么名字？”~
@88655 = ~“你没有什么偏爱的名字吗，德金？”~
@88656 = ~“不要那么可爱的好不好？”~
@88657 = ~“的确，比如大德金就比较有男子气概。”~
@88658 = ~“我认为德金这名字就不错。”~
@88659 = ~“你现在的名字不好吗？”~
@88660 = ~“那本书就是一个菜鸟写的。”~
@88661 = ~“谁？哦……我的导师。不，没什么。”~
@88662 = ~“你在搞笑吗？他是个老白痴，就是这样。”~
@88663 = ~“高贵的乔甘牺牲了自我。我会永远珍视关于他的回忆。”~
@88664 = ~“我的先师？有时候，是有一点。”~
@88665 = ~“不错。我们继续赶路吧。”~
@88666 = ~“但是你有了一整段冒险生涯，这不是你期望的吗？”~
@88667 = ~“但是泰莫法拉对你很不好。”~
@88668 = ~“你没回去过吗？”~
@88669 = ~“真是个蠢问题。”~
@88670 = ~“不幸猜错。”~
@88671 = ~“我希望如此。”~
@88672 = ~“我根本不在乎。”~
@88673 = ~“你想要财宝，不是吗？”~
@88674 = ~“如果我们找到了你想要的东西，跟我说一声。”~
@88675 = ~“我给你多少就拿多少，一个子儿也不能多。”~
@88676 = ~“什么？你认为我分配不公？”~
@88677 = ~“好吧，好吧。再加一点。”~
@88678 = ~“额外的？我可不给你。”~
@88679 = ~“你是我的书记员……最好经常呆在我身边。”~
@88680 = ~“你已经是位冒险者了，德金。”~
@88681 = ~“德金，我们是朋友。这比作为冒险者更重要。”~
@88682 = ~“你是个狗头人而已，德金。”~
@88683 = ~“是的，看起来是那样子。”~
@88684 = ~“我猜不会有那种例外。”~
@88685 = ~“是的。记得把这些都记下来。”~
@88686 = ~“还记得吗？我们是队友，德金。”~
@88687 = ~“谢谢，德金。”~
@88688 = ~“收割者一直说那是他的国度，仅此而已。”~
@88689 = ~“少问些问题吧，狗头人。”~
@88690 = ~“你为什么这么感兴趣？”~
@88691 = ~“德金，我不知道收割者是什么。可能是个恶魔？谁晓得。”~
@88692 = ~“正确。”~
@88693 = ~“问够了吧，德金。”~
@88694 = ~“首先我必须满足他开的价码，但基本上是的。”~
@88695 = ~“呃……经常如此。有种说法可以解释这东西如何运作，但我所知不多。”~
@88696 = ~“收割者好像说过这地方是个位面连接点。我不能完全理解。”~
@88697 = ~“收割者说他的国度是一个位面连接点。它和许多位面相连，但不是所有位面。”~
@88698 = ~“你怎么不亲自去问他？”~
@88699 = ~“闭嘴吧狗头人。我没那份情绪。”~
@88700 = ~“除非你能想出什么办法离开这里，否则给我闭嘴。”~
@88701 = ~“关于这个地方你能告诉我什么吗？”~
@88702 = ~“似乎……有点冷。不像是在地狱里，是吧？”~
@88703 = ~“你的第一条提示是什么？”~
@88704 = ~“我知道要做什么。”~
@88705 = ~“那就告诉我你所知道的。”~
@88706 = ~“好吧，闲话就扯到这里。”~
@88707 = ~“好吧，我们继续赶路，自己找出答案吧，好吗？”~
@88708 = ~“有没有办法知道这里是不是你所说的地方，德金？”~
@88709 = ~“关于那个故事，你还能想起什么有趣的事来吗？”~
@88710 = ~“你知道为什么那座城市消失了吗？”~
@88711 = ~“为什么把那座城市弄到这里来？”~
@88712 = ~“担心他们偷你的书，哈？”~
@88713 = ~“别担心。我相信没什么东西值得他们兴奋。”~
@88714 = ~“我想你的思维太深奥了他们理解不了，德金。”~
@88715 = ~“除非他们太走运。”~
@88716 = ~“闭嘴，狗头人！”~
@88717 = ~“别担心，德金，我会保护你的。”~
@88718 = ~“怎么了？什么事？”~
@88719 = ~“你总是那么说，德金。”~
@88720 = ~“为什么我要知道？”~
@88721 = ~“为什么不问问他们呢？”~
@88722 = ~“或许他们是某种奴隶。”~
@88723 = ~“他们也许是奴隶或者仆人，德金。”~
@88724 = ~“我们来找出答案吧。”~
@88725 = ~“问题够多了！现在是行动时间。”~
@88726 = ~“也许是我们从没见过的东西。”~
@88727 = ~“真是个蠢问题。”~
@88728 = ~“他们也可能让奴隶来做这些事。”~
@88729 = ~“再废话就把你送去做奴隶。”~
@88730 = ~“不，我相信他们会吃狗头人的。”~
@88731 = ~“为什么不会？在这里我们见过好多地表生物了。”~
@88732 = ~“这办法似乎行得通。”~
@88733 = ~“再犯傻我就让你消失。”~
@88734 = ~“我说，别想出版商的事了好吧？”~
@88735 = ~“幸好你没有，大家都高兴。”~
@88736 = ~“能说些关于他们的事吗？”~
@88737 = ~“我们四处转转的话大概能找到些证据。”~
@88738 = ~“集中心思。”~
@88739 = ~“你认为反魔法区域是怎么形成的？”~
@88740 = ~“没那么麻烦，我们会没事的。”~
@88741 = ~“那样最好。”~
@88742 = ~“我听说是这样的。”~
@88743 = ~“你为什么问起那个？”~
@88744 = ~“为什么不？一切都有可能。”~
@88745 = ~“我相当怀疑。”~
@88746 = ~“我不知道。也许吧。”~
@88747 = ~“我同意。那真是个可怕的存在。”~
@88748 = ~“对此观点我十分怀疑。”~
@88749 = ~“你曾经被石化过，就是你。你对我讲过。”~
@88750 = ~“我不想谈这个话题。”~
@88751 = ~“被石化的时候我没有任何感觉。”~
@88752 = ~“别傻了。”~
@88753 = ~“我非常怀疑，德金。”~
@88754 = ~“也许吧。如果能遇到，我们可以问它。”~
@88755 = ~“如果魔像能像你一样想这么多，我们的日子就不好过了。”~
@88756 = ~“幸好你不是魔像。”~
@88757 = ~“我们当然不知道，德金。也许他们也很高兴。”~
@88758 = ~“不过……？”~
@88759 = ~“我真的不想听到这件事，德金。”~
@88760 = ~“你不怕水，是吧？”~
@88761 = ~“我想你是对的。我从没像那样想过。”~
@88762 = ~“然后呢？那又有什么？”~
@88763 = ~“够了，德金。我不想听你胡扯。”~
@88764 = ~“德金，地下和地上一样，也有很多水。”~
@88765 = ~“我知道很多事情，德金。我很聪明。”~
@88766 = ~“我……啊……不认为事情是这样的……”~
@88767 = ~“我也没坐过船。”~
@88768 = ~“因为冒险怎么可能是安全的？”~
@88769 = ~“别当懦夫，那很安全。”~
@88770 = ~“好吧，一点都不安全，真的。”~
@88771 = ~“你决定吧。我理不出头绪。”~
@88772 = ~“你不会现在就吓破胆了吧？”~
@88773 = ~“正是如此。你知道他们没提过的出路吗？”~
@88774 = ~“我知道。对此事我也不大乐观。”~
@88775 = ~“你才知道啊？”~
@88776 = ~“太好了，太好了。我们继续赶路，好吗？”~
@88777 = ~“太好了，我很高兴有人能纵观全局。”~
@88778 = ~“你只关心你的书吗？”~
@88779 = ~“也许我能从这本书上捞到点好处？”~
@88780 = ~“你说幽暗地域吓不倒你？”~
@88781 = ~“我现在就该杀了你，小畜生。”~
@88782 = ~“我想你是对的。”~
@88783 = ~“我们一直面对危险，这很酷？”~
@88784 = ~“德金，有时候我真搞不懂你。”~
@88785 = ~“这扇门通到哪里，你知道吗？”~
@88786 = ~“显而易见的事，你说呢？”~
@88787 = ~“你为什么那么讲？”~
@88788 = ~“很好，让我们继续。”~
@88789 = ~“家常便饭，又有几个谜题要解开了。”~
@88790 = ~“这地城究竟有多深？”~
@88791 = ~“这些锁链都放在哪里？”~
@88792 = ~“安静，德金。继续监视。”~
@88793 = ~“多谢为我讲了这么多旅途见闻。我们继续吧。”~
@88794 = ~“很危险吗？”~
@88795 = ~“沉睡的列王？”~
@88796 = ~“那就继续赶路吧。”~
@88797 = ~“好的，德金，谢谢提醒。”~
@88798 = ~“他们是睡着了，还是死了？”~
@88799 = ~“按你说的，他们应该有许多财宝。”~
@88800 = ~“闭嘴。现在不需要你讲故事。”~
@88801 = ~“是的，我相信很快就能找到更多线索。”~
@88802 = ~“你对它了解多少？”~
@88803 = ~“多谢帮助，德金。”~
@88804 = ~“好吧，我们继续赶路。”~
@88805 = ~“如果我向镜子里看呢？”~
@88806 = ~“那些镜子能被打破吗？”~
@88807 = ~“复制你？”~
@88808 = ~“把你拉进去？”~
@88809 = ~“是的，当然。然后呢？”~
@88810 = ~[盯着他]~
@88811 = ~“我也听说是这样的，德金。”~
@88812 = ~“我还能回到旅馆里，是吧？”~
@88813 = ~“我想知道的就这些。”~
@88814 = ~“你对山下地城了解很多吗，德金？”~
@88815 = ~“你说收割者的神物会失效？”~
@88816 = ~“为什么那么讲？”~
@88817 = ~“多谢提醒。”~
@88818 = ~“无所谓。”~
@88819 = ~“如果看到什么眼熟的东西一定要告诉我。”~
@88820 = ~“是的，继续冒险。”~
@88821 = ~“好的，我会多加小心。”~
@88822 = ~“你对山下地城了解甚多，是吗？”~
@88823 = ~“多加小心，处处提防。”~
@88824 = ~“我们会很小心的，德金，放心。”~
@88825 = ~“和我在一起，没什么可怕的。”~
@88826 = ~“自从那些书定稿以后，山下地城显然又改变了不少，德金。”~
@88827 = ~“也许那个海拉斯特已经不在了。”~
@88828 = ~“说明我对你的耐心与日俱减了，狗头人。”~
@88829 = ~“说明我们身处一个非常危险的地方。”~
@88830 = ~“不，那又意味着什么？”~
@88831 = ~“我当然知道，狗头蠢货。”~
@88832 = ~“你在开玩笑吧。我没主意了。”~
@88833 = ~[盯着他]~
@88834 = ~[叹气]“是的，德金。我当然知道我们要去哪里。”~
@88835 = ~“无论怎样，我想我们是赶往拉沙曼在野地里裸奔。”~
@88836 = ~“除此以外还有品尝清炖狗头人。”~
@88837 = ~“算了。我不想讨论这个。”~
@88838 = ~“你跟着我是在找死。”~
@88839 = ~“好呵，我们走。”~
@88840 = ~“不，暂时留在这里。”~
@88841 = ~“也许不该总是让你四处乱跑。”~
@88842 = ~“你是个小狗头人兼吟游诗人。你还想怎样？”~
@88843 = ~“你不能自保，这才是实质问题。”~
@88844 = ~“不用担心，德金，你做得不错。”~
@88845 = ~“他确实提了问题，莉努。”~
@88846 = ~“别对她太苛刻，德金。她尽了全力。”~
@88847 = ~“真他妈痛，你应该知道。用煎锅进行恶意袭击。”~
@88848 = ~“很高兴又能见面，亲爱的。需要我帮忙吗？”~
@88849 = ~---------- Random Pop-Ups Start Here ------------~
@88850 = ~“哦，我的朋友，这是真的吗？是你想要的吗？”~
@88851 = ~“是的。亲爱的，请不要在此抛弃我，我无法忍受在此长久的等待。”~
@88852 = ~“啊，没关系。我确信自己可以走回去，不必为我担心。”~
@88853 = ~“那我可以帮你做什么吗，亲爱的？”~
@88854 = ~“我很少会看见他们，不过没关系。”~
@88855 = ~“当然，如果我能做到的话。”~
@88856 = ~“接着我会为你加速，亲爱的。”~
@88857 = ~“潜行可不是我的专长，不过我会尽力的。”~
@88858 = ~“如你所愿，不去管他吗？”~
@88859 = ~“我会尽我所能支援你的。”~
@88860 = ~“那么，我该去哪里？”~
@88861 = ~“如你所愿。”~
@88862 = ~“我并不是战争狂，但如果必须的话，我会做我该做的。”~
@88863 = ~“我会试着做的。”~
@88864 = ~“哦，很好。让我暂时先放下手头的活。”~
@88865 = ~“虽然我并不是很有眼光，但我可不是无知之徒。把你的包袱给我检查一下，我会告诉你我能做什么。”~
@88866 = ~“亲爱的，你需要我施放什么法术？”~
@88867 = ~“亲爱的，你想让我施展什么？”~
@88868 = ~“如果你确信的话……”~
@88869 = ~“那么我的目标是谁呢？”~
@88870 = ~“评论？关于哪方面的？”~
@88871 = ~“有道理，虽然我有些旅途劳顿……我并没有抱怨的意思。”~
@88872 = ~“我们可以谈点其他的吗？”~
@88873 = ~“我很好，亲爱的。不用为我担心。”~
@88874 = ~“和我期望的一样。我愿意接受挑战。”~
@88875 = ~“哦，我很好，亲爱的。多谢你的探问。”~
@88876 = ~“我并不想抱怨……不过身处这种盲目的影响中，我实在是不安。”~
@88877 = ~“我的伤暂时还很轻，一两个简单法术就可治愈。”~
@88878 = ~“虽然伤得很重，不过我还可以前进。”~
@88879 = ~“情况不好，”她预言畏缩着说，“这些伤虽然很重，但我当然不会死。”~
@88880 = ~“我中毒了，真希望我有法术可以让毒慢点发作。”~
@88881 = ~“我感觉不太好。真希望经过病痛的折磨后我会康复。”~
@88882 = ~“我还是不太确信。我曾经考虑过离开，但还是有点相信那不应该是我的命运。”她在这个问题上陷入深思。~
@88883 = ~“或许我可以回到无冬城，或者在这北部的荒原建造一座瑟哈妮·月弓神殿。毕竟深水城所给的报酬是很丰厚的。”~
@88884 = ~“亲爱的，有什么计划吗，如果这次冒险结束的话？”~
@88885 = ~她微笑着说：“我确信那是真的。我期望着你和你提到的慈善捐赠……那些报酬足够使很多受苦的人生活得到缓解。”~
@88886 = ~莉努沉思了片刻，说：“这次之后，我的冒险生涯就要结束了。当我从这石棺中醒来，”她颤抖着，“不……我不想再一次经历这些了。”~
@88887 = ~“也许是瑟哈妮在灾难发生之前将你送到这里，指引我要走的路。不管怎样，<CHARNAME>，非常感谢你的帮助。”~
@88888 = ~她咯咯地笑着：“我确信你会得到你应得报酬，我的朋友，而且会更多。来吧……我们出发。深水城还等着我们的援助。”~
@88889 = ~她温柔地笑道：“出发吧，朋友。我们还有很多事要做，而且深水城还需要我们的援助。”~
@88890 = ~“*我*想它可能就是某物吧。我们出发吧……我们还有很多是要做，而且深水城还需要我们的援助。”~
@88891 = ~“真的吗？我必须承认，我的设想是沿着相似脉络的。”~
@88892 = ~她微笑着点头：“那就是这种每天都会给我带来新的冒险的场所，不是吗？”~
@88893 = ~她红着脸，羞怯的微笑着，目光也投向远处：“我明白。我……不能否认想要更加了解你，<CHARNAME>。你看起来是个好人。”~
@88894 = ~“我原来从爱弗列斯卡来，亲爱的，不过我花了大量时间在无冬城和瘟疫作战。纳什尔领主是个慷慨的人。”~
@88895 = ~“这里有太多东西要重建，而且城市也需要有她的英雄……纳什尔领主对我们这些留下的人很慷慨。在这段时间，这感觉还是不错的。”~
@88896 = ~“我也许应该回爱弗列斯卡去，但是我却无法做到。这段时间以后，我感觉到对在陌生环境中冒险的渴望，而其他人也是这种想法。”~
@88897 = ~“我从来没看到谁在如此短的时间内在力量上进步如此之快，尽管这是一种特殊的待遇。”~
@88898 = ~她露骨地笑着：“<HESHE>可能也会有的，就像我们其他人一样。我并不在意，无冬城的英雄理应受这些赞誉，再多也不过分。”~
@88899 = ~“我听说沙尔文写了本关于整件事的书，”她转着眼球，咧嘴笑道，“无知。天真而且过分的夸大。不过这不就是吟游诗人的故事吗？”~
@88900 = ~“说实在的，我并不知道。<HESHE>杀死摩拉格回来之后，不知怎的同纳什尔领主发生了分歧。于是<HESHE>就离开了无冬城。”~
@88901 = ~“纳什尔领主如此恶劣地对待在那些日子里的真正英雄的做法是不可取的……不过也许我不该枉自判断，我并不了解他们之间的秘密。我只能假设<HESHE>仍在冒险之中。”~
@88902 = ~“并不像你想的那样……我不是一名想保护城里居民健康的牧师。我加入了艾瑞贝丝女士搜寻阴谋策划者的行动。”~
@88903 = ~“幸运的是我们成功了，而且城市也保住了。”她的眼睛慢慢变得忧伤起来，“但并不是没有有付出代价。我依然恳求艾瑞贝丝女士。”~
@88904 = ~“当然，对我来说已经足够。”~
@88905 = ~“她曾是泰尔的圣武士，但是你知道的……在愤怒与憎恨面前她被击倒了。”~
@88906 = ~“亲爱的，再说这件事时当心些。最后……我们已经得到了应得的。”~
@88907 = ~“是的。她是个好人，就像冯瑟克一样。”怒气布满莉努的脸上，“我想一些事实很难忘记的。”~
@88908 = ~“如果这是你的方式，我的亲爱的，我不会在质疑了。我会祈祷瑟哈妮保佑你在这生死攸关的时刻。”~
@88909 = ~“我会尽力保护你的安全，我的亲爱的。去磨练吧，置身与伤害之外。有时候我想你和我身陷得困境一样。”~
@88910 = ~“我并不想麻烦你。不过再给次机会吧。”~
@88911 = ~她好奇的盯着你半天：“你对卓尔有什么看法，<CHARNAME>？”~
@88912 = ~她点头道：“这样我不用和他们闲聊了。我们继续吗？”~
@88913 = ~她的脸色变得凝重起来：“在人类之前的很久之前，黑暗精灵曾居住在地表。不过，他们早就被赶到地下去了。”~
@88914 = ~“幽暗地域并不是他们原来家园。它是黑暗精灵们互相欺骗，战斗和与其他像矮人一样的种族竞争中建立的王国。”~
@88915 = ~“他们的威胁会更多，但这是卓尔的命运，他们互相战斗，并且变得衰弱。这正是他们的蜘蛛女神罗丝所希望看到的。”~
@88916 = ~“我们赶快走吧，和卓尔的交谈使我紧张不已。”~
@88917 = ~“但是，坦白说这并没有什么伟大的功绩。这个地下的邪恶种族不断和其他种族进行征战，卓尔并没有什么特殊。”~
@88918 = ~“我发现他们极为罕见地在一起行动。让这些卓尔联合在一起是一回事儿，但是如果是和灰矮人，夺心魔和眼魔联合又是另一回事儿。”~
@88919 = ~“不，在幽暗地域里一定正在发生着我们闻所未闻的事情。绝对不会是好消息。”~
@88920 = ~“这是不太可能的。卓尔们彼此分成不同的部族，并且不断为了取悦罗丝女神而彼此征战，我们无法指望他们的联合。他们不会有联合的动机。”~
@88921 = ~“我唯一想要看到的是会不会有一支卓尔部族可以凌驾于其他部族之上。但是只要罗丝还是他们的女神这就似乎不大可能。”~
@88922 = ~“这只是一座很小的卓尔神殿，但却是最有力量的女神罗丝的。这位蜘蛛女王公认为痛苦和残忍的化身。她是卓尔的神，而他们是他完美的孩子。”~
@88923 = ~“他对自己的自民毫无人道，我想。那些触怒他的人不是直接杀掉就是被变成蛛化精灵……半蛛半精灵的邪恶生物。而他的祭坛也总是被祭品的鲜血染的血红。”~
@88924 = ~“适者生存……这使得他们变强。当这些卓尔还是幼年时，”她的脸令人厌恶的扭曲着，“就被教唆着去杀死同胞以证明自己是强者。”~
@88925 = ~“这就意味着这些卓尔的一生都在努力着避免被杀，同时被迫使自己的头脑足够精明。这是他们成为令人丧胆的对手和残忍的杀戮者。”~
@88926 = ~“我并不确信他们是否像回到地面，据我所知，现在地面的强光会令他们十分痛苦，不过如果他们想要返回地面，那一定会像是征服者一样。”~
@88927 = ~“传说中提到有某些卓尔来到了地表，并且平静的生活着。他是伊丽思璀女神的信徒，一个远离家乡自我放逐的人。”~
@88928 = ~“我相信崔斯特比不是伊丽思璀女神的信徒，但一个在地表离群索居自我放逐的卓尔。”她耸了耸，“在费伦对每个种族都是例外，包括卓尔。”~
@88929 = ~“不错，但不是每个生下来小精灵都知道自己的传统。要我对你说一下吗？”~
@88930 = ~“我的人民拥有黑袍海拉斯特的传说，这个魔法师的建造物，”她转向她，“所有的一切。”~
@88931 = ~莉努耸耸肩：“如你所愿，亲爱的。我只提供我认为相关的东西。”~
@88932 = ~“好吧，你得记住我们出发的地方——‘敞开大门’。在深水城建立之前，海拉斯特的塔就建在那里。”~
@88933 = ~“他从地面不断向下挖掘着，越来越深，直到他闯进一个古老的矮人的洞穴。”~
@88934 = ~“在我们的传说中矮人族已经被卓尔屠杀殆尽，而这些精灵还留在这些洞穴中。海拉斯特很快占领了洞穴杀死或者束缚了他们。”~
@88935 = ~“他们是原始的居住者。”她环顾四周说道，“海拉斯特将这里按照自己的意愿改变了，并且进一步深入。也许他曾闯进了幽暗地域。”~
@88936 = ~她点头回答道：“不客气。”~
@88937 = ~“他是一个有着长久生活阅历的强大法师。”她耸耸肩，“不过却太过疯狂，如何公平的评价这种力量呢？像任何人一样，他当然可以被击败。”~
@88938 = ~“卓尔是强大的，既有魔法师又有牧师，与其他种族比起来有着明显优势。他们是完全独立的。如果某些人想联合他们对抗山下地城的话。”她的声音消失了，但所带来的思考还在。~
@88939 = ~“我不是很确信山下地城是否侵入了幽暗地域。一些说法是，另一些则不是……很明显,冲突已经发生了，不是吗？”~
@88940 = ~“传说中说道海拉斯特担心失去它的力量已经到了疯狂妄想的地步。他造出克隆生物和迷题……只为了使他的敌人远离他的魔法。当然，所有人都是他的敌人。”~
@88941 = ~莉努哈哈笑道：“是比大多数魔法师要早很多，但不会比伟大的贤者伊尔明斯特更古老。但也早得足够给精灵留下深刻印象……他毕竟比深水城还古老。”~
@88942 = ~----------------------这里开始随机对话--------------------------~
@88943 = ~“我不希望这种变化发生，也希望他不要发生在任何人身上。特别是你，我亲爱的。我应该尽力奋斗以使你远离这种命运。需要我再次加入你吗？”~
@88944 = ~她点头道：“我应该尽力将你的生命和希望重新带回给你“~
@88945 = ~她握紧武器，点头道：“好吧，亲爱的。不过……不要让我一个人在这太久。我不希望孤单。”~
@88946 = ~------------------------这一行必须放在队员之间说笑的结束处------------------------~
@88947 = ~“那是什么，汤米？你已经注视我很久了，现在，你可以说出来了。”~
@88948 = ~“好吧。我只是奇怪……你如何对抗这种盗贼的行径？”~
@88949 = ~“你想否认除了你那微不足道的道德或者是对手下的一点点恩惠以外，你是一个完全的无赖和窃贼这个事实吗？”~
@88950 = ~“是，除了所有那些烂东西。你是对我个人来的，事情将会如此继续。”~
@88951 = ~她从他那儿转过身，扬起下巴：“为什么不是对个人呢？你为大家做的很少。相反，你总是贪得无厌的从那里所有，现在他们再也不会忍受你这个歹徒了。”~
@88952 = ~“嗯……听起来你是指某些特别的事情。”~
@88953 = ~“我没有！我老爹是个堕落的小偷，但是这没有任何关系……”~
@88954 = ~“尊敬的女士，呃？是，这就解释了一切。你们这些家伙总是无法摆脱父辈的影响……真够可怜的。”~
@88955 = ~“等着瞧，你这个臭小鬼。总有一天瑟哈妮会让我在你身上施咒，那时候你就会衣不蔽体在街上哀嚎，无望的祈求得到神灵的宽恕！”~
@88956 = ~“是吗？听起来好像是我昨晚在那里。”~
@88957 = ~“啊！”莉努挫折的尖叫着跑开。~
@88958 = ~“离我远点，你这个臭小贼！我不想被人偷！”~
@88959 = ~“哎！这可是你不对，对可怜的汤米说这种话。而且，我只是在想关于你的一些事情。”~
@88960 = ~“你听说什么了？我想不到。”~
@88961 = ~“好像你在无冬城的大桥区引起了一场骚乱。是不是你？”~
@88962 = ~莉努退后了一步，好像很窘迫：“哦。嗯……就算是我，不过我可不知道这是不是骚乱。你怎么知道是我引起的？”~
@88963 = ~“真的是你引起的？”他大笑起来，不停地拍着腿，“我真不敢相信！这么美丽的小姐居然会引起一场骚乱！”~
@88964 = ~“没必要这么激动。只是一次事故而已。我那时只是想在大桥区买鸡给纳什尔领主熬汤。”~
@88965 = ~“鸡跑掉了，我跟在后面追，它跑到了几匹卫兵的马前……嗯，然后……马就惊了。”~
@88966 = ~“难道是鸡惊了马？”~
@88967 = ~“呃，不太准确。我扑过去抓鸡，不过不小心撞翻了一辆手推车……上面有只猫在打盹。它被吓了一条，掉进了附近的喷泉里。”~
@88968 = ~“那么是它惊了马？”~
@88969 = ~“一群狗追着那只湿淋淋的猫，它们冲到了马的下面，就是这样。”~
@88970 = ~“所以它们惊了马，那些马开始四散而逃，到处乱踩……骚乱是这样开始的吗？”~
@88971 = ~“不……不太对。我想把马追回来，所以在一路上弄……弄坏了……”~
@88972 = ~汤米举起手：“好了，别再说了。我想我知道了。真够乱的！一场恶梦，是吧？”~
@88973 = ~“我发现你注意我很久了，达尔兰。有话和我说吗？”~
@88974 = ~他点点头，好像有点不好意思：“是的，善良的精灵。请先原谅我的粗鲁，可以吗？你能告诉我为什么要这么走路吗？”~
@88975 = ~莉努脸红了：“怎么……我到底怎么走了？”~
@88976 = ~“精灵们在我们这些人中因为他们的优雅和美貌而闻名。你一样很美丽，可是为什么你没有和他们相同的优雅姿态呢？”~
@88977 = ~她把目光从达尔兰那里移开，脸更红了：“我……从没有过你所说的优雅，亲爱的。所以经常为此受到我的同伴的嘲笑。”~
@88978 = ~他点点头：“我不该和你谈这些的。请原谅我。我的意思是在那些不经意的时刻你总是流露出令人惊讶的优雅来。”~
@88979 = ~莉努似乎很惊讶：“你到底是什么意思？不是真的吧？”~
@88980 = ~“我认为如此。当你沉醉在幻想中或者你向你的神灵祈祷时……那时候你总是具有和同类一样的优雅。也许你的笨拙并不是与生俱来的。”~
@88981 = ~她的声音平静下来：“我没有这样考虑过。”~
@88982 = ~“我们都相信我们因为种种理由而并非完美。你的恐惧和哀伤我不会告诉别人……如果你愿意和像我这样的一个普通人商量它们的话。”~
@88983 = ~“谢谢你所说的话，亲爱的。也许……以后……我可能会做的。”~
@88984 = ~“达尔兰……我能问个问题吗？乌斯嘉部落究竟信仰什么？”~
@88985 = ~“你是问我们这些人的信仰吗，莉努，还是我自己的信仰？如果你想知道我的信仰，直接问我没关系。”~
@88986 = ~“我……我不想冒犯你，达尔兰。我只是好奇。”~
@88987 = ~“我很高兴可以满足你的好奇心，善良的精灵。我永远无法相信从你美丽的心灵中流露的问题会有什么恶意。”~
@88988 = ~“你……你真好，达尔兰。事实是我真的有点好奇。在我的记忆里你似乎从来没有提起过任何神的名字。”~
@88989 = ~他微笑着，低头看着她。“也许我并不信仰他们。乌斯嘉有诸多的远古神灵，但是我很早以前就不再信仰他们了。”~
@88990 = ~“我可以问问为什么吗？”~
@88991 = ~达尔兰有一会没有回答，他的眉毛蹙在一起。“有时，在一个人生命中最黑暗的时刻，他的信仰也许会崩溃。信仰是不太容易回复的。”~
@88992 = ~莉努把手放在他的臂膀上：“这不是不可能的，达尔兰。这个世界上还有值得信任的东西……善良的，可敬的。”~
@88993 = ~达尔兰拍拍她额手，他的眼睛很悲伤：“我相信很多事情，善良的精灵。我相信同情、荣誉和崇高。我只是不信仰神灵。”~
@88994 = ~“有些神值得你的信任，达尔兰。”~
@88995 = ~“也许我会因为你而重回信仰，善良的精灵。”他对她点点头，温柔的把她的手从胳膊上拿开，“未来的某一天。”~
@88996 = ~“你想问我什么呢，亲爱的沙尔文？你总在看我……”~
@88997 = ~“是的，不过……我怕为难你……”~
@88998 = ~“问吧。没关系。”~
@88999 = ~“嗯……我似乎听说你和纳什尔领主之间有些事情，他似乎对你和瑟比亚的某些事情很生气。”~
@89000 = ~莉努的脸突然红了：“哦，那件事。是的，唔……是我犯了错使得瑟比亚大使拂袖而去。不过，这完全是一次事故。”~
@89001 = ~沙尔文笑了：“怎么了？”~
@89002 = ~莉努无能为力的耸耸肩：“在一次宫廷典礼上，大使和我一起跳舞。我绊倒了，撞翻了一个侍者，他把一盆汤撒到了大使身上。”~
@89003 = ~“听起来没那么糟糕啊。”~
@89004 = ~“可惜那盆汤是滚烫的。这个可怜的人痛苦的乱动，不小心踏进了一个火盆，把自己点着了。”~
@89005 = ~“啊……”~
@89006 = ~“我想帮他……或者我认为是为了帮他……我把附近的一桶水倒在他身上。但我不知道里面装满的竟然是火盆的油……”~
@89007 = ~沙尔文举起手来：“别说了。我得想像的到。你这个可怜的小姑娘。”~
@89008 = ~“问个问题，沙尔文。你……你的妈妈是无冬城的一个裁缝师，对吧？一个名叫黛莉拉的骄傲的女士？”~
@89009 = ~显然沙尔文没有料到这个问题。她板起脸来怀疑的打量着莉努：“是的。你怎么知道的？”~
@89010 = ~莉努无助的做着手势：“我……我遇见过你的妈妈。她在瘟疫盛行的时候病倒了，对吧？”~
@89011 = ~“她倒是没有染上瘟疫。她得了坏骨病……我最后找到治疗这个病的药。不过我得说我花费了不小的努力。”~
@89012 = ~莉努点点头，她的表情很奇怪：“她也是这么说的。你和她……经常聊天吗？”~
@89013 = ~“不。”沙尔文板起脸来，从莉努那里走开了一会，“这不关你的事，不过……我们是很少说话。在我把药交给她之后就没有见过她。”~
@89014 = ~莉努很久没说话。然后，她终于用害怕的声音说：“这个病还有……并发症。你的妈妈死了，沙尔文。我尽了我所能，但我没别的办法。”~
@89015 = ~沙尔文的声音平静下来：“我知道。”~
@89016 = ~“我想别人没有告诉你吧。毕竟你离开了无冬城。”莉努显然有点痛苦，“我想你……你希望知道。”~
@89017 = ~沙尔文慢慢的点点头：“谢谢你，莉努。”她想了一会儿然后问到，“她……”~
@89018 = ~“最后没有受什么折磨。她死的很平静。”~
@89019 = ~沙尔文沉默了，突然泪如泉涌：“这样很好。”她再也不说话了。~
@89020 = ~“德金……你好像说过在那之前你在做什么来着？某种术士是吧？”~
@89021 = ~“德金是个红龙龙脉术士，”他骄傲的表示，“他有龙的心，就像从前的老大所说的一样。”~
@89022 = ~“很好，亲爱的。我希望这不会把你变得和很多龙一样邪恶。”~
@89023 = ~“邪恶？从前的老大并不邪恶。从前的老大只是心情不好。”~
@89024 = ~“嗯……好像和我听到的不一样。我们是在说白龙泰莫法拉，对吧？你不……不知道你的老板的计划吗，德金？”~
@89025 = ~他想了一会，不停的把脚换来换去：“也许德金知道一点。也许这就是德金离开的部分原因。”~
@89026 = ~莉努对他微笑着，拍拍他的脑袋：“也许我们的英雄偶尔会让我们失望，不过这也并不代表他们不具有优秀的品格。我想你过去的老大不是太坏。”~
@89027 = ~“他有时对德金很好。过去的老大教我的时候，我觉得自己不是狗头人，好像是一条龙。”~
@89028 = ~“一条善良的龙，我确信。”她对德金开朗的一笑，他也吃吃的笑着回应。~
@89029 = ~“德金，你看起来不太好。你的脸色怎么这么灰白！怎么了，亲爱的？”~
@89030 = ~“嗯……德金只是紧张。德金每次在地下城里走都会紧张。德金胆子不大。”~
@89031 = ~她微微一笑：“没关系，亲爱的。我们的感觉都一样。”~
@89032 = ~德金瞪大了眼睛望着她：“真的吗？”~
@89033 = ~“当然！我还记得我第一次离开爱弗列斯卡。我想去找瑟哈妮的圣杯，我不知道从哪里开始。当时我都吓傻了！”~
@89034 = ~“我以前没有离开过家。我不了解人类的习惯，他们捉弄我的时候我太害怕了。”~
@89035 = ~“德金可以理解。”~
@89036 = ~“会好的，亲爱的。即使你不在冒险，生活里所有事情都需要勇气。你现在就在这里，这个事实已经为你证明了很多。”~
@89037 = ~“这证明了什么呢？”~
@89038 = ~“这意味着你比那些需要你拯救生命的人们勇敢的多。这意味着即使你失败了，你还是一个英雄，因为你做出了努力。”~
@89039 = ~他抬起头看着莉努笑了：“德金喜欢你说的话，美丽的精灵女士。你真好，就像老大一样。”~
@89040 = ~“别担心。”~
@89041 = ~“我认为我们得分开。”~
@89042 = ~“不，别担心。”~
@89043 = ~“在这里等我回来。”~
@89044 = ~“我得走了。”~
@89045 = ~“我希望改变你的战术。”~
@89046 = ~“我现在不想改变什么。”~
@89047 = ~“我希望你留下发现的任何陷阱。”~
@89048 = ~“我希望你解除发现的任何陷阱。”~
@89049 = ~“我希望迅速前进，不用搜索和潜行了。”~
@89050 = ~“我希望你从现在起保持潜行。”~
@89051 = ~“如果我没打开锁着的门或箱子不用你来帮忙。”~
@89052 = ~“如果我没打开锁着的门或箱子你就过来帮忙。”~
@89053 = ~“我想改变你我之间的距离。”~
@89054 = ~“站远些。”~
@89055 = ~“保持中等距离。”~
@89056 = ~“靠近些。”~
@89057 = ~“前进，向任何出现的敌人发起攻击。”~
@89058 = ~“保护我，等我动手再发起攻击。”~
@89059 = ~“我希望改变你的装备。”~
@89060 = ~“你能鉴别我的装备吗？”~
@89061 = ~“我希望你施放一组辅助法术。”~
@89062 = ~“算了。”~
@89063 = ~“施放所有的辅助法术。”~
@89064 = ~“施放所有的长效辅助法术。”~
@89065 = ~“施放所有的短期辅助法术。”~
@89066 = ~“我希望你施放法术。”~
@89067 = ~“算了。”~
@89068 = ~“超视觉。”~
@89069 = ~“真知术。”~
@89070 = ~“召唤IX级生物。”~
@89071 = ~“召唤VIII级生物。”~
@89072 = ~“召唤VII级生物。”~
@89073 = ~“召唤VI级生物。”~
@89074 = ~“召唤V级生物。”~
@89075 = ~“召唤IV级生物。”~
@89076 = ~“召唤III级生物。”~
@89077 = ~“召唤II级生物。”~
@89078 = ~“召唤I级生物。”~
@89079 = ~“石肤术。”~
@89080 = ~“法术抗力。”~
@89081 = ~“法术吸收。”~
@89082 = ~“虔诚护盾。”~
@89083 = ~“护盾术。”~
@89084 = ~“阴影护盾。”~
@89085 = ~“识破隐形。”~
@89086 = ~“圣域术。”~
@89087 = ~“复原术。”~
@89088 = ~“提升抗力。”~
@89089 = ~“抵抗元素伤害。”~
@89090 = ~“移除麻痹。”~
@89091 = ~“移除恐惧。”~
@89092 = ~“移除疾病。”~
@89093 = ~“移除诅咒。”~
@89094 = ~“移除目盲/耳聋。”~
@89095 = ~“再生术。”~
@89096 = ~“法术防护。”~
@89097 = ~“防护元素伤害。”~
@89098 = ~“预知术。”~
@89099 = ~“祈祷术。”~
@89100 = ~“智慧术。”~
@89101 = ~“中和毒性。”~
@89102 = ~“异常再生术。”~
@89103 = ~“次级法术无效结界。”~
@89104 = ~“心灵屏障。”~
@89105 = ~“集体加速术。”~
@89106 = ~“魔化护甲。”~
@89107 = ~“法师护甲。”~
@89108 = ~“光亮术。”~
@89109 = ~“次级法术吸收。”~
@89110 = ~“次级复原术。”~
@89111 = ~“次级心灵屏障。”~
@89112 = ~“次级解除魔法。”~
@89113 = ~“敲击术。”~
@89114 = ~“隐形法球。”~
@89115 = ~“隐形。”~
@89116 = ~“高等隐形。”~
@89117 = ~“加速术。”~
@89118 = ~“高等石肤术。”~
@89119 = ~“高级法术吸收。”~
@89120 = ~“高等圣域术。”~
@89121 = ~“高等复原术。”~
@89122 = ~“高级解除魔法。”~
@89123 = ~“法术无效结界。”~
@89124 = ~“鬼面术。”~
@89125 = ~“行动自如。”~
@89126 = ~“狡猾术。”~
@89127 = ~“寻找陷阱。”~
@89128 = ~“轻灵术。”~
@89129 = ~“墒光护盾。”~
@89130 = ~“能量缓冲术。”~
@89131 = ~“不，我改变主意了。”~
@89132 = ~“是，继续。”~
@89133 = ~“忍受元素伤害。”~
@89134 = ~“坚韧。”~
@89135 = ~“元素护盾。”~
@89136 = ~“荣光术。”~
@89137 = ~“神能。”~
@89138 = ~“解除魔法。”~
@89139 = ~“防死护界。”~
@89140 = ~“死亡铠甲。”~
@89141 = ~“唤起死灵。”~
@89142 = ~“不灭明焰。”~
@89143 = ~“清醒术。”~
@89144 = ~“轻灵术。”~
@89145 = ~“蛮力术。”~
@89146 = ~“我改变主意了。”~
@89147 = ~“对所有人施法。”~
@89148 = ~“对施法。”~
@89149 = ~“对施法。”~
@89150 = ~“对施法。”~
@89151 = ~“对施法。”~
@89152 = ~“对施法。”~
@89153 = ~“对施法。”~
@89154 = ~“对施法。”~
@89155 = ~“对施法。”~
@89156 = ~“对施法。”~
@89157 = ~“给我的动物同伴施法。”~
@89158 = ~“给我的同伴施法。”~
@89159 = ~“给我施法。”~
@89160 = ~“给你自己施法。”~
@89161 = ~“祝福。”~
@89162 = ~“操纵死尸。”~
@89163 = ~“帮帮忙。”~
@89164 = ~“你以前想说的是什么？”~
@89165 = ~“停下来说说话。”~
@89166 = ~“我们说完了。”~
@89167 = ~“不，没有了。”~
@89168 = ~“一切怎么样？”~
@89169 = ~“你打算在这一切结束之后做些什么呢？”~
@89170 = ~“我相信这些报酬会被好好利用的。”~
@89171 = ~“我不知道。我还没有想过。”~
@89172 = ~“我还没有得到报酬。”~
@89173 = ~“不用客气。”~
@89174 = ~“没事。”~
@89175 = ~“我在考虑抽出一部分时间。”~
@89176 = ~“我确信有其他的冒险者会来。”~
@89177 = ~“我希望自己可以和你多待点时间。”~
@89178 = ~“你说你来自无冬城，对吧？”~
@89179 = ~“纳什尔领主慷慨吗？他给的价钱很好？”~
@89180 = ~“你认识无冬城的英雄吗？”~
@89181 = ~“是英雄独自拯救了无冬城吗？”~
@89182 = ~“现在那个英雄在哪儿？”~
@89183 = ~“你参加了消除瘟疫的战斗？”~
@89184 = ~“前进吧。”~
@89185 = ~“艾瑞贝丝女士怎么了？”~
@89186 = ~“就我所听说的，她是罪有应得。”~
@89187 = ~“听起来太悲惨了。”~
@89188 = ~“不，在这里待一会。”~
@89189 = ~“好，跟我来。”~
@89190 = ~“现在不行。我忙着呢。”~
@89191 = ~“你想怎么样，莉努？”~
@89192 = ~“我知道我应该了解他们的事情。”~
@89193 = ~“我知道他们是邪恶、黑皮肤的精灵，只有这些。”~
@89194 = ~“这就是我希望知道的。”~
@89195 = ~“那么幽暗地域的其他种族都恨卓尔吗？”~
@89196 = ~“卓尔会统一起来吗？”~
@89197 = ~“罗丝，和我说说这个女神。”~
@89198 = ~“为什么他们的女神希望他们自己互相征战？”~
@89199 = ~“卓尔希望回到地面吗？”~
@89200 = ~“除了崔老三还有其他有名的卓尔吗？”~
@89201 = ~“很多。毕竟，我是个精灵。”~
@89202 = ~“是的，请。我的知识很有限。”~
@89203 = ~“不，我对他们有足够的了解。”~
@89204 = ~“我不需要知道他的事情。”~
@89205 = ~“告诉我你对他的了解。”~
@89206 = ~“那么山下地城一度属于矮人吗？”~
@89207 = ~“谢谢，我知道了。”~
@89208 = ~“海拉斯特有多强大？”~
@89209 = ~“卓尔是怎么进入的？”~
@89210 = ~“闯进幽暗地域？你的意思是……”~
@89211 = ~“为什么要在这里放下这些迷题还有怪物呢？”~
@89212 = ~“精灵有关于他的传说吗？他多大了？”~
@89213 = ~“好吧，我们走。”~
@89214 = ~“不，现在在这里待会。”~
@89215 = ~“再次遇见你真好。需要我帮忙吗？”~
@89216 = ~---------- Random Pop-Ups Start Here ------------~
@89217 = ~“是吗？好吧，我可不会呆在通缉我的地方。你确信……？”~
@89218 = ~“好，你走吧。记得等我老死的时候再回来。”~
@89219 = ~“说得对。我会自己找路回去。”~
@89220 = ~“还有什么别的事情要我去做吗？”~
@89221 = ~“那会是我的第一个本能，哈哈。”~
@89222 = ~“如果可以，当然。”~
@89223 = ~“很好，我会跟着你。”~
@89224 = ~“那么，让阴影掩盖我吧。”~
@89225 = ~“我怀疑我还能做些别的什么。”~
@89226 = ~“我不是个游荡者，当我会努力去做的。”~
@89227 = ~“你需要我做什么？”~
@89228 = ~“好吧。”~
@89229 = ~“真的吗？很公平。”~
@89230 = ~“我会努力。”~
@89231 = ~“很好，努力吧……”~
@89232 = ~“我一定能试试。我看看你有什么，如果能认出来我会告诉你。”~
@89233 = ~“如你所愿。让我的音乐鼓舞你吧。”~
@89234 = ~“我知道了。你希望我使用什么辅助法术？”~
@89235 = ~“我该施放什么？”~
@89236 = ~“我可以。你确信吗？”~
@89237 = ~“我的目标是什么？”~
@89238 = ~“谈话？谈什么？”~
@89239 = ~“很好。但我更喜欢正在进行的传奇！”~
@89240 = ~“我们能谈谈别的吗？”~
@89241 = ~“我的脚都疼了，我想好好洗个澡。但是，你也一样吧。”~
@89242 = ~“我不介意停下来休息一会，但我能等待。”~
@89243 = ~“我，太好了，我觉得。”~
@89244 = ~“还好。你认为我们很快就能到幽暗地域了？我还没有看到它呢。”~
@89245 = ~“很好。我个人还在等待发生某些奇怪的事情。”~
@89246 = ~“一切都在向我们期望的方向发展。不是吗？你有什么计划？”~
@89247 = ~“如果我能看见更好。等一下……你在哪里？”~
@89248 = ~“我有点轻伤，不过不会致命。”~
@89249 = ~“我受了些伤，不过还没那么严重。”~
@89250 = ~“我……不太好。”她痛苦的缩成一团。“如果可以，我需要治疗。”~
@89251 = ~“我中毒了。这不太妙。”~
@89252 = ~“事实上，如果我没有这么糟糕就好了。我们能做些什么吗？”~
@89253 = ~“如你的要求，我一直在专注于我的战斗技能。我需要做些别的事情吗？”~
@89254 = ~“如你的要求，我一直在专注于我的吟游诗人技能。我需要做些别的事情吗？”~
@89255 = ~“如你所愿。我自己发现了更全面的安排。”~
@89256 = ~“我的训练？好吧……我现在同时锻炼战斗和吟游诗人技能。如果你愿意，我可以集中在一方面。”~
@89257 = ~她笑了：“很容易完成。”~
@89258 = ~她肯定的点点头：“战士。”~
@89259 = ~她肯定的点点头：“吟游诗人。”~
@89260 = ~“那要看我是否结束探险而定。”~
@89261 = ~她沉思了一会儿，说：“在费伦有很多地方可以去冒险。我在考虑是否该去卡林珊看看，也许……或者是东边的拉沙曼。”~
@89262 = ~“我也没有去过沙漠。也许埃诺奥克大沙漠可以？你去过那儿，<CHARNAME>……你觉得怎么样？”~
@89263 = ~“你是指贝都因？是的，我想多看看他们。也许我可以像你一样去寻找古代物品？”~
@89264 = ~“也许我可以边走边玩。我可以在瓦萨的巫王面前游玩。也许吧……或者可以去阴影谷追寻伊尔明斯特。”~
@89265 = ~“你呢，<CHARNAME>？你还会继续冒险吗？为什么我们不一起呢？”~
@89266 = ~“没必要这么直率吧。不过还是祝你好运。”~
@89267 = ~她微微一笑：“我猜我理解。无论如何，也没有什么不好的感觉。”~
@89268 = ~她笑了：“好！让我们继续，去完成这个任务，好吗？”~
@89269 = ~“哦，”她看起来有点失望，“从书里听起来你的冒险很有趣。不过我猜实际上它并没有那么激动人心。”~
@89270 = ~“是，我出生在那儿，不过很多时候我都在外面生活。我只是回来帮助这个城市摆脱瘟疫的困扰，然后我决定留下来。”她皱眉想着，显然是在回忆，“有一段时间我留在那里，”她补充道。~
@89271 = ~“真的，我猜想。继续走吧，好吧？”~
@89272 = ~沙尔文重重地叹了口气：“的确，我一度留在那里。纳什尔领主很希望我们能帮助解决瘟疫，并帮助重建民兵部队。我们曾经是英雄，感觉不错。”~
@89273 = ~“我一直想出名，但是我那时很光荣。不过它……没有持续多久。”~
@89274 = ~“一个我……我爱的男人离开了那个城市。他没有回来。我知道这听起来并不像我，但是……无冬城自此看起来就很孤独了。我想再次去冒险。”~
@89275 = ~“那就是为什么我一听到召唤就来到深水城。自然，遇见了你。”~
@89276 = ~“是的。虽然那英雄对<HISHER>拯救无冬城的功劳刻意保持低调，但我很清楚……如果不是靠着那位无冬城的英雄，我们无法取得现在的胜利。”~
@89277 = ~沙尔文耸耸肩，好像因为这个不愉快的话题而皱起了眉头，“<HESHE>在瘟疫结束和艾瑞贝丝死之后没有多久就离开了。我回想起来，也许是因为……与纳什尔之间存在分歧的缘故吧。”~
@89278 = ~“我想，我现在同样来帮助你。当我不歌唱就在战斗和施放魔法。事实上，我与艾瑞贝丝女士共事。”她的脸阴郁了下来。“你听说过她吧。”~
@89279 = ~“我知道为什么你这么称呼她，但是她的故事没你听说的这么简单。我想这很悲哀……特别是在最后的时候。”~
@89280 = ~“她死了，”沙尔文简单的说，“所有故事似乎都是这样结局的吧？”~
@89281 = ~她点点头，叹了口气：“我并不责备她所做的事情。不是全部。事实上，这真是个悲惨的故事……尤其是最后。”~
@89282 = ~“真的？我想她的故事大概现在已经四处流传了。只能说她是一个最终被迫背叛了她的人民圣武士。一个悲伤的故事……特别是结局。”~
@89283 = ~“如你所愿，然而我不会无限期的接受。”~
@89284 = ~“很好。我期待这次冒险！”~
@89285 = ~“知道了。也许以后吧。”~
@89286 = ~“我想……坦白一些事情。”~
@89287 = ~她走了一会神，脸红了：“好吧，问个问题吧。你……你发觉我们之间的某些事情了吗？”~
@89288 = ~沙尔文用笑声来掩饰被伤害的感觉：“我知道了。唔……知道了也不错。谢谢。”~
@89289 = ~她笑着对你摇晃着手指头：“别对我太热情了，这只是个简单的问题。比较，我们彼此之间并不太了解。”~
@89290 = ~“首先我是因为安德伦泰德的传闻而知道了你。其次，你救了我的命，我知道了你被认为是英雄的原因。”~
@89291 = ~“无论如何，我们有工作要去做，对吧？最好以后再讨论这些。”她停了一会，然后笑了，在转身要走时轻轻的吻了你。~
@89292 = ~她慢慢的点点头，微笑了：“我想这是个公正的答复。毕竟，我们彼此了解的不多。”~
@89293 = ~沙尔文脸红透了：“不，我没有开玩笑。”~
@89294 = ~她有点羞怯的笑了：“事实上，有点崇拜英雄。我不知道是否告诉过你，和你一起冒险真的很高兴。”~
@89295 = ~“我的意思是，首先因为你是安德伦泰德传说中的<CHARNAME>，我很兴奋……但随后，因为你救了我，我知道为什么你被称作英雄了。我……我很高兴在这里。”~
@89296 = ~沙尔文点点头：“当然。”~
@89297 = ~她点点头：“我……我只是希望你知道。就这些。”~
@89298 = ~“你去过黑暗地域吗？”~
@89299 = ~“嚯。真够粗鲁的。也许你可以在将来再加入同伴们。”~
@89300 = ~“好，首先你应该知道的是这是费伦大陆上最危险的地方，如果你愿意也可以说是费伦内部最危险的地方。”~
@89301 = ~“我们在哪儿都不能安全的休息。卓尔肯定会严密的巡逻。即使你可以抵抗眼魔的眼光，我可不敢相信你也能抵抗灵吸怪的心灵攻击。”~
@89302 = ~她耸耸肩：“无论如何，我觉得你需要的是多动脑子。我想你已经听说过很多关于黑暗地域的事情了。”~
@89303 = ~“似乎我们正朝那个方向前进。考虑到卓尔、灵吸怪还有眼魔都掺和进来了，我可看不到其他的选择了。”~
@89304 = ~“我有点好奇……你想拿这些报酬来干些什么呢？”~
@89305 = ~“好吧。我只是问问。”~
@89306 = ~“不？好，我知道我会拿那些钱做什么。”她的眼睛望着远方。~
@89307 = ~“哦来吧，别那么腼腆。花那么多钱肯定有些好事的。”~
@89308 = ~“哦我知道。不过，钱真不少。你一定要考虑一下。”~
@89309 = ~“啊！我认识！你想买的第一个东西是什么？”~
@89310 = ~她笑了，眼睛也睁大了：“嗯嗯……更好的……”她沉思了一会。“我能想想更好的吗？我不确定……嗯……”~
@89311 = ~“我会买能买到的最好的东西，要是费伦最好的工匠的作品！然后我就会四处旅游，只在最棒的旅店里休息！”她开心的大笑着。~
@89312 = ~“但我想我们得先从这次冒险中幸存下来，对吧？我们得动身了。”~
@89313 = ~她盯着你想看看你是不是认真的：“哦。好，我……我知道这是个合适的理由。”她耸耸肩。“或许这对我不太好，不过我知道自己该做什么。”~
@89314 = ~她满意地吹着口哨：“现在有东西值得看看了。你确定十万金币够了？”她咯咯的笑着。“我可知道自己用那些钱会做什么。”~
@89315 = ~她转转眼睛傻笑着：“你在戏弄我吧。我可知道自己用那些钱会做什么。”~
@89316 = ~“告诉我……你曾经是矮人乔甘的学生，是吗？一个矮人法师？”~
@89317 = ~她狡猾地表示：“我们都有点暴躁？这是一个简单的问题。”~
@89318 = ~她悲伤地点点头：“是，我知道。直到我从书里看到才知道这些，这对我是个震惊。他是个很好的矮人。我很高兴他还是开始建立他的学校了。”~
@89319 = ~“很好。原谅我提出这个问题。”~
@89320 = ~“哦？”她轻轻的笑了。“你不是<CHARNAME>·<CHARNAME>，安德伦泰德的英雄吗？我怎么觉得你是另外一个人？”~
@89321 = ~“他终于还是开办了一个学校。很高兴知道这些，因为这事情是他一直计划要去做的。”~
@89322 = ~“是我，不过没有多久。当我年轻的时候他想招我参加竖琴手。我还总在想他是不是有什么事情了。”~
@89323 = ~“是的，只有一段时间。乔甘很想让我加入，不过当我告诉他我的选择之后，他也同意了。随后我再没有见过他了。”~
@89324 = ~“不过，有时我会后悔没有加入竖琴手。”她对你扬起眉头，“你怎么样？你想过加入竖琴手吗？”~
@89325 = ~她点点头：“那就是我所期望的。”~
@89326 = ~她重新惊奇地微笑着打量你：“我该有所察觉的，真的。”~
@89327 = ~“好吧，我们得上路了。谈论那些老朋友总是让我很悲伤。我们干些刺激点的事情吗，好吧？”~
@89328 = ~“我挺奇怪这没有发生。乔甘把自己献身于对抗大陆上邪恶势力。”她耸耸肩，“也许到他遇见你时，他不会支持你。”~
@89329 = ~“是的，乔甘邀请了我。”她悲伤地叹了口气，“最后，我认为这些徘徊和侦察不适合我。我喜欢自己冒险。”~
@89330 = ~--------- Random Conversations begin here ----------~
@89331 = ~“我不能相信我们还在这里转来转去。你带的那个……那个神物是不是可以……可以传送我们通过这些障碍呢？”~
@89332 = ~“我只是有点紧张。”她把目光移开，似乎有些不好意思。“我只是猜想我们到这里好一会了，可是还在原地打转。或者说是我这么感觉的。”~
@89333 = ~她慢慢的点点头。“很好。无论如何，我不想再说什么了。我们继续前进吧。”~
@89334 = ~她盯着看了很久才说话。“你是那么说的，但是你怎么来保证？我俩并没有互相了解。”~
@89335 = ~“不怕，不。”她非常严肃的看着你。“我很久以前就不会在冒险里感到害怕了。我了解冒险。”~
@89336 = ~“不，我不想回旅店去。我不想停下来，别这么想。”~
@89337 = ~“当你在这儿发现我的时候，我正在思考。”她的脸色又陷入了沉思。“我被杀的太快了……如果你没有找到我……”~
@89338 = ~沙尔文重重的叹了一口气，勉强笑了一下。“我猜我所害怕的事情是糟糕的结局。轻松的结束，没有经历什么高潮……你理解我说的话吗？”~
@89339 = ~她突然笑着看着你。“看来你理解我的话。谢谢，我很欣赏这一点。但是……现在不是时候。我不该这样抱怨的……我的故事在这里不是重要的。我们继续前进吧。”~
@89340 = ~“我不该这么说。在结束之前我们有不少工作要去完成吧？我的故事还可以等待。”~
@89341 = ~“嗯那没有用。”~
@89342 = ~她沉思的皱起了眉头。“我认为你是对的。对于传送在这里可以正常进行我应该感到很奇怪的。不应该这样的。”~
@89343 = ~“我听说过。你小有名气的，记得吗？”~
@89344 = ~“嗯我们一定可以利用某些东西，因为所有我们做的都是越来越深的进入山下地城。”~
@89345 = ~“我……你是对的，你是对的。请原谅我。”~
@89346 = ~“管好自己？”她瞪着你。“难道我的生存不关我自己的事？看来现在我们所做的就是越来越深的进入山下地城。”~
@89347 = ~“除非我认错了，这里就是沉睡诸王之殿！”她充满敬畏的打量着周围。“我……我没想到居然有这么大。”~
@89348 = ~她点点头。“好吧。不过……不过要小心点，别碰任何东西。”~
@89349 = ~她微笑着扫了你一眼。“你最好知道这点。你不了解王座上死者的真正意义，所以最好什么都不要碰。”~
@89350 = ~她深深的吸了一口气，在继续说话前紧紧盯着一具骷髅好一会。“人类是一个古老的种族，比我们想的要老的多。我们真实的历史记录可能已经淹没在古代的战争里。”~
@89351 = ~“费伦的北方有很多国家，他们的名字甚至不为人所知，统治这里的是巫师之王，还有许多被遗忘的诸多大人们。”~
@89352 = ~她指指房间里的遗骸。“据说海拉斯特收集了那些最伟大古代国王的遗骸，并把他们安葬在这里。他们长眠于此，荣誉之地。”~
@89353 = ~“我不会碰他们。事实上，我不想。”她想房间的另一头点头致意。“我们继续前进吧？”~
@89354 = ~“可能。毕竟，这里是山下地城。我……我认为如果你不去打扰这些骸骨，他们也不会来烦你，但是我可不能完全肯定。”~
@89355 = ~她耸耸肩。“我猜那要看你的观点了。他们可能被埋葬在某些被遗忘的墓穴里，在其上一些人修建了房屋。如果是我，我觉得是这里。”~
@89356 = ~“我想我们可能已经进入了镜之神殿。这里是山下地城的几个著名地方之一。”~
@89357 = ~“如果你那么说。毕竟，能踏入这种地方的机会不多。”~
@89358 = ~“有人进入过山下地城，不久之前他们回来了……迄今为止，他们是唯一活着叙述自己经历的人，他们经常提起这个房间。”~
@89359 = ~“它的构造有时会改变，但一般是长长的两派镜子。某些是具有魔力的，某些则没有，按照推测具有魔力的非常不同……不过通常都是致命的。”~
@89360 = ~“经常提起的一面镜子就是相反之镜。它产生你的一个复制对手来攻击你自己。想想自己和自己打！”~
@89361 = ~“我个人想知道海拉斯特是在哪里得到所有这些东西的？你认为是他自己制造的吗？他怎么办到的？”~
@89362 = ~“不是的，比事实更重要的是我们应该继续向前。但是你会想看的，不是吗？当然你会的。”~
@89363 = ~“可能，对于合适的买家。但是看看这些东西。你怎么能把它们都运出去？更不要说当你靠近它时，它还会施放魔法。”~
@89364 = ~“我不知道。传说似乎是真的，因为所有的镜子都是一样的。”~
@89365 = ~“自然是。山下地城比深水城要古老的多，贯穿它的历史总不乏诸多的最著名的冒险者。这方面的传说很多。”~
@89366 = ~“如果我的记忆没错，这个方面可能离入口近些。显然海拉斯特喜欢有规律的安排他的迷宫。我真想见见那个人！”~
@89367 = ~“一些。事实上，好像知道的不多……他是一个伟大的大法师，很久以前就因为妄想而变得疯狂，藏身于自己创造的地下城之中。不知道他本人是否喜欢交际。”~
@89368 = ~她怀疑的看着你。“你不这样想吗？我们谈论的是一位费伦最伟大的大法师之一。我想和他谈谈，了解他发狂的原因，因为我不知道为什么会这样。”~
@89369 = ~“是的，我猜想他有很多魔法。人们希望从他那里夺去这些，大概这就是让他发狂的最初原因吧，你认为呢？”~
@89370 = ~“我猜，好消息是如果我和你一起，可能会遇到他。如果山下地城发生了一些重大的事情，海拉斯特大概会被卷进来的。”~
@89371 = ~“唔，他没有告诉过我这些事情，但是我们还是谈到了想像中的情况。海拉斯特不见任何人。”~
@89372 = ~“就看这个了。黑袍海拉斯特疯狂而充满妄想。毫无疑问他不需要地图来说明什么。”~
@89373 = ~她悲伤的笑了：“但是我肯定你对我幻想不感兴趣。我们有重要的事情要去做，对吧？我能再和你一起吗？”~
@89374 = ~她高兴的点点头：“很好。又开始伟大的冒险了。”~
@89375 = ~她的眉毛皱成了一团：“你救了我的命，不用我来帮你吗？好吧，那么，还是要谢谢你……如果要我帮忙，我随时效劳。”~
@89376 = ~------- 这一行必须放在队员之间说笑的结束处 ---------~
@89377 = ~“你知道的，汤米，我好像想起你以前提起的一个传说了。”~
@89378 = ~“是？这是个新东西。我过去仔细看看？”~
@89379 = ~“不是。但是，当你知道我是从谁那里听说这个故事，或许你就没那么惊讶了。”~
@89380 = ~“嗯？好的，别让我太担心。”~
@89381 = ~“我想你知道他。一个叫做萨米的老兵。”~
@89382 = ~汤米的反应非常剧烈。他的眼睛瞪的溜圆，连眼珠都快冒出来了：“萨米？！你看到过他？！在哪儿？！”~
@89383 = ~沙尔文吃吃地笑道：“哦，另外，我告诉了他哪里可以找到你。”~
@89384 = ~“到底为什么你这么做？！”~
@89385 = ~“我一直信仰公正，我的小朋友。”说完这话，沙尔文自鸣得意的笑着，走开了。~
@89386 = ~“你知道，汤米……我和你谈起过我戴的金戒指吗？”~
@89387 = ~“不。为什么我要知道呢？”~
@89388 = ~“事实上，这个故事和你有关。”~
@89389 = ~“是吗？那就讲吧。嘿，我一直喜欢听自己的故事。”~
@89390 = ~“你知道，曾经有一个我深爱的男人。他想娶我，而我也很乐意……但是他很穷困而且认为自己微不足道。他说要寻找一枚足以配的上我们爱情的戒指，在一天扬帆远去。”~
@89391 = ~“很多个月过去了，我一直没有见到他，悲伤的认为他背叛了我。然而，很久之后，我收到了一个口袋，里面有一封信，是我的爱人写下的，他带着我的爱驾船出行，回到无冬城。”~
@89392 = ~“信中说船沉了，尽管我的爱人从中逃生，不过没有几天还是因为发烧而死去了。我的爱人把这个戒指交给了这个人，并请求他把它送给我，希望我为了他带上这枚爱的信物。我一直戴着。”~
@89393 = ~“噢！这和汤米有什么关系？”~
@89394 = ~“不到五分钟前你偷偷把它摘了下来，你这个小矮子。如果你不赶快交给我，我会切断半身人中被称为成年人的家伙。”~
@89395 = ~“哦。嘿……为什么，看看这儿！这是你说的戒指吧？”汤米小心翼翼的把戒指还给了她。~
@89396 = ~“非常被迫。”~
@89397 = ~“告诉我，达尔兰，乌斯嘉要求每年要跳进冰冷的水里一次，是真的吗？”~
@89398 = ~“不是要求，沙尔文，只是庆祝一年的过去。大家在冰上打个洞，那些想跳的人就在黑水之中畅游。”~
@89399 = ~“你不是在开玩笑吧！这样游水会害死人的！这事情真是勇敢到了愚蠢的地步，事后难道你不会发烧而亡吗？”~
@89400 = ~达尔兰好奇的对她弯弯眉毛。“你不试试怎么知道这事情是勇敢到了愚蠢的地步呢？”~
@89401 = ~“曾经冬天又一次我试图涉水过河，那时候我很年轻，不小心掉了下去。我能幸存下来真是一个奇迹。”~
@89402 = ~“我们不会穿着衣服的，游泳之后我们会赶紧到温暖的地方弄干自己。这很爽，而且令人愉快，一点都没有什么伤害。”~
@89403 = ~沙尔文惊讶的望着达尔兰。“你光着身子在冰冷的水里游泳？！”~
@89404 = ~“是的，经常不穿衣服。身体很快就会热起来……是那些湿衣服带走了我们的温暖。嗯……为什么你这么盯着我？”~
@89405 = ~她目光朦胧的盯着这个强健的野蛮人。“噢……在想像你游泳的样子。”~
@89406 = ~“如果你喜欢，并且我们在新的一年还活着的话，我会很高兴让你见识一下。但是只能是在你和我一起的情况下。”~
@89407 = ~“嗯，挺诱人的。我会盼望的。”~
@89408 = ~“你知道，达尔兰，我曾经遇到过很多半兽人。他们大都是粗鲁的笨蛋，沉醉于自己的兽人血统之中。”~
@89409 = ~“对于人类我们是兽人，对于兽人我们则是人类，这使得我们很少为人所接受。所以我们都很沉醉于我们的差别之中。”~
@89410 = ~“你理解了。你比想像的要聪明的多。事实上，真的很惊讶。”~
@89411 = ~“我没什么惊奇的，吟游诗人。我只是一个试图获得高尚的普通的人。”~
@89412 = ~“那不是惊奇吗？”她轻轻的咯咯笑着。“你经常洗澡？还有你身上的气味……”~
@89413 = ~“我洗澡是因为卫生，而且在文明之的它是一个公认的习惯。你闻到的味道是我用来驱赶那些飞虫的药膏，它们被兽人的汗水吸引而来。”~
@89414 = ~“嗯。我没必要知道。闻起来很舒服。好像是桂皮还有玫瑰花瓣和蜂蜜混在一起的味道。”~
@89415 = ~“我相信是鲁特加根。在乌斯嘉之中，大家咀嚼鲁特加来防止蛀牙。”~
@89416 = ~“充满了浪漫的想法，不是吗？咳……”~
@89417 = ~“莉努，我想……你去过相遇之地吗？”~
@89418 = ~“哦。”莉努把目光移开，似乎有点悲伤。“那个精灵国度迁移的地方。”~
@89419 = ~“还有其他的相遇之地吗？”~
@89420 = ~“不，当然不。”莉努直接的望着沙尔文，摇摇头。“不，我没有去过那儿，尽管我非常想去。”~
@89421 = ~沙尔文看起来很迷惑。“你过去想去又没去？为什么不去呢？”~
@89422 = ~很久，莉努都说不出话来。最后她叹了口气耸耸肩。“我弄沉了船。”~
@89423 = ~“船？你是说你把带你去相遇之地的船给弄沉了？”~
@89424 = ~莉努点点头，不太高兴。“是一次可怕的事故！我怎么知道这船居然运载着送往岛上的灯油呢？”~
@89425 = ~“通常这似乎没什么区别。我能问问……”~
@89426 = ~“哦，”莉努生气的摆摆手。“一只猫偷了我的钱包。我承认是我救了它嘴里的那只可怜的老鼠。然后我绊倒了服务员，他手里拿了一只火把……这只是意外，猫抓了我，我往回一跳……”~
@89427 = ~“现在你在嘲笑我。我不会再说了。”~
@89428 = ~沙尔文非常用力的忍着窃笑。“对……对不起，莉努。真是悲伤……嚯嚯……”~
@89429 = ~“莉努，有时候我认为你有点过分善良热心了。你得注意这一点。”~
@89430 = ~莉努怀疑着望着沙尔文。“你说什么呢？对别人善良是没有错的。”~
@89431 = ~“有点错哦。还记得那个在“敞开大门”的那个滑头滑脑的家伙吗？你让她整整耽误了你三个小时。”~
@89432 = ~“我让他走开别打扰我。我还能怎么说。”~
@89433 = ~“我三十秒就可以让他滚蛋。”沙尔文捏着手指头。“否则他就有好受的。”~
@89434 = ~莉努吃吃的笑着，有点不好意思。“我可不能想像我能这么说话！不，我做不了。”~
@89435 = ~“那么这样，‘听着，人类，走开，要不就把你的卵蛋打进肚子里去。’很有效，相信我。”~
@89436 = ~“但是……如果我喜欢那个绅士，并不想赶走他呢？”~
@89437 = ~沙尔文笑了。“那么这就是另外一个话题了。我们以后再谈……我需要一些小东西。”~
@89438 = ~“德金，你是否意识到了就是因为你，才有许多别的狗头人进入了文明之地？”~
@89439 = ~“德金不知道。是真的吗？”~
@89440 = ~“是的，事实上，尽管众所周知他们很多都比你要邪恶的多，就我听说的是这样。”~
@89441 = ~“邪恶？是闻起来很臭的意思吗？”~
@89442 = ~“不，意思是……好，意思是他们不好，德金。他们是小偷和类似的角色，他们和佣兵一起工作。一点不像你这样可爱。”~
@89443 = ~“你认为德金可爱？”~
@89444 = ~“我们怎么说起这个了？我们是在讨论从洞穴里出来的其他狗头人。”~
@89445 = ~“德金希望再谈谈他有多可爱。”~
@89446 = ~“嗯。我们还是继续前进吧，好吗？那样最好。”~
@89447 = ~“我能问吗，德金……你在哪里学习了吟游诗人的技能？我想像不到狗头人具有吟诵音乐和诗歌的能力。”~
@89448 = ~“不。德金不是在狗头人部落学习的吟游诗人的技能。德金从老主人那儿学的。”~
@89449 = ~“嗯。这个老主人……他是人类吗？接受你的慈祥的陌生人？”~
@89450 = ~“不，老主人是一条巨大的夸夸其谈的白龙，它叫泰莫法拉。它留下德金，希望德金来取悦它。”~
@89451 = ~“一条白龙？我没有听过会用魔法的白龙。”~
@89452 = ~“老主人可以。老主人很聪明，它有很多书。德金一直都在读书，从中德金学会了很多东西。”~
@89453 = ~“是他教你演奏音乐的？”~
@89454 = ~“不，不像德金，老主人没有耳朵听音乐。德金自己学的。”~
@89455 = ~“真奇妙。你真是个复杂的小家伙。”~
@89456 = ~“嗯……德金说谢谢吗？”~
@89457 = ~“别介意。”~
@89458 = ~“我想我们得分开了。”~
@89459 = ~“不，别介意。”~
@89460 = ~“在这儿等我回来。”~
@89461 = ~“我要走了。”~
@89462 = ~“我想改变你的战术。”~
@89463 = ~“我现在什么都不想改变。”~
@89464 = ~“我希望你把发现的陷阱留下来。”~
@89465 = ~“我希望你解除所有发现的陷阱。”~
@89466 = ~“我想快些前进，不用搜索或者隐蔽。”~
@89467 = ~“我现在需要你隐蔽起来。”~
@89468 = ~“如果我没能打开门或者箱子不用来帮我。”~
@89469 = ~“如果我没能打开门或者箱子你就来帮我。”~
@89470 = ~“我想改变你我之间的距离。”~
@89471 = ~“离远一点。”~
@89472 = ~“保持中等距离。”~
@89473 = ~“靠近些。”~
@89474 = ~“前进，攻击任何出现的敌人。”~
@89475 = ~“保护我，等我开始动手再攻击。”~
@89476 = ~“我想改变你的装备。”~
@89477 = ~“你能鉴别我的物品吗？”~
@89478 = ~“我现在需要你吟唱歌曲。”~
@89479 = ~“我希望你施放一组辅助法术。”~
@89480 = ~“算了。”~
@89481 = ~“施放所有的辅助法术。”~
@89482 = ~“施放所有的长效辅助法术。”~
@89483 = ~“施放所有的短期辅助法术。”~
@89484 = ~“我希望你施放法术。”~
@89485 = ~“算了。”~
@89486 = ~“创伤低语。”~
@89487 = ~“超视觉。”~
@89488 = ~“真知术。”~
@89489 = ~“召唤IX级生物。”~
@89490 = ~“召唤VIII级生物。”~
@89491 = ~“召唤VII级生物。”~
@89492 = ~“召唤VI级生物。”~
@89493 = ~“召唤V级生物。”~
@89494 = ~“召唤IV级生物。”~
@89495 = ~“召唤III级生物。”~
@89496 = ~“召唤II级生物。”~
@89497 = ~“召唤I级生物。”~
@89498 = ~“石肤术。”~
@89499 = ~“法术抗力。”~
@89500 = ~“法术吸收。”~
@89501 = ~“虔诚护盾。”~
@89502 = ~“护盾术。”~
@89503 = ~“阴影护盾。”~
@89504 = ~“识破隐形。”~
@89505 = ~“圣域术。”~
@89506 = ~“复原术。”~
@89507 = ~“提升抗力。”~
@89508 = ~“抵抗元素伤害。”~
@89509 = ~“移除麻痹。”~
@89510 = ~“移除恐惧。”~
@89511 = ~“移除疾病。”~
@89512 = ~“移除诅咒。”~
@89513 = ~“移除目盲/耳聋。”~
@89514 = ~“再生术。”~
@89515 = ~“法术防护。”~
@89516 = ~“防护元素伤害。”~
@89517 = ~“预知术。”~
@89518 = ~“祈祷术。”~
@89519 = ~“智慧术。”~
@89520 = ~“中和毒性。”~
@89521 = ~“异常再生术。”~
@89522 = ~“次级法术无效结界。”~
@89523 = ~“心灵屏障。”~
@89524 = ~“集体加速术。”~
@89525 = ~“魔化护甲。”~
@89526 = ~“法师护甲。”~
@89527 = ~“光亮术。”~
@89528 = ~“次级法术吸收。”~
@89529 = ~“次级复原术。”~
@89530 = ~“次级心灵屏障。”~
@89531 = ~“次级解除魔法。”~
@89532 = ~“敲击术。”~
@89533 = ~“隐形法球。”~
@89534 = ~“隐形。”~
@89535 = ~“高等隐形。”~
@89536 = ~“加速术。”~
@89537 = ~“高等石肤术。”~
@89538 = ~“高级法术吸收。”~
@89539 = ~“高等圣域术。”~
@89540 = ~“高等复原术。”~
@89541 = ~“高级魔化武器。”~
@89542 = ~“高级解除魔法。”~
@89543 = ~“法术无效结界。”~
@89544 = ~“鬼面术。”~
@89545 = ~“行动自如。”~
@89546 = ~“狐之狡诈。”~
@89547 = ~“寻找陷阱。”~
@89548 = ~“轻灵术。”~
@89549 = ~“墒光护盾。”~
@89550 = ~“能量缓冲术。”~
@89551 = ~“不，我改变主意了。”~
@89552 = ~“是，继续。”~
@89553 = ~“忍受元素伤害。”~
@89554 = ~“坚韧。”~
@89555 = ~“元素护盾。”~
@89556 = ~“鹰之光彩。”~
@89557 = ~“神能。”~
@89558 = ~“解除魔法。”~
@89559 = ~“防死护界。”~
@89560 = ~“死亡护甲。”~
@89561 = ~“唤起死灵。”~
@89562 = ~“不灭明焰。”~
@89563 = ~“清醒术。”~
@89564 = ~“轻灵术。”~
@89565 = ~“蛮力术。”~
@89566 = ~“我改变主意了。”~
@89567 = ~“对所有人施法。”~
@89568 = ~“对施法。”~
@89569 = ~“对施法。”~
@89570 = ~“对施法。”~
@89571 = ~“对施法。”~
@89572 = ~“对施法。”~
@89573 = ~“对施法。”~
@89574 = ~“对施法。”~
@89575 = ~“对施法。”~
@89576 = ~“对施法。”~
@89577 = ~“给我的动物同伴施法。”~
@89578 = ~“给我的同伴施法。”~
@89579 = ~“给我施法。”~
@89580 = ~“给你自己施法。”~
@89581 = ~“祝福术。”~
@89582 = ~“操纵死尸。”~
@89583 = ~“帮帮忙。”~
@89584 = ~“你以前想说的是什么？”~
@89585 = ~“停下来说说话。”~
@89586 = ~“我们说完了。”~
@89587 = ~“不，没有了。”~
@89588 = ~“一切怎么样？”~
@89589 = ~“我想谈谈你的职业发展。”~
@89590 = ~“把你的时间均分在战士和吟游诗人的修行上吧。”~
@89591 = ~“继续你现在的发展。”~
@89592 = ~“重视战士的修行。”~
@89593 = ~“重视吟游诗人的修行。”~
@89594 = ~“你打算在这一切结束之后做些什么呢？”~
@89595 = ~“如果你不呢？”~
@89596 = ~“我认为，和一个有趣的人在一起很好。”~
@89597 = ~“我是个孤独的人，不过还是谢谢你的提议。”~
@89598 = ~“在地狱没有机会。”~
@89599 = ~“不。我有自己的计划。”~
@89600 = ~“我想应该就这么办。”~
@89601 = ~“我恨那里。除了沙漠和跋涉，什么都没有。”~
@89602 = ~“说实话，我没看出来。”~
@89603 = ~“没什么奇特的。”~
@89604 = ~“你说你来自无冬城，对吧？”~
@89605 = ~“我们已经讨论的够多了。”~
@89606 = ~“那么你在无冬城没有待多久？”~
@89607 = ~“为什么？发生什么了？”~
@89608 = ~“你认识无冬城的英雄吗？”~
@89609 = ~“<HESHE>怎么了？”~
@89610 = ~“你是如何帮着拯救那个城市的？”~
@89611 = ~“那个邪恶的叛徒？”~
@89612 = ~“最后怎么样？”~
@89613 = ~“是的。”~
@89614 = ~“不，没有。”~
@89615 = ~“不，暂时留在这里。”~
@89616 = ~“是，和我来。”~
@89617 = ~“现在不。我忙着呢。”~
@89618 = ~“是什么，沙尔文？”~
@89619 = ~“什么样的招认？”~
@89620 = ~“不。我没有。”~
@89621 = ~“你在开玩笑吗！我还一直想你不会问！”~
@89622 = ~“我不知道。我不了解你。”~
@89623 = ~“也许。多给些时间吧。”~
@89624 = ~“你开玩笑吗？”~
@89625 = ~“我知道。继续前进吧。”~
@89626 = ~“嗯……是的，不过……那不太舒服。”~
@89627 = ~“谢谢，沙尔文。”~
@89628 = ~“管好你自己吧。”~
@89629 = ~“不，我以前没有去过那里。”~
@89630 = ~“为什么你要问？”~
@89631 = ~“不关你的事，沙尔文。”~
@89632 = ~“我还没有考虑过。”~
@89633 = ~“你不想知道吗？”~
@89634 = ~“我还没有拿到报酬。”~
@89635 = ~“我想或许有些事情……”~
@89636 = ~“多么伟大的艺术殿堂！”~
@89637 = ~“事实上我会把钱尽可能交给那些需要它的人。”~
@89638 = ~“我想，或许我会建造一个城堡。”~
@89639 = ~“我会建造一座神殿来献给我的神。”~
@89640 = ~“也许，会造一座高塔作为魔法实验室。”~
@89641 = ~“我没想过。也许是一个安静的修道院？”~
@89642 = ~“也许是深水城的一座大厦。”~
@89643 = ~“也许，是买些新鞋。”~
@89644 = ~“我不想讨论这个。”~
@89645 = ~“我猜你是对的。我曾经在山顶村的乔甘学校待过。”~
@89646 = ~“主人乔甘死了。我不想谈他。”~
@89647 = ~“我说不，我说到做到。”~
@89648 = ~“不，你把我当成别人了。”~
@89649 = ~“我说过了，放在那里。”~
@89650 = ~“是，对。他在山顶村建立了一所学校。”~
@89651 = ~“你认识他？”~
@89652 = ~“那么你只了解他一点点……”~
@89653 = ~“不，绝不。”~
@89654 = ~“我有自己的机会。”~
@89655 = ~“是的，我想我会。”~
@89656 = ~“我已经是个竖琴手了。”~
@89657 = ~“竖琴手？那是什么？”~
@89658 = ~“乔甘想招募你参加竖琴手？”~
@89659 = ~“我们好像有点不耐烦了？”~
@89660 = ~“安静！我不想听人哭哭啼啼的。”~
@89661 = ~“别担心，我们会好的。”~
@89662 = ~“你没有被要发生的事情吓着吧，是吗？”~
@89663 = ~“你回旅馆吧，如果你想的话。”~
@89664 = ~“我想你在哭泣。”~
@89665 = ~“不是，不。”~
@89666 = ~“但我的确找到了你。你的故事还没有结束。”~
@89667 = ~“我这么认为。”~
@89668 = ~“它只能带我去已经去过的地方。”~
@89669 = ~“也许是。对你又如何呢？”~
@89670 = ~“没用？你疯了吗？”~
@89671 = ~“事实上，如果你想想，就知道它很有用。”~
@89672 = ~“你了解我的神物吗？”~
@89673 = ~“我们不需要靠它来克服前进路上的阻碍。”~
@89674 = ~“你没必要和我一起来。回旅馆去。”~
@89675 = ~“你为什么心烦呢？”~
@89676 = ~“至少我们正在前进。”~
@89677 = ~“唔，管好你自己吧。”~
@89678 = ~“够了。继续前进。”~
@89679 = ~“沉睡？他们好像都死了。”~
@89680 = ~“你对这个地方有什么了解吗？”~
@89681 = ~“那么，继续前进。”~
@89682 = ~“看起来他们的死亡有格外的价值……”~
@89683 = ~“这儿有什么危险吗？”~
@89684 = ~“这里没什么光荣的事情。”~
@89685 = ~“好吧，以后再谈。”~
@89686 = ~“这儿有什么危险吗？”~
@89687 = ~“你对这个地方有什么了解吗？”~
@89688 = ~“好吧，前进。”~
@89689 = ~“有我该知道的事情吗？”~
@89690 = ~“相反之镜是不是很贵重？”~
@89691 = ~“你怎么分别彼此呢？”~
@89692 = ~“这里有山下地城著名的地方。”~
@89693 = ~“别管它了。继续前进。”~
@89694 = ~“和我谈谈这个镜之神殿。”~
@89695 = ~“你对海拉斯特了解的多吗？”~
@89696 = ~“你真的希望遇见他？”~
@89697 = ~“我只想要他的一些力量。”~
@89698 = ~“是的，可能那挺有趣的。”~
@89699 = ~“你真是疯了！”~
@89700 = ~“你觉得这个地下城重新安排了吗？”~
@89701 = ~“是的，走吧。”~
@89702 = ~“不，暂时留在这里。”~
@89703 = ~“好像是，让我告诉你。”~
@89704 = ~随机弹出内容#20~
