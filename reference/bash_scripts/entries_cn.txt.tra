@97042 = ~“公证者？那是谁？”~
@97043 = ~“公证者的向导是谁？”~
@97044 = ~“她叫什么名字？”~
@97045 = ~“但是如果没人知道你名字的话，那这些雕刻是谁做的？”~
@97046 = ~“公证者？那是谁？”~
@97047 = ~“公证者的向导是谁？”~
