@108988 = ~“在我们军队里曾经有个智者，帮我们破解了巴特祖密码。即使是在他死后，我们这里也没人能超越他的才智。”~
@108989 = ~“要是那么简单就好了。我急着赶在血战的地狱之鼓的鸣响把我永久地震聋之前，离开这地方。”~
@108990 = ~“这群笨家伙。为什么还要去找什么正当理由？教他们去信奉邪恶的真理，<CHARNAME>，就像你教我的那样！”~
@108991 = ~“是真的，<CHARNAME>。我们的过去记忆已渐渐模糊，甚至是我过去有过那么多的事。”~
@108992 = ~“是为了保全你，<CHARNAME>。为了保全我们……”~
@108993 = ~“你没看到我也在么？够了，这笑话过时了。”~
@108994 = ~“让它歇会儿吧，<CHARNAME>。我不喜欢这些有关我过去的传说。”~
@108995 = ~“在我们军队里曾经有个智者，帮我们破解了巴特祖密码。即使是在他死后，我们这里也没人能超越他的才智。”~
@108996 = ~“画？德金的叔叔会在雪上写他的名字。不过挺深奥的，老大，是吧？听来挺棘手的……”~
@108997 = ~“在我们军队里曾经有个智者，帮我们破解了巴特祖密码。即使是在他死后，我们这里也没人能超越他的才智。”~
@108998 = ~“你没看到我也在么？够了，这笑话过时了。”~
@108999 = ~“让它歇会儿吧，<CHARNAME>。我不喜欢这些有关我过去的传说。”~
@109000 = ~“这帮笨蛋说话时就仿佛看我不到一样。看来，在我路过失落之地之时，在他们眼中，我变得近乎不可见。就他们所知，我已经从这个世界上消失了。”~
@109001 = ~“是我，<CHARNAME>，尽管很奇怪他们没认出我来。看来，在我路过失落之地之时，在他们眼中，我变得近乎不可见。就他们所知，我已经从这个世界上消失了。”~
@109002 = ~“在血战中，我见过这帮军队，<CHARNAME>。招募他们是很昂贵的，不过一旦形成就势不可挡。如果这是真的，看来，对于你来的那个世界可不是个好兆头。”~
@109003 = ~“靡菲斯特要为了这些灵魂所遭受的一切而付出代价……”~
@109004 = ~“是，现在靡菲斯特拥有它了。又一个灵魂被吞噬了……很快，除了失魂者我们中谁也留不下来。要是我们能再活一次，回家……但这里现在实在是太冷了。我感觉到他在接近中……”~
@109005 = ~“是的，德金也看到它了！”~
@109006 = ~“亡灵不愿接受我，<CHARNAME>。我一直期待看到那些被我在过去战争中打败的那些已经模糊的脸……”~
@109007 = ~“卡尼亚之门打开了……远离这地狱的寒冷……我回家了……到过去常去的地方……要是我能记起我家在哪……也许我只是去……看看我能不能找到……”~
@109008 = ~“我听到你们中的一个在尖叫，而且看到了一道闪光……”~
@109009 = ~“欺负弱小只会显示你的怯懦，<CHARNAME>……”~
@109010 = ~“我也没想到，<CHARNAME>。我相信，每张图应该构成了一个更长的词的一部分。对于‘一条水蛇’，还有别的什么词么？”~
@109011 = ~“他造的图，老大，而且你和德金不过是猜这些是什么！对于‘一条水蛇’，还有什么别的词？‘踝关节’，不，不是这个……”~
@109012 = ~“对我来讲，这更像an eel。从数学方面来说，我想它试着告诉我们一些与难相对的容易事。Eel-easy……对于最后一个音节有什么想法么，<CHARNAME>？”~
@109013 = ~“我想，每张图应该构成了一个更长的词的一个音节。对于‘一条水蛇’，还有别的什么词吗？”~
@109014 = ~“An eel是‘一条水蛇’，不是吗？另外这是1+1=2，很简单……看来我们找到了。Eel-easy……对于最后一个词有什么想法吗，<CHARNAME>？”~
@109015 = ~“哦！Eel！德金猜第一个音节是eel！另外1+1=2，很简单！Eel-easy……不过，老大我们还没玩完呢！德金会在老大你想最后一个的时候保持安静。”~
@109016 = ~“哦，像字谜游戏，老大！第二个问题，是吧？有多少音节？德金过去常在部族聚会上玩这个！”~
@109017 = ~“要是还不行的话，我们就把他带到所有的柱子前。他最终总会认出他要找的那个。”~
@109018 = ~“呀，给德金再来点线索。这有点困难！”~
@109019 = ~“做得好，<CHARNAME>。”~
@109020 = ~“耶！德金要再玩一次么？”~
@109021 = ~“欺负弱小只会显示你的怯懦，<CHARNAME>……”~
@109022 = ~“地表居住者和他们的多愁善感。如果我们黑暗精灵要宠物，我们会从奴隶栏里搞到。”~
@109023 = ~“有意思啊，老大。德金想我们应该常来地狱。”~
@109024 = ~“哦，字谜游戏，老大！有多少音节？德金过去常在部族聚会上玩这个！”~
@109025 = ~“每张图代表一个长单词的一个音节。除了这个，我都不确定。”~
@109026 = ~“哇，好大的墙，老大。”~
@109027 = ~“对这个，我有种古怪的感觉，<CHARNAME>，而且我想我不喜欢这感觉。”~
@109028 = ~“咦！这是个精灵少女，老大！”~
@109029 = ~“什么啊……”~
@109030 = ~“应该和那个洞穴有关。”~
@109031 = ~“我也没想到，<CHARNAME>。我相信，每张图应该构成了一个更长的词的一部分。对于‘一条水蛇’，还有别的什么词么？”~
@109032 = ~“他造的图，老大，而且你和德金不过是猜这些是什么！对于‘一条水蛇’，还有什么别的词？‘踝关节’，不，不是这个……”~
@109033 = ~“对我来讲，这更像an eel。从数学方面来说，我想它试着告诉我们一些与难相对的容易事。Eel-easy……对于最后一个音节有什么想法么，<CHARNAME>？”~
@109034 = ~“我想，每张图应该构成了一个更长的词的一个音节。对于 ‘一条水蛇’，还有别的什么词么？”~
@109035 = ~“An eel是‘一条水蛇’，不是吗？另外这是1+1=2，很简单……看来我们找到了。Eel-easy……对于最后一个词有什么想法么，<CHARNAME>？”~
@109036 = ~“哦！Eel！德金猜第一个音节是eel！另外 1+1=2，很简单！Eel-easy……不过，老大我们还没玩完呢！德金会在老大你想最后一个的时候保持安静。”~
@109037 = ~“哦，像字谜游戏，老大！第二个问题，是吧？有多少音节？德金过去常在部族聚会上玩这个！”~
@109038 = ~“你问的是这个？”~
@109039 = ~“你看什么呢，傻瓜？”~
@109040 = ~“如果你见到阿顿·斯维菲特，帮我在他的臭嘴上给一拳。”~
@109041 = ~吉斯泽莱人凝视着你，烦人而且阴沉。~
@109042 = ~“别管我，我离家很远了……”~
@109043 = ~“该死的导师和她的沉睡者……”~
@109044 = ~“我听说我们要搞定了这个肮脏的地方。卡尼亚之门已经打开，我们中只有很少的人打算留下来艰苦跋涉回到我们的家乡，边境之地……”~
@109045 = ~一队吉斯泽莱朝圣者，无论男女。有很多地方可去，不过他们首先会选小酒馆和神殿的周围（而不是神殿里面）。~
@109046 = ~“是真的，<CHARNAME>。我们有个非常好的开始，直到它……”~
@109047 = ~“是，听来挺有趣……”~
@109048 = ~“胡说，老大！魔法火焰一直是有效的！”~
@109049 = ~“维洛克斯莓。留意她的话，<CHARNAME>，就好像没了他们，我们就活不长了。”~
@109050 = ~“我们要进出看看他，<CHARNAME>。我提议我们要杀了这个导师而且搞定它。来个快刀斩乱麻，你知道我的意见。”~
@109051 = ~“卡尼亚之门打开了。我想要带点维洛克斯莓回边境之地的家，看看他们能不能在修道院的院子里生长。”~
@109052 = ~“笨问题，<CHARNAME>。”~
@109053 = ~“我想现在我明白了。导师对于他们就像先知对于我们的作用一样，<CHARNAME>。”~
@109054 = ~“哦，开始讲故事！你不介意德金把它记下来？继续。为什么你总是用这么过分的方法？”~
@109055 = ~“信念是个私人的东西，<CHARNAME>。像商人的商品那样散布它的神圣理论，或者在所有的人面前夸耀它，会减损它的魅力和力量。”~
@109056 = ~“别管它，<CHARNAME>。其实她不过是审慎的守护着她的那点秘密。”~
@109057 = ~“神会降祸给愚人们的。”~
@109058 = ~“另一个外层位面。我的军队从未在那里战斗过，不过我的一些部下在他们离开之前，曾经去过。大部分觉得受不了那地方。边境之地是个不利于战斗的地方。”~
@109059 = ~“那么阿顿一直带着他那一小部分，是吧？一点也不奇怪……”~
@109060 = ~“半个朋友，就像我……魔鬼的血统还是恶魔的血统，尽管，这是个问题。”~
@109061 = ~“阿顿？那个骗子？”~
@109062 = ~“你那么做是什么意思？”~
@109063 = ~“一点也不？”~
@109064 = ~“我听说我们要搞定了这个肮脏的地方。卡尼亚之门已经打开，我们中只有很少的人打算留下来艰苦跋涉回到我们的家乡，边境之地……”~
@109065 = ~“你有1万块了，老大？德金想他可以提点薪……”~
@109066 = ~“你在往水井里丢钱，<CHARNAME>。他是个无赖，别管他。”~
@109067 = ~“小心点，<CHARNAME>。现在钱是很多，不过我们以后可能就很需要它了。”~
@109068 = ~“<CHARNAME>！你打算给这家伙多少钱？”~
@109069 = ~“哦，想想德金能用它做什么！这听来比我们狗头人的音乐还要棒！”~
@109070 = ~“我希望他能常洗洗它们……”~
@109071 = ~“哦，想想德金能用它做什么！这听来比我们狗头人的音乐还要棒！”~
@109072 = ~“我希望他能常洗洗它们……”~
@109073 = ~“纸牌魔术？”~
@109074 = ~“我不相信他，<CHARNAME>。我说我们切开他的喉咙，免费拿我们想要的东西……”~
@109075 = ~“诡计总是有的，<CHARNAME>。至少和这个老阿顿，在这……”~
@109076 = ~“哦，想想德金能用它做什么！这听来比我们狗头人的音乐还要棒！”~
@109077 = ~“我希望他能常洗洗它们……”~
@109078 = ~“他是个泰夫林，<CHARNAME>。就像我。”~
@109079 = ~“主意不坏，如果你问我……”~
@109080 = ~“我不会在这事上比他慢的。”~
@109081 = ~“嘿，这是德金的工作，老大！”~
@109082 = ~“你让他去送死？”~
@109083 = ~“<CHARNAME>！”~
@109084 = ~“这应该很短……”~
@109085 = ~“合适的处罚。”~
@109086 = ~“你确定，<CHARNAME>？听来是个必死的方法，如果你问我……”~
@109087 = ~“拿着你应得的，我们赶快离开这。这地方让我感觉不对头，味道也不好。”~
@109088 = ~“告诉我更多的有关喇叭的事。”~
@109089 = ~“小心点。这整个位面中，水晶还有其他的用途，有邪恶的也有良好的。这个护身符可能不会像看起来那么简单。”~
@109090 = ~“说实话，不是一味地爱好和平。当他们决定战斗时，他们是野蛮的战士。这也是他们之所以在血战中，决定不参战。”~
@109091 = ~“说实话，不是一味地爱好和平。当他们决定战斗时，他们是野蛮的战士。这也是他们之所以在血战中，决定不参战。”~
@109092 = ~“你明白我的意思？”~
@109093 = ~“我来把导师介绍给你。至于你，我恐怕你就不必介绍了……”~
@109094 = ~“我们等，我们留，都没什么区别。我同伴朝圣者除了被抛弃的信仰外什么都不缺，只梦想着回家，想着过去的事总比想着没发生的事要好。”~
@109095 = ~“监狱……”~
@109096 = ~“监狱……”~
@109097 = ~“监狱……”~
@109098 = ~“她指白色女士的监狱，老大。”~
@109099 = ~“天使就是天使，导师：善意的不过也有他们品德上的弱点。是神，树立了真诚的信仰。”~
@109100 = ~“是<HESHE>，我保证……”~
@109101 = ~“我不是很清楚如何摸清这些谎言，<CHARNAME>，但我会参加。他会把它做得很有趣味的。”~
@109102 = ~“相反的。这些荣誉全是我的……”~
@109103 = ~“一个有趣的手法，<CHARNAME>。非常好，我会扮演天使的情人。这真是个非常有趣的运动……”~
@109104 = ~“不，不要把我也带进去，<CHARNAME>！我不想这个谎言中担任什么角色。”~
@109105 = ~“小心你的谎言，<CHARNAME>。你的言辞会暴露你的……”~
@109106 = ~“那不对……为什么你对她说谎，老大？”~
@109107 = ~“但愿你能相信，<CHARNAME>……”~
@109108 = ~“你问的太多了，<CHARNAME>……”~
@109109 = ~“用她自己的信仰毁了她，<CHARNAME>……”~
@109110 = ~“带她来到泰尔的光芒之中，<CHARNAME><BROTHERSISTER>。”~
@109111 = ~“准备好你的家伙。他看起来不怎么高兴……”~
@109112 = ~“你别以为自己是神，<CHARNAME>……”~
@109113 = ~“好的，干得非常顺利……”~
@109114 = ~“你别以为自己是神，<CHARNAME>……”~
@109115 = ~“干得好，干得好……你发现她眼里的背叛了么？”~
@109116 = ~“准备好你的家伙。他看起来不怎么高兴……”~
@109117 = ~“我不能……对不起，我一生都在崇拜您，崇拜您的梦想。只是我还没有准备好……对不起……”~
@109118 = ~“不，神啊，不！您为什么要抛弃我！？”~
@109119 = ~当你接近的时候发现。“他走了，”她轻声的对自己说。“没了他我该怎么办，<CHARNAME>？我建立了一切，我全部的人生，都在他的身边……对不起，我……我实在无法自己了……”~
@109120 = ~你偷偷的瞄了一眼书卷，看起来像是一本详细描述沉睡者梦境的日记。~
@109121 = ~“随着我越来越深的探入沉睡者的思维，发现他现在越来越多的梦到了他的找寻，不停的晃动翻转。那找寻带着他来到了卡尼亚广袤的荒地，一直穿过了卡尼亚之门……”~
@109122 = ~“我甚至都可以感到那种刺骨的寒冷，在漫天的大雪之中的垂死挣扎。他拥有可以使整个世界陷入黑暗的戒指，那戒指迫使他不停的向前……”~
@109123 = ~“靡菲斯特按照他的意思遗弃了守护者，我不知道他为什么这么做。其中的两个被他用寒冰之手所杀，而且看起来他好像知道剩下的三个还活着……”~
@109124 = ~“他的伤势令人担忧。每一步都费尽力气，但是每前进一步，他也就更接近任务的成功。只有在梦结束的时候那使命的本质才渐渐显露出来。他在寻找诸界智者……”~
@109125 = ~“我找到了沉睡者的第四个秘密。从此他会平安的入睡，再也不会梦到在荒原上的日子了。”~
@109126 = ~你注意到导师从冥想中回过神来。于是从书卷上移开视线，装作对旁边的石像很感兴趣。~
@109127 = ~“书！让开，老大。我也要看看。”~
@109128 = ~“她来了，老大！咻，这样让你看起来很无辜的样子……”~
@109129 = ~“<CHARNAME>？”~
@109130 = ~瓦伦轻轻的咳嗽，使你从书本上转移了注意力。~
@109131 = ~“咻！她来了。”~
@109132 = ~你感到导师在探询你的思维，判断你的意图。如果你想要阅读这个书卷，那你得等她被别的什么转移了注意力才行。~
@109133 = ~离开。~
@109134 = ~从某一项开始读。~
@109135 = ~继续读。~
@109136 = ~继续读。~
@109137 = ~继续读。~
@109138 = ~继续读。~
@109139 = ~“时间即是金钱，只是很少……”~
@109140 = ~那龙弯低身体，闻闻你，它的鼻息带着火苗。“怎么了？受不了这点火焰？”~
@109141 = ~“它会让你的血液沸腾如点燃了三只莓果的火焰一般。此外，有了它你再也不用寻找柴火了。若要问我的话，这的确是笔好买卖……”~
@109142 = ~“据说这是巴托魔界火焰的燃料。如果你想看的话，我把这灌木就种在酒馆的入口外边，不过我怀疑那个吉斯泽莱混蛋已经它们摘干净了。”~
@109143 = ~他呼吸着，把柜台遮蔽在呼出的气体之下。那是一瓶装满紫白色液体的瓶子，瓶塞发出明显的杜松子酒的气味。~
@109144 = ~“一条龙！看到了吗，老大？德金说过龙也有友好的……”~
@109145 = ~“我还有其他的问题。”~
@109146 = ~“也许一会再说。”~
@109147 = ~“它有多厉害？”~
@109148 = ~“维洛克斯莓？那是什么？”~
@109149 = ~“我会让你看到一个充满怨恨的灵魂……”~
@109150 = ~“一个类似的故事……”~
@109151 = ~“你想要……”~
@109152 = ~“请原谅我的热心。当某人正在找寻一样我拥有的东西时，他的思维也会变得尖锐。把关于我的真爱的事情放在一边，还有什么我能帮助你的么？”~
@109153 = ~“然而，那里的路充满了艰险。路途遥远，飓风致命。更糟糕的是，靡菲斯特让五个守护者把守道路。两个已经死在我手里，还剩下三个……”~
@109154 = ~“还有更多的位面和数不尽的生物在里面，就这样。别试着努力去弄清全部了，那你只是自讨苦吃……”~
@109155 = ~“德金应该用他的鲁特琴来做，老大！他从不让那些魔鬼来演奏……他们会弄坏琴弦。”~
@109156 = ~“就是这个。现在看好它赶快离开这里。你必须沿着它的路直到诸界智者那里，问她哪里可以找到众名智者。冰川也许会移动，但是那条路的确存在。”~
@109157 = ~“刹那位面？从没听说过……”~
@109158 = ~“他说的对啊，老大……”~
@109159 = ~“他说的有理，<CHARNAME>……”~
@109160 = ~“他说的有理，<CHARNAME>……”~
@109161 = ~“他说的有理，<CHARNAME>……”~
@109162 = ~“就是这个。现在看好它赶快离开这里。你必须沿着它的路直到诸界智者那里，问她哪里可以找到众名智者。冰川也许会移动，但是那条路的确存在。”~
@109163 = ~“我们面对的可是棘手的敌人啊，<CHARNAME>。魔鬼钟情于投机欺诈，他们深黯如何在束缚他们的法律之中找到空子的脱身之术。”~
@109164 = ~“那地狱般的喧闹是什么？是什么使你的嗓音如爆炸般轰鸣，凡人？”~
@109165 = ~“我会用你的家伙给你放血！注意你的行为，凡人……”~
@109166 = ~“如果这样没有效果的话，让我去他那里看看……”~
@109167 = ~“那样应该可以了……”~
@109168 = ~“<CHARNAME>！”~
@109169 = ~“嗯……也许德金一点也不想要那个喇叭……”~
@109170 = ~那有一个守护者，一只靡菲斯特留在这里驻守道路的猛兽，正在流血，好多的血。旁边还有一只，已经死了。还有三只，更加强壮，身形庞大……~
@109171 = ~“他很强大，即使在长时间的沉睡之后……”~
@109172 = ~“你为什么到这里来？你找到我的真爱了吗？”~
@109173 = ~“我梦到了我那真爱的名字，”他的眼中闪过一丝光芒，“她是一位使徒，叫做莱佛拉。现在我知道了她的名字，不过，也许我不用继续在这里等下去了。”~
@109174 = ~“我梦到了我那真爱的名字，”他低声吟唱着，“她是被靡菲斯特监禁在远方某个神秘地方的众名智者。”~
@109175 = ~“我梦到了我那真爱的名字，”他低声吟唱着，“就是我很久以前曾经见过的诸界智者……她怎么样了？你知道她还好吗？”~
@109176 = ~“我梦到了我那真爱的名字，”他的眼中闪过一丝光芒，“她是一个卓尔，名叫娜西拉。你知道她吗？”~
@109177 = ~“我梦到了我那真爱的名字，”他的眼中闪过一丝光芒，“她是一个吉斯泽莱人，名叫德哈瓦娜导师。你知道她吗？”~
@109178 = ~“我梦到了我那真爱的名字，”他的眼中闪过一丝光芒，“她是个名叫艾瑞贝丝女士的灵魂。你知道她吗？”~
@109179 = ~他注视着你的灵魂深处。“我梦见了我的真爱，就是你，<CHARNAME>·<CHARNAME>。”他吻了你，将你拉入他的怀中。他的吻有一种清晨的花朵的味道。“我的真爱……”~
@109180 = ~声音穿透了石室厚厚的石墙，但是沉睡者还是纹丝不动。你发觉想要叫醒他比想像中还要难。~
@109181 = ~你弯下身对着沉睡者的耳边轻轻的低语。“我带来了你真爱的名字，她叫做年轻之泽拉米瑟亚，一个被称为莱佛拉的使徒。”~
@109182 = ~“年青的人和年迈的人……天堂就是一个奇怪的地方，<CHARNAME>。但愿我永远不会去那里……”~
@109183 = ~你弯下身对着沉睡者的耳边轻轻的低语。“我带来了你真爱的名字，她叫做智者菲蕾丝，以众名智者之名为人所知。”~
@109184 = ~“想想看她同时爱着魔王靡菲斯特和这里的大天使，而且一切都在她一生中……”~
@109185 = ~你弯下身对着沉睡者的耳边轻轻的低语。“我带来了你真爱的名字，她叫做智者科德米莉亚，以诸界智者之名为人所知。”~
@109186 = ~“是的，那个蝴蝶女孩总是到处嗡嗡的响个不停，对吧，老大？”~
@109187 = ~你弯下身对着沉睡者的耳边轻轻的低语。“我带来了你真爱的名字，她叫做寻天者奎霏莉娅，一个名为娜西拉的卓尔。”~
@109188 = ~“我……我不知道，<CHARNAME>。爱上一个天使？那么多人里，为什么会是我？”~
@109189 = ~你弯下身对着沉睡者的耳边轻轻的低语。”我带来了你真爱的名字，她叫做误导之法蕾西亚，一个被称为德哈瓦娜导师的吉斯泽莱人。”~
@109190 = ~“嗯，你杀了的那个，老大？”~
@109191 = ~“你杀了的那个？”~
@109192 = ~你弯下身对着沉睡者的耳边轻轻的低语。“我带来了你真爱的名字，她叫做双魂瓦达莉亚，被称为艾瑞贝丝女士的灵魂。”~
@109193 = ~“他很漂亮。看看他睡着的时候多么的温柔？我们必须叫醒他，<CHARNAME>……”~
@109194 = ~“他可是个有用的家伙……来叫醒咱们的小玩具吧。”~
@109195 = ~你弯下身对着沉睡者的耳边轻轻的低语。“我带来了你真爱的名字，那就是我，残酷之拜扎登，被称为<CHARNAME>·<CHARNAME>。”~
@109196 = ~你弯下身对着沉睡者的耳边轻轻的低语。“我带来了你真爱的名字，那就是我，野性之默杜斯，被称为<CHARNAME>·<CHARNAME>。”~
@109197 = ~你弯下身对着沉睡者的耳边轻轻的低语。“我带来了你真爱的名字，那就是我，内省之卡基达，被称为<CHARNAME>·<CHARNAME>。”~
@109198 = ~你弯下身对着沉睡者的耳边轻轻的低语。“我带来了你真爱的名字，那就是我，自私之内泽本，被称为<CHARNAME>·<CHARNAME>。”~
@109199 = ~你弯下身对着沉睡者的耳边轻轻的低语。“我带来了你真爱的名字，那就是我，公正之纽索斯，被称为<CHARNAME>·<CHARNAME>。”~
@109200 = ~你弯下身对着沉睡者的耳边轻轻的低语。“我带来了你真爱的名字，那就是我，善良之以贝拉，被称为<CHARNAME>·<CHARNAME>。”~
@109201 = ~你弯下身对着沉睡者的耳边轻轻的低语。“我带来了你真爱的名字，那就是我，黑暗之德雷岑，被称为<CHARNAME>·<CHARNAME>。”~
@109202 = ~你弯下身对着沉睡者的耳边轻轻的低语。“我带来了你真爱的名字，那就是我，坚定之里休斯，被称为<CHARNAME>·<CHARNAME>。”~
@109203 = ~你弯下身对着沉睡者的耳边轻轻的低语。“我带来了你真爱的名字，那就是我，祝福之多尼塔，被称为<CHARNAME>·<CHARNAME>。”~
@109204 = ~“你？那是个多么残忍的计划啊，为什么要等到英雄都死去了那些人才知道忏悔？防守吧！”~
@109205 = ~“我们成了什么，<CHARNAME>？勒紧你的腰带，准备经历从没有过的苦日子吧……”~
@109206 = ~“谢谢我？但是为什么呢？我已经在熟睡中度过漫长的年月而无所事事，只是苦等。我做了什么足以赢得你的感谢呢？”~
@109207 = ~“当然的。请原谅，我从未因为感激之情而如此感动。那么告诉我，你来这还需要什么吗？”~
@109208 = ~“统治？那是个多么残忍的计划啊，为什么要等到英雄都死去了那些人才知道忏悔？防守吧！”~
@109209 = ~“收割者？我不知道你说的是谁。不过也许我可以在某些方面给予你小小的帮助，希望你能接受。还有什么事情是我可以为你做的吗？”~
@109210 = ~“我没有做过这类的事情。如果你知道了某些事情，那你就可以靠着自己对真理的悟性和热情来完成它。做事重要的是不能失信，我的朋友。”~
@109211 = ~“一个宗教？需要赞美它所有的神祇，而不只是一个。我只是效忠于更高荣耀的天使。找到我是你的幸运，不过外面还有比我更加慈爱美丽的存在。”~
@109212 = ~“我是个异界神侍。如果你想要感谢，那么应该感谢创造了我的神明。就这样？”~
@109213 = ~“你知道了？求你了，告诉我所有你知道的事情！从头开始，她叫什么名字？这样当她来的时候我就可以知道了！”~
@109214 = ~“不！我的真爱怎么办？你说你知道她的名字！告诉我，我求你了。我乞求你，别这样丢下我。当你离开的时候沉睡者失声痛哭。”~
@109215 = ~“不！我的真爱怎么办？你说你知道她的名字！告诉我，我求你了。我乞求你，你在这里不就是为了这个嘛？”~
@109216 = ~“莱佛拉，”他说，嘴里喃喃的念叨着。“你说是一个使徒？她会来的，在她的时间里。现在我知道了她的名字，也许我不用在这里继续等候下去了。”~
@109217 = ~“我要回到我的家乡去寻找她。如果她是个已经出生的天使，那么他们一定会有她的记录……谢谢你，我的朋友，你帮了我一个大忙。”~
@109218 = ~“我再也不能容忍你的嘲笑了！我知道你说的是谁，她不是我的真爱……谎言的标志就明明白白的刻在你的脸上！防守吧！”~
@109219 = ~“菲蕾丝，”他说，嘴里喃喃的念叨着。“可是靡菲斯特将她囚禁在遥远的某处神秘的地方。”~
@109220 = ~“诅咒你，<CHARNAME>！”~
@109221 = ~“菲蕾丝，”他说，嘴里喃喃的念叨着。“可是靡菲斯特将她囚禁在遥远的某处神秘的地方。”~
@109222 = ~“我不喜欢你的腔调和你说出我所爱之名时的轻蔑。你想要从我这里得到什么？”~
@109223 = ~“好的，让我们不再谈论我的真名。告诉我你对于被摩菲斯特囚禁的菲蕾丝，众名智者，所知多少。”~
@109224 = ~“诅咒他！他玩弄别人的感情，毁了别人的生活。如果你能看到他，请替我带给他最痛苦的报答！现在我必须去收拾他的残局，找回我的爱人……我得谢谢你。”~
@109225 = ~“是的，马上！我会扫荡卡尼亚荒地，那样，很快就可以找到她了！如果我能早点知道这些的话，就不会在睡梦中浪费那么多时间了。”~
@109226 = ~“你所给我的祝福比天堂所给的还要多，我的朋友！请原谅我的离去，不过为了迎接她随时可能的到来我还有很多要准备的呢……谢谢你。”~
@109227 = ~“你现在又在谋划着什么诡计，<CHARNAME>……？”~
@109228 = ~“好吧，我们让别人来作豚鼠，<CHARNAME>……来看看我是不是真的可以让那个男的来干。”~
@109229 = ~“<CHARNAME>！我是他的真爱，不是众名智者！你为什么要那样说！？”~
@109230 = ~“好吧，让我们玩玩那个男的。我还不确定我是否喜欢他呢……”~
@109231 = ~“是的，那个蝴蝶女孩总是嗡嗡的到处飞来飞去，对吧老大？”~
@109232 = ~“我再也不能容忍你的嘲笑了！我知道你说的是谁，她不是我的真爱…谎言的标志就明明白白的刻在你的脸上！防守吧！”~
@109233 = ~“科德米莉亚，”他说，嘴里喃喃的念叨着。“我想到最后会是我早已知道的某个人……她怎么样？还好吗？”~
@109234 = ~“诅咒你，<CHARNAME>！”~
@109235 = ~“科德米莉亚，”他说，嘴里喃喃的念叨着。“我想到最后会是我早已知道的某个人……她怎么样？还好吗？”~
@109236 = ~“我不喜欢你的腔调和你说出我所爱之名时的轻蔑。你想要从我这里得到什么？”~
@109237 = ~“好的，咱们别再谈论我的真名了。告诉我关于科德米莉亚，诸界智者的事情，我的真爱……告诉我她还好。”~
@109238 = ~“而且她还会嘲笑我的愚蠢。我真是个傻瓜，没能早点发现，不过至少是时间愚弄了我。”~
@109239 = ~“她有无数的分身。但是不管怎样，我都要找到她。这漫长的睡眠至少帮我恢复到了以前的体质。”~
@109240 = ~“不！哦，我的愚蠢已经深深的伤害了她。早在她在我之前到那里的时候我就应该意识到我已经爱上了她。”~
@109241 = ~“那么，她为什么要骗我？在我之前她就已经在那里了，那时她告诉我将会在这里，卡尼亚之门见到我的真爱。但是那时我竟然没有意识到她就是我的真爱……”~
@109242 = ~“我必须马上去她那里，为我浪费的这么多年道歉。如果那里有一个试炼，恐怕我会失败……别了，我的朋友，你真的帮了我一个大忙。”~
@109243 = ~“是的，那个蝴蝶女孩总是嗡嗡的到处飞来飞去，对吧老大？等下，不对……”~
@109244 = ~“好吧，我们让别人来作豚鼠，<CHARNAME>……来看看我是不是真的可以让那个男的来干。”~
@109245 = ~“<CHARNAME>！我是他的真爱，不是众名智者！你为什么会那么想！？”~
@109246 = ~“好吧，让我们玩玩那个男的。我还不确定我是否喜欢他呢……”~
@109247 = ~“我……我不知道，<CHARNAME>。爱上一个天使？那么多的人里，为什么就会是我？”~
@109248 = ~“我再也不能容忍你的嘲笑了！这个你说的卓尔，她不是我的真爱……谎言的标志就明明白白的刻在你的脸上！防守吧！”~
@109249 = ~“娜西拉，”他说，嘴里喃喃的念叨着。“你认识她吗？”~
@109250 = ~“诅咒你，<CHARNAME>！”~
@109251 = ~“娜西拉，”他说，嘴里喃喃的念叨着。“你认识她吗？”~
@109252 = ~“在平静与安详中逝去。至少这世界上还有爱，至少我知道了她的名字。”~
@109253 = ~“我不喜欢你的腔调和你说出我所爱之名时的轻蔑。你想要从我这里得到什么？”~
@109254 = ~“好的，咱们别再谈论我的真名了。关于我的真爱，娜西拉，你都知道些什么？”~
@109255 = ~“那就是我要问你的。过了这么多年，你带给我她的名字，我真不知道该如何感谢你。”~
@109256 = ~“但是假如我知道了我的真爱之名，那么一定意味着她就快出现了。我已经睡了足够长的时间，现在必须要准备她的到来了。谢谢你，我的朋友，请原谅我的离开。”~
@109257 = ~“娜西拉……我的真爱……我等了你那么久。那么久以来我在梦想着这一天的到来。”~
@109258 = ~娜西拉抽了他一记耳光，身上的钉子流出了鲜血。他的脸上充满了震惊的表情，她的手印依然清晰可见。”我……对不起，娜西拉。我做了什么使你不高兴了？”~
@109259 = ~“谁说我不高兴了？”她靠近他，低语道。她含住了他的嘴，用牙齿轻咬他的下唇。他处于混乱中，推开了她。“我得走了。”她说。~
@109260 = ~“可是你才刚刚来啊……我不明白。是什么让你离开我？”~
@109261 = ~“这与你无关，沉睡者……”~
@109262 = ~“你还会回来吗？我在哪可以找到你？”~
@109263 = ~“我不会回来了……你最好现在就说告别。”~
@109264 = ~“我为此已经等候许久，而我还是继续等下去为了再见你一面……喔，我的爱，你使我的生命一片空白，却让我心中的爱满到溢出。求你了，我乞求你，回到我身边吧！”~
@109265 = ~“我——我必须离开这个地方，把这芬芳留给你。我不得不走，否则就会被你逼疯了！别了，我的爱。我想我从此不会入睡了。”~
@109266 = ~“你说什么，<CHARNAME>？我想我会留住他的……”~
@109267 = ~“难道一位女士就不能保留一点自己的隐私么，<CHARNAME>？”~
@109268 = ~“我曾在多元宇宙中旅行过，在旅途中我认识到并非所有的魔鬼都是邪恶的，也并非所有的天使都是善良的。我所知道的只是神不会不分青红皂白的把我们系在一起。”~
@109269 = ~“但是假如我知道了我的真爱之名，那么一定意味着她就快出现了。我已经睡了够长的时间，现在必须要准备她的到来了。谢谢你，我的朋友，请原谅我的离开。”~
@109270 = ~“等等！你的真爱就在这里……就是我，娜西拉。一个卓尔。”~
@109271 = ~“那么*有些*卓尔似乎把过去都忘到脑后了，<CHARNAME>……”~
@109272 = ~“我……我不知道，<CHARNAME>……如果他发现了呢？”~
@109273 = ~“我才是他的真爱，<CHARNAME>。你为什么告诉他是她？”~
@109274 = ~“什么！？他是我的！你怎么敢把他给了她！”~
@109275 = ~“关心你自己的事情吧，鬼魂！”~
@109276 = ~“嗯，你杀了的那个，老大？”~
@109277 = ~“我再也不能容忍你的嘲笑了！这个你说的导师，她不是我的真爱……谎言的标志就明明白白的刻在你的脸上！防守吧！”~
@109278 = ~“导师，”他说，嘴里喃喃的念叨着。“你认识她吗？”~
@109279 = ~“诅咒你，<CHARNAME>！”~
@109280 = ~“导师，”他说，嘴里喃喃的念叨着。“你认识她吗？”~
@109281 = ~“在平静与安详中逝去。至少这世界上还有爱，至少我知道了她的名字。”~
@109282 = ~“我不喜欢你的腔调和你说出我名字时的轻蔑。你想要从我这里得到什么？”~
@109283 = ~“好的，咱们别再谈论我的真名了。关于我的真爱，导师，你都知道些什么？”~
@109284 = ~“这就是我所要的！过了这么多年，我真得好好的感谢你。”~
@109285 = ~“但是假如我知道了我的真爱之名，那么一定意味着她就快出现了。我已经睡了够长的时间，现在必须要准备她的到来了。谢谢你，我的朋友，请原谅我的离开。”~
@109286 = ~“那么我必须找到她。她曾经来过，就在这里，卡尼亚之门，她找到了我。可我是个笨蛋，在自己的手指间失去了她。不能再浪费时间了，十分感谢你所作的一切。”~
@109287 = ~“我的……我的沉睡者……”~
@109288 = ~“我的真爱……”~
@109289 = ~“我觉得自己好像已经认识你一生一世了……可是我以前却不知道这些……”~
@109290 = ~“嘘，我的爱。我不该……不过如果你还想，我愿意带你回到我的家乡极乐境。我们会在那里快乐的生活……”~
@109291 = ~“我……我当然愿意了！这里已经没有什么我留恋的了，除了……除了我的信徒们，还有我的朝圣者，他们…他们需要我。”~
@109292 = ~“信徒们会自己找到信徒会的，我的爱。他们会有他们自己的生活。你也一样要有你自己……”~
@109293 = ~“我不能……对不起，我的一生都在崇拜你，实现你的梦想中度过。我还没有准备好……对不起……”~
@109294 = ~“不，天哪，不！你为什么要抛弃我？！”~
@109295 = ~“你杀了她，是吗？她是来这里见我的，就在卡尼亚之门！我的真爱……那么，以眼还眼，以牙还牙！我会要你偿还的，凶手！”~
@109296 = ~“她为什么这么做？我想要的是她的爱，不是崇拜……她还在这里吗？如果可以的话我想和她说话……”~
@109297 = ~“好吧，我们让别人来作豚鼠，<CHARNAME>……来看看我是不是真的可以让那个男的来干。”~
@109298 = ~“<CHARNAME>！我是她的真爱，不是那个导师！你为什么要那样说！？”~
@109299 = ~“好吧，让我们玩玩那个男的。我还不确定我是否喜欢他呢……”~
@109300 = ~“我再也不能容忍你的嘲笑了！这个你说的艾瑞贝丝，她不是我的真爱……谎言的标志就明明白白的刻在你的脸上！防守吧！”~
@109301 = ~“艾瑞贝丝，”他说，嘴里喃喃的念叨着。“你认识她吗？”~
@109302 = ~“诅咒你，<CHARNAME>！”~
@109303 = ~“艾瑞贝丝，”他说，嘴里喃喃的念叨着。“你认识她吗？”~
@109304 = ~“在平静与安详中逝去。至少这世界上还有爱，至少我知道了她的名字。”~
@109305 = ~“我不喜欢你的腔调和你说出我名字时的轻蔑。你想要从我这里得到什么？”~
@109306 = ~“好的，咱们别再谈论我的真名了。关于我的真爱，艾瑞贝丝，你都知道些什么？”~
@109307 = ~“这就是我所要的！过了这么多年，我真得好好感谢你。”~
@109308 = ~“死了？不，不可能！她一定来过这里，一定是在我睡的太深了，不知道她来过，不知道她爱我！天哪，我真是个愚蠢的傻瓜！我放弃了这一生中最珍贵的东西！”~
@109309 = ~“我的艾瑞贝丝女士，我的真爱……许久以来我都在等你，许久以来我都在梦想这一天的到来。”~
@109310 = ~“把你的梦放到一边去吧，沉睡者，因为我已经将它变成了现实。唯一缺憾的是没有我你堕落的太久了……去吧，洗干净你自己。你身上都是魔鬼的臭味。”~
@109311 = ~“魔鬼的臭味？我的爱，我已经旅行了无数个里格来寻找你，在九渊地狱中沉睡了几千年来等候你的到来！如果洗个澡是你要求我的全部，我会去做的，只是……”~
@109312 = ~“好啊。马上洗干净你自己，然后我们再谈。”~
@109313 = ~“你不明白。你不会在整个卡尼亚找到一次洗澡的机会！我怀疑在整个巴托地狱是否会有！”~
@109314 = ~“我在数哦……一……二……”~
@109315 = ~“好吧，好吧，我会去的！我会去解决的！不过当我洗完了可以在哪找到你呢？”~
@109316 = ~“我会在天堂见你，你属于那里。”~
@109317 = ~“我的地方？我已经就无数年没有回到极乐世界了！那肯定会是一团糟……不，别担心！我会去洗澡然后净身——不，净身然后洗澡！这不重要，我会在那里见你的！”~
@109318 = ~“好啦，那样会让那个可怜的傻瓜忙活一阵子了。来吧，让我们回到深水城，然后再和靡菲斯特做笔买卖。”~
@109319 = ~“我实在是很讨厌去想那些她所说的关于我的话，<CHARNAME>……”~
@109320 = ~“我真是走了好长的一段路才到这里。”~
@109321 = ~“你愿意为了我再一次踏上旅途吗？在极乐世界的祝福之地我还有一个家园。我想要带你去那里，让我们在那里的美景中度过余生吧。”~
@109322 = ~“我不想再索取什么，爱人，但是我还肩负着一些必须完成的使命。靡菲斯特正在攻打我的家乡，托瑞尔，我们必须先去那里，把人们从他的魔掌中解救出来。”~
@109323 = ~“那么，摩菲斯特还统治着第八层地狱，是吗？如果你敢于冒着生命的危险去面对他，我的爱，我也一样。让我们去熄灭邪恶之火吧。”~
@109324 = ~“你愿意加入我们？谢谢你，我的爱，我会祈祷咱们都能在战斗中幸存下来。在极乐世界建立咱们自己的家园的梦想会变成现实的。”~
@109325 = ~“我的爱人与你同在，艾瑞贝丝。我会在那里找到你。”~
@109326 = ~“失魂者？不，不可能！我要去卡尼亚之门见的是她，根本不是看着她的生命精华慢慢的逝去！该死的诸界智者和她的谎言！”~
@109327 = ~“如果我的真爱在失魂者之中，那么只有一种方法我可以找到她。原谅我，朋友，我没有时间在这里耽搁了。”~
@109328 = ~“也许吧。不过我相信最阴暗的心中也会存在着一丝良知。也许她还可以被救赎。神是不会不分青红皂白的把我们系在一起的。”~
@109329 = ~“但是假如我知道了我的真爱之名，那么一定意味着她就快出现了。我已经睡了够长的时间，现在必须要准备她的到来了。谢谢你，我的朋友，请原谅我的离开。”~
@109330 = ~“等等！如果你要找的是艾瑞贝丝女士，那么她是不会来的，因为她根本不是你的真爱……你的心另有所属。”~
@109331 = ~“谢谢你，好心的女士。尽管我不知道你的话语为什么会是真的，但是我依旧相信你。我的命运总是自相矛盾的，但是我会把你的话记在心里的。”~
@109332 = ~“等等！你的真爱就在这里……就是我，艾瑞贝丝女士。”~
@109333 = ~“他以为那是通往天堂的旅程，而不是地狱的……”~
@109334 = ~“那不仅仅是说说而已，<CHARNAME>……”~
@109335 = ~“<CHARNAME>！”~
@109336 = ~“我不是他的真爱，<CHARNAME>！为什么你要这么暗示？”~
@109337 = ~“好吧，让我们玩玩那个男的。他现在也许有些用处了……”~
@109338 = ~“为什么她得到了那个男人？我才是他的真爱！”~
@109339 = ~“我再也不能容忍你的嘲笑了！你并不是我的真爱……谎言的标志就明明白白的刻在你的脸上！防守吧！”~
@109340 = ~他的眼神变得迷离，嘴边挂着最温暖的微笑。他将你拉入他天神般的拥抱之中，让你沐浴在他的吻里。“我的真爱。”他轻声说道。~
@109341 = ~“诅咒你，<CHARNAME>！”~
@109342 = ~他的眼神变得迷离，嘴边挂着最温暖的微笑。他将你拉入他天神般的拥抱之中，让你沐浴在他的吻里。“我的真爱。”他轻声说道。~
@109343 = ~“好吧，我们让别人来作豚鼠，<CHARNAME>……来看看我是不是真的可以让那个男的来干。”~
@109344 = ~“<CHARNAME>！我是他的真爱，不是你！你为什么要那样做！？”~
@109345 = ~“好吧，我们让那个人来做豚鼠，看看我是不是真的喜欢他。”~
@109346 = ~“那么，就是这样了，是吗？你要用我的真名来命令我吗？来吧，我准备好了。你要我做什么？”~
@109347 = ~“沉睡者很小心，不在他苍白的有点发绿的脸上有任何情绪的流露。你用他的真名来召唤他，这样做可能会失去他的信任。”~
@109348 = ~“为什么？你给我的我会原封不动还给你。还有什么吗？如果证明是我胜利了，那么我的双手将会沾满你的鲜血。如果是我失败了，我将永远不会知道我真爱的名字。”~
@109349 = ~“这真是疯狂之极！我祈祷你已经防御好了，由于你的命令，这场战斗将会不死不休……”~
@109350 = ~“但是……但是我还没有作出决定，<CHARNAME>。你会杀了他！如果这世上已经没有爱我的人存在该怎么办？！”~
@109351 = ~“是的，杀了他，<CHARNAME>。他怎么敢假装爱我！”~
@109352 = ~“不！！你会杀了他，<CHARNAME>！”~
@109353 = ~“我的任务还没完成，但你却让我别无选择。但愿七重天堂会宽恕你的灵魂。”~
@109354 = ~“你是一个根本不知道自己在干些什么的怪物……我的任务就是我所拥有的一切，我的生命意义也在于此。一旦放弃，我就一无所有……我必须服从你的命令，但愿七重天堂能对你的灵魂作出审判……”~
@109355 = ~沉睡者由于痛苦而哭泣，眼珠上翻。他喘息着，颤抖着倒地。他的生命正在逐渐的逝去，还未知道他的真爱就离开了凡间。~
@109356 = ~“生命中并不仅仅是爱情。还有战斗和血刃呢？鄙视那些忘了这些的人们……”~
@109357 = ~“但是……但是我还没有作出决定，<CHARNAME>。你会杀了他！如果这世上已经没有爱我的人存在该怎么办？！”~
@109358 = ~“是的，这让他学乖些，<CHARNAME>。他怎么敢假装爱我！”~
@109359 = ~“不！！你会杀了他，<CHARNAME>！我的爱，我的真爱……我的沉睡者……”~
@109360 = ~“情原谅我的离去，可是找到她对我来说太重要了。现在我知道了她的名字，有了寻找的目标，也许我不用呆在这里等待她的到来。如果可以我会前往地狱去找她。”~
@109361 = ~“是，她很快就可以确定了。血战的刺客一直是个威胁。刚刚我已经从睡梦中醒来，在梦中得知了我真爱的名字……”~
@109362 = ~“阴影中的女人？有一个精灵种族被称为卓尔，符合你的描述。事实上，刚刚我已经从睡梦中醒来，在梦中得知我的真爱是他们中的一员……”~
@109363 = ~“是的，地狱里充满了这样的人，他们拥有近千种形态。不过，刚刚我已经从睡梦中醒来，在梦中得知了我真爱的名字！”~
@109364 = ~“她——魔鬼，老大？”~
@109365 = ~“是的，地狱里充满了这样的人，对付他们千万不能犹豫……不过够了。刚刚我已经从睡梦中醒来，在梦中得知了我真爱的名字！”~
@109366 = ~“一个灵魂？刚刚我已经从睡梦中醒来，在梦中得知我的真爱是他们中的一员。如果是她怎么办？”~
@109367 = ~“我会让你看到一个充满怨恨的灵魂……”~
@109368 = ~“你的谎言已经背叛了你，凡人！我是个天使，出生在天堂山，任何不实的谎言都在我的监视之下！防守吧！”~
@109369 = ~“嫉妒或者不是，都是为了一尝爱情的味道，哪怕只是一会…你觉得我的真爱会杀了我吗？刚刚我已经从睡梦中醒来，在梦中得知了我真爱的名字。”~
@109370 = ~“一个类似的故事……”~
@109371 = ~“你想要……”~
@109372 = ~“她是一个吉斯泽莱人！刚刚我已经从睡梦中醒来，在梦中得知我的真爱是他们中的一员。如果是她怎么办？”~
@109373 = ~“你说了真话，我知道……还有，你把我已经从睡梦中唤醒，在梦中我好像听到了真爱的名字。天堂一般的光芒环绕着他。”~
@109374 = ~“她是一个吉斯泽莱人！还是一个导师？刚刚我已经从睡梦中醒来，在梦中得知我的真爱是他们中的一员。如果是她怎么办？”~
@109375 = ~“生命中并不仅仅是爱情。还有战斗和血刃呢？鄙视那些忘了这些的人们……”~
@109376 = ~“但是……但是我还没有作出决定，<CHARNAME>。你会杀了他！如果这世上已经没有爱我的人存在该怎么办？！”~
@109377 = ~“不！！你会杀了他，<CHARNAME>！我的爱，我的真爱……我的沉睡者……”~
@109378 = ~“是的，这让他学乖些，<CHARNAME>。他怎么敢假装爱我！”~
@109379 = ~“年青的人和年迈的人……天堂就是一个奇怪的地方，<CHARNAME>。但愿我永远不会去那里……”~
@109380 = ~“想想看她同时爱着魔王靡菲斯特和这里的大天使，而且一切都在她一生中……”~
@109381 = ~“诅咒你，<CHARNAME>！”~
@109382 = ~“你现在又在谋划着什么诡计，<CHARNAME>……？”~
@109383 = ~“好吧，我们让别人来做豚鼠，<CHARNAME>……来看看我是不是真的可以让那个男的来干。”~
@109384 = ~“<CHARNAME>！我是他的真爱，不是众名智者！你为什么要那样说！？”~
@109385 = ~“好吧，让我们玩玩那个男的。我还不确定我是否喜欢他呢……”~
@109386 = ~“是的，那个蝴蝶女孩总是到处嗡嗡的响个不停，对吧，老大？”~
@109387 = ~“诅咒你，<CHARNAME>！”~
@109388 = ~“是的，那个蝴蝶女孩总是到处嗡嗡的响个不停，对吧，老大？等一下，不对……”~
@109389 = ~“好吧，我们让别人来做豚鼠，<CHARNAME>……来看看我是不是真的可以让那个男的来干。”~
@109390 = ~“<CHARNAME>！我是他的真爱，不是诸界智者！你为什么要那样说！？”~
@109391 = ~“好吧，让我们玩玩那个男的。我还不确定我是否喜欢他呢……”~
@109392 = ~“我……我不知道，<CHARNAME>。爱上一个天使？那么多人里，为什么会是我？”~
@109393 = ~“诅咒你，<CHARNAME>！”~
@109394 = ~“我……我不知道，<CHARNAME>……如果他发现了怎么办？”~
@109395 = ~“我才是他的真爱，<CHARNAME>。你为什么告诉他是她？”~
@109396 = ~“什么？！他是我的！你怎么敢把他交给她？”~
@109397 = ~“关心你自己的事情吧，鬼魂！”~
@109398 = ~“嗯，你杀了的那个，老大？”~
@109399 = ~“你杀了的那个？”~
@109400 = ~“诅咒你，<CHARNAME>！”~
@109401 = ~“好吧，我们让别人来做豚鼠，<CHARNAME>……来看看我是不是真的可以让那个男的来干。”~
@109402 = ~“<CHARNAME>！我是她的真爱，不是那个导师！你为什么要那样说！？”~
@109403 = ~“好吧，让我们玩玩那个男的。我还不确定我是否喜欢他呢……”~
@109404 = ~“他很漂亮。看看他睡着的时候多么的温柔？我们必须叫醒他，<CHARNAME>……”~
@109405 = ~“他可是个有用的家伙……来叫醒咱们的小玩具吧。”~
@109406 = ~“诅咒你，<CHARNAME>！”~
@109407 = ~“我不是他的真爱，<CHARNAME>！为什么你要这么暗示？”~
@109408 = ~“好吧，让我们玩玩那个男的，<CHARNAME>。他也许还有点用处……”~
@109409 = ~“为什么是她得到了这个男人？我才是他的真爱！”~
@109410 = ~“诅咒你，<CHARNAME>！”~
@109411 = ~“你这个疯狂的傻瓜，<CHARNAME>，抛弃了这样的一个男人……一个疯狂的傻瓜……”~
@109412 = ~“多么的残忍，多么的残忍啊……深深的把刀插入然后再扭转，我的天哪，再扭转……”~
@109413 = ~“教他学乖点，<CHARNAME>……”~
@109414 = ~“老大就是喜欢取笑。你最好习惯一下。”~
@109415 = ~“那么你毕竟是知道如何对付男人，对吧？你是个称职的卓尔。”~
@109416 = ~“你够冷！做得漂亮，我的姐妹……”~
@109417 = ~“我实在不愿意去想你都说了些什么关于我的话，<CHARNAME>……”~
@109418 = ~“真够狠的，<CHARNAME>。我会记住你的……”~
@109419 = ~“你疯了吗？我曾经见过一整个军团的恶魔在一个异界神侍出现之后彻底溃败逃散。我们也撤离了，那样我们就可以在一个安全的举例观看那次屠杀了。”~
@109420 = ~“真够狠的，<CHARNAME>。我会记住你的……”~
@109421 = ~“真够丢人的，<CHARNAME>。异界神侍是众所周知的强大武士。我曾经见过一整个军团的恶魔在一个异界神侍出现之后彻底溃败逃散。我们也撤离了，那样我们就可以在一个安全的举例观看那次屠杀了。”~
@109422 = ~“好吧，我们来让你来作豚鼠，<CHARNAME>……来看看我是不是真的可以让这个男的来干。”~
@109423 = ~“<CHARNAME>！我是他的真爱，不是你！你为什么要那样说？！”~
@109424 = ~“好吧，让我们玩玩那个男的。我还不确定我是否喜欢他呢……”~
@109425 = ~“我不知道。你自己去找吧。”~
@109426 = ~“我已经得到了你所说的那个戒指。”~
@109427 = ~“我已经得到了你所说的那个戒指。”~
@109428 = ~“再见。”~
@109429 = ~“我是来宰了你的。”~
@109430 = ~“我是来感谢你的。”~
@109431 = ~“那么，我还有其他的问题。”~
@109432 = ~“在我的统治计划中，你只是个不知情的参与者罢了！”~
@109433 = ~“你帮助我找到了收割者的真名。”~
@109434 = ~“你使我对自己多了一些了解。”~
@109435 = ~“你铸就了整个宗教的基础。”~
@109436 = ~“你在地狱的深渊中是一支正义的力量。”~
@109437 = ~“我已经知道了你的真爱的名字。”~
@109438 = ~“再见。”~
@109439 = ~“那么，我还有其他的问题。”~
@109440 = ~“她叫做年轻之泽拉米瑟亚，一个被称为莱佛拉的使徒。”~
@109441 = ~“她是智者菲蕾丝，被称作众名智者。”~
@109442 = ~[撒谎]“她是智者菲蕾丝，被称作众名智者。”~
@109443 = ~“忍耐之塞雷斯法，我命令你服从我！”~
@109444 = ~“忍耐之塞雷斯法……”~
@109445 = ~“那么，我还有其他的问题。”~
@109446 = ~“是的，她是他的爱人。”~
@109447 = ~“那么你最好去放了她。”~
@109448 = ~“她曾经答应会来这里，可是还没有抵达。”~
@109449 = ~“我已经放了她。如果她爱你，她会在这里找到你的。”~
@109450 = ~“她是智者科德米莉亚，被称作诸界智者。”~
@109451 = ~[撒谎]“她是智者科德米莉亚，被称作诸界智者。”~
@109452 = ~“忍耐之塞雷斯法，我命令你服从我！”~
@109453 = ~“忍耐之塞雷斯法……”~
@109454 = ~“那么，我还有其他的问题。”~
@109455 = ~“去她那里吧。她知道了真相会很高兴的。”~
@109456 = ~“我不知道。她逃去了藏身之处。”~
@109457 = ~“我想她为了得到你已经疯狂了。”~
@109458 = ~“她为了你已经憔悴了许多。”~
@109459 = ~“她叫做寻天者奎霏莉亚，一个名为娜西拉的卓尔。”~
@109460 = ~[撒谎]“她叫做寻天者奎霏莉亚，一个名为娜西拉的卓尔。”~
@109461 = ~“忍耐之塞雷斯法，我命令你服从我！”~
@109462 = ~“再见。”~
@109463 = ~“忍耐之塞雷斯法……”~
@109464 = ~“那么，我还有其他的问题。”~
@109465 = ~“知道你们开心的在一起就足够了。”~
@109466 = ~“她死了。”~
@109467 = ~“我为你把她带来了。就在这里。”~
@109468 = ~“她是一个善良的灵魂，尽管过去受尽折磨。”~
@109469 = ~“我的家乡，卓尔的历史可是臭名昭著……”~
@109470 = ~“她叫做误导之法蕾西亚，一个被称为导师的吉斯泽莱人。”~
@109471 = ~[撒谎]“她叫做误导之法蕾西亚，一个被称为导师的吉斯泽莱人。”~
@109472 = ~“忍耐之塞雷斯法，我命令你服从我！”~
@109473 = ~“再见。”~
@109474 = ~“忍耐之塞雷斯法……”~
@109475 = ~“那么，我还有其他的问题。”~
@109476 = ~“知道你们开心的在一起就足够了。”~
@109477 = ~“她曾经到过这里，不过又离开了。”~
@109478 = ~“我为你把她带来了。就在这里。”~
@109479 = ~“我在另一个房间看到了她的尸体。”~
@109480 = ~“那就是她的尸体。”~
@109481 = ~“她建造了这个环绕着你的寺庙。”~
@109482 = ~“她叫做双魂瓦达莉亚，被称为艾瑞贝丝女士的灵魂。”~
@109483 = ~[撒谎]“她叫做双魂瓦达莉亚，被称为艾瑞贝丝女士的灵魂。”~
@109484 = ~“忍耐之塞雷斯法，我命令你服从我！”~
@109485 = ~“再见。”~
@109486 = ~“忍耐之塞雷斯法……”~
@109487 = ~“那么，我还有其他的问题。”~
@109488 = ~“知道你们开心的在一起就足够了。”~
@109489 = ~“她死了。”~
@109490 = ~“我为你把她带来了。就在这里。”~
@109491 = ~“她成为失魂者之中的一员，冰冻在卡尼亚的寒冰之中。”~
@109492 = ~“现实是，据说她要将邪恶带给我的家乡。”~
@109493 = ~“就是我，残酷之拜扎登，被称为<CHARNAME>·<CHARNAME>。”~
@109494 = ~[撒谎]“就是我，残酷之拜扎登，被称为<CHARNAME>·<CHARNAME>。”~
@109495 = ~“那就是我，内省之卡基达，被称为<CHARNAME>·<CHARNAME>。”~
@109496 = ~[撒谎]“那就是我，内省之卡基达，被称为<CHARNAME>·<CHARNAME>。”~
@109497 = ~“那就是我，自私之内泽本，被称为<CHARNAME>·<CHARNAME>。”~
@109498 = ~[撒谎]“那就是我，自私之内泽本，被称为<CHARNAME>·<CHARNAME>。”~
@109499 = ~“那就是我，公正之纽索斯，被称为<CHARNAME>·<CHARNAME>。”~
@109500 = ~[撒谎]“那就是我，公正之纽索斯，被称为<CHARNAME>·<CHARNAME>。”~
@109501 = ~“那就是我，善良之以贝拉，被称为<CHARNAME>·<CHARNAME>。”~
@109502 = ~[撒谎]“那就是我，善良之以贝拉，被称为<CHARNAME>·<CHARNAME>。”~
@109503 = ~“那就是我，黑暗之德雷岑，被称为<CHARNAME>·<CHARNAME>。”~
@109504 = ~[撒谎]“那就是我，黑暗之德雷岑，被称为<CHARNAME>·<CHARNAME>。”~
@109505 = ~“那就是我，坚定之里休斯，被称为<CHARNAME>·<CHARNAME>。”~
@109506 = ~[撒谎]“那就是我，坚定之里休斯，被称为<CHARNAME>·<CHARNAME>。”~
@109507 = ~“那就是我，祝福之多尼塔，被称为<CHARNAME>·<CHARNAME>。”~
@109508 = ~[撒谎]“那就是我，祝福之多尼塔，被称为<CHARNAME>·<CHARNAME>。”~
@109509 = ~攻击！~
@109510 = ~“忍耐之塞雷斯法，我命令你服从我！”~
@109511 = ~“忍耐之塞雷斯法……”~
@109512 = ~“那么，我还有其他的问题。”~
@109513 = ~“和我打吧。”~
@109514 = ~“离开这里，永远不要回来。”~
@109515 = ~“放弃寻找你真爱的打算吧……”~
@109516 = ~“我不知道。她好像人间蒸发了一样。”~
@109517 = ~“她是个女魔鬼，被我灭了。”~
@109518 = ~“一个充满复仇心的灵魂，我害怕。”~
@109519 = ~“只是个嫉妒的情人，没什么。”~
@109520 = ~“是个吉斯泽莱女人。”~
@109521 = ~“是那个导师。她领导着这里的寺庙。”~
@109522 = ~“那就是我，野性之默杜斯，被称为<CHARNAME>·<CHARNAME>。”~
@109523 = ~[撒谎]“那就是我，野性之默杜斯，被称为<CHARNAME>·<CHARNAME>。”~
@109524 = ~“是啊，不用客气。”~
@109525 = ~“你用谜语来回答我们？说得通俗一点，智者！”~
@109526 = ~“我恳求您，告诉我们真相，世界的命运就掌握在它手里到了。”~
@109527 = ~“如果你像对沉睡者那样对我们撒谎，我们会把你射下来，智者！”~
@109528 = ~“她向他撒了慌。她只告诉了他一半真相。”~
@109529 = ~“但是，那是一个‘哪里’的问题，老大！这不公平，你在作弊……”~
@109530 = ~“她应当了解，那比她把信任寄托在巴特祖要好。”~
@109531 = ~“也许不，但是她爱他，这谁都看得出来。她几乎为他而半疯了。”~
@109532 = ~“她疯了吗，老大？”~
@109533 = ~“我恐怕她已经失去理智了，<CHARNAME>……这已经超出了我的医疗能力范围。”~
@109534 = ~“告诉她，她想听到的。如果沉睡者真的如此想要我们出去，那么我们走。”~
@109535 = ~“她如此美丽……”~
@109536 = ~“自由的一点小小代价，确定一下……”~
@109537 = ~“这些名字值你为它们所付出每一个子儿，甚至更多。你做得很好，<CHARNAME>……”~
@109538 = ~“可恶！我应该料到没有那么简单……”~
@109539 = ~“我？我……我不知道。他是个天使而我……我是……我是一个卓尔。”~
@109540 = ~“这完全取决于你对诸神的信念，<CHARNAME>……”~
@109541 = ~“我……我希望诸神不会撒谎，<CHARNAME>。我们能赶回去吗？求你了。”~
@109542 = ~“什么！？德金的名字至少是那个的两倍，老大！不对，是三倍！”~
@109543 = ~“干，干！而且别忘记给小费，老大！”~
@109544 = ~“耶，德金耶想知道他的！这很让人激动，不是吗，老大？就好像奶奶的爪子抓着小鸡肚肠来给我算命。”~
@109545 = ~“谢谢你……我宁愿自己没有如此的知识来秤量你的心。”~
@109546 = ~“那么，完成了。我的命运再次被封禁了……”~
@109547 = ~“我……我害怕，<CHARNAME>，当我还是个孩子的时候……当我找到了先知，我曾经认为，我的命运将会掌握在我自己手里。我自由了。摆脱了家族的竞争，摆脱了那些姐妹，摆脱了瓦纱瑞丝……”~
@109548 = ~“我情不自禁的把我的真名看作是一种束缚……这看起来可能很奇怪，<CHARNAME>，我开始珍惜我的生命了，我将会憎恶轻易放弃它的行为……”~
@109549 = ~“我希望不仅仅是金钱动摇了你继续这项事业的信念，<CHARNAME>……”~
@109550 = ~“知道一个人的真名，意味着你负起责任。他们生或死，他们的历史与命运，他们的愤怒或者是他们栖息之所。你是个伟大的战士并且拥有要求我真名的权利。”~
@109551 = ~“不是现在，也不是永远……谢谢你，<CHARNAME>。”~
@109552 = ~“<CHARNAME>！”~
@109553 = ~“什么？不要开这种傻玩笑，<CHARNAME>！把我的真名留给诸神吧，让他们来主宰我。如果这个世界需要知道我的一切，让他们知道我是艾瑞贝丝女士，而不是其他什么的……”~
@109554 = ~“这就是魔鬼的背叛……”~
@109555 = ~“看起来……到处都是起义军！”~
@109556 = ~“已经有很久了，我可以确定，太久了……”~
@109557 = ~“她把你叫做那个？”~
@109558 = ~“她把你叫做那个？”~
@109559 = ~“她把你叫做那个？”~
@109560 = ~“哇！你是怎么在星星上写字的，老大？它们都那么小……”~
@109561 = ~“我认为答案已经非常明了了，<CHARNAME>。她就是我们在寻找的那个人。”~
@109562 = ~“不是现在，智者。”~
@109563 = ~“不是现在，智者。”~
@109564 = ~“不是现在，智者。”~
@109565 = ~“不是现在，智者。”~
@109566 = ~“毁灭毁灭毁灭毁～～～灭……”~
@109567 = ~“说得比做得轻巧，<CHARNAME>……”~
@109568 = ~“你并不孤单，<CHARNAME>。我们将一起面对他。血战的鼓点在我的血液里脉起，而我将和恶魔搏斗直至战死。”~
@109569 = ~“为了将深水城从黑暗精灵手里解救出来？如果城市还矗立在那里，而且我还可以活着看到它，那么你得到的远不止那些。个人来说，我的赌注都压在靡菲斯特身上了。”~
@109570 = ~“现在不是翻老帐的时候，<CHARNAME>！城市正如我们所说的那样，正在崩溃中！”~
@109571 = ~“你就为了这点报酬而工作？我觉得现在是我们重新为我们的劳作定价的时候了……”~
@109572 = ~“哈，老大？那是你的错误。德金无能为力了。”~
@109573 = ~“你许诺我的100,000金币呢？”~
@109574 = ~“嗯……你在和德金说话吗？”~
@109575 = ~“我有任何理由不和你说话吗，小家伙？你已经强大得超越了普通的龙。你已经发挥了狗头人里前所未有的潜力。”~
@109576 = ~“德金比老大更强？不，这个不对……”~
@109577 = ~“这个怎么不对了，小家伙？来，加入我。<CHARNAME>曾经做了什么阻止了你发挥你的潜力？我可以为你组成一个足以让所有龙都恐惧得为你下跪的军队！全世界都会知道你的名字，并且感到恐惧！”~
@109578 = ~德金的眼睛变得迷离，他开始思考靡菲斯特暗示给他的利益。“但是……<CHARNAME>才是老大，德金不会……”他转向你，看起来恐惧而绝望，“老大！德金不能够做这种决定！帮帮德金！”~
@109579 = ~德金看着你，然后是靡菲斯特，然后又是你，如此循环了几分钟。最后他的视线彻底离开了你。”那么……那么德金跟着大个儿红魔鬼走？”~
@109580 = ~“太棒了。我认为我们将成为非常好的朋友，小家伙。”靡菲斯特笑着转向你。~
@109581 = ~当他听到自己的真名，德金的眼睛变得迷离。“糟透了，老大……那让决定变得容易许多了。德金跟着你走！”靡菲斯特暗暗咆哮诅咒着，并且转向你。~
@109582 = ~“看看<HESHE>是如何威吓你的，小家伙？我决不会做那个。来，加入我。我们将成为生死与共的朋友。”~
@109583 = ~“啊！德金头晕了！大个儿红魔鬼说得太有道理了。”~
@109584 = ~“好，老大！你别担心，德金不会背叛你的！”德金转向魔王，吐出舌头，呸了一声。靡菲斯特眼珠一转，看着你。~
@109585 = ~“我们也可以组成一支团队，小家伙。而且，我比你的老大要大个儿，不是吗？”~
@109586 = ~“嗯……那虽然怪怪的，但是，在某方面，很有道理……那么我入伙？”~
@109587 = ~“那太棒了！”德金的转变和言语触怒了魔王，“老板和德金才是一伙儿的！你再怎么花言巧语也甭想破坏我们的关系！”靡菲斯特眼珠一转，看着你。~
@109588 = ~德金的眼睛变得迷离，他开始思考靡菲斯特暗示给他的利益。慢慢得，狗头人的眼睛眯了起来……他直起身子。“不！你可能是比老大大个儿，可是……可是……德金不——喜——欢——你！”~
@109589 = ~一种混杂了惊讶和愤怒的表情略过了靡菲斯特的脸。“你竟敢反抗我，爬行动物？”~
@109590 = ~“就是那样！德金反抗你！德金站在老大这边……一直到底。”~
@109591 = ~魔王讥嘲着他，然后彻底放弃了德金。“既然如此。就和<HIMHER>一起去死吧，如果你喜欢。”~
@109592 = ~“我们之间没什么可说的，魔鬼！”瓦伦咆哮着，“你是巴特祖，而我是塔那厘。我们之间除了决一死战别无选择。”~
@109593 = ~“哦？”靡菲斯特缓缓地笑道：“但是，你更偏向于人类。如果我告诉你，我能让你从恶魔的污秽中解脱出来，我可以让你摆脱那无尽的血战。年轻人，我很好奇，什么才是值得的？”~
@109594 = ~瓦伦注视着魔王，额头上渗出豆大的汗滴。“即使……即使你可以做到这些，这又会要我付出什么代价？”~
@109595 = ~“背叛<CHARNAME>。很明显，为我而战。这对你来说并不是什么新鲜事儿，总之……想想你的上一次战役。然后，你就能获得永恒的自由了。”~
@109596 = ~“我……背叛<CHARNAME>？但是，那也意味着背叛先知……”~
@109597 = ~“他们为你做了什么，瓦伦？真实吗？我能给你永恒的自由。”~
@109598 = ~“但是……我爱她……”~
@109599 = ~“你比她更清楚，年轻人。这种爱情会有什么未来？没有前途！然而，我却能给你永恒的自由。”~
@109600 = ~瓦伦沉思的面部闪过一阵强烈的思想斗争。“你……也许是对的。我……我不知道……”~
@109601 = ~“我决定了，”瓦伦阴沉着脸说道，“那么我站在魔王这边。”他闭上眼睛，说：“愿先知原谅我。”~
@109602 = ~“完美的抉择，我的小朋友……”靡菲斯特咧开嘴，恐怖地大笑。~
@109603 = ~瓦伦的脑袋猛地转向你，他咆哮道：“你……你使用我的真名来逼迫我服从？既然如此，<CHARNAME>。我会站在你这边的。但是，不管我曾经对你有过什么样的敬意，都结束了。”~
@109604 = ~“这就是你的回答？<CHARNAME>？威胁我？那么，也许我的怀疑是正确的。也许我最终该跟着靡菲斯特走。”~
@109605 = ~瓦伦看着靡菲斯特，缓缓地笑道：“说实话，魔王，我对<HISHER>的恐惧远胜于你。我拒绝你的诱惑。”~
@109606 = ~瓦伦缓缓地点点头：“不管你提供什么，魔鬼……这都比不上我对于背叛的愧疚，我宁愿看到你被摧毁！”~
@109607 = ~“也许你让我爱上你是个事实，<CHARNAME>，但是爱情不能主宰一切。你用爱情的连枷套住我，而靡菲斯特给我的是自由！”~
@109608 = ~瓦伦注视着你，缓缓地点头：“我决定了。虽然我很乐意为你杀了这个女人，靡菲斯特，但是……我不能那样做。”~
@109609 = ~“只有我可以满足你的愿望，瓦伦！只有我可以给你自由！不要成为一个傻瓜！”~
@109610 = ~瓦伦缓缓地点头：“你是对的。我……我必须这样做，<CHARNAME>。抱歉。”~
@109611 = ~瓦伦点点头：“我不会的，我的爱。任何魔鬼的许诺在你给我的爱面前，都如此荒谬缥缈。”他转向靡菲斯特，“我拒绝你的帮助。”~
@109612 = ~瓦伦嘲笑着魔王的计划。“你的帮助对我来说根本没用。<CHARNAME>已经把我从那种束缚中解脱出来了。然而，我不得不承认，我摧毁你的决心仍然很坚定！”~
@109613 = ~靡菲斯特朝瓦伦冷笑着，然后全然无视他了。~
@109614 = ~“你错了。伊丽丝璀已经接受了我。他们……他们才不管我以前做过什么呢。先知已经赦免我了。”~
@109615 = ~“她真的接受你了吗，娜西拉？<CHARNAME>接受你了吗？那么为什么你仍旧常常在晚上梦见的那些受害者？先知的人民并没有原谅你！你现在跟随的这个<MANWOMAN>也没有！”~
@109616 = ~“他们在背地里仍旧把你叫做刺客。他们只是在利用你。你可以利用先知来对抗瓦纱瑞丝。那就是为什么她能容忍你。那就是为什么她会假装欢迎一个杀手加入她的团伙。”~
@109617 = ~“不过现在敌人已经走了，你真的相信绵羊会让一只像你一样的狼蹲在他们中间？你有没有奇怪过为什么先知从来没有把你和其他人一起到地表去过？”~
@109618 = ~“推迟许诺不比撒谎好多少，娜西拉。伊丽丝璀从来不会接受你。你的手上沾了太多的鲜血，你的心中充满了死亡。”~
@109619 = ~“但是我接受你那杀手的一面，娜西拉……把你的愧疚抛到脑后！做一个真实的你！你是一个红色姐妹。加入我，娜西拉。作为一个红色姐妹，你更愿意为谁服务？<CHARNAME>·<CHARNAME>还是我？”~
@109620 = ~“我再也不能否认这些真相了！那些梦境，我的愧疚：都开始在我加入先知后出现。我曾经尝试过去否认真我，我在尝试去做一个并非我自己的人。我是一个黑暗精灵，<CHARNAME>。”~
@109621 = ~“我生来就是杀戮的工具，用来发现别人的弱点，用来摧毁那些敢于在永不休止的权利斗争中挑战我们的人。我愿意加入你，靡菲斯特……而且我将为这而狂欢！”~
@109622 = ~“我将和你共同对抗靡菲斯特，我没有其他选择。但是我不会喜欢不是由我亲自创造的命运。我也不会轻易地忘记或者原谅你在这里所作的一切！”~
@109623 = ~“不用害怕，<CHARNAME>。我不会让这个魔鬼的言语动摇了我对你的爱。他给我的只有仇恨和谎言，而你却让我知道，这个世界上还有更多东西。”~
@109624 = ~“我拒绝你，靡菲斯特，以及你所有的甜言蜜语。在别的地方找一个叛徒吧，因为我将坚定地站在<CHARNAME>·<CHARNAME>这边。”~
@109625 = ~“但是我接受你那杀手的一面，娜西拉……把你的愧疚抛到脑后！做一个真实的你！你是一个红色姐妹。加入我，娜西拉。作为一个红色姐妹，你更愿意为谁服务？<CHARNAME>·<CHARNAME>还是我？”~
@109626 = ~娜西拉沉思着他的言语良久，然后注视着他，目中无人地说道：“我已经抛弃了我的愧疚感，感谢<CHARNAME>。我再也不是一个红色姐妹……更不可能成为你的仆人。”~
@109627 = ~靡菲斯特冷笑着，视线离开了那个黑暗精灵。~
@109628 = ~“<HESHE>做得不错，不是吗？我曾经试图警告你，<CHARNAME>，但是你不听。我们现在就杀死<HIMHER>吗，靡菲斯特？我相当盼望这个。”~
@109629 = ~“一个双重背叛？多有意思？我承认我从没想过那种事。别这样吃惊，小靡菲！你不是也这样说：我是一个叛徒。这就是我的作为。”~
@109630 = ~“噢！但是我干！<CHARNAME>，我干！这对我的感情来说，是有一点小小的斗争，然后我意识到这有多么的完美：还有什么比背叛你最爱的人更邪恶呢？”~
@109631 = ~“此一时彼一时，地狱恶魔。<CHARNAME>已经让我再一次体会到了泰尔的祝福。泰尔是我现在的信仰。即使是你，以你所有的力量，也别想抵抗他的愤怒。”~
@109632 = ~“你说泰尔？那么我可以假设你在用泰尔的法术对抗我？再猜猜看，公主！这些是我的法术！我的！我把<CHARNAME>当木偶一样耍弄瓦纱瑞丝，这次，在卡尼亚，也一样。~
@109633 = ~“所有的时候，你都认为你自己以泰尔的名义在卡尼亚游荡？多么有趣。泰尔放弃你了，艾瑞贝丝，而且现在也一点都顾不到你。”~
@109634 = ~“不，这不可能是真的！这……这不可能！我再一次的有了信仰。我可以发誓我仍然能看到世间的美丽……”~
@109635 = ~“吧啦吧啦吧啦。你对她做了不少，<CHARNAME>。如果我不是即将要杀了你，我很可能会祝贺你的成果。你把她紧紧地控制在了手心里。那么，究竟会变得如何呢，公主？帮他还是帮我？”~
@109636 = ~“无论我做什么，看起来我都只能给世界带来灾难……我站在你这边，靡菲斯特。我没有其他选择。”~
@109637 = ~“你把我从冰封的洞穴救出，<CHARNAME>。你是我的依靠，我的引导，我的爱……你是对的。即使什么都没有，我也信任你。”~
@109638 = ~“你甚至连自己做决定都不会！你令我感到厌恶。那么，背叛我吧。”~
@109639 = ~“既然你如此坚决，那么就背叛我吧，但是我会想念你的，德金。”~
@109640 = ~“鳞歌者伊谢利亚，不要理睬靡菲斯特，继续跟着我。”~
@109641 = ~“如果你背叛我，我会扭断你的脖子，德金！”~
@109642 = ~“就是那样，德金！你正为之而战！”~
@109643 = ~“不要听他的妖言，德金！我们才是一伙的，记得吗？”~
@109644 = ~“我再也不会相信你了。背叛我吧，和靡菲斯特一起被埋葬吧。”~
@109645 = ~“恶魔斗士奥斯卡辛，我命令你站在我这边。”~
@109646 = ~“我会杀了你，如果你背叛我，瓦伦。我发誓！”~
@109647 = ~“不要相信他的谎言，瓦伦！我需要你站在我这边！”~
@109648 = ~“难道你不是爱我胜过那种自由，瓦伦？”~
@109649 = ~“我爱你，瓦伦。求你不要听他的。”~
@109650 = ~“不！我不会接受这个事实！求你不要这么做！”~
@109651 = ~“我爱你，娜西拉。你根本不是什么红色姐妹。”~
@109652 = ~“但是，我以为你爱我，艾瑞贝丝。”~
@109653 = ~“我爱你，艾瑞贝丝。那并不邪恶。”~
@109654 = ~“那总比和老鼠运动要好，嗯，可以肯定。”~
@109655 = ~“让他们保持在我周围。”~
@109656 = ~“哈，这个白痴看起来挺好吃的。”~
@109657 = ~“嗯，但愿我能在这个烂地方作战。”~
@109658 = ~“那个嗜血的拟态怪困住了又一个白痴，让我们去逮住他。”~
@109659 = ~当你靠近这翻滚着岩浆的斯特克斯河支流时，你感到背包里恶魔钩手的手指开始扭动。对岸有个火把支架，它看起来很想去构它。~
@109660 = ~“你需要使用维洛克斯莓。当天寒地冻，没有什么可以点燃火把。”~
@109661 = ~这个通道被一个冰瀑布挡住了。~
@109662 = ~“嗝？不能通过。嗯，不能通过。”~
@109663 = ~“你戴着那枚戒指？一定是，我都能闻到……异界神侍曾经愚弄过我，很久以前……但是再也不会了，我说，再也不会了。靡菲斯特不会希望那样的，不会……”~
@109664 = ~拟态怪被烧焦的灰烬让空气弥漫着一股刺鼻的味道。它曾经用来寻找巢穴的爪子试探着,蟹行而来。借助你背包的阴影，它从你的胸口爬过你的肩膀，钻了进去。~
@109665 = ~尽管一开始你错认为它是拟态怪身体的一部分，但现在你意识到这个可能是某种恶魔的钩手。正当你开始为这个奇怪的生物感到惋惜的时候，你发现自己被打扰了……~
@109666 = ~“要是你问我，我就告诉你，我是为这个该死的木头箱子服务的。你不能想像我被地狱般的魔法困在这里有多久。”~
@109667 = ~魔鬼看着残缺的手腕。“嗜血拟态怪……好了，我现在自由了。如果我看到的是真实的话。我认为你拿了一些我的东西，不是吗？傻瓜？”~
@109668 = ~那个挡住你去路的水晶看起来如此虚幻。看起来好像只在一个位面存在。也许沉睡者的谜题之戒在这里有用……~
@109669 = ~“你为什么拣那个‘L’，老大？那看来根本是错的。”~
@109670 = ~“有没有一个是从‘P’开始的，老大？德金认为应该从‘P’开始。”~
@109671 = ~“你仍然甘愿做红色姐妹的杀手？”~
@109672 = ~“他们确信你有一个，里佐维尔。真高兴看见你，尽管我更愿意这对我们都有利。”~
@109673 = ~“你当前持有的武器是一个投掷武器。我不能升级那种东西。无论如何，我只能升级近战和远程武器。”~
@109674 = ~“你当前持有的武器已经拥有了太多威力强大的附魔。我不敢冒险再强化它了那太危险。”~
@109675 = ~“有龙吗，老大？”~
@109676 = ~“确认一下真和龙一样大吗……”~
@109677 = ~“这里就是伟大而优雅的骑士在被吃掉前打伤友好的小龙……我们正在靠近，老大。”~
@109678 = ~“啊！龙息！骑士们在它们温暖而干燥的铠甲里逃跑！赶快行动，老大，不然我们就糗大！”~
@109679 = ~“看看他们的鳞片，他们的翅膀，他们是小龙，老大。打败那些敢于吃掉伟大骑士脑袋的家伙！”~
@109680 = ~“好吧，那么这里龙试着和邪恶的术士做交易。但是邪恶的术士背叛了它而且被它杀死了。但是，龙并没有吃了他。因为术士不好吃，谁都知道。”~
@109681 = ~“哦，哇！强大的龙屠杀了整只军队，把所有的东西都变成了粉末，最后飞回了家。总是有个最后，不是吗？你在听吗，老大？”~
@109682 = ~“呃，不要死啊，老大。”~
@109683 = ~“你疯了吗？”~
@109684 = ~“小心，<CHARNAME>……”~
@109685 = ~“我也能看看吗，老大？”~
@109686 = ~“你看见什么？”~
@109687 = ~“哇！你真打算那么做吗，老大？”~
@109688 = ~“你拿到另一个了吗？”~
@109689 = ~“<CHARNAME>？”~
@109690 = ~“你还好吗，<CHARNAME>？发生了什么？”~
@109691 = ~“哇！再来一遍，老大。”~
@109692 = ~“这个是导师的水晶，不是吗？我知道它比眼睛能看到能做的更多！你还好吗？”~
@109693 = ~“你好，老鼠先生。”~
@109694 = ~这个令人恐惧的小队的领队是一个矮人武僧，他的袍子表明了他是永亡僧团的成员。他用冷漠、死亡的眼神注视着你的到来。~
@109695 = ~“那么，<CHARNAME>，看来寂静之主最终回应了你。真不幸，你的地狱之旅在这里结束了。我们计划在这里取走你的性命。”~
@109696 = ~矮人点点头。“你知道我的荣耀，<CHARNAME>……就好像我知道你的。”~
@109697 = ~“我的名字是格瑞姆格诺。我曾经与无冬城那些抵抗过摩拉格和上古之民的英雄们一起旅行过，但那是很久以前的事了……”~
@109698 = ~“在我的一生中，我一直是死亡——寂静之主的仆人。我知道那些把自己的灵魂献给我的主人的每个人的名字与长相……那些人就像你，<CHARNAME>。”~
@109699 = ~“在你的冒险旅途中，究竟有多少人死在你的手里？一百个？一千个？你为寂静之主做了很多，而且你在永亡僧团里也很知名。”~
@109700 = ~“别说了，格瑞姆格诺。<CHARNAME>·<CHARNAME>对我们是一个威胁。我们必须像处理其他灵魂那样对付<HIMHER>。”~
@109701 = ~“玛格瑞姆，当上古之民的力量遗弃你的时候，你宣誓效忠于我。不要忘记，一切都应由我掌控。”格瑞姆格诺严厉地制止了他手下的话，把他的注意力再次转向你。~
@109702 = ~艾瑞贝丝惊讶地喘了口气。“我认出这个灵魂了：是格瑞姆格诺，这个矮人曾经帮助拯救过无冬城……还有玛格瑞姆！你们在这里做什么？”~
@109703 = ~名叫玛格瑞姆的牧师冷冷地笑了笑。“艾瑞贝丝，我们又见面了。不过你可以放心，我不再追随摩拉格和上古之民了。现在我有更大的野心！”~
@109704 = ~“靡菲斯特离开以后，必须要有人来填补这个空缺。这个地狱需要有人来统治。总之，顺我者昌，逆我者亡。”~
@109705 = ~“你会被消灭的。”~
@109706 = ~矮人慢慢地摇了摇头。“不，<CHARNAME>·<CHARNAME>，你太强大了。你的存在就是一种威胁。如果是我统治的话，我一定会把可能推翻我的人统统消灭掉。”~
@109707 = ~“只有最强的人才能统治这个九渊地狱。我比你要强大，<CHARNAME>·<CHARNAME>，所以该由我来统治。而且我一定要消灭你。”~
@109708 = ~“我认识你。你就是格瑞姆格诺，无冬城的那个矮人武僧！”~
@109709 = ~“你是谁？你怎么会认识我的？”~
@109710 = ~“去死吧，矮人！”攻击~
@109711 = ~“我不会对任何人鞠躬的。”~
@109712 = ~“我宣誓效忠于您，格瑞姆格诺。”~
@109713 = ~“我想该由我来统治这个地狱……而你要宣誓效忠于我！”~
@109714 = ~“我才不会管你在这里做什么，我只是在找出去的路而已。”~
@109715 = ~你可以在魔像的三个法术存储位中各存放一个法术。战斗中，魔像会首先释放这些法术，然后再发动普通攻击。你想要在哪个法术位中储存法术？~
@109716 = ~请选择想要存储在该法术位中的法术级别：~
@109717 = ~选择法术：~
@109718 = ~选择法术：~
@109719 = ~选择法术：~
@109720 = ~请选择想要存储在法术位中的法术：~
@109721 = ~保持目前的状态不变。~
@109722 = ~法术位3（目前已储存的法术：）~
@109723 = ~法术位2（目前已储存的法术：）~
@109724 = ~法术位1（目前已储存的法术：）~
@109725 = ~返回，选择另外的法术位。~
@109726 = ~等级4~
@109727 = ~火墙术~
@109728 = ~魅影杀手~
@109729 = ~次级法术无效结界~
@109730 = ~次级法术穿透~
@109731 = ~艾萨克次级飞弹风暴~
@109732 = ~高级隐形~
@109733 = ~冰风暴~
@109734 = ~恐惧术~
@109735 = ~艾伐黑触手~
@109736 = ~弱能术~
@109737 = ~元素护盾~
@109738 = ~疫病术~
@109739 = ~困惑术~
@109740 = ~降咒~
@109741 = ~等级3~
@109742 = ~吸血鬼之触~
@109743 = ~臭云术~
@109744 = ~减速术~
@109745 = ~闪耀法球~
@109746 = ~防护元素伤害~
@109747 = ~梅斯狄强酸吐息~
@109748 = ~闪电术~
@109749 = ~隐形法球~
@109750 = ~人类定身术~
@109751 = ~加速~
@109752 = ~造风术~
@109753 = ~火焰箭~
@109754 = ~火球术~
@109755 = ~移位术~
@109756 = ~解除魔法~
@109757 = ~等级2~
@109758 = ~蛛网术~
@109759 = ~塔莎狂笑术~
@109760 = ~识破隐形~
@109761 = ~抵抗元素伤害~
@109762 = ~马友夫强酸箭~
@109763 = ~次级解除魔法~
@109764 = ~隐形~
@109765 = ~食尸鬼之触~
@109766 = ~盖德利的电击环~
@109767 = ~坚韧术~
@109768 = ~死亡护甲~
@109769 = ~黑暗术~
@109770 = ~爆炎术~
@109771 = ~轻灵术~
@109772 = ~蛮力术~
@109773 = ~目盲术/耳聋术~
@109774 = ~巴拉冈的铁号角~
@109775 = ~等级1~
@109776 = ~返回，选择另一个法术级别。~
@109777 = ~克敌机先~
@109778 = ~睡眠术~
@109779 = ~护盾术~
@109780 = ~惊恐术~
@109781 = ~衰弱射线~
@109782 = ~负能量光线~
@109783 = ~魔法飞弹~
@109784 = ~法师护甲~
@109785 = ~钢铁内脏~
@109786 = ~冰刃~
@109787 = ~霍瑞兹考勒轰鸣~
@109788 = ~油腻术~
@109789 = ~脚底抹油~
@109790 = ~虹光喷射~
@109791 = ~燃烧之手~
@109792 = ~“杀了那个凡人！”~
@109793 = ~“但……但这是！深水城的魔鬼杀手！”~
@109794 = ~“安静！杀了它，不然我就让你求生不得，求死不能！”~
@109795 = ~“遵命……大人！”~
@109796 = ~假冒娜西拉的身份~
@109797 = ~贝尔弗伦~
@109798 = ~当大多数的巫妖准备撤离这个世界的时候，贝尔弗伦却有更大的野心。他空洞的眼窝中闪耀着征服的火光，冰凉的不死身躯丝毫不影响他对力量的渴求。~
@109799 = ~平民~
@109800 = ~这名人类看起来受了很大的惊吓，急需救助。~
@109801 = ~卡斯·乌斯-卡林~
@109802 = ~这个叫做卡斯·乌斯-卡林的牛头人曾经是无冬城周边一害，所到之处只剩死亡与毁灭。一名叫做纳什尔·阿拉贡达尔的年轻英雄结束了它的恐怖统治，同时也为他自己报了杀妻之仇。~
@109803 = ~深红~
@109804 = ~深红是声名狼藉的赏金猎手，她来自巨龙海岸，以冷酷无情的完美追击而闻名。据说，有一次因为她没能发现一名躲在阴影里的敌人，就把自己的左眼挖了出来。~
@109805 = ~这个黑暗精灵是地表精灵的邪恶亲戚，住在地底的幽暗地域。~
@109806 = ~多南是个好人，一个性情温和的人。但同时也是个单调沉闷的人。~
@109807 = ~这名半身人武士出现了……但不完全是。你忽然想到几个不错的笑话，不过看起来他似乎不懂得欣赏。~
@109808 = ~格瑞姆格诺~
@109809 = ~格瑞姆格诺是永亡僧团的一员，也是无冬城英雄的追随者之一。很少有人知道他离开无冬城之后的事情，不过大概可以推测出他依然在为寂静之主工作，把成百上千的无辜者带到一个古老的坟墓里去。~
@109810 = ~一个上了点年纪的男人在桌子边歪嘴笑着，不时像变戏法似的摆弄着几个小火球，取悦着一些脸带愁容的顾客。他的前额上有两只角，其中一只有些轻微的碎裂。~
@109811 = ~疲倦的采石场工人~
@109812 = ~疲倦的采石场奴隶~
@109813 = ~愠怒的朝圣者~
@109814 = ~这种生物已经变异、卷曲得不成形了，身体外面罩着一层黑色的壳，脑组织却暴露在外面，不过它依然保留了像狗一样的习性。它会在某处呜咽、徘徊，好像在等待着什么。~
@109815 = ~沉睡者，死亡~
@109816 = ~沉睡者一动不动地站立着，作为一个天界生物，他的力量灵气中却掺杂着悲伤和少许有着地狱气息的污点。你无法确定他究竟是在沉思，还是真的睡着了。他的身旁似乎笼罩着一层难以打破的寂静。~
@109817 = ~闷闷不乐的灵魂~
@109818 = ~德金，死亡~
@109819 = ~娜西拉，死亡~
@109820 = ~邪恶的艾瑞贝丝~
@109821 = ~善良的艾瑞贝丝~
@109822 = ~死亡的艾瑞贝丝~
@109823 = ~谜题者~
@109824 = ~这个位面的生物显然是很邪恶的，不过它们都有如惊弓之鸟般。它们小心翼翼，战战兢兢地行动，抱着紧张而半信半疑的态度看着靠近的东西。很难想像这样的半智慧生命会有真正的智慧。~
@109825 = ~火矮人宝石采集者~
@109826 = ~宝石采集者饥渴地看着你。~
@109827 = ~道路守卫者~
@109828 = ~一只史拉黑蟾在暗处等待着你。你意识到它也是靡菲斯特的一个道路守卫者。它应该也是追踪沉睡者到这里，不知道因为什么原因跟丢了。~
@109829 = ~牺牲品~
@109830 = ~“敞开大门”的厨子因他那与他的炉子一样火爆的脾气而出名，~
@109831 = ~卓尔是一个精灵的邪恶亚种，居住在危险的幽暗地域的深处。这个有点特别，带有麦维尔家族的标记。~
@109832 = ~这种生物是由你身边的这些地狱岩石形成的邪恶的元素。它几乎没有什么意识，只是热衷于毁掉任何它遇到的生命。~
@109833 = ~经师~
@109834 = ~这种生物是地狱里的熔岩和火焰的扩展生命形式，被某种未知的力量赋予了意识。和其他的元素不同，它被邪恶感染了，它对周围位面的生物怀有敌意。~
@109835 = ~巨蛛~
@109836 = ~这个单肢的恶魔——巨蛛——怒吼着。~
@109837 = ~这个怪物有着巨型蜘蛛的外表，致命的有力下颚，腿上有毒刺。它总是无意识的邪恶地流着口水，准备着猎食任何出现在它面见的生物，包括它的恶魔同伴。~
@109838 = ~冰巨魔萨满~
@109839 = ~冰巨魔狂暴战士~
@109840 = ~这种发着微光的生物是由周围位面的地狱里的冰与霜形成的，被某种未知的力量赋予了邪恶的意识。~
@109841 = ~这个苍白的超自然生物散发出一种内在的能量，仿佛能穿透你的肌肤温暖你的内心。尽管她很强大，但看起来却像未成年的人类女孩一般稚嫩。~
@109842 = ~靡菲斯特是统治巴托位面的几个魔王之一。在那个位面，他的力量是至高无上的……要是他被放任到主物质位面，引发的死亡和混乱是不可想像的。~
@109843 = ~靡菲斯特，小型~
@109844 = ~要不是你亲眼看到它在动，你就会把它当成一个普通的宝物箱。看起来它满足于在这里吃宝石和老鼠，对你没有太大的兴趣。~
@109845 = ~看来地狱也有它们自己的寄生虫。这些长得像老鼠的生物，又懒又肥，在这个地区嗅来嗅去，偶然找点宝石来咬。~
@109846 = ~灵吸怪~
@109847 = ~这长者獠牙的怪物身上带着许久之前与沉睡者的可怕战斗中留下的伤疤。它应该是被靡菲斯特留下的道路守卫者之一。~
@109848 = ~这个生物是由卡尼亚它自己的黑色酸液制造出来的。和元素类似，它有着这个地狱位面的邪恶天性，活着就是为了折磨那些不幸被它遇上的灵魂。~
@109849 = ~这种残忍的狼是霜巨人的狩猎同伴，被饲养来追踪猎物，靠数量优势来打倒对手。它不是主物质位面的生物，只存在于外层位面。~
@109850 = ~地狱冰霜座狼~
@109851 = ~这根本不是狼，实际上，是座狼……一种被愤怒和仇恨支配的恶魔生物，一心只想折磨那些冰冻卡尼亚的灵魂。~
@109852 = ~地狱冰霜座狼头领~
@109853 = ~这根本不是狼，实际上，是座狼……一种被愤怒和仇恨支配的恶魔生物，一心只想折磨那些冰冻卡尼亚的灵魂。这种座狼和其他的比要大得多，是群中的首领。~
@109854 = ~这种生物是长老的首领即主母……不过没有身体，只有蝴蝶似的翅膀。如同她的外表一样奇怪，她严肃地看着你，似乎不是很欢迎。~
@109855 = ~玛格瑞姆~
@109856 = ~一个决心要复兴正在消亡的蜥蜴人族的疯子，玛格瑞姆死于围攻无冬城之战。那次之后，无冬城的人们把他火葬，骨灰散在风中。~
@109857 = ~这个满是煤尘的人不停地咳嗽。当他看到附近的一只死鹦鹉，他脸都白了，开始因恐惧而又哭又闹。~
@109858 = ~一个深水民兵连的成员。少数的。自傲的。有魔力的。~
@109859 = ~一个深水城民兵连的魔法成员。直到最近，所有本地术士要求着装宽袍。这个特别的术士对无着装时代的结束很是高兴。~
@109860 = ~曾经是幽暗地域的一个卓尔，现在他只是一个迷失的灵魂，注定要在地狱中游走。~
@109861 = ~火甲虫的恶魔体，这个生物在地狱卡尼亚的熔岩坑里繁殖，掠食进入攻击范围内的迷失灵魂。~
@109862 = ~这个怪物是由散碎的骨头组成的，被某种未知的魔力所控制。它完全没有意识，和魔像类似，一般被用做守卫附近的东西。~
@109863 = ~邪恶地精生物，居住的卡尼亚的熔岩坑里，掠食路过的迷失灵魂。由于他的体型和力量，他是个利用陷阱和数量优势来对付比他强的对手的狡猾家伙。~
@109864 = ~这个小地精看来不起眼，可是它的口水说明它比它其他的同类————如果有的话————要笨一点。~
@109865 = ~纳格鲁~
@109866 = ~瓦伦，死亡~
@109867 = ~黑色的腐败的薄雾，看起来不像是被一个生命的意识所操纵，这个生物像是一个迷失的灵魂残存的扭曲意识，已经被抽干了它的能量。~
@109868 = ~这个生物像是一个迷失的灵魂残存的扭曲意识，已经被抽干了它的能量。现在它的存在只是作为生者的食物，把它变成它已经不再拥有的生命力。~
@109869 = ~这个骷髅被未知的魔力操纵着，被一个邪恶的意识所占据。它会打倒并消灭所有它遇到的生命。~
@109870 = ~灰尘在这些不死生物奴仆的骨头上形成了皮肤样的薄膜。它们守卫这个灵堂已经相当长的时间了。~
@109871 = ~这种地狱的憎恶可以被形容为由一个宿主骷髅操纵的一团魔鬼的血肉。要是这个生物有天放弃了这个躯壳，宿主会再找一个新的身体来占据。~
@109872 = ~魔鬼战士~
@109873 = ~最后的道路守卫者举起了双刃向你挑战。~
@109874 = ~白色龙人怪~
@109875 = ~龙人怪是地狱的拷问和审讯者。五种不同的龙人怪颜色代表了不同龙种的特殊技能。~
@109876 = ~艾瑞贝丝之盾~
@109877 = ~恶魔肉体之盾~
@109878 = ~一些在血之战中被遗忘的十字军战士用堕落的敌人的肉体制作的盾牌。这个表面已经凹凸不平了，上面满是伤疤，不知是恶魔死之前还是死之后造成的。~
@109879 = ~血之铠甲~
@109880 = ~这种铠甲不仅能在战斗中给予穿戴者绝佳的保护，而且能使穿戴者吸取敌人的生命从而恢复创伤。当然这是要付出代价的，穿戴者会觉得消耗巨大并且容易疲劳。~
@109881 = ~经师之腰带~
@109882 = ~导师之皮带~
@109883 = ~戈鲁乌之腕甲~
@109884 = ~这个厚腕甲看来是用一种黑色的类花岗岩的材料雕刻而成的。在外面刻着一个名字“戈鲁乌”。~
@109885 = ~这个厚腕甲看来是用一种黑色的类花岗岩的材料雕刻而成的。在外面刻着一个名字“戈鲁乌”……和你交易的这个深渊恶魔的名字。它发出黑暗的力量，而且，似乎只有邪恶天性的人才能使用它。~
@109886 = ~正义之头盔~
@109887 = ~沉睡者在他进入到地狱深处的路上制造的。这个头盔明显表明了他爱情的失意。它珐琅的表面上被雕刻了一系列精细的图案，描述了他在极乐世界远离祝福之地的家乡，那有着田园般美景的山丘和森林。一个婀娜的女人出现在数个图中，不过她的面孔被留白了。~
@109888 = ~卡尼亚姆·卡吉克斯~
@109889 = ~有着如同它的名字般冷酷的利刃，这件武器能立刻粉碎敌人的盾牌——或许还有敌人他们本身。
并非用铁制成，这把冰剑出奇的坚硬，而且相当锋利。剑柄被皮革包裹着，上面刻着“卡尼亚姆·卡吉克斯”，意思是“魔鬼之霜冻”。~
@109890 = ~这药水的效力可以让身体温暖一段时间。它由维洛克斯莓的能量作成，效力维持。
当时间过去，如果没有莓果或木头，这个药剂可以续命。~
@109891 = ~残破的笔记~
@109892 = ~要是你在读这封信，那你一定遇到了我的道路守卫者……听着：我把莫里科洛斯的叛军深埋在卡尼亚的冰层之下。这就是反对我的下场！趁早回头，现在还来得及。~
@109893 = ~血污的笔记~
@109894 = ~这张纸因年代久远而易碎，守卫的鲜血让它变软。两种不同的笔迹交替在上面，好像是某种魔法的反应。最后的一部分还很清晰：
“我追踪异界神侍到某个冰下的坟墓，主人，但在那里失去了他所有的踪迹。”

“找到他！”

“不过，主人，那里什么也没有。他不见了。”

“就在那里等着他！”

“要是他不回来了呢？”

“在那儿等着！他或是别的什么人可能来到那里……”

“可是，主人——”

“你弄烦我了，守卫。我说了，等着！要是我有别的命令，我会下达的！”

墨迹已经久远而且褪色了。看来，再也没有别的什么命令了。~
@109895 = ~潦草的笔记~
@109896 = ~这个潦草的笔记记录了靡菲斯特现在很熟悉的手稿：
“我将要出发去获得托瑞尔。多半塔那厘赶上了这个风，因为我得到消息说他们要发动一个在我驻守位置附近的袭击。你现在赶向监狱，不计代价要保护他们。最后，我只要有些笨恶魔来找我的众名智者。效忠我，我会把我原来在深水城的统治权给你……”

看来在他出发去你的家乡托瑞尔之前，血战的战斗已经爆发了。~
@109897 = ~谜题之戒~
@109898 = ~这枚谜题之戒曾经属于那个被称作沉睡者的异界生物。它由三个可以连接在一起的部分组成，分别代表希望、信仰和爱。戴上它的人可以用特异的眼光来观照这个世界，能发现平时被隐藏或被伪装成普通事物的真相。在户外，这个戒指还标记出了一条曾经引领沉睡者到达诸界智者的道路。所有想追随他足迹的人都应该戴上它。~
@109899 = ~破烂的座狼斗篷~
@109900 = ~在卡尼亚冰冻遗迹那里遇到一队冰霜座狼之后，你杀死了座狼的头领，它是一头强大的公头狼。在检视尸体时，突然，你意识到这不过是一个捆着厚厚的粗糙缝制的座狼皮的小型秃头侏儒。这个斗篷已经被你的攻击打坏，不能在寒风中提供更多的防御，不过它不平凡的特性还是没变。你注意到这个侏儒用它来召集其他的座狼来跟随他，你猜想，你和你的同伴也可以用它来做同样的事。~
@109901 = ~守卫的属性~
@109902 = ~巨蛛的属性~
@109903 = ~冰霜巨魔的属性~
@109904 = ~熔岩怪兽的属性~
@109905 = ~冰怪兽的属性~
@109906 = ~恶魔之主的长袍~
@109907 = ~这件长袍来历不明。~
@109908 = ~巨蛛的长袍~
@109909 = ~巴托的黑暗之弓~
@109910 = ~巴托的黑暗之弓是巴特祖在魔鬼与恶魔之间展开的血战中，作为对他侦察和刺探工作的奖赏。这弓的紧凑的大小和漆黑的颜色使它易于在中立的领土比如主物质位面间穿行。~
@109911 = ~传奇健康护身符~
@109912 = ~贝尔弗伦之斗篷~
@109913 = ~当贝尔弗伦选择要成为一个巫妖时，他穿过的这个简单的斗篷也做了类似的转变，变成了一个拥有黑魔法的物品。它的魔力来自贝尔弗伦的魔法，很多人在找寻它。不幸的是，所有找到它的人，也会遭遇到贝尔弗伦本人。~
@109914 = ~血吸虫~
@109915 = ~驱魔弩箭~
@109916 = ~隐形死亡~
@109917 = ~由赏金猎人卡莱莫森所制，这件铠甲对她追踪敌人有很大帮助。不用问，大部分时候都是找到尸体而不是活捉。~
@109918 = ~长老的大师斗篷~
@109919 = ~天罚~
@109920 = ~这把硬头锤是玛格瑞姆喜爱的兵器。玛格瑞姆是一个试图要复兴上古之民的疯狂牧师。他死后，这件兵器几易其手，所有它的主人都神秘地死了，死状恐怖。有人把这归结于这件兵器上附有一个诅咒，也有人认为这是玛格瑞姆要复仇的灵魂所做的。~
@109921 = ~卡斯之斧~
@109922 = ~这把可怕的斧子是伟大的牛头人首领卡斯·乌斯-卡林所钟爱的武器。在卡斯被纳什尔·阿拉贡达尔打倒之前，这武器上已经沾满了无数英雄的鲜血。~
@109923 = ~贝尔弗伦法杖~
@109924 = ~传说这个法杖是术士贝尔弗伦转职成巫妖前夕所制。很多人相信贝尔弗伦已经下了决心，希望这个法杖能使他成为一个更强大的巫妖。也有人说是这个法杖把他引向了黑暗，因为它的魔力太过强大，可以把法师的能力提高到超过极限的地步而且摧毁他的神智。~
@109925 = ~魔鬼之刺~
@109926 = ~这把细剑可以释放出腐蚀对手皮肤的酸液，对手即使没有被酸液杀死，也会因体力不支而倒地。~
@109927 = ~终极邪恶护符~
@109928 = ~羽斗篷~
@109929 = ~这件由许多厚而软的羽毛多层缝制而成的斗篷，穿起来很舒适。在接缝处有很深的折痕，看来它之前的主人穿了它很多年。~
@109930 = ~灼热腰带~
@109931 = ~这种强有力的腰拥有如初升旭日般耀眼的金色带扣，它们来自深渊魔域的焦热地狱。在那儿，火矮人族的奴隶们被迫为他们的恶魔主人把无尽的沙海融成玻璃。暗红色的玻璃被一片片地打磨成血战中使用的箭头和矛头。~
@109932 = ~这件斗篷的历史可以追溯到理查德·加瑞森王统治吉宾斯菲尔德城邦。这是他的仆人，一个叫波尼托尔的疯子，为他而做。
波尼不是个天才，他设法在几天内完成这件斗篷。这是个怪胎，看来一点也不像斗篷，不过波尼托尔已经尽全力了。他把这个破烂的衣服包了一下，献给了他的主人。

不过这件礼品的简陋激怒了加瑞森王，当着大臣们的面把波尼杀死了，他的血把这个粗糙的斗篷染上了耀眼的红色。

在把波尼的尸体扔出去之前，加瑞森王为了嘲笑这个笨拙的工匠，把这个斗篷披在了身上。厅里的朝臣也在讥笑手工的粗劣。

这个斗篷一上肩，突然，国王发觉他变强了，变聪明了，变年轻了。即使是寒风也无法撼动这把老骨头了。

长久以来，人们认为这件斗篷是因为一个愚者的血在一个智者的厅堂上产生的与众不同的魔法。结果是，国王的术士说这个斗篷的法力不是制造出来的，而是碰巧被波尼的血染红而成的。

不管怎样，这件看来不起眼的斗篷有着相当强的法力。直到现在，吉宾斯菲尔德城中的领主和夫人们穿着他们最丑的衣服来庆祝愚人节和理查德·加瑞森王长期的英明统治。~
@109933 = ~沉睡者属性2~
@109934 = ~维洛克斯莓之火把~
@109935 = ~这个火把似乎只要你拿着它就会燃烧。即使是卡尼亚的寒风也不能熄灭它。把它熄掉放在你的背包里，当你把它拿出它又会复燃。
尽管它的照明范围不大，不过维洛克斯莓可以提供相当大的热量。~
@109936 = ~兰希尔~
@109937 = ~硫磺~
@109938 = ~硫磺是从巴托的火焰中铸造出来的，作为一个奖品，魔王靡菲斯特把它赏给了一个在卡尼亚不幸的莫里科洛斯叛乱之战中对他忠心耿耿的将军。它充满魔力的灰色刀刃在火焰中伤痕累累，锯齿状的边缘永远地卷曲着。~
@109939 = ~魔鬼战士之甲~
@109940 = ~魔鬼之头~
@109941 = ~洞穴水滴1~
@109942 = ~hx_durnan_tp~
@109943 = ~hx_durnan_cast_tp~
@109944 = ~hx_fend_tp_sound~
@109945 = ~temp_demon~
@109946 = ~恶魔之手地带~
@109947 = ~恶魔之手形状~
@109948 = ~小水池1~
@109949 = ~酒馆长凳~
@109950 = ~酒馆椅子~
@109951 = ~终结墓石~
@109952 = ~这些尸骨有致的堆在地上。~
@109953 = ~在冰雪中，你看到了一个人的轮廓。~
@109954 = ~祭坛~
@109955 = ~看来只有你有戒指，你决定最好还是靠近点检查。~
@109956 = ~箱子~
@109957 = ~圆桶~
@109958 = ~小桶子~
@109959 = ~终结闪电~
@109960 = ~经师~
@109961 = ~达尔兰~
@109962 = ~汤米~
@109963 = ~宝物库~
@109964 = ~莉努~
@109965 = ~沙尔文~
@109966 = ~先知~
@109967 = ~恶魔之手插入~
@109968 = ~拟态怪帮助打开~
@109969 = ~拟态怪帮助关闭~
@109970 = ~守卫2触发器~
@109971 = ~佣兵跳跃者~
@109972 = ~瓦伦/娜西拉罗曼史触发器~
@109973 = ~5瓦伦/娜西拉罗曼史触发器~
@109974 = ~铁匠铺~
@109975 = ~结局路径点~
@109976 = ~客栈WP~
@109977 = ~一个被吞噬的灵魂~
@109978 = ~当你离开熟悉的收割者的领地，向肮脏的亡魂之城出发时，你觉得你被突然而来的寒气冻了个正着。一些持续不变的阴暗微光映在泥乎乎的冰上，幽灵的身影在破烂的帐蓬中挤做一团，用一些火堆来赶走绝路的寒意。突然一声可怕的尖叫透过寒风传过来，一个幽灵的身影在一闪的白光里消失了。他的同伴对他的离开似乎悲哀多于惊奇。你出于好奇，决心要加入他们，烤烤火，顺便问问他们你刚才所见。~
@109979 = ~当你离开熟悉的收割者的领地，向肮脏的亡魂之城出发时，你觉得你被突然而来的寒气冻了个正着。一些持续不变的阴暗微光映在泥乎乎的冰上，幽灵的身影在破烂的帐蓬中挤做一团，用一些火堆来赶走绝路的寒意。突然一声可怕的尖叫透过寒风传过来，一个幽灵的身影在一闪的白光里消失了。他的同伴对他的离开似乎悲哀多于惊奇，据他们所说，这已经变成稀松平常的事了。显然，靡菲斯特正在吞噬这些可怜幽灵的灵魂，让他们到你的家乡托瑞尔去成为魔王军队中的一分子。~
@109980 = ~阿顿·斯维菲特，地狱气息酒馆的顾客，与吉斯泽莱朝圣者同行巡回小丑，他把他很喜欢的万魔喇叭当做纸牌游戏的奖品。他曾试图用这个喇叭来唤醒沉睡者，在他把它吹响之前，被吉斯泽莱导师当场抓住。如果你感兴趣要得到它，你只要下注，并在五个谜题之内猜出他拿的哪张牌。你不肯定能相信他，不过这值得一试。~
@109981 = ~魔王靡菲斯特耍了你。他命令你的神秘盟友，守门人，阻止你回你家乡托瑞尔的深水城，在地狱界卡尼亚给你下圈套。守门人似乎很同情你的情形，不过他说他别无选择，因为靡菲斯特用他的真名来命令的他。这种名字在这个地方看来有特别的魔力，你只有得到守门人的真名，才能摆脱靡菲斯特的控制。~
@109982 = ~沉睡者并没像你希望的那样对你找寻守门人真名的事有所帮助。你得知，在地狱军团占领卡尼亚之前，这里被一个叫做智者的古民族所生活着。他们中，有一个众名智者，被靡菲斯特囚在卡尼亚的冻土之下的某个监狱。找不到众名智者，沉睡者转而用一个魔戒作向导去找她的姐妹，诸界智者。要是你也一样这么做，也许她会帮你找到她姐妹囚困的监狱。沉睡者把这个戒指分为三个部分，藏在他会所下的一个有守卫的地窖。看来你要从那开始你的旅程。~
@109983 = ~能把你引向诸界智者而且有希望能找到守门人的真名的，那个沉睡者的戒指，是一个奇怪的宝物。当你戴上它的时候，你似乎看到了另一层的空间，异次元。有些在真实世界中不出现的东西出现了，而当你期望去找的时候又消失不见了。据沉睡者所说，在外面，这个戒指可以在巨大的卡尼亚荒原上为你指出一条明路。自从靡菲斯特把你放逐到这冻土后，你心中第一次燃起了希望之火。~
@109984 = ~你最终得到了守门人的真名：放逐者赫丘古斯。你大声念了几遍。声音有点悲，不过你急切地希望它能起作用。这是你逃出生天的车票，回到你家乡托瑞尔的深水城……就算那里已经被靡菲斯特趁你不在弄得一团糟。众名智者把你带回了卡尼亚之门，但你转念开始想在走之前，你是不是在这个位面还有什么没完成的事。和靡菲斯特作对不是件简单的事，你最好能为世界带来和平。~
@109985 = ~靡菲斯特：凶兆~
@109986 = ~凝视着插在卡尼亚冰原上的一个冰水晶，你看到靡菲斯特在你家乡托瑞尔的景象。看来他在你走之前搜索反抗军营地。当他在尸体堆上穿行时，他们又复活了，一支亡灵军队在等待他的调遣。~
@109987 = ~凝视着插在卡尼亚冰原上的一个冰水晶，你看到靡菲斯特在你家乡托瑞尔的景象。看来，他集结军队向地表慢慢进发，恣意破坏。靡菲斯特似乎是靠他做的破坏为食。每一刻，他都在变强……~
@109988 = ~凝视着插在卡尼亚冰原上的一个冰水晶，你看到靡菲斯特在你家乡托瑞尔的景象。看来他在走向地表，进入“敞开大门”。很多人被他的死亡凝视烧成了灰，可惜你还不知道杜尔南和他家人的命运。尽管如此，时间紧迫，深水城正处在危险之中。~
@109989 = ~深水城几乎要成废墟了，靡菲斯特的无情的军队到处都是。你耽搁了太长的时间，你最害怕的事还是成了现实了。~
@109990 = ~在你可以进入沉睡者神殿的内密室之前，你必须解开五个谜题，并把它们告诉吉斯泽莱导师德哈瓦娜。五个谜题如下：他是谁？他从哪里来？他为什么离开？他在寻找谁？答案是什么？
你得到了五个谜题中的一个的答案。~
@109991 = ~吉斯泽莱导师德哈瓦娜坚持认为你要解开五个谜题，你才可以进入沉睡者神殿的内密室。五个谜题如下：他是谁？他从哪里来？他为什么离开？他在寻找谁？答案是什么？
你得到了五个谜题中的二个的答案。~
@109992 = ~在探访城西北角的沉睡者神殿时，你获准进入了据说沉睡者休息的内密室。~
@109993 = ~魔王之守卫~
@109994 = ~根据沉睡者的梦，靡菲斯特留下了五个守卫来堵路。两个最弱的被他打败了，剩下三个被他骗过或避过了。经过那次以后他们学乖了，所以，你要是想沿着沉睡者的足迹，你可能要挨个面对他们三个。~
@109995 = ~从沉睡者的话得知，靡菲斯特留下了五个守卫来堵路。两个最弱的被他打败了，剩下三个被他骗过或避过了。经过那次以后他们学乖了，所以，你要是想沿着沉睡者的足迹，你可能要挨个面对他们三个。~
@109996 = ~靡菲斯特留下了五个守卫来堵沉睡者之路。两个最弱的在此前就被打倒了，现在你杀死了第三个——一个在亡魂之城外等着你的魔鬼。~
@109997 = ~靡菲斯特留下了五个守卫来堵沉睡者之路。两个最弱的在之前就被打倒了，你亲手杀了第三个。现在你杀死了第四个，他是一只追踪沉睡者到你这个位置的强大的黑色巨蟾。诸界智者应该已经很近了。~
@109998 = ~靡菲斯特留下了五个守卫来堵沉睡者之路。两个最弱的在之前就被打倒了，第二个和第三个被你亲手杀了。你现在杀死了第五个也是最后一个守卫，一个在监狱前守卫的有法力的穴居恶魔。既然五个守卫全死了，众名智者和她的秘密都是你的了。现在你要找到把她从冰里救出来的方法。~
@109999 = ~恶魔采石场的首领戈鲁乌不在了，尽管他的采矿工还在工作，害怕他会回来，或者首都莫菲斯塔会再派一个更狠的来坐他的位子。你应该为你在采石场的一筹莫展而感到羞愧。~
@110000 = ~五个谜题之五~
@110001 = ~你已经进入到神殿的内密室去见沉睡者，没必要再想什么五个谜题。~
@110002 = ~导师德哈瓦娜带着她的五个谜题死了。你只能靠你自己的智慧来追踪他们了。~
@110003 = ~五个谜题之一~
@110004 = ~五个谜题之四~
@110005 = ~在导师德哈瓦娜允许什么人进入她的神殿的内密室，他必须解开沉睡者的五个谜题。五个谜题之四是“他在找什么？”
你从地狱气息酒馆的阿顿·斯维菲特那得到了答案，沉睡者在找诸界智者。~
@110006 = ~谜题者之墓~
@110007 = ~你觉得你自己在接近诸界智者。在卡尼亚的冰封荒地之下的密室中，你找到了一个石像鬼的石像。在它的基座上写着“石遇石，石头转，闪对闪，闪电消。”~
@110008 = ~你杀死了公证者，一只像狗一样的在城中心一个洞穴入口前哀鸣的怪物。看来他单独地保守着，那个可以消去堵住洞入口的魔法的秘密。估计这个秘密因它的死去也再无人知了。~
@110009 = ~五个谜题之二~
@110010 = ~五个谜题之三~
@110011 = ~在导师德哈瓦娜允许你进入神殿的内密室之前，你必须解开沉睡者的五个谜题。五个谜题之三是“他为什么离开？”~
@110012 = ~在导师德哈瓦娜允许你进入神殿的内密室之前，你必须解开沉睡者的五个谜题。五个谜题之三是“他为什么离开？”
你从亡魂之城的亡灵那里知道了答案。他们说，因为沉睡者的内心已经觉得没有爱了。~
@110013 = ~在导师德哈瓦娜允许你进入神殿的内密室之前，你必须解开沉睡者的五个谜题。五个谜题之三是“他为什么离开？”
你从被困在卡尼亚的吉斯泽莱朝圣者那里知道了答案。他们说，因为沉睡者的内心已经觉得没有爱了。~
@110014 = ~满足了智者的要求后，你得到了亡魂之城地狱气息酒馆的小丑阿顿·斯维菲特的真名。他在神之口中被称为毁灭之卡蒂思维特。
借此之力，你现在要求他把他所有从客人那里打牌和赌博赢来的彩头都给你。~
@110015 = ~满足了智者的要求后，你得到了亡魂之城地狱气息酒馆的小丑阿顿·斯维菲特的真名。他在神之口中被称为毁灭之卡蒂思维特。
借此之力，你现在要求他挑战酒馆的守卫，一个强大的暗影龙。~
@110016 = ~满足了智者的要求后，你得到了亡魂之城地狱气息酒馆的小丑阿顿·斯维菲特的真名。他在神之口中被称为毁灭之卡蒂思维特。
借此之力，你现在要求他为你写一首传记歌来记录你的丰功伟绩，并在整个位面里传颂。~
@110017 = ~亡魂之城地狱气息酒馆的小丑，阿顿·斯维菲特，现在死了。看来他最终死于他的真名：毁灭之卡蒂思维特。结果是，这个名字已经没有用了。~
@110018 = ~满足了智者的要求后，你得到了艾瑞贝丝·德·泰尔玛兰德女士的真名。她在神之口中被称为双魂瓦达莉亚。~
@110019 = ~满足了智者的要求后，你得到了艾瑞贝丝·德·泰尔玛兰德女士的真名。她在神之口中被称为双魂瓦达莉亚。
借此之力，你现在要求她在你和靡菲斯特在深水城的废墟上对决时，要抵抗靡菲斯特的诱惑。~
@110020 = ~满足了智者的要求后，你得到了艾瑞贝丝·德·泰尔玛兰德女士的真名。她在神之口中被称为双魂瓦达莉亚。
借此之力，你现在要求她忘记她背叛无冬城的罪恶感。~
@110021 = ~满足了智者的要求后，你得到了艾瑞贝丝·德·泰尔玛兰德女士的真名。她在神之口中被称为双魂瓦达莉亚。
借此之力，你现在要求她放弃她的圣武士身份，走向邪恶之路。~
@110022 = ~满足了智者的要求后，你得到了艾瑞贝丝·德·泰尔玛兰德女士的真名。她在神之口中被称为双魂瓦达莉亚。
借此之力，你现在要求她放弃邪恶，再次恢复她的圣武士身份。~
@110023 = ~满足了智者的要求后，你得到了艾瑞贝丝·德·泰尔玛兰德女士的真名。她在神之口中被称为双魂瓦达莉亚。
借此之力，你现在要求她把她的灵魂交给你，以便你更好的对付靡菲斯特。~
@110024 = ~满足了智者的要求后，你得到了艾瑞贝丝·德·泰尔玛兰德女士的真名。她在神之口中被称为双魂瓦达莉亚。
借此之力，你现在要求她不顾你有缺点的人品而爱你。~
@110025 = ~满足了智者的要求后，你得到了艾瑞贝丝·德·泰尔玛兰德女士的真名。她在神之口中被称为双魂瓦达莉亚。
你现在把她的名字卖给了戈鲁乌，采矿场的臭嘴老板，让她一辈子都过着苦力生活。~
@110026 = ~满足了智者的要求后，你得到了你仆人德金的真名。他在神之口中被称为鳞歌者伊谢利亚。
借此之力，你现在要求他在你和靡菲斯特在深水城的废墟上对决时，要抵抗靡菲斯特的诱惑。~
@110027 = ~满足了智者的要求后，你得到了你仆人德金的真名。他在神之口中被称为鳞歌者伊谢利亚。
借此之力，你现在要求他有自信相信以他的能力，他完全可以成为一个称职的冒险者。~
@110028 = ~满足了智者的要求后，你得到了你仆人德金的真名。他在神之口中被称为鳞歌者伊谢利亚。
你现在要求他把他的灵魂交给你，以便你更好的对付靡菲斯特。~
@110029 = ~满足了智者的要求后，你得到了你仆人德金的真名。他在神之口中被称为鳞歌者伊谢利亚。
你现在把他的名字卖给了采矿场的臭嘴老板，让他一辈子都过着苦力生活。~
@110030 = ~满足了智者的要求后，你得到了亡魂之城采矿场的臭嘴老板，戈鲁乌的真名。他在神之口中被称为卑鄙加格弗洛。
借此之力，你现在要求他弃恶从善。~
@110031 = ~满足了智者的要求后，你得到了亡魂之城采矿场的臭嘴老板，戈鲁乌的真名。他在神之口中被称为卑鄙加格弗洛。
借此之力，你现在要求他把他藏了许久的宝石库指给你看。~
@110032 = ~满足了智者的要求后，你得到了亡魂之城采矿场的臭嘴老板，戈鲁乌的真名。他在神之口中被称为卑鄙加格弗洛。
借此之力，你现在要求他以你的名义放假。~
@110033 = ~满足了智者的要求后，你得到了亡魂之城采矿场的臭嘴老板，戈鲁乌的真名。他在神之口中被称为卑鄙加格弗洛。
借此之力，你现在要求他无条件的给你和你的仆人一件强大的宝物。~
@110034 = ~被称作卑鄙加格弗洛的采矿场的老板戈鲁乌，已经死了。你费了半天劲弄来的真名却一点用都没有。~
@110035 = ~满足了智者的要求后，你得到了她姐姐诸界智者的真名。她在神之口中被称为智者科德米莉亚。
借此之力，你现在要求她回来，可是，没有用。看来她找到了一个安全的藏身之处。~
@110036 = ~满足了智者的要求后，你得到了你的死对头，魔王靡菲斯特的真名。他在神之口中被称为野心瑟拉克斯菲。
借此之力，你现在要求他取消他想控制你家乡托瑞尔来变成第十层巴托地狱的计划。~
@110037 = ~满足了智者的要求后，你得到了你的死对头，魔王靡菲斯特的真名。他在神之口中被称为野心瑟拉克斯菲。
借此之力，你现在要求他让你加入他想控制你家乡托瑞尔和所有巴托地狱的计划。~
@110038 = ~满足了智者的要求后，你得到了你的死对头，魔王靡菲斯特的真名。他在神之口中被称为野心瑟拉克斯菲。
借此之力，你现在要求他让你代替他成为你家乡托瑞尔和所有巴托地狱的主人。~
@110039 = ~满足了智者的要求后，你得到了你的死对头，魔王靡菲斯特的真名。他在神之口中被称为野心瑟拉克斯菲。
借此之力，你现在要求他和你打一仗来决定你家乡托瑞尔和所有巴托地狱的命运。~
@110040 = ~满足了智者的要求后，你得到了你仆人娜西拉的真名。她在神之口中被称为寻天者奎霏莉亚。
借此之力，你现在要求她，在你和靡菲斯特在深水城的废墟上对决时，要抵抗靡菲斯特的诱惑。~
@110041 = ~满足了智者的要求后，你得到了你仆人娜西拉的真名。她在神之口中被称为寻天者奎霏莉亚。
借此之力，你现在要求她宽恕她自己，忘记她的可怕的过去。~
@110042 = ~满足了智者的要求后，你得到了你仆人娜西拉的真名。她在神之口中被称为寻天者奎霏莉亚。
借此之力，你现在要求她把她的灵魂交给你，以便你更好的对付靡菲斯特。~
@110043 = ~满足了智者的要求后，你得到了你仆人娜西拉的真名。她在神之口中被称为寻天者奎霏莉亚。
借此之力，你现在要求她不顾你有缺点的人品而爱你。~
@110044 = ~满足了智者的要求后，你得到了你仆人娜西拉的真名。她在神之口中被称为寻天者奎霏莉亚。
你现在把她的名字卖给了戈鲁乌，采矿场的臭嘴老板，让她一辈子都过着苦力生活。~
@110045 = ~满足了智者的要求后，你得到了困在亡魂之城的吉斯泽莱朝圣者首领，导师德哈瓦娜的真名。她在神之口中被称为误导之法蕾西亚。
借此之力，你现在要求她唤醒她珍爱的沉睡者。~
@110046 = ~满足了智者的要求后，你得到了困在亡魂之城的吉斯泽莱朝圣者首领，导师德哈瓦娜的真名。她在神之口中被称为误导之法蕾西亚。
借此之力，你现在要求她唤醒她珍爱的沉睡者并承认她是他的唯一之爱的事实。~
@110047 = ~满足了智者的要求后，你得到了困在亡魂之城的吉斯泽莱朝圣者首领，导师德哈瓦娜的真名。她在神之口中被称为误导之法蕾西亚。
借此之力，你现在要求她和小丑阿顿·斯维菲特和解。~
@110048 = ~满足了智者的要求后，你得到了困在亡魂之城的吉斯泽莱朝圣者首领，导师德哈瓦娜的真名。她在神之口中被称为误导之法蕾西亚。
借此之力，你现在要求她放弃她对沉睡者的信念。~
@110049 = ~吉斯泽莱朝圣者的导师德哈瓦娜，已经死了。满足了智者的要求后，你得到了她的真名是误导之法蕾西亚。可惜，已经没有用了。~
@110050 = ~满足了智者的要求后，你得到了沉睡者的真名。他在神之口中被称为忍耐之塞雷斯法。
借此之力，你现在要求他从长眠中醒来。~
@110051 = ~满足了智者的要求后，你得到了沉睡者的真名。他在神之口中被称为忍耐之塞雷斯法。
借此之力，你现在要求他离开亡魂之城，在这儿他曾邂逅了他的真爱。~
@110052 = ~满足了智者的要求后，你得到了沉睡者的真名。他在神之口中被称为忍耐之塞雷斯法。
借此之力，你现在要求他放弃他寻找真爱的想法。~
@110053 = ~满足了智者的要求后，你得到了沉睡者的真名。他在神之口中被称为忍耐之塞雷斯法。
借此之力，你现在要求他和导师德哈瓦娜打一场，这个吉斯泽莱女人为了解释他的梦而创建了一个宗教。~
@110054 = ~满足了智者的要求后，你得到了沉睡者的真名。他在神之口中被称为忍耐之塞雷斯法。
借此之力，你现在要求他相信你对于他的唯一真爱的谎言。~
@110055 = ~多年的长眠之后，沉睡者已经死了。满足了智者的要求后，你得知他真名是忍耐之塞雷斯法。由于他的去世，这已经没有用了。~
@110056 = ~从众名智者那里知道了他的唯一真爱的身份后，你回到了亡魂之城的绿肤沉睡者那里，来告知她的名字。~
@110057 = ~得知导师德哈瓦娜就是她所崇拜的沉睡者的唯一真爱后，你回到了她的神殿。把这个消息宛转地告诉了她。她的反应很复杂，最后，看来她相对于被爱而言，更习惯于崇拜沉睡者。~
@110058 = ~从众名智者那里知道了他的唯一真爱的身份后，你回到了亡魂之城的绿肤沉睡者那里。你故意让他相信那另有其人。~
@110059 = ~得知导师德哈瓦娜就是她所崇拜的沉睡者的唯一真爱后，你回到了她的神殿看她的反应。你故意让她相信那另有其人，这个谎言正中她的下怀。~
@110060 = ~沉睡者的唯一真爱，导师德哈瓦娜，死了。没有人能想到，他们在多年的亲密接触之后，却没有真正的互相了解到，他们才是天作之合。~
@110061 = ~沉睡者死了，他终生追寻真爱的旅程也结束了。~
@110062 = ~满足了智者的要求后，你得到了你仆人瓦伦的真名。他在神之口中被称为。
借此之力，你现在要求他在你和靡菲斯特在深水城的废墟上对决时，要抵抗靡菲斯特的诱惑。~
@110063 = ~满足了智者的要求后，你得到了你仆人瓦伦的真名。他在神之口中被称为恶魔斗士奥斯卡辛。
你现在要求他把他的灵魂交给你，以便你更好的对付靡菲斯特。~
@110064 = ~满足了智者的要求后，你得到了你仆人瓦伦的真名。他在神之口中被称为恶魔斗士奥斯卡辛。
你现在要求他不顾你有缺点的人品而爱你。~
@110065 = ~满足了智者的要求后，你得到了你仆人瓦伦的真名。他在神之口中被称为恶魔斗士奥斯卡辛。
你现在把他的名字卖给了采矿场的臭嘴老板，让他一辈子都过着苦力生活。~
@110066 = ~由于你得知了你的唯一真爱的身份，你和你爱人的关系得到了突飞猛进的发展。你已经可以想像你将来的幸福生活了……~
@110067 = ~由于你对你唯一真爱的身份不满意，你选择破坏刚刚建立起来的你们之间的关系。不过，似乎你无法违背上苍的安排。~
@110068 = ~你对你唯一真爱的身份不满意，你的心已经另有所属。不过，似乎你无法违背上苍的安排。~
@110069 = ~借助你知道的真爱的真名，你开始大献殷勤。抓住这个机会利用这个魔力，你要求你的爱人对你的求爱做出积极的反应，不过却无视你心里的冷漠。~
