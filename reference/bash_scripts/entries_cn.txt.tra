@97888 = ~“我想要回答那五个谜语见见那个沉睡者。”~
@97889 = ~“我不知道。”~
@97890 = ~“一个靡菲斯特的邪恶帮凶。”~
@97891 = ~“一个经历过血战的老兵。”~
@97892 = ~“一个人型龙。”~
@97893 = ~“一个精灵战斗英雄。”~
@97894 = ~“一个天上的异界神侍，善良的生物。”~
@97895 = ~“他在我的托瑞尔世界中的家里欢呼。”~
@97896 = ~“他在卡赛里的监狱中欢呼。”~
@97897 = ~“他在不停变化的混沌海位面上欢呼。”~
@97898 = ~“他在天界欢呼。”~
@97899 = ~“他在极乐境的被祝福地区欢呼。”~
@97900 = ~“他开始厌倦了美女和探索，他开始变得可怕起来。”~
@97901 = ~“恶魔的种子在他的心中成长发芽。”~
@97902 = ~“完美使他感到恶心。”~
@97903 = ~“他被当作一个叛徒而流放。”~
@97904 = ~“他的内心已经没有爱了。”~
@97905 = ~“他一直在寻找他自己的灵魂。”~
@97906 = ~“他一直在寻找你，导师，希望能得到你智慧的指点。”~
@97907 = ~“一个因她的美貌而出名的女魔鬼。”~
@97908 = ~“靡菲斯特，第八重地狱的领主。”~
@97909 = ~“诸界智者。”~
@97910 = ~“‘在且仅在你的心中。’”~
@97911 = ~“‘我在这儿。’智者说。”~
@97912 = ~“‘在极乐境，那是你所抛弃的地方。’”~
@97913 = ~“‘哪儿都不是。’”~
@97914 = ~“‘她会去卡尼亚之门旁找你。’”~
@97915 = ~“我还有些问题要问。”~
@97916 = ~“谢谢。”~
@97917 = ~“再见。”~
@97918 = ~“你知道收割者的真名吗？”~
