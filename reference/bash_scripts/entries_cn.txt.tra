@86970 = ~这扇门不是为你创造的……~
@86971 = ~这扇门通到你上次死亡的地方。你要使用它吗？~
@86972 = ~不，我想去别的地方。~
@86973 = ~[传送]是的。~
@86974 = ~这扇门通往。你要使用它吗？~
@86975 = ~不——我想去别的地方。~
@86976 = ~[传送]是的。~
@86977 = ~只有你在卡尼亚的某处放置了一个绑定点，这扇门才能使你通到那里。~
@86978 = ~这扇门通往。你要使用它吗？~
@86979 = ~不——我想去别的地方。~
@86980 = ~[传送]是的。~
@86981 = ~这扇门通往。你要使用它吗？~
@86982 = ~只有你在卡尼亚的某处放置了一个绑定点，这扇门才能使你通到那里。~
@86983 = ~不——我想去别的地方。~
@86984 = ~[传送]是的。~
@86985 = ~这扇门通往。你要使用它吗？~
@86986 = ~只有你在卡尼亚的某处放置了一个绑定点，这扇门才能使你通到那里。~
@86987 = ~不——我想去别的地方。~
@86988 = ~[传送]是的。~
@86989 = ~这扇门通往。你要使用它吗？~
@86990 = ~只有你在卡尼亚的某处放置了一个绑定点，这扇门才能使你通到那里。~
@86991 = ~不——我想去别的地方。~
@86992 = ~[传送]是的。~
@86993 = ~这扇门通往。你要使用它吗？~
@86994 = ~只有你在卡尼亚的某处放置了一个绑定点，这扇门才能使你通到那里。~
@86995 = ~不——我想去别的地方。~
@86996 = ~[传送]是的。~
@86997 = ~这扇门不是为你创造的……~
@86998 = ~这扇门通到你队长那里。你要使用它吗？~
@86999 = ~不——我想去别的地方。~
@87000 = ~[传送]是的。~
@87001 = ~你手中的这个瓶子开始晃抖。瓶子里面翻腾出一阵烟雾，这层薄雾渐渐形成一个体格强壮的男人的外形。~
@87002 = ~你手中的这个瓶子开始晃抖。瓶子里面翻腾出一阵烟雾，这层薄雾渐渐形成一个体格强壮的男人的外形。~
@87003 = ~“我不是奴隶！我是阿瑟提斯皇家的继承人。卓尔不能使我屈服，你也一样不能，凡人！”~
@87004 = ~“请允许我做个自我介绍：我是瓦尔寇里安·阿瑟提斯，拥有皇家血统的强大风巨灵。”~
@87005 = ~“你们这些凡人对我们总有些奇怪的偏见。每次我遇见你们这些人的时候，你们就觉得我有义务必须要实现你们的一个愿望。”~
@87006 = ~“非常不巧，它已经无法实现了。不过我还是很感激你把我放了出来。”~
@87007 = ~“报酬？好吧，我想这些事情应该按顺序来。不过首先，请允许我做个自我介绍：我是瓦尔寇里安·阿瑟提斯，拥有皇家血统的强大风巨灵。”~
@87008 = ~“你们这些凡人对我们总有些奇怪的偏见。每次我遇见你们这些人的时候，你们就觉得我有义务必须要实现你们的一个愿望。”~
@87009 = ~“非常不巧，它已经无法实现了。不过我还是很感激你把我放了出来。请允许我做个自我介绍：我是瓦尔寇里安·阿瑟提斯，拥有皇家血统的强大风巨灵。”~
@87010 = ~“我确实有东西可以给你作为回报；海拉斯特最近给了我一件小饰物，让我帮他保管。我猜他不想让它落入卓尔的手中，不过我也确定，他不会介意我把这东西交给你们。”~
@87011 = ~“这是一个魔法入口的活化之石，这个入口可以使你在山下地城和深水城之间来往。我好像记得海拉斯特说过，它好像在山下地城第二层的东部地区。”~
@87012 = ~“嗯，你不是一个讨厌的家伙。大多数的凡人都不会蠢到来找风巨灵的麻烦。不过由于你使我重获自由，所以我再给你一次机会。”~
@87013 = ~“我还可以为你做些其他的事情；我有一个对我们两个都有好处的提议。我已经厌倦了和卓尔做买卖。而现在海拉斯特又失踪了，我的生意不如以前了。”~
@87014 = ~“我很欣赏你，凡人。你和其他人不一样，有一种独特的品质。自从海拉斯特消失了以后，我的生意就没什么进展了。”~
@87015 = ~“我可以帮你个忙，凡人。我允许你光顾我的店铺，里面满是魔法商品。”~
@87016 = ~“是的，没错。我想你太忙了。很好——我会回到我的店铺里去，我们以后还可以继续交易。”~
@87017 = ~“我想，你肯定没有意识到，这个机会是多么地难得。”~
@87018 = ~“我是个和珍贵、强大的魔法物品打交道的商人。我在各个位面间收集稀有的神器，然后把它们卖给很少几个特定的客户。”~
@87019 = ~“海拉斯特是和我关系最好的一名顾客。这就是我同意他创造出这个召唤瓶的原因。每当他想要看我货品的时候，我都可以立刻出现。”~
@87020 = ~“当然，自从卓尔得到了这个瓶子以后，我每天都要被他们召唤二十次。如果我知道海拉斯特是这么粗心的话，就绝不会同意这件事的。”~
@87021 = ~“由于这个瓶子的力量，只要有人召唤，我都必须回应，而且我不能对召唤我的人做出敌对的行为。不过，我可以不和他们交易。”~
@87022 = ~“黑暗精灵是比我低下的种族。我不会和他们交易的。我一直谨慎地处理我的客户名单。因为你把我从卓尔的手中解救了出来，我决定把你添加到那份名单中去。”~
@87023 = ~“那么，我要回去工作了。位面间有许多稀有和奇妙的物品，我一直注意把它们添加到我的货物清单中。”~
@87024 = ~“如果你需要我做什么的话，就用这个瓶子召唤我。你每天可以使用三次。不管我在哪个位面上探险，我都会立刻回应你的召唤的。”~
@87025 = ~“我觉得那不太可能。如果你攻击我的话，我只不过会从你所在的这个位面上消失而已。你实际上无法对我造成什么影响。”~
@87026 = ~“也许你觉得你确实有能力伤害到我，不过你会发现那只是在浪费时间而已。其实如果我们互相合作的话，会更有好处。你一个人好好考虑一下吧。”~
@87027 = ~“哈哈！你当然可以，凡人。我们风巨灵对于你们来说，有着无穷的吸引力啊，不是吗？很好，有什么问题尽管提。”~
@87028 = ~“金币本身对我来说并不值钱，重要的是它的象征意义。对于凡人来说，金币是很宝贵的。放弃它是可以说是一种牺牲。我的东西都很昂贵：对你来说，购买它们是一种巨大的牺牲。”~
@87029 = ~“把金币给我，就是牺牲的价值——对于你的价值——然后转移给了我。对你来说这太过复杂了，我并不期望你能够完全理解。”~
@87030 = ~“你所需要知道的就是，我已经给我的物品估过价了，而且，一律不讲价。”~
@87031 = ~“为了寻找财富，我已经在位面间旅行了好几个世纪了。在我的旅行中遇见过许多魔法物品……不过这些物品我们的族人都不太用得上。”~
@87032 = ~“但是你们凡人会发现这些物品实际上是非常有用的。为了不浪费这些物品，我决定卖给真正需要它们的人。”~
@87033 = ~“当然，和凡人打交道是很麻烦的。这就是我要小心挑选顾客的原因。像海拉斯特这样的大法师是很有价值的客户，而一名咒法师学徒显然就不行。”~
@87034 = ~“你理解错了，凡人。其实可以说，所有的风巨灵都有皇室的血统。尽管我的家庭很受尊重，不过我还是没什么权力。”~
@87035 = ~“如果你想用你们自己的职业体系来看待我的话，我只是一名富有的商人而已。”~
@87036 = ~“你们这些凡人，行为背后的动机基本上都是一样的：贪婪，追求权力，渴望征服。我认为卓尔为了个人利益，是不管他人死活的。”~
@87037 = ~“不过，细节方面我也不太清楚。卓尔为什么要特地选择这个时间，这个地点，他们对海拉斯特做了什么，或是想对他做什么，我和你们一样一无所知。”~
@87038 = ~“不多。我知道海拉斯特创造出了它，而且我个人觉得，他对这个创造感到相当自豪。不过我对凡人的这类事情没什么兴趣。”~
@87039 = ~“我只能推测，凡人。海拉斯特一直把召唤瓶带在身边，所以我觉得，应该是不知何故，卓尔直接从他手里得到了这个瓶子。”~
@87040 = ~“不过我怀疑是海拉斯特自己把召唤瓶交给他们的。这个法师和我一样不喜欢黑暗精灵。”~
@87041 = ~“我猜这个瓶子是从他那里抢来的，也就是说海拉斯特现在成了黑暗精灵的俘虏……如果他还活着的话。”~
@87042 = ~“你要是再敢在我面前消失，我就会灭了你！”~
@87043 = ~“你要服从我，风巨灵！我拥有你！”~
@87044 = ~“很抱歉我们从一开头就不顺利。”~
@87045 = ~“这可不是什么援助——你现在是我的奴隶！”~
@87046 = ~“你是谁？”~
@87047 = ~“一个风巨灵？这是否意味着你可以满足我的一个愿望？”~
@87048 = ~“那么既然我救了你应该有些报酬吧？”~
@87049 = ~“一个风巨灵？那么我命令你听从我的命令！”~
@87050 = ~“你是一个风巨灵？这是否意味着我可以实现一个愿望？”~
@87051 = ~“你最好拿点别的东西，而不是这个恶心的破石头！”~
@87052 = ~“是那个吗？”~
@87053 = ~“谢谢。”~
@87054 = ~“我没时间。”~
@87055 = ~“那听起来好像不算什么奖励。”~
@87056 = ~“你的商店？你说什么？”~
@87057 = ~“暂且就说到这里。”~
@87058 = ~“我还想问些其他事情。”~
@87059 = ~“为什么你不把那些卓尔毁灭掉呢？”~
@87060 = ~“为什么你不停止回应召唤呢？”~
@87061 = ~“我现在想看看你的东西。”~
@87062 = ~“不，暂且就说到这里。”~
@87063 = ~“我觉得我该杀了你，拿走你的东西。”~
@87064 = ~“我想问你几个问题。”~
@87065 = ~“给我说说你的货物吧。”~
@87066 = ~“我想多了解你一些，瓦尔寇里安。”~
@87067 = ~“我想问你其他一些事情。”~
@87068 = ~“为什么要开个商店呢？风巨灵要金子来做什么呢？”~
@87069 = ~“为什么你决定做个商人呢？”~
@87070 = ~“你以前说过自己血统高贵？”~
@87071 = ~“你知道为什么黑暗精灵回到山下地城吗？”~
@87072 = ~“关于山下地城你能告诉我什么呢？”~
@87073 = ~“你知道海拉斯特发生什么了吗？”~
@87074 = ~“让我看看你卖些什么。”~
@87075 = ~收割者站在你的面前，如冰寒冷。他沉思着的平凡脸庞闪动着冷漠的火焰，你禁不住颤抖起来。~
@87076 = ~“你被禁止进入主物质位面。如果你想让我帮你回到那里，我只能对你说抱歉了。”~
@87077 = ~“你在主物质位面死去了。很抱歉你被禁止返回那里，我不能答应你。”~
@87078 = ~“当然，旅行者。在这里，我们拥有的唯一东西就是时间。”~
@87079 = ~“魔鬼靡菲斯特通过我的真名控制了我。因此我不能违背他的命令。”~
@87080 = ~“这些是神灵自己赐予我们的名字。在位面里都有巨大的力量，你可以想像，那些知道人会多么小心的保护它们。”~
@87081 = ~“唉，因为靡菲斯特同样给我下了禁令，所以我也不能答应你这个要求。但是，你可以利用我真名的力量命令我让你返回你的家，那么我就没有理由来拒绝你了。”~
@87082 = ~“这里有一个门，以前对你是封闭的。它通向卡尼亚和亡魂之城。现在它为你敞开着。你最好到那里去，就当是回家一样。”~
@87083 = ~“就我所知，除了我自己和靡菲斯特，没人知道。一个不会告诉你，而另一个你不能问……抱歉，旅行者，也许你余下的日子都要在卡尼亚度过了。”~
@87084 = ~“靡菲斯特利用了你，这是魔鬼的本质。他在你和瓦纱瑞丝之间建立了一种结合，让你们总是能够接触彼此。当你杀死她时，你和他互换了位置。”~
@87085 = ~“他用你的自由换走了禁锢他的锁链。他以前和你一样被禁锢在这里，不过通过他的诡计和阴谋，通过那种结合他逃脱了。”~
@87086 = ~“这种结合。死之结合，生之结合，力之结合，这个结合把你带到了这里，一次又一次。这是魔鬼的交易，你永远不知道你做的。”~
@87087 = ~“魔鬼，也就是靡菲斯特，禁止你去主物质界。这是卡尼亚，巴托的第八重炼狱，这里他是一切的主人。”~
@87088 = ~“当然，旅行者。在这里，我们拥有的唯一东西就是时间。”~
@87089 = ~“尽管这让我很痛苦，我是我主人的仆人。靡菲斯特下的命令我必须遵守。”~
@87090 = ~“不，我不能，不过不是因为害怕惩罚：我是地狱之子，很了解它的痛苦。他靠的是我的真名控制了我。我无法违背这种命令。”~
@87091 = ~“这些是神灵自己赐予我们的名字。在位面里都有巨大的力量，你可以想像，那些知道人会多么小心的保护它们。”~
@87092 = ~“唉，因为靡菲斯特同样给我下了禁令，所以我也不能答应你这个要求。但是，你可以利用我真名的力量命令我让你返回你的家，那么我就没有理由来拒绝你了。”~
@87093 = ~“这里有一个门，以前对你是封闭的。它通向卡尼亚和亡魂之城。现在它为你敞开着。你最好到那里去，就当是回家一样。”~
@87094 = ~“就我所知，除了我自己和靡菲斯特，没人知道。一个不会告诉你，而另一个你不能问……抱歉，旅行者，也许你余下的日子都要在卡尼亚度过了。”~
@87095 = ~“是的，第八层炼狱，卡尼亚的冰封荒地，巴托的死亡深渊。无论叫什么名字，对你都是一样的，一座监狱。”~
@87096 = ~“靡菲斯特利用了你，这是魔鬼的本质。他在你和瓦纱瑞丝之间建立了一种结合，让你们总是能够接触彼此。当你杀死她时，你和他互换了位置。”~
@87097 = ~“他用你的自由换走了禁锢他的锁链。他以前和你一样被禁锢在这里，不过通过他的诡计和阴谋，通过那种结合他逃脱了。”~
@87098 = ~“这种结合。死之结合，生之结合，力之结合，这个结合把你带到了这里，一次又一次。这是魔鬼的交易，你永远不知道你做的。”~
@87099 = ~“正相反。对于像你这样的人，没有家之类的东西了。你必须忘记主物质界的一切，因为你不会回去了。”~
@87100 = ~“禁止你去那里，而且我也不能送你去……抱歉，旅行者。让我感到哀伤的内在现在开始困扰你。”~
@87101 = ~“逝者的灵魂可以在任何地方走向终结。外部位面变化无限，谁知道一个灵魂会走到哪里。”~
@87102 = ~“也就是说，如果你希望，我可以利用这些门把他们召唤过来。但他们会自己选择是否来，按照自己的愿望。我不能强迫他们过来，就像我不能强迫你来一样。我要召唤谁呢？”~
@87103 = ~“当然，旅行者。在这里，我们拥有的唯一东西就是时间。”~
@87104 = ~“这个魂灵拒绝了……我感到了他直接对你的怒火和恨意，旅行者。他觉得你错了，不会回应你的召唤。你还想召唤谁呢？”~
@87105 = ~“行了，他的灵魂已经穿过了大门，急速向我们飞奔，正在重新组成他的身体……你的同伴回来了。”~
@87106 = ~瓦伦突然出现了，就像最后一次见到他一样。他看看四周，有点不知所措。“那么看起来我再一次被召唤出来。站在你的身边，<CHARNAME>，是吗？”~
@87107 = ~“很高兴和你在一起。”他转过身去面对者守门人。“你，奇怪的家伙，我觉得是你召唤我吧？你把我带到了这个……地方？”~
@87108 = ~“是的，坏家伙。<CHARNAME>·<CHARNAME>要你来到地狱的这里……现在，旅行者，你还想召唤谁呢？”~
@87109 = ~“这个魂灵拒绝了……我感到了她直接对你的怒火和恨意，旅行者。她觉得你错了，不会回应你的召唤。你还想召唤谁呢？”~
@87110 = ~“行了，她的灵魂已经穿过了大门，急速向我们飞奔，正在重新组成她的身体……你的同伴回来了。”~
@87111 = ~娜西拉突然出现了，似乎非常惊讶。她没有经过思考就亮出了一柄匕首。“什么……我在哪里？”她的眼睛盯着你。“<CHARNAME>？我……我又活了？”~
@87112 = ~她慢慢的点头，似乎理解了。“谢谢你带我回来，嗯，我的朋友。靡菲斯特杀死我和其他很多反抗者，至少就我看到的而言。”她看看四周。“这是哪儿？我们在位面之中？”~
@87113 = ~“是的，邪恶的家伙。<CHARNAME>·<CHARNAME>要求你出现在地狱的此处……现在，旅行者，你还需要召唤谁？”~
@87114 = ~“行了，他的灵魂已经穿过了大门，急速向我们飞奔，正在重新组成他的身体……你的同伴回来了。”~
@87115 = ~德金突然出现了。奇怪的是，他似乎看起来并不惊讶，而且一点都不意外。“老大！你总算来了。老德金一直告诉天使们他有很多事情要做，所以他不该呆在哪里，不过他们不相信他。”~
@87116 = ~（叹气）“就像他说的，老德金一直都不错，笨天使们。”他看看周围，注意到了这个房间。“嗯……老大，我们在地狱里吗？这地方或许需要清洁一下了。”~
@87117 = ~“是的，小家伙。<CHARNAME>·<CHARNAME>要求你出现在地狱的此处……现在，旅行者，你还需要召唤谁？”~
@87118 = ~收集者慢慢的点头。“沉睡者聪明而又年老。在卡尼亚形成时他就穿越了这些大门，那是离我们这些守门人出生还很遥远。不过他还在这里，沉睡等待着。”~
@87119 = ~“我年轻的那会儿见过他在沉睡，“他睡在其上的高台上刻着‘她会在卡尼亚之门找到你’，因此他在等着那个她。”~
@87120 = ~“死亡或者金发女士，谁知道？那些字在那里，或许那就是他遇到的问题的答案。这是我知道的一切。”~
@87121 = ~“看来，你已经知道了我的真名……很好，我为你打开去往深水城的通路，它会带你去见一个叫杜尔南的人。但是，你走之前，还有什么事情需要我做吗？”~
@87122 = ~“先给你一个忠告，旅行者……一旦打开靡菲斯特放在你身上的锁链，踏入那扇门，你就背离了带你来到这里的合同。”~
@87123 = ~“你不会再见到我，也不会再次目睹卡尼亚的寒冰了。”收割者深鞠一躬。“为您效劳我很……高兴。祝你好运，旅行者。”~
@87124 = ~“您想释放卡尼亚的魔鬼，嗯，<LADYLORD>，一旦出现在人类的领域，他们就很难被收回了。不过即便如此，我还是同意你的要求。还有呢？”~
@87125 = ~“如果这是你的希望，我可以这么做。即使死亡本身也不能再会留住这里的魂灵了。还有什么可以效劳的？”~
@87126 = ~“如你所愿，旅行者。我很快会把他们安全的送到边境的家，还有呢？”~
@87127 = ~带着头巾的身影出现在你的视野，如冰寒冷。他沉思着的平凡脸庞闪动着冷漠的火焰，你禁不住颤抖起来。~
@87128 = ~“这些门通向很多地方，每一个都可以通过利用你的神物来固定指向一个地方。你或许可以全部用上，除了那个薄雾笼罩的门。那一个你不能使用。”~
@87129 = ~“我不能说。”~
@87130 = ~“因为这是你的恩人的愿望……我已经许诺，这是很神圣的。”~
@87131 = ~“这是门房，进入死者之地的入口。欢迎来这里，但是我不希望你在这里游荡。你的心还在跳动，生命还在远方向你召唤……”~
@87132 = ~“你只需要提问，旅行者，因为我被命令要服从。”~
@87133 = ~“我是收割者，灵魂的征收者，尘土的收集者，守门人。你已经离开了生者之地。”~
@87134 = ~“有一个你的强大的朋友要求我让你在死之前返回生者之地。”~
@87135 = ~“你那些强大的朋友要求我不能说出他们的名字，因此我要遵守。至少，暂时，这是个秘密。”~
@87136 = ~“再见。”~
@87137 = ~“我还要问你一些事情。”~
@87138 = ~“我得去我的冒险队的头儿那里。”~
@87139 = ~“我已经死了，希望能回到我倒下的地方。”~
@87140 = ~“回到我的另一个问题。”~
@87141 = ~“为什么你不能答应？”~
@87142 = ~“真名是什么？”~
@87143 = ~“你的真名是什么？”~
@87144 = ~“那么，我现在做什么呢？”~
@87145 = ~“那么，谁知道你的真名呢？”~
@87146 = ~“靡菲斯特？但是我是在和瓦纱瑞丝战斗。”~
@87147 = ~“他取代我的位置是什么意思？”~
@87148 = ~“什么结合？”~
@87149 = ~“谁说我禁止去那里？”~
@87150 = ~“回到我前一个问题。”~
@87151 = ~“为什么你以前不告诉我这些呢？”~
@87152 = ~“你不能违背他吗？”~
@87153 = ~“真名是什么？”~
@87154 = ~“你的真名是什么？”~
@87155 = ~“那么，我知道什么呢？”~
@87156 = ~“那么，谁知道你的真名呢？”~
@87157 = ~“第八层炼狱？”~
@87158 = ~“靡菲斯特？但是我是在和瓦纱瑞丝战斗。”~
@87159 = ~“他取代我的位置是什么意思？”~
@87160 = ~“什么结合？”~
@87161 = ~“但是主物质界是我的家！”~
@87162 = ~“为什么我永远不能回去？”~
@87163 = ~“我死去的同伴怎么了？他们在哪里？”~
@87164 = ~“回到我的另一个问题。”~
@87165 = ~“召唤瓦伦。”~
@87166 = ~“召唤娜西拉。”~
@87167 = ~“召唤德金。”~
@87168 = ~“我寻找沉睡者的五个秘密。”~
@87169 = ~“他在等什么？”~
@87170 = ~“‘她’是谁？”~
@87171 = ~“放逐者赫丘古斯，我命令你打开我回家的道路。”~
@87172 = ~“谢谢，收割者。够了。”~
@87173 = ~“让魔鬼在这位面中四处破坏。”~
@87174 = ~“让亡灵重回生命之地。”~
@87175 = ~“让吉斯泽莱朝圣者回家。”~
@87176 = ~“再见。”~
@87177 = ~“看看这些门！他们通向哪里？”~
@87178 = ~“薄雾笼罩的门后是什么？”~
@87179 = ~“为什么你不能说？”~
@87180 = ~“为什么我不能用那个薄雾笼罩的门？”~
@87181 = ~“这个恩人是谁？”~
@87182 = ~“我在哪里？”~
@87183 = ~“我如何回去？”~
@87184 = ~“谁给你下的命令？”~
@87185 = ~“你是谁？我是怎么来的？”~
@87186 = ~“那么……我死了？”~
@87187 = ~“我那个‘强大的朋友’是谁？”~
@87188 = ~“我得去我的冒险队的头儿那里。”~
@87189 = ~“我已经死了，希望能回到我倒下的地方。”~
@87190 = ~“如你所愿。现在去找找可以战斗的东西，我很饥渴。”~
@87191 = ~“问我的剑同不同意？这儿有个建议：别那么做。”~
@87192 = ~“进城看看怎么样？嗯……我很久没有看到美丽的、衣着暴露的女人了。”~
@87193 = ~“使劲摇。让我更快些。”~
@87194 = ~“不要被吸魂武器刺死。如果这样了，不要试图逃脱这种武器。利剑也一样。”~
@87195 = ~“不要死去。我知道听起来很简单，但是很有效。我自己应该遵照这个原则的。”~
@87196 = ~“远离冒险，养些孩子。我不知道……你要我给你什么？我不提供建议，而是毁灭。”~
@87197 = ~“你可以继续。看起来我似乎在战斗中失去了几秒钟的知觉。”~
@87198 = ~“我看到了更好的日子。”~
@87199 = ~恩塞力克重重的叹了一口气。“如果你必须知道，我已经把最后一日的多数时间用来试图想起我女儿的名字了。”~
@87200 = ~“活着的时候，我是一个巫师，拥有胜过所有我认识的人的智力。我很骄傲，这是个麻烦，以至于最后甚至丢失了自我，连自己姓甚名谁都忘记了。”~
@87201 = ~“在考虑我是怎么变成武器中的一份之前我给你提过建议，不是吗？还记得吗？”~
@87202 = ~“我发现，你有你自己的记忆问题。或者是短期的记忆广度。不管怎么样，我突然想到和你说话的仅仅是武器上的‘烙印’……逐渐消逝的人。”~
@87203 = ~“好吧，部分的我一直想知道是否我的老朋友没有出来，并把我完全解救出来。真正的恩塞力克大概还在哪里，不知道我还存在着。”~
@87204 = ~“这是一种……一种令人不安的情绪，似乎我并不真的存在。”~
@87205 = ~“我认为，现在的我是个武器，一直到我的意识消散都是这样。”他沉思了一会。“在某种程度上，也是一种解脱：我彻底是一个武器了，其他的什么都不是。”~
@87206 = ~“那么走吧，以我为武器，如果你愿意的话……尽量用我来干掉尽可能多的敌人，这样我能稍稍的复仇。我是暴力的工具……那么我做的就应该是残暴！哈哈哈哈——哈！”~
@87207 = ~“你是想看看是不是真的有另一个灰色恩塞力克？或者曾经有一个？不……不，我不确定师父是否我想知道这些东西。”~
@87208 = ~“哼。如果把你装到下一个我们找到的棍子里，让你一个人孤单的过上半个世纪之久，看看你的性格是否会变得乐天。不，我不这么认为。”~
@87209 = ~“活着的时候我也不是只靠着武器而谋生。事实上，我有时也会用弩，但是这一直是个问题。”~
@87210 = ~“你一直没有听着我告诉你的事情吗？我的记忆在消退，一点一点的从这里消失，对此我也没有办法。”~
@87211 = ~“不。不是真的。她不会因为这样的会面而感谢我，因为我不是慈父，或者说从来没有做过。如果她还活着，也是个老太太了。”~
@87212 = ~“嗯，”他考虑了很久，“真正的麻烦是找不到我的身体。不过，我觉得我可以被传送到别人的身体里。”~
@87213 = ~“哈哈哈哈！我该做什么，亲爱的<MANWOMAN>？为了这个和你争斗？不，在这方面你很安全，不用怕。”~
@87214 = ~“我觉得唯一可能的事情就是让我的灵魂进入其他人的身体……也许是魔像或者其他东西，最好是不错的状态。”~
@87215 = ~“然而，这种过程如何进行我也不知道。我忘了很多东西……这也让我无法完整的脱离出来。”~
@87216 = ~“事实上。这么多年我丢失了很多我记忆的细节，我几乎肯定自己正在从刀里消散。有一天我会完全消失，或者仅仅留下只能靠意识才能交流的一点点。”~
@87217 = ~“但是这和你无关，亲爱的<MANWOMAN>。我有点盼望这个日子。或者是彻底完全的死去或者……没有意识，这样我就再也不用担心了。”~
@87218 = ~“你真太好了，亲爱的<MANWOMAN>，不过现在能离白骨远些倒也不算太糟。至少我不再无聊。向你保证，现在去杀戮吧，这样才能让我感觉好起来。”~
@87219 = ~“当然。令人高兴的一方面是，还有比变成剑更糟的事情。也许……也许我会变成一个锅！或者一双臭哄哄的皮靴。真恶心。”~
@87220 = ~“不要麻烦你自己，真的。如果命运对我微笑，并且有东西掉进了你怀里……那很好，不过我也不会等待神灵的介入。”~
@87221 = ~“很可能。那意味这我可能会脱离这个宝剑，真的……你遇到过多少没有灵魂的躯体，嗯？好像不多。”~
@87222 = ~“现在，现在，好像并不太糟糕。记住影响只是暂时的，不是吗？”~
@87223 = ~“你有多不舒服？”利剑不耐烦地问道。“或许你可以……但我没有想到利剑会让你这么痛苦。你自己操心吧，我没办法确认这个……”~
@87224 = ~“嗯，”利剑考虑着，“全面而言我还在从你那里吸取能量，那么好吧……我得说很可能。但同时我也在逐渐成为更加强大的武器。从很多角度而言，这是个交易，不是吗？”~
@87225 = ~“现在……别磨磨蹭蹭的了！我可以改变这个局面，给你带回生命的力量……但是这也意味着丧失加强我自己的机会。不过记住这种效果只是暂时的。”~
@87226 = ~“我……也许可以，是的。但那也会意味着丧失加强我自己的机会。不过记住这种效果只是暂时的。”~
@87227 = ~恩塞力克没有提出什么意见，只是在那里嘟嘟囔囔着，好像在说什么和感谢无关的话。~
@87228 = ~“如你所愿，”利剑不高兴的叹着气。“如果想让这个再度发生，告诉我就是了。我要试图抑制利剑的……狂热……以及其他的时期。”~
@87229 = ~“没关系？”利剑感激地吹着口哨。“好吧，这比我想像的要容易！那么继续前进，我的新伙伴！”~
@87230 = ~“哦？”利剑听起来有点怀疑。“那么确切的说，你想知道什么呢？”~
@87231 = ~“这很危险。”~
@87232 = ~“我最后一次谈及这些东西是在五十年前了。你想要什么呢？想要我给你画一张地图？我还真希望可以帮你。”~
@87233 = ~“不，不确切。我存身其中的利剑施法绝佳……它从生物汲取生命力来治疗使用它的人。”~
@87234 = ~“另外，我并不觉得惊讶。当心……我还没有被骷髅之外的生物使用过。这对我们都是一个新的体验。”~
@87235 = ~“不，并不对。你可以看到我把它埋入了地下城很深，不是吗？所有那些宝藏都在我死后被我那些所谓的同伴挖走了。”~
@87236 = ~“嗯，我发誓，如果我碰到任何一个其中的笨蛋，如果你拿我把他砍翻在地我都会非常高兴的，无论他们现在变得有多老、多么虚弱。”~
@87237 = ~“好吧，”利剑迟疑了一会，“我不……不好意思……承认这一点，不过我好像已经忘记了很多细节。”~
@87238 = ~“我已经在这个利剑里呆了大概五十年，至少五十年！我生命的很多细节内容都变得……最多只能说是模模糊糊的了。哦，我知道我自己是谁，或多或少，而且我曾经是个巫师。没有了。”~
@87239 = ~“我记得我*拥有*魔力。而且我知道它们叫什么。但是，就像我说过的，具体的内容我都不知道。”他重重的叹着气。“这真的很让人痛苦。”~
@87240 = ~“嗯……我怀疑他们还活着吗？很多我的同伴大概都是五十年前的事情了，如果他们还没有在丢下我的身体之后消逝的话。”~
@87241 = ~“我有一个女儿，但是她……她可能和我一样衰老了。不对，应该是更老。毫无疑问她不会记得灰色恩塞力克，真让人难受。我……我以前很少和她在一起。”~
@87242 = ~“不，很抱歉我得说我过去的生活已经结束了。我应该死去的……事实上，我已经是个死人，现在的我只是过去的重复而已。迷人的想法，你不这么认为吗？”~
@87243 = ~“不，很抱歉我得说我过去的生活已经结束了。我应该死去的……事实上，我已经是个死人，现在的我只是过去的重复而已。迷人的想法，你不这么认为吗？”~
@87244 = ~“自然的。那就是我来这里的原因，现在我是一柄利剑。真实的存在着……靠着剑刃为生！哈哈。我要告诉你，这就是无穷无尽。”~
@87245 = ~“好吧，*那东西*在那儿。我承认我有点悲伤，因为你很想赶紧摆脱我，但至少比让我被尘土覆盖要好得多。”~
@87246 = ~“如你所愿！前进，我的好<MANWOMAN>！”~
@87247 = ~“没关系。”~
@87248 = ~“你能提些建议吗？”~
@87249 = ~“你在这里怎么样？”~
@87250 = ~“听起来你不太高兴。”~
@87251 = ~“对你可够困难的。”~
@87252 = ~“不是。”~
@87253 = ~“是的。”~
@87254 = ~“我同意。我希望能做些事情。”~
@87255 = ~“也许，我可以看看你怎么样了。”~
@87256 = ~“这就是我需要的。牢骚满腹的武器。”~
@87257 = ~“但是你还是存在着。以武器的形式。”~
@87258 = ~“为什么很难记起来呢？”~
@87259 = ~“你想再见到她吗？”~
@87260 = ~“能把你弄出这个利剑吗？”~
@87261 = ~“你没有得到我的！”~
@87262 = ~“这也可能吗？”~
@87263 = ~“不完整？”~
@87264 = ~“太可怕了！我很抱歉。”~
@87265 = ~“有道理。那么，我就不需要再操心这个了。”~
@87266 = ~“我会试图把你解脱出来。”~
@87267 = ~“这种肉身应该是没有魂灵的吧？”~
@87268 = ~“和我谈谈你的人类生活吧。”~
@87269 = ~“我希望你可以加强利剑上的附加魔法。”~
@87270 = ~“你似乎在影响我的健康。究竟是为什么？”~
@87271 = ~“你说不确定是什么意思？”~
@87272 = ~“我会慢慢忍受这个的。”~
@87273 = ~“我会因此而死吗？”~
@87274 = ~“还会更糟吗？”~
@87275 = ~“我觉得我得把你卖掉。”~
@87276 = ~“你能为此做些什么吗？”~
@87277 = ~“算了。也许这样你更有价值。”~
@87278 = ~“那么，别介意。我暂时可以保留这个魔法。”~
@87279 = ~“好吧。暂时清除这个魔法。”~
@87280 = ~“没关系。”~
@87281 = ~“回答我一些问题如何？”~
@87282 = ~“我没必要知道任何事情。”~
@87283 = ~“你能和我谈谈山下地城？”~
@87284 = ~“不，真的。”~
@87285 = ~“你还有我知道的神秘力量吗？”~
@87286 = ~“你知道附近哪里有什么财宝吗？”~
@87287 = ~“和我谈谈你的人类生活。”~
@87288 = ~“忘了？”~
@87289 = ~“你还记得任何法术吗？”~
@87290 = ~“还有怀念你的人吗？”~
@87291 = ~“你可以做我的武器，这就是办法。”~
@87292 = ~“你能卖个好价钱。”~
@87293 = ~“好吧，我们走吧。”~
@87294 = ~制造菜单~
@87295 = ~你想知道（需要GP）？~
@87296 = ~你想知道（需要GP）？~
@87297 = ~你想知道（需要GP）？~
@87298 = ~你想知道（需要GP）？~
@87299 = ~你想知道（需要GP）？~
@87300 = ~[成功]——你成功的制造了这个物品！~
@87301 = ~——你没有制造出这个物品。~
@87302 = ~在这里你能找到各种各样的原料。这些原料依其质地可以变成不同的武器或铠甲的部件。一旦原料变成了部件，可以与其他部件一同制造各种各样的物品，弹药如匕首、铠甲、弹药等等。~
@87303 = ~这些原材料有毛坯布、皮革、榆木板、橡木板、大块的骨骼、铁、钢还有羽毛。杀死生物或消灭其他东西可以得到这些材料。~
@87304 = ~这些原材料可以变成或大或小的部件。大型的部件包括：原皮甲、榆木弩架、橡木把手、橡木盾面、钢片胸甲、钢锁子短甲、全身钢甲、钢刀把、头盔、发射杆还有衣料。~
@87305 = ~小型的部件用在大型的部件上来决定最后的物品是什么。包括：皮甲片、皮绳、铁钉、铁链、铁环、铁带、小钢片、大钢片、毡布垫还有铁锤头。~
@87306 = ~靠这个部件你无法制造武器！~
@87307 = ~靠这个部件你无法制造武器或铠甲！~
@87308 = ~靠这个部件你什么都制造不了！~
@87309 = ~现在的状态你无法使用制造技能。~
@87310 = ~制造DC：金币：~
@87311 = ~是~
@87312 = ~制造DC：金币：~
@87313 = ~是~
@87314 = ~制造DC：金币：~
@87315 = ~是~
@87316 = ~制造DC：金币：~
@87317 = ~是~
@87318 = ~制造DC：金币：~
@87319 = ~是~
@87320 = ~研究制造之术~
@87321 = ~退出~
@87322 = ~神物是奇怪的东西，上面刻着字。表面的刻字可能反映出它的真实情况。~
@87323 = ~现在你不能删除绑定点，因为你一个也没有放置。~
@87324 = ~你可以去掉绑定点，只要去掉指引神物魔力的魔法地域。这样，你就可以建立一个新的绑定点。~
@87325 = ~现在你不能传送到任何地方，因为你一个绑定点也没有放置。~
@87326 = ~通过被传送回收割者的领域，你可以用五个魔力之门之一来回到从前建立绑定点的地方。你也可以返回冒险开始的地方。~
@87327 = ~绑定点可以让你回到曾经去过的地方。你可以建立五个绑定点。每个绑定点都需要一个你的游荡石。~
@87328 = ~神物可以在五个你选择的绑定点上起作用。你可以在任意时刻传送回这些绑定点。~
@87329 = ~放置绑定点需要游荡石。传送到一个绑定点无需付出任何代价。你只有在你的物品栏中有游荡石时才能放置绑定点。~
@87330 = ~没有绑定点可以传送。通过使用神物来建立绑定点。~
@87331 = ~[取消绑定点。]~
@87332 = ~[把神物放回背包。]~
@87333 = ~[取消绑定点5——位于]~
@87334 = ~[取消绑定点4——位于]~
@87335 = ~[取消绑定点3——位于]~
@87336 = ~[取消绑定点2——位于]~
@87337 = ~[取消绑定点1——位于]~
@87338 = ~[回到领导者那里。]~
@87339 = ~[传送到绑定点。]~
@87340 = ~[把神物放回背包。]~
@87341 = ~传送回门房。~
@87342 = ~[建立绑定点。]~
@87343 = ~[把神物放回背包。]~
@87344 = ~[试试其他东西。]~
@87345 = ~[建立绑定点5。]~
@87346 = ~[建立绑定点4。]~
@87347 = ~[建立绑定点3。]~
@87348 = ~[建立绑定点2。]~
@87349 = ~[建立绑定点1。]~
@87350 = ~[查看说明。]~
@87351 = ~你认出了这个黑暗精灵是里佐维尔，先知的反抗军营地的铁匠。他对你微微一笑说，“我没想到在这里可以见到你，<CHARNAME>·<CHARNAME>。欢迎来到炼狱之中。”~
@87352 = ~“我在立特米亚撒的围城之战中死去了。不知道为什么最后会到了这里……也许第八层地狱需要一个好铁匠吧。”~
@87353 = ~“不太糟糕。我已经重建了我的熔炉，从下面汲取热量。我已经打造了很多武器，尽管生意不怎么样，不过总比没事干强。”~
@87354 = ~“这些顾客有点不同：或是魔鬼，或是吉斯泽莱人，而非我习惯见到的卓尔们。但除此之外，万变不离其宗。我还在卖武器、升级武器。”~
@87355 = ~“又回来了，<CHARNAME>·<CHARNAME>？想看看我的货物吗？还是你想升级自己的武器？或者还有其他事情？”~
@87356 = ~这个卓尔铁匠从他的炉边抬头看着，他的脸上是汗水和炉灰的痕迹：“你是先知等待的那个地面人，不是吗？我在想你到这里用了多久。”~
@87357 = ~“我的名字叫里佐维尔，手艺大师，擅长打造武器。你是<CHARNAME>·<CHARNAME>，对吧？很高兴见到你。”~
@87358 = ~“如果需要我帮忙，随时在此效劳。随便看看我的货物吧，哦，如果你需要，我可以帮你升级武器。”~
@87359 = ~“再见，<CHARNAME>·<CHARNAME>。如果你想购买或者升级武器，你可以来找我。”~
@87360 = ~“再见，祝你好运，<CHARNAME>·<CHARNAME>。我们全靠你了。”~
@87361 = ~“铠甲和武器，多数都是……不过武器是我的专长。而且，我可以升级武器。如果考虑这个环境我的价钱非常公道。”~
@87362 = ~“我不是因为贪婪才要钱。我需要黄金来作为我魔法熔炉的燃料。黄金可以让魔法之焰纯净炙热的燃烧。没有黄金我就不能打造和升级武器了。”~
@87363 = ~“我在这里没多久，知道的不多。我一直关注于打造武器，还要帮那些需要的人来升级武器。”~
@87364 = ~“回答问题并不是我所擅长，但我会尽力帮助你解决问题。”~
@87365 = ~“我确信，没有比你听说的更多的消息了。我听说她过去是魔索布莱城的主母之一，但这可能只是个传言。”~
@87366 = ~“我知道的就是如果我们不能找到团结起来对抗她的办法，她的大军会把我们全部干掉。我只希望麦维尔家族能够聪明的看到这一点。”~
@87367 = ~“好吧，这曾经是麦维尔家族的旧家。但自从我们进来——我是说先知和她的追随者——这更像一个难民营了。”~
@87368 = ~“正如你所想的，这里的气氛很紧张。很多卓尔不喜欢伊丽丝璀的追随者，麦维尔家族也不例外。不过，他们没有别的选择。”~
@87369 = ~“如果我们不联合起来，瓦纱瑞丝会把我们一扫而光。如果我们能团结，或许还有生存的机会。至少先知是这么认为的。”~
@87370 = ~“我和先知一起来到这里，但是我不是伊丽丝璀的追随者。并不是所有跟随先知的人都与她保持一致的宗教信仰。”~
@87371 = ~“我们有些人是从瓦纱瑞丝那里逃出来的卓尔。几个强大的卓尔家族被她的军队消灭了，只有一部分幸存者留下来了。”~
@87372 = ~“我的经历没什么特别的。我很小就开始学习我的技能，很快就靠这些引起了位于切那萨德的赞罗他家族的乌撒拉主母的注意。”~
@87373 = ~“但是当瓦纱瑞丝开始掌权，赞罗他家族拒绝加入她……这是个大错误。瓦纱瑞丝消灭了整个家族。就我所知，我是唯一的幸存者。”~
@87374 = ~“在我逃出切那萨德的路上，我遇到了几个伊丽丝璀的追随者。他们很同情我，把我带到了先知这儿，从那时起我就成为她的随从。”~
@87375 = ~“我没有告诉过你我是个手艺大师吗？我可以造任何武器，并使它变得更好，只要你给我足够的黄金。”~
@87376 = ~“我的工作和那些用大锤锻造武器的铁匠有些不同。我是个手艺人。我用技巧和强力的魔法来代替蛮力。”~
@87377 = ~“给我一个武器，我可以用我熔炉的魔力来提高它的品质。我可以进行增强。我可以用火焰、寒冰或者闪电的力量来浸透它。无论你需要什么，我都能做到。”~
@87378 = ~“我看你现在手里没有什么武器。如果你需要升级武器，你得把它拿出来。”~
@87379 = ~“我看你拿着武器。需要我升级吗？”~
@87380 = ~“没问题，要我替你的做些什么呢？”~
@87381 = ~“你的已经具有那个属性了。这样做只是浪费你的黄金。”~
@87382 = ~“你的已经具有那个属性了。这样做只是浪费你的黄金。”~
@87383 = ~“你的已经具有那个属性了。这样做只是浪费你的黄金。”~
@87384 = ~“你的已经具有那个属性了。这样做只是浪费你的黄金。”~
@87385 = ~“没问题，要我替你的做些什么呢？”~
@87386 = ~“还可以为你做什么呢？”~
@87387 = ~“你的已经具有那个属性了。这样做只是浪费你的黄金。”~
@87388 = ~“你的已经具有那个属性了。这样做只是浪费你的黄金。”~
@87389 = ~“你的已经具有那个属性了。这样做只是浪费你的黄金。”~
@87390 = ~“你的已经具有那个属性了。这样做只是浪费你的黄金。”~
@87391 = ~“你的已经具有那个属性了。这样做只是浪费你的黄金。”~
@87392 = ~“你的已经做过附魔升级了。这样做只是浪费你的黄金。”~
@87393 = ~“你的已经做过附魔升级了。这样做只是浪费你的黄金。”~
@87394 = ~“你的已经做过附魔升级了。这样做只是浪费你的黄金。”~
@87395 = ~“对不起，你似乎没有足够的黄金。我需要黄金来作为我魔法熔炉的燃料。黄金可以让魔法之焰纯净炙热的燃烧。只有黄金才能如此燃烧，这样我才能施法。”~
@87396 = ~“看一个大师在工作。”~
@87397 = ~“你的已经做过伤害升级了。这样做只是浪费你的黄金。”~
@87398 = ~“对不起，你似乎没有足够的黄金。我需要黄金来作为我魔法熔炉的燃料。黄金可以让魔法之焰纯净炙热的燃烧。只有黄金才能如此燃烧，这样我才能施法。”~
@87399 = ~“看一个大师在工作。”~
@87400 = ~“你的已经具有那个属性了。这样做只是浪费你的黄金。”~
@87401 = ~“我不是因为贪婪才要钱。我需要黄金来作为我魔法熔炉的燃料。黄金可以让魔法之焰纯净炙热的燃烧。没有黄金我就不能打造和升级武器了。”~
@87402 = ~“你在这里干什么？”~
@87403 = ~“我想升级武器。”~
@87404 = ~“再见。”~
@87405 = ~“你卖些什么东西？”~
@87406 = ~“让我看看你的货物。”~
@87407 = ~“我在为拯救你们而努力！难道你不能给我点帮助吗？”~
@87408 = ~“我想问你一些问题。”~
@87409 = ~“我怎么才能升级武器？”~
@87410 = ~“你了解瓦纱瑞丝吗？”~
@87411 = ~“能和我谈谈这个营地吗？”~
@87412 = ~“我想问你其他的事情。”~
@87413 = ~“你是伊丽丝璀的追随者吗？”~
@87414 = ~“和我谈谈你自己吧。”~
@87415 = ~“你可以升级武器吗？”~
@87416 = ~“这是怎么做的？”~
@87417 = ~“我想升级我的。”~
@87418 = ~[附加无限弹药+5。需要金币]~
@87419 = ~[附加力量修正值上限+10。需要金币]~
@87420 = ~[附加力量修正值上限+5。需要金币]~
@87421 = ~[附加攻击加值+1。需要金币。攻击加值最大为+10]~
@87422 = ~“我想升级我的。”~
@87423 = ~“我改变主意了。”~
@87424 = ~[让武器可以恢复我的生命生命（每轮增加生命2点）。需要金币]~
@87425 = ~[让武器增加我的魔法抗力（+20魔法抗力）。需要金币]~
@87426 = ~[让武器使我获得增加真知术。需要金币]~
@87427 = ~[让武器获得锐锋效果。需要金币]~
@87428 = ~[让武器永久加速。需要金币]~
@87429 = ~[附加闪电伤害+2d6。需要金币]~
@87430 = ~[附加火焰伤害+2d6。需要金币]~
@87431 = ~[附加冰冻伤害+2d6。需要金币]~
@87432 = ~[附加酸性伤害+2d6。需要金币]~
@87433 = ~[附加增强加值+1。需要金币。增强加值最大为+10]~
@87434 = ~“既然我是为了拯救你们大家，不能帮我一下吗？”~
@87435 = ~浓稠而冰冷的薄雾不断涌入冰封的水池。冰面下似乎埋藏着无法辨认的东西，在池中时起时伏。~
@87436 = ~离开。~
@87437 = ~把你的手伸进冰冷的池里。~
@87438 = ~---------- Random Pop-Ups Start Here ------------~
@87439 = ~野蛮人的反应很惊讶。“我知道。你能确信这是对的吗？在你穿过山下地城的路途中，你也许在战斗里会需要我的力量和技术。”~
@87440 = ~“你不会后悔做这个决定的，<CHARNAME>。我以我血管中流淌着的红虎之血为誓。”~
@87441 = ~达尔兰皱着眉头。“我不喜欢这样，但我尊重你的决定，<CHARNAME>。我会在这里等你回来。”~
@87442 = ~“如你所愿，尽管我认为你在犯错误。再见，<CHARNAME>。”~
@87443 = ~“你想改变成什么战术？”~
@87444 = ~“我最好把这些陷阱留给能弄好它的人。”~
@87445 = ~“我拆除陷阱的能力不够。不过我会尽力。”~
@87446 = ~“不过，乌斯嘉战士不会躲在阴影里。这种战术更适合于巡林客和刺客们。”~
@87447 = ~“我会在这里躲到战斗开始，然后我会突袭那些敌人。”~
@87448 = ~“这不是我这类人的战斗方式，不过我会在可能的时候发起突袭。”~
@87449 = ~“这是个好主意。我该把这些锁留给更擅长撬锁的人。”~
@87450 = ~“我会为你清除前进道路上的任何障碍！”~
@87451 = ~“很好。你想让我呆多远呢？”~
@87452 = ~“如你所愿。”~
@87453 = ~“这就是通向乌斯嘉人和红虎部落的道路。我很高兴对出现在面前的你的敌人发起攻击。”~
@87454 = ~“我会用我的生命来保护你，我会在战斗中一马当先。”~
@87455 = ~“如你所远。看看我的背包吧，你想怎么样就怎么样。”~
@87456 = ~半兽人奇怪的看了你一眼。“我希望自己的怒火是在战场上发泄。你现在想惹我生气吗？”~
@87457 = ~半兽人耸耸肩。“我不是喜欢说话的人，不过如果你想说就说吧。”~
@87458 = ~“如你所愿。还需要什么呢？”~
@87459 = ~“考虑现在情况，还有可能的情况。我健康而且毫发未伤，可以面对山下地城的情况。”~
@87460 = ~“你还想知道什么吗？”~
@87461 = ~“我还有一些小伤，不过不碍事。如果别人伤得重些，可以等一会再给我治疗。”~
@87462 = ~“我伤得很重，不过不会致命。如果可能，最好在下次战斗前治疗一下。”~
@87463 = ~“我伤得汉中。如果不赶紧治疗，下次战斗中我可能就帮不上什么忙了。”~
@87464 = ~“我还是什么都看不到，整个世界尽是黑暗。如果不赶快治疗我的眼睛，下次战斗我就帮不上忙了。”~
@87465 = ~“这毒药让我很虚弱。我们得尽快找到解毒的方法。”~
@87466 = ~“这病折磨着我，我越来越糟糕了。我们要赶紧找到办法来治疗它，越快越好。”~
@87467 = ~“我没太想起它，<CHARNAME>。不过在山下地城的黑暗之中的生活让我更加热爱家乡的宽广平原了。”~
@87468 = ~“我认为……我想在此之后我要回到红虎部落了。如果长老们还需要我的话，我会接收他们的邀请加入部落长老会。”~
@87469 = ~“不，我不这么认为。当然，现在不行。所有这些计划都需要我们能幸存下来——如果我们只在这里夸夸其谈，无事可成。继续开始我们的任务吧。”~
@87470 = ~“是的，我认为我是。当然，所有这些计划都需要我们能幸存下来——如果我们只在这里夸夸其谈，无事可成。继续开始我们的任务吧。”~
@87471 = ~野蛮人皱起了眉头。“我想你已经赢得了了解这个传说的权利。毕竟，是你把我救了过来。”~
@87472 = ~“我回到我的人民那里：乌斯嘉的红虎部落。当我离开是，我是被放逐的，我是一个有兽人血统的所谓贱民。但我回来的时候受到了英雄般的待遇。”~
@87473 = ~“长老知道我参与拯救了无冬城。更重要的是，在冒险中，我发现了乌斯嘉之矛，遗失了数个世纪之久的部族圣物。”~
@87474 = ~达尔兰皱起了眉头。“如果你只是想嘲弄我，为什么你在第一个地方问我这事呢？”他摇摇头，跺脚而去。~
@87475 = ~“一段时间里，我在红虎部落与儿女们一起生活的很高兴。但不久部族长老们来找我，希望我加入部族长老会。他们希望我来帮助领导这个部落。”~
@87476 = ~“我拒绝了这个荣誉。我还没有准备好承担这项责任，我知道我还有其他的目标要去完成——尽管我并不知道它是什么。”~
@87477 = ~“我本应该留在我的部落里，我还是个众人景仰的英雄。但是我觉得生命并不完整，我对生存的目标并无感觉。所以我又一次离开了乌斯嘉部落。”~
@87478 = ~“我向北走了一段时间，受雇为佣兵或保镖。最后，我遇到了莉努和沙尔文，在无冬城我碰见了他们。我认为这是一个先兆。”~
@87479 = ~“我说服他们相信我们的命运是纠结在一起了。很快，我们遇见了那个游荡者，汤米。他在逃跑——就像平常一样——他也很高兴的加入了我们。”~
@87480 = ~“也许，不过我有别的看法。在我们聚在一起之后不久，我们听说了对深水城的攻击，我们新的目标就很明显了。”~
@87481 = ~“我也这么认为。在我们聚在一起之后不久，我们听说了对深水城的攻击，我们新的目标就很明显了。”~
@87482 = ~“我们都参与拯救了无冬城，现在我们又聚到一起来拯救另一个城市。有一种冥冥之中的力量把我们带到了这里——它也把你，<CHARNAME>，领到了这里。”~
@87483 = ~“但是仅仅靠夸夸其谈我们可拯救不了深水城。我们晚些再谈把，现在我们得回到手头的任务上了。”~
@87484 = ~他耸耸肩。“也许我是。我还没有准备好去承担部族长老的责任。但我不认为这是逃避。我只想去寻找我没有的东西。”~
@87485 = ~“我原先并非来自无冬城。但你是对的：在那段可怕的时间我在那里，一场可怕的瘟疫席卷了这个城市。”~
@87486 = ~“我和无冬城的大英雄一起旅行，并在根除瘟疫的行动里起到了一些小小的作用。”~
@87487 = ~“我并不惊讶。拯救城市中我的作用很小。城里很少有人会知道我是谁。”~
@87488 = ~“真的吗？我很吃惊。事实是拯救城市中我的作用很小。城里很少有人会知道我是谁。”~
@87489 = ~“实际上，城里很少有人会知道我是谁。拯救城市中我的作用很小。”~
@87490 = ~“然而，为了感谢我的努力，纳什尔领主的确为我颁发了不少赏金。但即使是靠着这些财富，我在无冬城也找不到快乐。”~
@87491 = ~“不？真奇怪，因为是你开始这个谈话的。很好，继续我们的任务吧，我不想再谈我在无冬城的日子了。”~
@87492 = ~“也许这是我的传统。很多乌斯嘉部落都参加攻打无冬城。人们用怀疑和仇恨的目光看着我。而我又是一个半兽人，这就更糟了。”~
@87493 = ~“但我也认为还有些其他问题。无冬城本身也有错；它毁灭了自己的灵魂，出卖了自我，与自我为敌。”~
@87494 = ~“我是在说艾瑞贝丝，无冬城的战士，还有她的爱人范斯维克。为了平息暴乱，范斯维克被处死：这真是残忍而不公正的惩罚。”~
@87495 = ~“是的——她和她的爱人范斯维克。因为那些暴徒叫嚣着要以他的鲜血来偿还，纳什尔领主处死了他，但是他唯一的罪过是因为他被拯救无冬城的强烈愿望蒙住了眼睛。”~
@87496 = ~“范斯维克的死导致了艾瑞贝丝的背叛：无冬城背叛了她所爱的人，她以同样的方式来报复这座城市。”~
@87497 = ~“艾瑞贝丝是无冬城善的象征，她倒下之后，城市的部分灵魂也随之死去了。城市依旧存在，但是有些伤口难以愈合。也许这就是我为什么离开的原因。”~
@87498 = ~“我回到了我的家乡，乌斯嘉人红虎部落的土地。”~
@87499 = ~“是的，没有希望。不过很准确。不久城市会重建。但我不想和这有什么关系。我回到了我的家乡，乌斯嘉人红虎部落的土地。”~
@87500 = ~这个魁梧的野蛮人深深的叹着气。“也许最好我们晚些再谈论这个话题。我现在希望把精力集中在如何离开山下地城。”~
@87501 = ~“如你所愿。”~
@87502 = ~“我会忠诚的为你效劳，如同你是红虎部落的一员。”~
@87503 = ~“很好。如果你愿意，也许我以后会告诉你。”~
@87504 = ~“我在想山下地城，还有所有死在这里的人们。整个费伦的人们都知道，海拉斯特的地下城就是冒险者的墓地。”~
@87505 = ~“很好。我会保留这个想法。”~
@87506 = ~“我只是不能理解为什么有人会想要下到这里来。为什么要把生命耗费在这种以谋杀你为目的的地下城之中呢？”~
@87507 = ~半兽人点点头。“我想我会尊重这种想法。但是还有其他很多的地方可以验证冒险者的勇气。”~
@87508 = ~“是的，那里是有财富……但不值得去冒险。除了山下地城还有很多地方可以去寻宝；那里可要安全的多。”~
@87509 = ~“英雄？去那里的所谓英雄都是为了自己的私人目的——这可不是什么英雄。我觉得他们完全可以找到其他更能证明自己价值的地方。”~
@87510 = ~“在冒险者的心里似乎总能记起这个地方。它的传说四处盛行，我禁不住怀疑是否里面有什么超自然的力量在主宰这一切。”~
@87511 = ~“我也在想同样的事情。海拉斯特花了很多年来设计这座地下城，他把自己全部的精力和时间都投入其中。他或许很想让别人见识见识他创造的这个地方。”~
@87512 = ~“难道海拉斯特不会在这个设计精密的地下城里设置魔法吗？山下地城这个名字本身不就具有让冒险者深陷其中而不能自拔的魔法力量吗？”~
@87513 = ~“也许吧。但或许那里还有别的东西。也许山下地城这个名字本身就具有某种诅咒：听到这个名字的冒险者难以抑制对于它的好奇心。”~
@87514 = ~“不？海拉斯特是个大法师。我们也不知道他的魔力是什么？也许山下地城这个名字本身就具有某种诅咒：听到这个名字的冒险者难以抑制对于它的好奇心。”~
@87515 = ~“这种吸引力是微弱的，它可以被抑制……但它总是存在着。这个想法隐藏在你的思绪中，终归会吞噬你的思想，让你屈服于它，开始向山下地城前进。”~
@87516 = ~半兽人耸耸肩。“我不知道。似乎山下地城这个名字在我的大脑里萦绕着，我也无法把它排除于外。也许当我们找到海拉斯特就能解决所有问题。至少，我希望能这样。”~
@87517 = ~“想想吧。海拉斯特花了很多年来设计这个地下城，他为此倾注了大量的时间和精力。也许他希望别人能看到他的杰作。”~
@87518 = ~“那可不同。我们的目的是神圣的，我们要拯救整个城市。那些在攻击深水城之前来这里的人呢？他们的目的是什么呢？”~
@87519 = ~“我有一些要坦白的，<CHARNAME>。有些……有些事情是不同的。但是我想你有权利知道。”~
@87520 = ~“如你所愿。那么，我们回到手头的工作吧。”~
@87521 = ~“我不喜欢这个地方。我向如果不是脑袋有问题，没有人会喜欢在山下地城游荡，这里尽是陷阱和怪物。但对于我而言还要糟糕。”~
@87522 = ~“这里的空气阴沉而腐败。走廊太狭窄了。天花板也太低了。如果上面的山塌了，并把我们埋葬在岩石之中该怎么办？”~
@87523 = ~“我不会背叛你！我们乌斯嘉认为我们必须面对我们的威胁。我们靠的是征服它，这样他们就不再能压迫我们了。”~
@87524 = ~“我只是觉得你应该了解我的……处境，因为好像是你在领导这次冒险。但我发誓不会让这些在我们的任务中影响到自己。”~
@87525 = ~“我知道这看起来不太合理，但我的确一直生活在我部落所处的巨大地区中。我习惯了广阔的天空，习惯了寒风刺透我的脸庞。这地方让我感觉太糟糕了。”~
@87526 = ~“是的，当然。我知道。我们乌斯嘉人相信我们必须面对威胁。我们要征服它，这样它们才无法在威胁我们。”~
@87527 = ~“不！好吧……是的。也许要一点。这通常不是问题，我以前去过地下城，但是山下地城不同，它更加可怕。”~
@87528 = ~--------- 开始随机对话 ----------~
@87529 = ~“这扇门好像是一种特殊的保护装置，海拉斯特靠它来控制山下地城的生物，并保持他们各自的不同等级状态。”~
@87530 = ~“这个地下城里到处都是各种各样的强大而危险的生物。如果它们聚在一起，真是不小的麻烦，即使对于海拉斯特本人来说也是如此。”~
@87531 = ~“我所关心的是这扇门被封了起来。如果紧急系统已经启动，那么也就意味着海拉斯特已经不再控制它了。”~
@87532 = ~“如你所愿。”~
@87533 = ~半兽人摇摇头。“我不能猜测。但我怀疑我们得仔细考虑是否要继续进入这个迷宫。”~
@87534 = ~“我们乌斯嘉有一个传说，关于迷失部落的传说。据说他们消失在地下，那些酋长的白骨一直守卫这部落的财富。”~
@87535 = ~“我只是说我们在这儿一定要小心。无论做什么请记住我的警告。”~
@87536 = ~“传说认为那些骷髅一直在静静的伴随着他们的财富休眠，如果有人来侵扰，他们就会醒来屠杀那些入侵者。”~
@87537 = ~“我怀疑我们是否已经发现了乌斯嘉迷失部落的遗迹，但我认为每一种生物都有类似的这种传说，一些亡灵守卫着自己的财富。”~
@87538 = ~“不，或许不是。但我认为每种生物都有这种传说，亡灵守卫着自己的财富，如果别人来打扰他们，他们会突然出现。”~
@87539 = ~“如你所愿。”~
@87540 = ~“这并不让我惊讶，想想我们在地下城里已经见到的那些东西吧。”~
@87541 = ~“如你所愿。你希望我再一次加入你的队伍吗？”~
@87542 = ~“我不能否认你说的这些事实，<CHARNAME>。我的失败让我的部落和我的乌斯嘉传统蒙羞。但是我知道我可以做的更好！”~
@87543 = ~半兽人叹了口气。“如果我作为第一线战士可以在这个团体里起到更大的作用，那么我似乎得找到办法来接收自己随时会死去的命运了。”~
@87544 = ~达尔兰点点头。“我知道你说的是事实，但我一直对于自己的力量很自豪。我不会轻易死去……然而我认为没有人会。”~
@87545 = ~“我不会夸夸其谈，或者许下不切实际的诺言，<CHARNAME>。但是如果你让我再次加入你，我发誓我会尽我所能来为你效劳。”~
@87546 = ~看来这些话伤害了半兽人的自尊，不过他很快就试图隐藏起自己的失望。“如你所愿。我会在这里等你改变主意。”~
@87547 = ~半兽人似乎露出了微笑。“那么我们回山下地城吧……这次我要比前一次走的更远！”~
@87548 = ~------- 这一行必须放在队员之间说笑的结束处 ---------~
@87549 = ~“是的，达尔兰？你需要什么吗？”~
@87550 = ~“什么？你在说什么？”~
@87551 = ~“你一直在很近的看着我。不是我担心——因为我习惯别人瞪着我。但是我只是希望能确定这只不过是一个简单的注视而已。”~
@87552 = ~半兽人清了清嗓子，显然不太舒服。“我没有盯着你，沙尔文。”~
@87553 = ~吟游诗人眉头一蹙。“你没有？这有点难堪啊，达尔兰。那么为什么你不盯着我呢？难道你没有发现我的魅力吗？”~
@87554 = ~“嗯……是的，你很有魅力。但是我不……哦，也许我是的。但这并不意味着……”半兽人有点绝望的看着你。“<CHARNAME>，帮帮我。”~
@87555 = ~“是的，达尔兰。你搭了这张床，现在你得躺进去……如果你幸运的话。”她对达尔兰眨眨眼笑了，然后甩甩头发走开了。~
@87556 = ~沙尔文微笑着。“我在任何一个男人的范围之外。但有些人要更接近些。”她对达尔兰会意的眨眨眼，然后甩甩她长长的红发走开了。~
@87557 = ~半兽人爆发出一阵大笑。“夫妇？我想你的脑袋一定是在上一次战斗中被打中了，<CHARNAME>。看着我。沙尔文不在我的兴趣之内。”~
@87558 = ~“但这太有趣了！而且，他深爱着这点。你不是吗，达尔兰？”她对这个半兽人会意的眨眨眼，然后甩甩她长长的红发走开了。~
@87559 = ~半兽人羞怯的对你一笑。“也许我是盯着她看了，但你得承认她是很难被忽视的女人。”~
@87560 = ~“沙尔文，我能和你说一会话吗？我想……你在那之后感觉如何……嗯，就是在那次伏击中死去之后。”~
@87561 = ~“看起来我做的不错。没有后遗症，没有疾病影响。”她偏着头凝视达尔兰。“那对我们来说都是过去的事情了，达尔兰。”~
@87562 = ~半兽人突然低垂了目光。“是，当然。我只是……我只是觉得是我让你倒下了。我是我们这个团体的战士，我应该保护你。哦……当然，你和其他人。”~
@87563 = ~沙尔文的眉毛生气的扬了起来。“你是说我需要我自己的私人保镖？我可能没有你那么强壮，达尔兰——很少人能比得上你。但我有其他的天分可以保护自己。”~
@87564 = ~“我们不是万事都要靠蛮力和巨斧！我的魔法和吟唱是我需要的，所以别再试图照顾可怜的沙尔文。她自己能照顾自己！”~
@87565 = ~半兽人很显然被她激烈的反应吓了一跳。“我……我不是这个意思，沙尔文。我在战斗中见识过你；我知道你可以照顾自己。”~
@87566 = ~吟游诗人的眼睛里流露出顽皮的目光。“你在战斗中见识过我？你喜欢你所看到的吗？”~
@87567 = ~半兽人的脸红了。“是的……哦，我是说不，不喜欢。换句话说……嗯，只要你好我就很高兴。”沙尔文笑着走开了，半兽人在那里生气的摇着头。~
@87568 = ~“德金，你能别再那里嘟嘟囔囔吗？我都要烦死了。”~
@87569 = ~“你听见德金嘟嘟囔囔吗？你耳朵真好。也许你想听德金唱歌吧？德金的歌唱的不错哦。问问老大吧。老大喜欢听德金唱歌。”~
@87570 = ~“哦，别，别唱歌，也别嘟嘟囔囔的。我们难道不能静静的前进吗？看看这样如何？”~
@87571 = ~“好吧，达尔兰，我可以有时间给你编一首歌了。”~
@87572 = ~“你要为我编歌？”半兽人的声音里居然透出一种战斗里都未曾出现的恐惧。“什么歌？”~
@87573 = ~“你这个大块头的兽人！你需要的是热血沸腾的兽人之歌！但是……好像没有多少关于兽人的歌谣。叉子……呃……猪肉……”~
@87574 = ~“叉子和猪肉？这就是我的歌？这好像更适合于厨子而不是野蛮人。那么……呃……嗯，我想很难找到适合于兽人的歌。”~
@87575 = ~“是，如果你是个厨子就简单多了。你没想过改变一些职业吗？德金知道很多关于做饭的歌：叉子和猪肉；锅和热气；吃与肉。是吧？”~
@87576 = ~“告诉你，德金。如果我以后做个厨子，你可以写你想写关于我的任何歌。不过现在，最好别再谈你的音乐了。行吗？”~
@87577 = ~这个小鬼微笑着说，“好像听起来不错。”这个狗头人走开了，又一次开始嘟嘟囔囔。达尔兰看着他，微笑着摇摇头。~
@87578 = ~“哦，老大。你不是这个意思吧。你只是情绪不好。德金为你唱一首鼓舞士气的歌。”~
@87579 = ~“汤米……你在干什么？”~
@87580 = ~“呃？什么？做？嗯……我什么都没作！放松，我的伙伴。别太紧张了。你总是很怀疑。”~
@87581 = ~“当你在身边我总觉得很可疑，汤米。你老是看着我，半身人。我知道你做什么。你在踩我的道儿！”~
@87582 = ~“踩你的道儿？不，你弄错了。我只是……呃……我只是喜欢看你打仗。你肯定能把旁人都打到一边。我只是喜欢看我们的敌人遭难，仅此而已。”~
@87583 = ~“再把我当傻子，我就好好的让你尝尝厉害，汤米。我可知道自己身上有多少钱，如果有人偷的话……哼”~
@87584 = ~“哦，这不公平！你也许会不小心掉下它们。如果你从背包了漏点东西下来，或者把钱丢了呢？你不能怪汤米拾起来吧？谁拣到归谁，对吧？”~
@87585 = ~“谁拣到归谁？汤米，我告诉你：如果我发现你拿我的任何东西，我就狠狠的揍你，直到你还回来。”~
@87586 = ~汤米的眼睛惊讶的瞪大了。“好吧，好吧。我知道了。达尔兰不喜欢分享。切，你怎么把我和那些小罪犯混为一谈。”~
@87587 = ~“莉努，你能看看你往哪里走吗？这是今天早晨第三次你踩到我的脚后跟了。”~
@87588 = ~“哦，我很抱歉，亲爱的。我不是故意的，只是因为地面不平才绊着我了。你知道我手脚挺笨的……如果这次我不摔断腿才是奇迹呢！”~
@87589 = ~“我才不担心呢。你自有解决的办法。”~
@87590 = ~莉努耸耸肩。“是的，当这些事情到来的时候我还有点小小的运气。不过，我还是希望别笨手笨脚的。有时我希望自己姿态优雅，就像很多女士一样。”~
@87591 = ~“但如果你更优雅些，估计你就不会这么走运了。这东西都是公平的很。你的笨手笨脚只不过是长时间走运的代价罢了。”~
@87592 = ~“嗯……我以前没想到这点。谢谢，达尔兰。我现在意识到自己的笨手笨脚也是一种福气啊！”~
@87593 = ~“我很高兴你这么想。但是，别老把你的‘福气’发泄到我的脚后跟上了，求你了！”~
@87594 = ~莉努微笑着。“当然，亲爱的。我从现在起会离你远点。”~
@87595 = ~“和我一起来。”~
@87596 = ~“没关系。”~
@87597 = ~“我认为我们需要分开前进。”~
@87598 = ~“我改变主意了。和我在一起。”~
@87599 = ~“在这儿等我回来。”~
@87600 = ~“我决定了。回到杜尔南旅店去。”~
@87601 = ~“我想改变战术。”~
@87602 = ~“我现在不想改变什么。”~
@87603 = ~“如果看到陷阱，你可以不管它。”~
@87604 = ~“我要求你解除任何看到的陷阱。”~
@87605 = ~“不用再隐秘行动了。”~
@87606 = ~“在这里躲起来，直到下次战斗开始。”~
@87607 = ~“一直保持隐秘状态。”~
@87608 = ~“不用帮我打开锁起的门或者箱子。”~
@87609 = ~“如果我不能打开锁起的门或者箱子，你来帮我。”~
@87610 = ~“我想改变你和我之间的距离。”~
@87611 = ~保持远距离。~
@87612 = ~保持中距离。~
@87613 = ~靠近我。~
@87614 = ~“前进，对任何你看见的敌人发起攻击。”~
@87615 = ~“保护我，我攻击之后才能动手。”~
@87616 = ~“我想调整你的装备。”~
@87617 = ~“我希望你使用你的野蛮人狂暴。”~
@87618 = ~“再想一下，还是算了。”~
@87619 = ~“我确定。现在动手吧。”~
@87620 = ~“这是你先前要说的话吗？”~
@87621 = ~“停下来说说话。”~
@87622 = ~“好了，说完了。”~
@87623 = ~“不，没有了。”~
@87624 = ~“我只是在想你怎么样。”~
@87625 = ~“接下来你想做什么？”~
@87626 = ~“一个月之后你就会想再次离开了。”~
@87627 = ~“终于准备定居了吗？”~
@87628 = ~“你离开无冬城后做了什么？”~
@87629 = ~“我看起来担心这个吗？”~
@87630 = ~“接下来发生了什么？”~
@87631 = ~“你终于被接受了？”~
@87632 = ~“你去哪儿了？”~
@87633 = ~“真是一个奇怪的结合。”~
@87634 = ~“好像是我的命运。”~
@87635 = ~“好像你逃跑了。”~
@87636 = ~“你说你来自无冬城？”~
@87637 = ~“真有趣。我没有听说过你也参与拯救了无冬城。”~
@87638 = ~“我好像听说过你。你很有名。”~
@87639 = ~“在那之后你在无冬城一定颇受欢迎。”~
@87640 = ~“我真的不担心这个。”~
@87641 = ~“为什么不？”~
@87642 = ~“你的意思是？”~
@87643 = ~“你是在说艾瑞贝丝吧？”~
@87644 = ~“你到哪里去追求那个呢？”~
@87645 = ~“那真是一段阴暗的过去。”~
@87646 = ~“不，还没有。呆在这里。”~
@87647 = ~“是，来吧。”~
@87648 = ~“现在不。”~
@87649 = ~“是什么？”~
@87650 = ~“我没时间。”~
@87651 = ~“这里有什么呢？”~
@87652 = ~“是，这里真是可怕的地方。”~
@87653 = ~“这是挑战。证明你自己，检验你的极限。”~
@87654 = ~“贪婪。这里有很多财宝。”~
@87655 = ~“名誉。英雄在这里证明自我。”~
@87656 = ~“可能和海拉斯特的魔法有关。”~
@87657 = ~“真是疯狂。山下地城是因为它自身的特点而出名。”~
@87658 = ~“我以前没有想到过。”~
@87659 = ~“没有这么强大的魔法。”~
@87660 = ~“你的意思是？”~
@87661 = ~“我们到了。”~
@87662 = ~“我们没时间了。”~
@87663 = ~“好的——前进，半兽人。”~
@87664 = ~“什么？有什么不对吗？”~
@87665 = ~“你要离开我吗，大块头？”~
@87666 = ~“别担心，山不会塌下来。”~
@87667 = ~“也许你该回到地面上去。”~
@87668 = ~“别担心，达尔兰。一切都很正常。”~
@87669 = ~“你有幽闭恐惧症吧！”~
@87670 = ~“很显然，你不这么认为吗？”~
@87671 = ~“他为什么需要保护装置呢？”~
@87672 = ~“继续前进。”~
@87673 = ~“有人知道怎么打开这扇门吗？”~
@87674 = ~“我想我不用你的帮助也能处理这个局面。”~
@87675 = ~“守卫？你是什么意思？”~
@87676 = ~“你认为这些骷髅是来自那个部落吗？”~
@87677 = ~“你没有告诉我想知道的事情。”~
@87678 = ~“谢谢你的警告。继续前进。”~
@87679 = ~“你认为这些骷髅会复生？”~
@87680 = ~“没关系。我不想再讨论这个了。”~
@87681 = ~“你继续那样等死吧，这并没有帮助。”~
@87682 = ~“你每次战斗都在前面。你想怎么样？”~
@87683 = ~“山下地城是个危险的地方。死亡似乎是预料之中的。”~
@87684 = ~“留在这里，现在。”~
@87685 = ~“我希望你再次加入我的队伍。”~
@87686 = ~“别担心。”~
@87687 = ~“是你盯着看的。你自己搞定这问题吧。”~
@87688 = ~“忘了她吧，达尔兰。她不是你那种类型的人。”~
@87689 = ~“问题是什么？我认为你们两个不错。”~
@87690 = ~“沙尔文，别再作弄达尔兰了。”~
@87691 = ~“也许现在不是唱歌的时候，德金。”~
@87692 = ~“对。德金，为什么你现在不唱呢？”~
@87693 = ~“我不！”~
@87694 = ~“你现在带着德金，好吧？”~
@87695 = ~---------- Random Pop-Ups Start Here ------------~
@87696 = ~“不，老大，不！别这么说！德金不想走……德金希望继续冒险！”~
@87697 = ~“综合考虑，德金认为这样最好。”~
@87698 = ~“嗯……好吧，德金留在这儿。但你要快点回来，老大！德金看不到你的冒险就没法写你的传奇故事了！”~
@87699 = ~“嗯……好吧，德金自己找路回去。不过我不喜欢这样。”~
@87700 = ~“你想要德金做什么？”~
@87701 = ~“噢！但这会是精彩的部分！哦好吧。”~
@87702 = ~“大英雄允许忠实的狗头人施放他希望的魔法了。呼咂！”~
@87703 = ~“你，嗯……不想我施放坏魔法？好～老大，听你的。”~
@87704 = ~“你要德金施放坏魔法？收到，老大。”~
@87705 = ~“好，老大。德金给你留下陷阱。”~
@87706 = ~“嗯……德金会尽力解除陷阱的，绝对。”~
@87707 = ~“德金停下来了，好吧。”~
@87708 = ~“好，德金会像小老鼠一样……除非他碰到下一个对手！喔！”~
@87709 = ~“德金现在变成了一个小老鼠。吱吱！”~
@87710 = ~“好吧。不管怎样，又再给德金记录老大传奇故事的机会了。”~
@87711 = ~“是，德金能做。没有门能扛的住德金的手艺！哈哈！”~
@87712 = ~“好。嗯……你需要德金做什么？”~
@87713 = ~“搞定！哈哈！”~
@87714 = ~“你的意思是……等到他们靠近了在动手？嗯……好吧。我是勇敢的德金……我是勇敢的德金……”~
@87715 = ~“你要德金保护你？好！德金现在是官方卫士了！”~
@87716 = ~“哦。好，德金为你打开了包袱。唔……不过，不太干净是吧。别管那些臭袜子了……”~
@87717 = ~“唔……好吧。德金会在你的包袱里翻翻，看看能不能找到些你还不了解的东西。继续……”~
@87718 = ~“喔！你想听德金唱歌！德金很高兴为老大唱歌！”~
@87719 = ~“你要德金施展法术？你想让德金施放什么法术呢？”~
@87720 = ~“你想让德金施放什么？”~
@87721 = ~“你确定？”~
@87722 = ~“好。向谁施放？”~
@87723 = ~“你说的大怪物那里是什么？”~
@87724 = ~“也许，德金在这个要塞里感觉不怎么样。”~
@87725 = ~“你想和德金谈谈？你想谈什么呢，老大？”~
@87726 = ~“老大，你还想谈什么？”~
@87727 = ~“德金累了。脚都疼了，后背也受伤了。小德金觉得好像呆在贝壳里滚来滚去。啊，总的来说还是不错。”~
@87728 = ~“嗯……还想说什么呢，老大？”~
@87729 = ~“德金大概有点消化不良了。”[打嗝！]“呃……就是。”~
@87730 = ~“嗯。很好。德金想不起把墨水放在哪儿了。如果没有墨水怎么写呢？”~
@87731 = ~“很好。你怎么样，老大。你也还好吗？”~
@87732 = ~“德金希望和老大一起经历这个伟大的冒险！嗯……这意味着每件事都很刺激。”~
@87733 = ~“嗯……德金还好。除了德金记不起你怎么写‘多余的’的。”~
@87734 = ~“德金忙着写传奇故事的最新一章。等着看吧，老大！肯定比第一章精彩的多。”~
@87735 = ~“嗯……好吧，德金猜到了，除了德金看不到太多。你在哪里，老大？”~
@87736 = ~“德金感到有些擦伤，但是还好。德金比他看起来要坚强的多。”~
@87737 = ~“德金伤的很厉害。冒险都是这样的吗？处处流血的时候再写传奇故事可是够困难的。”~
@87738 = ~“哦……德金感觉挺糟糕的。伤得很重。也许我们现在可以休息一下？”~
@87739 = ~“德金觉得自己中毒了。老是打嗝而且皮肤象火烧一样。老主人有时候觉得给德金下药挺好玩……德金可不这么认为。”~
@87740 = ~“嗯……德金感觉不太好。长了好多疹子，好像到处都是。唉。”~
@87741 = ~“你想谈谈德金的训练吗？好的，老大。”~
@87742 = ~“德金一直希望成为红龙龙脉术士。这可很困难……但是德金觉得越来越强壮了。但愿老主人是对的。你希望德金做些别的事情吗？”~
@87743 = ~“嗯，现在德金想做个吟游诗人了。你希望德金做些别的事情吗？”~
@87744 = ~“好的，老大。也许德金该继续努力做红龙龙脉术士，不过他不会停止做吟游诗人的努力。”~
@87745 = ~“德金现在也在努力成为和你们一样的红龙龙脉术士，还有吟游诗人，就像和你提起过的一样。如果你希望德金做其他的事情，告诉我，老大。”~
@87746 = ~“你说怎么样就怎么样，老大。”~
@87747 = ~“好的，老大。德金会努力。”~
@87748 = ~“好的，老大。德金觉得没问题。也许德金以后会试着去做红龙龙脉术士。”~
@87749 = ~“你的意思是在德金写完下一本书之后？”~
@87750 = ~“在德金把下一本书卖个好价钱之后？”~
@87751 = ~“德金走进出版社，如果德金没有从那个老板那里拿到足够的报酬，他可就麻烦了！德金不想胡说。而且，德金要版税。”~
@87752 = ~“出书后，德金也许会回到耐色山脉。”~
@87753 = ~“德金认为他可以让狗头人部落带出深山，和人类共同生活。德金认为他可以让部落不再卑微而肮脏了。”~
@87754 = ~“这太吸引德金了。但是……德金还是继续了。只是因为第一次做的不好不一定意味这德金不该再次常识。”~
@87755 = ~“德金也许是第一个来到开化土地的狗头人。德金觉得自己不会是唯一想来的狗头人。他肯定也不会是最后一个试图这样做的狗头人。”~
@87756 = ~“也许这挺难。也许又很多狗头人会对抗德金。但是德金还是会努力，一直。”~
@87757 = ~“好主意，老大。继续前进。”~
@87758 = ~“德金不这么想，但是谢谢你。嗯，如果没你不可能，老大。德金永远不会忘记你。”~
@87759 = ~“谢谢，老大。如果没有你不可能。德金永远不会忘记你。”~
@87760 = ~“但是……冒险还没有结束，老大。继续前进吧！”~
@87761 = ~“德金也希望如此。德金认为每个人都能改变。也许最初，只有德金告诉他们才能不那样。也许以后因为他们希望才不会那样做。”~
@87762 = ~“嗯……德金没有多少故事。但是为了你，老大！让德金想想……”~
@87763 = ~“我们注定如此！注定注定注定注定注定！注定注定注定注定注定！注定注定注定注定注定！注定注定注定注定注定！注定注定注定注定注～定！”~
@87764 = ~“注定！！注定注定注定注定注定！！注～定！”~
@87765 = ~“嗯……咕哝……咕哝咕哝……德金忘词了……啦特哒……”~
@87766 = ~“哦～！德金在唱歌，耶！德金唱歌！他忘记是怎么样的了，但没有人知道，因为德金在唱歌！！”~
@87767 = ~“因为这是无……无冬之夜！没有人会从利爪下拯救你！
你知道这里是无……无冬之夜！
你为了自己的生命而战，黑夜杀手，黑夜惊悸！”~
@87768 = ~“开……开始播报新闻！德金今天走了！德金希望成为其中的一份子！深水城！深水城！”~
@87769 = ~“我们注定如此！咚咚咚咚咚！耶，我们注定如此！咚咚咚咚咚！叭叭——叭！我们都注定如此！”~
@87770 = ~“注定——注定注定！注定注定注定注定！听到了吗？！！！注定！！”~
@87771 = ~“幽暗地域！幽暗地域！友好的、和善的幽暗地域！遍地蛛网！如果你被缠住，必将丧命！当心！当心幽暗地域！”~
@87772 = ~“我们来了！哒—当！我和老大，来干掉卓尔女神！哒—当！！”~
@87773 = ~“德金为你演唱注定之歌！注定注定注定！注定！注定！注定注定注定！注定！”~
@87774 = ~德金抓抓脑袋。“德金来参加真正的冒险了。所有都要靠自己。”~
@87775 = ~“就在德金离开你去深水城之前。德金正在路上，他看到黑夜里的那些小小的村落。德金很饿所以他溜了进去，这可不是他常做的事情。”~
@87776 = ~“德金觉得村子里的人大概很少看过狗头人，除非有什么坏事。他们经常在德金有机会解释前，就把德金赶出来。”~
@87777 = ~“但是大笨熊在前天晚上就吃光了德金的食物，所以德金的肚子都开始叫了。他想要些食物，否则会饿的。”~
@87778 = ~“这很奇怪。德金把头伸进了酒馆的门，问是否可以让他进去，一个胖女人说好吧。她把德金带进来，给他大吃了一顿，甚至还给他准备了一个房间。”~
@87779 = ~“她以前没有见过狗头人，并没有觉得德金很奇怪。后来当其他人进来之后，他们变得很烦……但那个胖女人阻止了他们。她说德金是个绅士，所以他们安静了。”~
@87780 = ~“是。德金很幸运。胖女人独自经营这个旅馆，所以德金留下来一段时间帮她做些家务琐事。村子里的每个人都叫她妈妈，德金也是。”~
@87781 = ~“德金甚至想过要留下来陪妈妈，但没有做到。”令人惊讶的，德金沉默了一会，一颗眼泪流了下来，他赶紧把它擦去。“狼群……他们在一天晚上冲入了村子，妈妈在外面，他们杀害了她。”~
@87782 = ~“开始，村民认为是德金杀了妈妈。不过后来在仔细检查后他们知道是恶狼干的。村长提供了赏金奖赏那些追捕和消灭恶狼的人。”~
@87783 = ~“村里没有人去。他们说，恶狼又大又危险。所以德金出手了。”德金的声音因为愤怒而冷酷了很多。“他不仅仅悲伤而且很愤怒。妈妈绝不该这么死去！所以他出发找到了狼穴，把那些恶狼杀了个一干二净。”~
@87784 = ~“德金也伤的很重，不过他很高兴可以干掉他们。感觉很好。德金为妈妈报了仇，成为了真正的冒险者……村长如同许诺的那样为德金颁发了赏金。”~
@87785 = ~“妈妈的儿子继承了这个旅馆，他不喜欢德金……村子里也没有人真正相信德金，即使是他消灭了恶狼。德金随后去了深水城。”~
@87786 = ~德金擦去了脸上的泪水，沉默了一会。“另外……妈妈再也没有在那儿。她向德金提到了你。德金一直都很想见到老大……”~
@87787 = ~“德金发现不和老大一起旅行很困难。这不表示德金没有试过。”~
@87788 = ~“德金和老大一起很快乐，现在，是吧？我们继续冒险吧！”~
@87789 = ~“德金睡着了。他不知道妈妈在外面……即使他知道，他也睡着了，什么也听不到。”~
@87790 = ~“德金对妈妈的死很痛苦。她对德金很好，甚至说德金就像她儿子一样。”~
@87791 = ~“她是到外屋去。德金觉得这个时间太糟糕了。”~
@87792 = ~“德金遇见过卓尔，就在整个冒险开始之前。”~
@87793 = ~“不。这个卓尔实际上是在和德金说话。”~
@87794 = ~德金想了一会，试图记起来。“那是在深水城的市场里……德金象疯了一样到处乱跑因为他把鲁特琴忘在了一个地方，而他又不知道。而且那是德金唯一拥有的鲁特琴。”~
@87795 = ~“你没有注意？那不重要，老大。重要的是德金在乱跑而且没有注意他跑的方向。”~
@87796 = ~“德金转过拐角，然后‘砰’的一声！他撞到了一个站在那里的大家伙身上。不过他不仅仅是个大家伙，它是一个黑暗精灵。”~
@87797 = ~“只有这些人才会有黑皮肤、白头发和尖利的眼睛。你还能认为是什么呢，老大？”~
@87798 = ~“总之，德金躺在那里，吓晕了，那时卓尔转过身来，拔出了两柄巨大的利剑。他以为德金在攻击他！他准备干掉德金，所以德金尽力尖叫起来！”~
@87799 = ~“这使卓尔停了下来，德金利用这个机会拼命的道歉。卓尔说没关系，他是因为我是狗头人而认为我是个坏家伙……而且在这个城市里见到狗头人很奇怪。”~
@87800 = ~“他身边有一个胖胖的矮人，他笑着拍拍卓尔的后背，说他们所有人都应该了解的更多些。德金不知道那句话的意思，但是卓尔放走了德金。”~
@87801 = ~“德金也非常惊讶。”~
@87802 = ~“呒……矮人提到了。好像是什么关于‘烦躁’或者‘小东西’或者……或者“滚开”，或者其他东西。”~
@87803 = ~“德金同意。不过，对于卓尔他是那种神秘的人。”~
@87804 = ~德金使劲摸着脸，拼命的想着。“德金曾经遇到过另一条龙。”~
@87805 = ~“那是一条漂亮、巨大的龙。金色的，德金记得是。实际上，德金是在深水城遇见的它。”~
@87806 = ~“是。他装成了一个人。你知道龙这么做过吗？他们可以变成任何需要的样子。老主人总是变成个人的样子。”~
@87807 = ~“老主人只是为了写书才那么做，他这么说的。老主人过去常常说他不喜欢变成人的样子，但是他说这有它的好处。不过，德金知道他并没有说实话。”~
@87808 = ~“老主人曾经有一次变成人去了山顶村，德金跟着他一起。这只是德金第二次走出洞穴，所以德金很紧张。”~
@87809 = ~“德金感到奇怪的就是老主人为什么要去人类的城镇。”德金耸耸肩，似乎很迷惑，“所以德金躲了起来，看着老主人进入了旅店。”~
@87810 = ~“当德金透过窗户偷看，他看到老主人在吃一个大馅饼。老主人脸上笑得很开心，他看起来非常高兴！然后，老主人离开了城镇回到了家里。”~
@87811 = ~“老主人非常喜欢馅饼，德金认为。不过，德金并不知道是哪种。偶尔德金会觉得奇怪当时没有和老主人谈过这个。”~
@87812 = ~“哦，他只是想知道德金是否明白时间。他甚至没有告诉德金他自己是一条龙，但是德金知道。德金知道。”~
@87813 = ~“是的，老大。关于老主人喜欢馅饼。”~
@87814 = ~“嗯……德金也注意到了。德金认为他们很……很红。”~
@87815 = ~“他们不太大。也许德金飞了一小段，但是不能确定。德金并不太关心那事。”~
@87816 = ~“是的……有趣。德金现在看起来很奇怪。尽管如此……德金不确定他是否高兴。”~
@87817 = ~“德金在想或许他有白色的翅膀。也许，就像老主人一样。”~
@87818 = ~“当老主人说德金得到龙穴，他是指象老主人那样的白色龙血。德金不太确定。”~
@87819 = ~“不，德金喜欢做龙脉术士。德金觉得强大……也许从第一次德金离开老主人。德金认为他可以做所有的事情！”~
@87820 = ~“德金只是，嗯……想像老主人一样。”~
@87821 = ~“呵呵。德金知道那很愚蠢。德金很快就克服了……他只是，嗯，有点怀念老主人了。”~
@87822 = ~德金羞愧的低下头。“你是对的。德金不该这么吹毛求疵。对不起，老大。”~
@87823 = ~“你这样认为？”德金再一次感激地看了看他的双翼。“或许你是对的。谢谢，老大！”~
@87824 = ~“你认为现在德金是龙脉术士？耶，这太不同了。德金有时真的感觉很奇怪。”~
@87825 = ~“哦，有时德金会做奇怪的梦。他四处飞翔去找牛来吃。德金觉得很强壮、愤怒甚至会发出恶臭的呼吸。”~
@87826 = ~“当德金醒来，有时他的皮肤非常烫。他看着老大，甚至有时会想‘哈哈，<RACE>小东西！’即使德金并不真这么想。”~
@87827 = ~“你别担心，老大。德金一切都控制的挺好，实际上……这让德金感觉很好。”~
@87828 = ~“德金只是希望不会打嗝，嗯，在不合适的时候吐火或者其他东西。德金不想烧焦老大或者其他东西……”~
@87829 = ~“或许有一天德金会强壮，他可以飞，象老主人那样做事情？那让他成为超级德金！呵呵！”~
@87830 = ~“谢谢，老大！”~
@87831 = ~“呵呵……对，老大。德金记得呢。”~
@87832 = ~“嗯……德金的意思是和你谈谈那个……”~
@87833 = ~“老主人曾经告诉德金他有龙血，就在他体内非常强大。德金不明白那意味着什么……德金瘦小、虚弱，不会吐火或者别的东西。”~
@87834 = ~“但是有时候……有时候德金战斗的时候会感到心跳的很快，而且他感觉……强大。你认为这是不是有点愚蠢呢，老大？”~
@87835 = ~“嗯……德金认为或许他会试试看，嗯，试着成为龙脉术士。老主人从来没有和德金谈过这个，但是……或许挺不错的？”~
@87836 = ~“这要看你了，老大。德金按照你说的来做。如果你希望德金做个忠实的吟游诗人，那么德金会高兴的去完成的。”~
@87837 = ~“好的。德金会专心去做的。谢谢，老大。”~
@87838 = ~“好的。德金不想让你失望，老大。也许，以后再去做龙脉术士吧。”~
@87839 = ~“那么德金现在去做龙脉术士吧，嗯，或许以后再去做个吟游诗人吧。德金希望可以。如果不行你告诉我，老大。”~
@87840 = ~“德金首先来到了深水城，然后他出版了书。那使德金挣了一点钱，这样他可以多出去旅行……然而说实话，德金从没有走这么远。”~
@87841 = ~“那……那不没有象想像的那样解决德金的问题。德金乐意把伟大、壮丽的故事卖给出版商……然手德金只得到了两千或者三千金币。”~
@87842 = ~他慢慢的点点头，看来有点窘迫。“德金知道。德金只是……希望自己来。德金总是让老大来留心德金，德金得试试。即便它不成功。”~
@87843 = ~“当出版商为了伟大、壮丽的故事而交给德金报酬时，德金认为自己已经完成了。德金认为两、三千金币就可以了。”~
@87844 = ~德金抬头看看你，他笑得很开心。“你？那让德金很高兴。他希望能出名，有很多人会阅读并了解关于老大的冒险的传奇故事。”~
@87845 = ~“德金不是为钱而做的。出版商不会给德金多少钱……也许，两千或者三千金币，德金记不太清楚了。”~
@87846 = ~“哦，或许那没有多少。德金大概得到了两千或者三千金币。”~
@87847 = ~“德金希望能给你预备点钱，老大。说实话，德金已经作了。只不过……只不过还没多久。很多人都想要德金的钱，德金不知道该怎么去花。”~
@87848 = ~“德金不太清楚。对于德金那好像是很多钱，比他从前见到的都要多。”~
@87849 = ~“总之，德金在深水城里没待多久。那儿有很多人都想要德金的钱，而德金却不知道该怎么花钱。”~
@87850 = ~“在德金意识到人们欺骗他之前，他已经为每件东西都付了比实际高得多的价格。德金想找人控诉，可是没有人关心他，因为他只是个小狗头人。”~
@87851 = ~“德金也试过，但是他不可能通过战斗或者施放魔法来让那些人对他友善。如果德金真的那么做，人们就会认为德金是个邪恶的狗头人，然后他就会被攻击……或许会被杀掉。”~
@87852 = ~“甚至连城市的卫兵都没有帮助德金。德金想跟他们说话，但是他们只是追着德金试图干掉他……德金差点丧命，不过还是逃脱了。狗头人在那里不受欢迎。”~
@87853 = ~“老主人说过吟游诗人应该是迷人和老练的。德金不是个很好的吟游诗人。德金用光了所有的钱。德金在肮脏的酒馆里演奏音乐，可是没人听，没人认为德金迷人。”~
@87854 = ~“德金不太了解文明社会，但是德金不是哑巴。德金知道为什么人们那么看待狗头人……这是事实。狗头人卑鄙而污秽。”~
@87855 = ~“如果德金是个哑巴，他会认为所有人都是卑鄙和污秽的，就像所有人那样认为狗头人一样。如果有像你一样的人，那么还是有其他人。德金只是想找到他们。”~
@87856 = ~“德金要证明给他们看德金是个真正的吟游诗人。总有一天所有人都会知道德金的。”~
@87857 = ~德金笑了，露出满口尖利的牙齿。“我同意，老大。出发冒险！”~
@87858 = ~德金好像一下子噎住了。“谢谢，老大。那对于小德金来说有点太多了。”~
@87859 = ~德金笑了，露出满口尖利的牙齿。“谢谢，老大！你是最棒的！”~
@87860 = ~“你这么说真好，老大。不过，德金知道没有多少人像你一样。”~
@87861 = ~“不。德金不想放弃，老大。德金如果放弃了就不会来这里了。”~
@87862 = ~“你不认为小德金有点虚弱？”~
@87863 = ~“那不同，老大。当德金和你冒险，他可以战斗并施放魔法。不过当德金在城市里，他就不能做了。”~
@87864 = ~“德金也听说是那样的。出版商只是付德金他买书的钱，不过……德金知道的不多。德金那时认为有很多钱的。”~
@87865 = ~德金含糊的耸耸肩。“出版商只是付德金他买书的钱，德金知道的不多。”~
@87866 = ~“建造山下地城的法师？德金只是从故事里了解一点点而已。”~
@87867 = ~“你是说，你要检验德金？哦！德金首先希望他有时间来研究！”~
@87868 = ~“呃……嗯，他的全名是黑袍海拉斯特，德金是这么记得的。他非常老了。有人说他比伊尔明斯特都要老。”~
@87869 = ~“德金曾经读过一本书，里面说海拉斯特在深水城建立之前就来到了这里。他带了七个徒弟，然后建造了塔楼……因为那是大法师经常做的事情。”~
@87870 = ~“嗯，书里面说海拉斯特是个小个子，即使在那时就有点疯狂了。徒弟们看到他的次数不多，因为他躲在塔楼里。他把塔楼建造的越来越深，希望躲藏起来并和恶魔对话。”~
@87871 = ~“然后有一天海拉斯特把塔挖的太深了，他进入了古代矮人的矿坑。那里已经没有矮人了……只有很多怪物。所以海拉斯特进入了矿坑，从此以后再也没有见到他，那里就是山下地城。”~
@87872 = ~“发生的不多。海拉斯特持续着疯狂，山下地城一直在危险。然后发生了这个。老大，这暗示着传奇般的冒险。”~
@87873 = ~“那就是德金了解海拉斯特的全部。德金希望那能帮得上忙。”~
@87874 = ~“海拉斯特不让怪物离开，所以深水城没有遇到过危险。德金认为深水城可能很久很久都没有听说过山下地城和海拉斯特了。”~
@87875 = ~“杜尔南是第一批从山下地城活着返回的冒险者之一。实际上，德金读的书就是杜尔南的同伴写得……但是德金忘记他的名字了。”~
@87876 = ~“有些，或许。海拉斯特一直在召唤怪物，设置迷宫、陷阱还有洞穴。也许是为了保护他，或者是为了杀人？德金不知道。”~
@87877 = ~“你知道，伊尔明斯特曾经说过，山下地城是冒险者在费伦最大的坟场。德金怀疑那是否是对的？”~
@87878 = ~“不在了。几个世纪以来，海拉斯特不停的建造和改变这个地底世界。他们说他总在改变布局，只是为了保证安全，而且他经常穿越墙壁。”~
@87879 = ~“那是个不同的故事。如果德金记得的话，他们都被卓尔杀了……所以当海拉斯特来的时候，那里已经成为一个大的地下城。有些故事说海拉斯特杀死了所有他找到的卓尔。或许他们对他发疯吧？”~
@87880 = ~“德金猜想他有点太疯狂了。他陷入了妄想，认为所有人都想干掉他。没人能说清楚为什么海拉斯特会变成这个样子。”~
@87881 = ~“或许，超过一千年？老大，那是个传奇。过时了就没那么伟大了，你知道。”~
@87882 = ~“不再了。德金相信“敞开大门”旅馆的地点就是塔曾经坐落的地方。那就是为什么那里有通往山下地城的入口。”~
@87883 = ~“德金不这么认为。书上说海拉斯特杀死了很多徒弟。或许，有些人跟他下到了山下地城，但是没有人知道他们发生了什么。”~
@87884 = ~“啊！德金……心……”~
@87885 = ~“德金崇拜老大走过的大地！真的！不要对德金这么凶！”~
@87886 = ~“德金真的很抱歉！！你不能原料小德金吗？”他纯洁得对你眨着眼睛。~
@87887 = ~“德金在老大面前只是一条小虫！原谅小德金！”~
@87888 = ~“德金得到教训了，他发誓！德金会做好的，会的！”~
@87889 = ~“耶！德金真高兴！德金从现在起会努力的，德金发誓！”~
@87890 = ~“啊！不要伤害德金！德金抱歉，他会做好的！”~
@87891 = ~“哦！的金不想惹麻烦，老大！原谅德金吧！”~
@87892 = ~“德金不值！德金不值！”~
@87893 = ~“为什么要这样对德金？德金很抱歉！真的抱歉！”~
@87894 = ~“哦。好吧……德金或许以后再和你说。”~
@87895 = ~“德金只是……想说你是德金遇到过的最好的朋友。”~
@87896 = ~“或许，老大否认了，但是德金知道老大真的关心。否则德金为什么会在这里呢？”~
@87897 = ~“没有人象老大这样给德金机会……而且你给了德金两次机会！德金会为此感谢老大的。”~
@87898 = ~“好，老大。德金不再会用这种乱七八糟的事情来烦老大了。”~
@87899 = ~“德金有吗？”~
@87900 = ~“哦，当然！德金要完成老大伟大、壮丽的传奇！它会很伟大的，老大，等着瞧吧！”~
@87901 = ~“嘿嘿……德金也同意。如果他让老大高兴，那就让德金很高兴了。”~
@87902 = ~“德金不……不那么想，但是或许老大是对的。德金是个强大的狗头人！也许很快德金就有自己的传奇故事了！谢谢，老大。”~
@87903 = ~“嘿……你让德金不好意思了，老大。那可不容易，想想德金长出鳞片的样子。哈哈！”~
@87904 = ~“呃……没什么。老大，忘了德金说的吧。”~
@87905 = ~“呃……不，还好。德金还好。”~
@87906 = ~“不，不……别担心德金。德金没什么要说的。”~
@87907 = ~“嗯，也许……不。不，不，德金会好的。继续冒险吧，老大。”~
@87908 = ~“啊！！好的，老大，好的！德金要去浴室了！！能停一会吗？！？！”~
@87909 = ~“当书写完的时候德金该给它起个什么名字呢？”~
@87910 = ~“嗯……也许德金有主意。但是德金认为他或许这次该问老大。”~
@87911 = ~“这本书是关于老大和他的伟大、壮丽的冒险历程！老大真的没有什么意见吗？”~
@87912 = ~“嗯。也许德金该把它叫做‘老大的冒险’？真是太俏皮了！”~
@87913 = ~“呃。别提醒德金了。德金恨那个家伙！德金总有一天会追捕到他，然后在他的屁股上狠狠踢上一脚！哼！”~
@87914 = ~“但是老大或许是对的。哦好吧。”~
@87915 = ~“那时德金上次想起的名字。嗯……也许是‘<CHARNAME>·<CHARNAME>的冒险，大结局’？没人以前这么叫过哦。”~
@87916 = ~“哦。呃……德金没想过要给它起个这么愚蠢的名字。哈哈……”他拿出了笔记本，开始快速的划掉一些东西。~
@87917 = ~“天啊。德金也想的一样。德金和老大居然英雄所见略同啊？”~
@87918 = ~“哈哈。老大现在是个喜剧演员了，德金发现了。”~
@87919 = ~“德金在写传奇故事……德金刚才在想……”~
@87920 = ~“德金想知道老大打算怎么办，呃……你想被褥和描述呢？”~
@87921 = ~“好~，老大。但是如果人们觉得你不像德金写的这样，你不会哭着来找德金吧。”~
@87922 = ~“呃……德金也许可以，但是他听说<RACE>族人很自负……”~
@87923 = ~“呃……德金也许可以，但是他听说<RACE>族人对于这种东西很敏感……”~
@87924 = ~“但是……德金和你一同旅行的全部目的啊，老大！德金在这里要记录你的旅行！把你的伟大告知全世界！你不想谈谈自己该如何被描写吗？”~
@87925 = ~“嗯……我说你是一个<RACE>帅哥。当我不称你为老大时，我总是这么叫你的。”~
@87926 = ~“嗯……现在德金该怎么不惹麻烦的描写你呢……”~
@87927 = ~“好的，德金认为他得到了暗示，老大。谢谢你的帮忙。”~
@87928 = ~“说实话？当德金说实话的时候，人们总会疯狂起来。不，德金认为他最好还是说谎安全一些。谢谢，老大。”~
@87929 = ~“真的？但是没人会从那种描写里认出你来。哦好，德金继续试试看……”~
@87930 = ~“嗯……我说你是一个<RACE>美女。当我不称你为老大时，我总是这么叫你的。”~
@87931 = ~“你还记得老主人吗？”~
@87932 = ~“德金记得你告诉德金他是自由的时候。他几乎不相信老主人让他走了。德金非常高兴。”~
@87933 = ~“德金只是想知道……当你和老主人说话的时候，他提起德金了吗？”~
@87934 = ~“哦。有时德金想念老主人，但是那不是德金想谈论的。”~
@87935 = ~“老主人曾经告诉过德金有很多龙的血脉。德金不太确定……德金既不大也不强壮，他也不会吐火或者别的东西。”~
@87936 = ~“也许那样还好……除非德金总在吐火。那就很难吃东西了。”~
@87937 = ~“不，老主人很少开玩笑。不会和德金。可是，很多时间这完全没有意义。”~
@87938 = ~“也许。德金真的不这么认为，但是有时候他会感到怀疑。”~
@87939 = ~“老主人有一次告诉德金，说德金有很多龙的血脉。但是他没有说更多了……现在德金经历了很多变化……”~
@87940 = ~“所以德金怀疑是否老主人并没有说过德金的事情？没有象那样的事情？”~
@87941 = ~“哦。德金希望……嗯，德金只想能好好利用它。”~
@87942 = ~“哦。德金……德金会试试看，老大。”~
@87943 = ~“那么你不记得老主人说过什么了？一点都没有？”~
@87944 = ~“是的，德金记得你告所过他。德金有点难过……不过德金知道不是这样的话老主人不会让他走的。”~
@87945 = ~“哦。德金希望或许你会记得。那不重要。”~
@87946 = ~“呃……如果德金在书里写他不喜欢深水城，你不会反对吧？”~
@87947 = ~“当他和老主人在一起的时候，德金读了很多深水城的书……有很多书，真的很多！德金把它们都读了！他一直惊讶会有这么多人住在一个地方！”~
@87948 = ~“所以当德金离开山顶村，他就先去了深水城。德金来到了那座大城市！如果德金在那里能够成功，那德金在哪里都能成功！”~
@87949 = ~德金拖着脚。“德金在那里失败了。深水城的每个人对小德金都很吝啬。”~
@87950 = ~“对不起，老大。德金只是……想从书里得到。”~
@87951 = ~“他们举着干草叉追德金，派卫兵来追捕德金。德金被从很多旅馆里赶了出来……在德金最后找到一家半兽人同意让他住在马厩里之前，他在冰冷的水沟里睡了三天。”~
@87952 = ~“德金只是希望……也许深水城还有对他好的人。就像你。”~
@87953 = ~“你释放了德金。那是为德金做的最好的事情了。”~
@87954 = ~“呵呵……老大，你这么说，但是德金知道你不是那个意思。”~
@87955 = ~“也许，还不太糟糕。最后人们停止了追逐德金。德金出版了老大的伟大传奇故事，就像他说得那样。”~
@87956 = ~“但是德金还没有经历他所盼望的伟大冒险。世界很大，而德金很渺小。也许下次德金会从一个小村落开始，并从那里到达深水城？”~
@87957 = ~“德金对卓尔了解的不多。老大了解卓尔吗？”~
@87958 = ~“呃，德金对于卓尔有些问题。也许老大知道答案？”~
@87959 = ~“哦。好的。总之，那并不太重要。”~
@87960 = ~“呃……很多地面生物很久以来都生活在地下，得不到阳光，他们变得灰暗和苍白。德金的部落有时候会去抓奴隶，他们都是这个样子。”~
@87961 = ~“德金听说卓尔曾经生活在地面上。为什么他们没有变的灰暗和苍白？为什么他们还有黑色皮肤呢？”~
@87962 = ~“为什么他们有白头发？有些人把他们吓得够呛吗？这对于小德金都很奇怪。”~
@87963 = ~“或许你是对的老大。德金一直想他们应该是灰色的，就像矮人和侏儒一样……但是德金对于这些事情了解得很少。真奇怪。”~
@87964 = ~“噢……德金要把它记下来！谢谢，老大！”~
@87965 = ~“但是……有些<RACE>家伙有点邪恶……”~
@87966 = ~“哦。德金没有想到那是一个规矩……谢谢，老大。”~
@87967 = ~“德金看到过一次。但是老主人很快就吃了他。他说卓尔非常非常好吃。”~
@87968 = ~“是的。老主人说黑肉是最好的。”~
@87969 = ~“哦？德金不知道那很重要。”~
@87970 = ~“呃……是的。当然德金知道！唉……你怎么想德金呢，老大？哈哈……”~
@87971 = ~“也许，你认为德金该换个名字？”~
@87972 = ~“真的？即便德金把名字变成‘有史以来最伟大的狗头人德金’也不会吧？老大能这么叫德金吗？”~
@87973 = ~“哦。好的。对不起，老大。”~
@87974 = ~“啊。德金会叫你‘有史以来最伟大的老大’。如果你要德金这么叫的话。”~
@87975 = ~“哈哈！老大真搞笑！”~
@87976 = ~“德金在想，他也许需要一个更好的名字，好用来写在德金的书上。”~
@87977 = ~“但是德金该改成什么呢？也许，一些更有男子气的？”~
@87978 = ~“德金喜欢老大的名字……但是那好像不太适合小德金。如果德金作了，你不会为此发抖吧……”~
@87979 = ~“呃……那的确不是卷舌音。也许德金该把自己叫做唐纳德？”~
@87980 = ~“真的？德金不太确定。‘唐纳德·鳞歌者’……呃。也许德金还是以后再说吧……”~
@87981 = ~“好的。德金再考虑考虑吧，老大。”~
@87982 = ~“德金好像在什么书上读到过。呃。也许德金想的有点多了……”~
@87983 = ~“你那样认为？好的。也许德金考虑的太多了。谢谢老大！”~
@87984 = ~“哦，听起来有点……有点……德金。人们拿起书，皱着鼻子大声念出德金的名字，也许他们还以为是只小鸡写的书呢。”~
@87985 = ~“嗯。哈哈。老大真有趣。那德金以后再问你吧，在你不再像演滑稽的巨人的时候。”~
@87986 = ~“德金有时候怀疑……你曾经怀念过那个老矮人吗？他的名字是？乔甘大师？”~
@87987 = ~“哦。德金只是怀疑。德金有时候会怀念老主人。”~
@87988 = ~“是的，那就是德金想要的。最终，德金得到了所有他想要的东西。”~
@87989 = ~“并不都是。有时候老主人对德金挺好的，他教了所有德金现在知道的东西。那就是为什么德金为老主人服侍了那么久的原因……德金欠他。的。”~
@87990 = ~“不。德金不希望回到冰穴去……那没有德金的东西。德金也不想再去冒成为奴隶的危险了。”~
@87991 = ~“有时德金只想去把这些事情告诉那时认识德金的人，这样他们可以看到德金现在的样子。这样德金就可以和人分享他的变化了。”~
@87992 = ~“德金认为老主人会为德金高兴得。嗯……老大认为乔甘大师会为老大高兴吗？”~
@87993 = ~“哦。对不起，老大。德金不再说了。”~
@87994 = ~“德金这么认为。是的，德金很确定乔甘大师会为老大高兴的。”~
@87995 = ~“不？哦。不知道为什么，德金发现那很悲伤。哦，好的。”~
@87996 = ~“我们怎么分配我们找到的财宝呢？你会一扫而空？还是德金也可能得到一点呢？”~
@87997 = ~“那么……你想让德金成为筹码？”~
@87998 = ~“哦。那么德金现在被雇下来了。德金理解。”德金拿出了他的笔记本，藏着不让你看到，生气地写了几句话。~
@87999 = ~“好的……德金听说冒险者在手里有筹码的时候常常会成功。德金*可以*在找到宝藏的时候呼唤筹码。”~
@88000 = ~德金咧开嘴大笑着，露出了满口尖利的牙齿。“你对小德金太好了，老大！这就是筹码！”~
@88001 = ~“但是……德金想做个合适的冒险者！”~
@88002 = ~“呃。那么老大会拿走所有的钱了。德金知道了。”德金拿出了他的笔记本，藏着不让你看到，生气地写了几句话。~
@88003 = ~“德金并不那么想。你对德金太好了，老大！”~
@88004 = ~“那么只是因为德金是个狗头人而不是个合适的冒险者？你伤害了德金的感情，老大。德金会记得的，总有一天会把它写在书上的！”~
@88005 = ~---------这里开始随机对话----------~
@88006 = ~“嗯……德金猜想很快就要结束了，对吧？我们就要从这里出去了？”~
@88007 = ~“然后呢？我们去打那个坏家伙？”~
@88008 = ~“嗯……德金只想告诉你，老大……德金绝对相信你会赢得。你是迄今最伟大的英雄啊。”~
@88009 = ~“噢，德金永远不会忘记的！朝着冒险的结局出发吧！呀呼！”~
@88010 = ~“嗨……你这么说真好，老大。朝着冒险的结局出发吧！呀呼！”~
@88011 = ~“朝着冒险的结局出发吧！呀呼！”~
@88012 = ~“你把这里叫做什么？”~
@88013 = ~“收割者是谁？或者德金该问的是收割者是什么呢？”~
@88014 = ~“好的，德金就写……嗯……‘一个老大知道的，奇怪、恐怖的爬行鬼出没的地方’。听起来挺好。”~
@88015 = ~“德金需要传奇故事的背景。德金从没有去过这里，记得吗？”~
@88016 = ~“你在阴影位面找到了这块石头，而它又把你带到了这里？”~
@88017 = ~“然后收割者把你送到你想去的任何地方？”~
@88018 = ~德金抓抓自己的下巴想着，最后拿出了他的书，写上了几行字。“好的，老大。德金只想检查一下。你现在继续吧。”~
@88019 = ~“首先，在他和那个什么收割者谈话之前，德金想知道老大说什么。”~
@88020 = ~“德金很确定我们到了，而且到了地狱。”~
@88021 = ~“哦。呃……对不起，老大。”~
@88022 = ~“呃……这里没有很多好人，德金认为。”~
@88023 = ~“老大，也许你在考虑那个深渊魔域。那是个完全不同的地方。”~
@88024 = ~“全部，呃，全部死人？还有恶魔。或者是魔鬼？德金总是把它们混为一谈。”~
@88025 = ~“德金认为他记得关于迷失之城的传闻。他在很久以前，和老主人读过那类书。”~
@88026 = ~“好的，那么，老大。德金留给自己吧。”~
@88027 = ~“嗯……这里是那座翼精灵城的一部分。翼精灵就是带翼的精灵，书上是这么说的。从德金离开洞穴开始还没有看到过带有翅膀的精灵呢，所以也许书在说谎呢。”~
@88028 = ~“翼精灵城坐落在高山之上，那里每个人都很快乐。然后有一天——嗖——一切都消失了。没人知道它去了哪里，但是传说他们去了最黑暗的地方……就是这儿？”~
@88029 = ~“哎哎，老大！继续冒险吧！”~
@88030 = ~“德金一直热爱你随时准备冒险的特点，老大！”~
@88031 = ~“就像图画一样。”~
@88032 = ~“呃……也许那有一个咒语。或者一个巫师。或者是女王。或者是个不同的故事。德金记得不太清楚。德金只是记得有一天——嗖——一切都消失了。”~
@88033 = ~“呃……不是。故事里没说。它只提到有一天——嗖——一切都消失了。它并没有说有一天——嗖——这是因为……”~
@88034 = ~“德金不知道。传说没有提到城市去了哪里，实际上，只提到它从高山落入了最黑暗的地方。德金认为故事只是在猜测。”~
@88035 = ~“你也认为触须脑袋可以读德金的思想吗？”~
@88036 = ~“你太了解德金了，老大。”~
@88037 = ~“那……那让德金觉得有点奇怪的舒服，老大。”~
@88038 = ~“听你这么说德金真高兴，老大。你对小德金太好了。”~
@88039 = ~“哦！你要给他们饲草架，老大？德金看着他们，想他们也许和牙垢很般配，也许，但是你也许在想同样的事情。”~
@88040 = ~“德金对这个地方感觉不太好。”~
@88041 = ~“好的，老大。德金会静静的说得，不过……”~
@88042 = ~“谁保护老大？就像德金说的：他对这个地方感觉很糟。”~
@88043 = ~“有什么不对呢？看看周围，老大？我们正在竟如末日的邪恶要塞！！那永远都不会是好事。”~
@88044 = ~“好的，德金就是这个意思。他感觉很糟。他并不能确定，也许是末日的巨大要塞。”~
@88045 = ~“这个村落……这些人都是地表人，他们在幽暗地域做什么呢，老大？”~
@88046 = ~“只是……德金在村子里看到的人都是来自地表。而且穿脏脏的衣服。也许他们都很穷？”~
@88047 = ~德金再次仔细看看。“他们全部，老大？德金在村子里看到的人都是来自地表。而且穿脏脏的衣服。也许他们都很穷？”~
@88048 = ~“如果他们是奴隶，也许，那他们是谁的奴隶？”~
@88049 = ~“你是对的，老大！让我们继续冒险吧！！”~
@88050 = ~“好的，老大。德金只是有点担心……他描绘出德金被锁起来，然后穿脏脏的衣服。不喜欢这样的画面。”~
@88051 = ~“你怎么会认为是那些漂浮的眼球挖出了这些隧道？他们也许是靠眼射线炸出来的？”~
@88052 = ~“哦。这只是让德金怀疑。忘了德金说得吧，老大。”~
@88053 = ~“奴隶？你认为他们把狗头人作为奴隶？”~
@88054 = ~“呃……好吧。找到线索了，老大。”~
@88055 = ~“那……不会给德金带来好的映象，老大！老大是个坏蛋！坏蛋！”~
@88056 = ~“呃。也许他们那里有一些漂亮的狗头人女奴，德金可以救出她们来。那给另外德金好故事的素材哦……”~
@88057 = ~“德金希望眼睛能发出射线让东西消失。怪物向老大走过来：吱啦！！德金的房子脏了：吱啦！！出版商哈哈大笑：吱啦！！”~
@88058 = ~“哦。德金只是……站在这里，然后……”~
@88059 = ~“他改变了德金的头衔，象一个傻狗头人那样对待德金。吱啦！！你的，你干了！你听到德金的话了！吱啦！！”~
@88060 = ~“德金看到了老大的讥讽：吱啦！！”~
@88061 = ~“遗迹是个……奇怪的地方。也许在那些眼球之前就居住着某些不同的种族，对吧，老大？”~
@88062 = ~“不。德金一点都没有认出这个遗迹。也许，德金觉得有点象卓尔的地方，但是德金可不是卓尔专家。”~
@88063 = ~“德金只是……觉得奇怪。老大，魔法在这里好像毫无感觉。德金一点都不喜欢。”~
@88064 = ~“德金尽力，老大。不过，没有魔法……那可不会给德金多少自信。”~
@88065 = ~“德金不知道，真的。听起来很奇怪，但是这附近有什么东西会吸取魔法力量？至少，那不是个自然的东西。”~
@88066 = ~“好的，老大。不用魔法，然而……德金觉得有点恶心……”~
@88067 = ~“德金对于魔像了解的不多。他们是被法师造出来的，对吧？”~
@88068 = ~“那么……他们是活的，象德金一样吗？他们要吃东西、睡觉、做梦吗？他们需要什么东西吗？”~
@88069 = ~德金点点头，考虑着你的话。“也许，德金认为你是对的。”~
@88070 = ~“只是在德金看来如果魔像可以思考、感觉还有大吃大喝，那么从制造者离开这里他们就很悲伤了。也许他们进退维谷，也许他们愤怒。”~
@88071 = ~“如果德金是个魔像，而矮人总是下来拆散魔像，那么德金也会愤怒的。烦躁，不过也愤怒。”~
@88072 = ~“老大，你曾经被变成过石头。也许，那有点不同吧？当你是石头的时候你有什么感觉呢？”~
@88073 = ~“德金认为不会太好的。也许一切都不会啊，石头什么也感觉不到。”~
@88074 = ~“也许做个石头也不错。或者做一个魔像只有打开和关闭，生存或者毁灭。也许石魔像想着同样的事情呢？”~
@88075 = ~“哦。那只是德金考虑的材料。不用管小德金了，老大。我们回到冒险吧！”~
@88076 = ~“噢，我们可以吗？好主意啊，老大！”~
@88077 = ~“啊，这是老大对德金说的最好的事情了。”~
@88078 = ~“是真的。尽管也许用木头来建造有点好笑……或者也许可以用黄金！那么德金就很值钱了！”~
@88079 = ~“快乐？如果制作者都不在了，你怎么能找到他的意义呢？德金不想成为一个没有什么意义而出来的东西。那让德金听起来不太高兴。”~
@88080 = ~“德金知道地下有水……甚至前任老大所居住的很深、很深的洞穴里也有好多水……”~
@88081 = ~“但是如果卓尔有船……也许你认为那是船吧？如果卓尔有船，那就以为这里有一片大海！也许是整个大洋！”~
@88082 = ~“好的，老大。如果你认为我们不久得上船，德金所希望的就是你先提醒他一下……”~
@88083 = ~“但是，德金没有在船上旅行过。呃……那看起来好像不太安全……”~
@88084 = ~“他们地下没有整个大洋吧，有吗？你需要多大的洞穴呢？”~
@88085 = ~“呃……你怎么能把整个大洋都放到地下呢？你需要多大的洞穴呢？”~
@88086 = ~“你怎么知道的，老大？”~
@88087 = ~“哦。德金希望他和老大一样聪明。”~
@88088 = ~“德金记得在书里面读到过，有整个种族住在幽暗地域的地下水域里。大嘴唇的渔夫和吸你脑子的大鱿鱼！”~
@88089 = ~“他们如何在没有星星、风和物品的情况下航行呢？但是德金没有在船上旅行过，即使是在地面上。那看起来不太安全……”~
@88090 = ~“嗯那让德金感觉好些了。不过德金的肚子还是吓得够呛。你得保证如果上船的话先告诉德金，可以吗？”~
@88091 = ~“呃。也许你是对的，老大。德金没有那么想。但是，得紧的肚子可能不太同意……”~
@88092 = ~“呃……好的，德金接收你的话，老大。不过，如果德金的脑袋被大乌贼打破了，他会很不高兴的。”~
@88093 = ~“那没法让德金感觉更好些，老大。如果你想让我们上船，你一定要先告诉德金，好吧？”~
@88094 = ~“呃……我们真的到了幽暗地域了。我们真的到幽暗地域了！”~
@88095 = ~德金停下来，怀疑的看着你。“你想找路出去，老大？但为什么呢？”~
@88096 = ~“你不高兴？”德金的声调有点怀疑，他盯着你，好像你突然变成了一只绿色的猿猴。“为什么你不高兴？”~
@88097 = ~“太好了！”德金绕着那里跑着，双手激动挥舞着不停。“德金读了很多幽暗地域的消息，现在德金真的到这里来了！”~
@88098 = ~“这对德金的书太好了！‘传奇的英雄来到了可怕的幽暗地域’！这会是最伟大的书！”~
@88099 = ~“好的，老大！继续这场传奇的冒险吧！”~
@88100 = ~“德金在他上次离开老大之后到处旅行。然而，他真正想做的事情就是去幽暗地域！即便名字听起来都很酷：幽暗地域！德金听着都有点发抖。但是德金太渺小了不能去，那儿太危险了。”~
@88101 = ~“不仅仅是德金的书，那也是伟大、传奇的英雄的书！你也想让书很好吧，不是吗，老大？”~
@88102 = ~“你要金币，老大？德金挣不到多少金币。也许出版商有不少吧，德金真的不知道。德金知道的就是很多人读到了这个故事。那就让德金很高兴了。”~
@88103 = ~“害怕？德金早就非常想去幽暗地域了，尽管他知道自己可能会变成触须头的奴隶或者被卓尔蜘蛛吃掉。”~
@88104 = ~“但是现在……现在德金和伟大、传奇的英雄一起来到了幽暗地域！德金来到了幽暗地域是为了完成末日来临的急迫任务！”~
@88105 = ~“那真的，真的很酷，老大。”~
@88106 = ~“哦……不不！现在别丢下德金！直到他看到幽暗地域吧！求你了，求你了，大英雄！！发发善心吧！！”~
@88107 = ~“哦，德金是对的。老大，你很快就会回到德金的思考方式了。这是一次最伟大的冒险！你知道的！”~
@88108 = ~“正确！老大，耶！这还非常有趣，德金刚知道！”~
@88109 = ~“嗯，也许是因为你没有太注意，老大。”~
@88110 = ~“你看到门口那里了？德金认为我们只有通过它才能走得更远。”~
@88111 = ~德金想了一会，然后制止地面。“下面。”~
@88112 = ~“德金记得这个门在德金读过的书里提到过。有，呃……四根？四根锁链？四根锁链把门固定在这个位面上。”~
@88113 = ~“每次用过门之后，锁链都回消失在那个地方，你必须把他们找回来才能再次打开门。这个门的名字很长，但是德金现在忘了。”~
@88114 = ~“正确，老大！我们继续冒险吧！”~
@88115 = ~“耶，德金知道你的意思，老大。海拉斯特一定解决了迷题。”~
@88116 = ~“书里说它会变化，但是山下地城总是非常大、非常深。我们可能会走上好几个星期也看不到尽头。但是老大，除非你找到锁链才能下的更深一些。”~
@88117 = ~“德金不知道。书里没提到过。德金认为也许它每次都不尽相同。”~
@88118 = ~德金瞪大了敬畏的眼睛打量着那个房间。“德金……德金知道这个地方叫什么。那就是，呃，沉睡诸王之厅。”~
@88119 = ~“哦，抱歉老大。德金只是想帮忙。”~
@88120 = ~“呃……好的，老大。”~
@88121 = ~“德金认为你得小心别打扰别人。如果你尊重它，也许它会好的。德金没法确定。”~
@88122 = ~德金在继续说话前偷偷瞟了一眼那些骷髅。“很久以前德金在书上看到古代人类国王的遗体在山下地城里长眠。”~
@88123 = ~“他们是伟大的国王、王后还有法师，都来自北地，那儿比任何地方的出现的都要早，现在早己为人所忘怀了。那就是说他们非常的古老，老大。”~
@88124 = ~“他们赢得了对敌人的大战，把他们赶尽杀绝。海拉斯特把这里作为他们的荣誉之所。在这里他们长眠。”~
@88125 = ~“对的，老大！我们继续冒险吧！”~
@88126 = ~“欢迎你，老大。永远乐于为您效劳。”~
@88127 = ~“如果那里有很多魔法就没有很多不同了。你知道的，老大。死人会站起来，象活人一样迅捷的发起攻击。有时候可能会更快。”~
@88128 = ~德金耸耸肩。“德金不知道。也许。德金怀疑是不是能那么轻松的从他们那里拿到。也许那只会唤醒他们。”~
@88129 = ~“呃……德金曾经读过关于这里的书。这叫做魔镜之殿，如果德金记得没错的话……这他也许没有……”~
@88130 = ~德金畏缩起来。“噢。对不起，老大……德金只是想帮忙……”~
@88131 = ~德金点点头，但是看起来很害怕。“好得，老大……”~
@88132 = ~德金抓抓脑袋，想了一会。“德金读书的时候是这么说的，魔镜之殿也许靠近着人口。有些人并没有进入山下地城很远就看到了它。”~
@88133 = ~“也许，大法师海拉斯特移动了它？德金不知道。但是如果你向镜子里望去可得小心……其中有些会有奇怪的事情发生，比如把你吸进去或者再复制一个你。这个坏东西。”~
@88134 = ~“你对小德金太好了，老大。”~
@88135 = ~“啊~啊，老大！继续冒险吧！”~
@88136 = ~“那么德金认为你好了。尽管德金想的很烦人……”~
@88137 = ~德金耸耸肩。“德金这么认为。不过也许这里有些镜子和其他的不太一样。无论如何，那有不少厄运啊，不是吗？”~
@88138 = ~德金沉思着抓抓下巴。“有魔镜会复制那个往里看的人。是那种邪恶的复制，它会攻击你。德金似乎记得有一面那样的镜子就在这里。”~
@88139 = ~“你知道……就像镜子的对面有一个完全颠倒的世界？或者也许有另一个德金读到的故事……”~
@88140 = ~德金在继续说话之前慎重的看看周围。“你，呃……你知道我们是在山下地城，对吧？”~
@88141 = ~这个狗头人从你身边躲开了一点，显然不太确定。“嗯，呃……你知道那意味着什么，对吧？”~
@88142 = ~德金紧张的从一个脚跳到另一个脚。“一旦你进入了山下地城，那就意味着你不再能轻松的出去了。魔法不会把你带到任何地方去。”~
@88143 = ~“哦？老大已经知道了？对不起，老大……德金只是紧张。德金读了很多关于山下地城的书。”~
@88144 = ~“呃……如果你爬绳子，是的。”~
@88145 = ~德金考虑了一会耸耸肩。“德金不太确定。也许老大的信仰更加强大。但是所有传闻都在这里保持一致，比如传送术不会在这里起作用。”~
@88146 = ~“德金读了很多关于山下地城的故事。他们都提到了同一件事情，比如传送术不会在这里起作用。”~
@88147 = ~德金稍微懂了一下，似乎站在那里让他感到不安。“那么，呃……老大，继续冒险吧？”~
@88148 = ~“肯定的，老大。”~
@88149 = ~“那么继续传奇吧！”~
@88150 = ~德金狂热的点点头。“德金很高兴听到这个，老大！那么，呃……继续冒险吧？”~
@88151 = ~“那时候德金拼命工作来取悦老主人，德金读了很多书。老主人喜欢听山下地城的故事，所以德金只要找到这类书就会去读。”~
@88152 = ~“也许那很多都只是故事，但是德金认为还有不少是事实。老主人有些书是别人没有的，所以也许德金知道一些别人不知道的事情。”~
@88153 = ~“有些德金知道的事情，德金宁愿不知道。就像海拉斯特法师的事情……那个一手缔造这里的人……他真的很疯狂，想杀死所有来这里的人。那让德金紧张。”~
@88154 = ~德金咧开嘴笑了。“哦，德金知道。德金更加担心老大。那么，呃……老大，我们继续冒险吧？”~
@88155 = ~德金看来对你的反应很高兴。“那很真实，老大。你真的很聪明。那么，呃……继续冒险吧？”~
@88156 = ~德金看起来并不信服。“法师有方法可以长久的生存。德金认为，特别是疯狂的人。”~
@88157 = ~“是~，但是那不是所有的意思，老大。”~
@88158 = ~“哦。老大真的没有想法？”~
@88159 = ~德金盯着你看了很长时间，然后眨了眨眼睛。“德金听说过拉沙曼。那就是人们在那里做的事情吗？”~
@88160 = ~“哦。”德金不安的拿出他的本本，写了几条记录，睁大了眼睛。然后他再一次抬头看着你。“嗯……我们现在来到了山下地城，老大。你知道那意味着什么吗？”~
@88161 = ~“好得。德金只是担心老大会因为德金发疯的，就这样。”~
@88162 = ~“呃……那么，德金可以期望被复活很多次么？”~
@88163 = ~德金悄悄地靠近你，令人同情的看着你。“那么……你想重新让德金和你一起了，老大？那就是你为什么复活德金，对吧？”~
@88164 = ~“耶！上路出发！”~
@88165 = ~“你想让德金……留在这里？呃……好吧。德金就这么做。但是你要知道，德金很快就会孤单了……”~
@88166 = ~“德金很激动！德金一直认为老大就在他身后！哦，嗯……德金会做得更好的。”~
@88167 = ~“德金不知道。他想也许在旅程里有更多的‘喂～！’、更少的‘唉～！’，就够了。”~
@88168 = ~德金沉思的点点头。“呃……好的。德金努力想想怎么去解决。”~
@88169 = ~“哦。知道这个还好些。德金要开始担心了。”~
@88170 = ~------- 这一行必须放在队员之间说笑的结束处 ---------~
@88171 = ~“呃……你真的死了吗，精灵女士？你看起来好像还没有死。”~
@88172 = ~“我真的死了，是的。那就是你真想知道的吗？”~
@88173 = ~“呃……并不是。德金怀疑你怎么样一直都这么好？它是很困难的吧？”~
@88174 = ~“你到底是什么意思？”~
@88175 = ~“德金想和你一样。他试着只去想那些好的事情，甚至是神圣的……但是德金就会想起一些可笑的事情，然后就会大笑起来，这很困难。”~
@88176 = ~“心灵纯洁并非意味着没有幽默感。”~
@88177 = ~“但是……你从来不笑。你总是很悲伤。”~
@88178 = ~“我……但是那并不代表着什么，小家伙。那只意味着……我的心悲伤。”~
@88179 = ~“你悲伤？为什么你如此悲伤呢？德金可以为你做什么事情来让你不再悲伤吗？”~
@88180 = ~“不……不，小家伙。你不能为我做什么。”~
@88181 = ~“呃……真的不。德金怀疑你怎么变得如此邪恶？它真的很难吗？”~
@88182 = ~“你到底是什么意思？”~
@88183 = ~“德金看着镜子，希望能和你一样。他露出牙齿咆哮着‘吼！吼！德金大恶魔！’但是他从不能象你那样令人惊慌。”~
@88184 = ~“我把它看作一种恭维。”~
@88185 = ~“每当德金认为自己接近了邪恶的边缘，但是德金突然就会想起一些可笑的事情，然后就会大笑起来，这很困难。”~
@88186 = ~“邪恶并非意味着没有幽默感，狗头人。”~
@88187 = ~“瓦伦……德金希望你知道他认为你是个很好的战士。”~
@88188 = ~“我很高兴你注意了。”~
@88189 = ~“你怎么学着那样战斗？”~
@88190 = ~“困难的道路。每次都会带来死亡。”~
@88191 = ~“噢。德金在考虑寻找线索……但是也许那不是个好主意。”~
@88192 = ~“为什么不呢？你更加腐朽了，狗头人。我怀疑你复制了我的思想。”~
@88193 = ~“你知道，德金能听出讽刺来。”~
@88194 = ~“也许以后你可以用同样的敏感来找到合适的韵音。”~
@88195 = ~“德金现在不和你说话了。”~
@88196 = ~“慷慨是个缺点。狗头人，你太过大方了。”~
@88197 = ~“为什么你有角呢？你是半羊人吗？”~
@88198 = ~“以正常说话的方式。我是一个半魔人……一个泰夫林，如果你听说过的话。”~
@88199 = ~“恶魔有孩子吗？”~
@88200 = ~“当他们想要就有。你总是提这些愚蠢的问题吗？”~
@88201 = ~“德金只要愿意就可以变得很天真。那时他魅力的一部分。”~
@88202 = ~“嗯，我有一件武器可以在人们意识到他死去之前就把他的脑袋打个稀巴烂。我会在他还在说个不停的时候就让他变成一具尸体。那就是我魅力的一部分。”~
@88203 = ~“过去德金的老主人会吃些坏的蘑菇，然后喷出可以杀死一窝狗头人的气体。德金把头埋进了水桶里，那就是他活下来的原因。”~
@88204 = ~“我从一百多人李杀出了血路，呼吸着他们的血腥，感到有上百次被他们的刀剑所伤却没有死去。”~
@88205 = ~“一次老主人在睡觉的时候滚到了德金的身上。老主人太重了。”~
@88206 = ~“好像不太让你感到折磨，是吧？”~
@88207 = ~“不，没多少。”~
@88208 = ~“那么德金听你说你从来没有看到过太阳。”~
@88209 = ~“我没有到过地面上。对，没错。”~
@88210 = ~“你会紧张吗？太阳非常明亮。德金记得他第一次看见太阳的时候。”~
@88211 = ~“我……试着去想像它。”~
@88212 = ~“你无法想像。它非常的明亮，直刺进你的头里。头顶的天空一下子开阔起来，你确定你要坠入深深的黑暗里——”~
@88213 = ~“闭嘴！”~
@88214 = ~“你看起来不太好。”~
@88215 = ~“那……那是个过去的事情了。也许你自己觉得有点太多的打扰<CHARNAME>了，对吧？”~
@88216 = ~“不。德金在这里很好。”~
@88217 = ~“高兴。”~
@88218 = ~“为什么德金从来没有听到过你走路的声音，精灵女士？”~
@88219 = ~“那……那是一项印在我心上的技能。当我是红色姐妹时，走路弄出声音就意味着死亡。”~
@88220 = ~“你得学习保持这样安静？”~
@88221 = ~“是的。否则我的师傅就会杀了我。”~
@88222 = ~“如果你学的不好他就会杀了你？”~
@88223 = ~“不。她没有眼睛。如果她听见周围有什么声音，她就会发出毒镖。而且她从不会失手。所以必须静悄悄地移动。”~
@88224 = ~“你也可以动得快点。”~
@88225 = ~娜西拉笑了一下：“是，你可以动得快些，但她也一样。”~
@88226 = ~“你上学付了很多钱吧？”~
@88227 = ~“那不是个学校。红色姐妹是我接受刺客训练的组织。”~
@88228 = ~“那些和你一起成为红色姐妹的人有不少是你的朋友吧？”~
@88229 = ~“你说我那一级？不。在训练之后，每级只有一个人能幸存下来毕业，成为完全的红色姐妹。”~
@88230 = ~“呃……德金没法确定这种教育方式是个好主意……”~
@88231 = ~“但是它……非常精确。”~
@88232 = ~“呃……嘿嘿。德金说过沙尔文女士非常漂亮吗？”~
@88233 = ~“不，德金没有。不过你在盯着我，我就是那种你心目中的人。”~
@88234 = ~“你的意思是？”~
@88235 = ~“别害羞，我的小蜥蜴朋友。在吟游诗人之间，我知道那种眼神的意思。”~
@88236 = ~“德金在看沙尔文的头发。”~
@88237 = ~“真的，我很满意，但是你得知道那不是……什么”~
@88238 = ~“德金在看沙尔文的头发。很漂亮，不过在靠近沙尔文的脑袋的地方有些不同的颜色。正常吗？德金以前没有看到过。”~
@88239 = ~“当……当然正常了！嗯……如果你不向任何人提起这事我给你二十个金币。”~
@88240 = ~“三十。”~
@88241 = ~“好的，三十。现在闭嘴。”~
@88242 = ~“呃……德金想问沙尔文几个问题。是你写的《无冬之夜》这本书吗？”~
@88243 = ~“事实上，是我写的，小家伙。我想你是《古城阴影》的作者吧？”~
@88244 = ~“你读过德金的书？德金很激动！你喜欢吗？”~
@88245 = ~“嗯……开头很好。但是第二章好像有点……仓促……”~
@88246 = ~“德金文思泉涌。”~
@88247 = ~“还有其他的问题。我很乐意以后给你列出来，如果你愿意的话。”~
@88248 = ~“德金很乐意！德金也可以告诉你《无冬之夜》的纰漏之处！”~
@88249 = ~“你说什么呢？我的书里没错！”~
@88250 = ~“你开玩笑吧？”~
@88251 = ~“哦，闭嘴，你。”沙尔文转身离开了。“批评家。”~
@88252 = ~“达尔兰，在你们那里他们抓住过狗头人吗？”~
@88253 = ~“我部落附近？是的，他们抓住过。我那时干掉过很多狗头人，就像我部落的其他武士一样。”~
@88254 = ~“哦~。那可不太好。”~
@88255 = ~“一点也不，德金。你和我年轻的时候战斗的那些坏蛋一点都不同。你有一些他们从来不曾有过的东西。”~
@88256 = ~“一双好鞋？”~
@88257 = ~“荣誉。那就是把野兽和文明人分开的真正标志。”~
@88258 = ~“你认为德金有荣誉？”~
@88259 = ~“我认为你在争取荣誉，小家伙，无论你知不知道，那就是你所走的路。争取荣誉就是要赢得它，那会让你得到尊敬。”~
@88260 = ~“从前没有狗头人得到过尊敬。”~
@88261 = ~“你不应该是最后一个，德金。也许成为一个使者就是你的命运。你想过吗？”~
@88262 = ~“你让德金想了好多。”~
@88263 = ~“我的确希望这样。”~
@88264 = ~“那么……德金在考虑一些事情。你是半兽人？”~
@88265 = ~“对，没错。”~
@88266 = ~“德金从前见过很多兽人。也许，你看起来和他们有点象，但是不是特别象。”~
@88267 = ~“我还有部分的人类血统。对我的部落的暴虐带来的副产品。你肯定听说过这样的组合，狗头人……你们也会象兽人一样发起袭击。”~
@88268 = ~“狗头人不这么做。德金不认为狗头人能这么做。”~
@88269 = ~“也许你的善良和其他的人类种族都很不同。”~
@88270 = ~“老主人说过狗头人有龙的血脉！不过，呃，他说的好像并不太高兴……”~
@88271 = ~“龙血很强大。你应该为此自豪。小家伙，从那里汲取力量和勇气吧。”~
@88272 = ~“你很优雅。德金喜欢你。也许他会把你这个伙伴写到老大的传奇故事里。”~
@88273 = ~“我会很荣幸的。”~
@88274 = ~“啊哈！嗯……德金会为你写首诗的，漂亮的精灵女士……”~
@88275 = ~“哦？哈哈哈！你可以叫我莉努，德金。这样更好些。”~
@88276 = ~“哦，不……德金不能这么叫！”~
@88277 = ~“这样才好，亲爱的。我可以有幸聆听你的诗吗？”~
@88278 = ~“好！等一下阿……它是怎么开头的呢？哦！德金现在想起来了！”~
@88279 = ~“精灵女士漂亮又可爱，美丽的红发、两个大左脚，
打起仗来笨手笨脚，
走起路来磕磕绊绊，
你觉得她优雅真的很可爱！”~
@88280 = ~“呃……这是夸奖吗？”~
@88281 = ~“德金认为你是最好的！”~
@88282 = ~“我知道了。呃……谢谢。也许我该……到<CHARNAME>那里去。对不起。”~
@88283 = ~“德金能问漂亮的精灵女士几个问题吗？”~
@88284 = ~“我的，你不是最可爱的吗？你可以问任何问题，小可爱。”~
@88285 = ~“好的。德金想知道为什么你那么笨手笨脚的？德金见过很多精灵，没有象你这么笨手笨脚的。”~
@88286 = ~“呃，我……我不觉得我自己笨手笨脚的。”~
@88287 = ~“不，你真的笨手笨脚的。德金见过你从包袱里拿东西，你最后几乎把老大给打晕了。”~
@88288 = ~“是的，嗯……我非常抱歉……”~
@88289 = ~莉努叹了口气，不太高兴。“我……我得说每个人都自己擅长的东西，对吧？”~
@88290 = ~“那么你擅长笨手笨脚吧？”~
@88291 = ~“你最好还是回去尝哪个可爱的末日之歌吧，我的小朋友？那样更好些。”~
@88292 = ~“好的。德金很高兴你喜欢听我唱歌。”~
@88293 = ~“但是她说德金可以问！德金只是好奇。”~
@88294 = ~莉努又羞又恼地盯着你：“我*说过*对不起！锅卡在那里了……”~
@88295 = ~“德金认为很好玩。老大你看起来真的很奇怪。但是，呃……你怎么不回答啊。”~
@88296 = ~“老大！德金不喜欢被汤米这么看着！”~
@88297 = ~“我再也不盯着你看了，你这条大蜥蜴！”~
@88298 = ~“德金说你是……是……没长鳞片的狗头人！”~
@88299 = ~“没长鳞片的狗头人？你在搞笑？你只会骂这种脏话吗？”~
@88300 = ~“德金不想侮辱你，那样有失德金的身份……”~
@88301 = ~“胡扯！你应该握紧拳头威胁我。来吧试试……”~
@88302 = ~“像这样吗？（怒吼状）”~
@88303 = ~“对了！就这样！现在说：‘你这只阴沟里长大的粉红色色臭老鼠！’”~
@88304 = ~“你是只阴沟里长大的粉红色色臭老鼠！”~
@88305 = ~“不错，不错。以后多练练。”~
@88306 = ~“德金感觉很滑稽，我好像想打人。”~
@88307 = ~“德金的钱包哪去了？德金有个钱包来着，现在不见了。可能是掉了？”~
@88308 = ~“狗头人，别用你那双小眼睛瞪我！我是贼，但不代表我偷了你的钱包。”~
@88309 = ~“唔……德金没有别的意思……”~
@88310 = ~“你绝对有！看你那双充满责难的小眼睛！知道我是谁吗？本大爷是汤米。你呢……只是个狗头人！”~
@88311 = ~“但是德金*什么*也没说！钱包里好像就剩几分钱了……”~
@88312 = ~“啊，这个我知道。现在你又开始装可怜了？好吧，这是你的血汗钱，拿去！现在你高兴了？”~
@88313 = ~“你找到了德金的钱包！嘿！汤米，你最好了！”~
@88314 = ~“唉，就知道你要这么说。”~
@88315 = ~“加入我的队伍吧。”~
@88316 = ~“没事了。”~
@88317 = ~“我想我们该分道扬镳了。”~
@88318 = ~“好吧好吧，那就跟着我吧。”~
@88319 = ~“在这里等我回来。”~
@88320 = ~“还是分开吧。后会有期。”~
@88321 = ~“我想改变你的战术。”~
@88322 = ~“目前我只想改变这么多。”~
@88323 = ~“除非我的命令，否则别施放任何法术。”~
@88324 = ~“我希望你能随意施放法术。”~
@88325 = ~“别用解除魔法为队友解除瘫痪状态。”~
@88326 = ~“用解除魔法为队友解除瘫痪状态。”~
@88327 = ~“发现陷阱之后不要拆解。”~
@88328 = ~“看到陷阱马上拆解。”~
@88329 = ~“以后不要使用潜行状态。”~
@88330 = ~“保持潜行，直到下次战斗为止。”~
@88331 = ~“无伦何时，尽量保持潜行状态。”~
@88332 = ~“我打不开锁的时候不要插手。”~
@88333 = ~“如果我打不开锁，快来帮忙。”~
@88334 = ~“我想调整一下我们之间的距离。”~
@88335 = ~离我远一点。~
@88336 = ~保持中距离。~
@88337 = ~靠近我。~
@88338 = ~“见到敌人马上攻击。”~
@88339 = ~“保护我，我不出手就不要进攻。”~
@88340 = ~“我想更换你的装备。”~
@88341 = ~“你能鉴定我的装备吗？”~
@88342 = ~“我想让你使用吟唱技能。”~
@88343 = ~“我想让你施放一组辅助法术。”~
@88344 = ~“没事了。”~
@88345 = ~“施放所有辅助法术。”~
@88346 = ~“施放所有效果持久的辅助法术。”~
@88347 = ~“施放所有短暂效果的辅助法术。”~
@88348 = ~“我想让你施放一个法术。”~
@88349 = ~“没事了。”~
@88350 = ~“创伤低语。”~
@88351 = ~“超视觉。”~
@88352 = ~“真实目光。”~
@88353 = ~“9级生物召唤术。”~
@88354 = ~“8级召唤生物术。”~
@88355 = ~“7级召唤生物术。”~
@88356 = ~“6级召唤生物术。”~
@88357 = ~“5级召唤生物术。”~
@88358 = ~“4级召唤生物术。”~
@88359 = ~“3级召唤生物术。”~
@88360 = ~“2级召唤生物术。”~
@88361 = ~“1级召唤生物术。”~
@88362 = ~“石肤术。”~
@88363 = ~“法术抗力。”~
@88364 = ~“法术吸收。”~
@88365 = ~“信仰之盾。”~
@88366 = ~“护盾术。”~
@88367 = ~“影盾术。”~
@88368 = ~“侦测隐形。”~
@88369 = ~“圣域术。”~
@88370 = ~“复原术。”~
@88371 = ~“提升抗力。”~
@88372 = ~“抵抗元素伤害。”~
@88373 = ~“移除麻痹。”~
@88374 = ~“移除恐惧。”~
@88375 = ~“移除疾病。”~
@88376 = ~“移除诅咒。”~
@88377 = ~“移除盲聋。”~
@88378 = ~“再生术。”~
@88379 = ~“法术防护。”~
@88380 = ~“防护元素伤害。”~
@88381 = ~“占卜术。”~
@88382 = ~“祈祷术。”~
@88383 = ~“枭之智慧。”~
@88384 = ~“解毒术。”~
@88385 = ~“异常再生术。”~
@88386 = ~“次级法术无效结界。”~
@88387 = ~“心灵屏障。”~
@88388 = ~“群体加速术。”~
@88389 = ~“魔化护甲”~
@88390 = ~“法师护甲。”~
@88391 = ~“光亮术。”~
@88392 = ~“次级法术吸收。”~
@88393 = ~“次级复原术。”~
@88394 = ~“次级心灵屏障。”~
@88395 = ~“次级消解术。”~
@88396 = ~“敲击术。”~
@88397 = ~“隐形法球。”~
@88398 = ~“隐身术。”~
@88399 = ~“高等隐身术。”~
@88400 = ~“加速术。”~
@88401 = ~“高等石肤术。”~
@88402 = ~“高等法术吸收。”~
@88403 = ~“高等圣域术。”~
@88404 = ~“高等复原术。”~
@88405 = ~“高等魔化武器。”~
@88406 = ~“高等消解术。”~
@88407 = ~“守护法球。”~
@88408 = ~“鬼面术。”~
@88409 = ~“行动自如。”~
@88410 = ~“狐之狡诈。”~
@88411 = ~“寻找陷阱。”~
@88412 = ~“灵体术。”~
@88413 = ~“熵光护盾。”~
@88414 = ~“能量缓冲。”~
@88415 = ~“不，我改变主意了。”~
@88416 = ~“是的，继续。”~
@88417 = ~“忍受元素伤害。”~
@88418 = ~“坚忍术。”~
@88419 = ~“元素护盾。”~
@88420 = ~“鹰之威仪。”~
@88421 = ~“神能术。”~
@88422 = ~“解除魔法。”~
@88423 = ~“防死结界。”~
@88424 = ~“死亡护甲。”~
@88425 = ~“唤起死灵。”~
@88426 = ~“不灭明焰。”~
@88427 = ~“清醒术。”~
@88428 = ~“猫之优雅。”~
@88429 = ~“公牛之力。”~
@88430 = ~“我改变主意了。”~
@88431 = ~“对所有队员使用。”~
@88432 = ~“对使用。”~
@88433 = ~“对使用。”~
