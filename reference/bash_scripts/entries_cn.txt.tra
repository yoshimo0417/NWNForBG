@103875 = ~闪电惊魂鞭~
@103876 = ~闪电惊魂鞭是用电蜥蜴的皮制成的，打击时能释放出一阵电能，造成沉重伤害，并使得目标有可能在短时间内处于眩晕状态。~
@103877 = ~大型闪电惊魂鞭~
@103878 = ~闪电惊魂鞭是用电蜥蜴的皮制成的，打击时能释放出一阵电能，造成沉重伤害，并使得目标有可能在短时间内处于眩晕状态。~
@103879 = ~变形者之大型黑暗精灵皮甲~
@103880 = ~黑暗精灵之寒冰刃~
@103881 = ~只有最出色的黑暗精灵武器匠才知道怎样铸造这些致命的武器。有谣言说人们必须到卡尼亚的冰冻荒原去找到必需的原料才能铸造这样一件强大的武器，但是这些原料究竟是什么却毫无所知。~
@103882 = ~狗头人突击队装备~
@103883 = ~邪兽鬼法杖~
@103884 = ~变形者之恶魔肉身魔像装备~
@103885 = ~变形者之大型史拉亡蟾装备~
@103886 = ~变形者之铁魔像装备~
@103887 = ~变形者之邪兽鬼形体装备~
@103888 = ~变形者之石魔像装备~
@103889 = ~大幽灵装备~
@103890 = ~小型混乱盾牌~
@103891 = ~利剑之恩赛力克~
@103892 = ~“那就是战争中会发生的事，亲爱的。人们遭受劫难。”~
@103893 = ~“大部分人都会那样。但是只要有战争，就会有平民受难。”~
@103894 = ~“是的。我敢打赌这里的价格是正常价格的两倍！而且人们还觉得我是个骗子。”~
@103895 = ~“我怀疑她的动机会像她使其看起来那样的纯洁。我猜那里头藏着很大的利益。”~
@103896 = ~“你很勇敢，亲爱的。你维护了自己的名声，应该得到称赞。”~
@103897 = ~“德金也注意到了，头。为什么你会像那样说话？德金觉得听起来很好笑。”~
@103898 = ~“战士最大的敌人是时间；时间已经打败了这个人，没有必要再用他的缺点来打击他了。”~
@103899 = ~“噢！这个怪老头已经很沮丧了。你用不着再伤他的心。”~
@103900 = ~吟游诗人厌恶地摇了摇头说，“并不需要那样。”~
@103901 = ~莉努严肃地长时间注视着你。“真的需要那样做吗？把一个老人弄哭？”~
@103902 = ~“哇奥，头，有时候你真是卑鄙。”~
@103903 = ~沙尔文斜着身子靠近你，低声耳语道，“你在这里做了一件好事。每个人都想觉得自己是有用的。”~
@103904 = ~莉努斜着身子靠近你，耳语道，“你真好，亲爱的。每个人都需要觉得自己是有用的。”~
@103905 = ~达尔兰笑着对这个老人说：“虽然年龄带走了你的力量，但却给了你智慧。我很高兴看到你在使用这件新的武器。”~
@103906 = ~“那件怎么样。我猜你这个怪老头不是这般无用吧。”~
@103907 = ~“你还想知道别的什么吗？”~
@103908 = ~“德金认为他说的是真的，头。德金听说过血牙。他是一个高大骇人的地精首领……后来失踪了。人人都说血牙死掉了，连同他的部族一起。”~
@103909 = ~德金怀疑地看了这个地精一眼。“德金认为你想要头雇用你，休想！头不需要你的帮助……他有德金在此！”~
@103910 = ~“不，不，不。格鲁夫不想被雇用，如果这意味着需要深入山下地城。格鲁夫只是想交谈。”~
@103911 = ~德金伤心地摇了摇头，“噢，头。为什么你会让他们折磨他？”~
@103912 = ~“噢，我想这有点残酷，伙计。他们会一直折磨他直到他像猪一样的尖叫！”~
@103913 = ~“他不会造成什么麻烦，杜尔南。说不定还会比较有用。”~
@103914 = ~“他确实看起来很急切。也许他真地有些用处，杜尔南。”~
@103915 = ~“不要因为他的地精身份而妄作判断，杜尔南。给他一个证明自己的机会。”~
@103916 = ~汤米咧开了嘴笑着，“很高兴我看到了。我正想要亲自去试验一下呢。当然，现在我知道得更清楚了。”~
@103917 = ~达尔兰笑着摇了摇头，“那就是我为什么不信任魔法的原因！”~
@103918 = ~“一个以后可以牢记在心的经验，<CHARNAME>：当一个巫师说‘不要碰’，那就不要碰！”~
@103919 = ~莉努笑了起来，“那会教你和其他人的玩具一起玩耍，亲爱的。”~
@103920 = ~“小心，头！哦……别介意。德金的警告太迟了。”~
@103921 = ~“但是也许是一位黑暗精灵女士假装成另一位黑暗精灵女士，以此来戏弄人们，让大家觉得她不是第一位女士，尽管实际上她确实是第一位女士！”~
@103922 = ~“不过如果人们认为第二位黑暗精灵女士可能是第一位黑暗精灵女士，那么第一位黑暗精灵女士就不能假装成第二位黑暗精灵女士……除非大家都希望第二位黑暗精灵女士真的是第一位黑暗精灵女士！”~
@103923 = ~“如果人们希望这样，那么也许第二位黑暗精灵女士可能……哈……也许第一位黑暗精灵女士是……唔，这样没什么含义。噢，头：德金的脑子受伤了。”~
@103924 = ~“除非你认为这个伪装太明显了，以至于我们会无视你！那么，一个黑暗精灵的伪装就有着绝妙的作用：老式的双重开关！当然，你必须认为我们打算那样做。”~
@103925 = ~“如果你认为我们想到了双重开关，那么你就不能那样做了。除非你的确知道我们预料到了双重开关，那么你就会拉下另一到开关来让我们步入歧途——三重开关！”~
@103926 = ~“但是一个三重开关意味着瓦纱瑞丝不会乔装成一个黑暗精灵……或者说还是意味着它会乔装成一个黑暗精灵？噢，我的头疼。”~
@103927 = ~对于如此混乱的逻辑，黑暗精灵摇了摇头，显然决定不认同这样的观点。相反，她把注意力放到了你身上。~
@103928 = ~“她起的作用很大。”~
@103929 = ~“她的确有用，亲爱的。”~
@103930 = ~“有时候最明显的伪装是最有效的。你可以凭着简单的打扮而藏身。但是，考虑到你已经对我们所做的一切，这并没有什么用……”~
@103931 = ~“那可真不是我所说的公平战斗，亲爱的。当然，没人说黑暗精灵会公平战斗。”~
@103932 = ~“关于使用巧计而不是莽力的问题，有一些地方需要说明。”~
@103933 = ~“德金喜欢这个计划，头。给那些可恶的黑暗精灵们一个大惊喜吧！”~
@103934 = ~“卓尔可能成为可怕的对手，我们应该利用所有可以得到的优势。”~
@103935 = ~“嗨，那正是我所喜欢的策略！从天而降的死亡，我们甚至不需要弄脏双手！”~
@103936 = ~“我想我们应该在做出判断前听听她所要说的。”~
@103937 = ~“对她小心点。她也许是个叛乱者，但是她仍然是一个黑暗精灵！”~
@103938 = ~“我对你的期望不低，精灵。我们居住在地表的表兄弟常常对我们抱有偏见。但是我的帮助是真诚的。”~
@103939 = ~“卓尔反抗者？我听说过这个组织的故事，但是从没想过自己会遇到……如果我们真地遇到过的话。”~
@103940 = ~“我不知道，头。德金不太了解黑暗精灵，但是他们意味着坏消息。”~
@103941 = ~“不同？哦，是的。你是装成我们的朋友，然后从背后插刀子，而不是直接从正面刺我们的肚子。”~
@103942 = ~德金迅速抽出一支鹅毛笔和一张羊皮纸。“这也许会是一个好故事，对吗，头？德金想把它写下来。那个怪物叫什么名字来着？”~
@103943 = ~“我以前从没听过像那样的怪物，你说那个东西叫什么？”~
@103944 = ~“蛇鸡兽。你当然听说过他们？魔法兽。体型很小，但是非常致命。它们能把一个人变成石头。”~
@103945 = ~“什么鸡巴兽？”~
@103946 = ~“什么鸡巴兽？”~
@103947 = ~“蛇鸡兽。就像……噢，算了吧，白费口舌。”索伯雷恼怒地摇了摇头。~
@103948 = ~莉努悲伤地摇了摇头：“他们为了保护一头邪恶透顶的生物而丢了性命。”~
@103949 = ~“这头野兽只要有一丝机会，就可能已经杀死了他们，可他们还为了它而送命？“~
@103950 = ~“他们为了一个怪兽而送命？”~
@103951 = ~“看来你的帮手已经足够多了。你的团队里的人太多了，而你必须妥善的分配财物，这样你身上的钱就不值得以后去偷了。哈！开个玩笑而已。”~
@103952 = ~“如果你真地想要汤米加入你，那么在你没有如此多的人跟着的时候来找我吧。”~
@103953 = ~再见。~
@103954 = ~“你愿意加入我吗？”~
@103955 = ~“嚯，头！杜尔南想要知道这事，你不觉得吗？如果海拉斯特失踪了，那可是个大消息！德金想知道他到哪去了？”~
@103956 = ~“我们应该告诉杜尔南这件事，<CHARNAME>。他想知道海拉斯特已经放弃了山下地城。当然，我们也要想法搞清楚他到哪里去了。”~
@103957 = ~“杜尔南想要听到与此有关的消息，<CHARNAME>。当然，我们也要想法搞清楚这个巫师到哪里去了。”~
@103958 = ~“德金知道你的感受。就因为我是个狗头人，人们对我很坏。但是如果他们让德金唱歌给他们听，那么它们可能就不会那么恨我了。”~
@103959 = ~“哈，头，也许你是对的。德金就像是一坛好酒……在你的地窖里呆得越久就越香醇。”~
@103960 = ~“唔……也许头是对的。有些人对音乐并不欣赏。”~
@103961 = ~“哈，那对我来说也很困难。人们只看了一眼就认为我是个小偷。”~
@103962 = ~“哈，但是他们不知道！如果人们对我抱有怀疑的话，倒是一件好事，那会使得从他们身上偷东西容易得多。好了，你现在打算到哪里去？”~
@103963 = ~“我也有同样的问题。人们看到了我非同寻常的美丽，但是他们认为我只有身体而没有大脑。但是，像你一样，我发现我可以利用这一点。”~
@103964 = ~半兽人叹了口气，“一个我非常熟悉的故事。恐怕太熟悉了。”~
@103965 = ~“人们只是需要时间来适应你，德金。”~
@103966 = ~“否则他们可能会更加痛恨你。”~
@103967 = ~你是一个盗贼。~
@103968 = ~“海拉斯特应该知道这事可能会在某天发生的。即便是一个大法师，山下地城也是一个难以控制的地方。”~
@103969 = ~“战斗和杀戮是怪兽们最擅长的。海拉斯特应该不要期望他们会做别的。”~
@103970 = ~“更别提黑暗精灵攻击地面的事了。”~
@103971 = ~“哈，当你的死亡地下城变得一团糟时，你会痛恨它的。”~
@103972 = ~“德金知道你的感受。有时候头会解释一下，但是有时候德金觉得自己是打火星来的，一点都不明白其中的道理。”~
@103973 = ~“你不担心。头可以想个计划来拯救疯法师，头是个作计划的好手，对吧，头？”~
@103974 = ~“海拉斯特也许觉得那会让你更加顺从。我发现这种想法对人也同样适合：越沉默的人，越容易让他们做我想要的事情。”~
@103975 = ~“我们都有自己的天分。显然你的优点就是，唔……你的优点。”~
@103976 = ~“亲爱的，你真可怜，海拉斯特没有给你更多的思维能力是个耻辱。”~
@103977 = ~“哈，我们看得出来，伙计。也许海拉斯特在他把你缝起来的时候用完了好的大脑，于是只好用个陈旧腐朽的。”~
@103978 = ~“哈，当你有大个子朋友的时候，人们就会对好好对你。这就是为什么当头在身边时德金从不担心的原因。”~
@103979 = ~“我确信他们会的。通过挑选法师的跑腿童仆而继续他坏的一面……唔，我是说，跑腿魔像。”~
@103980 = ~“但是你是一个魔像，你怎么会有父亲呢？”~
@103981 = ~“你是一个魔像，是制造品。你怎么会有父亲呢？”~
@103982 = ~“对不起，亲爱的，但是你并不是真的有父亲。你是一个魔像。”~
@103983 = ~“莉努就是个典型。老是帮助那些需要帮助的。”~
@103984 = ~“我对你期望很高，莉努。你一直帮助那些有需要的人。”~
@103985 = ~“嗨，头……这是酒店中的那位精灵牧师女士吗？你好，精灵牧师女士。你记得德金，对吧？不记得了？那么，你一定记得头，对吧？<CHARNAME>·<CHARNAME>？来自酒店？”~
@103986 = ~“莉努，我很高兴你还活着……和我一样，感谢<CHARNAME>·<CHARNAME>。你还认得来自酒店的<HIMHER>，对吧？”~
@103987 = ~“莉努，我很高兴你还活着……和我一样，感谢<CHARNAME>·<CHARNAME>。你还认得来自酒店的<HIMHER>，对吧？”~
@103988 = ~“没什么个人私事。我只是对你有一种不好的感觉。”~
@103989 = ~沙尔文悲伤地摇了摇头，“我理解一个巫师可以拥有超自然的仆人，但是为什么海拉斯特会有人类奴隶呢？”~
@103990 = ~“普通的人类奴隶对于像海拉斯特这样拥有强大力量的人来说有什么用呢？这只能是他在滥用其力量；他保有奴隶仅仅因为他能够这样做。”~
@103991 = ~“你是奴隶？那真不幸。德金不赞成奴隶制度。除非主人既允许奴隶唱歌跳舞，又允许他们讲故事。以前的主人就是这样对德金的。我想，那样也不错。”~
@103992 = ~“不幸的是，我们的任务根本与唱歌跳舞无关。海拉斯特喜欢其他更致命的娱乐。他喜欢看着冒险者死去；为此他创造了山下地城。”~
@103993 = ~半兽人如释重负，“明智的决定。那些黑暗精灵不会知道是什么攻击了他们。实际上，我现在就想与他们战斗。”~
@103994 = ~“选择在你的手上，<CHARNAME>。实际上，我期望着这场战斗，干掉黑暗精灵让我觉得高兴。”~
@103995 = ~“我确信你作出了正确的决定，亲爱的。我们可以对付一小群黑暗精灵；实际上，我期望着打败她们。”~
@103996 = ~“那正是汤米喜欢听到的。如果要我在爬过湿软的臭虫隧道跟与黑暗精灵作战之间选择，那么我想选择后者。”~
@103997 = ~“你想要战斗而不是潜入，头？好吧，如果头想要战斗，那么德金也一样！”~
@103998 = ~半兽人摇了摇头，脸色苍白。“我想这事个坏主意。”~
@103999 = ~“那么我想我的意见没什么用，是不是？好吧，至少我知道自己的立场。”~
@104000 = ~“你是我们的头，<CHARNAME>。我只是希望你作出了正确的选择。”~
@104001 = ~“如果你确定了，亲爱的，那么我想我们就试试你的方法。”~
@104002 = ~“很好的选择，头。臭虫人看起来很可怕，但是德金认为他们比黑暗精灵要好。”~
@104003 = ~“要是隧道塌陷了怎么办？要是我们在下面迷路了怎么办？要是那里没有空气怎么办？”~
@104004 = ~“我不这么认为，亲爱的。我确信这……生物……没有恶意，但是我想穿越他们的隧道并不是个合适的做法。”~
@104005 = ~“我个人并不喜欢爬越一个超大的臭虫隧道！我们可能会越到太多恶心的东西。”~
@104006 = ~“虽然我完全是为了避免和黑暗精灵战斗，但还是不喜欢挤着身子穿过巨型蚂蚁的隧道。”~
@104007 = ~“德金喜欢这个主意，头。黑暗精灵不好惹。偷偷的溜过去比和他们战斗要好得多。”~
@104008 = ~“杜尔南想要听到与此有关的消息，<CHARNAME>。当然，我们也要想法搞清楚这个巫师到哪里去了。”~
@104009 = ~“我们应该告诉杜尔南这件事，<CHARNAME>。他想知道海拉斯特已经放弃了山下地城。当然，我们也要想法搞清楚他到哪里去了。”~
@104010 = ~“嚯，头！杜尔南想要知道这事，你不觉得吗？如果海拉斯特失踪了，那可是个大消息！德金想知道他到哪去了？”~
@104011 = ~主母之鞭+7~
@104012 = ~头骨钥匙~
@104013 = ~这把钥匙可以打开走出沉睡群王大厅的门。~
@104014 = ~黑暗精灵长官之钥匙~
@104015 = ~铜钥匙~
@104016 = ~战斗嚎叫第二组~
@104017 = ~地下幽室之呻吟~
@104018 = ~死亡序曲之特效~
@104019 = ~召唤序曲之特效~
@104020 = ~小型熔岩之炉~
@104021 = ~中型火把之焰2~
@104022 = ~瀑布大洞穴~
@104023 = ~瀑布洞穴~
@104024 = ~损坏的黑暗精灵战炮~
@104025 = ~娜西拉靠近了你，她自称是一个神秘的反抗组织的代表，这个组织正在反抗进攻深水城的黑暗精灵。据娜西拉所说，进攻深水城的军队被一个强大的家族主母所控制，人们只知道这个主母叫做瓦纱瑞丝。娜西拉还说瓦纱瑞丝抓获了海拉斯特，并把他关起来当作囚犯。
如果娜西拉说的是实情，那么在你拯救深水城的使命中就多了一位盟友。但是如果她在撒谎，那么信任她将是非常致命的……~
@104026 = ~达尔兰不很情愿地同意原谅你先前对他荣誉的攻击，你救了其性命这个事实可能对他作出这个决定影响很大。~
@104027 = ~这件圣物自从你在影界找到以后——也许是它找到了你——就成为你的了。
收割者之遗物将会把你传送到一个结界空间，那里被一个称作收割者的神秘生物所控制。利用这件圣物你可以将一个地点与收割者领地的一扇门绑定在一起，这样就可以让你瞬间传送至那里。收割者也会在你濒临死亡的时候把你救到它的领地去。不管是绑定还是拯救，都要消耗掉一颗游荡石。更多的信息可以从收割者本人那里得到……但是你的神秘仆人从不愿意透露遗物的真实特性，甚至它自己的本性。~
@104028 = ~你让沙尔文重新恢复生命，她决定回到“敞开大门”，而不是一个人呆在山下地城中。~
@104029 = ~虽然你将沙尔文从坟墓中拉了出来，她看起来也不太喜欢你。她可能会回到“敞开大门”，虽然到了那里她也不见得会有什么好听的跟你说。~
@104030 = ~沙尔文拒绝接受你对她的侮辱所作的道歉，明确表明她不想宽恕也不会忘记。~
@104031 = ~沙尔文不很情愿地同意原谅你先前对她所说的那些难听的话，你救了其性命这个事实可能对她作出这个决定影响很大。~
@104032 = ~你决定杀死沙尔文，尽管你刚刚把她从相似的情形下救出来。然而一旦你和她的交往结束了，那么她可能会一直处于死亡状态。~
@104033 = ~你救活了汤米，然后他回到了“敞开大门”，而不是独自呆在山下地城里。~
@104034 = ~虽然你将他从坟墓中拉了出来，他看起来也不太喜欢你。他可能会回到“敞开大门”，虽然到了那里他也不见得会有什么好听的跟你说。~
@104035 = ~汤米拒绝接受你对他的侮辱所作的道歉，明确表明他不想宽恕也不会忘记。~
@104036 = ~汤米不很情愿地同意原谅你先前对他所说的那些难听的话，你救了其性命这个事实可能对他作出这个决定影响很大。~
@104037 = ~你决定杀死汤米，尽管你刚刚把他从相似的情形下救出来。然而一旦你和他的交往结束了，那么他可能会一直处于死亡状态。~
