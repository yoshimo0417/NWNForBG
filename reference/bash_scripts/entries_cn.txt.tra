@108622 = ~洛梅利沙尔~
@108623 = ~这个翼精灵穿着一件圣职者袍，但是袍子上面的神圣符号似乎被有意地污损了。~
@108624 = ~疾病触发器~
@108625 = ~陷阱触发器~
@108626 = ~卓尔卫兵~
@108627 = ~靡菲斯特~
@108628 = ~扬希尔~
@108629 = ~夸撒拉~
@108630 = ~神秘的橘色火焰吞噬着这些书本，令其上记载的知识不复存在。~
@108631 = ~反抗军营地：一支军队由此而生~
@108632 = ~废弃的入口~
@108633 = ~拟态怪巢穴~
@108634 = ~幽城魔影~
@108635 = ~刮风的战场~
@108636 = ~冰原之下~
@108637 = ~冰封巢穴~
@108638 = ~幽暗地域：战争狂潮~
@108639 = ~要塞庭院~
@108640 = ~卡尼亚最深的荒地~
@108641 = ~宝石大厅~
@108642 = ~冰封洞穴~
@108643 = ~谜题者之墓~
@108644 = ~“敞开大门”：靡菲斯特征服地表~
@108645 = ~结尾单元~
@108646 = ~卡尼亚荒地深处~
@108647 = ~地下拱顶~
@108648 = ~卡尼亚荒地~
@108649 = ~这个装置被重新设置到了一个新的位置上。~
@108650 = ~“保持那样，老大，一切都会变好的……德金说‘开火’！”~
@108651 = ~“让开，换德金来。”~
@108652 = ~“换个方向，老大！你都打到后面去了“~
@108653 = ~“低点，低点！”~
@108654 = ~“不，瞄得再高些，老大！”~
@108655 = ~传奇到此为止。~
@108656 = ~你的传奇将一直萦绕在这个以英雄和恶霸同样辈出而闻名后世的时代中。书吏们将在布满尘灰的古籍中读到你的事迹，并为曾有这么一位走遍托瑞尔的冒险者感到惊奇。~
@108657 = ~但是，传奇结束了，历史并没有结束。在古书中，记载了你和你的伙伴们日后的命运，以及你们的故去对世界的影响。~
@108658 = ~而至于沉睡者，很少有人为他的死而哀悼。天使们早已忘记了他，在巴托也没人喜欢他。在遥远的混沌海位面，一些吉斯泽莱人仍然试图按照他教导的方式生活，也许，还记得他的人只有那些仍然吟唱着你们传奇的吟游诗人。对他们来说，他是一个为了所谓的爱情而赌上并失去了一切的悲剧人物。~
@108659 = ~幽灵艾瑞贝丝在令人兴奋的战利品中与你一道狂欢。她青春永驻，美貌和对你的虚情假意未因岁月而有丝毫减退。受她的真名之命，她忠实地扮演着你的爱侣，直到你老朽不堪。在你撒手人寰时，她俯下身来，在你的耳朵上咬下一块肉，“我会在地狱等你的，我的爱人。”她低语道。你死后她很快不知所踪，有传说说你们在地狱里再次碰了面，正如她的诺言。接下来发生了结果无人知晓的惨烈战斗……~
@108660 = ~受她的真名之命，幽灵艾瑞贝丝永葆着青春美丽，直到你老朽不堪，就要咽气。在你弥留之际，她俯下身体，在你的耳畔低语：“地狱见，亲爱的。”~
@108661 = ~娜西拉终于离开了幽暗地域，但她在地面上也没有得到自由。被你用真名的力量所永远束缚，她被迫背弃了伊丽思璀和先知。她成了你意志的永恒奴隶，只能唯命是从刺杀任何阻碍你计划的人。同时暗暗计划对你的无望复仇。~
@108662 = ~你拒绝给瓦伦完全的自由。他放弃了探险的梦想，终其一生为你的奇想所役使，他宣称爱着你，但在他逐渐成为自己从前的影子，一具没有灵魂的躯壳的事实面前，这一誓言显得益发苍白空洞。他很快衰老得与年龄毫不相称，他对战斗荣光的热爱早已被单调无聊的生活消磨殆尽，最后死在睡梦中。~
@108663 = ~“我的背酸痛得要命。”~
@108664 = ~“别靠近采石场办公室。戈鲁乌现在心情很坏。”~
@108665 = ~“得回去工作了。戈鲁乌的命令……”~
@108666 = ~“别烦我，好不容易能休息会儿。”~
@108667 = ~“这是恶魔发出的声音……锻造着铁链……哐！”~
@108668 = ~“唔？没时间和你聊天。戈鲁乌说门已经打开了。将军命令我们准备好打一场恶战。我们要在内层位面开辟新的战线。”~
@108669 = ~一行魔鬼采石场工人。在城市中到处可见，但集中在采石场周围。~
@108670 = ~“小点声，<CHARNAME>。这样谈论那事儿会让我们送命的。”~
@108671 = ~“唔？没时间和你聊天。戈鲁乌说门已经打开了。将军命令我们为血战做好准备。我们要在内层位面开辟新的战线。”~
@108672 = ~“只不过是一个正在作恶的魔鬼，<CHARNAME>。不想插手的话，最好离开的远远的。”~
@108673 = ~“以最罪孽深重的灵魂为燃料的火焰，我听说过这个。”~
@108674 = ~“快点，我们走吧。他什么也不知道。”~
@108675 = ~“必须承认，导师的信仰吸引了我的兴趣。”~
@108676 = ~“哈哈！这真有趣，头儿！我们找到靡菲斯特以后就这么对付他，怎么样？”~
@108677 = ~“改变主意了，<CHARNAME>？”~
@108678 = ~“让我们把他和同类清除出这里吧。”~
@108679 = ~“这个死活不动，我说我们干脆干掉他。”~
@108680 = ~“老大，你自己去和他说吧！”~
@108681 = ~“你告诉他吧，头儿！”~
@108682 = ~“后面的路你得自己走了<CHARNAME>……”~
@108683 = ~“我知道是你拆毁的，你这个多事的家伙！！！问题是，九渊在下，你到底想干什么？！”~
@108684 = ~“就像我上次告诉你的，笨蛋！我有那么多小魔鬼，但是在这里只有一个，你的明白！？”~
@108685 = ~“你自己告诉他吧，头儿！”~
@108686 = ~“不，头儿，不！德金不想走！”~
@108687 = ~“先知看错你了，<CHARNAME>。你这种肮脏阴暗的灵魂会毁掉我们所有人……”~
@108688 = ~“你死定了，叛徒！别再从你的脏嘴里吐出我的名字……”~
@108689 = ~“黑暗是我们的熟人，然而，但愿神将他们的复仇倾斜在你的灵魂之上……”~
@108690 = ~“你活不了几天了，<CHARNAME>。好好数着过吧。”~
@108691 = ~“以我血脉之名起誓，不要在敌人中间麻痹我！”~
@108692 = ~“你敢！就算我生来就要受奴役，也要在我的家乡，和我的族人一起，而不是在这个寒冷的荒原中，让这凶暴的魔鬼做我的主人！”~
@108693 = ~“头……头儿？Pi你要找人代替德金？”~
@108694 = ~“不，<CHARNAME>，这是邪恶的！哪怕想一想都令人作呕！”~
@108695 = ~“来啊，<CHARNAME>……你有种就过来……”~
@108696 = ~“不要受引诱，<CHARNAME>。正直者决不可相信魔鬼。”~
@108697 = ~“我是该称赞你的好奇心呢，还是该割开你的喉管，<CHARNAME>？”~
@108698 = ~“不！不要把德金卖为终身奴隶，头儿！让我记录你的传奇冒险经历吧！”~
@108699 = ~“我讨厌这个，<CHARNAME>，不想掺和进去。”~
@108700 = ~“别和无赖谈条件，<CHARNAME>！把他的头敲到腔子里去，要不就闪开些，让我来！”~
@108701 = ~“什么！？”~
@108702 = ~“从巴托的魔爪下拯救的又一个灵魂！泰尔以你为荣，<CHARNAME>。我们都以你为荣。”~
@108703 = ~“嘿嘿，听说我们魔鬼得感谢你打开了通道，你这卑微的臭鼬！我已经传话给首都的将领们，并且得到了将在血战中发起一次大型进攻的命令！”~
@108704 = ~“但我有一点时间，让我以感激之心给你一些建议。另外，我听过关于你的传说……”~
@108705 = ~“但是我已经把它大卸八块了！”~
@108706 = ~“但是这里有一个小魔鬼！”~
@108707 = ~“我知道有的战士在每场战斗前，都在自己身上划出伤痕。他们说这能给他们勇气来面对即将来临的杀戮。”~
@108708 = ~“信仰忠诚的蠢货，除此之外他们一无是处。”~
@108709 = ~“说来可就话长了。在城镇的西北角有座神殿，以后我可以带你去。”~
@108710 = ~“当心点，小家伙，你只会让自己受伤更重。”~
@108711 = ~“我知道有的战士在每场战斗前，都在自己身上划出伤痕。他们说这能给他们勇气来面对即将来临的杀戮。”~
@108712 = ~“信仰忠诚的蠢货，除此之外他们一无是处。”~
@108713 = ~“说来可就话长了。在城镇的西北角有座神殿，以后我可以带你去。”~
@108714 = ~“伤的很严重，<CHARNAME>。记得你的承诺。”~
@108715 = ~“看起来不太好，<CHARNAME>。我看看能作些什么。”~
@108716 = ~“这会教他知道……”~
@108717 = ~“他很能忍受疼痛……”~
@108718 = ~“我认为处理这事只有一个办法。”~
@108719 = ~“<CHARNAME>·<CHARNAME>！”~
@108720 = ~“呀！”~
@108721 = ~“消失了……我们可怜的领队消失了……”~
@108722 = ~“被吞噬了……消失在一阵白色闪光中。”~
@108723 = ~“那只是时间问题……”~
@108724 = ~幽灵抬起头来，目光穿透你的身体，就像你不存在一样。~
@108725 = ~“哪儿都好……好冷“~
@108726 = ~“门打开了……我要回家……离开这地狱般的寒冷……去作作祟……如果我还记得家在哪儿的话……也许我先离开这儿再说……然后试试看还能不能找到……”~
@108727 = ~1-LINER GHOST。妇女和老人。好几个。城里到处可以见到，不过在大门口比较集中。~
@108728 = ~“你介意有人同行么？”~
@108729 = ~“如你所愿，<CHARNAME>。”~
@108730 = ~我们得马上走，已经有很多人领先我们了。”~
@108731 = ~“得大开杀戒了，<CHARNAME>。让这地狱名副其实吧。”~
@108732 = ~“那你独自出发吧。当我发现你被穿在魔鬼的长枪上时，不要看着我哀求仁慈。”~
@108733 = ~“我想我开始喜欢你了。”~
@108734 = ~“你得先把队伍里的弱者清除出去。这么庞大的队伍不适合在地狱里旅行。太多的负担只会让我们行动迟缓。”~
@108735 = ~“以善之名，你愿意接纳一个曾经堕落，终获救赎的泰尔圣武士与你共同作战么？能为你服务我将倍感荣幸。”~
@108736 = ~“那么我会守护这儿，为善开辟一块生长发芽的土壤。”~
@108737 = ~“那么让我们出发吧。别放松警戒，在这儿邪恶的力量占有压倒优势。”~
@108738 = ~“你精简完队伍后回来找我，要开始地狱之行，我们必须精干高效。”~
@108739 = ~“不错，我刚到这儿时曾经学习过它们，那时我正努力搞明白这儿的状况。恐怕我除了最后一条外，都忘得差不多了，但是最后那条，我想我恐怕永远也忘不掉了。”~
@108740 = ~“导师的第五条谜题的答案就埋藏在他沉睡之处脚边的石中：‘她会在卡尼亚之门处找到你’，这些字句一直萦绕在我的耳旁，直到现在我仍然无法摆脱它们。”~
@108741 = ~“信仰只是愚人的游戏，<CHARNAME>，我投入其中的时间已经长到够看穿把戏了。梦汉的梦不过是同旁人的梦一样能被粉碎的梦罢了。”~
@108742 = ~“不过如果你非得知道的话，我仍然记得导师的最后谜题。‘答案是什么？’她问……‘她会在卡尼亚之门处找到你。’做你想做的事情吧。”~
@108743 = ~“我和你一起。走吧，我们要做的事儿还多着呢。”~
@108744 = ~“我会原谅你，但我不会忘记这个……我们走吧。”~
@108745 = ~“德金的真名！你想让我干嘛，头儿？”~
@108746 = ~“没事？什么事都没有？要德金说的话，这可真是浪费真名力量的妙用啊。老大，你花费了多少在上面？噢对了，我们还得完成探险呢，别磨蹭了。”~
@108747 = ~“头儿？”~
@108748 = ~“是的，头儿。德金没事儿……挺难过，不过没事儿。你准备赴死了么，头儿？”~
@108749 = ~“不错，头儿。德金相信自己。还有事么？”~
@108750 = ~“呃……头儿？德金很需要这个灵魂。他只有这一个，看到了么？这真是你想要的么？”~
@108751 = ~“噢！你刚才可吓得德金够呛，头儿。看来真名这玩意儿可不那么有趣……还有其他给我的指示么？”~
@108752 = ~“唷……好，头儿，什么都在……再见……这么长时间了，而且要谢谢你的鱼肉……不要撞到门……啊啊啊！”~
@108753 = ~听到这些字眼，瓦伦瞪大了眼睛。“我的真名，”他承认，眼神混合着愤怒和恐惧，“你准备……指示我做什么？”~
@108754 = ~他对你鄙夷地嗤道：“你要强迫我爱你么，女士？哪怕是我们共同经历了这一切以后？”~
@108755 = ~瓦伦好奇的盯着你，似乎并没有完全理解你刚才的话……突然他的眼睛瞪大，身体僵直，身体上四处奔流着电光。~
@108756 = ~片刻之后，他开始抽搐，一团奇怪的黑色发光物质从他的身体上升起，逐渐烟消云散。当他再度睁开眼睛时，整个人都显得与以前似乎有所不同，那神秘的光环，灵魂深处的怒火……，全都消失了。~
@108757 = ~“我……我简直不敢相信！”他难以置信地盯着自己，渐渐露出了微笑。“那污点……消失了！这感觉真美妙！我感觉再世为人了！”瓦伦欢笑着拥抱了你。“谢谢！谢谢你给我的这份珍贵礼物！”~
@108758 = ~瓦伦的眼中闪过危险的红光。“取走我的灵魂，”他咆哮道，“这意味着我生命的终结。确定这真是你的愿望么？”~
@108759 = ~瓦伦点了点头，如释重负。“谢谢你，<LADYLORD>。请不要再向我索求了，我恳求你。”~
@108760 = ~就在你的眼前，瓦伦开始剧烈地战抖。随着生命精华的被突然剥夺，他发出愤怒痛苦的尖叫，身体很快化为一堆尘土。你得到了瓦伦的灵魂。~
@108761 = ~他困惑地盯着你，道：：“我很感激你，女士，但是……你真的要强迫我爱你么？哪怕那根本不是真爱？”~
@108762 = ~他把目光移往别处，不愿直视你的眼睛。“还有别的事么，女士？”~
@108763 = ~瓦伦用他深邃的蓝色眼睛盯着你，牙齿咬得咯咯作响，道：“那好吧……我亲爱的，你对我的主宰没有界限。但是一旦我获得自由……我就会杀了你，我保证。”~
@108764 = ~瓦伦的眼中现出如释重负的神情。“谢谢，<CHARNAME>。我感激不尽。现在……如果我们还想援救深水城的话，就得立刻穿越大门。”~
@108765 = ~他盯着你，眼睛逐渐转为血红……，但他一言不发，慢慢地握紧了双拳，又松开了。~
@108766 = ~瓦伦奋力抵抗着你的意旨，但最终放弃了。他靠了过来，两眼紧闭，温柔地吻上你的双唇。当你们分开时，他双颊热泪长流。~
@108767 = ~“但愿这能令你高兴，我的女士。”他啐道，拒绝直视你的眼睛。~
@108768 = ~他停了下来，目光直射入你的眼睛深处，表情突然充满爱意。他靠了过来，温柔地吻了你。“我想就是这儿了。”~
@108769 = ~“深水城在等待着我们，亲爱的。我们在这儿耽搁得越久，受到靡菲斯特祸害的人就越多……必须阻止他。”~
@108770 = ~现在微笑经常出现在他的嘴边。“你不知道，<CHARNAME>。就像……就像是突然减去了肩上的重负一样。”~
@108771 = ~“谢谢你，<CHARNAME>。我永远无法报答你的恩情。现在……如果我们想援救深水城的话，得赶快穿越大门。”~
@108772 = ~“我的真名……？你……你想对我干什么？”~
@108773 = ~“这我就放心了。现在我们得赶紧穿越大门，回到托瑞尔，如果我们拖得太久，靡菲斯特会毁掉整个深水城的。”~
@108774 = ~她的黑眼中出现了恐惧的神色，说：“但是向你献出我的灵魂，就意味着我的死亡。没有了它我将化为尘土。你真的知道自己索求的是什么吗，<CHARNAME>？”~
@108775 = ~“感谢你的仁慈，我的主人。我恳求你，不要再向我索取任何东西了。”~
@108776 = ~随着生命精华的被剥夺，黑暗精灵发出痛苦的尖叫。就在你的眼前她迅速地枯萎，老去了千年韶华，先是皮肤干缩，眼睛内陷，接着整个身体化为一堆枯骨和尘土。你得到了娜西拉的灵魂。~
@108777 = ~黑暗精灵把头猛地向后仰，发出痛苦失望的叫声，她咬牙切齿地说道：“你要强迫我爱你？你到底是什么，你这头禽兽？”~
@108778 = ~“我的真名给你主宰我的权力，<CHARNAME>。无论你怎么滥用你的力量，我都得被迫服从，但一旦我获得自由，我就会杀了你！你还有什么侮辱我的把戏么？”~
@108779 = ~她厌恶地往地上吐了口唾沫，这是她唯一能违背真名力量而做的事。“完事了么？”~
@108780 = ~她发出愤怒的叫声，但仍然不得不遵从你的命令。吻了以后，她掉头就走，不敢再面对你。显然你彻底击垮了她的精神。~
@108781 = ~“你答到要点了，<CHARNAME>，”她用极其细微的声音说道，“现在我们必须了解你对诱惑者的力量和对我的一样是否完全相同。你对我还有什么要求？”~
@108782 = ~娜西拉惊讶地瞪大了眼睛。看起来她似乎在试图抵抗什么，紧接着她低下了头。当她再抬起头来时，脸上的表情很奇怪。~
@108783 = ~“我的……我的罪恶感消失了，”她惊喜地说道，“它消失的无影无踪，就像从未存在过一样，我……我自由了。谢谢你，<CHARNAME>；你给了我一份无可替代的礼物。”~
@108784 = ~“但是尽管有你的热心，我仍然要找到这个……使人不安的。一个真实名字的力量就是一个伟大的职责-一个我不希望你忽视的职责。你要有什么希望我做的？”~
@108785 = ~“是，<CHARNAME>。”~
@108786 = ~“那我呢，<CHARNAME>？我也一样只是你的玩物么？”~
@108787 = ~“这不是个好故事，不过我现在暂时相信它。如果我们能活过与靡菲斯特的战斗，我想我们有必要好好谈谈了。”~
@108788 = ~“然后凭你的直觉，<CHARNAME>。她不过是个鬼魂，是个虚无的梦！她身上没有任何值得你爱的东西……回到我身边吧。你要信守诺言。”~
@108789 = ~“全心全意？那你对我山盟海誓时倒是用的谁的心？那个睡着了的男人的？”~
@108790 = ~“你相信靡菲斯特情人的说辞？那我呢？你有了我的爱还不够么？”~
@108791 = ~“看看嫉妒驱使你做了什么，黑暗精灵！？你真是个自私的小姑娘！别以为胸脯大了就算个女人……愿神饶恕你的愚行！”~
@108792 = ~“收起你那套说教吧，幽灵。等我和<CHARNAME>杀死靡菲斯特后你最好马上消失，我对你说教的耐性到那为止了……”~
@108793 = ~“好极了……如果你蠢到爱上了她，那我又有什么资格/义务阻止你的愚行呢？我踏入那扇门，是为了我自己，而不是为了你……也许本来就该这样。”~
@108794 = ~“如果事情都如它们所应该的那样的话，你也不需要回来了，幽灵……走吧，亲爱的，在托瑞尔还有使命等着我们。我想看看你向我描绘过一次又一次的地面世界的模样。”~
@108795 = ~“你有什么要说的，<CHARNAME>？游戏很愉快，不过已经结束了！我在托瑞尔还有未了之事才踏入那扇门，别以为是为了你……”~
@108796 = ~“你这头自大的……种猪！如果这是在下面幽暗地域里，我会因为这些话把你杀了！现在这门不过是我去往地表世界的通行证，仅此而已……想想自己真是瞎了眼，怎么会爱上你这条可怜虫……”~
@108797 = ~“看到了么，艾瑞贝丝？他的床上给我们两人都留下了位置！是什么让你如此害怕？”~
@108798 = ~“不知是哪儿出了问题但是我爱你，<CHARNAME>。拥有你的一半感情总好过一无所得。”~
@108799 = ~“德金的真名！你想要我做什么，头儿？”~
@108800 = ~“没什么？真的没什么？那真是对真名的浪费，如果你问德金。你还会在上面花多少钱，头儿？哦，行，我们的冒险结束了，快点啦。”~
@108801 = ~“头儿？”~
@108802 = ~“是的，头儿。德金没事儿……挺难过，不过没事儿。你准备赴死了么，头儿？”~
@108803 = ~“不错，头儿。德金相信自己。还有事么？”~
@108804 = ~“呃……头儿？德金很需要这个灵魂。他只有这一个，看到了么？这真是你想要的么？”~
@108805 = ~“噢！你刚才可吓得德金够呛，头儿。看来真名这玩意儿可不那么有趣……还有其他给我的指示么？”~
@108806 = ~“唷……好，头儿，什么都在……再见……这么长时间了，而且要谢谢你的鱼肉……不要撞到门……啊啊啊！”~
@108807 = ~瓦伦听到这个词，眼睛都睁大了。“我的真名，”他承认，目光中流露着即愤慨而敬畏的神情。“你打算怎样……命令我？”~
@108808 = ~他带着憎恶的表情讥笑你。“你要强迫我爱你吗，女士？尽管我们已经不再有关系了。”~
@108809 = ~瓦伦好奇地看着你，似乎不甚明了你所说的……而后，他突然睁大了眼睛。他僵住了，一股猛烈的电流穿过了他的身体。~
@108810 = ~片刻之间，伴着他的痉挛，他的身体上升起一种奇异的黑色光泽，并弥散开来。当他睁开眼睛时，有些事情……已经不对劲了。重生的光晕，他灵魂中的愤怒……一切都已散去。~
@108811 = ~“我……我真不敢相信！”他疑惑地看着自己，渐渐笑了。“污染……全没了！我现在……感觉棒极了！我感觉获得新生！！”瓦伦抱着你，快活地笑了。“谢谢你！谢谢你给我的奇妙礼物！”~
@108812 = ~瓦伦眼中闪现出一抹危险的红色。“带走我的灵魂吧，”他咆哮着，“我也将就此终结。永久地。你确定这就是你想要的？”~
@108813 = ~瓦伦点点头，放心了。“谢谢你，<LADYLORD>。请……不要再问我了，求你了。”~
@108814 = ~在你眼前，瓦伦开始猛烈地晃动。他带着全部的愤怒和苦恼尖叫着，仿佛他的生命力被一下子抽掉了一样。他的躯壳化作了众多的尘埃，消散了。~
@108815 = ~他困惑地盯着你。“我很感激，女士，不过……你要强迫我爱你么？即使那根本不是真爱？”~
@108816 = ~他目光移开，不愿与你目光相对。“还有什么事么，女士？”~
@108817 = ~瓦伦用他深情的蓝眼睛注视着你，紧抓他的爪。“就这样吧……我的爱。你对我的无限控制。要是我能给我自己自由，无论如何……我会杀了你。相信我吧。”~
@108818 = ~瓦伦的目光流露出一丝安慰。“谢谢你，<CHARNAME>。我很感激。现在……如果我们要营救你的深水城，我们要尽快穿过卡尼亚之门。”~
@108819 = ~他注视着你，眼中泛起暗红之色……但他什么也没说。慢慢地，他戴着护手的拳头，收紧而又放开。~
@108820 = ~瓦伦挣扎着反抗你的命令，但最后放弃了。他靠了过来，闭上了眼睛，温柔地用嘴唇亲吻着你。分开时，眼泪顺着他的脸颊淌下。~
@108821 = ~“希望这能让你快乐，女士。”他吐了口唾沫。他拒绝与你目光相对。~
@108822 = ~他停下来凝视你的眼，脸色变得深情。他靠过来温柔地亲吻着你。“我猜是有吧。”~
@108823 = ~“深水城正等着我们，我的爱。我们在这呆得越长，靡菲斯特就会伤害更多的人……我们必须要阻止他。”~
@108824 = ~现在他舒适地微笑着。“你没办法了？<CHARNAME>。这……仿佛我肩上的重量轻了很多。”~
@108825 = ~“谢谢你，<CHARNAME>。我永远不能报答你。现在……如果我们要营救你的深水城，我们要尽快穿过卡尼亚之门。”~
@108826 = ~“我的真名……那……你打算把我怎么样？”~
@108827 = ~“我……我放心了。现在赶快，我们必须穿过卡尼亚之门回托瑞尔。如果我们耽搁时间长了，靡菲斯特会把深水城全毁了。”~
@108828 = ~她黑纱后的眼神中现起了恐惧之色。“但如果我给你我的灵魂，我就会死掉。失去它，我将化作了尘埃……你确定这就是你想要的，<CHARNAME>？”~
@108829 = ~“谢谢你的仁慈，我的主人。我求求你，可是，不要再问我了。”~
@108830 = ~黑暗精灵尖叫着，仿佛她的生命力被一下子抽掉了一样。在你眼前，她一下子老了上千年，她皮肤上现出皱纹，眼睛深陷，她的身体凋萎成了一堆枯骨和尘埃。娜西拉的灵魂现在是你的了。~
@108831 = ~这个黑暗精灵的头突然转了过来，把她的痛苦与绝望哭喊了出来。她咬着牙说：“你要强迫我爱你么？你这个畜牲！”~
@108832 = ~“我的真名将我的控制权交给你了，<CHARNAME>。不管你怎么样滥用你的力量，我都被迫要服从。但如果我能找到重获自由的方法，我会杀掉你！……现在，你准备要我怎么样？”~
@108833 = ~她厌恶地朝地上吐了口痰，但她无法抗拒真名的力量。“就这些了吧？”~
@108834 = ~她愤怒地哭喊着，但还是照着你的命令做了。亲吻结束时，她掉头跑掉，无法面对你。明显地，你彻底地破坏了她的意志。~
@108835 = ~“你证明你的论点是正确的，<CHARNAME>，”她突然在你耳边低语。“现在我们必须要查明，你对靡菲斯特的控制是不是和对我的一样。你还要我做什么？”~
@108836 = ~娜西拉惊讶地睁大了眼睛。她看来想要反对，然后低下了头。当她抬起头时，脸上现出奇怪的表情。~
@108837 = ~“我……我的罪恶都没了，她惊奇地说。“消失了，就像它从来没存在过。我……我自由了。谢谢你，<CHARNAME>；你不像别人那样，而是给了我一件礼物。”~
@108838 = ~“但尽管你是善意的，我仍然觉得……有点不妥。真名的力量实在是强大，希望你不要乱用它。你还要我做什么吗？”~
@108839 = ~“是的，<CHARNAME>。”~
@108840 = ~“那我们呢，<CHARNAME>。我也是你的一个玩具么？”~
@108841 = ~“原来我也许不信，但现在我相信了。如果我们能从靡菲斯特那活下来，不管怎样，我想我们会要有次长谈的。”~
@108842 = ~“那么调整一下你的判断力吧，<CHARNAME>。她是一个鬼魂，一个梦，别的就没了！那么，有什么可爱的……回到我这来吧。要记得你说过的话。”~
@108843 = ~“出于黑心，你对皮肤的感觉突然不那么强烈了，<CHARNAME>。那我呢？我们互相说过的话都不算了？难道我对你的爱不够多么？”~
@108844 = ~“你要相信那个靡菲斯特的爱人说的话？那我呢？难道我对你的爱不够多么？”~
@108845 = ~“看看你的妒嫉都造成了什么，黑暗精灵！？你不过是个自私的小女孩！你有胸部并不代表你就是个女人了……我第一眼看到你时就该杀了你。”~
@108846 = ~“嗯，你最好赶在我和<CHARNAME>把靡菲斯特搞定之前，因为当他的血开始涌出时，我对你的宽容也就结束了。”~
@108847 = ~“很好……如果你笨到爱上她，那么你给淘汰了。我会因为自己的理由而走过卡尼亚之门，不是因为你……所有对爱情的谈论足够让我觉得想吐。”~
@108848 = ~“那就去吐吧，最好把你哽死，鬼魂……来吧，亲爱的，回托瑞尔后我们还有事要做。我想看看你和我说了很多次的地表世界。”~
@108849 = ~“你怎么样，<CHARNAME>？好，这是个不错的小游戏，不过想一下吧！如果我穿过卡尼亚之门，那是因为在托瑞尔我有未完成的事，不是因为你……”~
@108850 = ~“你这个无礼的……男人！如果这是幽暗地域，那么我会因为那些话杀了你！卡尼亚之门就是我的返乡票，现在，什么都没了……想想吧，我居然会爱上你这个小人……”~
@108851 = ~“你不能和我比，娜西拉，你最好也加入我，我不会咬伤你的。这最多是咬一小口，不是吗，<CHARNAME>……”~
@108852 = ~“你如果指望吓到我，艾瑞贝丝，再试试吧。可能你太忙没注意到，我毕竟是个黑暗精灵……让我们先分享这个男人，以后，再因为他打一场。”~
@108853 = ~“你有太多的随从了。对不起，<CHARNAME>，但我更喜欢小拨人的亲密感。”~
@108854 = ~“完了么？我们才刚开始，<CHARNAME>……”~
@108855 = ~“你让那么一帮白痴随从围着你。我拒绝和这样的队伍同行。”~
@108856 = ~“地狱有够多的朋友了，<CHARNAME>。你要再来一个么？”~
@108857 = ~“我不喜欢那人怎么谈论我和你，<CHARNAME>……”~
@108858 = ~“老大，要出大事了……德金能感觉到。”~
@108859 = ~“我被打败，被嘲笑，被教来去憎恨和去杀人！你要把我怎么样，精灵？”~
@108860 = ~“她有黑暗精灵的活力，不是吗，<CHARNAME>……”~
@108861 = ~“但你不爱他吗？”~
@108862 = ~“秘密？哦，继续！头，我把笔放哪儿了？”~
@108863 = ~“我，也是，跟在遥远的战争之旗之后行进。它会改变你，肯定是很多。”~
@108864 = ~“是的，如果你就是那些灵魂所提到的那个人……”~
@108865 = ~“哦，你是从无冬城来的么？德金知道这故事！”~
@108866 = ~“我们只是友善而诚实！”~
@108867 = ~“我的女士？我也要点头哈腰的么？”~
@108868 = ~“他们无视我们的迟到。为什么他们要宽恕你？”~
@108869 = ~“啊，沉睡者！”~
@108870 = ~“你听到了么，老大？我们吟游诗人叫它‘苦恼的少女’。”~
@108871 = ~“实际上，我宁可你不跟着我。”~
@108872 = ~“一点也不。请加入我。”~
@108873 = ~“分一半战利品给你？再想下。”~
@108874 = ~“好的，为了对付邪恶，加入我吧。”~
@108875 = ~“也许下次吧，艾瑞贝丝。”~
@108876 = ~“和你共事是我的荣誉。”~
@108877 = ~“我在寻找沉睡者的五个谜题。”~
@108878 = ~“我在寻找沉睡者的五个谜题。”~
@108879 = ~[德金]“鳞歌者伊谢利亚……”~
@108880 = ~“没什么。不要介意……”~
@108881 = ~“相信自己，德金。”~
@108882 = ~“你人不错，有天赋，有幽默感。你不再需要我了。如果我死了，你会没事的。”~
@108883 = ~“如果我帮忙就不会。来吧，我们的历险还没完呢。”~
@108884 = ~“投降吧，交出你的灵魂，小家伙！”~
@108885 = ~“如果这意味着要失去你，那么，不。”~
@108886 = ~“是的，我确定。”~
@108887 = ~[瓦伦]“恶魔斗士奥斯卡辛……”~
@108888 = ~“现在没什么事。”~
@108889 = ~“把你的灵魂交给我吧！”~
@108890 = ~“我要你永远做我的情人！”~
@108891 = ~“我因此要把你从恶魔的污染中解救出来。”~
@108892 = ~“不客气。”~
@108893 = ~“很高兴你喜欢他。把我的灵魂拿去。”~
@108894 = ~“如果这意味着要失去你，那么，不。”~
@108895 = ~“对不起，亲爱的，但这是为了我们。”~
@108896 = ~“是，我是。”~
@108897 = ~“好。现在，作为报答，你要成为我永远的情人。”~
@108898 = ~“好吧……或许不。”~
@108899 = ~“你听到我。”~
@108900 = ~“我们搞定了。暂时如此。”~
@108901 = ~“你不用恐吓我。我完全地拥有你。”~
@108902 = ~“你疯起来挺性感的。吻我吧！”~
@108903 = ~“那么毕竟我们还是有希望的吧？”~
@108904 = ~“它真的那么不同？”~
@108905 = ~“我很高兴。你的确得到它了。”~
@108906 = ~[娜西拉]“寻天者奎霏莉亚……”~
@108907 = ~“现在没什么事。”~
@108908 = ~“把你的灵魂交给我吧！”~
@108909 = ~“如果这意味着要失去你，那么，不。”~
@108910 = ~“是，我确定。”~
@108911 = ~“我要你永远做我的情人！”~
@108912 = ~“你的愤怒对我毫无意义。我完全地拥有你。”~
@108913 = ~“你疯起来挺性感的。吻我吧！”~
@108914 = ~“宽恕你自己过去的罪行吧。”~
@108915 = ~“我不会伤害你的，娜西拉。”~
@108916 = ~“我别的就不知道了，娜西拉。我不知道……”~
@108917 = ~“好吧……是的，实际上……玩具是个合理的描述。”~
@108918 = ~“不，我总是爱你的，娜西拉……”~
@108919 = ~“为什么你们俩一定要打呢？好吧，我谁都不爱！”~
@108920 = ~“成全我们吧，娜西拉。艾瑞贝丝 是我的爱人，不是你。”~
@108921 = ~“对不起，艾瑞贝丝，不过娜西拉是对的。她是我最初的也是最好的爱人。”~
@108922 = ~“我对你们俩个的爱都足够多的。”~
@108923 = ~[德金]“鳞歌者伊谢利亚……”~
@108924 = ~“没什么。不要介意……”~
