@100039 = ~“你在作恶方面干得很拿手，艾瑞贝丝。”~
@100040 = ~“难道你不想变得强大？不想为自己复仇吗？”~
@100041 = ~“泰尔选择了你作为他的圣武士，难道你怀疑他的智慧吗？”~
@100042 = ~“好吧。一旦你拥抱了邪恶，就再也无法回头了。”~
@100043 = ~“你在基于一种正义感而行动。”~
@100044 = ~“让泰尔来决定他是否会接受你吧。”~
@100045 = ~“你并不是单独行动的。”~
@100046 = ~“那么就在这地狱深处坚持公正吧。”~
@100047 = ~“那么这是泰尔的错误，不是你的。”~
@100048 = ~“如果不是为了爱，你怎么会干这件事？”~
@100049 = ~“靡菲斯特想要你那样去感受。”~
@100050 = ~“就要结婚了，你怎么还会不爱他？”~
@100051 = ~“靡菲斯特仅仅是在玩弄你的感情。”~
@100052 = ~“我也在依照自己的信条而生活。”~
@100053 = ~“但是关于道德是怎样的？关于善良和邪恶又是怎样的？”~
@100054 = ~“我想我知道你的来历。”~
@100055 = ~“为什么你试图忘掉他们？”~
@100056 = ~“我不会让它发生的。”~
@100057 = ~“行，我要注意些什么？”~
@100058 = ~“我明白。”~
@100059 = ~“你并不想要那样。”~
@100060 = ~“你为什么攻击我？”~
@100061 = ~“我以为自己知道你的来历。”~
@100062 = ~“我有些问题想要问你。”~
@100063 = ~“我相信你在犯一个错误。”~
@100064 = ~“我想要折磨你。”~
@100065 = ~“我需要你的帮助。”~
@100066 = ~“我为你感到难过。”~
@100067 = ~“你身体发冷，所以我让你变得暖和起来。”~
@100068 = ~“我在寻找沉睡者的五个谜题。”~
@100069 = ~“回答我其他的问题。”~
@100070 = ~“你是知道答案还是不知道？”~
@100071 = ~“拜托了，我的女士，你一定得帮帮忙。”~
@100072 = ~<StartCheak>[劝说]</Start>“那么告诉我答案吧。”~
@100073 = ~“诸神是怎样恶意伤害你的？”~
@100074 = ~“你爱的这个男人是谁？”~
@100075 = ~离开。~
@100076 = ~用三个维洛克斯莓燃起一堆大火。~
@100077 = ~用两个维洛克斯莓燃起一堆中等程度的火。~
@100078 = ~用一个维洛克斯莓燃起一堆小火。~
@100079 = ~夸张地说，我是个众名智者。~
@100080 = ~艾瑞贝丝~
@100081 = ~德·泰尔玛兰德~
@100082 = ~卓尔反抗军剑术大师~
@100083 = ~卓尔武器英雄~
@100084 = ~多南~
@100085 = ~布林斯本~
@100086 = ~佛拉里~
@100087 = ~布鲁舍~
@100088 = ~阿顿~
@100089 = ~斯维菲特~
@100090 = ~采石场老板戈鲁乌~
@100091 = ~显而易见的暴怒让采石场老板膨胀得像一团暴风云，四周的墙壁似乎在他苏醒的怒火中颤抖和变化。~
@100092 = ~采石场奴隶史拉蟾~
@100093 = ~这个肌肉发达的生物身躯苍白，上面留满了疤痕，那是无数次拷打的结果。这景象使得服一辈子地狱般苦役的想法越来越不吸引你。~
@100094 = ~采石场欲魔工人~
@100095 = ~欲魔曾经拥有漂亮的容颜，但现在她肤色苍白，身上满是皮革般坚韧的疤痕、曲张的静脉以及其他一些因过于艰苦的生活而留下的印记。~
@100096 = ~采石场小魔鬼工人~
@100097 = ~这个小魔鬼疲惫地拍打着他的翅膀，让它的胳膊和腿在经过一天艰苦的劳动后松软地悬垂着。~
@100098 = ~采石场小魔鬼“懒鬼”~
@100099 = ~这个迷迷糊糊的小魔鬼和研磨机发生了一次糟糕的接触，胳膊伤得非常可怕。~
@100100 = ~吉斯泽莱朝圣者~
@100101 = ~这名男子虽然样子凶恶，但是看上去好像很无聊。他那抑郁的表情似乎和他苍白的面容很相配。~
@100102 = ~这名女子虽然样子凶恶，但是看上去好像很无聊。她那抑郁的表情似乎和她苍白的面容很相配。~
@100103 = ~吉斯泽莱拾莓者~
@100104 = ~这名女子伏下身从一小簇灌木丛上摘取莓子，然后把它们放进身边的置于冰块之上的袋子里。~
@100105 = ~采石场工人之深狱炼魔~
@100106 = ~这个深狱炼魔弯着腰，长有利爪的手因为繁重的劳动而开裂和起泡了。~
@100107 = ~斯克维尔那~
@100108 = ~德哈瓦娜~
@100109 = ~沉睡者~
@100110 = ~亡者之灵~
@100111 = ~这个可怕的灵魂飞快地穿梭于存在与虚无之间，只能靠落在它身上的一层霜来依稀辨别它的外形。~
@100112 = ~客栈老板~
@100113 = ~这个客栈老板用阴沉的眼神向下打量着你。~
@100114 = ~客栈老板~
@100115 = ~这个客栈老板可能是你所见过的比较奇怪的一个。同样，这个客栈也许是最奇怪的客栈中的一个……~
@100116 = ~堕落的阿斯莫~
@100117 = ~炼狱火矮人~
@100118 = ~平民，女性（受害者）~
@100119 = ~平民，男性（受害者）~
@100120 = ~小白（受害者）~
@100121 = ~厨师（受害者）~
@100122 = ~这个“敞开大门”的厨师以如他的火炉般暴烈的脾气而出名。~
@100123 = ~麦维尔家族卓尔守卫~
@100124 = ~花岗岩怪兽~
@100125 = ~火元素侦察兵~
@100126 = ~火元素~
