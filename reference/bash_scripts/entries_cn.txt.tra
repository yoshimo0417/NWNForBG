@98028 = ~“它们通向哪里？”~
@98029 = ~“我该怎么做才能让收割者服从我的意志？”~
@98030 = ~“你说‘直到他梦见答案’是什么意思？”~
@98031 = ~“你从他那里知道到了些什么？”~
@98032 = ~“我想把沉睡者的五个谜题读一遍。”~
@98033 = ~“我不知道。”~
@98034 = ~“一个万恶的邪魔，是靡菲斯特的仆从。”~
@98035 = ~“一个血战的老手。”~
@98036 = ~“一条化作人形的龙。”~
@98037 = ~“一名精灵战争中的英雄。”~
@98038 = ~“一个天上的异界神侍，善良的生物。”~
@98039 = ~“他来自我在托瑞尔世界的故乡。”~
@98040 = ~“他来自卡赛里的监牢。”~
@98041 = ~“他来自变化多端的混沌海位面。”~
@98042 = ~“他来自天界天堂。”~
@98043 = ~“他来自极乐境。”~
@98044 = ~“他对寻找唯一真爱之事感到厌烦，走上了可怕的道路。”~
@98045 = ~“邪恶的种子在他心中萌发。”~
@98046 = ~“追求完美使他变得病态。”~
@98047 = ~“他因叛国而被驱逐。”~
@98048 = ~“他的心与爱无缘。”~
@98049 = ~“他在找寻自己的灵魂。”~
@98050 = ~“他在找你，导师，希望借助你的智慧。”~
@98051 = ~“一个以其美貌著称的女魔鬼。”~
@98052 = ~“靡菲斯特，第八重地狱的领主。”~
@98053 = ~“诸界智者。”~
@98054 = ~“‘在且仅在你的心中。’”~
@98055 = ~“‘我在这儿。’智者说。”~
@98056 = ~“‘在极乐境，那是你所抛弃的地方。’”~
@98057 = ~“‘哪儿都不是。’”~
@98058 = ~“‘她会在卡尼亚之门找到你。’”~
@98059 = ~“我还有些问题。”~
@98060 = ~“谢谢你。”~
@98061 = ~“你能告诉我有关位面的事情吗？”~
@98062 = ~“导师是什么意思？”~
@98063 = ~“你觉得你的敌人是谁？”~
@98064 = ~“你能猜透别人的心事……”~
@98065 = ~“再见。”~
@98066 = ~“我不在的时候，你和你的人进展如何？”~
@98067 = ~“他梦到什么了？”~
@98068 = ~“我已经知道了他的唯一真爱的身份。”~
@98069 = ~“回到我的其他问题上来。”~
@98070 = ~“它是一位名叫莱佛拉的星界使徒。”~
@98071 = ~“它是众名智者。”~
@98072 = ~[撒谎]“它是众名智者。”~
@98073 = ~“它是诸界智者。”~
@98074 = ~[撒谎]“它是诸界智者。”~
@98075 = ~“是我的同伴，娜西拉。”~
@98076 = ~[撒谎]“是我的同伴，娜西拉。”~
@98077 = ~“是艾瑞贝丝女士。”~
@98078 = ~[撒谎]“是艾瑞贝丝女士。”~
@98079 = ~“是你，德哈瓦娜导师。”~
@98080 = ~[撒谎]“是你，德哈瓦娜导师。”~
@98081 = ~“我是他的唯一真爱。”~
@98082 = ~[撒谎]“我是他的唯一真爱。”~
@98083 = ~“我已经知道了沉睡者的真名。”~
@98084 = ~“回到我的其他问题上来。”~
@98085 = ~“你是对的，导师。真名太危险了，应该保密。”~
@98086 = ~“那么我不会告诉你的。”~
@98087 = ~“沉睡者被称作忍耐之塞雷斯法。”~
@98088 = ~“我不懂，为什么你不想知道他的名字？”~
@98089 = ~“误导之法蕾西亚……”~
@98090 = ~“回到我的其他问题上来。”~
@98091 = ~“你是沉睡者的唯一真爱。”~
@98092 = ~“让你自己与名为阿顿·斯维菲特的泰夫林和解。”~
@98093 = ~“放弃你的信仰。忘记沉睡者。”~
@98094 = ~“我命令你叫醒沉睡者……”~
@98095 = ~石柱上刻着一个词：“极乐境”~
@98096 = ~石柱上刻着一个词：“协调。”~
@98097 = ~石柱上刻着一个词：“尺度。”~
@98098 = ~石柱上刻着一个词：“无限。”~
@98099 = ~石柱上刻着一个词：“叛国。”~
@98100 = ~石柱上刻着一个词：“交替。”~
@98101 = ~在这条龙不怀好意的凝视下，你感觉自己有些微微的失常。按你的猜测，只有在这种外位面里，这种生物才会成为旅店老板。~
@98102 = ~“你需要服务吗？”它发牢骚似地说道，它那巨大的嘴角扭曲成又像发怒又像冷笑的样子。~
@98103 = ~旅店老板就像一位真正的生意人一样露齿一笑，道：“我能酿上好的烈性维洛克斯莓酒，不过原料的供应老是跟不上需要……给我找来五个维洛克斯莓，这样你就可以得到一品脱酒。”~
@98104 = ~“我知道怎么去经营一家旅店，找来材料做我的晚餐，然后美美地喝上一杯。把剩下的菜留给像你这样的傻瓜……现在你是不是打算来上一杯？”~
@98105 = ~这条龙冷酷的笑声响彻整个旅店。你听到在后面房间有一个啤酒杯打碎的声音。“不要挣扎了，傻瓜。找张椅子坐下然后喝上一杯，你得住在这里。”~
@98106 = ~你在这位旅店老板的视线中看到了一丝寒意。“戈鲁乌和我有一个协议，是关于下班的采石场工人的，所以这里就是他们花钱的地方。有些灵魂也会来这里，魔鬼才知道为什么。”~
@98107 = ~“就拿这些吉斯泽莱人来说，他们都是新来的，除了带来麻烦以外什么都没有，酗酒好像就是他们生命里唯一剩下的东西了。不过和他们在一起的那个有翅膀的家伙，他喝得很凶很快。我倒是希望他有钱付帐……”~
@98108 = ~龙温暖的呼吸闻起来就像腐烂的尸体散发的气味。你想也许你可以在它的齿缝里找到某人的大腿。“你是说睡觉？也许用长眠不醒更适合……”~
@98109 = ~“再见。”~
@98110 = ~“你有什么能御寒的东西吗？”~
@98111 = ~“没关系。”~
@98112 = ~交出五个维洛克斯莓。~
@98113 = ~“你知道收割者的真名吗？”~
@98114 = ~“我要回到我在托瑞尔世界的家。”~
@98115 = ~“告诉我有关你的老主顾的事情。”~
@98116 = ~“我在找沉睡者的五个谜题。”~
@98117 = ~[查看商店]“你有什么？”~
@98118 = ~沉睡者用优雅的草体书在这张卡片上写着的一段祈祷文：   孩提时代，我学会希望。
   成人之后，希望成熟为信仰。
   当我老去，我带着爱为我的信仰祈祷。~
@98119 = ~沉睡者摇摇晃晃地醒来，突然被吵醒了使他处于混乱之中。~
@98120 = ~沉睡者现在完全清醒了，满怀期待地看着你。~
@98121 = ~沉睡者斜眼看着那团昏暗的绿光，他的眼睛还没有适应醒来后的环境。~
@98122 = ~“啊，她确实很快。血战的刺客 一直在附近出没，尽其所能散布混乱……”~
@98123 = ~“啊，地狱里满是这样的东西，而且它们往往有上千种花样。你把她罪恶的本质加以消灭的做法是正确的。”~
@98124 = ~“啊，地狱里满是这些东西。在这种情况下，再杀死它们一次的做法通常是给他们的最好的解脱。”~
@98125 = ~“是的，我现在了解了。吉斯泽莱人忠于其信仰，他们对观念与哲学的崇拜远胜于对神的崇拜。那么现在就让她那一套无神论的信仰来安慰她吧。”~
@98126 = ~“你的谎话出卖了你，凡人！我是生于天堂山的天使，假话逃不出我的视线！”~
@98127 = ~“无论妒忌与否，只要尝试一下爱，即使只是一瞬间……你觉得我的唯一真爱会害死我吗？不，不要回答。这不是我希望去考虑的命运。”~
@98128 = ~“你说了真话，我知道……不过她是向哪一位神做祈祷？她提到的神殿又是什么？难道我仍然还是在卡尼亚之门，不会吧？”~
@98129 = ~“往南，你是说？冰原一定是移动过了，把我给带走了！不过等等，我绝不能气馁。要是她注定要在那里等我，那么事情一定是这样的。”~
@98130 = ~“冰原的漂流不能改变那个简单的事实。也许你已经看到她，我的唯一真爱来到这大门了！也许你你已经把她带到这里来了！告诉我，她在这里吗？”~
@98131 = ~“好，好，万事如意……不过那个喇叭似乎提醒了我，你是冒着很大风险才弄出那么大的声音。为什么要这样做？”~
@98132 = ~“好，好，万事如意……是你砍伤了我，又狠又快，不是吗？伤口虽然好了，但是看，刀疤却还在。为什么你要那么做？”~
@98133 = ~“你到底是为什么差点把她给杀死？……不，我从你身上感觉不出有恶魔的血统。也许你是一个没有恶行的恶魔。”~
@98134 = ~“你就像你所吹的那个喇叭一样：有魔鬼之声却没有魔鬼之形……够了，接下来我要求你回答有关那个女人生命的问题：你有没有看见过我的唯一真爱？告诉我，她是不是就在这里？”~
@98135 = ~“可是砍伤了我，又狠又深。伤口已经愈合，但是看，刀疤还在。够了，不过作为回报，我要你回答一个问题：你有没有看见过我的唯一真爱？告诉我，她是不是就在这里？”~
@98136 = ~“好，要是你希望把卡尼亚所有的魔鬼都杀死，那么我要给你祝福。我唯一的忠告是不要让自己英年早逝。”~
@98137 = ~“我从来没有听说过像这样的东西，但天下之大无奇不有。不过，它带有异端的色彩。你打倒她是正确的。”~
@98138 = ~“我？我可以感觉到真相，不过这种想法……实在太可怕了！她没有发现这是异教吗？你在这种异端思想被散布开来之前把她杀死，这么做是对的。”~
@98139 = ~“我发誓，好像是喇叭的巨响把她从某个空间的深处召唤而来发起攻击……我觉得你这么做冒了很大风险。为什么你要这么做？”~
@98140 = ~“是你砍伤了我，又狠又快。为什么你要那么做？”~
@98141 = ~“现在我醒了，我问你：你看到过我的唯一真爱吗？她在这里吗？这样问让我有点害怕。”~
@98142 = ~“你没有选择了才来到我这里？我的确在这里，作为在卡尼亚深处的一名天使，这些年来我一直在沉睡中等待我的唯一真爱，你觉得我能提供选择吗？”~
@98143 = ~“我不知道如何帮你。我所知道的就是我在等我的唯一真爱。你看到过她吗？她在这里么？”~
@98144 = ~“你的确取得了某种意义上的成功。可是为什么要叫醒我？为什么是现在？我的唯一真爱，她在这里吗？”~
@98145 = ~“很好。既然我等了她这么长时间，那么再等久些也没什么害处……你要我做什么？”~
@98146 = ~“唉，你不是第一个要做这种尝试的人了……在卡尼亚最遥远的荒地某处有只被放逐的生物，叫做众名智者……它是我所一直未能完成的任务的一部分……”~
@98147 = ~“故乡……我差点记不起来了。我探索了这么长时间，但是即使现在我的任务也没有完成……在卡尼亚最遥远的荒地某处有个我从来没有见过的生物，叫做众名智者……”~
@98148 = ~“我从来没有听说过你提到的这位收割者，不过至于真名，我倒是知道一点。它似乎总是在太多和不够之间。”~
@98149 = ~“是的，那是我唯一没有完成的任务……在卡尼亚最遥远的荒地某处有只被放逐的生物，叫做众名智者……”~
@98150 = ~“在哪里？带她来！我要亲眼见她！”~
@98151 = ~“我也不想变得那么狂热。但是当一个人把他的全部生命都专注于单单一件事情上时，他对除了目标以外的其他任何东西都不会在意。能不能告诉我，这次要说真话，我的真爱在这里吗？”~
@98152 = ~“虽然你有着我从未见过的美貌，但是我在你身上感觉到一种怨恨，女士。你让我感到不确定……假如你能证明你是我的真爱，那么即使生活在你的怨恨之中，我对你的爱也忠贞不渝。”~
@98153 = ~“啊，善良的女人，泪水的女儿，是真的吗？你的美貌勿庸置疑。但是你是我的唯一真爱吗？证明给我看，我会永远爱你的。”~
@98154 = ~“你？但是……但是你和我所期待的完全不同……请原谅我的冒昧，但是我需要…需要更多的，怎么说呢……不，我不能相信。在你拿出证据来之前我不能相信你。”~
@98155 = ~“她？但是她已经死在你自己的手上了！不！我绝不相信！你是被魔鬼派来诱惑我的！要是你希望我相信你说的，那么就一定要拿出证据来。除此之外我什么也不信！”~
@98156 = ~“我只知道一件证据，就是我未能完成的任务唯一的那一部分……在卡尼亚最遥远的荒地某处有只被放逐的生物，叫做众名智者……”~
@98157 = ~“那么，关于我的唯一真爱，你看见她了么？”~
@98158 = ~“靡菲斯特把她囚禁在卡尼亚最遥远的荒地，但是这片荒地很大，所以我不知道囚禁她的地方在哪里。但是有一个人知道，我过去曾经得到过她的帮助……”~
@98159 = ~“那样说来，我知道有一枚戒指可以指出通往诸界智者的道路。她只会回答你一个问题。所以关键就是你要问她在哪里可以找到众名智者。”~
@98160 = ~“啊，说到众名智者，我是多么想知道靡菲斯特把她流放到哪里去了……”~
@98161 = ~“它是一枚谜题之戒，是一个来自机械境的模机为我打造的。它依靠希望的力量来工作。很久以前我希望得到一个答案，于是这枚戒指为我指出了道路，引导我找到答案。”~
@98162 = ~“转瞬境也被称为希望的贯穿位面。不管你有什么希望，它都会为你揭示答案。但是要小心，有些东西只存在于转瞬境而有些则完全不存在。”~
@98163 = ~“好的，关于戒指和我寻找诸界智者的事情……”~
@98164 = ~“在我沉睡之前，我建造了一座大殿来保证戒指的三个部分的安全。让我在这里召唤出前去那里的传送门……哦，那里有守卫，这一点真不好意思，当时我太累了，时间也很晚了。”~
@98165 = ~“怎么不能？虽然它的光芒黯淡，但是希望永存，即使在冰天雪地的卡尼亚也是如此。”~
@98166 = ~“它是一处充满了各种存在的位面。不过与其说它是一处真正的位面，它倒更是一种观点，一种观察解释事物的方法。举例而言，在那里你无法移动……”~
@98167 = ~“我也没有听说过有什么人把它称作家的，但是它一直就在那里。是希望之路把我从机械境引导到卡尼亚的诸界智者这边。对你而言它也是如此。”~
@98168 = ~“是的，机械境的机械天堂。它是某种意义上的天堂。在那个位面，有一座叫做雷格拉斯的城市，它是被叫做模机的机械生物的家园。”~
@98169 = ~“它们有各种大小和形状，有些是立方体，有些是十二面体。为我打造这枚戒指的是个身体残废的被流放者，老态龙钟但却技艺超群……”~
@98170 = ~“我曾是堕入九渊地狱深渊的天使。要是我被抓住而让戒指落入魔鬼们的手里的话，它们就可以找到诸界智者。我可不敢让她陷入那种危险之中。”~
@98171 = ~“这枚戒指被分成三个部分，只有一种方法可以把它们合起来。假如我被抓住，我可以把戒指拆开，那样它们就没办法用了。”~
@98172 = ~“哦，如果你正好问对，她是会回答一个以上的问题的。不过鉴于她所知道的只是事物所在的位置，她能回答的问题就只有一个了。我从来没有问过她为什么会那样，但是不管怎么说，事情就是这样。”~
@98173 = ~“是仍在人世的很少几位智者中的一位。在这场愚蠢的血战中我们失去了太多……但她是安全的，即使魔鬼也不知道她的所在。”~
@98174 = ~“咳，你会知道我唯一真爱的名字！在这个世界上没有比这个更有价值的事情了！”~
@98175 = ~“一个永恒的天堂。我的真爱和我会带着你一起回到极乐境去！”~
@98176 = ~“那么你要得到什么？告诉我，要是它是我力所能及的，我一定效劳！”~
@98177 = ~“好，让我们来谈谈诸界智者。自从我最后一次和她说话以后已经过了很长时间了，但是她的话却永远改变了我的一生。”~
@98178 = ~“那么有谁比他的旧情人，众名智者，更会被靡菲斯特所流放，因为害怕她会被人利用来对付自己？”~
@98179 = ~“我要找出真相而你要找一件武器。而她就是我们的目标！她所知道的真相就是你的宝剑，她所拥有知识就是他的克星！所以你要找到她…假如你不想为我去找她，那么就为你自己去找她吧。”~
@98180 = ~“人们常说家最好，要是这句话是真的，那么还有谁能比诸界智者更能帮你呢？所以请你到她那里去，这样对我们两个都有好处。”~
@98181 = ~“不，我不干，但是如果你要找的是一个名字，那么众名智者就是你一定要找到的人！我们的需要是一致的，我们的目标是相同的…假如你不想为了我去做这件事，那么就当是为你自己吧。”~
@98182 = ~“很简单，只要问她我的真爱的名字，然后用你的嘴唇把她那优美的声音带回我这里。我会知道你是不是说了真话。”~
@98183 = ~“因为这些名字是有力量的。靡菲斯特化装成一个名叫莫雷克罗斯男爵的人，发动了一场针对他自己的叛乱，以图找出他的情人‘众名智者’所说的背叛者。”~
@98184 = ~“最终他流放了手下十一名将军和她，因为他害怕其他人可能会利用她来对付自己。他把她带走，命令地狱的所有人都忘记她……唉，名字在这里意味着力量，也意味着弱点。”~
@98185 = ~“智者，或者称为远古巴托住民，他们是拥有大智慧的善良生物。冰天雪地的卡尼亚在很久以前就是他们的家园，比恶魔与魔鬼在漫长的血战中占领这里的时间还要早。”~
@98186 = ~“我面临一个选择，她只同意我问一个问题，只能得到一个答案。我该赌上一切来获得我的真爱的身份吗？甚至不能保证我能找到她…？”~
@98187 = ~“或者我应该谨慎行事，知道她会在哪里找到我，这样至少我们有机会看见对方的脸庞，虽然互不相识，但却永远相爱……我选择了后者。”~
@98188 = ~“是的，每个人都有自己的爱，即使像我这样的傻瓜也不例外。我在自己的一生中一直在寻找她的踪迹……我有充分的证据确定她会在这里找到我，所以我在这里等她。那么告诉我吧，她在这里吗？”~
@98189 = ~你回到平台上，再次注视着这名奇怪男子的淡绿色皮肤。他的存在让你感觉到平和。~
@98190 = ~平台上刻着的文字因为岁月而模糊。在屋内绿光的照射下，你看见上面写着“她会在卡尼亚之门与你相遇。”~
@98191 = ~沉睡者的带翼身体就在你面前沉睡，沐浴在惨淡的绿光下。你小心地靠近他。~
@98192 = ~当你接近沉睡者时，你可以感觉到导师之护身符在你的背包里嗡嗡作响。~
@98193 = ~当你接近沉睡者时，你脖子上的护身符嗡嗡作响，里面冒出了昏暗的光芒。~
@98194 = ~沉睡者的沉睡已经持续了数不清的世纪。你怀疑要把他从这平静的睡眠中叫醒不是件轻松的事情。~
@98195 = ~你抽出剑，用拇指抵住刀刃，立刻便冒出一滴血来。你非常满意刀刃的锋利，然后你把匕首狠狠地插进沉睡者的大腿，向下一划，留下一个很大的伤口。~
@98196 = ~鲜血从伤口涌出，溢满了下面的平台，变成一幅红色的画卷。正当你在欣赏这一景象的时候，伤口开始愈合了……沉睡者在痛苦的呻吟中醒来。~
@98197 = ~声音响彻了墓室厚厚的石头墙壁，但是沉睡者却无动于衷。你意识到要叫醒他需要比一个<MANWOMAN>的嗓音更响亮的声音。~
@98198 = ~你把喇叭凑到唇边，使劲一吹。一开始似乎万籁俱静，接着，一阵刺耳的声音过后，房间里响彻万魔殿的尖啸风声。~
@98199 = ~这喇叭似乎要吞噬你肺里的全部空气。你试着要停止下来，可是做不到。正当你要昏过去的时候，喇叭的声音减退了……在你面前的沉睡者颤抖着醒来了。~
@98200 = ~你感觉胸前的护身符微微发热。在它中心的水晶里，冒出了暗淡的绿光。~
@98201 = ~房间里极冷，你身上的痛苦愈发沉重。你感觉自己已经不能把精神集中在这护身符上，在不停的呕吐中，很快你就放弃了。~
@98202 = ~你把思想集中在水晶上，让痛苦慢慢地消退。最终，你的心平静下来，你发现自己正漂浮在一片惨白的薄雾中。~
@98203 = ~穿过烟雾，你听到了战斗的声音：“和靡菲斯特一起去死吧！莫雷克罗斯男爵万岁！”有人喊道：“莫雷克罗斯是卡尼亚的主宰！”另外的人喊着：“我们打赢啦！”~
@98204 = ~苍白色的窗帘散开，显现出一打魔鬼和一个陌生人的身形，这个陌生人雪白得就像围绕她的雾气一样。一个魔鬼，男爵，有着肥胖的身体和谄媚的神情，显得格外与众不同。他清了清嗓子，开始说话。~
@98205 = ~男爵的身体突然拉长，变得又高又黑，他感谢这些将军给他的协助。而他们却在他面前害怕得颤颤发抖，因为男爵渐渐地显现出了自己的原型：他就是靡菲斯特，被这些将军们打败的统治者。~
@98206 = ~这位脸色苍白的女子上前一步，脸颊上挂着泪珠。”那么我呢，亲爱的？我把那些会出卖你的人的真名交给了你。你现在相信我了吗？”~
@98207 = ~“你是众名智者，亲爱的。”他温柔地回答说。”而你是我最最需要消除的危险。在这里名字的力量实在太强大了，我决不会让你来用它对付我。”~
@98208 = ~这里的疯狂仿佛因一滴眼泪而停止。“求求你，”她哭道，“要是你还爱我，就不要把我流放！我会和你一起呆在那座城市的。”~
@98209 = ~靡菲斯特冷笑着答道，“但是我的甜心，我不爱你……从来也没有。”说着，他把她抛到没有星星的天空中，变成一颗燃烧着的流星飞向卡尼亚最遥远的荒地。~
@98210 = ~泪水掉到冰上散成碎片。每一片碎片里都是沉睡者的影像，他的嘴唇上挂着冰霜，在一片紫色的烟雾中穿行。在他面前出现了一道树立在冰雪之中的大门。~
@98211 = ~你打开了门，沉睡者跌跌撞撞地穿了过去，为了能摆脱刺骨的冰风而谢天谢地。你感觉自己被拉进了另外的门里，穿过走廊，穿过房间…~
@98212 = ~突然间你发现自己处在一间房间里，有一个声音说“你有许多问题，但我只回答一个”。你可以感觉到沉睡者在考虑提哪个问题时的痛苦心情。~
@98213 = ~“是为了爱我才来到这里，智者。我想要知道我的真爱如今身在何方或者告诉我在哪里能知道她的名字，这样我就可以认出她，但是，你能给我的答案都帮不了我。”~
@98214 = ~“所以我想要问你在哪里我可以遇见她。告诉我，这样我就能在那里等她，直到她找到我。这就是我的问题，智者，告诉我正确的答案。”~
@98215 = ~沉睡者回到卡尼亚之门 时，智者的答案便消失在紫色的雪暴中了。他从手指上取下戒指，世界又重新变回雪白。~
@98216 = ~当他从手指上取下戒指的时候，它又重新分成三部分，互相连接，就像它们刚被打造出来的时候一样。他在冰雪之下建造了一座墓室，将戒指存放于其中，这样它就安全了。~
@98217 = ~在墓室之上他为自己留下一张从下面加热的石床。他花了很多天来等待他的真爱。当她最终没有出现的时候，他便慢慢地陷入沉睡之中，心里想着她以后会在那里找到自己。~
@98218 = ~沉睡者陷入没有梦的沉睡之中。虽然尝试了各种办法，但你依然不能到他身边。~
@98219 = ~这座城市似乎并不存在于沉睡者的梦中。于此相反的是，门房的入口暴露在一片冰原之上，这座城市一定是在后来的某一时间因为门房的不敷使用而在附近建造的。~
@98220 = ~诸界智者给出的答案仍然回响在沉睡者的潜意识中：“她会在卡尼亚之门找到你……”~
@98221 = ~一大堆令人昏乱的问题在沉睡者的心中翻动。我在哪里？我该属于哪里？众名智者被放逐到哪里去了？我该去哪里？~
@98222 = ~在哪里能找到我的唯一真爱？她现在在哪里？她会死在什么地方？我会死在什么地方？哪里能找到真善美？哪里能消灭假恶丑？在哪里能让我知道真相？~
@98223 = ~这声音是一名女子的，但不是沉睡者之前梦里众名智者的声音。你意识到她应该是那个被叫做诸界智者的人。~
@98224 = ~你发觉很难把精神集中在研究房间的特点上。似乎突然间有很多地方而又突然间什么也没有。你不知道该怎么办。~
@98225 = ~这阵薄雾似乎要把所有东西都包围进去，甚至包括它自己。你看了沉睡者一眼，发现有一串红色的箭头在紫色的空气中燃烧，指向大门。~
@98226 = ~某种程度上似乎这来自与他手上戴着的戒指，这枚戒指为他指出一条穿过荒原的路线。~
@98227 = ~他颤抖着，几乎被冻死，但是某种东西，可能是热情，也可能是疯狂，仍然在他的眼中燃烧。他来此寻找答案，而那些答案，经过长时间努力，终于接近了。~
@98228 = ~你似乎无法再集中精力于这散开的泪水，很快它就消失得无影无踪。看起来梦已经结束而另一场梦又开始了。~
@98229 = ~似乎没有什么东西可以让你集中精力的，在梦里你没有可以依靠的概念。就好像沉睡者从来没有听说过收割者，~
@98230 = ~穿过烟雾，你看见了一幅遥远冰原的景象，它的表面零星地散布着十二个冒烟的深坑。地坑慢慢地被飘雪所填满。流放者被埋葬于此。~
@98231 = ~沉睡者似乎把卡尼亚看作是巴托地狱最近新增加的一部分，而众名智者则不知怎么地属于卡尼亚的过去。~
@98232 = ~你感觉到其他远古巴托住民一定和沉睡者是生活在同一时代的，但是他们人数稀少，又被魔鬼追杀，最终几乎灭绝。~
@98233 = ~一个接着一个地，靡菲斯特喊着背叛他的将军的名字，他们的真名，把他们包围在地狱之火中，变成流星飞到卡尼亚没有星光的天空中。~
@98234 = ~“你被流放了，”他大声宣布，“到卡尼亚最遥远的荒地去吧！让冰原把你埋葬，让巴托地狱忘记你的存在！听从你的真名，我命令你！”~
@98235 = ~在梦中他似乎比你记忆中要年轻，也高一些。获胜后的傲慢之情在他身上处处可见。他也一定感到胜利的喜悦，他的谎言让他引以为傲。~
@98236 = ~似乎莫雷克罗斯男爵的出现是一条诡计，是靡菲斯特用来发现阴谋推翻他的背叛者的陷阱。~
@98237 = ~他们的声音粗暴而含混不清，时而咬牙切齿。他们是血战中魔鬼一边的将军，拥有极高的地位。~
@98238 = ~但是，这声音却不一样，令人不安而不是魔鬼的声音。虽然年代久远，但这声音却似乎包含着超出时代的知识。它知道得太多了……它知道背叛就在眼前，但它却保持沉默。~
@98239 = ~梦境就在你的周围，每个方向上都有着丰富的色彩，似乎无穷无尽。你把精神集中在男爵的名字上，突然感觉到一阵不安。~
@98240 = ~也许是出了某种差错，你发现自己心里充满了大难临头的感觉。背叛就在眼前，你可以感觉到莫雷克罗斯男爵没有把某些事情告诉他的追随者。~
@98241 = ~沉睡者的梦境在你的好奇心之下变化了。你听到了老者说故事的声音，闻到了酸酒的气味，感受到了篝火的温暖。~
@98242 = ~这一定是沉睡者很久以前曾经听过的故事。一个他所发现的故事。是关于在卡尼亚的一场起义，一场魔鬼与恶魔之间为了争夺第八地狱统治权的战争。~
@98243 = ~你可以微微感觉到他身体缓慢的上下起伏。他的呼吸在冰冷的空气中化作一阵薄烟，他翅膀上的羽毛在穿堂风的作用下微微飘动。~
@98244 = ~他的脸色充满悲伤，额头上显出疲倦，但他的嘴角却露出温柔的微笑。他身上的某种东西使人不可否认地感觉到神圣。~
@98245 = ~沉睡者现在已经完全醒了，满怀期待地看着你。~
@98246 = ~沉睡者在平台上沉睡着，和你上次见到他时相比毫无变化。你很想知道他在那里睡了多久，而他又打算等待多久呢。你意识到自己没有办法进入他的梦境……~
@98247 = ~你靠得很近，轻轻说出了沉睡者的真名。“忍耐之塞雷斯法……”你的声音刚刚，他便轻轻的活动起来，仿佛他在熟睡时也能感觉到有人在命令他。~
@98248 = ~沉睡者松了口气，又沉沉地睡去。~
@98249 = ~沉睡者醒了过来，激动不已，他的眼睛仍然未能适应神殿里惨淡的绿光。“这是什么意思？为什么你要叫醒我？”~
@98250 = ~沉睡者醒了过来，激动不已，他的眼睛仍然未能适应神殿里惨淡的绿光。~
@98251 = ~“朝圣者<CHARNAME>！为什么你要叫醒他！？这有什么意义？”你可以感觉到她的惊恐和不怀好意。你看见她握紧双拳，准备攻击。~
@98252 = ~导师没有任何反应表明她是否听到了你的话。一声愤怒的尖叫之后，她倒在你身上。~
@98253 = ~昏过去的导师停止了动作，无法伤害到控制她的人。~
@98254 = ~“但是……不，我不要和她作战！发生什么事情了？疯了！”~
@98255 = ~“你需要做不少解释才行，朝圣者，不过似乎我没有别的选择只能听你的说法了。说下去吧……”~
@98256 = ~“啊，你的确有很多问题要向我解释。那么你为什么要打搅我呢？”~
@98257 = ~你向沉睡者点了点头。“我梦见了我的唯一真爱的名字。”他正色道，圣光开始回旋盘绕，围住他的身体。~
@98258 = ~“她是名为莱佛拉的星界使徒。我将回到自己的故乡去寻找她。假如她是已经出生的天使，那么就很有可能会有记录……”~
@98259 = ~“是众名智者，被靡菲斯特囚禁在莫雷克罗斯的某个遥远而秘密的地点。”~
@98260 = ~“是诸界智者，我过去见过她，很久以前。但愿她一切都好……”~
@98261 = ~“她是娜西拉，女性黑暗精灵。你知道她么？”~
@98262 = ~“她是一名吉斯泽莱人，人称德哈瓦娜导师。你知道她么？”~
@98263 = ~“她是被称为艾瑞贝丝女士的灵魂。你知道她么？”~
@98264 = ~“是你，<CHARNAME>·<CHARNAME>。你就是我所等待的那个人。”他站到你面前，吻你，把你拉进他的怀抱。“我的唯一真爱。”他喃喃道。~
@98265 = ~导师来得突然，去得也突然，留给你和沉睡者的只是她的愤怒。~
@98266 = ~“那是谁？我好像看见她了。”~
@98267 = ~[他以为自己认出了他的真爱]“我要谢谢你的保护。刚才我梦见我的唯一真爱了，我不喜欢在我注视她的时候被打断。”~
@98268 = ~“是的，你要为我解释不少问题。你这次把我吵醒是为了什么事情？”~
@98269 = ~“你把我从梦中吵醒了，我刚梦见自己听到我唯一真爱的名字，”他正色道，圣光开始回旋盘绕，围住他的身体。~
@98270 = ~“你把我的唯一真爱赶走了，自寻死路！你把我惹火了，傻瓜！”~
@98271 = ~沉睡者的肌肉鼓起扭曲，他的身体就好像做了噩梦一样扭曲起来。他痛苦地咆哮，之后一切都归于静止。你把手放在他的脖子上时感觉不到脉搏。他的身体已经开始变冷。~
@98272 = ~他刚才的激动突然停止，肌肉僵直，就好像沉睡者的整个下意识都因为这条线索的出现而失去活力。~
@98273 = ~沉睡者等待着，双目紧闭，仍然被他的真名所控制。~
@98274 = ~他对着名字微笑，十分安祥。~
@98275 = ~他对着名字微笑，十分安祥。~
@98276 = ~沉睡者转过身去，背对着你。你感觉到他并不相信你。~
@98277 = ~他对着名字微笑，十分安祥。~
@98278 = ~他对着名字微笑，十分安祥。~
@98279 = ~沉睡者转过身去，背对着你。你感觉到他并不相信你。~
@98280 = ~他对着名字微笑，十分安祥。~
@98281 = ~他对着名字微笑，十分安祥。~
@98282 = ~沉睡者转过身去，背对着你。你感觉到他并不相信你。~
@98283 = ~他对着名字微笑，十分安祥。~
@98284 = ~他对着名字微笑，十分安祥。~
@98285 = ~沉睡者转过身去，背对着你。你感觉到他并不相信你。~
@98286 = ~他对着名字微笑，十分安祥。~
@98287 = ~他对着名字微笑，十分安祥。~
@98288 = ~沉睡者转过身去，背对着你。你感觉到他并不相信你。~
@98289 = ~他对着名字微笑，十分安祥。~
@98290 = ~沉睡者转过身去，背对着你。你感觉到他并不相信你。~
@98291 = ~他转向你，张开双目，嘴上露出温和的微笑。他靠向你，吻了你一下，把你拉入他天使般的怀抱。他的嘴感觉就像是早晨的花朵。“亲爱的。”他低声说道。~
@98292 = ~他转向你，张开双目，嘴上露出温和的微笑。他靠向你，吻了你一下，把你拉入他天使般的怀抱。“亲爱的。”他低声说道。~
@98293 = ~他的脸上露出了震惊的表情，你的手印还留在上面。他的声音充满了混乱和悔恨的烦恼。“我……对不起，<CHARNAME>。我做的事情让你不高兴了？”~
@98294 = ~在犹豫和害羞之中，他把手放在你的颈后。轻轻的靠了过来，闭上眼睛，他在你的唇上印下了这个世界最温柔的一吻。~
@98295 = ~“紧张？是什么让我的爱如此忧伤？”~
@98296 = ~“我的存在？但是……但是你是我的真爱！我不属于你吗？难道我等待这么久就是为了看到你轻蔑的折磨吗？我也许应该在睡眠中死去……”~
@98297 = ~“那么，别了。我把永恒的爱交给你，收到的却是你的轻蔑……我怎么能收到这种蔑视。我只能乞求下辈子不会如此残酷。”~
@98298 = ~“原谅我，亲爱的，因为你是对的。我担心自己的心太关注这个时刻了，现在我一定会为此受到煎熬。请不要蔑视我的爱。”~
@98299 = ~一丝忧愁扫过他的眉梢。“有什么关系吗，我的爱？”~
@98300 = ~“我……我闻起来很糟糕？我的爱，我跨越千山万水来找你，在九界之狱长眠千年等待你的到来！如果你所要求的就是洗个澡我回去做，但是……”~
@98301 = ~当看到沉睡者的脸上由恐怖绽开为开朗的笑容，你对着自己笑了。他仰起头，爆发出你听过的最开心、最热烈的笑声。~
@98302 = ~“你是对的，在这个地方我几乎忘记自己的幽默感了。再次笑出来感觉真好，我得为此谢谢你。但是请和我说实话，在你的心里究竟埋藏着什么忧愁呢？”~
@98303 = ~“你不理解。你在整个卡尼亚都不会找到一个澡堂！我怀疑是不是整个巴托之狱都不会找到一个。”~
@98304 = ~“好，好，我会去做！我会解决得！但是做好以后我该到哪里去找你呢？”~
@98305 = ~“我的地盘？但是我已经很久很久没有回到极乐世界了！那儿也许是一团糟了……不，别担心！我会好好洗个干净！没事，我会在那儿见到你的！”~
@98306 = ~“那么我在那里等你，洗得干干净净，然后我们好好谈谈。或许我们能找个地方喝喝茶，或者我好好招待你一顿晚宴！喜欢小羊肉吗？不，不要回答，那会是个惊喜。我在那儿见你！”~
@98307 = ~“别动！一点都不要动！我马上就回来！我发誓，<CHARNAME>，以我的爱的名义！”~
@98308 = ~“结束了？但这只刚刚开始！……好吧，我要诅咒你和你这个性别的所有人！但愿你的黑心会在胸膛里腐烂……我为你耗费了一生。我们就此结束吧，<CHARNAME>·<CHARNAME>……”~
@98309 = ~“但是你刚刚来……有什么这么紧迫呢？”~
@98310 = ~“你会回来吗？我在哪儿能找到你？”~
@98311 = ~“是的，我在极乐世界的家。我离开的太久了……愿神祝福你必须做的事情。我会在天堂准备好我的家来等待你。”~
@98312 = ~“那么去吧，我亲爱的人，去做你必须做的事情吧。如果我在一个星期内没有接到你的消息，我会在这个你叫作深水城的地方找你。”~
@98313 = ~“那么我会这里一直等到你回来。我祈求你不要走的太久，我的爱，你的吻是沙漠中的清泉，我渴望得到更多……”~
@98314 = ~“那么我会在这里一直等到你回来……去完成你必须的事情吧，我的爱，但是在你垂垂老矣之前回来吧。尽管我会一直等下去，但是时间……”~
@98315 = ~“我来到巴托寻找你，<CHARNAME>，我不会让任何邪恶出现在我们之间。我会和你一起与邪恶作战，以我们爱的名义，如果你允许的话。”~
@98316 = ~“爱不会妨碍的，但是，如果这是你的愿望，我不会插手。那么，在你的战斗结束之后，我去哪儿找你呢？”~
@98317 = ~“我理解。如果那是你的希望，我不会介入……不过，在你的战斗结束之后，我去哪儿找你呢？”~
@98318 = ~“<CHARNAME>？你是说真的吗？我承认，我梦想过更多……但是至少我看到了你。我听到了你的声音。我吻到了你的唇……”~
@98319 = ~“我等了很久了，我会再等到第二次见到你……哦，爱，虽然我的命运如此空洞，而我的心至少很充实。你的记忆会支持着我……那么，别了，我的真爱……”~
@98320 = ~“是的，我在极乐世界的家。我离开的太久了……愿神在你面对邪恶时给你祝福。我会在天堂准备好我的家来等待你完成你的战斗。”~
@98321 = ~“托瑞尔世界的深水城……那么去吧，我亲爱的人，让我的爱伴随着你。你一赢得战争我就去那儿找你。”~
@98322 = ~“那么我会这里一直等到地老天荒，直到你回来，我的爱……预案。愿神在你面对邪恶时给你祝福。”~
@98323 = ~“为了你我会翻天覆地……物质位面的托瑞尔世界？去吧我亲爱的，让我的爱伴随你。我会在那儿找到你，并与你并肩作战。”~
@98324 = ~他亲吻着你的唇，交缠着你的舌头，变得越来越热情。“我一生都在等待这个时刻，<CHARNAME>”他喃喃私语，泪水从他灰绿色的眼睛里汹涌而出。~
@98325 = ~你的思想中有神么东西，然后，关于对你的仇敌，靡菲斯特，复仇的一些记忆浮现了出来。忧愁浮上了沉睡者的眉弓。“你怎么了？我的爱？”~
@98326 = ~沉睡者。他很久之前漫游到这里希望找到他的真爱。在那个包含他名字的神殿去找他。~
@98327 = ~“我不知道。好像她无处可生。”~
@98328 = ~“一个女魔鬼，已经被我消灭了。”~
@98329 = ~“恐怕是个报复的灵魂。”~
@98330 = ~“是个吉斯泽莱女人。”~
@98331 = ~“只是一个嫉妒的爱人，没什么。”~
@98332 = ~“那是导师。她管理着这儿的神殿。”~
@98333 = ~“卡尼亚之门？不，他们在南方很远。”~
@98334 = ~“你在亡魂之城，就在卡尼亚之门的脚下。”~
@98335 = ~“她崇拜泰尔，善良公平之神。”~
@98336 = ~“她崇拜邪恶的魔鬼。”~
@98337 = ~“她崇拜一个叫作沉睡者的人。”~
@98338 = ~“她崇拜的是你。”~
@98339 = ~“我不确定。”~
@98340 = ~“我需要引起那个女人的注意。”~
@98341 = ~“我没有什么选择，需要你的帮助。”~
@98342 = ~“我需要唤醒你。”~
@98343 = ~“不，她不在，但我还需要更多地了解你。”~
@98344 = ~“再见。”~
@98345 = ~“我必须阻止恶魔。”~
@98346 = ~“我希望回到托瑞尔世界的家。”~
@98347 = ~“你知道收割者的真名吗？”~
@98348 = ~“是的，她在……”~
@98349 = ~“对不起，我说错了。我不想引起惊慌。”~
@98350 = ~“她就在那儿，艾瑞贝丝女士。”~
@98351 = ~“就是我。我是你的真爱。”~
@98352 = ~“她在那儿，那具地上的尸体。”~
@98353 = ~“你需要什么证据来了解你的爱？”~
@98354 = ~“回答我另一些问题。”~
@98355 = ~“我怎么才能找到众名智者？”~
@98356 = ~“回答我另一些问题。”~
@98357 = ~“那么告诉我这个戒指的事情吧。”~
@98358 = ~“回答我另一些问题。”~
@98359 = ~“好吧，让我看看那个戒指。”~
@98360 = ~“仅凭希望就能使用它？”~
@98361 = ~“贯穿位面是什么？”~
@98362 = ~“模机？机械境？你在说些什么？”~
@98363 = ~“你说的谜题之戒是什么意思？”~
@98364 = ~“为什么她只能回答一个问题？”~
@98365 = ~“谁是这个诸界智者？”~
@98366 = ~“给我的是什么？”~
@98367 = ~“是的，好吧，还不够……”~
@98368 = ~“没兴趣……”~
@98369 = ~“回答我另一些问题。”~
@98370 = ~“我必须阻止恶魔。”~
@98371 = ~“我想回到托瑞尔世界的家。”~
@98372 = ~“你知道收割者的真名吗？”~
@98373 = ~“她能给你什么证据？”~
@98374 = ~“为什么她被放逐了？”~
@98375 = ~“哪种生物会叫那样的名字？”~
@98376 = ~“为什么你没能完成任务？”~
@98377 = ~“你的真爱？”~
@98378 = ~离开。~
@98379 = ~唤醒沉睡者。~
@98380 = ~用刀割他。~
@98381 = ~对他耳朵大喊。~
@98382 = ~吹响万魔喇叭。~
@98383 = ~戴上导师之护身符。~
@98385 = ~向前穿过薄雾。~
@98386 = ~集中到那个白衣女人。~
@98387 = ~集中到那个女人的眼泪。~
@98388 = ~打开冰中的门。~
@98389 = ~集中到他问的问题。~
@98390 = ~集中到戒指上。~
@98391 = ~更深的进入沉睡者的梦境。~
@98392 = ~集中到亡魂之城。~
@98393 = ~集中到众名智者的回答上。~
@98394 = ~集中到沉睡者的诸多问题上。~
@98395 = ~集中到那个声音。~
@98396 = ~集中到那个房间。~
@98397 = ~集中到紫色的薄雾。~
@98398 = ~集中到沉睡者。~
@98399 = ~重新集中到四散的眼泪。~
@98400 = ~集中到收割者的真名。~
@98401 = ~集中到放逐的想法。~
@98402 = ~集中到众名智者的思想。~
@98403 = ~集中到反叛的将军。~
@98404 = ~集中到恶魔。~
@98405 = ~集中到男爵的观念。~
@98406 = ~集中到那些大声呼喊的人。~
@98407 = ~集中到莫雷克罗斯男爵的名字上。~
@98408 = ~尝试确定梦的背景。~
@98409 = ~检查沉睡者。~
@98410 = ~离开。~
@98411 = ~用刀割他。~
@98412 = ~对他的耳朵大喊。~
@98413 = ~吹响万魔喇叭。~
@98414 = ~对他的耳朵说出他真爱的人的名字。~
@98415 = ~对他的耳朵念出他的真名。~
@98416 = ~回到从前的选项。~
@98417 = ~“醒来。”~
@98418 = ~攻击她。~
@98419 = ~“别发火，导师，让我解释！”~
@98420 = ~“误导之法蕾西亚！”~
@98421 = ~“攻击我，你这个笨蛋！你在等什么？”~
@98422 = ~“如果你要战斗，和你从前的沉睡者去打吧！”~
@98423 = ~“再见。”~
@98424 = ~攻击他。~
@98425 = ~“与她战斗，忍耐之塞雷斯法！你没有选择！”~
@98426 = ~“那么你就默默忍受她的殴打吧，笨蛋！”~
@98427 = ~“呆在那儿别说话。很快就会清楚的。”~
@98428 = ~“很高兴听到这个。我希望她发现你在这里。”~
@98429 = ~[离开并未死]“她在这里坚持了一会不过还是走了。”~
@98430 = ~[她活着，在另一房间里]“无疑她在隔壁房间等你。”~
@98431 = ~[她活着，在这个房间里]“我把她带来了。她就在这里。”~
@98432 = ~[她死了，在另一房间里]“我在另一个房间看到了她的尸体。”~
@98433 = ~[她死了，在这个房间里]“她的尸体就在那儿。”~
@98434 = ~“她在你身边修建了这个神殿。”~
@98435 = ~“再见。”~
@98436 = ~“忍耐之塞雷斯法……”~
@98437 = ~“很高兴听到这个消息。我希望她在这里找到你了。”~
@98438 = ~[艾瑞贝丝在这区域]“我把她带来了。她就在这儿。”~
@98439 = ~[艾瑞贝丝永远被冰封]“她已经迷失了自我，冰封在卡尼亚的冰原之下。”~
@98440 = ~“在世间，据说她给我的家乡带来了巨大的不幸。”~
@98441 = ~“从这儿滚开！”~
@98442 = ~“陷于地狱的亵渎者。”~
@98443 = ~“没什么重要的人。”~
@98444 = ~“那是你的真爱。”~
@98445 = ~“放弃你真爱的追求……”~
@98446 = ~“我已经知道你的真爱的名字了。”~
@98447 = ~回到你从前的选项。~
@98448 = ~“是年轻之泽拉米瑟亚，天神莱佛拉。”~
@98449 = ~“是智者菲蕾丝，他是众名智者。”~
@98450 = ~[说谎]“是智者菲蕾丝，他是众名智者。”~
@98451 = ~“忍耐之塞雷斯法，我命令你相信我！”~
@98452 = ~“是智者科德米莉亚，他是诸界智者。”~
@98453 = ~[说谎]“是智者科德米莉亚，他是诸界智者。”~
@98454 = ~“忍耐之塞雷斯法，我命令你相信我！”~
@98455 = ~“是寻天者奎霏莉娅，一个叫做娜西拉的黑暗精灵。”~
@98456 = ~[说谎]“是寻天者奎霏莉娅，一个叫做娜西拉的黑暗精灵。”~
@98457 = ~“忍耐之塞雷斯法，我命令你相信我！”~
@98458 = ~“是误导之法蕾西亚，称作德哈瓦娜导师的吉斯泽莱人。”~
@98459 = ~[说谎]“是误导之法蕾西亚，称作德哈瓦娜导师的吉斯泽莱人。”~
@98460 = ~“忍耐之塞雷斯法，我命令你相信我！”~
@98461 = ~“是双魂瓦达莉亚，艾瑞贝丝女士的魂灵。”~
@98462 = ~[说谎]“是双魂瓦达莉亚，艾瑞贝丝女士的魂灵。”~
@98463 = ~“忍耐之塞雷斯法，我命令你相信我！”~
@98464 = ~“是我，残酷之拜扎登，我的名字是<CHARNAME>·<CHARNAME>。”~
@98465 = ~[说谎]“是我，残酷之拜扎登，我的名字是<CHARNAME>·<CHARNAME>。”~
@98466 = ~“是我，内省之卡基达，我的名字是<CHARNAME>·<CHARNAME>。”~
@98467 = ~[说谎]“是我，内省之卡基达，我的名字是<CHARNAME>·<CHARNAME>。”~
@98468 = ~“是我，自私之内泽本，我的名字是<CHARNAME>·<CHARNAME>。”~
@98469 = ~[说谎]“是我，自私之内泽本，我的名字是<CHARNAME>·<CHARNAME>。”~
@98470 = ~“是我，公正之纽索斯，我的名字是<CHARNAME>·<CHARNAME>。”~
@98471 = ~[说谎]“是我，公正之纽索斯，我的名字是<CHARNAME>·<CHARNAME>。”~
@98472 = ~“是我，善良之以贝拉，我的名字是<CHARNAME>·<CHARNAME>。”~
@98473 = ~[说谎]“是我，善良之以贝拉，我的名字是<CHARNAME>·<CHARNAME>。”~
@98474 = ~“是我，黑暗之德雷岑，我的名字是<CHARNAME>·<CHARNAME>。”~
@98475 = ~[说谎]“是我，黑暗之德雷岑，我的名字是<CHARNAME>·<CHARNAME>。”~
@98476 = ~“是我，坚定之里休斯，我的名字是<CHARNAME>·<CHARNAME>。”~
@98477 = ~[说谎]“是我，坚定之里休斯，我的名字是<CHARNAME>·<CHARNAME>。”~
@98478 = ~“是我，祝福之多尼塔，我的名字是<CHARNAME>·<CHARNAME>。”~
@98479 = ~[说谎]“是我，祝福之多尼塔，我的名字是<CHARNAME>·<CHARNAME>。”~
@98480 = ~“忍耐之塞雷斯法，我命令你相信我！”~
@98481 = ~“再见。”~
@98482 = ~掴他耳光。~
@98483 = ~“抱歉，我们出发吧。”~
@98484 = ~“没什么。我只是紧张，就这样。”~
@98485 = ~“你的在场让我不高兴。”~
@98486 = ~“你假设的太多了一点，异界神侍。”~
@98487 = ~突然离开。~
@98488 = ~“你闻起来真恶心。”~
@98489 = ~“我在开玩笑。如果你爱我，你应该学会怎么去笑。”~
@98490 = ~“好。赶快去洗个澡，然后我们谈谈。”~
@98491 = ~“我在数数……一……二……”~
@98492 = ~“你不会……现在最好你自己说再见吧。”~
@98493 = ~“我会在天堂等你，你属于那里。”~
@98494 = ~“我会在我的家乡托瑞尔的深水城等着你。”~
@98495 = ~“我就在这里等你，卡尼亚之门。”~
@98496 = ~“我对你的借口没有兴趣。这个关系结束了。”~
@98497 = ~“我得走了。”~
@98498 = ~“很抱歉，不过那和你没有关系。”~
@98499 = ~“我不回去……你最好和我告别吧。”~
@98500 = ~“我会在天堂等你，你属于那里。”~
@98501 = ~“来我家乡托瑞尔的深水城找我。”~
@98502 = ~“我会回这儿来找你，就在卡尼亚之门。”~
@98503 = ~“我还没有准备好，行吗？”~
@98504 = ~“邪恶正在我的家乡托瑞尔肆虐。”~
@98505 = ~“不，你会碍事的。”~
@98506 = ~“不，有些事情我必须独自去做。”~
@98507 = ~“你不会……现在最好你自己说再见吧。”~
@98508 = ~“让我们在天堂相会，你属于那儿。”~
@98509 = ~“在深水城。”~
@98510 = ~“我会回这儿来找你，就在卡尼亚之门。”~
@98511 = ~“你愿意帮我？”~
@98512 = ~回吻他。~
@98513 = ~诸界智者扇着她轻薄的翅膀在你周围盘旋，希望引起你的注意。~
@98514 = ~在一片混乱的地方，你看到了一个女人的脸，她有一对蝴蝶般的翅膀和妖艳的眼神……看来沉睡者的戒指终于把你带到了诸界智者面前。~
@98515 = ~“是的，你应该问得是在哪儿能找到耐性，你应该问！很多人在这个世上找到了真爱，可是谁找到了耐性呢？这个答案远远比前者值得深究……”~
@98516 = ~“你的自愿？这就像一团乱麻，无数的线头缠绕在一起，这不仅仅关乎你自己！你没有他的双翼，你没有他的外表，但是你还是和他问了同样的问题。你有他的戒指，是吧？”~
@98517 = ~“不？你确信吗？你带着他的戒指，而它又独一无二，世间仅此一枚，不是吗？就在这里。你没有他的双翼，你没有他的外表，但是你还是和他问了同样的问题。”~
@98518 = ~“但是来吧，异界神侍，我的朋友，我唯一的朋友，我在这个世界上的真爱，我们一同回忆旧时光吧。随便你提多少个问题都可以，但不要涉及地点。你已经问过那个问题了，别再问了。”~
@98519 = ~“拜托，我珍爱的异界神侍，看到你这么请求我，我的心都碎了。我不能告诉你。你知道我真的无法告诉你，我早就对你说过了。”~
@98520 = ~“或许不是。或许你是带着自己的愿望和需要才来到这里，不同于我的异界神侍……但是我相信他会回来找我的……很好，我会给你两个答案：”~
@98521 = ~“当然我不会，我的爱，我的异界神侍。只有一个问题，我发誓，因为我不敢让你看到整个画面。很明显我不再能成为你的真爱，不是吗？”~
@98522 = ~“我不敢离开这里的安全，但是我知道你的爱随处都会出现。我的心是脆弱和嫉妒。你难道希望我给你一个银色的盘子，然后塞一个苹果到你嘴里？”~
@98523 = ~“好的，希望引领你走了这么远，异界神侍。我想没有什么能阻止它把你带到结束的那一刻……我会给你的问题提供两个答案，因为这是你第二次问我了。”~
@98524 = ~“那么我又是谁可以拒绝你的心的愿望呢？……很好，我会给你的问题提供两个答案，因为这是你第二次问我了。”~
@98525 = ~“第一个答案就在把你带到这里的戒指里。让它的三条希望之带和我给你的第四条失望之带连接起来。它会像引领你来这里一样带你去她的监狱。”~
@98526 = ~“你不是第一个试图寻找他们的监狱的人，也不是第一个找到的人。时间就像一个十二根辐条的车轮，我们的生命每逝去一个小时，另一根辐条就一去不复返……”~
@98527 = ~“不。谢谢你，我的异界神侍，同时为了一切的所有和皆无。你从我那里生成了一个影子……然而你的轮辐已经转过去了，你该走了。在我完全消逝之前继续你的追求吧……”~
@98528 = ~“不，不要谢我……忘了我吧……那样更好些，我认为。是的，忘了我，我的异界神侍，还有轮辐的流逝，或许我也会忘记你……”~
@98529 = ~“彼即其本身，我的异界神侍。也许随着轮辐的逝去，你会理解的。”~
@98530 = ~“如果你爱一个人，让他们自由吧……否则你的心会永远的被他们咬住。让他们的自由成为你自己的自由……”~
@98531 = ~你看着手指上的戒指。原来在那里的三条金带现在缠绕在一起，看起来像是纠结的黑色藤蔓，寒冷如铁，冻结在一起。~
@98532 = ~“因为那个问题包括一个‘哪里’，而且我很久之间见到你就告诉过你。只有一个，我告诉了你。只有一个问题，一个答案。我告诉你，我的异界神侍……”~
@98533 = ~“你叫她姐妹？是的，我能看到你为什么会这么看我们。她是我们之中最年轻的一个，在魔鬼们宣布卡尼亚属于他们之后出生……年轻而且甜美，美丽而又愚蠢……”~
@98534 = ~“哦，异界神侍……她爱的太多、太快、太激烈、太投入。我们都是知识的娼妇，他们因为我们的思想而爱我们。即使是你，即使是恶魔，都一样。”~
@98535 = ~“我们试图警告她远离魔鬼的心，但只能让她的热情更加剧烈。也许她想改变他，也许她的内心比我们知道的变得更加黑暗……”~
@98536 = ~“但是，她爱他，并且也为他所爱，或者说在他背叛她、抛弃他之前看起来是这样，他把她丢到了一边，流放到某个地方，我不能告诉你是哪里，异界神侍……”~
@98537 = ~“安静，异界神侍……看这你说的多难？你没有爱过我，但是至少你相信我。我该向谁去乞求更多，我的异界神侍？我该向谁去乞求更多呢？”~
@98538 = ~“那些话本身听起来很甜美，异界神侍，从你的口中说出就更为甜美了。但是如果你曾经爱过我，你该和我留在一起。如果你现在爱我，你也会这么做。事实胜于雄辩……”~
@98539 = ~“我……我曾经。哦，我试图不去，异界神侍，我试图更坚强，但是有些问题没有答案，或者是没有有意义的答案，或者是没有立刻能说明多少的答案……我尽力不去，异界神侍。”~
@98540 = ~“你，异界神侍，只有你，就像我从前对你说的，只有你。在他们的时候我爱着其他人，但是我很久没有见到什么人了，只有你。我对你说的是真的，异界神侍。只有你……”~
@98541 = ~“啊，异界神侍，那儿根本就不是什么地方。没什么地方，不算个地方，虚无的地方，界间之处，一个你自己找到我的地方。你喜欢吗？和我留在这里吧。”~
@98542 = ~“你是异界神侍，因为你带着他的戒指，问他的问题，追求他的追求。我也是我，面孔、位置和事情的混合体。”~
@98543 = ~“每次奸邪诡计得逞，就会有一个天使失去它的双翅……她会在卡尼亚之门找到你，异界神侍，我再次告诉你。一次又一次，我告诉了你。”~
@98544 = ~迷题“诸界智者”发现于卡尼亚荒地里。~
@98545 = ~“再见。”~
@98546 = ~“是的，我厌倦了等待。”~
@98547 = ~“我出于自愿。”~
@98548 = ~“我不是异界神侍。”~
@98549 = ~“众名智者被关在哪里？”~
@98550 = ~“但我不是你的异界神侍！”~
@98551 = ~“你只是不想告诉我！”~
@98552 = ~“不，但我希望你会。”~
@98553 = ~“是的，我做了……”~
@98554 = ~“第二个答案是？”~
@98555 = ~“无论如何还是谢谢你。”~
@98556 = ~“谢谢。”~
@98557 = ~“那意味着什么呢？”~
@98558 = ~“谢谢。”~
@98559 = ~看看沉睡者的戒指。~
@98560 = ~“你为什么不能告诉我？”~
@98561 = ~“和我谈谈你的姐妹吧，众名智者。”~
@98562 = ~“她让自己与恶魔相爱了？”~
@98563 = ~“异界神侍不爱你。”~
@98564 = ~“我不仅仅是爱你的思想……”~
@98565 = ~“你说过谎吗？”~
@98566 = ~“你爱谁？”~
@98567 = ~“这是什么地方？”~
@98568 = ~“你是谁？”~
@98569 = ~“我不知道你在说什么。”~
@98570 = ~众名智者转过身来，她苍白的脸上尽是悲伤。~
@98571 = ~突然众名智者出现在你眼前，她苍白的脸庞洋溢着胜利的喜悦，冰色的肌肤掩不住年轻的容貌。她向你靠过来，在你的耳边低声私语……~
@98572 = ~“啊，真名……每个名字都有它的价值，而价值又意味着一个名字。神如此宣布。你想知道谁的真名呢？”~
@98573 = ~“很好。我们一直在谈论你的真名……”~
@98574 = ~“我已经告诉你了，你所知道的卡尼亚收割者，按照神的语言应该叫做放逐者赫丘古斯……你还希望知道什么呢？”~
@98575 = ~“啊，我能感到这是你真正寻找的真名。不过，神需要一个奇怪的代价……有两个东西可以帮助你实现愿望：戒指和护身符。你必须交出它们。”~
@98576 = ~“卡尼亚收割者，按照神的语言应该叫做放逐者赫丘古斯……你还希望知道什么呢？”~
@98577 = ~“我已经告诉你了，你知道的魔鬼靡菲斯特，第八层地狱之主，按照神的语言他应该被叫做野心瑟拉克斯菲……还想知道什么呢？”~
@98578 = ~“在欺骗反叛中，有一件事情揭开了我所爱之人的虚伪外表，那就是莫雷克罗斯男爵和他本就是一个人。”~
@98579 = ~“他设法保证真相不为人知，他甚至禁止我提起他的名字。原谅我和我爱他的心，但是那个名字我无法告诉你……或许换一个吧？”~
@98580 = ~“很好，于他而言，神也有他们要求的代价，非常高昂……你愿意付出五十万金币来知道靡菲斯特的真名吗？”~
@98581 = ~“魔鬼靡菲斯特，第八层地狱之主，按照神的语言他应该被叫做野心瑟拉克斯菲……还想知道什么呢？”~
@98582 = ~“我已经告诉你，按照神的语言我叫作智者菲蕾丝……还要知道什么呢？”~
@98583 = ~“如果想知道我的真名，神要求你付出二十万金币的代价……你愿意吗？”~
@98584 = ~“尽管你知道我叫众名智者，按照神的语言我应该被叫做智者菲蕾丝……你还要知道什么呢？”~
@98585 = ~“我已经告诉你了，你所知道的阿顿·斯维菲特，按照神的语言应该叫做毁灭卡蒂思维特……你还希望知道什么呢？”~
@98586 = ~“如果你想知道阿顿·斯维菲特的真名，神要求你付出十万金币的代价……你愿意吗？”~
@98587 = ~“阿顿·斯维菲特，按照神的语言应该叫做毁灭卡蒂思维特……你还希望知道什么呢？”~
@98588 = ~“我已经告诉你了，你所知道的德哈瓦娜导师，按照神的语言应该叫做误导之法蕾西亚……你还希望知道什么呢？”~
@98589 = ~“如果你想知道德哈瓦娜导师的真名，神要求你付出十万金币的代价……你愿意吗？”~
@98590 = ~“德哈瓦娜导师，按照神的语言应该叫做误导之法蕾西亚……你还希望知道什么呢？”~
@98591 = ~“我已经告诉你了，采石场老板戈鲁乌，按照神的语言应该叫做卑鄙加格弗洛……你还希望知道什么呢？”~
@98592 = ~“如果你想知道采石场老板戈鲁乌的真名，神要求你付出十万金币的代价……你愿意吗？”~
@98593 = ~“采石场老板戈鲁乌，按照神的语言应该叫做卑鄙加格弗洛……你还希望知道什么呢？”~
@98594 = ~“我已经告诉你在你的星座上没有写下什么真爱。这是你的命运，再问也不会有什么改变……你还希望知道什么呢？”~
@98595 = ~“我已经告诉你，你的真爱按照神的语言应该叫做强壮之塞加里昂。你现在不认识他，不过你以后会的……你还想知道什么名字呢？”~
@98596 = ~“我已经告诉你，你的真爱按照神的语言应该叫做忍耐之塞雷斯法。他就是沉睡者……你还想知道什么名字呢？”~
@98597 = ~“我已经告诉你，你的真爱按照神的语言应该叫做恶魔斗士奥斯卡辛。他就是瓦伦……你还想知道什么名字呢？”~
@98598 = ~“我已经告诉你，你的真爱按照神的语言应该叫做美丽之卡桑德拉。你现在不认识她，不过你以后会的……你还想知道什么名字呢？”~
@98599 = ~“我已经告诉你，你的真爱按照神的语言应该叫做寻天者奎霏莉娅。她就是娜西拉……你还想知道什么名字呢？”~
@98600 = ~“我已经告诉你，你的真爱按照神的语言应该叫做双魂瓦达莉亚。她就是艾瑞贝丝女士……你还想知道什么名字呢？”~
@98601 = ~“如果你想知道自己真爱的名字，神需要你付出三十万金币的代价……你愿意吗？”~
@98602 = ~“很抱歉，地狱行者，神没有在你的星座上写下你的真爱。似乎你注定孤独一生。”~
@98603 = ~“爱是一件很艰难的事情，而没有它又会更加艰难……我很抱歉，地狱行者，我没有什么办法来使真相变得柔和一些……来吧，或许你还想知道别的名字。”~
@98604 = ~“神不会撒谎……”~
@98605 = ~“你的真爱按照神的语言应该叫做强壮之塞加里昂。你现在不认识他，不过你以后会的。”~
@98606 = ~“爱是很艰难的事情，但是我承认这不是我预料的反应。神已经赐予你属于自己的真爱。为什么你要抗拒这个呢？”~
@98607 = ~“神不会撒谎……”~
@98608 = ~“你的真爱按照神的语言应该叫做忍耐之塞雷斯法。他就是沉睡者。”~
@98609 = ~“你的真爱按照神的语言应该叫做恶魔斗士奥斯卡辛。他就是瓦伦。”~
@98610 = ~“爱是很艰难的事情，但是我承认这不是我预料的反应。神已经赐予你属于自己的真爱。为什么你要抗拒这个呢？”~
@98611 = ~“神不会撒谎……”~
@98612 = ~“你的真爱按照神的语言应该叫做美丽之卡桑德拉。你现在不认识她，不过你以后会的。”~
@98613 = ~“爱是很艰难的事情，但是我承认这不是我预料的反应。神已经赐予你属于自己的真爱。为什么你要抗拒这个呢？”~
@98614 = ~“神不会撒谎……”~
@98615 = ~“你的真爱按照神的语言应该叫做寻天者奎霏莉娅。她就是娜西拉。”~
@98616 = ~“爱是很艰难的事情，但是我承认这不是我预料的反应。神已经赐予你属于自己的真爱。为什么你要抗拒这个呢？”~
@98617 = ~“神不会撒谎……”~
@98618 = ~“你的真爱按照神的语言应该叫做双魂瓦达莉亚。她就是艾瑞贝丝女士。”~
@98619 = ~“爱是很艰难的事情，但是我承认这不是我预料的反应。神已经赐予你属于自己的真爱。为什么你要抗拒这个呢？”~
@98620 = ~“如我警告你的，认知有它的价格。你要求看到神书写在星座上的东西，而我也告诉你了。现在你必须承受后果……你还想知道什么？”~
@98621 = ~“很高兴真相让你高兴。并非所有的反应都如此热烈……现在你还想知道什么名字呢？”~
@98622 = ~“神不会撒谎……”~
@98623 = ~“我已经告诉你，星界使徒（用你的话叫做莱佛拉）就是沉睡者的真爱……你还想知道什么？”~
@98624 = ~“我已经告诉你，我就是沉睡者的真爱……你还想知道什么？”~
@98625 = ~“我已经告诉你，我的姐姐，也就是你知道的众名智者，她是沉睡者的真爱……你还想知道什么？”~
@98626 = ~“我已经告诉你，娜西拉是沉睡者的真爱……你还想知道什么？”~
@98627 = ~“我已经告诉你，德哈瓦娜导师是沉睡者的真爱……你还想知道什么？”~
@98628 = ~“我已经告诉你，艾瑞贝丝女士是沉睡者的真爱……你还想知道什么？”~
@98629 = ~“我已经告诉你，你是沉睡者的真爱……你还想知道什么？”~
@98630 = ~“如果你想知道沉睡者真爱的真名，你必须付出三十万金币的代价……你愿意吗？”~
@98631 = ~“沉睡者的真爱按照神的语言叫做年轻之泽拉米瑟亚……她就是星界使徒，或者按照你们的说法叫做莱佛拉。”~
@98632 = ~“神不会撒谎……”~
@98633 = ~“沉睡者的真爱按照神的语言叫做智者菲蕾丝……就是我，众名智者。”~
@98634 = ~“不，地狱行者……出于对我姐姐的尊敬，她就是你叫做诸界智者的人，我不会去。那会让她心碎的……”~
@98635 = ~“了解真相的危险就是他必须时刻面对这种知识带来的后果。这就是我们智者每天生活必须与之斗争的东西……”~
@98636 = ~“对我现在如此，将来亦然……知道哪些就足够多了，必须同时面对舒适和负担。”~
@98637 = ~“你用我的真名命令我，地狱行者……很好，一旦我们在这里结束了，我会回到你称作沉睡者的一方，那样我或许会成为他的真爱……”~
@98638 = ~“我们谈谈好些的事情吧……肯定还有别的你想知道的名字。”~
@98639 = ~“你在追踪别人，因为他们是你的真爱；你还要追踪别人，因为他们不是。当一个与你断开，自然要去追寻另一个……”~
@98640 = ~“神不会撒谎……”~
@98641 = ~“沉睡者的真爱按照神的语言叫做智者科德米莉亚……就是诸界智者。”~
@98642 = ~“神不会撒谎……”~
@98643 = ~“沉睡者的真爱按照神的语言叫做误导之法蕾西亚……就是德哈瓦娜导师……”~
@98644 = ~“神不会撒谎……”~
@98645 = ~“沉睡者的真爱按照神的语言叫做寻天者奎霏莉娅……就是娜西拉……”~
@98646 = ~“神不会撒谎……”~
@98647 = ~“沉睡者的真爱按照神的语言叫做双魂瓦达莉亚……就是艾瑞贝丝女士……”~
@98648 = ~“为什么，怎么了，地狱行者？”~
@98649 = ~“神不会撒谎……”~
@98650 = ~“沉睡者的真爱就是……就是你，地狱行者……”~
@98651 = ~“爱是很艰难的事情，但是我承认这不是我预料的反应。神已经赐予你属于自己的真爱。为什么你要抗拒这个呢？”~
@98652 = ~“如我警告你的，认知有它的价格。你要求看到神书写在星座上的东西，而我也告诉你了。现在你必须承受后果……你还想知道什么？”~
@98653 = ~“他等了很久；多等几个小时也没什么问题……来吧，还有什么别的问题吗？”~
@98654 = ~“神不会撒谎……”~
@98655 = ~“我已经告诉你，按照神的语言，沉睡者叫做忍耐之塞雷斯法……你还想知道什么？”~
@98656 = ~“如果你想知道沉睡者的真名，神要求你付出十万金币的代价……你愿意吗？”~
@98657 = ~“我已经告诉你，按照神的语言，沉睡者叫做忍耐之塞雷斯法……你还想知道什么？”~
@98658 = ~“我已经告诉你，按照神的语言，德金叫做鳞歌者伊谢利亚……你还想知道什么？”~
@98659 = ~“如果你想知道德金的真名，神要求你付出二十万金币的代价……你愿意吗？”~
@98660 = ~“按照神的语言，德金叫做鳞歌者伊谢利亚……你还想知道什么？”~
@98661 = ~“我已经告诉你，按照神的语言，娜西拉叫做寻天者奎霏莉娅……你还想知道什么？”~
@98662 = ~“如果你想知道娜西拉的真名，神要求你付出二十万金币的代价……你愿意吗？”~
@98663 = ~“按照神的语言，娜西拉叫做寻天者奎霏莉娅……你还想知道什么？”~
@98664 = ~“我已经告诉你，按照神的语言，瓦伦叫做恶魔斗士奥斯卡辛……你还想知道什么？”~
@98665 = ~“如果你想知道瓦伦的真名，神要求你付出二十万金币的代价……你愿意吗？”~
@98666 = ~“按照神的语言，瓦伦叫做恶魔斗士奥斯卡辛……你还想知道什么？”~
@98667 = ~“我已经告诉你，按照神的语言，艾瑞贝丝女士叫做双魂瓦达莉亚……你还想知道什么？”~
@98668 = ~“如果你想知道艾瑞贝丝女士的真名，神要求你付出二十万金币的代价……你愿意吗？”~
@98669 = ~“知识的价格总是昂贵的。没有人比我理解的更深，因为我付出了巨大的代价……但是还是有些名字比其他要便宜些。你还想知道什么？”~
@98670 = ~“按照神的语言，艾瑞贝丝女士叫做双魂瓦达莉亚……你还想知道什么？”~
@98671 = ~“我已经叫出了你的真名，你必须为此付出我的自由。以神的语言，你是残酷之拜扎登。”~
@98672 = ~“我已经叫出了你的真名，你必须为此付出我的自由。以神的语言，你是野性之默杜斯。”~
@98673 = ~“我已经叫出了你的真名，你必须为此付出我的自由。以神的语言，你是内省之卡基达。”~
@98674 = ~“我已经叫出了你的真名，你必须为此付出我的自由。以神的语言，你是自私之内泽本。”~
@98675 = ~“我已经叫出了你的真名，你必须为此付出我的自由。以神的语言，你是公正之纽索斯。”~
@98676 = ~“我已经叫出了你的真名，你必须为此付出我的自由。以神的语言，你是善良之以贝拉。”~
@98677 = ~“我已经叫出了你的真名，你必须为此付出我的自由。以神的语言，你是黑暗之德雷岑。”~
@98678 = ~“我已经叫出了你的真名，你必须为此付出我的自由。以神的语言，你是坚定之里休斯。”~
@98679 = ~“我已经叫出了你的真名，你必须为此付出我的自由。以神的语言，你是祝福之多尼塔。”~
@98680 = ~“我可以……残酷之拜扎登，你已经找到你寻觅的名字。现在去亡魂之城吧，你或许会在那里追寻你的命运。”~
@98681 = ~“我可以……野性之默杜斯，你已经找到你寻觅的名字。现在去亡魂之城吧，你或许会在那里追寻你的命运。”~
@98682 = ~“我可以……内省之卡基达，你已经找到你寻觅的名字。现在去亡魂之城吧，你或许会在那里追寻你的命运。”~
@98683 = ~“我可以……自私之内泽本，你已经找到你寻觅的名字。现在去亡魂之城吧，你或许会在那里追寻你的命运。”~
@98684 = ~“我可以……公正之纽索斯，你已经找到你寻觅的名字。现在去亡魂之城吧，你或许会在那里追寻你的命运。”~
@98685 = ~“我可以……善良之以贝拉，你已经找到你寻觅的名字。现在去亡魂之城吧，你或许会在那里追寻你的命运。”~
@98686 = ~“我可以……黑暗之德雷岑，你已经找到你寻觅的名字。现在去亡魂之城吧，你或许会在那里追寻你的命运。”~
@98687 = ~“我可以……坚定之里休斯，你已经找到你寻觅的名字。现在去亡魂之城吧，你或许会在那里追寻你的命运。”~
@98688 = ~“我可以……祝福之多尼塔，你已经找到你寻觅的名字。现在去亡魂之城吧，你或许会在那里追寻你的命运。”~
@98689 = ~“在一个永恒之地，时间又有何意义呢？我无法给出准确的数字，只能说自从莫雷克罗斯男爵的欺骗反叛之后我就来到了这里。”~
@98690 = ~“那是一个密谋推翻卡尼亚之主靡菲斯特的计划，至少是那些参与者的目的。他们盲目跟随着魅力十足的莫雷克罗斯男爵走向了灭亡。”~
@98691 = ~“好吧，不再谈论回忆，地狱行者。我没有多少带来欢乐的回忆了。”~
@98692 = ~“我后悔自己成为始作俑者……我爱靡菲斯特，力图保护他。我请神告诉我背叛者的名字，他们给出的名字都是他最亲近的同伴。”~
@98693 = ~“他不相信我，所以他有意策划了这个欺骗性的计划想证明我是错的。我自己知道……唉，神不会欺骗。因为愤怒，他把我和那些叛徒放逐到了这里……”~
@98694 = ~“低级别的都在战斗中被屠杀了。反叛的将军，总共十一人，被靡菲斯特放逐到了这个冰封的监狱。”~
@98695 = ~“所谓的男爵就是靡菲斯特本人。因为怀疑他的将军的忠诚，他自己导演了这场叛变，想在最亲近的朋友里找出叛徒。”~
@98696 = ~“因为那是你，你的过去，你的将来。神已经在星座上写下了它……即使这个黑暗的地方，你的存在也使之暗淡，地狱行者。”~
@98697 = ~“因为那是你，你的过去，你的将来。神已经在星座上写下了它……你是跨越这个黑暗裂痕的桥梁，地狱行者。”~
@98698 = ~“因为那是你，你的过去，你的将来。神已经在星座上写下了它……你给黑暗带来了光明，地狱行者。”~
@98699 = ~“对于名字，我不会犯错误。这就是天赋又是天谴……”~
@98700 = ~“你说的名字是你给自己起的名字。我说的名字是神赋予你的名字。它意义重大，请小心守护它。”~
@98701 = ~“按照普通人的叫法，我是众名智者，魔鬼们把我叫做远古的巴托之民。但我的真名是神书写在星座之上的，并非普通人能念出来的。”~
@98702 = ~“这些名字价值非凡，每一个都需要付出代价。你让我获得了自由，已经偿付了你自己真名的代价，所以我将它告诉你。”~
@98703 = ~反叛的众名智者，埋葬于卡尼亚偏远的冰层之下。~
@98704 = ~“再见。”~
@98705 = ~“我想知道其他名字。”~
@98706 = ~“回答我其他的问题。”~
@98707 = ~“收割者的……”~
@98708 = ~“谜题之戒和导师之护身符？它们就在这里。”~
@98709 = ~“靡菲斯特……”~
@98710 = ~“告诉我靡菲斯特的真名，智者菲蕾丝！”~
@98711 = ~“好，这是五十万金币。”~
@98712 = ~“你的……”~
@98713 = ~“好，这是二十万金币。”~
@98714 = ~“阿顿·斯维菲特的……”~
@98715 = ~“好，这是十万金币。”~
@98716 = ~“德哈瓦娜导师的……”~
@98717 = ~“好，这是十万金币。”~
@98718 = ~“采石场老板戈鲁乌的……”~
@98719 = ~“好，这是十万金币。”~
@98720 = ~“我的真爱是……”~
@98721 = ~“好，这是三十万金币。”~
@98722 = ~“不，不是！”~
@98723 = ~“呸！他们有勇无谋，不值得一战。”~
@98724 = ~“没有真爱？真的吗？”~
@98725 = ~“不，不是！”~
@98726 = ~“我的心爱着其他人。”~
@98727 = ~“我不认识他。”~
@98728 = ~“一个我不认识的人？真的吗？”~
@98729 = ~“沉睡者？真的吗？”~
@98730 = ~“不，不是！”~
@98731 = ~“我的心爱着其他人。”~
@98732 = ~“我对他没兴趣。”~
@98733 = ~“我几乎不知道他。”~
@98734 = ~“谢谢你，智者。他的名字对我太美了。”~
@98735 = ~“瓦伦？真的吗？”~
@98736 = ~“不，不是！”~
@98737 = ~“我的心爱着其他人。”~
@98738 = ~“我不认识她。”~
@98739 = ~“一个我不认识的人？真的吗？”~
@98740 = ~“不，不是！”~
@98741 = ~“她已经是沉睡者的真爱了！”~
@98742 = ~“娜西拉？真的吗？”~
@98743 = ~“不，不是！”~
@98744 = ~“她温柔、善良、柔弱！”~
@98745 = ~“她的心黑暗而残酷！”~
@98746 = ~“她死了！她已经迷失了！”~
@98747 = ~“她已经是沉睡者的真爱了！”~
@98748 = ~“我的心爱着其他人。”~
@98749 = ~“我对她没兴趣。”~
@98750 = ~“我几乎不认识她。”~
@98751 = ~“谢谢你，智者，她的名字对我而言似乎是仙乐。”~
@98752 = ~“艾瑞贝丝？真的吗？”~
@98753 = ~“那个沉睡者的真爱……”~
@98754 = ~“好的，这是三十万金币。”~
@98755 = ~“一个天神？真的吗？”~
@98756 = ~“太好了！快和我回去我们告诉他吧！”~
@98757 = ~“我理解……”~
@98758 = ~“但是你是他的真爱！”~
@98759 = ~“智者菲蕾丝，我命令你去见沉睡者！”~
@98760 = ~“你对靡菲斯特的爱？”~
@98761 = ~“禁止你？快和我回去吧，你会见到他！”~
@98762 = ~“你？真的吗？”~
@98763 = ~“诸界智者？真的吗？”~
@98764 = ~“导师？真的吗？”~
@98765 = ~“娜西拉？真的吗？”~
@98766 = ~“太可怕了！不可能这样啊！”~
@98767 = ~“她死了！”~
@98768 = ~“看起来不太适合。”~
@98769 = ~“我是爱着他的人！”~
@98770 = ~“太好了！我得回去告诉他！”~
@98771 = ~“艾瑞贝丝女士？真的吗？”~
@98772 = ~“太可怕了！这不能在我这里出现啊！”~
@98773 = ~“他是一个嗜杀的天使，大声说出来吧！”~
@98774 = ~“我的心爱着其他人。”~
@98775 = ~“我对他没兴趣。”~
@98776 = ~“我几乎不认识他。”~
@98777 = ~“太好了！我得回去告诉他！”~
@98778 = ~“我？真的吗？”~
@98779 = ~“沉睡者的……”~
@98780 = ~“好的，这是十万金币。”~
@98781 = ~“德金的……”~
@98782 = ~“好的，这是二十万金币。”~
@98783 = ~“娜西拉的……”~
@98784 = ~“好的，这是二十万金币。”~
@98785 = ~“瓦伦的……”~
@98786 = ~“好的，这是二十万金币。”~
@98787 = ~“艾瑞贝丝的……”~
@98788 = ~“现在不行，智者。”~
@98789 = ~“好的，这是二十万金币。”~
@98790 = ~“我的……”~
@98791 = ~“我得回到亡魂之城。你能带我回去吗？”~
@98792 = ~“你被关在这里多久了？”~
@98793 = ~“欺骗反叛？什么意思？”~
@98794 = ~“回到我其他的问题吧。”~
@98795 = ~“你在欺骗反叛中扮演着什么角色呢？”~
@98796 = ~“反叛者后来怎样了？”~
@98797 = ~“这位男爵是谁，为什么他带领他们走向灭亡？”~
@98798 = ~“你为什么叫我卡尼亚之惩罚？”~
@98799 = ~“你为什么叫我卡尼亚之公正？”~
@98800 = ~“你为什么叫我卡尼亚之光？”~
@98801 = ~“你肯定错了，我的名字是<CHARNAME>·<CHARNAME>。”~
@98802 = ~“你是谁？”~
@98803 = ~杜尔南的脸上渗出了汗珠。他喊出了命令，可是声音都被战斗的厮杀淹没了。他看起来比你记得的要老些，他的肩膀因为诸多失利的负担而被压得很低。他转过身来，很惊奇。~
@98804 = ~“无论你在哪里，都要地方背后的敌人，我的朋友。卓尔的威胁只是为了掩饰更大的恐怖。我们的牧师说魔王靡菲斯特已经来到了这个世界。”~
@98805 = ~“坦西尔，我的女儿，跟随商队逃到了无冬城。然而，麦雷，我好几天没有见到她了……时间很可怕：我们的牧师说魔王靡菲斯特已经来到了这个世界。”~
@98806 = ~“来吧，我的朋友。现在看来，卓尔的入侵只是更大为了掩饰更大的威胁。你说起的魔王似乎已经来到了这个世界。”~
@98807 = ~“在有些事情上我永远不能理解你，但是我必须说再次看到你我轻松了许多。牧师们说魔王靡菲斯特已经来到了这个世界。”~
@98808 = ~“当你不在的时候，似乎我们已经身处地狱一般。卓尔的威胁只是为了掩饰更大的恐怖。我们的牧师说魔王靡菲斯特已经来到了这个世界。”~
@98809 = ~“即使现在我们还在与他的走狗们作战。有些地区还在抵御他们的冲击，但是那只是在靡菲斯特没有亲自参加战斗的地方。我们且战且走，苟延残喘。”~
@98810 = ~“他会把我们全部毁灭，<CHARNAME>……所有的地区都会陷落……祝福那些死去的人吧，因为剩下的人都将成为他的奴隶……或许你现在来有某个理由，但是我看不到。”~
@98811 = ~“你想让我命令我的人进入九渊地狱的烈火中！该死的，<CHARNAME>！你没有来过这里！你没有看到我所看到的东西！如果你勇敢抑或愚蠢，自己去面对他吧！我办不到……”~
@98812 = ~“但愿神会赐予你力量。每次战斗之后他都会更加强大。有报告说他正前往这里。如果他来了我会让我的人撤退的……你是我们唯一的希望了，<CHARNAME>。”~
@98813 = ~杜尔南，深水城卫队的领导。用他的队伍作出了向导。~
@98814 = ~“别担心我了。告诉我我能帮什么。”~
@98815 = ~“这是一个很长的故事。你的家安全吗？”~
@98816 = ~“我和靡菲斯特有些事情还没有结束。”~
@98817 = ~“我死过……”~
@98818 = ~“我去了地狱并回来了，杜尔南……”~
@98819 = ~“我知道，杜尔南……我也被吓坏了……”~
@98820 = ~“你没有骨气吗？他是个魔鬼。干掉他！”~
@98821 = ~“确保每个人的安全。我来对付靡菲斯特。”~
@98822 = ~靡菲斯特的身上有上千个伤口在渗出鲜血、火焰和脓液，他躺在地上。他的眼睑闪烁着光芒，在深处紧盯着你。~
@98823 = ~你的对手靡菲斯特，在你身边高高耸立，周身放射着火焰。他让你丧失了优势地位，对着你渺小的身形发出了轻蔑的嗤笑。~
@98824 = ~“相信我，人类，你没有那个能力……统治世界需要锐利的思维和冷酷的心。你真的……不够。”~
@98825 = ~“加入我？抱歉，凡人，但这是独角戏……我曾拥有过‘朋友’。大概十一或是十二个，为了一起干那件事。但到了最后，我想他们都不是真的喜欢我，真的要做我的‘朋友’。”~
@98826 = ~“你和那些军队，愚蠢的人类？我敢说他们逃走了并让你独自面对我。真遗憾。”~
@98827 = ~“我……我的真名！你控制了我！？你从哪儿知道的？！啊，但我必须服从！……你……你想让我做什么呢，<LADYLORD>？我该如何为您效劳？”~
@98828 = ~“我……我的真名！你控制了我！？你从哪儿知道的？！啊，但我必须服从！……你……你想让我做什么呢，<LADYLORD>？我该如何为您效劳？”~
@98829 = ~“现在……和你一起的是谁，<CHARNAME>？不是狗头人，他是真正的龙！充满着力量！告诉我，小东西，为什么你想虔诚的仆人跟随着<CHARNAME>，而你本来可以更厉害的？”~
@98830 = ~[德金回答，倾向于靡菲斯特的争辩]~
@98831 = ~[他公开指责玩家，但还是被迫遵从]~
@98836 = ~“那么年轻的泰夫林还是屈尊和你一同旅行……瓦伦·影息，对吧？很荣幸遇见你，我的年轻人。你的名声已经远扬于外了。”~
@98837 = ~[瓦伦回答，倾向于靡菲斯特的争辩]~
@98838 = ~[他公开指责玩家，但还是被迫遵从]~
@98843 = ~“我发现娜西拉还是和你在一起，<CHARNAME>。但是多久呢？我们都知道你不属于任何地方，娜西拉。伊丽思璀什么都没有给你……但我可以给你一切东西！”~
@98844 = ~“她说……她说他们希望我下去。我们得阻止瓦纱瑞丝。她说她以后会让我重生，在打败瓦纱瑞丝之后。她许诺……她许诺在那之后……”~
@98845 = ~娜西拉突然转过头来，她的面孔因为痛苦而扭曲，因为真名的力量控制了她。她紧盯着你，充满了愤怒。“现在我们看穿你了，<CHARNAME>·<CHARNAME>。”~
@98846 = ~“你认为我怕死，<CHARNAME>？你真的如此不了解我吗？你和其他人都一样；你不会让我脱离我的过去。我要加入靡菲斯特来对付你。”~
@98848 = ~“他说的话有些是真的。我试图把过去留在身后，但是我不能。这就是我。我生为黑暗精灵，作为红色姐妹而长大。什么都改变不了。”~
@98849 = ~“别害怕，<CHARNAME>。我不会让这个魔鬼的话改变我对你的忠诚。我知道他在说谎。”~
@98850 = ~“但是我得谢谢你如此细心照顾我忠实的仆人。你能安全的把她带到这里真是太好了。对吗，我的小姐……”~
@98851 = ~[艾瑞贝丝回答，倾向于他的争辩]~
@98852 = ~“我在想什么时候那张牌会出现呢……说实话，我认为它不在你那里。那属于<CHARNAME>，靡菲斯特：<HESHE>有一些精巧的小东西……”~
@98853 = ~“说得真好，真是感人啊。我一定要把它刻在你的墓碑上。~
@98854 = ~“哦，<HESHE>是个能言善辩的人，靡菲斯特。你知道你们魔鬼的问题吗？你们想的太少了。我不会把自己的雄心仅仅局限于你那个漂亮的地狱之中。”~
@98855 = ~“你虚弱而且绝望。就像一只使人厌恶的小狗。赢得朋友或者盟友不是靠这种方式。对不起，我已经做出了决定。”~
@98856 = ~“别注意<HIMHER>！看看<HESHE>有多绝望？”~
@98857 = ~“但是我确实看到你带着你那个漂亮的圣武士……我们最后一次见面已经很久了，不是吗？如果我记得没错，你哭着离去，对于你在世界上的位置极为困惑……”~
@98858 = ~[艾瑞贝丝回答，倾向于他的争辩]~
@98859 = ~“哦我让生活变得多么混乱，<CHARNAME>，这个死亡……我不知道是否应该亲吻你还是扇你的耳光。如果我们活了，也许还有很多时间来考虑这一点。”~
@98860 = ~“已经这样了……”~
@98862 = ~“我怎么对待它呢？除了死亡和失望……我的灵魂和靡菲斯特在一起。永远是这样……很抱歉，<CHARNAME>……”~
@98863 = ~“你把我从冰墓中带回来，<CHARNAME>。你是我的基石，我的试金石……你是对的。如果没有别的，我信任你。靡菲斯特去死吧……”~
@98864 = ~“我一直以为你能够领会我的意思。我试图获得整个巴托地狱的统治权。准确地说，所有十个地狱……不过有个阻碍。你看，我似乎是碰到了一点困难……”~
@98865 = ~“我该怎样把你珍贵的世界打造成地狱呢？说实话，我的意思是，该怎样装饰这个地方呢？嗯……土色调的装饰就很适合。”~
@98866 = ~“多么机智啊！你不喜欢最可爱的卡尼亚，真令人遗憾。我想我把它留给你真是很够意思。想像一下：你也许会成为第八地狱的主人。这难道不是所有凡人都渴望得到的地位吗？”~
@98867 = ~靡菲斯特。他强大，他邪恶，他是女孩们的梦想……~
@98868 = ~“回卡尼亚去，永远不要回来……”~
@98869 = ~“我再也不想见到你。”~
@98870 = ~“不会有下次了……”[杀死他。]~
@98871 = ~“这个世界是我的！”~
@98872 = ~“没有荣誉……”[杀死他。]~
@98873 = ~“忏悔吧！”~
@98874 = ~“对我的诅咒回到你自己那里吧！”[杀死他。]~
@98875 = ~“我来替换你。”~
@98876 = ~“我来加入你。”~
@98877 = ~“我来阻止你。”~
@98878 = ~“你给我的只是一个空壳。准备受死吧。”~
@98879 = ~“那么来代替我吧。用你的全力！”~
@98880 = ~“野心瑟拉克斯菲，给我交出托瑞尔！”~
@98881 = ~“把卡尼亚交换给它本来的居民，智者！”~
@98882 = ~“为你的罪行忏悔吧！愿你的心重归善良！”~
@98883 = ~“那么和我动手吧，你这个懦夫！”~
@98884 = ~“那么我道歉：你把死亡带给了自己。”~
@98885 = ~“野心瑟拉克斯菲，服从我！”~
@98886 = ~“我会去开个旅店让你坐女仆！”~
@98887 = ~“你会跟随我冒险，做我的佣兵！”~
@98888 = ~“我会统治巴托地狱，你会做我的仆从。”~
@98889 = ~“和我一起统职屯行地狱吧！”~
@98890 = ~“你连一半都不知道！和我战斗吧，你这个懦夫！”~
@98891 = ~“那么我要死来试试……”~
@98892 = ~“野心瑟拉克斯菲，我命令你停止屠杀！”~
@98893 = ~“和我动手吧！”~
@98894 = ~“为我效劳直到你死！”~
@98895 = ~“回到卡尼亚，永远留在那里！”~
@98896 = ~“愿你的心重归善良！”~
@98897 = ~“我命令你死！”~
@98898 = ~[玩家认识到了德金的出卖]~
@98899 = ~[玩家用德金的真实名字（鳞歌者伊谢利亚）命令他]~
@98902 = ~[[玩家认识到了瓦伦的出卖]~
@98903 = ~[玩家用瓦伦的真实名字（恶魔斗士奥斯卡辛）命令他]~
@98906 = ~“和他站到一边吧。我知道你最终会背叛我。”~
@98907 = ~“寻天者奎霏莉娅，我命令你和我站在一边！”~
@98908 = ~“你愿意面对谁的愤怒呢？他的还是我的！？”~
@98909 = ~“别理他，娜西拉。你自己已经脱离红色姐妹了。”~
@98910 = ~“那么和你去地狱吧，我要把你们都干掉！”~
@98911 = ~“双魂瓦达莉亚，我命令你和我站在一边！”~
@98912 = ~“我比他要邪恶得多，亲爱的……”~
@98913 = ~“我能提议一个双方都能接受的方法吗？”~
@98914 = ~“曾经做过叛徒，永远都是叛徒，……”~
@98915 = ~“双魂瓦达莉亚，我命令你和我一起战斗！”~
@98916 = ~“我会让你死得极为痛苦！”~
@98917 = ~“他在说谎！你的信任来自你自己，艾瑞贝丝。”~
@98918 = ~“为什么你要这么做？”~
@98919 = ~“让你失望了，地狱早就已经冰封了。”~
@98920 = ~“抓出他们！从后面包围！”~
@98921 = ~“我们的迷！我们珍贵的迷！”~
@98922 = ~“干掉他们！”~
@98923 = ~“他们绝不能打扰神圣的迷题！”~
@98924 = ~“入侵者！把他们赶出去！他们是来解开我们的迷！”~
@98925 = ~尽管这个投石器上布满了烧焦的痕迹和战斗中留下的伤痕，但它看来还能够使用。如果能把它带到众名智者的冰封监狱，或许能让它发挥更多作用……~
@98926 = ~离开。~
@98927 = ~把投石器扔过熔岩。~
@98928 = ~开膛破肚的尸体上覆盖着一层冰霜。那人死不瞑目，眼睛还直勾勾地盯着叛军将领的空牢房。血战来临之时，他或许没能挨上多久。~
@98929 = ~一根冰晶突出于冰层之外，黑暗的轮廓一直蜿蜒绕下。~
@98930 = ~晶体变得暗淡无光，它和靡菲斯特的联系现在被切断了。~
@98931 = ~离开。~
@98932 = ~窥探晶体。~
@98933 = ~“为了血战！！！！”~
@98934 = ~“我们的补给不够了！快送点来！”~
@98935 = ~“把他们赶会去！”~
@98936 = ~“去死吧魔鬼！”~
@98937 = ~“当心那里！”~
@98938 = ~“为了血战！！！！”~
@98939 = ~“卡尼亚属于我们！”~
@98940 = ~“滚回你的深渊魔域去，恶魔！”~
@98941 = ~“为了巴托！”~
@98942 = ~“挡开他们！”~
@98943 = ~这段栅栏看起来很旧了。木头都向四面八方裂开了。~
@98944 = ~看来这里有足够的木头来点火。~
@98945 = ~当莓果破开，里面就会喷射爆发出能量来，点燃你附近的树木。大火会由此而生，它的温暖会在很长一段时间内伴随你。~
@98946 = ~当莓果破开，里面就会喷射爆发出能量来，点燃你附近的树木。火会由此而生，它的温暖会在一段时间内伴随你。~
@98947 = ~当莓果破开，里面就会喷射爆发出能量来，点燃你附近的树木。小火会由此而生，它的温暖稍微伴随你一小会。~
@98948 = ~卡尼亚刺骨的风在火点起来之前就吹灭了它。你得找别的方法来点火。~
@98949 = ~火的温暖让人心宁静，驱走了卡尼亚的刺骨寒冷，让营地舒适了起来。~
@98950 = ~离开。~
@98951 = ~用二十个维洛克斯莓来点起一场烈火。~
@98952 = ~用三个维洛克斯莓来点起一场大火。~
@98953 = ~在休息前等一会。~
@98954 = ~用两个维洛克斯莓来点火。~
@98955 = ~在休息前等一会。~
@98956 = ~用一个维洛克斯莓来点起一场小火。~
@98957 = ~停止宿营。~
@98958 = ~在休息前等一会。~
@98959 = ~休息。~
@98960 = ~用燧石和火绒点火。~
@98961 = ~这个通道被一个冰瀑布挡住了。或许是你刚才与之战斗的那个恶魔趁你不注意时使的坏。想要打开这条通道对任何生物来说都是一件相当大的工程。~
@98962 = ~脚下是酷热，周围弥漫着煤渣。在煤上步行的想法让你拥有了极其痛苦的经验。~
@98963 = ~“我会让那些恶魔见识一下真正的血战！”~
@98964 = ~“间谍！恶魔把小家伙作为间谍派到我们当中来！”~
@98965 = ~“我会把他们全都碾碎，不论是魔鬼还是恶魔！”~
@98966 = ~“血战就在眼前！他们刚在城墙外开战了！”~
@98967 = ~“啊……啊！小家伙！是魔鬼还是恶魔？我不知道……”~
@98968 = ~你没有办法直接用它。~
@98970 = ~“你会在痛苦中永受煎熬！”~
@98971 = ~“我会高兴的看着你在痛苦中痛不欲生！”~
@98972 = ~“你没有希望！”~
@98973 = ~“去死！”~
@98974 = ~“你们都去死吧！这片土地是我创造的地狱！”~
@98975 = ~“现在走吧，永远不要回来。”~
@98977 = ~你在考虑如何把沉睡者戒指的三部分最终结合起来。然而，等你找到所有的部分，还是很难说。~
@98978 = ~沉睡者戒指的三个部分在你的手里闪闪发光，每个都雕刻了一个不同的字。你不知道该从哪个开始。~
@98979 = ~你把标着“希”的戒指的一部分和其他分开，用你的手指握住它。它闪烁着微弱的光芒，似乎在鼓励你继续下去。~
@98980 = ~你惊讶地跳了起来，因为有一股电流冲过了你的身体。你看到戒指在你的手中自行解体。显然，你做错了。~
@98981 = ~你把标着“信”的戒指的一部分和标着“希”的装在一起。接缝慢慢发光，然后消失了，两个部分结合在了一起。~
@98982 = ~你放进最后那个部分，上面标着“爱”。接缝闪闪发光，最终组成了完整的戒指。三个字，“希”、“信”、“爱”，现在与沉睡者的祈祷中提起希望、信仰和爱对应起来。~
@98983 = ~你惊讶地跳了起来，因为有一股电流冲过了你的身体。显然，你做错了。~
@98984 = ~收起戒指碎片。~
@98985 = ~从标着“爱”的部分开始。~
@98986 = ~从标着“希”的部分开始。~
@98987 = ~装上标着“爱”的部分。~
@98988 = ~装上标着“信”的部分。~
@98989 = ~把戒指分开，并收好。~
@98990 = ~装上最后一个部分，“爱”。~
@98991 = ~从标着“信”的部分开始。~
@98992 = ~老鼠四处急跑，搜寻闪烁的宝石来装饰自己的窝。它躲在箱子的阴影里，尽力想避开陌生人贪婪的目光。~
@98993 = ~老鼠用牙齿叼住一颗宝石，正慢慢地拖着这个战利品回到自己的窝里去。它躲在箱子的阴影里，尽力想避开陌生人贪婪的目光。~
@98994 = ~你偶然在雪中发现了一些半埋的足迹，但是无法分辨它们的首尾。~
@98995 = ~你在雪中发现了一些半埋的足迹。看起来好像是稍小的某种狗类动物，或者是其他你无法认出的大家伙。~
@98996 = ~你在雪中发现了一些半埋的足迹。多数可能是一群前往西面的洞穴的大座狼留下的。一组大座狼脚印意味着有个强大的头狼在带领着这个群体。~
@98997 = ~一组大座狼脚印意味着有个强大的头狼在带领着这个群体。然而，惊讶得是，你没有发现幼畜的痕迹。~
@98998 = ~再往远方一点，你还看到了一些旧的脚印，它们是巨魔留下的。根据其深度还有寒冷的天气，你怀疑有几个冰巨魔一定把这个地方当作自己的家了。~
@98999 = ~你在每条尘土中的道路都偶然发现了啮齿动物的痕迹。~
@99000 = ~你在尘土满布的地面上看到了一些陈旧的老鼠痕迹。他们在附近肯定有个窝。~
@99001 = ~你在尘土满布的地面上看到了各种各样陈旧的老鼠痕迹。他们都通向角落的一对箱子，在那里你能看到他们咬穿了一些小洞。毫无疑问它们在附近有个窝。~
@99002 = ~你在雪中偶然发现不同的大痕迹。它们肯定块头很大。~
@99003 = ~你在雪中看到一些深深的脚印。他们的体积表示着是巨大的类人生物留下的，尽管还有一些你无法认清的稍小些的脚印。~
@99004 = ~你看到雪地里有不少脚印。多数是一群霜巨人留下的大脚印，不过你也看到了一些可能属于冰巨魔的小一点的脚印。~
@99005 = ~虽然脚印混杂在一起，他们似乎没有什么冲突。你怀疑这两队生物是否只是单纯的会面，他们似乎不得不搁置一些小的争议了。~
@99006 = ~你在被踩踏的一团糟的雪地上偶然发现了一些血迹，但你不知道它是谁留下的。~
@99007 = ~你在被踩踏的一团糟的雪地上发现了一些血迹。有些脚印似乎是原生的巨魔。~
@99008 = ~你在被踩踏的一团糟的雪地上发现了一些血迹，很快就确定巨魔派出了一小队人发起了袭击，试图抓捕一些霜巨人的猎狼。~
@99009 = ~通过血迹，你可以判断出，其中一个巨魔一定无法控制它的饥饿，在回到安全的家的路上就开始撕咬起猎物来。~
@99010 = ~你偶然在积雪下方发现了大块的冰，你不知道它们是如何形成的。~
@99011 = ~你在积雪里看到了一个比较规则的冰块突出来。他们似乎也组成了一列脚印，不过在靠近霜巨人的地方变得乱七八糟。~
@99012 = ~一种火热的生物，可能是某种火元素的形式，把积雪融化并最终冻结形成了冰的脚印。~
@99013 = ~通过痕迹的混乱判断，他们有好几个，并且他们可以在巡逻的霜巨人前突然出现，并把他放倒。他倒下的痕迹非常深。~
@99014 = ~脓水成池，烂泥成堆，它们标志着你刚看到的残酷战斗。~
@99015 = ~脓水成池，烂泥成堆，它们标志着你刚看到的残酷战斗。血迹通向碎裂的墙，战斗还在向下延伸。~
@99016 = ~脓水成池，烂泥成堆，它们标志着你刚看到的残酷战斗。血迹通向碎裂的墙，战斗还在向下延伸。~
@99017 = ~你靠近来仔细看看那些痕迹，注意到它们似乎疲惫而伤势严重，似乎他们卷入的战斗已经持续了很长一段时间。~
@99018 = ~你偶然发现了几乎被雪覆盖起来的深深的脚印。这些脚印肯定是很久之前留下的，只是因为深度和尺寸才一直保持可见。~
@99019 = ~你看见几乎被雪覆盖起来的深深的脚印，尽管时间挺长了，你能看出它是大约身材中等的人类留下的，其他可能是很大的、奇形怪状的魔鬼留下的。~
@99020 = ~你看见几乎被雪覆盖起来的一对脚印。尽管时间挺长了，你能看出它是一个相对虚弱的男性人类留下的，或许是某个法师，接近了附近的陷阱。~
@99021 = ~看起来他一定进行了某种仪式，融化了寒冰，释放了某个犯人，似乎是一个体格魁伟、奇形怪状的怪恶魔。~
@99022 = ~显然随后发生一场口角，那个怪恶魔显然很快就解决了那个释放他的人。恶魔笨拙的步伐在战场上留下了它的证据。~
@99023 = ~最近战斗的证据已经被卡尼亚无尽的落雪覆盖了。~
@99024 = ~通过研究那些消逝的痕迹，它们是敌对的恶魔和各自无数的战争机器留下的，你能看到各种各样的阵地、佯攻和最近战斗的战略。~
@99025 = ~你不知道是否有一方知道在他们战斗的连绵冰原之下，埋藏的东西的重要性……~
@99026 = ~通过研究那些消逝的痕迹，它们是敌对的恶魔和各自无数的战争机器留下的，最近的战斗已经进行了一段时间，战斗力双方互有胜负。~
@99027 = ~显然较少的恶魔们是战斗开始的牺牲品，随后就是激烈的炮火攻击，它摧毁了双方的战争机器。~
@99028 = ~当你到达的时候，恶魔们稍微获得了一些优势，并把前沿向前推进。然而这种优势也耗尽了他们的资源，迫使他们开始投掷所有生下来的废物。~
@99029 = ~你不知道是否有一方知道在他们战斗的连绵冰原之下，埋藏的东西的重要性……~
@99030 = ~狼小心的嗅着你，只要看到突然的移动，随时准备逃走重新集结。~
@99031 = ~头狼对你点点头，在它把注意力转移到嬉闹的幼崽之前，你可以发誓自己看到它对着你点了点头。~
@99032 = ~头狼对着风中的天空嚎叫着，他的吼声似乎在诉说着某个故事……~
@99033 = ~这曾经有过幼崽，群狼活力的源泉。但是随后巨人们来了，他们摧毁了这个窝，把幼崽偷走以作为自己的猎犬。只要幼崽能回来，狼群会重新强盛起来。~
@99034 = ~头狼坚强的站在你的面前，咆哮着。你能闻到其他狼害怕的味道。~
@99035 = ~头狼咆哮着咬着你的脖子，在放开之前就渗出了鲜血。它对着风中的天空怒吼着，此时压力减轻了。~
@99036 = ~他的吼声似乎有个故事：这曾经有过幼崽，群狼活力的源泉。但是随后巨人们来了，他们摧毁了这个窝，把幼崽偷走以作为自己的猎犬。只要幼崽能回来，狼群会重新强盛起来。~
@99037 = ~幼狼拽着你的脚后跟，似乎想和你一起玩。~
@99038 = ~幼狼兴奋得吠叫着，跑出了围栏。~
@99039 = ~狼似乎看见你很高兴。~
@99040 = ~浪小心的嗅嗅你，只要看到突然的移动，随时准备逃走重新集结。~
@99041 = ~狼还是对你很小心，不过好像乐于让你通过。看起来它想把你引见给狼群的头狼。~
@99042 = ~对着它的口露出你的脖子。~
@99043 = ~攻击头狼。~
@99044 = ~离开。~
@99045 = ~让它嗅吧。~
@99046 = ~攻击它。~
@99047 = ~你进不去狼窝。~
@99048 = ~那样接近狼窝似乎不太明智。~
@99049 = ~门锁上了。~
@99050 = ~一些古旧的箱子组成了一堵墙，挡住了你的去路。它们似乎是用某种奇怪、不知名的金属制作而成的。魔力在这些障碍物周围盘旋，显然它们并不像看起来那么简单。~
@99051 = ~不过，看起来在魔法中有一个小的间隙，某些胆大的老鼠成功地利用了其弱点，打穿了通向另一端的洞。~
@99052 = ~有东西在下面的黑暗中闪烁着。黄金？老鼠的眼睛？隐藏的敌人？黑暗使它难以分辨。~
@99053 = ~好像飞行不再可行，因为你太大了无法遮掩穿过那个洞。~
@99054 = ~离开。~
@99055 = ~通过洞看看。~
@99056 = ~飞过那个洞。~
@99057 = ~你把两个耳朵给雕像装上了。惊讶的是，怪兽的嘴巴张开了，露出了一个小开关。~
@99058 = ~你听见按顺序敲了三声锣响。它们在整个房间里回荡着。~
@99059 = ~你把一个耳朵给雕像装上了，但是第二个还是空的。~
@99060 = ~你靠近观察，注意到雕像没有耳朵。原来应该是耳朵的地方被两个小孔代替了，似乎可以装进什么东西。~
@99061 = ~按动开关。~
@99062 = ~把另一个耳朵放进剩下的孔里。~
@99063 = ~离开。~
@99064 = ~把两个耳朵都装进孔里。~
@99065 = ~把一个耳朵装进孔里。~
@99066 = ~导师之护身符中间的晶体闪烁着放出光芒，似乎渴望见到光。它的折射有些奇怪，但是你也不知道它是什么。~
@99067 = ~导师之护身符比你最初的想法拥有更多的能量。在特定的角度，它的晶体中心会捕获光线，暂时改变你的外形。一点一点，你感到掌握了这些新发现的能量。~
@99068 = ~在憔悴、疲倦和惊讶中，你握住了导师之护身符。在这里，城市的尘垢之下，光线更加明亮，不知何故它似乎和你最近意外的变化联系到了一起。~
@99069 = ~每次你改变外形，你都看到从护身符中心放射出了光芒。你小心地开始进一步的研究。~
@99070 = ~收起护身符。~
@99071 = ~变形为狼。~
@99072 = ~把长边对准光线。~
@99073 = ~变形为土元素。~
@99074 = ~把宽边对准光线。~
@99075 = ~变形为皮克精。~
@99076 = ~把高边对准光线。~
@99077 = ~收起护身符。~
@99078 = ~把长边对准光线。~
@99079 = ~把宽边对准光线。~
@99080 = ~把高边对准光线。~
@99081 = ~老鼠对你眨眨眼睛，在把注意力转到嗅他面前的尸体前皱了皱鼻子。~
@99082 = ~老鼠抬眼看看你，似乎它和这些窝一样古老。在它们黑暗的思维深处，你可以看到一系列连续快速闪动的画面。~
@99083 = ~你看到白骨和腐烂的肉体，闪烁着目标的期望，最重要的是，永远的力求生存。~
@99084 = ~从老鼠那里似乎涌动着感激的温暖。你可以清楚地感到它希望你看看它的窝，但是你不确定自己是否可以进到它咬出的洞里。~
@99085 = ~它害怕的尖叫着跑开了。~
@99086 = ~老鼠似乎对它长久以来收集的财富有一种很强的占有欲。你感到它把那些东西藏在了一个只有老鼠可以到达的地方。~
@99087 = ~腐烂的肉体和白骨带来了一种舒服的气息，一种家的感觉。看起来老鼠要利用来自这些洞穴的decay来组成自己的巢穴。~
@99088 = ~离开。~
@99089 = ~喂老鼠一些种子。~
@99090 = ~攻击老鼠。~
@99091 = ~集中到闪烁物体的画面上。~
@99092 = ~集中到死亡和腐败的画面上。~
@99093 = ~老鼠对你眨眨眼睛，在回去咬他面前尸体的脚后跟之前皱了皱鼻子。~
@99094 = ~[邪恶]“滚开。”~
@99095 = ~---------- Random Pop-Ups Start Here ------------~
@99096 = ~“但是我们的旅程还没有结束。你确定吗？”~
@99097 = ~“谢谢，<CHARNAME>。愿泰尔指引我们前进。”~
@99098 = ~“这里？很好，不过你要快点回来，因为我怀念你的温暖和陪伴。”~
@99099 = ~“对……对不起，<CHARNAME>，我不想冒犯……我想我会回到门房，祈祷你快点平安回来。”~
@99100 = ~“是的，你觉得怎么样才能更合适呢？”~
@99101 = ~“很好。我会记住这些变化的。”~
@99102 = ~“很好。我会避免施法，改为信任我的利刃。”~
@99103 = ~“谢谢。我会施展我认为合适的法术。”~
@99104 = ~“我会尽力避免的，不过我承认做一个圣武士似乎有点背离我的职业。”~
@99105 = ~“当然。我作为圣武士的责任就是让我们都保持健康。”~
@99106 = ~“那样最好。我喜欢这样。”~
@99107 = ~“我会尽力的，尽管阴间的事情已经超出了我的知识范围。”~
@99108 = ~“好。我担心这幅铠甲让我无法放轻脚步。”~
@99109 = ~“我会在可能的时候从阴影发起攻击，尽管我必须承认我更愿意光明正大的战斗。”~
@99110 = ~“我会尽力保持安静，不为人所见。”~
@99111 = ~“我会让你来做，绝不插手。”~
@99112 = ~“如果碰到锁，我会来解决。”~
@99113 = ~“当然。你认为多远合适？”~
@99114 = ~“我会在那个距离跟着你。”~
@99115 = ~“以泰尔的力量，我要赶走我们的敌人。”~
@99116 = ~“以泰尔的力量，我会尽我所能掩护你。”~
@99117 = ~“你还要讨论别的战术吗？”~
@99118 = ~“很好但是我不想你拿走我的铠甲。”~
@99119 = ~“我能试试。让我翻翻你的东西看看你有些什么。”~
@99120 = ~“我有几个……你想让我用哪一个呢？”~
@99121 = ~“以泰尔的名义。”~
@99122 = ~“以泰尔的名义。”~
@99123 = ~“当然。你愿意得到长久利益还是只想得到眼前利益呢？”~
@99124 = ~“当然。我为你该释放哪个魔法？”~
@99125 = ~“你肯定要释放这个魔法吗？”~
@99126 = ~“如你所愿。你想让我为谁释放呢？”~
@99127 = ~“还有什么事情呢？”~
@99128 = ~“马上。”~
@99129 = ~“好的，我可以休息一下。坐下来谈谈话真舒服。”~
@99130 = ~“还要什么可以效劳的呢？”~
@99131 = ~“我一直在奇怪为什么当我试图转变亡灵时，我没有试着自己逃脱……”~
@99132 = ~“还要谈什么呢？”~
@99133 = ~“有点冷，不过我曾经经历过更寒冷的时候……”~
@99134 = ~“我挺好。继续走吧。”~
@99135 = ~“我的脸色有点苍白，不是吗？”~
@99136 = ~“我挺好。该担心的是你。”~
@99137 = ~“没有风暴能搅乱我内心的平静。”~
@99138 = ~“健康而强壮。”~
@99139 = ~“对于一个地狱中的圣武士还不算太糟，不是吗？”~
@99140 = ~“我挺好了。你呢？”~
@99141 = ~“有什么东西让我目盲。我什么都看不到了。”~
@99142 = ~“我不算最好，不过也算不错了。我建议我们继续前进。”~
@99143 = ~“你看不到我变得有多衰弱吗？我很糟糕，需要有机会休息和恢复状态。”~
@99144 = ~“我只是有点衰弱了。如果不赶紧休息，我会完全消失得。”~
@99145 = ~“我中毒了，一种可怕的毒药。”~
@99146 = ~“我觉得病了，似乎疾病侵入了我灵魂的血脉中。”~
@99147 = ~[POST-MIMIC]“我已经有了一些想法，<CHARNAME>，而且我仍然被无冬城所吸引。或许是到了我该回去那个地方的时候了，不知怎的，我觉得或许自己还能成为它的保护者、它的领路人。”~
@99148 = ~“是的，未来一定会在它该出现的时候到来。现在讨论它只会减缓他到来的步伐。”~
@99149 = ~“我想了一段时间了。我只是希望我来这里可以为我的老家带来和平。”~
@99150 = ~“<CHARNAME>？这不是你承认和不承认的问题……如果你最终还是不需要我，你应该把我留在寒冰里，永远不该劝我重新开始我已经陷落的圣武士时代。”~
@99151 = ~“我们搜寻收割者的真名，不是吗？如果成功，所有的东西都会突然变成了可能……”~
@99152 = ~“我认为，这是我的苦修。我一定要为我所背叛的做出救赎。还有更多的。我想再次在夏天漫步在这条街道，听听神殿的歌唱……它对我是个美丽的结束。”~
@99153 = ~[PRE-MIMIC]“我也不知道，……不久之前，我还觉得自己没什么未来。让我再想一想。”~
@99154 = ~“死对你的想法产生了某些影响。他们变得厚重起来。你的记忆也一度被遮蔽起来……突然我开始怀疑，我不再知道我对我的罪行的感觉……”~
@99155 = ~“我害怕地狱，<CHARNAME>。当靡菲斯特来的时候，他象玩具一样戏耍我的混乱……直到你来我才意识到地狱无法对我内心的善良产生任何威胁。”~
@99156 = ~“当然，这就是你想问的？”~
@99157 = ~“如果我们坚持就不会，不。我们的要求是公正的，神会眷顾我们，毫无疑问！”~
@99158 = ~“对你做的我感到很高兴。你把我带回了正路，我不会忘记，我向你保证。”~
@99159 = ~“胡说。你看到了我的苦难，并帮助了我。尽管你的行为粗鲁，我还是可以看到你深藏的善良。就是这种善良使我重新找回了自我。”~
@99160 = ~“我听说有些武者如果在战斗中成了残疾，他们有时候仍然能感觉到失去的肢体在他们的想象中还存在着。我现在就是这种感觉，而且是身体的所有部分……”~
@99161 = ~“世界似乎在我的眼中变暗，声音变小，味道变淡。每个东西都还在那里，只不过我似乎是在隔着一层棉絮去感受它……”~
@99162 = ~“是的，对于死后的生活我只能说起这些对你有意义的东西了。”~
@99163 = ~“说实话，我不知道期盼什么。在我的训练中我研究过地狱，但是读关于卡尼亚冰封废墟的书和自己亲身处于其中完全是两码事……”~
@99164 = ~“可怕？我承认自己的生活太激烈，以致于错过了生活的活力。但是地狱，我肯定，它比任何东西都要恐怖……”~
@99165 = ~“可能吧。如果这就是所有地狱带来的惩罚，我会惊讶的。然而或许你已经把我从最糟糕的地方救出来了，<CHARNAME>。”~
@99166 = ~[POST-MIMIC]“我……说这些很难，<CHARNAME>……我背弃了我爱的人，我完全辜负了他们。我率领着一支邪恶的军队来到了城市的大门，让他们占领并大肆屠杀……”~
@99167 = ~“是的，谈论无冬城让我很痛苦。我发现还是很难用语言来表达。”~
@99168 = ~“我在无冬城的土地上死去了。至少这可以稍微安慰我……所有我带来的毁灭中的一件好事。最终时刻到来的时候，它可以说是慈祥的，和猛烈的死亡一样多。”~
@99169 = ~“我猜想卡尼亚是神放逐象我这样的人的地方。或许是我的灵魂把它找了出来。最后，雪看起来很合适，你不这样认为吗？”~
@99170 = ~“是的。我只是希望他们能在我完全堕落之前做些什么。回应对他们的信任，他们让我吃惊了。我一直想我可以幸存度过这场战争。”~
@99171 = ~“究竟为什么……我问自己很多次。我认为，在心中，我说服自己是对的，别的都是错的。哦，他们的确做了些错失，犯了一些错误但是……”~
@99172 = ~“如果无冬城居民不是完美，我认为他们的缺点就是伪善。有时伪善就是伪善，没有别的。我是如此自以为是，我看不到区别。”~
@99173 = ~“来自陆斯坎的海盗，兽人部落，佣兵，远古公会……我把他们纠结在我身边，让他们为我效劳。只要我认为自己是为着一个神圣的目的……”~
@99174 = ~“我从一个名叫摩拉格的老太婆那里接收了我的力量，她是她的远古部落的最后一个女皇……但最终我为自己效忠。别的都是在撒谎。”~
@99175 = ~“哦我出生在那里！在孩提时我就在那里的街道跑来跑去，我知道每个隐蔽处和裂缝，每个弱点，每个实力……如果我都不知道多好。无知是福啊……”~
@99176 = ~“如果我生为一个笨蛋，那么我的背叛就什么都不是了！对于我自己的善良我过分的聪明了，<CHARNAME>……用一个艺术家的眼睛，我知道去摧毁最美的一些东西……”~
@99177 = ~[PRE-MIMIC]“我……我还是在试图解决，<CHARNAME>。我不认为我准备好谈论它了。或许我们可以在以后谈论这个问题……”~
@99178 = ~“有趣，我一直在想同一个事情……”~
@99179 = ~“有人说过你有多么有进攻性？”~
@99180 = ~“这里？好，不过要快点。”~
@99181 = ~“高兴啊！当你遇到麻烦你可以回来门房这里找我。”~
@99182 = ~“为什么？我不需要变化。你才是犯所有错误的人！”~
@99183 = ~“好。至少还有些事情你没有卷进去……”~
@99184 = ~“如你所愿。我的利刃已经开始渴求献血了。”~
@99185 = ~“现在？黑暗魔法又时兴起来了吗？”~
@99186 = ~“是的，让他们去受苦吧……”~
@99187 = ~“哦，真的……或许我会，或许我不会……”~
@99188 = ~“用你的方式。”~
@99189 = ~“认为它结束了吧。不过如果我给你留下一个，把它当作礼物吧。”~
@99190 = ~“真羞耻。我刚开始欣赏自己呢。”~
@99191 = ~“我会从黑暗中反击。”~
@99192 = ~“如同阴影一般。”~
@99193 = ~“如果你需要我的意见，<CHARNAME>，你得不到什么帮助。”~
@99194 = ~“好，但是每次我做这事我都要嘲笑你。”~
@99195 = ~“哦，那么就是那样，是吗？”~
@99196 = ~“很好，我会尽力保持你愚蠢的距离，不过一旦鲜血横流，我看这个距离可不会有什么用。”~
@99197 = ~“这是我的荣幸。”~
@99198 = ~“很好，我们得安全从事，虽然他像个傻子一样冒险的死去了。”~
@99199 = ~“你还有其他你坚持从事的‘变化’吗？”~
@99200 = ~“好，但留下铠甲。”~
@99201 = ~“这是我的荣幸……”~
@99202 = ~“哈！你想让我的能量持续多长时间呢？”~
@99203 = ~“现在怎么样？”~
@99204 = ~“你确定吗？我痛恨有任何……任何失误……”~
@99205 = ~“谁会受苦？”~
@99206 = ~“你还要我做什么呢？”~
@99207 = ~“认为它结束了吧。”~
@99208 = ~“当然……”~
@99209 = ~“好，我逐渐就可以忍受你了。”~
@99210 = ~“放心吧，<CHARNAME>。别担心我。”~
@99211 = ~[还有别的东西？]~
@99212 = ~“好奇心杀死了那个猫，<CHARNAME>。不要试图尝试你的运气哦。”~
@99213 = ~“只是在考虑我可能散布的邪恶，仅此而已。”~
@99214 = ~“我每天都在逐渐强大。”~
@99215 = ~“我会好的。”~
@99216 = ~“象我可能会撕掉小狗的脑袋，为什么？”~
@99217 = ~“象我可能会在整个大陆出没。继续前进吧。”~
@99218 = ~“不关你的事，<CHARNAME>。我不需要你的关心。”~
@99219 = ~“邪恶，<CHARNAME>。绝对的邪恶。”~
@99220 = ~“我瞎了。我什么都看不到，无论它是在这个世界还是下一个世界！”~
@99221 = ~“我并没有达到最强大的状态，但是很快就要到了。我建议我们继续前进。”~
@99222 = ~“我在衰退，<CHARNAME>。我能把我的形态保持一段时间，但是休息并恢复一下会比较好。”~
@99223 = ~“我在快速的甩土。我担心不久就要完全看不到我了。”~
@99224 = ~“毒药感染了我。”~
@99225 = ~“我觉得病了，似乎疾病侵扰了我。”~
@99226 = ~[POST-MIMIC]“我已经决定我和无冬城还没有结束。你不认为那儿的神殿会利用一个邪恶的灵魂吗？或者圣地会有些麻烦，那儿的城堡怎么样？”~
@99227 = ~“如果它让你高兴，不过我必须承认对我的事情有一种奇怪的兴趣。”~
@99228 = ~“我已经想了一段时间。我敢说，听起来它像是个繁荣时期的地狱，你不同意吗……”~
@99229 = ~“我永远不会要求得到允许……很抱歉，<CHARNAME>，但是你把我放到了这个进程，而我不会被劝阻。无冬城会陷落，而我会在它的废墟上建立我的王座。”~
@99230 = ~“我们在寻找收割者的真名，不是吗？如果我们能成功，所有事情都会突然变成可能……”~
@99231 = ~“去侵扰它的墓地，掠夺它的土地，把它的子民象老鼠一样驱赶。当我完成时，没有一个生灵敢把那座城市称作自己的家！”~
@99232 = ~[PRE-MIMIC]“我不能说我完全确定。似乎不久之后我决定完全放弃我的野心。但是你是对的，我的恶意还没有消耗殆尽。”~
@99233 = ~“我要考虑你的问题一会。也许我以后会有更好的答案。”~
@99234 = ~“死亡会改变你的一些想法。他们变得厚重而坚韧。你的记忆也一度被遮蔽起来……突然我产生了疑问，对于我做的事情产生了罪恶感……”~
@99235 = ~“我害怕地狱，<CHARNAME>。我在教堂中长大，记得吗？靡菲斯特象对待玩具一样玩弄我的悲伤……直到你来我才意识到不应该害怕地狱而是去拥抱它！”~
@99236 = ~“当然。靡菲斯特忙于掠夺托瑞尔，你想玩二十个问题……如果你对它没有什么问题我也没有了。”~
@99237 = ~“你真的很高贵……我还没有决定我是否应该感谢你。也许有一天我会杀了你，paw through your entrails to help me arrive at a decision。”~
@99238 = ~“多么有趣啊。我不记得谢过你。事实上，有一天我或许会为此选择杀了你。但是谁知道呢？你或许会成为一个不错的佣兵……”~
@99239 = ~“你已经释放了我的巨大邪恶，而且你从未按照你的理由限制我。你还来得及后悔。或许你已经后悔了……多么遗憾啊。”~
@99240 = ~“我听说有些武者如果在战斗中成了残疾，他们有时候仍然能感觉到失去的肢体在他们的想象中还存在着。我现在就是这种感觉，而且是身体的所有部分……”~
@99241 = ~“我是因为我相信我自己会是。或许所有这些只是一具腐烂的尸体的梦想。我所知道的就是，<CHARNAME>，你只是一个侵蚀我眼睛的蛆虫。”~
@99242 = ~“感到意外需要改变话题吗？那时虚弱的标写。别担心，我会原谅的，不过我不会忘记……”~
@99243 = ~“那可以解释很多了，不是吗……”~
@99244 = ~“不，是卑鄙。那有区别……而且，我会认为你至少会为我的话承担一些责任。毕竟，你是玩弄魔鬼规则的一个人。”~
@99245 = ~“自有它的时刻。你有一天会去试试的……无论如何，直到蛆虫离开。它自然会打破孤独的宿命。”~
@99246 = ~[POST-MIMIC]“我让它屈服，<CHARNAME>！我在剑湾杀出，带领军队来到了它的大门前！我给它带去了一场可怕的梦魇，它或许可以从中醒来，但是它永远不会忘记！”~
@99247 = ~“他们说好奇心杀死这只猫，<CHARNAME>。但是继续。继续吧。看看在我厌倦你之前，你还能走多远……”~
@99248 = ~“我死在无冬城冷酷的土地上，以我的鲜血来诅咒它。那是我的胜利，<CHARNAME>。他们即使到最后也无法从我这里夺走它。”~
@99249 = ~“我猜想卡尼亚是神放逐象我这样的灵魂的地方。或者说是我的灵魂找到了这里。最后，白雪看起来很合适，你不这样认为吗？”~
@99250 = ~“我可能死去了，但是我象失败了吗？谢谢你，我的复仇刚刚开始……我打碎了他们的灵魂。我要让他们看到自己的可耻。我教他们如何厌恶自己，我还没有完成……”~
@99251 = ~“纳什尔领主要求公正，那么我就给他完全的公正！我或许没有爱过范斯维克，那个我想嫁的傻瓜，但是他不应该受到这种无情的死刑！”~
@99252 = ~“他爱我，我找不到理由去拒绝。他是群狼中的一只羊，我怜悯他，没有别的。”~
@99253 = ~“在人类来到北地很久之前，甚至是在精灵来之前，它就是一个伟大帝国的土地。时间抹去了那个帝国，但是统治它的人一直延续至今。”~
@99254 = ~“她的名字是摩拉格，我觉得没有比把无冬城交给它真正的主人更为公正了。部落、海盗、远古公会还有佣兵，我带领着他们加入了战斗。”~
@99255 = ~“即便那时，他们也在我面前卑躬屈膝，念叨着他们愚蠢的祷告。我是他们的圣武士，他们认为那会让我看不到他们的伪善……哦不，我全都看到了……”~
@99256 = ~“法律不公正，城主专治，信念无用，警卫堕落。我向四周望去，尽是谎言。那个城市只配得到这种下场……”~
@99257 = ~[PRE-MIMIC]“哈！别太专横了，<CHARNAME>……我几乎不认识你。我改变吧，好吧？我提到了我的命运！那时一个你还没有准备好聆听的故事……当你值得听得时候再回来吧。”~
@99258 = ~“我教，我指导，我帮助……但是我不会训诫，<CHARNAME>，记住我的话……”~
@99259 = ~“也许在某些世界有所不同，但是这儿都一样，地狱只是灵魂长久的旅途中的一个停留点；就像一串珍珠中的一个黑点。”~
@99260 = ~“死亡就是开始，而非结束。生命只是我们存在的一小部分，让我们准备面对以后更多生命的一个小小教程。天堂和地狱统一在一起，但是即便他们也不能包含所有的东西。”~
@99261 = ~“无论地狱在我的路上留下了什么，都是我应受的……但是现在负担轻了。有点太轻了。我禁不住在想是否有什么更可怕的东西在等着我呢。”~
@99262 = ~“依照我在神殿的训练，外部位面是神的形态：他统治着这个位面，为之定型。所有这些寒冰和熔岩都是靡菲斯特想让它们出现才出现的。”~
@99263 = ~“我在想他走了会发生什么呢……”~
@99264 = ~“是吗？我们还在讨论地狱的本质，不是吗？”~
@99265 = ~“准确的说是地狱的独裁本质让它变得如此可怕，你没有看到吗？如果寒冰和熔岩都有它存在的逻辑原因，那么它就丧失了对我们思想的优势。”~
@99266 = ~“我不确定。我想他背叛了卡尼亚。让我担心的是，他现在希望把托瑞尔变成他的王座。”~
@99267 = ~“他不再需要了。他统治着巴托的深狱，并统治着所有人！阿斯莫德斯统治着九个，而我们的朋友希望把托瑞尔变成第十个，从而得到奖金。”~
@99268 = ~“是，在无冬城，记得吗？圣武士并非生来就是的。它包括诸多深奥的学习。我从来没有想到自己可以接收这样第一手的关于地狱的经验……”~
@99269 = ~“是，我的心因为他们而倍受煎熬，把他们变成无尽的悲哀……”~
@99270 = ~“那就是我为什么不敢忘记，<CHARNAME>。我在那儿也是个傻瓜，他们的一些愚蠢的谎言落在了我的肩上。我必须相信傻瓜可以被原谅，否则绝望就是我唯一知道的命运了。”~
@99271 = ~“我一直会想起纳什尔领主站在那里宣布要绞死范斯维克和德斯泽尔的样子……我现在知道了，当时我在他那里看到的是恐惧……”~
@99272 = ~“不，根本不是什么快乐的人……我一直会想起纳什尔领主站在那里宣布要绞死范斯维克和德斯泽尔的样子……我现在知道了，当时我在他那里看到的是恐惧……”~
@99273 = ~“你看不到吗？街道上的暴徒，因为瘟疫袭击带来的贫穷，比舒服的坐在座位里的城主握有更大的权力！即便那样他统治着他们，他怕他们。瘟疫只是一件工具。”~
@99274 = ~“所有德斯泽尔需要的就是一个愤怒的暴徒，一个虚弱的城主，一个丧失欣赏的圣武士。我们都被握在他的手掌中，那就是为什么当我们把他绑在火刑柱上烧死的时候他还在微笑。邪恶是阴险的……”~
@99275 = ~“作为泰尔的圣武士，纳什尔领主坚持由我来宣布他们有罪，但是我拒绝了。他老了，而且疾病缠身，不想再神殿大门外面对人群了。”~
@99276 = ~“但我迫使他做了，那时候我发现自己滑向了黑暗的深渊。当德斯泽尔倒下，他的脖子折断，他的脚在摇晃……黑暗毁灭了我。”~
@99277 = ~“德斯泽尔说自己是一个泰尔信徒，来自远方希望为教堂服务，但是相反的是，他给每个信徒带来了疾病。范斯维克拒绝承认它，而我怎么能怀疑一个我爱的人呢……”~
@99278 = ~“在各自的方式而言，他们都是虚弱的人。我应该大声地说出来。有些事情我该说出来……而我把他们留给了纳什尔领主和那些暴徒。”~
@99279 = ~--------- Random Conversations begin here ----------~
@99280 = ~“力量就是塞壬海妖的诱人歌声，<CHARNAME>，而责任就是沉重的负担。我祈祷不会看到你为它而被摧垮……你知道的真名就是你手中掌握的某些人的命运。当心你寻找的东西吧。”~
@99281 = ~“力量就是塞壬海妖的诱人歌声，<CHARNAME>。当面临抉择，你怎么知道自己不会选择另一个呢？……你知道的真名就是你手中掌握的某些人的命运。当心你寻找的东西吧。”~
@99282 = ~“力量就是塞壬海妖的诱人歌声，<CHARNAME>。它会同等的破坏善良和邪恶。你知道的真名就是你手中掌握的某些人的命运。当心你寻找的东西吧。”~
@99283 = ~“不。力量就是塞壬海妖的诱人歌声，<CHARNAME>。一旦她自由了，你或许不会听到我的警告。现在听我说……你知道的真名就是你手中掌握的某些人的命运。当心你寻找的东西吧。”~
@99284 = ~“那也许是这样，但是它不会阻止我担心相反的情况。但是我已经说了我的部分。去解救贫苦的女人，做你愿意做的事情吧。”~
@99285 = ~“是的，一点点。如果轻易的放弃我的命运，我就是个笨蛋了……但那是为了所有其他人，我才警告你。请，<CHARNAME>，注意我的话，不要在追求力量中毁灭你自己。”~
@99286 = ~“谢谢。你知道我不会轻易警告你的。”~
@99287 = ~“是在无冬城的树林中，城市的东北角。就在那里，范斯维克第一次吻了我，我们把自己姓名的首字母刻在那棵树上……那时，我真傻。不，或许应该说是无知……”~
@99288 = ~“是的，曾经是……但在他们绞死他之后，我跑到那棵树下失声痛哭，我的未来从此被撕个粉碎。我不再是圣武士，<CHARNAME>。我也不会再见到正义……”~
@99289 = ~“不，那时候我已经知道了。我并不爱他，但被爱的感觉却很好……在他们绞死他之后，我逃到了那棵树边，在那里放声痛哭，似乎我的心已经碎了。我不再是圣武士，也不会再见到正义……”~
@99290 = ~“我死的时候很年轻，他也一样。在他们绞死他之后，我跑到了那棵树底下，在树根那里辗转反侧……我不再是圣武士，也不会再见到正义……”~
@99291 = ~“我无法让自己相信，我曾追求的正义却是加诸他身上的不义……要是我不是那么盲目，或许世界上就不会有那么多的恐怖……”~
@99292 = ~“去吧。去同诸界智者谈谈，从她那里获取你所需要的吧。然后，让我们赶快离开这个地方，它承载了太多让我伤心的回忆。”~
@99293 = ~“它本来不在这里的。我不认为它是这里的一部分。我甚至不认为我们是在卡尼亚，<CHARNAME>……”~
@99294 = ~“但是她怎么会知道那棵树呢？”~
@99295 = ~“但是那棵树……”~
@99296 = ~“不，上面有我姓名的首字母……还有一颗心……我跟你说过的，我认得那棵树！”~
@99297 = ~“它刚飞过去，就在我们进来的时候！”~
@99298 = ~[男性]“我在想一些更加让人愉快点的事……”~
@99299 = ~“是的，那是个拟态怪，不是吗？但是你看到它是怎样钩抓着离开的？我想我以前从没听说过像这样的东西……走吧，我们去把你的衣服要回来。你的牙齿开始咯咯作响了。”~
@99300 = ~[男性]“你在跟我调情吗？”~
@99301 = ~[男性]“确切地说，要冷却哪里？”~
@99302 = ~“唷！对不起，<CHARNAME>。只是……再次开怀发笑的感觉真好。恐怕有些时候了……现在让我们为你取回那些衣服；我能听到你的牙齿在咯咯打颤。”~
@99303 = ~[男性]“不要觉得被侮辱了。如果我笑了，那是因为你大大超出了我的期望，<CHARNAME>。”~
@99304 = ~“我也许是……这也许来得有些让人惊奇，但是我们圣武士随缘相爱并结婚的作风是广为人知的……”~
@99305 = ~“我是个圣武士，不是个装正经的人。这也许来得有些让人惊奇，但是我们圣武士随缘相爱并结婚的作风是广为人知的……”~
@99306 = ~“不？那么让我们以后再来回忆它，<CHARNAME>……但是现在我们需要把你的衣服要回来。我能听到你的牙齿在咯咯打颤。”~
@99307 = ~“是的，爱情……这个词那么让人害怕吗？”~
@99308 = ~“对不起，我并不想让你感到不安……让我们去把你的衣服找回来。我能听到你的牙齿在咯咯打颤。”~
@99309 = ~“爱情除了肉体还有更多的东西，<CHARNAME>……算了，就当我没说吧……”~
@99310 = ~“我也是……还是让我们把你的衣服找回来吧，<CHARNAME>。我能听到你的牙齿在咯咯打颤。”~
@99311 = ~“啊，别像个孩子！我不是在说你……我在说范斯维克……算了，就当我没说吧……”~
@99312 = ~“对死者来说，也许一切事物品味起来都包含生命。我不知道，<CHARNAME>，也许现在尘土和时间是我的生命。我想，在身体消逝后，精神也会变老……”~
@99313 = ~“我真搞不懂你！在头一分钟里，你洋溢着支持和鼓励，而在下一分钟里却变成了恶意和刻薄……我已经做好决定了，并且和你不同，我打算坚持下去。”~
@99314 = ~“那么就去找沉睡者，做你必须要做的事情吧。事情越早了结，你就能越早回家。”~
@99315 = ~“我并不想显得感情脆弱。只是事情发展得太快了。需要一点时间去适应再次成为一个圣武士的感觉。我原以为有些情感已经永远消失了……”~
@99316 = ~“但是我们到这里是来找沉睡者的。来吧，让我们做原本打算在这里要做的事……”~
@99317 = ~“也有悲伤。幸福是因为他的爱人正在向他走来，悲伤是因为她还不在这里。我想，希望正是这样起作用的……两者混合在一起。”~
@99318 = ~“非常合理。你越早知道守门者的真名，就能越早回到家里。”~
@99319 = ~“感到幸福真好。我不清楚是否还会有这种感觉。一想到有段时间我把它当成是理所当然的，<CHARNAME>……不管怎样，让我们做我们来这里要做的事吧，怎样？”~
@99320 = ~“一些鬼魂缠绕别人，一些鬼魂被别人缠绕。我想我是属于后者。然而由于你，是的，<CHARNAME>，我想我有希望了……让我们做我们来这里要做的事吧。”~
@99321 = ~“你怎么会感觉不到它呢？难道你没有一丝的快乐？一丝的希望？”~
@99322 = ~“我们都是，<CHARNAME>。即使是我也一样，并且我比大多数人有更多的理由不再回去。也许那就是我们必须要做的原因……来吧，让我们做我们来这里要做的事，看看结果会怎样。”~
@99323 = ~“你是个让人难以忍受的常闹情绪的老家伙，<CHARNAME>，但是我想我确实欠你那么多。而且刚才我也没怀多少希望，不是吗……让我们做我们来这里要做的事。”~
@99324 = ~“不，<CHARNAME>，你难道看不出来吗？希望支撑着我们！沉睡者已经在这里呆了多久了，一个天使呆在地狱深处，然而却不受骚扰，甚至是受到尊敬。”~
@99325 = ~“他在这里就和你一样。而且我也一样。快乐就是即便在很坏的境地也能找到好的方面。希望就是相信艰苦的情形会变得好起来。”~
@99326 = ~“如果你真要坚持的话，<CHARNAME>……做你要做的事吧。”~
@99327 = ~“嗯……实际上很多。但是我想我们能从一点点开始……现在让我们做我们来这里要做的事吧。”~
@99328 = ~“我不是在说教……只是因为很难看到你如此不快乐，我只想要帮你……啊，没关系，让我们做我们来这里要做的事吧。”~
@99329 = ~“我不是在寻求复仇，<CHARNAME>……我所要求的只是一丝希望。希望看过大恶的世界也能看到大善……希望有一颗能这样说的心……”~
@99330 = ~“我想我们不能拖延了……巨大的邪恶在我们的家园——托瑞尔——肆虐。我们必须让天堂的光辉在其上闪耀，把邪恶的力量消减。来吧，让我们在世界上实现我们的和平。”~
@99331 = ~“不……<CHARNAME>，请不要这样做……”~
@99332 = ~“但是我过去所做的是错的！数不清的无辜者因为我的行为而死去，数不清的朋友也这样死去。如果感觉不到愧疚，感觉不到自责，那就是对这个世界的冷漠。这是没有人性的做法。这就是你要求我做的吗？”~
@99333 = ~“谢谢你，<CHARNAME>。对自己的过去负责的能力是我唯一保留下来的尊严……你想要求一些别的来替代它吗？”~
@99334 = ~“我想诸神有他们的神秘之处。但是通过他们的语言发出的命令必须得到他们的同意，不管是为善还是为恶。通过你的命令，我得到了补偿……还有别的吗？”~
@99335 = ~“你得到了我的供词，那么我将不再受苦。就按你的命令吧。你还想问我什么？”~
@99336 = ~“那么你的后代将会受到诅咒。让他们个个都逐渐陷入绝望之中……事情将会如你所命令的那样。你还有别的苦难加到我身上吗？”~
@99337 = ~“我的灵魂？但那是我拥有的全部！我不知道它将带给你什么力量，但是如果没有它，我将变成失魂者……你确信这是你想要的吗？”~
@99338 = ~“对于那一点，我感谢你。<CHARNAME>，请停止这种疯狂的行为吧！看在我的份上，我求求你了，除此以外再也不要有别的要求了……”~
@99339 = ~“遵命，<CHARNAME>……”~
@99340 = ~“但是我再次成为了一名圣武士，如果没有你我做不到这一点！……可是这是你的命令，而我必须服从……该死的，<CHARNAME>，不要对我再有别的什么要求了！”~
@99341 = ~“但是怎么会是爱呢？……唉，既然你已经给了我命令，那么我将以我所能够的方式爱你直到生命的尽头……你对我还有别的什么命令吗？”~
@99342 = ~[浪漫度1]“只是……我有过的全部愿望就是被爱。这已经太晚了吗？我是说，如果我走过那个传送门但是那边却没有什么东西为我的话，那该怎么办？我只是不能忍受重新生活，让自己迷失在过去之中……”~
@99343 = ~“但是你爱我吗，<CHARNAME>？”~
@99344 = ~“超过世界上任何的东西。我唯一的遗憾就是我必须死去才能找到你。如果你不能反过来爱我，我能够理解。毕竟我是在地狱遇见你的……但是请告诉我，你爱我吗？你能爱我吗？”~
@99345 = ~“不？……我想我应该早就知道。有些事情太珍贵了，在今生或者来世是没有希望得到的。”~
@99346 = ~“是的，嗯……我更好的判断也是不爱你……”~
@99347 = ~“我会跟随我的本心。”~
@99348 = ~“就像你是我的一样。”~
@99349 = ~你能感到艾瑞贝丝恶意的眼神透入你的身体。你判断出她有事要说，但是她似乎想要你来问她。~
@99350 = ~“疯狂是受启发者的智慧。”~
@99351 = ~“也许它在别的世界和在我们的世界不同，但是在这里，地狱只是灵魂漫长朝圣之路的另一站；一串珍珠链上的一颗黑色的珠子。”~
@99352 = ~“死亡不是结束而是开始。生命只是我们存在的一部分，一堂简单的指导课，以便让我们为此后很多次的生命做好准备。天堂和地狱是相连一体的，但是它们也包含不了这个统一体的全部。”~
@99353 = ~“老实说，似乎还很不够。惩罚的本质就是那些最该受到惩罚的人几乎就是那些执行惩罚，并享受其带来的最不正当的快乐的人。”~
@99354 = ~“对心灵中真实的黑色部分来说，地狱拥有着一个圣武士可能在天堂找到的所有快乐。也许还更多一些，如果我自己敢这么说的话……”~
@99355 = ~“考虑到这个选择，我会让它变得更温暖一点……并且更黑，我想。”~
@99356 = ~“真地说来，关于地狱还有什么更多可说的呢……”~
@99357 = ~“我在黑色中寻找善，就是如此……让地狱变得这么可怕的原因是它任性横行的本质，你明白吗？如果它之所以是黑色有其自身的原因，那么这种黑色就会对生活在其中的生物的头脑失去力量。”~
@99358 = ~“我开始觉得这甚至没有必要。靡菲斯特已经抛弃了卡尼亚。他现在希望把托瑞尔作为他的王座。凭着一点野心，什么事情在地狱里都是可能的。”~
@99359 = ~“他不再需要它了。巴托异界最深地域的统治者也是整个巴托异界的控制者！阿斯莫德斯统治着第九地狱，但是我们的朋友正想把托瑞尔变成第十地狱从而攫取这一权力。”~
@99360 = ~“根据我在神殿的训练，外层位面具有由神控制而形变的特性：如果他（或者她）统治着这个位面，那么也可以改变其形状。为什么会有这些冰块和熔岩相依相临的景观？因为是靡菲斯特让它这样的。”~
@99361 = ~“是的，我在心里艰难地移动着它们，把它们变成我的仇恨的形状……”~
@99362 = ~“那就是我为什么要拒绝忘记的原因，<CHARNAME>。愚者不能受难。他们必须被清除，他们愚昧的鲜血必须流成一幅画，这样我们就可以把我们的诅咒写在他们的墙上……在无冬城里就必须这样。”~
@99363 = ~“我总是想起纳什尔领主站在人群前宣布将要绞死范斯维克和德斯泽尔的情形。现在我明白了我在他身上看到的是什么……害怕。冷漠，僵硬的害怕。”~
@99364 = ~“也许……但是我总是想起纳什尔领主站在人群前宣布将要绞死范斯维克和德斯泽尔的情形。现在我明白了我在他身上看到的是什么……害怕。冷漠，僵硬的害怕。”~
@99365 = ~“你没看到吗？那些被瘟疫蹂躏，肮脏凄惨的街头民众比舒舒服服坐在宝座上的领主有更大的权利！他统治着他们，但是即便如此，他仍然害怕他们。”~
@99366 = ~“最后，我只能极度痛恨纳什尔领主。但他只是单单一个人，一个承载我愤怒的单个容器，而我的愤怒溢出了。我把真正的复仇对准了民众……”~
@99367 = ~“纳什尔领主坚持说作为泰尔的圣武士，我应该出面宣布他们的罪行，但是我拒绝了。这个老头不想面对等候在神殿门外的人群。”~
@99368 = ~“但是我使得他这样做了，在那一刻我能感觉出他是个渺小的小人物，并且他恨我。当德斯泽尔倒下了，他的脖子被折断，他的腿在空中摇荡……我知道我已经转变了。”~
@99369 = ~“他们都是笨蛋。我告诉我自己我爱前者并默默地忍受后者。我应该在有机会的时候把他们俩都杀掉，可是实际上我却把他们留给了纳什尔领主和民众去处置。”~
@99370 = ~“德斯泽尔装成是一个泰尔的追随者，千里迢迢前来为教会服务，但实际上却利用每一次的祈福来传播疾病。范斯维克视而不见，而我又怎能怀疑这个我告诉自己我爱他的人……”~
@99371 = ~--------- 随机交谈在这里开始 ----------~
@99372 = ~“敌人的敌人是我的朋友。来吧，让我们暂时别去管脸色苍白的智者，二是看看能否解救替代他的将军们……”~
@99373 = ~“那是真的。我面对着一个教化而又残忍的对手。相对地，我们也必须要狡猾而又残忍……但是你是对的。由于被他们的愤怒所蒙蔽，这些将军只不过是一群废物。”~
@99374 = ~“拥有力量的是名字，而我们必须要找到的就是众名智者。让我们把她知道的名字都探查出来。有了那个宝库，我们就能所向无敌了！”~
@99375 = ~“只有一条途径能够找出来，不是吗……难道你没有被他们的力量所引诱？”~
@99376 = ~“你在暗示着什么，<CHARNAME>？如果你没忘记的话，我也曾是个叛徒……”~
@99377 = ~“我已经这样了……但是就像我在说的，我们还要考虑对付一些将军……”~
@99378 = ~“你应该这样的，你个笨蛋！如果我觉得背叛你符合我的利益，那么我会立刻这样做！我每一刻的忠诚，都在加深你对我的负债感。有一天我会要求偿还的……现在，关于这些将军……”~
@99379 = ~“好。因为我从没说过你是错的……现在，关于这些将军……”~
@99380 = ~“就在无冬森林里，城市的东北边。范斯维克第一次吻了我，我们把我们的首字母刻在了树上……我是如此愚蠢的一个女孩。我应该把那片森林烧掉的！”~
@99381 = ~“在他们把他绞死后，我跑进了那片森林，找到了我们的树，蜷缩在它的根上。我那时就该把它烧掉的，但是相反我却像个软弱的女孩一样哭着并发誓要复仇。”~
@99382 = ~“不，我那时就知道。我不爱他但是被爱的感觉是如此美妙……在他们把他绞死后，我跑到了森林里我们的树边，伤心地哭着并发誓要复仇。”~
@99383 = ~“我也很早就死了。而他和我一样。在他们把他绞死后，我跑进了森林，找到了我们的树，蜷缩在它的根上。我想孩子般地哭着并发誓要复仇。”~
@99384 = ~“我仍然要复仇，<CHARNAME>……去吧。和诸界智者交谈，榨取我们所需的信息，然后跟这个地方了结了。它有着太多关于过去弱点的记忆。”~
@99385 = ~“不是来自这里。我觉得不是这里的任何地方。我甚至觉得我们再也不在卡尼亚了，<CHARNAME>……你能想像拥有这种力量吗？”~
@99386 = ~“但是她怎么能够知道那棵树呢？”~
@99387 = ~“那是那棵树……”~
@99388 = ~“不，那上面有我名字的首字母……还有一颗心……我跟你说过，我认识那棵树！”~
@99389 = ~“飞走的那个，就在我们进来的时候！”~
@99390 = ~“继续当傻瓜吧，如果你愿意。这与我无关……”~
@99391 = ~“不，更恰当说，你在忍受我的存在带来的耻辱……”~
@99392 = ~“你这样认为，是吗，亲爱的？那样很好，但是我更喜欢折磨男人……现在去把你的衣服取回来吧。你的胖身子让我恶心。”~
@99393 = ~“它对你的价值是多少，亲爱的？70,000个金币？”~
@99394 = ~“别声张，亲爱的。”~
@99395 = ~“很久以前我就把它扔掉了，公主……现在去穿上别的衣服吧。我的胖身子让我恶心。”~
@99396 = ~“别吓我，亲爱的……”~
@99397 = ~[男性]“要是我知道这么容易就能把你的衣服脱光……”~
@99398 = ~“一个棘手的问题，是吧？我必须要记住这点……去把你的衣服取回来吧。你的胖身子让我恶心。”~
@99399 = ~“没那么快，<CHARNAME>。我制定规则，你来遵行。如果你是个好男孩，我可能还会告诉你我喜欢你。现在只能说我已经有了感官的兴趣……”[浪漫度设为1]~
@99400 = ~“我也许死的，<CHARNAME>，但是肉体的快乐仍然充满诱惑，并且还有一些我在活着的时候没有机会去做的事情……我不会像你保证我的爱和忠诚，但是你掌握着我的欲望。”[浪漫度设为1]~
@99401 = ~“但是首先让我们煎炸了那个小动物，让它受一番痛苦……这似乎是个合适的庆祝。”~
@99402 = ~她以僵硬的沉默作为回答，眼神仿佛凿出了一些小孔，直透入你的心房。~
@99403 = ~“我感觉他在审判我，不是吗？他是一个天界生物，一个天使。甚至他可能在侍奉泰尔……我已经做了决定，而我不能接受被审判！不能被他，也不能被任何人审判。”~
@99404 = ~“好的，让我们了结了它吧。你最好知道自己在做什么……？”~
@99405 = ~“它在沉睡中，就如同死去多时的我一样……也许这其中有些真相，但是还不能说明整个问题。”~
@99406 = ~“我不知道。但是他想从我们这里得到一些东西，就像我们也想从他那里得到一些东西一样。我能感觉到。我能从他睡觉的姿态中看出来……我只是不喜欢欠天使一份好意……”~
@99407 = ~“复仇……那么让我们复仇吧，<CHARNAME>……托瑞尔名正言顺地属于我们。我们没有慈悲心肠。我们不留下任何活口。我们回家了，回家来征服一切……无可回头。”~
@99408 = ~[浪漫度1]“是的，复仇……但是请告诉我实情，<CHARNAME>。你真的爱我吗？”~
@99409 = ~“我不需要你的怜悯！……托瑞尔名正言顺地属于我们！我们没有慈悲心肠。我们不留下任何活口。我们回家了，回家来征服一切！我们把它夷为平地，<CHARNAME>，然后重新建造一个……这是唯一的途径。”~
@99410 = ~“那么让我们把这些魔鬼从我们的背后撕掉并杀死，<CHARNAME>……托瑞尔名正言顺地属于我们。我们没有慈悲心肠。我们不留下任何活口。我们回家了，回家来征服一切……”~
@99411 = ~“不……你在干什么？大胆！”~
@99412 = ~“好的，我很高兴你清醒过来了。让我们快点，靡菲斯特在等着呢。”~
@99413 = ~“别犯傻了，<CHARNAME>。你用不着通过我的真名来命令我那样！相反，我对此很高兴。我将以一个大奸大恶之人载入史书……还有别的事吗？”~
@99414 = ~“我的灵魂？但那是我拥有的全部！我不知道它将带给你什么力量，但是如果没有它，我将变成失魂者……你确信这是你想要的吗？”~
@99415 = ~“对于那一点，我表示感谢。你还要强迫我做什么？”~
@99416 = ~“遵命，<CHARNAME>……”~
@99417 = ~“但我是个暗黑暗卫士，一条在你的建议下选择的道路……可你让我没有别的选择。我遵命就是……请不要再对我提别的要求了。”~
@99418 = ~“主……主人？……既然你已经给了我命令，那么我将以我所能够的方式爱你直到生命的尽头……你对我还有别的什么要求吗？”~
@99419 = ~[浪漫度1]“但是你爱我吗，<CHARNAME>？你真的爱我吗？”~
@99420 = ~“那会使我将要做的事变得容易些……”~
@99421 = ~“背叛你……”~
@99422 = ~“它只是我们玩的一个游戏……我明白……”~
@99423 = ~“好的……我不希望存在任何误解……”~
@99424 = ~“是的，嗯……爱上你也同意不是我更好的判断……”~
@99425 = ~“和我自身的黑暗……”~
@99426 = ~“因为你是我的……”~
@99427 = ~艾瑞贝丝在门房的晦暗中悲伤地笑了。你想知道这样是否会让死者痛苦得再次死去。~
@99428 = ~艾瑞贝丝的目光穿过门房的晦暗斜视着你。它似乎从另一次死亡的恐怖中得到了快乐。~
@99429 = ~------- 这一行必须放在队员之间说笑的结束处 ---------~
@99430 = ~“你非得要寻找光明吗？我是个杀手，艾瑞贝丝，一名红色姐妹。这是我注定要做的。”~
@99431 = ~“只是当我转过身是你却不在……”~
@99432 = ~“噢，我在那里，我的女士。我向你保证。”~
@99433 = ~“但是如果我看不到你，我怎么知道你并不是……”~
@99434 = ~“不是什么？不是打算割破你的喉咙？割破<CHARNAME>的喉咙？你看明白了，我了解<HIMHER>的时间比你长。<CHARNAME>选择了我。你才是那个不能被信任的人！”~
@99435 = ~“你什么意思？<HESHE>救了我，让我免于沦为失魂者！我再次有了活下去的目标！为什么你不能信任我呢？”~
@99436 = ~“我应该问你同样的问题，但是如果你想要我的答案，以下就是：你让它看起来太简单了点！一些空洞的言语，然后突然间你就重生了！”~
@99437 = ~“我的一生都在刀尖口上生活，试图分辨出是非好坏，而现在我仍然处在刀尖口上！没有解脱之道，没有“从此以后幸福地生活着”！因此为什么你就应该拥有？”~
@99438 = ~“这就使我以后幸福的生活？被诅咒在一个冰冷的地狱里游荡，忏悔自己的罪行，又被一个傲慢的相信自己是唯一一个受苦受难者的黑暗精灵所纠缠？”~
@99439 = ~“当黎明到来的时候，它一定会来得很突然，但是这并不会让之前的黑夜变得短暂！我已经经历过自己的黑夜。我活着经历过，死着经历过……也许你也必须这样。”~
@99440 = ~“请你让我单独呆着吧，好吗？”~
@99441 = ~“我保留自己的看法、精神，并建议你也这样。”~
@99442 = ~“但是我有很好奇，我的姐妹……你效劳的这个瓦纱瑞丝是谁？”~
@99443 = ~“她是我发誓要保护的家族的首领。”~
@99444 = ~“并且也很强大，我听说……”~
@99445 = ~“她很让人害怕，是的……但是最终她是虚弱的。她的力量不属于她自己。她依赖一名男性的力量，依赖靡菲斯特，这是她失败的原因。”~
@99446 = ~[玩家是女性]“是的，这里我们都是女性，这是件好事。男人只会带来失望和心灵的背叛。”~
@99447 = ~“你说起来仿佛是经验之谈……”~
@99448 = ~“在一生中，我效力过很多男人，他们全都背叛了我。纳什尔领主，泰尔，范斯维克……只有在为女人效力的时候我才变得强大。摩拉格，<CHARNAME>，我自己……”~
@99449 = ~“你自己？”~
@99450 = ~“你还很年轻，小妹妹。总有一天你会明白没有人值得效力。”~
@99451 = ~“是的，艾瑞贝丝……我明白。”~
@99452 = ~[玩家是男性]“就像你依赖<CHARNAME>一样？”~
@99453 = ~“我只依赖自己锋利的剑刃和自己作为红色姐妹得到的训练！不要把<CHARNAME>扯进来！”~
@99454 = ~“但是怎样做到呢，小妹妹？因为他我们才在这里，我们追随着他的使命。最终，谁将会得救？你那尊贵的先知？我的无冬城？别犯傻了！”~
@99455 = ~“我并没有明确地要求来到地狱！这是强加到我身上的，就像你一样！<CHARNAME>困在这里这件事也跟这没有关系！”~
@99456 = ~“你已经如此习惯于不被别人看见以至于连自己都看不见了吗？<CHARNAME>与这件事关系大了！这是他的故事，你难道看不出？”~
@99457 = ~“那么当我抓住机会的时候，我会把它变成自己的故事！”~
@99458 = ~“我也会，小妹妹。我也会……”~
@99459 = ~“我一直听到有声音，我的女士。似乎这个位面的精华在纠缠着我。然后愤怒不停地在我心中滋长。啊！我不知道我还能容纳多久。”~
@99460 = ~“那么，倾听我的声音。专注于我的声音，把其他所有的都排除在外。外层位面自愿地生存和呼吸着。魔鬼实际上是由卡尼亚精华衍生出来的，就像是一棵大树上的果实一样。”~
@99461 = ~“我不能这样做，我的女士！我永远也不能把它当成家。我是巴托异界的恶魔，它永远也不会让我离开的！”~
@99462 = ~“你必须这样。我会帮助你。我曾是失魂者中的一员，还记得吗？我曾是这个位面中的一员，但只是短暂的一时，就像是树中的汁液一样。它不能伤害你，它也不能拥有你。它只能在你把自己放弃给它的时候攫取你。”~
@99463 = ~“倾听我的声音……卡尼亚，是我，艾瑞贝丝女士，一个失落在你这里但是又被找到的人。这个人，瓦伦，不是你的敌人。他会像风一样穿过你，然后消失掉……”~
@99464 = ~“放过他。他流的是塔那厘族的血，那是你在深渊魔域中的敌人，但是他的心是属于托瑞尔的，一个不属于你们的世界。倾听我的声音，一个曾经失落过的人的声音，然后放过他……”~
@99465 = ~“它……它在消退。这些声音……谢谢你，我的女士。不敢去想如果你不在这里，我会变成什么样子。”~
@99466 = ~“别急着感谢我，瓦伦。祈祷它在我们回家之前不再回来吧。如果它真的回来了，那么我们两个它都想拥有，并且它会变得非常非常疯狂……来吧，让我们继续赶路。”~
@99467 = ~“为什么你还要纠缠我，鬼魂？我已经变得越来越强大了。如果我体内的恶魔成长了，那是因为它只是我的一半。”~
@99468 = ~“或者说你只是他的一半？只拥有你父亲一半的伟大，你父亲一半的力量……看看你的成长，瓦伦。要用多久你的真性才能咬破那件薄薄的正义外套？”~
@99469 = ~“你只是一个幽灵！你对我的命运一无所知，不知道什么将会发生，什么不会发生！”~
@99470 = ~“你真的相信那样吗，瓦伦？我是死者中的一员，很久以前就已经度过了自己的命运。在某种意义上，我是你的归宿。我是你的未来。记住我的话：你体内的恶魔会一直成长，很快就将吞噬你。”~
@99471 = ~“谎言！我宁愿杀死自己也不愿被吞噬！”~
@99472 = ~“那么看来你要做一个决定，不是吗，瓦伦……”~
@99473 = ~“如果我去了，我会带上你的，魔鬼！”~
@99474 = ~“真的？多么浪漫……很好，你知道我睡在哪里的。”~
@99475 = ~“有一点，艾瑞贝丝女士。我变得更容易发怒，并且总是感到似乎有什么东西在看着我……你呢？”~
@99476 = ~“要谢谢<CHARNAME>，我必须承认地狱并没有带来我原来所想的折磨。我知道自己活该承受更大的折磨。在很多方面，我的灵魂现在受到的烦扰比生前要少。”~
@99477 = ~“也许卡尼亚对我的影响并不像它对其他一些泰夫林一样厉害。我的父亲是一个恶魔，而不是一个魔鬼。它只会在战争时期才会来到巴托异界。”~
@99478 = ~“血战。”~
@99479 = ~“是的，邪恶势力间的战争。我承认我那种想要用靡菲斯特的黑色之血来涂抹刀刃的渴望并不仅仅来源于复仇活着正义事业。我体内的魔性也希望这样。”~
@99480 = ~“只要你体内的人性也渴望这样，那就是行了。你可能不会这样想，但是你母亲的遗传在你的身上很强烈，并最终会比你父亲的遗传远为重要。”~
@99481 = ~“谢谢你，艾瑞贝丝。这些话在这个寒冷的地方听起来很让人振奋。”~
@99482 = ~“你的意思是什么，死者……”~
@99483 = ~“你现在是在地狱，泰夫林。你的恶魔之血在这里是不是正在沸腾，不断的冒泡到达表面？如果曾有一个时机来发掘你父亲的遗传的话……”~
@99484 = ~“我自己决定自己的道路，巫婆。既不是父亲的道路也不是母亲的道路，而是中间的一条。另外，我的父亲是一个恶魔，不是一个魔鬼。如果他的血液要在这里沸腾，那是因为愤怒和战斗的气息。”~
@99485 = ~“邪恶就是邪恶，笨蛋！是血战阻碍了我们前进！正义的力量很弱但是至少它们是团结在一起的。而同时我们这些邪恶的后代却在相互捕杀，浪费了我们的力量和智慧！”~
@99486 = ~“看着，女人，我不是将军而据我所知，你自己也不是那么伟大的一个人！我听说过无冬城的故事……如果你这么狡猾，又怎么会死掉呢？”~
@99487 = ~“够了！”~
@99488 = ~“你被俘虏然后被处决！你现在只是一个故事！一个脚注！没人在意！”~
@99489 = ~“够了！”~
@99490 = ~“没人在意……所以你要么和我一起做事，要么你就别做。我没有选择这场战斗，知道吗？”我只是来这里完成一项任务，然后就回家去……”~
@99491 = ~“德金是比较冷，但是并不太冷。他穿着袜子！”~
@99492 = ~“你穿着袜子？这真是件喜事！”~
@99493 = ~“羊毛袜子。德金的奶奶很久以前给他做的。还有连指手套。‘别忘了在石头上晒晒！”她常常这样说。或者是‘你会得要命的感冒的，你会的！’，然后她就喂给德金昆虫吃。非常美味的食物。”~
@99494 = ~“回想无冬城和我在那里的神殿的日子是让人奇怪的。所有的事情看起来都黑白分明。我永远也不会知道狗头人会这么有趣……”~
@99495 = ~“当然，带着连指手套弹琵琶是非常困难的……五指手套应该实用得多，德金认为……你知道怎样编织吗？艾瑞贝丝小姐？”~
@99496 = ~“哈！不，德金，对于编织我一窍不通！我想那恐怕是在当时并不重要的事情之一……当我们回家以后，也许你的奶奶能教我。”~
@99497 = ~“对你来说，任何事都可以，艾瑞贝丝小姐！但是她会说到你耳朵起茧的。诸如雪落到了她的头上，原两条路线上山的道路这样的事。它对德金来说从来没有什么意义。”~
@99498 = ~“德金穿着袜子！”~
@99499 = ~“请再说一遍？”~
@99500 = ~“羊毛袜子。德金的奶奶很久以前给他做的。还有连指手套。‘别忘了在石头上晒晒！”她常常这样说。或者是‘你会得要命的感冒的，你会的！’，然后她就喂给德金昆虫吃。非常美味的食物。”~
@99501 = ~“就当我没问……”~
@99502 = ~“当然，带着连指手套弹琵琶是非常困难的……五指手套应该实用得多，德金认为……你知道怎样编织吗？艾瑞贝丝小姐？……艾瑞贝丝小姐？”~
@99503 = ~“德金为自己写了一首新歌如果他……当他回到狗头人家乡的时候。”~
@99504 = ~“别当心，我们会把你送回家的，小东西。我像你保证……同时，你也许可以为我唱唱那首歌……”~
@99505 = ~“德金还没有完成，但是它是这样子的：‘强大英明的狗头人，绿色德金由于意外被送到了地狱。他什么也没做错！诚实地说，这是真的！他由于意外被送到了地狱……”~
@99506 = ~“好了，我相信他们会理解的。而且听起来这是首不错的歌……”~
@99507 = ~“当然，它用狗头人的语言唱起来更加押韵……”~
@99508 = ~“我确信是这样的，小东西。我确信是这样的。”~
@99509 = ~“德金不能被踩在脚下！你的脚老是在德金上面！坏脚！坏透了！”~
@99510 = ~“坏？你的小脑袋根本不能理解坏意味着什么，蜥蜴。你想要我向你展示一下什么是真正的坏吗？”~
@99511 = ~“唔……并不真地想，邪恶的女士。”~
@99512 = ~“并不真地想？你像是一个傲慢的小孩……要叫就叫我的名字！”~
@99513 = ~“不……不是真地想，艾瑞贝丝小……小姐……”~
@99514 = ~“很好。那么遵守我的第一条命令，离脚下远点……并且不要打搅我……”~
@99515 = ~“他在吞噬我们，吃掉我们的灵魂来建造他的军队……我不会为军队效劳！再也不会！我效力过泰尔，效力过纳什尔领主，效力过摩拉格和她的上古之民！我的一生都抹着他们的颜色，挥舞着他们的旗帜……”~
@99516 = ~“我现在不会为靡菲斯特效力了，我已经赌博并输了如此之多！……是的，我向他发起了挑战。其他的幽灵以为我这样做是为了他们，但他们是笨蛋。我现在只为自己效力。”~
@99517 = ~“靡菲斯特觉得我的挑战非常有趣，于是听完了我所说的一切。他非常耐心地听着直到我再也无话可说。然后再沉默中，他说出了我藏在心中很久的一个秘密……”~
@99518 = ~“范斯维克，泰尔的牧师，被当作叛徒而绞死，一个我打算嫁给她的男人，一个我一直说我爱他的男人……我从没有爱过他……我从没有爱过他，而靡菲斯特不知怎么知道这个真相。”~
@99519 = ~“你难道不明白吗？当他们绞死他的时候，我抛弃了我的教会，我的信仰，我的神灵。我领导着一支邪恶的军队攻击无冬城，我自己的城市。我把毁灭带到这个世界，把自己的灵魂罚下地狱……”~
@99520 = ~“因为爱，因为痛苦，因为正义的愤怒而不那样做？我的整个生命都是一个谎言。虚荣的圣武士，不被接受的暗黑暗卫士，它们都是差不多的毒药，在我的血管里流淌。”~
@99521 = ~“不是吗？邪恶是你作出的一个决定。那时它的力量之源。不能做好事只是一种自满和兰多。真正的邪恶是对腐败和罪恶的故意追求。”~
@99522 = ~“为了邪恶而邪恶……你提出了一个我无法反驳的观点，点火者。很好，我对世界的痛恨已经因为你的火而更深，因为这里的冰而更硬了……”~
@99523 = ~“地狱……卡尼亚……你提出了一个我无法反驳的观点，点火者。一个人只能与她的命运抗争这么久。很好，我对世界的痛恨已经因为你的火而更深，因为这里的冰而更硬了……”~
@99524 = ~“以皆真实且为人所赐的我的刀刃，我的姓名以及地狱深处所有的魔鬼起誓，我将在剩下的生命里为了邪恶而追求邪恶。愿他们学会害怕我！”~
@99525 = ~“胡说。我对此感到很悲惨。被愧疚腐蚀，被愤怒蒙蔽，心中充满怀疑……一生中，我只在为非作恶，除此以外什么也没干。”~
@99526 = ~“我已经实现了自己的复仇。仇恨在持续的时候，它实际上是甜蜜的感觉。对于权力，我并没有兴趣。如果我要变成邪恶，我就会为了邪恶自身而邪恶。没什么别样的邪恶比这更冷酷了。”~
@99527 = ~“是的，我是这样。我怀疑一切，甚至我自己。神灵会犯错，魔鬼会犯错，鬼魂会犯错，犯人也会犯错。在我做下了这一切以后泰尔怎么可能还会接受我呢？”~
@99528 = ~“是的，我真地做了。我不爱范斯维克那是真的，但是绞死他并没有正义在里面，只有对民众的安抚和一个年迈的统治者的弱点。”~
@99529 = ~“正义……你提出了一个我无法反驳的观点，点火者。也许我的信仰被你的火焰重新提炼了，也被这里的冰块加强了。很好，我会照你说的做……”~
@99530 = ~“让泰尔来决定吧……你提出了一个我无法反驳的观点，点火者。也许我的信仰被你的火焰重新提炼了，也被这里的冰块加强了。很好，我会照你说的做……”~
@99531 = ~“不，但是我仍然会做。正义就是一个人做正确的事，即便是她的四周被邪恶包围。”~
@99532 = ~“正义……你提出了一个我无法反驳的观点，点火者。也许我的信仰被你的火焰重新提炼了，也被这里的冰块加强了。很好，我会照你说的做……”~
@99533 = ~“以皆真实且为人所赐的我的刀刃，我的姓名以及我一生中所有做下的善恶之事起誓，我将把剩下的生命献给泰尔和他的正义事业，不管这样做是更好还是更坏。谨遵此誓！”~
@99534 = ~“我没有看到泰尔降临地狱……我不需要什么神灵来为我的所作所为负责。我非常清楚地采取行动并付出代价。”~
@99535 = ~“作为圣武士，我被爱戴，被尊崇，我被提升至那个狭窄的地位。在他们的眼中，我不可能做错，也不会说错。如果处在我的境地，你会做些什么呢？”~
@99536 = ~“如果你告诉某些人说他们很完美，那么他们就会向你表现出他们是有缺点的……我播下了自我毁灭的种子，因为我需要降低身份。所有那些对我有很高要求的人都需要。”~
@99537 = ~“那么他成功了，因为这里我做着一些既不善良也不邪恶的事情，既不是圣武士也不是暗黑暗卫士，除了想变得平庸以外什么都不想要，并把自己的灵魂融入卡尼亚的精华。”~
@99538 = ~“尽管他是个怀有好意的笨蛋，但始终还是一个笨蛋。然而他年轻，并且是我侍奉的教会的牧师。嫁给他就等于嫁给了教会。这一切似乎是个完美的错误……”~
@99539 = ~“那么为什么我知道他的话是真的？我从没爱过范斯维克……我希望我爱过。”~
@99540 = ~艾瑞贝丝女士幽灵般的手指掠过她的秀发。您能感到她的不安传遍你的身体，穿过你的骨骼，然后消失掉。~
@99541 = ~“那又怎样？我见过以好人的名号干的坏事，也在好人蔑视的事业中见过崇高的行为。它们让我变得善良？它们让我变得邪恶？不，只有变得愤世嫉俗，对这个世界厌倦疲惫。”~
@99542 = ~“那很好笑。我认为我已经不再认识自己了。我知道自己的名字，我知道事实和细节，我知道我堕落的故事……我曾经是泰尔的一个圣武士，曾经有过一场瘟疫，我爱过一个男人……”~
@99543 = ~“所有的一切似乎像一个可怕的童话，一个来自从前的别人的故事。也许它就是这样的……也许你所了解的也是这样。我不知道……我努力想忘记那些时光。”~
@99544 = ~“你想知道实情？如果我告诉你我不喜欢生前的我又怎样。我甚至不知道我是否喜欢现在的我。也许成为一名失魂者是个不错的选择，这样甚至对记忆都麻木不觉。”~
@99545 = ~“我明白……”~
@99546 = ~“你真正在意的是什么，点火者……算了，别再烦我了。”~
@99547 = ~“不，我不认为你在意。请别再烦我了。”~
@99548 = ~“我是的。拜托，别再烦我了。”~
@99549 = ~“为什么你要点燃那堆火？”~
@99550 = ~“是的，但是我正努力做到被人遗忘……因为你的记忆，我攻击了你。”~
@99551 = ~“并且我有一些我不愿给出的答案。因为你的好奇心，我攻击了你。”~
@99552 = ~“也许是这样的，但这属于我要犯的错。因为你的自我正义感，我攻击了你。”~
@99553 = ~“你对折磨，苦恼，痛苦毫无所知！因为你的无知，我攻击了你。”~
@99554 = ~“我并不需要你所给的。所以我因你的自私而攻击了你。”~
@99555 = ~“是什么让你觉得我想要你的怜悯？因为你的傲慢，我攻击了你。”~
@99556 = ~“我是一个叛徒，你会信任我吗？我已经死了，你会让我复活吗？我被人痛恨，你会爱我吗？我失去了我的清白，你会帮我找到吗？……别浪费口舌了。有些事情你是无法取回的。”~
@99557 = ~“你因为一个关于信仰的愚蠢问题而‘救’了我？你怎会认为我有答案呢？去请求诸神来得到那些宝贵的答案吧，但愿他们像伤害我一样地伤害你。”~
@99558 = ~“难点就在这里，不是吗？每个人都想要答案，我们会走遍天涯海角去寻找它们，结果却只是发现它们根本就不存在。”~
@99559 = ~“我玩过了导师的小游戏，知道了她那五个谜题，那又能得到什么？沉睡者的梦就是如此：梦……它们像其他东西一样可以被打碎。”~
@99560 = ~“我非要那样吗？我玩过了导师的小游戏，知道了她那五个谜题，那又能得到什么？沉睡者的梦就是如此：梦……它们像其他东西一样可以被打碎。”~
@99561 = ~“如果它对你如此重要，那么你并不配知道。也许这样会教你不要打搅女士的休息……”~
@99562 = ~“你想知道答案？关于五个谜题？‘她会在卡尼亚之门找到你。’这就是你那愚蠢的答案。从中找到你想要得吧，点火者。”~
@99563 = ~“他们把我爱的人变成了一具尸体，把我信仰的正义变成了嘲讽，把我变成了一个恶魔。你应该让我成为失魂者的一员的，因为我已经没有什么东西让我留在这里了。”~
@99564 = ~“你凭什么身份问我这样的问题？拜托，最好还是忘了他……最好把一切都忘掉……别再烦我了。”~
@99565 = ~冰块从她的脸上融化，像泪水一样往下流。她的头发湿漉漉地粘着眉毛。你第一次意识到她这么美丽。在困惑，害怕与叛逆的表情中，她出手了。~
@99566 = ~火堆的灰烬冰冷而又苍白。~
@99567 = ~当莓子裂开时，一股股能量飞溅而出，点燃了你旁边的木材。在由此燃起的篝火中，你面前的女性开始微微颤抖……~
@99568 = ~当莓子裂开时，一股股能量飞溅而出，点燃了你旁边的木材。这是堆不错的火焰，但是热度似乎还不够穿透你前面这尊冰塑的雕像。你需要一堆更大的火焰。~
@99569 = ~当莓子裂开时，一股能量飞溅而出，点燃了你旁边的木材。然而火焰似乎太小了，无法温暖这寒冰四结的洞穴……~
@99570 = ~带有魔法的植物卷须挡住了你的道路。你能听到卷须那边有女人在抽泣。她的声音空洞而又冰冷，在她自己制造的监牢的冰墙上回荡。~
@99571 = ~“不，那样就行了。”~
@99572 = ~“我觉得我们需要分开。”~
@99573 = ~“好吧。那么和我呆在一起。”~
@99574 = ~“在这里等着直到我返回。”~
@99575 = ~“离开我。就是现在。”~
@99576 = ~“我想改变你的策略。”~
@99577 = ~“目前我不想改变其他什么了。”~
@99578 = ~“我不想要你施放任何法术，除非我叫你这么做。”~
@99579 = ~“我想要你走上前，独立地施放法术。”~
@99580 = ~“不要试图施展解除魔法来解除队友们遭受的瘫痪效应。”~
@99581 = ~“施展解除魔法来解除队友们遭受的瘫痪效应。”~
@99582 = ~“我想要你把任何发现的陷阱置之不理。”~
@99583 = ~“我想要你解除任何发现的陷阱。”~
@99584 = ~“不要试图潜行了。”~
@99585 = ~“保持潜行状态，但是如果遭遇下一场战斗就解除。”~
@99586 = ~“我要你现在就进入潜行状态。”~
@99587 = ~“如果我无法打开锁住的门或箱子，不要帮我。”~
@99588 = ~“在我无法打开锁住的门或箱子的时候要帮助我。”~
@99589 = ~“我想改变你跟我保持的距离。”~
@99590 = ~“和我保持远距离。”~
@99591 = ~“保持中等距离。”~
@99592 = ~“保持近距离。”~
@99593 = ~“一看见敌人就上前攻击。”~
@99594 = ~“守护我，在我攻击之前不要进攻。”~
@99595 = ~“我想调整你的装备。”~
@99596 = ~“你能鉴定我的装备吗？”~
@99597 = ~“我想要你施展你的一项特殊能力。”~
@99598 = ~“神盾术。”~
@99599 = ~“天赋神力。”~
@99600 = ~“圣疗之手。”~
@99601 = ~“我需要你施展一组防护魔法。”~
@99602 = ~“没关系。”~
@99603 = ~“施展你拥有的每一个防护魔法。”~
@99604 = ~“施展所有你拥有的长时效防护魔法。”~
@99605 = ~“施展所有你拥有的短时效防护魔法。”~
@99606 = ~“我要你施展一个魔法。”~
@99607 = ~“没关系。”~
@99608 = ~“超视觉。”~
@99609 = ~“真知术。”~
@99610 = ~“九级召唤生物术。”~
@99611 = ~“八级召唤生物术。”~
@99612 = ~“七级召唤生物术。”~
@99613 = ~“六级召唤生物术。”~
@99614 = ~“五级召唤生物术。”~
@99615 = ~“四级召唤生物术。”~
@99616 = ~“三级召唤生物术。”~
@99617 = ~“二级召唤生物术。”~
@99618 = ~“一级召唤生物术。”~
@99619 = ~“石肤术。”~
@99620 = ~“护盾术。”~
@99621 = ~“阴影之盾。”~
@99622 = ~“发现隐身。”~
@99623 = ~“抵抗术。”~
@99624 = ~“元素抵抗。”~
@99625 = ~“移除诅咒。”~
@99626 = ~“移除目盲/耳聋。”~
@99627 = ~“法术防护。”~
@99628 = ~“防护元素伤害。”~
@99629 = ~“预知术。”~
@99630 = ~“猫头鹰的智慧。”~
@99631 = ~“心灵屏障。”~
@99632 = ~“群体加速。”~
@99633 = ~“法师护甲。”~
@99634 = ~“照明术。”~
@99635 = ~“次级心灵屏障。”~
@99636 = ~“敲击术。”~
@99637 = ~“隐形法球。”~
@99638 = ~“隐形术。”~
@99639 = ~“高级隐形术。”~
@99640 = ~“加速术。”~
@99641 = ~“高级石肤术。”~
@99642 = ~“鬼面术。”~
@99643 = ~“狐之狡猾。”~
@99644 = ~“找寻陷阱。”~
@99645 = ~“轻灵术。”~
@99646 = ~“能量缓冲术。”~
@99647 = ~“不，我已经改变主意了。”~
@99648 = ~“是的，继续吧。”~
@99649 = ~“忍受元素伤害。”~
@99650 = ~“耐力术。”~
@99651 = ~“鹰之光彩。”~
@99652 = ~“神恩术。”~
@99653 = ~“制造不死生物。”~
@99654 = ~“不灭明焰。”~
@99655 = ~“清醒术。”~
@99656 = ~“猫之优雅。”~
@99657 = ~“公牛之力。”~
@99658 = ~“我已经改变主意了。”~
@99659 = ~“对全队施展法术。”~
@99660 = ~“对施展法术。”~
@99661 = ~“对施展法术。”~
@99662 = ~“对施展法术。”~
@99663 = ~“对施展法术。”~
@99664 = ~“对施展法术。”~
@99665 = ~“对施展法术。”~
@99666 = ~“对施展法术。”~
@99667 = ~“对施展法术。”~
@99668 = ~“对施展法术。”~
@99669 = ~“对我的动物伙伴施展法术。”~
@99670 = ~“对我的魔宠施展法术。”~
@99671 = ~“对我施展法术。”~
@99672 = ~“对你自己施展法术。”~
@99673 = ~“荣耀灵光。”~
@99674 = ~“操纵死尸。”~
@99675 = ~“你刚才想要说的是什么？”~
@99676 = ~“让我们停下来聊一聊。”~
@99677 = ~“好了，讨论到此为止。”~
@99678 = ~“感觉怎么样？”~
@99679 = ~“当一切都结束后，你打算干些什么？”~
@99680 = ~“回答我其他的问题。”~
@99681 = ~“一个不错的计划，让我印象深刻。”~
@99682 = ~“不，我不会同意的。”~
@99683 = ~“假设你能够离开卡尼亚……”~
@99684 = ~“你有什么目的？”~
@99685 = ~“为什么你几乎成了失魂者中的一员？”~
@99686 = ~“回答我其他的问题。”~
@99687 = ~“九渊地狱对我们中的任何一员都没有威胁。”~
@99688 = ~“没什么，艾瑞贝丝。很高兴我能帮上忙。”~
@99689 = ~“唔。我应该早懂得置身事外的。”~
@99690 = ~“成为圣灵是什么样的？”~
@99691 = ~“回答我其他的问题。”~
@99692 = ~“那么说和我期待的差不多。”~
@99693 = ~“对你来说这一定非常可怕。”~
@99694 = ~“也许会更糟……”~
@99695 = ~“无冬城里到底发生了什么事？”~
@99696 = ~“再见。”~
@99697 = ~“回答我其他的问题。”~
@99698 = ~“你怎么死的？最后怎么到了这里？”~
@99699 = ~“可是他们打败了你。他们背叛了你……”~
@99700 = ~“为什么你要做这样一件事？”~
@99701 = ~“你率领的是谁的军队？”~
@99702 = ~“你为谁效力？”~
@99703 = ~“但是在那之前，曾有过一段时间，你把这座城市称为家园。”~
@99704 = ~“为什么你想逃避这些？”~
@99705 = ~“不，那样就行了。”~
@99706 = ~“我觉得我们需要分开。”~
@99707 = ~“好吧。那么和我呆在一起。”~
@99708 = ~“在这里等着直到我返回。”~
@99709 = ~“离开我。就是现在。”~
@99710 = ~“我想改变你的策略。”~
@99711 = ~“目前我不想改变其他什么了。”~
@99712 = ~“我不想要你施放任何法术，除非我叫你这么做。”~
@99713 = ~“我想要你走上前，独立地施放法术。”~
@99714 = ~“不要试图施展解除魔法来解除队友们遭受的瘫痪效应。”~
@99715 = ~“施展解除魔法来解除队友们遭受的瘫痪效应。”~
@99716 = ~“不要解除你发现的陷阱。”~
@99717 = ~“接触任何你所发现的陷阱。”~
@99718 = ~“不要试图潜行了。”~
@99719 = ~“保持潜行状态，但是如果遭遇下一场战斗就解除。”~
@99720 = ~“我要你现在就进入潜行状态。”~
@99721 = ~“如果我无法打开锁住的门或箱子，不要帮我。”~
@99722 = ~“在我无法打开锁住的门或箱子的时候要帮助我。”~
@99723 = ~“我想改变你跟我保持的距离。”~
@99724 = ~“和我保持远距离。”~
@99725 = ~“保持中等距离。”~
