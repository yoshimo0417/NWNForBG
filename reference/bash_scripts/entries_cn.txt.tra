@101567 = ~援助术。~
@101568 = ~请问要怎样召唤魔宠。~
@101569 = ~“很好，凡人。你想知道点什么呢？”~
@101570 = ~“我想不用很多。我会”~
@101571 = ~“只有那些该死的卓尔…和其他肮脏的种族。凡人，我尽可能应付一下幽暗地域的黑暗洞穴。”~
@101572 = ~“你知道任何关于地狱的事吗？”~
@101573 = ~“你可以告诉我任何关于幽暗地域的事吗？”~
@101574 = ~“你意识到那会让你的健康受点损失，是吧？你的一些宝贵体质来换取一把好的武器？”~
@101575 = ~“很好。掠夺者。”~
@101576 = ~“可爱极了！让我们开始吧，好吗？”~
@101577 = ~“你的意思……嗯，好。我假设行的。如果你喜欢，就告诉我。”~
@101578 = ~“没关系。”~
@101579 = ~“我知道。你尽可能多流点。”[-6体质]~
@101580 = ~“我知道。适量流点。”[-4体质]~
@101581 = ~“我知道。就一点就可以了。”[-2体质]~
@101582 = ~“暂时？是自发的吗？”~
@101583 = ~“对你来说比较适合你的武器是投掷类武器。我不能改进这些，对不起。但我可以改进远程或近战武器。”~
@101584 = ~“你现在使用的武器已经附上了很多强大魔法。我不能冒险再干这事，太危险了。”~
@101585 = ~半兽人小心地看了看你的同伴。“嗯……再想一下，也许你们已经有了足够的援助了，现在，如果有情况有变，就回去。”~
@101586 = ~“恩…没关系。德金要弄点响声来，但现在太晚了。”~
@101587 = ~“你明白了。老大。”~
@101588 = ~“当我和我的旧主人在一起的时候，我就读过一些书。书上说所有的卓尔都是邪恶的，肮脏的。但是那不是真的吧？”~
@101589 = ~德金慢慢地点着头，挪了挪步。“你认为所有的卓尔都是邪恶的吗？你为什么这么认为？”~
@101590 = ~“但是…德金也是从黑暗的洞穴来的。德金不是黑暗的和扭曲的。”~
@101591 = ~“那么有些卓尔是除外的？你认为有不少是例外的？”~
@101592 = ~“但是…。狗头人也是邪恶种族。而德金不是邪恶的。至少德金不认为他是邪恶的。”~
@101593 = ~“那么…如果有一个除外，那就会有更多的吗？也许会有很多的。”~
@101594 = ~他深深地叹了口气。“德金对他所来的狗头族感到迷惑。他不明白因为他们是狗头人他们就是邪恶的…或者也许他们会是善良的，如果他们能表现一下他们到底是怎么样的？”~
@101595 = ~那个小狗头人似乎对你的反应感到沮丧。“噢，德金就是不明白这一切。”~
@101596 = ~他不停地挪着步子，并搓着手。“德金不知道。也许德金是这么想的。”~
@101597 = ~“德金有时很迷惑如果他永远都是唯一的善良的狗头人。如果他是…那么德金永远都会孤独的。”~
@101598 = ~他迅速地点点头。“对，老大。继续冒险吧！”~
@101599 = ~他用怀疑的眼神看着你，缓缓地点了点头。”德金想你是对的，老大。”~
@101600 = ~德金裂开嘴，给你一个满怀善意的微笑。”德金希望你是对的。老大。”~
@101601 = ~德金裂开嘴，给你一个满怀善意的微笑。”也许有一天德金回到狗头人部落，他们会看到怎么样的一个英雄德金呢？德金喜欢听到这声音。”~
@101602 = ~德金裂开大嘴，笑着说。“德金有老大你啊。那是真的。对小德金来说这已经够了。”~
@101603 = ~德金抓了抓头皮，努力地想了一会儿。“对德金来说大多数的卓尔是邪恶的，但也许有会有例外？”~
@101604 = ~德金抓了抓头皮，努力地想了一会儿。“那么先知女士呢？你认为她是邪恶的吗？”~
@101605 = ~“我的真名…什么…你想要我和你做什么？”~
@101606 = ~“我……我放心了。现在快点，我们必须穿过大门回到托瑞尔。如果我们等得太久，靡菲斯特会摧毁整个深水城。”~
@101607 = ~恐惧蔓延到她那双被遮盖的眼里。“但是，如果我把我的灵魂给了你，那么我会死的。我就会一无所有化为尘土…你知道你在说什么吗，<CHARNAME>？”~
@101608 = ~“谢谢您的仁慈，我的主人。我请求你，别在问了。”~
@101609 = ~在卓尔的尖叫声中，她的身体被一层层的剥去。在你眼前她的似乎衰老了一千年，皮肤变得皱纹满布，眼球下陷，身体干枯成了一堆骨头而后成为灰尽。现在娜西拉的灵魂是你的了。~
@101610 = ~卓尔把头往后一扭，痛苦而又绝望地哭了出来。她咬了咬牙：“你要强迫我爱你吗？你这个禽兽！”~
@101611 = ~“我的真名可以使你掌握我，<CHARNAME>。不管你如何滥用权利，我都会服从。但是如果我找到了自由之路，我一定会杀了你！…”~
@101612 = ~她朝地上吐了口口水，除此之外，对付她真名的力量，她似乎无计可施。“就这些吗？”~
@101613 = ~她因愤怒而放声大哭起来，但还是照你命令的做了。但亲吻结束后，她就跑开了，不再面对你。很显然，你深深伤了她的心。~
@101614 = ~“你已经注意到了，<CHARNAME>，”她用极轻的声音说道，“现在我们必须看看你的用与摩菲斯特的力量是否和你用于我的一样强大。你还想问我些什么？”~
@101615 = ~娜西拉惊奇得睁大了眼睛。她好像注意到那东西，并低下了头。当她往上看时，她的脸上露出了奇怪的表情。~
@101616 = ~“我……我的罪孽已经消失了，”她吃惊地说，”已经消失了，就好像是从来都没有过似的。我……我自由了。谢谢你，<CHARNAME>，你给了我一件与众不同的礼物。”~
@101617 = ~“尽管你很善意，但我仍然感到不安。使用真名的力量需要极大的责任，我希望你不会滥用。你还有什么希望我做的吗？”~
@101618 = ~“请别……，<CHARNAME>，不这么做……”~
@101619 = ~“我所做的是错的！许多无辜的人和朋友因为我的原因而丧生。为了不再感到有罪孽，懊悔，让在世界变的冷淡。那是野蛮的。这就是你想问我的吗？”~
@101620 = ~“谢谢，<CHARNAME>。对我的过去负责是我仅存的尊严，你还有什么要问我的吗？”~
@101621 = ~“我推想神有他们自己的秘密。但无论好坏，他们所做出的命令必须获得神的批准。你的命令，我同意…还有别的吗？”~
@101622 = ~“我不会受到伤害，你有我的诺言。和你的命令一样。你还有别的要问我的吗？”~
@101623 = ~“诅咒你的子子孙孙。让他们所有都绝望去吧…就像你所命令的那样。你还有什么痛苦要强加在我身上的吗？”~
@101624 = ~“我的灵魂？但那是我的一切了！我知道不是你将得到这力量而是失去它，我会加入…你确定这就是你想要的？”~
@101625 = ~“对此，我感谢你。<CHARNAME>，请阻止那愚蠢的行为！因为我的原因，我求你了，别在问我了。”~
@101626 = ~“听令，<CHARNAME>”~
@101627 = ~“但是，我又是一个圣武士了，没有你，我不能完成我的使命！……这是你的命令我必须服从……该死的，<CHARNAME>，但愿你没别的什么问题了。”~
@101628 = ~“但，怎么会是爱呢？……哎，你曾命令我，我无论怎样都将爱你。甚至是到我生命的最后一天……。你还有什么要求吗？”~
@101629 = ~“不……你在做什么？你敢！”~
@101630 = ~“好，我很高兴你能醒悟。现在让我们快些，靡菲斯特在等我们。”~
@101631 = ~“别蠢了，<CHARNAME>。你不需要以我真名的名义命令我做这些！相反，我很得意。历史书会记住我这个大恶魔的……还有别的吗？”~
@101632 = ~“我的灵魂？但这是我的全部了！我知道不是你将得到这力量而是失去它，我会加入……你确定这就是你想要的？”~
@101633 = ~“为了那，我要感谢你。你还有什么要强迫我的吗？”~
@101634 = ~“受命，<CHARNAME>……”~
@101635 = ~“但是我是个暗黑暗卫士，根据你建议我选择了这条路！……但是没有给我留下选择。我会服从你的命令…但愿你没别的什么问题了。”~
@101636 = ~“我……我的主人？……你命令我，我无论怎样都将爱你。甚至是到我生命的最后一天……。你还有什么要求吗？”~
@101637 = ~“是。<CHARNAME>。”~
@101638 = ~当听到他所说的，瓦伦猛地把眼睛睁大。”我的真名，”他承认了，他的眼睛充满着愤怒和敬畏。”你打算让我做什么？”~
@101639 = ~他带着厌恶的语气嘲笑你。”你想要强迫我来爱你，我的女士？从开始到结束？”~
@101640 = ~瓦伦好奇地看着你，好像他完全没有弄懂你的意思……突然，他的眼睛睁的老大。他身体发僵，像是猛烈的电流穿过他的身体。~
@101641 = ~只一会儿，他奇怪的一阵痉挛，身体上闪了下黑光又很快的消失了。当他睁开双眼时，好像什么东西发生了变化。一种不可言语的预感，他灵魂中的骚乱……都消失了。~
@101642 = ~“我……我不敢相信！”他用怀疑的目光打量着自己，慢慢地，笑了。“污点……没了！我感觉……感觉太好了！我感觉到了人性！”瓦伦抱住了你，愉快地笑了。“谢谢！谢谢你带给我的这件奇妙的礼物！”~
@101643 = ~“谢谢，<CHARNAME>。我还未报答你。现在……让我们尽快穿过大门去救你们的深水城吧。”~
@101644 = ~瓦伦的眼中闪过一倒危险的红光。“拿着我的灵魂，”他咆哮到，“那将是我生命的终止，永远。你确定那是你的愿望吗？”~
@101645 = ~瓦伦放心地点点头。“谢谢，<LADYLORD>。请……别再问我了。我求你了。”~
@101646 = ~瓦伦在你面前激烈的颤抖。他疯狂尖叫着，像是有着巨大的痛苦，很快，他的外表枯萎变成了沙土。瓦伦的灵魂现在是你的了。~
@101647 = ~他迷茫地盯着你。“我很高兴，我的女士，但是……你想要强迫我爱你？即使根本没有真爱？”~
@101648 = ~他把脸转了过去，极不愿意看这你的眼睛。“还有别的吗？我的女士？”~
@101649 = ~瓦伦用他热情的蓝眼睛盯着你，紧缩他的下颚。“那样也好，我的爱。你是那是没有约束的。无论如何，我应该自己救自己，我会杀了你的。相信我。”~
@101650 = ~瓦伦的眼中显示出痛苦的解脱。“谢谢，<CHARNAME>，我很高兴。现在……让我们尽快穿过大门去救你们的深水城吧。”~
@101651 = ~他怒视你，他的眼中燃烧着愤怒……但他什么都没有说。慢慢地，他交错拳头，不断地紧握，放松。~
@101652 = ~瓦伦努力地抵抗你的命令，但最后放弃了。他弯身，闭上眼睛温柔地亲吻着你的唇。当你离身，眼泪顺着他的脸颊流下。~
@101653 = ~“我希望那会让你高兴，我的女士。”他吐了吐口水。他拒绝直视你的眼睛。~
@101654 = ~他停下来，凝视你的眼睛，他的表情突然变地动情。温柔地吻你。“我假如那就是。”~
@101655 = ~“深水城在等着我们，亲爱的。我们在这里呆得越久，那被靡菲斯特伤害的人就越多。我们必须阻止他……”~
@101656 = ~现在他浅浅地笑道：“你不知道，<CHARNAME>。这……这好像是在我的肩膀上加了重担。”~
@101657 = ~“德金的真名！你想要我做点什么，老大？”~
@101658 = ~“没什么？没什么？好吧，要是你询问德金，那是对真名的浪费。老大，你在这上花了多少？哦，好的。我们的冒险该结束了，所以，快点。”~
@101659 = ~“老大？”~
@101660 = ~“是，老大。德金没事的……真的伤心，但没事的。你在制定遗嘱，老大？”~
@101661 = ~“是，老大，德金相信他，还有吗？”~
@101662 = ~“哦，老大？德金有点需要那个灵魂。看，那是他得到的唯一的东西。你确定你想要什么吗？”~
@101663 = ~“哦，呸！你让德金感到有点恐惧，老大。也许真名一点也不好玩……你还有别的什么命令吗？”~
@101664 = ~“咿……好的。老大，这里什么都没有…感谢鱼，再见。别让路上的门夹了你。西西。”~
@101665 = ~“靡菲斯特在前面等我们。也许在是我们最后一次战斗了。”~
@101666 = ~“你真的这么认为？”~
@101667 = ~瓦伦点点头，轻拍德金的头。“唉，我干。无论如何，站在<CHARNAME>一边战斗应该是对的。你也是。”~
@101668 = ~“这一定是受欢迎的计划，”娜西拉说，“我期盼与你一同战斗，<CHARNAME>，你也一样，德金。”~
@101669 = ~“很高兴你会这样说，精灵女士。”~
@101670 = ~“你是个很好的战士，比你自己描述的要好。”她看上去就像是在地狱中，“我，是一个，很乐意离开这个失落灵魂之地。他们呼唤我。让我不安。”~
@101671 = ~德金正要转身，但马上停了下来，举起小手。“哦，德金还有一件事要说。”~
@101672 = ~“这是个非常危险的地方。也许你想和德金谈谈德金应该用什么策略，是吧？”~
@101673 = ~“好，老大，继续冒险吧！”~
@101674 = ~德金看着你的同伴说：“老大，你确定需要德金吗？德金不想做被施舍者。”~
@101676 = ~“感谢新消息。”~
@101677 = ~“当然这是真的。决不相信一个卓尔。”~
@101678 = ~“这就像是他们生活地的缩影，黑暗又曲折。”~
@101679 = ~“好，也许不是他们的全部，但至少是大部分。”~
@101680 = ~“如果有几人不是邪恶的，他们就是罕见的例外。”~
@101681 = ~“你什么意思？”~
@101682 = ~“他们整个种族的邪恶的。没有列外的。”~
@101683 = ~“那是真的。我断想。”~
@101684 = ~“你是个例外，就这些。”~
@101685 = ~“没有人是完美的。”~
@101686 = ~“我们还是继续谈论卓尔？”~
@101687 = ~“听起来好像是个愚蠢的主意。”~
@101688 = ~“我不会扑灭你的希望的。德金。”~
@101689 = ~“你想告诉他们如何变得善良，德金？”~
@101690 = ~“哦，哭够了吧！我们走吧！”~
@101691 = ~“你再也不需要了，你必须知道这一点。”~
@101692 = ~“我想在那边一定会有其他善良的狗头人，天知道。”~
@101693 = ~“我明白了。我猜在某种程度上你是对的，”~
@101694 = ~“你找到了我，对吧？”~
@101695 = ~“我真的不知道，德金。”~
@101696 = ~“可能吧。他们说那个著名的崔斯特？杜垩登是个好卓尔”~
@101697 = ~“或许不是。”~
@101698 = ~“先知是善良的，是吗？”~
@101699 = ~“是的，有些卓尔是好的，但大部分是邪恶的。”~
@101700 = ~“走吧。”~
@101701 = ~[娜西拉]“寻天者奎霏莉娅……”~
@101702 = ~“现在没什么。”~
@101703 = ~“交出你的灵魂！”~
@101704 = ~“如果这意味着失去你，那么不行。”~
@101705 = ~“是的，我确定。”~
@101706 = ~“你是我的爱人，我要抓紧了，永远！”~
@101707 = ~“你的怒火对我来说什么都不是，我拥有你，肉体和灵魂。”~
@101708 = ~“你发疯的时候真性感。给我一个吻！”~
@101709 = ~“原谅你过去的错吧。”~
@101710 = ~“我不会做出任何伤害你是事的，娜西拉”~
@101711 = ~[艾瑞贝丝]“双魂瓦达莉亚……”~
@101712 = ~“没什么，没关系。”~
@101713 = ~“对无冬城里所发生的一切不会感到内疚。”~
@101714 = ~“你是对的。我不会问你了。”~
@101715 = ~“你没看到？这是你的赎罪。那是真的。”~
@101716 = ~“我不想看到你这样受罪。”~
@101717 = ~“是的，艾瑞贝丝。死亡和寒冷…”~
@101718 = ~“交出你的灵魂！”~
@101719 = ~“如果那意味着失去你，那么不行。”~
@101720 = ~“是的。我确定。”~
@101721 = ~“我命令你继续邪恶，而不是善良。”~
@101722 = ~“我命令你爱我……”~
@101723 = ~“没什么。没关系。”~
@101724 = ~“对无冬城里所发生的一切不会感到内疚。”~
@101725 = ~“交出你的灵魂！”~
@101726 = ~“如果那意味着失去你，那么不行。”~
@101727 = ~“是的。我确定。”~
@101728 = ~“我命令你继续邪恶，而不是善良。”~
@101729 = ~“我命令你爱我……”~
@101730 = ~“完了，艾瑞贝丝”~
@101731 = ~[瓦伦]“恶魔斗士奥斯卡辛……”~
@101732 = ~“现在没什么”~
@101733 = ~“交出你的灵魂！”~
@101734 = ~“你是我的爱人，我要抓紧了，永远！”~
@101735 = ~“我因此把你从恶魔的混污中解救出来。”~
@101736 = ~“你太客气了。”~
@101737 = ~“很高兴你喜欢它，现在把你的灵魂给我。”~
@101738 = ~“如果这意味着失去你，那么不行。”~
@101739 = ~“对不起，亲爱的，但这是为了我们。”~
@101740 = ~“是的。”~
@101741 = ~“好，现在，作为报答，你永远都是我的爱人。”~
@101742 = ~“嗯，或许不是。”~
@101743 = ~“你听到我说的了。”~
@101744 = ~“现在我们完成了。”~
@101745 = ~“你不会吓唬我。我拥有你，肉体和灵魂。”~
@101746 = ~“你发疯的时候真性感，给我一个吻！”~
@101747 = ~“毕竟那是我们所有人的希望？”~
@101748 = ~“是不是真的感到有点不同？”~
@101749 = ~“我很高兴，你的确赢得了它。”~
@101750 = ~[德金]“鳞歌者伊谢利亚……”~
@101751 = ~“没什么。没关系。”~
@101752 = ~“相信你自己，德金。”~
@101753 = ~“你真好，你很有才能，你也很有趣。你不再需要我了。就是我死了，你还是会很好的。”~
@101754 = ~“或许我帮不上。来，我们要结束这段冒险。”~
@101755 = ~“交出你的灵魂，小东西！”~
@101756 = ~“如果那意味着失去你，那么不行。”~
@101757 = ~“是的，我确定。”~
@101758 = ~“现在呢？”~
@101759 = ~“不是现在。”~
@101760 = ~“听起来好像是个不错的主意。”~
@101761 = ~她想了一会儿，说：“亲爱的，我考虑了一下，觉得这事其实并不那么重要。就当我没说吧。”~
@101762 = ~“看来你已经有了足够的帮手。我不想让团队变得拥挤……等你真的需要我时再回来找我吧。”~
@101763 = ~“你想要我再次加入你的团队吗？”~
@101764 = ~----------随机弹出选项从这里开始------------~
@101765 = ~“分开？你是……当真的吗？我觉得自己的技能非常有用，特别是处在我们目前的处境。”~
@101766 = ~“你不会为此而后悔的，<CHARNAME>。”~
@101767 = ~“我不知道这是否是最明智的决定，但是我会照你说的去做，在这里等着……暂时。”~
@101768 = ~“如你所愿，尽管我觉得你犯了一个错误。我会回到我们初次组队的地方，如果你改变主意了，你可以到那里找到我。”~
@101769 = ~“如果你觉得我的策略方面需要什么改进，尽管告诉我就行了。”~
@101770 = ~“不使用魔法？我的法术是我作战策略中重要的一部分，不过如果你觉得这样比较好，那么我照办。”~
@101771 = ~“这样可能比较好。我非常善于利用魔法来配合我在战斗中的其他技能，不会让你失望的。”~
@101772 = ~“那似乎是个奇怪的决定，但是如果你觉得这样对小组比较好，那么我就不使用魔法来驱散各种让人散失能力的效果。”~
@101773 = ~“我会尽可能使用我的魔法来驱散各种让人散失能力的效果。”~
@101774 = ~“行，从现在起我不会碰遇到的任何陷阱。”~
@101775 = ~“我会尽力解除任何侦测到的陷阱。”~
@101776 = ~“我不想让自己暴露而易受攻击，不过如果你觉得这样比较好，那么我就不施展潜行术。”~
@101777 = ~“我会保持隐藏状态直到参加战斗，然后从暗影中发起攻击！”~
@101778 = ~“我将会是暗影女士，我就像黑暗女士自身。”~
@101779 = ~“行，我不会参与进来，除非你碰到锁了。”~
@101780 = ~“我会用我的技能和法术打开任何你碰到的锁。”~
@101781 = ~“好的，你想要我在你身边多近？”~
@101782 = ~“如你所愿。”~
@101783 = ~“通常我在无人提防的情况下施展魔法，进行攻击比较有效，但是如果你觉得那样对全队更有利，那以后我就冲到前面进行攻击。”~
@101784 = ~“战斗中我会听你指挥，我会像你的影子一样呆在你身边保护你的背面。”~
@101785 = ~“好的，我会打开物品栏，让你调整到合适为止。”~
@101786 = ~“我确实有点这方面的知识，虽然这不是我的特长。让我仔细检查一下你的物品栏，看看能鉴定什么你不能鉴定出的东西。”~
@101787 = ~“我的魔法由你支配，你想让我施展什么法术？”~
@101788 = ~“你确定吗？”~
@101789 = ~“那么我的法术的目标是谁？”~
@101790 = ~“这只要一会儿的时间。”~
@101791 = ~“明智的决定，很多战斗就是因为不恰当的准备而告负。你想要我施展哪种类型的法术？”~
@101792 = ~“当……嗯，当我们死了以后，我们要去的地方的名字叫什么？”~
@101793 = ~“没关系，现在这是并不重要。”~
@101794 = ~“没关系，现在这是并不重要。”~
@101795 = ~“你还想和我谈点别的事情吗？”~
@101796 = ~“我做得不错，没让大家失望，但是等这一切都结束了，我会觉得更好。”~
@101797 = ~“你还想和我谈点别的事情吗？”~
@101798 = ~娜西拉疲惫地对你一笑，“没必要为我担忧，亲爱的……尽管我渴望这样的冒险尽快结束。这地方给我带来回忆，但是我宁愿忘记这些回忆。”~
@101799 = ~“很奇怪，现在我感到很乐观，尽管说不出原因。也许这是个好兆头……或者只是混乱爆发前的平静。”~
@101800 = ~“对不起。我看起来很消沉吗？也许是我想了太多不该想的事，总是流连于往事。我真应该把自己的思绪集中到手头的事情上。”~
@101801 = ~“我睡得不好，梦中常常出现那些被我杀死的人的脸。但是对此你无能为力。除此以外，我很好。”~
@101802 = ~“我迫切希望我们的任务能够结束，但是我想有这种念头的人不只我一个。除此以外，我很好。”~
@101803 = ~“我的视力还没有恢复，尽管我已经习惯了黑暗。除非我的眼睛能够得到治愈，否则我起不了什么作用。”~
@101804 = ~“我受了一些轻伤，但是并不严重。如果你有机会，也许我们可以治疗一下。”~
@101805 = ~“我伤得不轻，但是并不十分严重。尽管如此，在下次遭遇战之前治疗一下我的伤势是个不错的选择。~
@101806 = ~“我的伤势非常严重。如果可能的话，现在就要得到治疗。”~
@101807 = ~“毒药仍然在我的体内。越早解毒，情形就越好。”~
@101808 = ~“这病让我越来越难以忍受，我们应该尽快治疗。”~
@101809 = ~“听你的建议，目前我的训练只注重提高刺客技能，忽略法师技能。”~
@101810 = ~“听你的建议，目前我的训练只注重提高法师技能，忽略刺客技能。”~
@101811 = ~“好的。我会平衡发展法师和刺客技能。如果其中一个职业落后了，我会专门提高它，直到我的技能再次达到平衡。”~
@101812 = ~“目前我正努力平衡我的魔法能力和刺客能力。如果我在其中一个领域落后了，我会尽力在那里多下功夫，直到两者达到平衡。”~
@101813 = ~“当然了。”~
@101814 = ~“如果你觉得我的刺客技能比我的法术更有用，那么我会只在刺客职业上增加经验。”~
@101815 = ~“如果你觉得相对于刺客技能我的法术对全队来说更为重要，那么我想我可以只在法师职业上增加经验。”~
@101816 = ~“那么你一直在想着他们，<CHARNAME>？我也是。”~
@101817 = ~“你一直在想着他们，亲爱的？我也是。”~
@101818 = ~“如果我靠近些听，我想我能听到他们在呼唤我。有些声音……有些声音再说我的名字。我想我的受害者的灵魂就在那些失落在这里的灵魂之中。”~
@101819 = ~“没什么，至少我能说得出的没什么。我感到的只是一种伤心……和强烈而又痛苦的内疚。”~
@101820 = ~“是吗？我杀人是奉瓦纱瑞丝之命，谁知道靡菲斯特已经控制她多久了。也许他在利用她来为自己收集这里的灵魂。”~
@101821 = ~“红色姐妹用的是仪式匕首，一种带有强大魔法的匕首。也许是那些法术把受害者的灵魂召唤出来，然后带到了这个地方。”~
@101822 = ~“那就是你对这件事情的理解吗？仅仅是一些混乱的想像？看看我们现在的处境：我们是在九渊地狱！我们被失落的灵魂和受折磨的幽灵所包围着。”~
@101823 = ~“我听到的是真实的，<CHARNAME>。我知道这就是真的。我的受害者回来用他们不息的哭叫缠绕着我。”~
@101824 = ~“是的，尽管我感觉不到我们处在危险之中，至少不是物质危险。他们似乎只是回来用不息的哭叫缠绕着我。”~
@101825 = ~“我怎么能够阻止它？看看我们现在的处境：我们是在九渊地狱！我们被失落的灵魂和受诅咒的幽灵所包围着。我的受害者回来用他们不息的哭叫缠绕着我。”~
@101826 = ~黑暗精灵眼放寒光，宛如四周凄冷的土地，“你不用担心，<CHARNAME>。我已经学会和过去的幽灵一起生活。”~
@101827 = ~“我会让自己的心变得坚硬，忽视它们绝望的哭叫，至少在我们找到离开这个该死的地方的出路之前会这样。快点，在前面带路。我不想在这里做任何不必要的停留。”~
@101828 = ~黑暗精灵以厌恶的眼光看着你，“我以为你是一个富有同情心的人，<CHARNAME>。我以为在自己虚弱的时候能够得到你的支持。”~
@101829 = ~“也许……也许你不是我所想的那种人，<CHARNAME>。”她转过身背对着你。~
@101830 = ~“如果我从苦痛的经验中学到了某种关于爱情的道理，那么这个道理就是：最终爱情似乎总会带来悲伤和背叛。”~
@101831 = ~“我知道……我知道你说的是真的，<CHARNAME>。但是我不知道自己是否能够置之不理。如此多的灵魂，如此多的声音，我怎么能够经受得住它们？~
@101832 = ~黑暗精灵打量了你一下，点头说道：“是的，我能做到这样。他们只是声音而已，没什么大不了的。他们不能伤害到我。除非我让他们那样做，否则他们没有力量打到我。”~
@101833 = ~娜西拉慢慢地恢复了镇定。“是的，我开始感觉好点了。我承受……得了。但是我不想在这里做任何无谓的停留。”~
@101834 = ~“是的……你和我在一起。我能从你这里吸取力量。我……我做到这样。他们只是声音而已，没什么要紧的。他们不能伤害我。当你在我身边时，他们做不到这点。”~
@101835 = ~娜西拉因思考着答案而沉默了一下。“当我第一次遇见先知时，我觉得我会和她的追随者一起生活在托瑞尔的地面上。也许我仍然要这样做。”~
@101836 = ~“但是其他时候我想自己也许并不属于地表世界。也许，我该像先知一下，带领着探险队在整个幽暗地域拯救其他的人，就像我自己被拯救一样。”~
@101837 = ~她用奇怪的眼神看了你一眼。“作为伊丽思璀的追随者，那不太会是我所追求的职业类型。我想帮助那些困在幽暗地域的人找到我带来的拯救。”~
@101838 = ~“不要犯错误，<CHARNAME>：我仍然跟以前一样强大。但是现在我想用自己的技能为伊丽思璀服务。如果你觉得那样会让我变得软弱，那说明你还不明白。”~
@101839 = ~“我想关于这事我们再也没什么可讨论的了。让我们继续我们的旅程吧。”~
@101840 = ~“也许……也许如果我能找到其他迷失在黑暗中的人，我就可以帮助他们找到一条通往更好生活的道路。我知道要想逃离幽暗地域的暴力轮回是多么的困难。”~
@101841 = ~“是的，我认为是那样的。但是有时候看来我们这些生活在地表下的人几乎没有希望，没有机会逃离。我们比那些生活在地表上的人需要更多的帮助。”~
@101842 = ~“我希望你是对的。我将不得不让伊丽思璀的高雅指引着我。”她叹了叹气，“这样的谈话最好留到以后，现在也许我们应该继续我们的使命。”~
@101843 = ~“不幸的是我认为那不会在不久的将来发生。也许有一天会的……但是我会尽力为伊丽思璀效劳直到那一天来临。我只是还不清楚怎样才能达到这个目标。”~
@101844 = ~“和你呆在一起？我……我感谢你的邀请，<CHARNAME>，但是我觉得不合适。我真的不想追随着你，在一个接一个的冒险中度过自己的岁月。”~
@101845 = ~“当时机成熟，我会听从伊丽思璀的指引。但是现在那个时机还没有来临，这里仍然有很多事情需要我们完成。让我们回到自己的使命中去吧。”~
@101846 = ~“我……我想过这事了，<CHARNAME>。有时候我想命运把我们都带到了这里，它有它的理由；我想我们是注定要在一起的。”~
@101847 = ~“但是有时候，我又想我们将不得不分道扬镳。我们的道路也许会时不时地相交，但是最终我们还是不能走同一条路。我只是……我只是不知道是不是可以这样。”~
@101848 = ~“这样不公平，<CHARNAME>！事情没那么简单！这事……比较复杂。”~
@101849 = ~“你……你真的相信那样，是吗？也许……也许你是对的。”她给了你一个温暖的笑容，“你真地给了我一个要好好考虑的想法，<CHARNAME>。”~
@101850 = ~“你……你会为我那样做吗，<CHARNAME>？我……我不知道该怎么说了。你真地给了我一个要好好考虑的想法……”她一时说不出话来，慢慢地消失了。~
@101851 = ~“这……这不是我们现在就应该觉得的事，我们应该等这一切都结束了再说。到那时我会祈求伊丽思璀的指引，然后……然后就将看到我们将要看到的结果。”~
@101852 = ~“让我们回到我们的使命中。我们的敌人还没有被击败；如果我们想要生存下去，我们必须集中精神。”~
@101853 = ~“我会很高兴和你谈论有关月光女神的话题，但是我不是什么专家，我只是最近才渐渐明白她的信仰。”~
@101854 = ~“伊丽思璀是月光和众星女神——月光和星星是黑暗精灵再也没有看到过，已经被遗忘的。她同时也是仁慈，宽恕和救赎女神。”~
@101855 = ~“所有向她寻求更好道路的人都是受欢迎的。即使是我这样的人——身上沾着一百个人的鲜血——也被接受了。伊丽思璀相信我们能够超越过去的自我。”~
@101856 = ~娜西拉眼光变得冰冷，“你有权保留自己的观点。但是没必要用这样残忍恶毒的语言攻击我如此强烈信仰的事物。”~
@101857 = ~“显然你并不是真地想要了解伊丽思璀，而且我也不会呆在这里任凭你为了娱乐嘲弄我的信仰。让我们继续赶路。”~
@101858 = ~“如果瓦纱瑞丝转变的愿望是真诚的，那么她在这里会受到欢迎。不过，我不相信她会很快现身并亲自在先知面前进行忏悔。”~
@101859 = ~“先知具有洞察人心的眼力，她能辨别出一个人对其的信仰到底是真诚的，还是仅仅用语言来遮挡他们本来的用意。”~
@101860 = ~“这就是为什么我虽有过去的罪行，但仍被接受的原因。先知能够看出我崇拜伊丽思璀，并接受她原谅的愿望是真诚的。”~
@101861 = ~娜西拉眼睛看着地面，说：“我……我必须对你诚实，<CHARNAME>。我知道伊丽思璀女士包容一切，但是有时我觉得自己甚至没有资格崇拜她。”~
@101862 = ~“我的双手沾满了太多的血腥，回首过往我做了太多可耻的事情。当我得知一切已经无法挽回时，我怎么还能继续生活下去呢？”~
@101863 = ~“是的，我觉得……我觉得你是对的。伊丽思璀因为现在的我而接受了我，没有保留，没有审判。我也努力应该这样做。”~
@101864 = ~“但是有时候我的那些受害者的脸仍然缠绕着我，我会梦到他们。你知道这事吗？他们紧紧地盯着我，眼睛一眨也不眨，充满了控诉和憎恨。”~
@101865 = ~“我会努力把注意力集中到目前所做的事情上，不会让自我怀疑影响我们的使命，这一点我向你保证。”~
@101866 = ~“原谅我，但是我不想再讨论这个了。让我们……让我们继续前进吧。”~
@101867 = ~“不，我不这样认为。对不起……这事我必须自己解决。你帮不了我，<CHARNAME>，谁也不能。”~
@101868 = ~“这是一个很多人对伊丽思璀的追随者提出过的问题。但是答案很简单：我们相信仁慈和宽恕，但不是傻子。我们会抗击敌人，保卫自己。”~
@101869 = ~“我们不会让自己被扔进坑洞里让野兽吞掉，而我们的敌人却在一旁边笑边看。我们为了事业而愿意牺牲自我，但是我们不会毫无意义的死去。”~
@101870 = ~“然而，如果我们的敌人真心想要改变，那么我们会接受他们，并原谅他们在过去对我们造成的伤害。正如我所说的，即便是像我这样罪业深重的人也能够获得拯救。”~
@101871 = ~她摇了摇头，道：“我没有必要去赚取自己的救赎。伊丽思璀赦免了我过去的罪行，因为我发自内心地知道自己的所作所为是错误的。拯救是无偿给予的礼物。”~
@101872 = ~“这是使得伊丽思璀与其他的神不同的地方。她并不要求我侍奉她，但是我仍然会侍奉她，因为我信仰她，因为我相信我能够帮助拯救他人。”~
@101873 = ~“坎塔家族已经不存在了，它为瓦纱瑞丝所摧毁。当我决定加入红色姐妹的时候，我就意识到自己必须接受这个事实并继续前行。”~
@101874 = ~“如果我想要生存下去，就不会出现那种情况。加入红色姐妹是一个机会，能够让我得到一些已经失去的东西：权力、声望和影响力。如果这意味着我需要和以前的敌人结盟，那也只好这样。”~
@101875 = ~“当然，当我遇见了先知后，我就把自己的忠诚转向了伊丽思璀，并抛弃了瓦纱瑞丝和我以前的生活。”~
@101876 = ~“为什么你会这么说，<CHARNAME>？我以为……我以为我们彼此理解。我以为……我以为我们彼此信任。也是是我错了。”娜西拉叹了口气，摇了摇头。~
@101877 = ~“这对我意味着很多，<CHARNAME>，特别是在考虑到其他一些人的想法时。有些人把我看成机会主义者，不断地变换阵营。他们没有认识到真相。”~
@101878 = ~“我对伊丽思璀的转变与我当时把忠诚从坎塔家族转到瓦纱瑞丝的情形完全不一样。那只是为了便利的一个举动，而这次则是信仰的转变。”~
@101879 = ~“伊丽思璀给了我一种新的生活下去的方式，给了我一条崭新的道路。我知道前面的路将会困难重重，但是在我的心中，我知道这是正确的。”~
@101880 = ~娜西拉看起来就像被打了一巴掌：“我看你和其他人没什么两样。”她咬紧牙关，一字一顿地说，“说得够多了，让我们继续前进吧。”~
@101881 = ~卓尔看起来一时被你的话惊呆了：“我……谢谢你，<CHARNAME>。我没有期望过能得到如此的支持，对此我万分感激。”~
@101882 = ~她对你报以温暖的一笑，道：“我知道你会的，<CHARNAME>。我知道不管面对什么，事情都会变得容易，因为你和我在一起。”~
@101883 = ~娜西拉深深吸了口气，然后说道：“我很高兴我们能够这样的交谈，<CHARNAME>。但是仅靠交谈我们并不能阻止敌人。我们需要继续前进。”~
@101884 = ~“因为加入了先知，我牺牲了所有在红色姐妹中得到的东西，并且站在了冲突中较弱的一方。如果不是因为真诚地相信先知所代表的立场，我不会这样做。”~
@101885 = ~娜西拉笑了起来：“你定是知道怎样让一个姑娘心情高兴，<CHARNAME>。谢谢你的赞扬。”~
@101886 = ~娜西拉害羞地对你笑了笑：“我也很高兴，你理解我。虽然我们认识的时间不长，但是我觉得你已经比别人更了解我。你相信我。”~
@101887 = ~“你真的不明白，是吗？坎塔家族已经毁掉了，什么也不存在了！为什么在我有一个重建自己生活的机会时仍要抓住一堆无用的灰尘不放？”~
@101888 = ~“加入红色姐妹是我的一个机会，可以让我重新得到已经失去的大部分东西：权力，声望和影响。如果代价是要我与以前的敌人结盟，那们就让它这样吧。”~
@101889 = ~“复仇在对我的生存没有意义。红色姐妹给了我一些已经失去的东西：权力，声望和影响，而代价则是和以前的敌人结成联盟。”~
@101890 = ~“没什么可多说的，<CHARNAME>。我们是刺客，明白而又简单。让红色姐妹分开的是我们独一无二——并且常常是致命的——训练方法。”~
@101891 = ~她叹了口气：“行，我想你已经有权知道更多有关我的情况了。我会告诉你有关我们的训练。”~
@101892 = ~“那些参加红色姐妹训练的人都是由瓦纱瑞丝亲手挑选的。6个人一个班进行训练，只有一个能够完成。”~
@101893 = ~娜西拉耸了耸肩：“是你提出来的。如果你不想讨论了，那下次我们就不会再说了。”~
@101894 = ~“我是这样做的，虽然这几乎不算是一个预料之中的结果。如果训练没有杀死你，那么其他的学生也有可能会杀死你。事实上，除掉其他的学生这样的行为是受到鼓励的。”~
@101895 = ~“恰恰相反。从第一天起我们就知道身处性命攸关的战斗中。如果训练没有杀死你，那么其他的学生会。事实上，除掉竞争对手这样的行为是受到鼓励的。”~
@101896 = ~“这样一个紧张的环境使得每个学生随时表现出自己能力的极致，它使得最后生存下来的人是小组里最好的。”~
@101897 = ~“我参加训练的时机比大多数人都要晚。有些人以为我的年龄会成为劣势。他们认为我比那些年轻的对手们学得要慢，适应的也慢。”~
@101898 = ~“但是我把自己的年龄和经验看成是优势。在加入红色姐妹组织之前，我就已经开始学习魔法——对其他学生来说这是很明显的一个优势。”~
@101899 = ~“不用说，导师被我使用魔法的本领，以及利用它来取得优势的能力留下了深刻的印象。~
@101900 = ~“每个参加训练的学生都有一个标明其技术和能力的名字。我的名字叫阿露尔·菲恩。用你们的话说就是最佳巫师。”~
@101901 = ~“只有一个学生凭她的技能对我构成威胁：维尔肯·维尔德——暗藏之刃。几个月之内其他学生都死了——两个死在她手里，两个死在我手里。”~
@101902 = ~“维尔肯和我一直想除掉对方。但是我们都很小心狡猾，于是两人同时活到了训练结束。”~
@101903 = ~“毕业前夕我们被告知第二天早上两人将会在一个训练室中进行最后的摊派。”~
@101904 = ~“指导老师明确禁止我们在那天晚上杀死对方的图谋：他们想要我们为明天的对抗好好休息。”~
@101905 = ~“但是我知道单打独斗我不是她的对手。她太敏捷了；我甚至不会有施展魔法的机会。于是那天晚上我溜出了房间，潜入她的卧室，割断了她的喉咙。”~
@101906 = ~“结果？第二天早上她死了。指导老师对我的抗命非常生气，但是他们没有其他学生活下来，所以只好让我毕业。”~
@101907 = ~“我唯一欺骗的就是死亡。我比其他学生活得都长。这就是训练的全部意义。当然，自从我加入先知以后，我稍微改变了我的观点。”~
@101908 = ~“那时候，我对自己感到非常骄傲。但是现在我再也不能做这样可怕的事了。”她摇着头，把回忆赶走。“也许我们应该回到手头的任务中来。”~
@101909 = ~“我确实是这样……尽管在信仰伊丽思璀以后我已经在很多方面有了改变。”~
@101910 = ~娜西拉笑了起来：“我怀疑这样会不会有帮助，<CHARNAME>。我对自己所做的事情非常擅长。但是现在你可以安稳地睡觉……我不是从前的我了。”~
@101911 = ~“我的故事已经说得足够了，我们还有很多事情要做，我们应该回头继续我们的任务。”~
@101912 = ~“那样会违背红色姐妹所代表的一切。相反，他们告诉我们第二天早上在一个训练室进行最后的较量。”~
@101913 = ~“谁说过有关公平的事？我的生命处在危险之中！另外，我们的训练要求我们使用任何可支配的资源。如果有什么的话，那就是指导老师很崇拜我使用魔法的能力。”~
@101914 = ~她露齿一笑，仿佛一位捕猎者：“我的能耐比你想像的更多！”~
@101915 = ~“实际上，我想知道关于你的一些事情。当这一切都结束后，下一步你打算怎么办？我是说……你会回到地面，不是吗？”~
@101916 = ~“我猜你知道我开始明白为什么瓦纱瑞丝会害怕你……为什么先知会对你如此信任。”~
@101917 = ~“有些是我可以告诉你，我一直在观察你，<CHARNAME>。我观察你怎样处理自己的事情。你让我想起了我曾经认识的一个人。”~
@101918 = ~“更多有关我的情况？好吧，以前我什么都不愿意说，因为我几乎不了解你。但是既然现在我们在一起干活，你有权知道。”~
@101919 = ~“如你所愿。但是我希望我们以后有机会再说。”~
@101920 = ~娜西拉冷冷地瞟了你一眼，“我在说此地一些超物质的东西。我感到冰封般的寒冷，那是陷落在我们周围的失落的灵魂发出来的。”~
@101921 = ~是的，我觉得越早找到回主物质世界的路越好。我迫不及待地想离开这个世界：它勾起了我本想遗忘的记忆。”~
@101922 = ~“当然你也能感觉得到他们，他们像是幽灵的影子，几乎不存在。但是如果你仔细倾听，你能听到他们，就像是被遗忘的回声在私语。~
@101923 = ~“自从我们来到这里以后，这种情况变得越来越显著了。看起来他们似乎是在向我们诉说，想要告诉我们一些事情……但是我现在还不太明白。”~
@101924 = ~卓尔站立了一会儿，她的脑袋偏向一边，仔细聆听着：“我几乎可以……不。它已经消失了。也许我们继续前进比较好。~
@101925 = ~“不？你确定吗？如果你只是在听……不，他们已经暂时消失了，沉默无言。”~
@101926 = ~娜西拉用奇怪的眼神看了你一眼，“也许……也许你是对的。”她用双臂抱紧了自己，颤抖着说，“让我们继续前进吧。”~
@101927 = ~娜西拉用奇怪的眼神看了你一眼，“也许……也许你是对的。”她颤抖着，把你拉近，吸取着你的温暖。过了一会儿她把你放开，说：“让我们继续前进吧。”~
@101928 = ~卓尔站立了一会儿，她的脑袋偏向一边，仔细聆听着：“不，我认为他们不是想要警告我们……它几乎就像……不，它消失了。他们暂时已经消失了，沉默无言。”~
@101929 = ~娜西拉用双臂抱紧了自己，颤抖着说：“让我们继续前进吧。”~
@101930 = ~她颤抖着，把你拉近，吸取着你的温暖。过了一会儿她把你放开，说：“让我们继续前进吧。”~
@101931 = ~“不，我想不是的。但是此地有一些超物质的东西。我感到冰封般的寒冷，那是陷落在我们周围的失落的灵魂发出来的。”~
@101932 = ~“那就是你所想的吗，即便是在这样的冰冻荒地上？如果你那笨拙的想要恭维我的企图不是那么不合适的话，我也许会觉得它们较为可敬。”~
@101933 = ~“另外，我不是在说简单的物质上的温暖，我感到的寒冷比这要深，它是困在我们周围的失落的灵魂发散出来的彻骨的冰冷。”~
@101934 = ~娜西拉调皮地扬了扬眉毛：“我很高兴你觉得它有吸引力，但是我不知道为此而遍体冻伤是否值得。”~
@101935 = ~艾瑞贝丝扬了扬眉毛：“你们两个能不能至少体面一点，在私下里逗弄你们的儿女情长？这个地方本来已经够让人难以忍受了。”~
@101936 = ~娜西拉敏锐地忽视了这个精灵的嘲弄，“实际上，我感到的寒冷比肉体的要深，它是困在我们周围的失落的灵魂发散出来的彻骨的冰冷。”~
@101937 = ~“我们相互之间认识不久，但是一起经历了很多。我知道你是被迫帮助我们抵抗瓦纱瑞丝的，即便这样我也仍然对你所作的一切表示感激。”~
@101938 = ~“你真的那样独善其身吗？你还在不在意靡菲斯特现在就把毁灭降临深水城？”~
@101939 = ~“至少你不是那么得独善其身。但是我想我们真的也没什么别的可以说了，让我们把注意力转移一下，想想怎样离开这个该死的地方，并阻止他。”~
@101940 = ~“我知道，那么我想我们真的也没什么别的可以说了，让我们把注意力转移一下，想想怎样离开这个该死的地方，并阻止他。”~
@101941 = ~“我相信你，<CHARNAME>，就像我相信你会想法阻止靡菲斯特，并把我们从这个地方解救出去。你是一个伟大的英雄……也许是有史以来最伟大的。”~
@101942 = ~“那是真的，但是如果有人能够想法阻止他的话，我知道那个人就是你，<CHARNAME>，在抵抗瓦纱瑞丝的战斗中你证明了自己是一个真正的英雄。并且我知道你也将找到一个方法离开这里。”~
@101943 = ~“但是对我来说你不仅仅是一个英雄。我曾习惯于独自生活，藏身于阴影之中。我……我没几个朋友。但是我把你当作朋友，<CHARNAME>。”~
@101944 = ~她笑了笑，脸上一幅如释重负的表情，“很高兴听到你这样说，<CHARNAME>。在这样一个地方，我们需要所以能够拥有的朋友。”~
@101945 = ~“现在让我们找到一条路来走出这个该死的地方！”~
@101946 = ~“不仅仅是朋友？我……我很抱歉，<CHARNAME>。我关心你，但是仅仅作为一个朋友。我不了解……我真的了解你不够深，还不能感觉到其他的感情。”~
@101947 = ~“也许……也许我什么都不该说。我不想……我是说，我从没想要……对不起。”她转过身，慌乱地走开了。~
@101948 = ~“你生气了。如果我做了让你觉得超出友谊之外的事，我表示歉意。我只是希望当你冷静下来以后，我们仍然是朋友。让我们……让我们继续前进吧。”~
@101949 = ~娜西拉看起来明显的不安，说话时甚至不敢看你的眼睛：“是的，也许这样更好。让我们赶路吧。”~
@101950 = ~她仰望着你，脸上是宽慰和悲伤混合的表情：“我希望自己的感觉能够不同，<CHARNAME>……但是我没做到。让我们……让我们继续前进吧。”~
@101951 = ~她笑了起来，眼睛向下看着。你不能确定，但是你想她可能在脸红。她组织了一下语言，然后继续说下去。~
@101952 = ~“是的，当然，你是对的，我很抱歉，我不知道自己想到了什么。在打败瓦纱瑞丝之前，考虑自己的未来毫无意义，这样只会让事情变得混乱。”~
@101953 = ~“有时候我想无聊才是我寻找的东西。我的生活充满激动：我似乎避免不了。也许在地面上我能最终找到自己寻求的平静。”~
@101954 = ~“我也这样听到过。先知警告过我，说卓尔在那里将会一直受到怀疑和憎恨。但是比起这里与死亡和背叛为伍的生活，那样会更坏吗？”~
@101955 = ~娜西拉摇了摇头：“对不起，<CHARNAME>。在我们没有打败瓦纱瑞丝之前，我不该想到以后地表的生活，那样只会让事情变得复杂。”~
@101956 = ~“让我们……让我们继续冒险吧。”~
@101957 = ~“我听说过很多有关它的奇迹：太阳，风，雨。对我来说，想像一下这些事物都是困难的。我发现它们既令人兴奋又非常可怕。”~
@101958 = ~“你过分热切的自信很让人鼓舞，但是也模糊不清让人不安。最好能让我看见一些实实在在的证据，好让证明我没有把信仰放错地方。”~
@101959 = ~娜西拉低头往下看着：“有时候我想如果我没有把信仰转向伊丽思璀，那么我现在会在哪里；想像着如果我杀掉了先知，又会发生一些什么事情。”~
@101960 = ~娜西拉看起来很吃惊：“难道我没有告诉过你这个故事吗？当我还是红色姐妹的成员，还在侍奉瓦纱瑞丝的时候，我被派去杀掉先知。”~
@101961 = ~“没有？好吧，我想你自己也能猜得出详情。我只要说说下面这些就够了：我来行刺先知，结果却转向信仰伊丽思璀。”~
@101962 = ~“但是既然你看起来认为我们时间紧迫，那么我想我们还是继续前进吧。”~
@101963 = ~“那事发生在不到一年以前，就在瓦纱瑞丝超越了其他主母的野心，开始攀登真正的权力之峰以后。”~
@101964 = ~“先知一直领导着深入幽暗地域的冒险团队。他和她的追随者来传播伊丽思璀的教义，帮助那些想要逃到地面的人。”~
@101965 = ~“为瓦纱瑞丝效劳的几个重要的手下在先知的敦促下转变了信仰，并抛弃了他们以前的女主人。显然，瓦纱瑞丝不能让这种情况继续下去。”~
@101966 = ~“我是瓦纱瑞丝手下顶尖的刺客之一：野心勃勃而又能力不凡。她告诉我，如果我能够把先知的头带给她，她就会让我成为红色姐妹里的一个训练者——一个伟大的荣誉。”~
@101967 = ~“我开始研究伊丽思璀的教义；我想了解所面对的敌人。在我看来，他们所传授的这些教义非常奇怪：仁慈，同情，宽恕，救赎。”~
@101968 = ~“那时候，我想这些只不过是愚蠢的空想，并把它们丢在了一边。我只是把它们看成是让我赢得对目标的优势的方法。”~
@101969 = ~“你也许是对的。伊丽思璀的教义虽然奇怪，但是我的脑海里已经播下了转变的种子……尽管我自己都没意识到。”~
@101970 = ~“我潜入了先知的营地，装扮成一个想要转变的人。很简单的，我就被安排和我的受害者进行面对面地接见。让我吃惊的是，我甚至被允许单独和她见面。”~
@101971 = ~“单独面对先知的时候，我拔出了剑，扑上前去想要把她击倒。她坐在哪里，一动也不动。她的眼中没有害怕，没有吃惊，似乎一切都在意料之中。~
@101972 = ~“我想要杀死她，但是不知为什么她并不害怕死亡。我从没见过这样的情形，某种念头让我的手停了下来。”~
@101973 = ~“也许是伊丽思璀自身神力的干预，也许是我的良心。不管什么原因，我的手被麻痹了，抓着的剑刃也变得僵硬。”~
@101974 = ~“先知看着我说：你必须选择，娜西拉。打倒我，然后瓦纱瑞丝赐予你巨大的财富。或者让我活下去，然后在伊丽思璀女士的足下得到拯救。”~
@101975 = ~“那种奇怪的让我束手的麻痹消失了，我的意志再次可以自由控制。但是我并没有把她击倒，而是跪在了她面前，把我的刀刃放在她脚上。”~
@101976 = ~“是的，当然，我们不能仅凭语言阻止瓦纱瑞丝。来吧，然我们前进。”~
@101977 = ~娜西拉奇怪地看了你一眼：“那么我想我们应该感谢处在当时情形下的是我而不是你，如果我杀了先知，那么我们两个可能都不能活下来反抗瓦纱瑞丝了。”~
@101978 = ~“但是这件事情就到此为止吧，我们必须继续我们的冒险，想办法阻止瓦纱瑞丝，其他事情都无关紧要。”~
@101979 = ~“是的，从那天以后我就把自己献给了先知和伊丽思璀女士。”~
@101980 = ~“也许吧，虽然那时我还没有意识到她的天分。我所知道的就是，我的受害者第一次不惧怕死亡。尽管我想要杀死她，但是某种力量让我的手停住了。”~
@101981 = ~“不，而且我认为即使回到当时的情形，自己也没有那样的感受。了解伊丽思璀的教义在我的心理和头脑里埋下了转变的种子……尽管我没有意识到。”~
@101982 = ~“不，我对先知和伊丽思璀的信仰一直都很虔诚。但是，看到一些有关我们信仰的实实在在的证据还是不错的。”~
@101983 = ~“是的，并且我和她有同样的信仰，而看到我们信仰的实在的证据是件好事。”~
@101984 = ~“我一直在观察你，<CHARNAME>。我观察你怎样处理自己的事情。你让我想起了我曾经认识的一个人。”~
@101985 = ~“这谈不上监视，<CHARNAME>。我们在一起做事，彼此好奇是人之常情。我一直在观察你，就像我相信你也在一直观察我一样。”~
@101986 = ~“就像希拉敏一样，你身上也有某种权威的气质。即使是一个奴隶，希拉敏只要一出现就能得到尊重。<HESHE>是一个领袖……就像你一样。”~
@101987 = ~“你让我想起了希拉敏，在我加入红色姐妹之前认识的一个仆人。<HESHE>是一个<RACE>，像你一样……并且来自地表。坎塔家族——我的家族——在一个奴隶拍卖会上买下了<HIMHER>。”~
@101988 = ~“希拉敏不像其他任何的仆人，<HESHE>身上有种权威的气质；即使是一个奴隶，<HISHER>只要一出现就能得到尊重。希拉敏是一个领袖……就像你一样。”~
@101989 = ~“不，我想你不能。另外，希拉敏是我过去的一部分，<HESHE>已经死了好多年了；<HESHE>是在瓦纱瑞丝摧毁坎塔家族的时候被杀死的。”~
@101990 = ~“是的，我想你是对的。我生命的那一部分已经过去了，希拉敏已经死了好多年；<HESHE>是在瓦纱瑞丝摧毁坎塔家族的时候被杀死的。”~
@101991 = ~“希拉敏已经死了好多年；<HESHE>是在瓦纱瑞丝摧毁坎塔家族的时候被杀死的。”~
@101992 = ~娜西拉点了点头：“坎塔家族是第一个被瓦纱瑞丝摧毁的，那时很多很多年以前的事情了，那时候她仅仅只是一个普通的野心勃勃的卓尔主母——和其他的主母没有什么不同。”~
@101993 = ~“不，尽管考虑到我与红色姐妹的联系，我能看出你的想法。但是我在很久很久以后才加入她们。”~
@101994 = ~“我是坎塔家族的瓦萨娜主母最小的女儿。当我们家族倒下的时候，瓦纱瑞丝想要把我和所有的姊妹都杀死，就跟我的母亲一样。”~
@101995 = ~“起初我并不没有那样。我是坎塔家族的瓦萨娜主母最小的女儿。当我们家族倒下的时候，瓦纱瑞丝想要把我和所有的姊妹都杀死，就跟我的母亲一样。”~
@101996 = ~“但是尽管我还年轻，我已经很精通卓尔的政治了。我在坎塔家族之外还有同党，当我的家族被毁灭的时候他们帮我逃了出去。”~
@101997 = ~“不错。瓦纱瑞丝派红色姐妹来追杀我，但是每当有人找到我时，最后死掉的总是她。”~
@101998 = ~“我杀了如此多红色姐妹的人，于是瓦纱瑞丝最终邀请我加入她。我对逃亡的生活感到厌倦了，所以我接受了她的邀请。”~
@101999 = ~卓尔怒视着你：“是的，我的故事结束了。显然你想把注意力集中到我们的任务上。很好，让我们继续前进吧。”~
@102000 = ~“是的，我想现在真不是讨论它的最好时机。如果你以后想和我谈论此事，告诉就行。现在让我们继续前进吧。”~
@102001 = ~“家庭对卓尔来说并不重要，时机成熟时我会计划杀死瓦萨娜主母和我的姊妹，以便能够统治坎塔家族。我的姊妹也会这样做，这是我们的方式。”~
@102002 = ~“随着坎塔家族的覆灭，我成为主母的梦想也破灭了。但是我仍然怀有野心，想要提高自己的地位，改善自己的生活。红色姐妹为我提供了一个唯一可行的选择。”~
@102003 = ~“是的，有一点。但是你必须理解卓尔的想法。对她来说我活着比死掉更有用。瓦纱瑞丝野心勃勃，她不愿意放弃一个如此有用的潜在盟友。”~
@102004 = ~“但是现在实在不是谈论这个问题的时候。我们需要专心致志地阻止瓦纱瑞丝。如果你想要继续这个话题，我们可以以后再聊。”~
@102005 = ~“是的，有一点。但是你必须理解卓尔的想法。对她来说我活着比死掉更有用。瓦纱瑞丝野心勃勃，她不愿意放弃一个如此有用的潜在盟友。”~
@102006 = ~“家庭对卓尔来说并不重要，时机成熟时我会计划杀死瓦萨娜主母和我的姊妹，以便能够统治坎塔家族。我的姊妹也会这样做，这是我们的方式。”~
@102007 = ~“我是一个多巴斯——用你们的话来说叫做放逐者——一个没有家族的卓尔。我一直都在逃亡，试图比瓦纱瑞丝派来追杀我的刺客——红色姐妹——多走一步。”~
@102008 = ~“红色姐妹对他们所从事的职业非常拿手；不管我逃到哪里，她们都能找到我。当然，我也是个好手，每次我被发现的时候，都是她们中的一个死去，而不是我。”~
@102009 = ~“在我手里损失了几十个她最优秀的刺客以后，瓦纱瑞丝意识到我该成为她的盟友，而不是敌人。她邀请我加入红色姐妹，我答应了。”~
@102010 = ~卓尔笑了起来：“你反应很快，<CHARNAME>……尽管我承认我发现你很特别，让人很感兴趣。但是那不是我的意思。”~
@102011 = ~卓尔笑了起来：“老实说你不是大家公认的帅哥，<CHARNAME>……但是我确实发现你很特别，让人很感兴趣。但是那不是我的意思。”~
@102012 = ~卓尔笑了起来：“我承认你有某种魅力，大多数女性会觉得很有……吸引力。我断定我不是第一个告诉你这些的人。但是那不是我的意思。”~
@102013 = ~“你应该知道我的一些情况，以前我什么都不愿意说，因为我几乎不了解你。但是现在既然我们在一起做事，那么你有权知道。”~
@102014 = ~“正如你已经听到的，在侍奉先知之前我是一个刺客……卓尔中很普通的职业；我是红色姐妹的成员。”~
@102015 = ~“我认为你没有完全抓住我所告诉你的事情的重点。”~
@102016 = ~“红色姐妹是一个发誓效忠瓦纱瑞丝的刺客精英组织。”~
@102017 = ~卓尔悲哀地摇了摇头：“我们一起经历患难，我帮你与海拉斯特战斗，但是你仍然不信任我吗，<CHARNAME>？”~
@102018 = ~“我想我用不着吃惊。你不是第一个怀疑我对先知忠诚的人，即使我成为了伊丽思璀的追随者，反抗瓦纱瑞丝的邪恶。”~
@102019 = ~“我一次次冒着生命危险阻止瓦纱瑞丝的阴谋，我做了任何先知要我做的事情，并且做得更多。但是我还是必须背负着其他人的怀疑。”~
@102020 = ~娜西拉愤怒地啐了一口：“你和其他人一样坏。我必须要怎样做才能证明自己呢？先知相信我；她信任我，为什么你就不能呢？”~
@102021 = ~“事实证明，我对瓦纱瑞丝的了解对先知和她的追随者很有帮助，为此我非常高兴。但是因为我以前的立场，仍然有些人用怀疑的眼光看着我。”~
@102022 = ~“那么你是一个笨蛋。谁比我更熟悉幽暗地域？谁更了解瓦纱瑞丝的手下？你需要我和你站在一边，<CHARNAME>。”~
@102023 = ~“好吧，仔细观察我。也许那时你会明白我在尽一切可能阻止瓦纱瑞丝。”~
@102024 = ~“如果我的语言不能让你相信我对先知和她的事业的忠诚，那么我希望我的行动能够让你相信。”~
@102025 = ~卓尔笑了起来：“真的？我……当我告诉你我的过去时，我还感到害怕，怕你会拒绝和我一起做事。你不会是头一个这样做的人。”~
@102026 = ~卓尔长长地叹了口气：“我很高兴能有这次交谈，<CHARNAME>；既然现在你知道了我真实的过去，那么我们就能够完全把注意力集中到阻止瓦纱瑞丝的事情上来。谢谢你。”~
@102027 = ~她谈了口气：“不，不像我不能那样。但是伊丽思璀教导我们救赎对我们所有人都是可能的，至少先知相信我。我知道她信任我。我想这就足够了吧。”~
@102028 = ~“确实是的，但是那些日子已经一去不返了。先知已经给我指明了更好的道路，我已经成了伊丽思璀的一名追随者。”~
@102029 = ~卓尔笑了起来：“现在你说话像先知一样。但是有时候我们的历史不是这样轻易被忽略的，我想你还没有完全明白我告诉你的话。”~
@102030 = ~--------- Romance Conversations begin here ----------~
@102031 = ~她耸了耸肩，把脸转了过去。“我……没事。也许我什么都不该说。最好能离开这个地方。”~
@102032 = ~娜西拉鬼鬼祟祟地四处察看了这个地方很长一段时间。当她回过头看，看见你正看着她的时候，忽然有些脸红。~
@102033 = ~“不，我想不是这样的。也许等我们用靡菲斯特的真名把他送回老家之后，再谈这件事也不迟。”~
@102034 = ~“德金的真名！你想让我干什么事情，老大？”~
@102035 = ~“没有？什么都没有？如果你问德金的话，那真是太浪费真名了。老大，你又得在那上面花多少钱？好吧，我们的冒险还没结束，赶快走吧。”~
@102036 = ~“老大？”~
@102037 = ~“是的，老大。德金没什么……确实有些伤心，不过没事了。老大，你打算就这么死去吗？”~
@102038 = ~“是的，老大。德金相信他自己。还有其他事吗？”~
@102039 = ~“嗯……老大？德金有些想要那个灵魂。这是他得到的唯一一样东西，知道吗？你确定那就是你要的吗？”~
@102040 = ~“啧啧！老大，你把德金吓呆了好一阵。也许这些真名毕竟不是什么有趣的东西……你还需要命令我做什么吗？”~
@102041 = ~“呃……好了，老大，没事了……再见……谢谢你一直以来都给我鱼吃……别让那门挡住了你的去路啊！”~
@102042 = ~听到这句话的时候，瓦伦瞪大了眼睛。“是我的真名，”他承认道，眼神里同时带着愤慨与敬畏。“你打算……命令我做什么呢？”~
@102043 = ~他面带厌恶地对你笑了笑。“你想强迫我爱上你，女士？我们的友谊就这样结束了吗？”~
@102044 = ~瓦伦好奇地看着你，好像没听懂你刚才所说的话……然后忽然瞪大了眼睛。他僵了一下，一道电流猛烈地穿过了他的身体。~
@102045 = ~片刻之后，他化作一道奇怪的黑色的闪光，从身体中升了起来，然后消散了。当他睁开眼睛的时候，好像有些东西……不太一样了。那股异常的灵气，以及灵魂中的狂暴……都已经不见了。~
@102046 = ~“我……我不相信！”他疑惑地看着自己，慢慢地笑了起来。“我又变回来了！我感觉好极了！这太棒了！！”瓦伦开心地笑着，然后一把抱住了你。“谢谢！谢谢你给我一个这么好的礼物！”~
@102047 = ~瓦伦的眼中闪过一道危险的红光。“取出我的灵魂，”他咆哮着，“我就会完蛋的。我会永世不得超生的。你真的要这样做？”~
@102048 = ~瓦伦点点头，放下心来。“谢谢你，<LADYLORD>。请……别再问我问题了，求求你。”~
@102049 = ~瓦伦在你眼前剧烈地颤抖起来。因为生命的本原被突然去除了，他愤怒而痛苦地尖叫着，身体渐渐化作了一堆灰尘。瓦伦的灵魂现在是你的了。~
@102050 = ~他困惑地盯着你。“我很感激你，女士，但是……你想强迫我爱上你？即使这根本就不是真爱？”~
@102051 = ~他把脸转了过去，不愿和你对视。“还有其他的事情吗，女士？”~
@102052 = ~瓦伦用他的蓝眼睛瞪着你看。“就是这样，亲爱的。你完全控制住了我。但是，如果我能获得自由……我会杀了你的。相信这一点。”~
@102053 = ~瓦伦的眼中充满了坚定的信念。“谢谢你，<CHARNAME>。非常感激。如果你还想要拯救你的深水城的话，我们就应该赶快通过大门。”~
@102054 = ~他盯着你看，眼中燃起了一片暗红色……但是他什么也没说。慢慢地，他双拳紧握，然后又松开了。~
@102055 = ~瓦伦挣扎着想要反抗你的命令，但是最后还是屈服了。他向前倾过来，闭着眼睛，温柔地吻在你的嘴唇上。当你分开的时候，泪水顺着他的脸颊流了下来。~
@102056 = ~“我希望这能令你高兴，女士，”他吐了口唾沫。他不再和你对视了。~
@102057 = ~他停下来，凝视着你的眼睛，表情充满了爱意。他向前倾过来，温柔地吻着你。“我想就是这样了。”~
@102058 = ~“深水城还等着我们，亲爱的。我们在这里呆得越久，靡菲斯特就会伤害越多的人……我们必须要阻止他。”~
@102059 = ~他轻松地笑了笑。“你不知道，<CHARNAME>。那就好像从我肩头卸下了千斤重担。”~
@102060 = ~“谢谢你，<CHARNAME>。我真是无以为报。现在如果你还想要拯救你的深水城的话，我们就应该赶快通过大门。”~
@102061 = ~“不……请别这样，<CHARNAME>，别做这种事情……”~
@102062 = ~“但是我做错了什么！我的行为导致了许多无辜的人还有我许多朋友的死亡。要说不会感到愧疚和自责，那也未免太冷酷了吧。这就是你想要问我的吗？”~
@102063 = ~“谢谢你，<CHARNAME>。对我来说，对我自己的过去负起责任，是我现在唯一的尊严了。你想要了解什么事情吗？”~
@102064 = ~“我想，就算是神也会有自己的秘密。但为什么一定要有他们的许可，才能用他们的语言发布命令呢，不管是好的命令还是不好的。按照你的命令，我会弥补的……还需要我做什么事情吗？”~
@102065 = ~“我不能忍受你的话语。我会遵从你的命令。你还需要我做什么事情吗？”~
@102066 = ~“我诅咒你的子孙后代。让他们都领会到什么叫做绝望……我会遵从你的命令。你有什么痛苦需要对我发泄吗？”~
@102067 = ~“我的灵魂？但那是我的东西！我知道你有那种力量，但是如果我失去了它，我就会变成失魂者……你真的需要它吗？”~
@102068 = ~“为此我很感谢你。请别这样了，<CHARNAME>，停止这疯狂的举动吧！就算是为了我自己，我求求你，别再要求什么了……”~
@102069 = ~“遵命，<CHARNAME>……”~
@102070 = ~“但是我重新成为一名圣武士了，有些事情如果没有你，我是办不到的！但我会服从你的命令的……该死的<CHARNAME>，别再向我要求什么了！”~
@102071 = ~“但那怎么能称作爱？唉，按照你的命令，我会一生一世都爱着你的……你对我还有什么要求吗？”~
@102072 = ~“不……你在干什么？你怎么敢做这种事情！”~
@102073 = ~“太好了，你终于恢复理智了。赶快，靡菲斯特正等着我们呢。”~
@102074 = ~“别傻了，<CHARNAME>。你根本就不需要用真名来命令我！恰恰相反，我很喜欢这样。这本历史书可以唤醒我，使我变得非常邪恶……还有什么事吗？”~
@102075 = ~“我的灵魂？但那是我的东西！我知道你有那种力量，但是如果我失去了它，我就会变成失魂者……你真的需要它吗？”~
@102076 = ~“为此我很感谢你。你还要强迫我做什么？”~
@102077 = ~“遵命，<CHARNAME>……”~
@102078 = ~“但我是暗黑暗卫士，是听了你的建议才走上这条路的！但你却不给我选择的余地。我会服从你的命令的……请别再要求我什么了。”~
@102079 = ~“吾……吾主？按照你的命令，我会一生一世都爱着你的……你对我还有什么要求吗？”~
@102080 = ~“好的，<CHARNAME>。”~
@102081 = ~“我的真名……你……你想让我做什么事情？”~
@102082 = ~“我……放心了。赶快，我们要穿过那道门，回到托瑞尔世界去。如果再拖延下去，靡菲斯特就会毁了深水城的。”~
@102083 = ~一丝恐惧出现在她深邃的目光中。“如果我把灵魂给了你，我就会死的。我会化为尘土……你真的要这样吗，<CHARNAME>？”~
@102084 = ~“谢谢你的恩惠，吾主。但我还是要求求你，不要再向我要求什么了。”~
@102085 = ~卓尔尖叫着，生命之源正从她身上流失。就在你眼前，她突然好像过了几千年，皮肤起皱，眼珠掉落，身体化为一堆白骨。娜西拉的灵魂属于你了。~
@102086 = ~卓尔猛地转过头去，绝望地哭出声来。她咬紧牙关说道：“你逼我爱上你？你真是个禽兽！”~
@102087 = ~“你可以通过真名来控制我，<CHARNAME>。你尽管使用你的力量来强迫我吧。但我总会想办法摆脱的，我会杀了你！那你现在还要我做什么？”~
@102088 = ~她厌恶地朝地上吐了口唾沫，但是却无法反抗真名的力量。“就这样了？”~
@102089 = ~她狂叫一声，但还是接受了你的命令。当她吻完了你，马上转过头去，不再面对你了。很明显，你伤透了她的心。~
@102090 = ~“你说得对，<CHARNAME>。”她亢奋地说道，“我们必须弄清楚，你的力量是不是像凌驾于我的一样能凌驾于靡菲斯特的。你对我还有什么要求？”~
@102091 = ~娜西拉惊奇地睁大了眼睛。她看上去打算反抗，然后低下了头。当她抬头向上看的时候，脸上的表情非常奇怪。~
@102092 = ~“我已经不再感到愧疚了，”她吃惊地说道，“它消失得无影无踪了，好像根本就没有存在过一样。我……我自由了，<CHARNAME>；你给了我一个独一无二的礼物。”~
@102093 = ~“尽管你很仁慈，但我还是觉得有些……不安。真名的力量也意味着重大的责任——我希望你不要滥用。你还需要我做什么？”~
@102094 = ~卓尔僵住了。“我希望它和你说的那么简单，<CHARNAME>。但是我不能假装什么都没发生过。我必须倚赖以前学到的知识生活。”~
@102095 = ~“我明白了。好吧，那么，这是你最后一次听到我说话了。我不会妨碍你把靡菲斯特放逐回地狱的。”~
@102096 = ~“不……我想你办不到。这是我自己的问题，我必须想办法解决——在我们尽全力打败靡菲斯特以后。”~
@102097 = ~“我想原谅我自己。我知道我已经不是原来的那个自己了，伊丽思璀也已经原谅了我。但我还是不确定，到底能不能做到。”~
@102098 = ~“是的，我想我会的。会来得及的。”她叹了口气，摇摇头说道，“对不起……靡菲斯特现在正在深水城大肆破坏，我不知道为什么会在这个时候提出来。”~
@102099 = ~“肯定是这个位面。它对我来说很奇妙。我们出去吧，找到靡菲斯特，把他送回老家。”~
@102100 = ~“不，<CHARNAME>，你不能再这样做了！你不能再脚踏两条船了。你必须要做出选择：她，还是我？”~
@102101 = ~“你又吃醋了，卓尔！？你还是个自私的小女孩呀！不要以为胸部大了，你就是女人了……愿神能饶恕你的愚行！”~
@102102 = ~“别再给我讲大道理了，鬼魂。等<CHARNAME>和我处理完了靡菲斯特的事情，你就赶快给我走，我对你已经忍无可忍了。”~
@102103 = ~“你这个傲慢的……男人！你要是在幽暗地域里说出这种话，我肯定会杀了你！那门可以通向地表，现在，没事了……我怎么会爱上你这么一个人……”~
@102104 = ~“我们不能再耽误时间了，<CHARNAME>……托瑞尔正面临着巨大的危机。我们必须用天堂之光驱散那些邪恶。走吧，让我们去维持世界的和平。”~
@102105 = ~“很好……如果你蠢到会爱上她，那我来结束你的愚行？我是为了自己要穿过那道门的，不是为了你……总之，就让它那样吧。”~
@102106 = ~“如果事情正常发展的话，你就不应该回来，鬼魂……走，亲爱的，我们还要回托瑞尔去。我要亲眼看看你向我说起的地表世界。”~
@102107 = ~“你有什么，<CHARNAME>？这确实是个好玩的小游戏，但是现在该结束了！我一旦踏过了那道门，就会在托瑞尔接到数不清的任务，才不是为了你……”~
@102108 = ~“你这个傲慢的……男人！你要是在幽暗地域里说出这种话，我肯定会杀了你！那门可以通向地表，现在，没事了……我怎么会爱上你这么一个人……”~
@102109 = ~“艾瑞贝丝，看见没有？他的床可以同时容下我们两个人！你在害怕什么呢？”~
@102110 = ~“看起来有些不妥，但是我爱你，<CHARNAME>。能得到你半个人总比什么都得不到要强。”~
@102111 = ~“你到底有多少个女人，<CHARNAME>？我总觉得这话听起来耳熟。”~
@102112 = ~“你又吃醋了，卓尔！？你还是个自私的小女孩呀！不要以为胸部大了，你就是女人了……我第一眼看到你的时候就该杀了你”~
@102113 = ~“你最好在<CHARNAME>和我处理完靡菲斯特的事情之前离开，我对你已经忍无可忍了……”~
@102114 = ~“你这个傲慢的……男人！你要是在幽暗地域里说出这种话，我肯定会杀了你！那门可以通向地表，现在，没事了……我怎么会爱上你这么一个人……”~
@102115 = ~“我们把这些魔鬼从背上扯下来宰了，<CHARNAME>……托瑞尔应该是我们的。我们不会心慈手软的。我们要回到家乡，开始征服……”~
@102116 = ~“很好……如果你蠢到会爱上她，那就太没用了。我是为了自己要穿过那道门的，不是为了你……这些谈情说爱的话已经开始让我作呕了。”~
@102117 = ~“那你就去呕吧，希望你会噎住，鬼魂……走，亲爱的，我们还要回托瑞尔去。我要亲眼看看你向我说起的地表世界。”~
@102118 = ~“你有什么，<CHARNAME>？这确实是个好玩的小游戏，但是现在该结束了！我一旦踏过了那道门，就会在托瑞尔接到数不清的任务，才不是为了你……”~
@102119 = ~“你这个傲慢的……男人！你要是在幽暗地域里说出这种话，我肯定会杀了你！那门可以通向地表，现在，没事了……我怎么会爱上你这么一个人……”~
@102120 = ~“你别和我争，娜西拉，你也可以加进来的。我不会咬你的。最多就是轻轻地啃一下，是不是，<CHARNAME>……”~
@102121 = ~“如果你是故意要气我，艾瑞贝丝，那你就再试试看。万一你事情太多顾不过来，毕竟我是个卓尔……我们先共用这个男人，等以后再来争。”~
@102122 = ~“快，<CHARNAME>，在这里多耽误一秒钟，我看到你那地表世界的时间就会少一秒钟。”~
@102123 = ~“为什么精灵女士这么难过？德金觉得这是冒险中最精彩的部分！老大是最有史以来伟大的！”~
@102124 = ~“你是对的，德金。<CHARNAME>是一个好‘老大’，而且对我们很好。我只是……想要离开而已。”~
@102125 = ~“嗯，德金想要谢谢老大。德金已经为下一本书作了许多笔记，其中有很多都是关于他的！”~
@102126 = ~德金凑近了去看娜西拉。她好像没听到，于是他拍了拍她的铠甲。“你好像还在为德金伤心。怎么了？”~
@102127 = ~“我知道，我应该庆幸自己能离开这里。一直呆在巴托地狱里可不是件轻松的事情。”~
@102128 = ~“不，不是吧？我看见了你眼中的火焰。你很牵挂这个地方吧。”~
@102129 = ~“不会比你更多了，娜西拉。你觉得这里怎么样？”~
@102130 = ~“我只是想知道……嗯……这是什么地方？”~
@102131 = ~“那收割者又是谁？或者说，收割者是*什么*？”~
@102132 = ~“一个你毫无所知的盟友？你太天真了，<CHARNAME>。但愿这个盟友不会在你最需要的时候背叛你。”~
@102133 = ~“我知道。很明显，你对收割者所知甚少。但你至少应该对这个领域有些了解吧？”~
@102134 = ~“一个由恶魔般的存在维持着的连接通道？你居然能找到一个这么奇怪的盟友，<CHARNAME>。我希望你没有看走眼。”~
@102135 = ~“你是真的不知道，还是不想告诉我？”~
@102136 = ~“发生什么了？我们在什么地方？这里难道是……不，不可能。难道是真的？我们……在九渊地狱中的某一层里？”~
@102137 = ~娜西拉冷冷地瞪了你一眼。“走吧。我和你一样想从这个地方出去。”~
@102138 = ~卓尔摇了摇头，不敢相信你们现在的处境。“很抱歉，但是我对地狱所知甚少。如果是深渊魔域的话，我还能派上点用场。”~
@102139 = ~“我唯一能说的就是，尽快找到一条离开这里的路，我想你应该也是这么认为的。”~
@102140 = ~“九渊地狱有许多层，并不是所有的地方都有火焰和硫磺。不过实际上，我根本就不想来这种地方。”~
@102141 = ~“别再讽刺了，<CHARNAME>。也许你认为跨越位面是很正常的事情，但我确实不太适应。”~
@102142 = ~“据说这个镇子是凭空出现在这座岛上的……很明显，这背后牵涉到某种强力的魔法。瓦纱瑞丝想把那魔法据为己有。”~
@102143 = ~卓尔磨了磨牙齿，回答道。“如果你把仇恨都发泄到自己人身上了，<CHARNAME>，那还怎么对付敌人。”~
@102144 = ~“那正是我所想的。走吧。”~
@102145 = ~“灵吸怪根本就看不起其他的种族，我们在他们眼里都是奴隶。毫无防备的思想对于他们来说，有着致命的吸引力。”~
@102146 = ~“如果你打算从一堆灵吸怪的包围中杀到主脑那里去的话，我会和你并肩战斗的。但是要记住，我们此行的目的是要和他们达成协议。”~
@102147 = ~“我们要和主脑进行谈判，这样可以让其他的夺心魔以为主脑已经背叛了他们。如果你能保护好自己的思想，也许我们可以和平地解决这件事情。”~
@102148 = ~娜西拉叹了口气，道：“很好，我就知道我们要打一场硬仗。战斗一开始，我就会掩护你的。”~
@102149 = ~“这些灰矮人奴隶的头盔可以使你的思想免遭夺心魔的探测。戴上这种头盔，你的思想就安全了。”~
@102150 = ~“很明显，因为你是我们的队长，灵吸怪会以为我是你的奴隶。自尊心强烈的灵吸怪不可能降低自己的身份，去探测一个奴隶的思想。”~
@102151 = ~“记得自己扮演的是一名拜访佐瓦柯穆的奴隶，这样事情就好办了。至少对于一个住满了夺心魔的城市来说是这样的。”~
@102152 = ~娜西拉对你怒目而视。“我会把那当成一个玩笑的，<CHARNAME>。我才不是谁的奴隶。在你拜访佐瓦柯穆的时候，我会当你的仆人，不过别忘了，这只是演戏而已。”~
@102153 = ~“记得自己扮演的是一名拜访佐瓦柯穆的奴隶，这样事情就好办了。至少，在对付夺心魔的时候是这样。”~
@102154 = ~娜西拉开玩笑地扬了扬眉毛：“我可能演不好一名奴隶，<CHARNAME>。你知道，在卓尔社会里，我们女性可是处在支配地位的哦。”~
@102155 = ~“是的……大概你们男人才会相信。而我会粉碎你的幻想吧？对了，我们现在还得担心更重要的事情。”~
@102156 = ~“我哪里*专横*了，<CHARNAME>！如果我知道解决问题的途径，怎么可能不帮助你们呢？还是说我没有向你提供过建议？”~
@102157 = ~娜西拉又说了些别的事情，忽然闭口不语了。过了一会儿她又说道：“我想那是个恭维吧。我看我得退出了，冲得太前面了可不好。”~
@102158 = ~“戒心太重？戒心太重？！我不是戒心重，我只是……噢……我只是抗议一下对我不公正的评价！”~
@102159 = ~“嗯。我很愿意接受这个赞美：很明显，你应该佩服我的威信，还有我负责任的态度。“~
@102160 = ~“我知道。那好，记得自己扮演的是一名拜访佐瓦柯穆的奴隶，这样事情就好办了。至少对于一个住满了夺心魔的城市来说是这样的。”~
@102161 = ~“对，会的。注意在佐瓦柯穆城里别把它取下来。一旦你的思想暴露在外，灵吸怪就会毫不犹豫地发起攻击。”~
@102162 = ~“这座神殿有死亡和黑暗魔法的气息。不管里面有什么在等着我们，我都不会感到奇怪的，这里的不死生物肯定都是瓦纱瑞丝那边的。”~
@102163 = ~“我想，那里面不止有不死生物。就算在里面发现一群亡灵巫师，我也不会觉得奇怪的；或者有一群黑暗的法师正专心于复活死尸。”~
@102164 = ~“抱怨？我觉得这应该叫做周密的计划。你喜欢打遭遇战，但是我喜欢有准备的战斗。我发现那样可以提高生存的机率！”~
@102165 = ~她摇了摇头，道：“像这样的情况，让人不得不怀疑先知对你的信心，<CHARNAME>。我发现你就会带着我们去屠杀。我现在正做着和以前一样的事情。”~
@102166 = ~卓尔叹了口气，道：“依然是那么直接而又中肯。很好，那就继续杀戮吧。”~
@102167 = ~“我知道你会的，<CHARNAME>。但是请记住：你并不是孤身一人。不论发生什么事情，我都会支持你的。”~
@102168 = ~“我也会的。”~
@102169 = ~“我也是，老大！”~
@102170 = ~“这个村庄……这些居民好像都来自托瑞尔的地表世界。有点不对劲。幽暗地域的居民只会把地表人当成奴隶或者是食物……”~
@102171 = ~“有可能，但是我觉得我们比那些村民还要害怕。我想他们大概是奴隶……但不知道他们的主人是谁。”~
@102172 = ~“嗯，你有可能是对的。但是他们的主人是谁？他们为什么要服侍他？”~
@102173 = ~“当然。只是准备要……呃，我也不知道是什么。总之要做好准备。”~
@102174 = ~“你的意思是说，某种幻术或者魔法掩盖了他们的真实身份？不，我不这么认为……当然，我也不能确定。不过我觉得他们看上去像是真的。”~
@102175 = ~“这些废墟有些奇怪。这种建筑看起来不像是眼魔的地道。不是灵吸怪的，不是灰矮人的……当然也不是卓尔的。”~
@102176 = ~卓尔不屑地看了你一眼：“我可不想陷入手足无措的境地。这个地方确实……不太对劲。”~
@102177 = ~“空气凝重而且死寂。魔法好像失去了活力……不知道我的魔法在这个地方还有没有用。”~
@102178 = ~“不光是我的法术，反魔法区域会影响到我们每个人，但我并不是光靠法术战斗的！”她投过来一个挑衅的眼神，“带路吧。我准备好了。”~
@102179 = ~“我觉得很真实了。但是我觉得，在里面等着我们的，是某种可以很长时间不依赖魔法而存在的东西。”~
@102180 = ~“幸好我并不是光靠法术战斗的。”她做了一个深呼吸。“带路吧。我准备好了。”~
@102181 = ~“我猜不到。但是我想，不管我们在里面发现了什么，应该有一个很久以前就存在的不依赖魔法的出口。”~
@102182 = ~“我想有那种可能。但我还是很害怕。我可不想陷入手足无措的境地。这个地方确实……不太对劲。”~
@102183 = ~“不管有多困难，我们都必须要试着找出眼魔暴君。这些地道里可能埋伏着几十只眼魔。”~
@102184 = ~“我才不怕！至少不会输给任何判断力正常的人。眼魔太可怕了……他们不会对来访者手下留情的。”~
@102185 = ~“嗯……我没考虑过。我在想，发现他们之后应该怎么办。能帮助他们当然最好。但是如果他们发动攻击，我们就要展开防守。”~
@102186 = ~“你要在眼魔的巢穴里剥那些眼球？你是在开玩笑吗，<CHARNAME>？要不要我提醒你会发生什么？石化，解离，然后死亡。别开玩笑了！”~
@102187 = ~娜西拉摇摇头，轻轻地笑了一下，道：“直面死亡……真不知道该说你是有着令人难以置信的勇气，还是蠢到了家。不过为了我们大家，我希望是前者。”~
@102188 = ~“你真的准备好了，<CHARNAME>？你到底知不知道满是魔像的地下城有多难闯？”~
@102189 = ~“不，当然不是。但魔像就很难办了。魔法对它们几乎没什么用，武器也很难伤害到它们。而且这些好像还不是一般的魔像。”~
@102190 = ~“制造它们的法师看起来是位制造构装生物的大师。就算碰到以前没见过的怪物，我也不会惊讶的。”~
@102191 = ~“你很特别；我不会让你有什么意外的。请答应我，你一定会当心的。”~
@102192 = ~娜西拉板着脸，用平静地声音说道：“很好。走吧。”~
@102193 = ~“记住：所有跟随先知的人的命运都掌握在你的手上，<CHARNAME>。如果你失败了，我们的希望就破灭了。”~
@102194 = ~卓尔使劲地摇了摇头：“你这个男人，别自作多情了。我说你特殊，那是因为先知的预言。你被认为是我们的救世主。”~
@102195 = ~娜西拉略带笑意地回答道：“你是个好人，<CHARNAME>。不过实际上，我只是遵照先知的预言而已。你注定会成为我们的救世主。”~
@102196 = ~“靠近码头的时候要当心。黑河是立特米亚撒军事力量中的关键部分：军队不可能安全地渡水。一掉到水里，马上就没命了。”~
@102197 = ~“好的。你想渡河的时候，找卡瓦拉斯就行了。他，或者说她——卡瓦拉斯这人很难说——可以带我们安全地渡过。”~
@102198 = ~“如果你想要过河，找卡瓦拉斯就行了。那船夫比任何人都要熟悉这条河。他，或者说她——没人能确定卡瓦拉斯到底是什么——能把我们带到想去的地方。”~
@102199 = ~“这至少可以阻止他们攻击城市的这一侧。黑河上没有桥梁——一建起来马上就会被上涨的河水冲毁。”~
@102200 = ~“不可能在这样的水流中游泳，几乎也没法划船。只有最熟练的船夫才能安全地达到对岸。”~
@102201 = ~“幽暗地域对于地表人来说是很奇怪。许多有备而来的人都精神失常了。对于你的意外来访，我很想知道你对这里的感受。”~
@102202 = ~“对，你已经出示了充分的证据。但自负最终会导致你失败。正如我们亲眼所见——即使像海拉斯特这么强大的法师，也因为粗心而失败了。”~
@102203 = ~“不要低估了幽暗地域的危险性。这里的生物为了求生，可不会像你所知的托瑞尔的地表生物那样。”~
@102204 = ~“我很高兴听到你那样说。我不是骗你，幽暗地域真的是很危险。这里的生物为了求生，可不会像你所知的托瑞尔的地表生物那样。”~
@102205 = ~“但是我想让你知道，你并不是孤身作战，<CHARNAME>。我会尽全力，帮助你阻止瓦纱瑞丝的。”~
@102206 = ~她只眯了眯眼睛，没有其他的反应：“其他人经常不相信我。所以我学会了用行动来证明自己。”~
@102207 = ~“那我们走吧。光是站在这里可没法阻止瓦纱瑞丝。”~
@102208 = ~卓尔点点头：“请吧。这次谈得很愉快。但是我们应该走了；真正的工作还在前面呢。”~
@102209 = ~卓尔非常赞同你说的话，频频点头：“这次谈得很愉快。但是现在该走了；真正的冒险还在等着我们呢。”~
@102210 = ~“先知说，你是唯一能够打败瓦纱瑞丝的人。我们的命运都掌握在你手上了。我关心你对幽暗地域的反应，是很自然的。”~
@102211 = ~她愣了一下，反应过来的时候不禁一笑：“你别吹牛了，加路克！我对你*那*方面才不感兴趣呢。”~
@102212 = ~“当然。我们还有许多事要做。”~
@102213 = ~“嗯，我想你是对的。但是，我想我能照顾好我自己。以后我会更加小心的。”~
@102214 = ~“你是想让我再次跟着你吗？”~
@102215 = ~卓尔什么也没说，只是认同地点了点头。你认为她的嘴角好像露出了一丝笑容。~
@102216 = ~卓尔看着你的同伴，皱了皱眉：“你真的不需要我？看起来你已经有很多帮手了。”~
@102217 = ~卓尔的眼神中透露着不满，但还是点头同意了。“很好。如果你觉得没有我更好的话，那我会在这里等着的。”~
@102218 = ~卓尔僵住了。“生命是脆弱的，而我们的敌人又这么可怕。肯定……会遇到挫折的。但是这次失败并不能掩盖我所付出的努力。”~
@102219 = ~“我能帮你，<CHARNAME>。我以后会更加注意的。前提是，你还愿意让我加入队伍。”~
@102220 = ~娜西拉反驳你说的话：“我很清楚我自己的实力，<CHARNAME>——也知道我的极限。用不着你来担心我；我以后会更小心的。”~
@102221 = ~“那就放心了。但是，我希望你以后不用老是复活我。”~
@102222 = ~------- 这一行必须放在队员之间说笑的结束处 ---------~
@102223 = ~“所以，艾瑞贝丝，我听说你曾经是无冬城的大英雄。至少在你背叛他们以前是这样的。”~
@102224 = ~“你真的认为你有资格来审判我吗，卓尔？你曾经是一名刺客。有多少人把你当成朋友，可你却把刀子捅进了他们的心脏？”~
@102225 = ~“我不是在审判你，艾瑞贝丝。但是我想说，我们就像是同一枚硬币的正反面：我是一名赎了罪的刺客，而你却是一名不受神宠的堕落圣武士。”~
@102226 = ~“尽管你已请求赎罪，但你心里还是充满了仇恨，卓尔。虽然你不想承认，但过去的生活仍然对你影响不小。”~
@102227 = ~“不，我想她没有。你和她也一起旅行了一段时间，如果你真的认为她已经赎罪了的话，那就不用理会我的想法了。”~
@102228 = ~卓尔瞪着你：“我还以为我赢得了你对我们的支持。看起来是我错了。”~
@102229 = ~娜西拉再一次对着艾瑞贝丝说道：“我们那里有一种说法：elg'carress。就让它那样吧。”~
@102230 = ~“<CHARNAME>是对的。这样的争吵毫无意义。我们那里有一种说法：elg'carress。就让它那样吧。”~
@102231 = ~艾瑞贝丝的目光黯淡了下来，忽然又对黑暗精灵怒目而视：“我说得已经够多了，卓尔知道那是什么意思。”~
@102232 = ~娜西拉无辜地耸耸肩：“我不是要攻击你。也许你翻译的时候有些曲解。无论如何，继续前进吧。我们已经浪费很多时间了。”~
@102233 = ~艾瑞贝丝笑了笑：“我知道为什么<CHARNAME>会被你迷住了，娜西拉。你乌黑的皮肤之下燃烧着热烈的火焰，不过我不需要你用它来指引我的道路。”~
@102234 = ~“我不是在寻找爱情。我的浪漫史已经结束了……很凄惨地结束了。相信我，我说的话并不是要破坏你和<CHARNAME>之间的关系。”~
@102235 = ~“你是对的：你并没有破坏。我现在明白了。那么我们就没什么要讨论了吧？继续执行任务吧。”~
@102236 = ~“所以，瓦伦……尽管你还有所保留，但你必须承认，到目前为止，<CHARNAME>已经证明<HIMHER>自己了。”~
@102237 = ~瓦伦不情愿地朝你那个方向瞥了一眼：“是的，我承认到目前为止，先知的预言被映证得很好。”~
@102238 = ~“那么你是不是可以重新考虑一下你对先知预言不信任的看法？”~
@102239 = ~泰夫林笑了笑说：“卓尔，你真狡猾。让我承认这个事实，然后当我乱了阵脚的时候，又用另一个观点把我引到你那边去。”~
@102240 = ~“如果你挥刀能像你说话那么迅速和精确的话，就可以在战场上跟我合作了。”~
@102241 = ~“你可真是能说会道！先用恭维转移我的注意力，然后用一个完全不相关的论据来回避我的问题；干得漂亮。现在回答我的问题……在战场上我会和你并肩作战的。”~
@102242 = ~“我对于先知预言的观点是不会改变的，娜西拉。而且我观察了你在战斗中的表现；你的防守上有一个漏洞。”~
@102243 = ~“你说你不改变信仰，我可以接受，但是你说我防守上有漏洞，我就不能接受了。我故意在左侧留出一丝破绽，把对手引诱过来，然后攻击不备！”~
@102244 = ~“但你每次这样做的时候，右腿都暴露在敌人面前了。这才是我说的漏洞，而不是你左侧那个明显的破绽。”~
@102245 = ~娜西拉闭上了眼睛，回想战斗时的情况。她突然睁开了眼睛。“你是对的！我右腿毫无防备；我必须要改进。谢谢你，瓦伦。我们谈到这些真是太好了。”~
@102246 = ~“瓦伦，我能问你个问题吗？”~
@102247 = ~“可以。你想知道什么？”~
@102248 = ~“我知道你和我一样忠心于先知。我知道，你相信她和伊丽思璀的目标。但既然这样，你为什么不相信先知的预见呢。为什么不相信？”~
@102249 = ~泰夫林看起来不安，用手揉了揉脖子上的肌肉。“我有一些恶魔的血统；也许这使我对于神力的预言有更全面的看法。”~
@102250 = ~“我经常看见凡人被外层位面的那些存在所误导。我看见他们被那些所谓的预言所操纵，就像棋盘上的棋子那样。”~
@102251 = ~“所以你认为先知被伊丽思璀的预见误导了？”~
@102252 = ~“不，也不能这么说。但是我觉得先知的预见不一定要来自伊丽思璀。或者说，可能伊丽思璀自己也被误导了。你知道，神也不是绝对正确的。”~
@102253 = ~“那你还跟随先知？”~
@102254 = ~“和你先前说的一样，我相信先知和伊丽思璀所代表的事物。我见过太多遗失的灵魂，别人都不相信他们会赎罪；就像你和我一样。”~
@102255 = ~“我的直言没有打扰你吧，娜西拉？如果我像你一样，相信先知的预言，你是不是会好过些？”~
@102256 = ~卓尔摇了摇头：“不，我觉得你跟随先知的动机并不重要。重要的是你站在我们一边。而且，看到你在战场上的表现让我很高兴。”~
@102257 = ~“嗯……卓尔女士，你是在看德金吗？每次我一看，你就会盯着我。”~
@102258 = ~娜西拉皱皱眉。“对，我想我是在看着你。或者更准确的说，是在打量你。我在找你的利刃是什么。”~
@102259 = ~“利刃？那是什么？德金的肘部有刺，不过那称不上是刀刃。”~
@102260 = ~“你是个幸存者，德金。但我不知道你是怎么办到的。你看起来又小又瘦，还有点……头脑简单。而且你太天真，太容易相信别人了。”~
@102261 = ~娜西拉无力地摇了摇头。“不管根据什么定律，你根本就不可能活这么长的时间，可……可你竟然还没死。这违反逻辑啊。”~
@102262 = ~狗头人疑惑地看着你：“德金使这位卓尔女士疯了吗？德金做错了什么吗？”~
@102263 = ~“那是你的秘密吗？无知的幸运？不，这肯定是在演戏——一种伪装。你肯定是深藏不露。肯定是！我要找出证据来。德金，我正在看你。”~
@102264 = ~狗头人笑了笑。“你看着我？你想听德金唱歌吗？那能使你平静下来。”~
@102265 = ~“呃……不，不用了。嗯……也许这不是在演戏。也许你就是常人无法理解的神秘存在之一。德金，你知道吧？把我刚才说的话忘了吧。”~
@102266 = ~德金点点头，对娜西拉翘起了拇指，说：“没问题，卓尔女士。德金已经把我们刚才的谈话忘记了。”~
@102267 = ~“德金，<CHARNAME>真的向你提起过我吗？你真的跟一条龙学过艺？”~
@102268 = ~“啊，没错。德金本来想在那里学习成为术士，但是旧主人说我没有那个天分。他认为德金最好是学习吟唱和说故事。”~
@102269 = ~“真是奇怪啊，他居然耐得下性子教你，没有一口把你给吞掉。”~
@102270 = ~“德金有时候也觉得奇怪。可能是旧主人他太寂寞了。他没有朋友。没人去探访旧主人，也没人邀请他参加聚会。”~
@102271 = ~“真的？我无法想像，居然没人去邀请一条龙。”~
@102272 = ~“德金也觉得奇怪。也许他们怕他会把椅子给坐坏了。旧主人很大很大。德金从没当他的面说过，但对于一条龙来说，他真的很胖。”~
@102273 = ~“嘿—也许那就是旧主人没有立刻吃掉德金的原因！你想，他是不是可能正在节食？而狗头人的脂肪含量比较高。”~
@102274 = ~“我想是有那个可能……”~
@102275 = ~“你觉得其他的龙也会担心变胖吗？也许德金应该给想要减肥的龙写一份特殊的食谱？德金以前从没有见过那东西！”~
@102276 = ~“我承认，给龙的食谱可能是一个还未开发的市场。但是……”~
@102277 = ~“你觉得应该怎么开头呢？也许德金应该把所有的食物列成一张表，然后标出脂肪含量的高低。你怎么想，卓尔女士？你看起来很苗条。所有的黑暗精灵都像你一样吗？”~
@102278 = ~“呃……最好把卓尔列在高脂肪的食物里面。有健康意识的龙应该就不会吃我们了。”~
@102279 = ~德金迅速地在一张皱了的羊皮纸上记了下来：“卓尔是高脂肪的。写好了。”~
@102280 = ~“没事了。”~
@102281 = ~“我想我们要暂时分开一下了。”~
@102282 = ~“那好。跟我走吧。”~
@102283 = ~“在这里等我回来。”~
@102284 = ~“去吧。我们以后可能还会见面的。”~
@102285 = ~“我想改变一下你的战术。”~
@102286 = ~“现在没什么需要改变的。”~
@102287 = ~“除非我另外指定，否则不要施放任何法术。”~
@102288 = ~“我想让你走在前面，自己根据情况施放法术。”~
@102289 = ~“不要用解除魔法移除队友身上的不良状态。”~
@102290 = ~“使用解除魔法移除队友身上的不良状态。”~
@102291 = ~“就算你发现了陷阱也不要去管它。”~
@102292 = ~“我要你一发现陷阱就去解除。”~
@102293 = ~“不要再试图潜行了。”~
@102294 = ~“在下次战斗之前保持潜行。”~
@102295 = ~“尽量一直保持潜行。”~
@102296 = ~“就算我没能打开门或箱子的锁，也不要帮我。”~
@102297 = ~“如果我没能打开门或箱子的锁，就过来帮我。”~
@102298 = ~“我想调整一下我们之间的距离。”~
@102299 = ~和我离远一点。~
@102300 = ~保持中距离。~
@102301 = ~靠近我。~
@102302 = ~“你一看到敌人就上前攻击。”~
@102303 = ~“在我发动攻击之前一直护卫我。”~
@102304 = ~“我想要调整一下你的装备。”~
@102305 = ~“你能鉴定一下我的装备吗？”~
@102306 = ~“我需要你施放一个法术。”~
@102307 = ~“没事了。”~
@102308 = ~“超视觉。”~
@102309 = ~“真知术。”~
@102310 = ~“九级召唤怪物术。”~
@102311 = ~“八级召唤怪物术。”~
@102312 = ~“七级召唤怪物术。”~
@102313 = ~“六级召唤怪物术。”~
@102314 = ~“五级召唤怪物术。”~
@102315 = ~“四级召唤怪物术。”~
@102316 = ~“三级召唤怪物术。”~
@102317 = ~“二级召唤怪物术。”~
@102318 = ~“一级召唤怪物术。”~
@102319 = ~“石皮术。”~
@102320 = ~“法术抵抗。”~
@102321 = ~“法术吸收。”~
@102322 = ~“虔诚护盾。”~
@102323 = ~“护盾术。”~
@102324 = ~“阴影护盾。”~
@102325 = ~“识破隐形。”~
@102326 = ~“圣域术。”~
@102327 = ~“复原术。”~
@102328 = ~“提升抗力。”~
@102329 = ~“抵抗元素伤害。”~
@102330 = ~“移除麻痹。”~
@102331 = ~“移除恐惧。”~
@102332 = ~“移除疾病。”~
@102333 = ~“移除诅咒。”~
@102334 = ~“移除目盲/耳聋。”~
@102335 = ~“再生术。”~
@102336 = ~“法术防护。”~
@102337 = ~“防护元素伤害。”~
@102338 = ~“预知术。”~
@102339 = ~“祈祷术。”~
@102340 = ~“猫头鹰的智慧。”~
@102341 = ~“中和毒素。”~
@102342 = ~“强力再生术。”~
@102343 = ~“次级法术无效结界。”~
@102344 = ~“心灵屏障。”~
@102345 = ~“梅斯狄强酸护罩。”~
@102346 = ~“群体加速术。”~
@102347 = ~“魔化护甲。”~
@102348 = ~“法师护甲。”~
@102349 = ~“光亮术。”~
@102350 = ~“次级法术吸收。”~
@102351 = ~“次级复原术。”~
@102352 = ~“次级心灵屏障。”~
@102353 = ~“次级驱散。”~
@102354 = ~“敲击术。”~
@102355 = ~“隐形法球。”~
@102356 = ~“隐形。”~
@102357 = ~“高等隐形。”~
@102358 = ~“加速术。”~
@102359 = ~“高等石皮。”~
@102360 = ~“高等法术吸收。”~
@102361 = ~“高等圣域术。”~
@102362 = ~“高等复原术。”~
@102363 = ~“高等驱散。”~
@102364 = ~“法术无效结界。”~
@102365 = ~“鬼面术。”~
@102366 = ~“行动自如。”~
@102367 = ~“狐之狡诈。”~
@102368 = ~“寻找陷阱。”~
@102369 = ~“灵面术。”~
@102370 = ~“熵光护盾。”~
@102371 = ~“能量缓冲。”~
@102372 = ~“不，我改变主意了。”~
@102373 = ~“对，继续前进。”~
@102374 = ~“忍受元素伤害。”~
@102375 = ~“坚忍术。”~
@102376 = ~“元素护盾。”~
@102377 = ~“鹰之威仪。”~
@102378 = ~“神力术。”~
@102379 = ~“移位术。”~
@102380 = ~“解除魔法。”~
@102381 = ~“防死结界。”~
@102382 = ~“死亡护甲。”~
@102383 = ~“召唤亡灵。”~
@102384 = ~“不灭明焰。”~
@102385 = ~“清醒术。”~
@102386 = ~“轻灵术。”~
@102387 = ~“蛮力术。”~
@102388 = ~“我改变主意了。”~
@102389 = ~“对所有队员施展。”~
@102390 = ~“对施展。”~
@102391 = ~“对施展。”~
@102392 = ~“对施展。”~
@102393 = ~“对施展。”~
@102394 = ~“对施展。”~
@102395 = ~“对施展。”~
@102396 = ~“对施展。”~
@102397 = ~“对施展。”~
@102398 = ~“对施展。”~
@102399 = ~“对我的动物伙伴施展。”~
@102400 = ~“对我的魔宠施展。”~
@102401 = ~“对我施展。”~
@102402 = ~“对你自己施展。”~
@102403 = ~“祝福术。”~
@102404 = ~“操纵死尸。”~
@102405 = ~“援助术。”~
@102406 = ~“我需要你施放群体性防御法术。”~
@102407 = ~“没事了。”~
@102408 = ~“施展所有的防御性法术。”~
@102409 = ~“施展所有长效的防御性法术。”~
@102410 = ~“施展所有短效的防御性法术。”~
@102411 = ~“一开始你想说什么来着？”~
@102412 = ~“我们停下来谈一会儿吧。”~
@102413 = ~“暂且就说到这里。”~
@102414 = ~“不，没什么了。”~
@102415 = ~“你要怎么做呢？有什么不对劲吗？”~
@102416 = ~“我想讨论一下你的训练问题。”~
@102417 = ~“我希望你找到这两者之间的平衡点。”~
@102418 = ~“继续你现在的所做的事情。”~
@102419 = ~“集中精力成为一名刺客。”~
@102420 = ~“我希望你专注于法师的训练。”~
@102421 = ~“我想再谈谈有关失魂者的事情。”~
@102422 = ~“他们和你说了什么？”~
@102423 = ~“我想，这就是你心虚的表现吧。”~
@102424 = ~“太荒谬了。”~
@102425 = ~“如果你正在丧失心智，我会把你换掉的！”~
@102426 = ~“对，你杀了他们，使得他们生气了。”~
@102427 = ~“别再让你过去的经历折磨你自己了。”~
@102428 = ~“我很烦这种事情。你现在就把这个问题解决掉！”~
@102429 = ~“你要坚强，娜西拉。你必须要能抵抗它们。”~
@102430 = ~“你已经不再是过去的你了，娜西拉。这些灵体没权利这样对你。”~
@102431 = ~“你能做到，娜西拉。我相信你。你比自己所想的更坚强。”~
@102432 = ~“但你不是孤身一人，亲爱的。我会永远和你在一起的。”~
@102433 = ~“当这一切结束之后，你有什么打算？”~
@102434 = ~“在地表上，一名刺客可以找到很多工作做的。”~
@102435 = ~“你终于软化了！”~
@102436 = ~“我觉得，帮助幽暗地域里的其他人是一个崇高的目标。”~
@102437 = ~“地表上也有许多需要拯救的人们。”~
@102438 = ~“当那个时刻到来的时候，我可以确定你会做出正确的选择的。”~
@102439 = ~“听起来你似乎想要改变整个卓尔社会。”~
@102440 = ~“也许你可以跟着我。”~
@102441 = ~“好的。那选伊丽思璀代替我吧。”~
@102442 = ~“我们可以让它运转起来。”~
@102443 = ~“不管你去哪里，我都会跟着你。”~
@102444 = ~“我想跟你谈谈有关伊丽思璀的事情。”~
@102445 = ~“那就告诉我你能干什么。”~
@102446 = ~“伊丽思璀的追随者会相信什么？”~
@102447 = ~“听起来，对我来说似乎是个愚蠢的信仰。”~
@102448 = ~“如果有人能得救，那瓦纱瑞丝会怎么样？”~
@102449 = ~“很高兴你能得到救助。”~
@102450 = ~“我们过去都办过很糟糕的事情。所以放手去干吧。”~
@102451 = ~“过去的事情就让它过去，你要学会这一点，娜西拉。”~
@102452 = ~“也许伊丽思璀的一些崇拜者已经能够原谅你了。”~
@102453 = ~“别因为那些梦而妨碍我们的任务！”~
@102454 = ~“我能帮得上什么忙吗？”~
@102455 = ~“如果伊丽思璀真像她鼓吹的那样仁慈和宽恕，为什么我们会在她的仪式上杀这么多人？”~
@102456 = ~“那就是你现在帮助我的原因吗？作为对过去罪行的某种忏悔？”~
@102457 = ~“我想知道更多关于坎塔家族的事情。”~
@102458 = ~“我想你真的是没有别的选择了。”~
@102459 = ~“坎塔家族，瓦纱瑞丝，先知：你的忠诚看起来相当反复无常呢。”~
@102460 = ~“我希望你不要又倒戈相向了。”~
@102461 = ~“很高兴你现在站在我们这一方。”~
@102462 = ~“我能看出来，你的这次转变是真诚的。”~
@102463 = ~“说得好，不过这话从你嘴里说出来，就没那个意思了。”~
@102464 = ~“你不会一个人上路的，娜西拉。我会帮助你的。”~
@102465 = ~“我没看出来那和我有什么不同。”~
@102466 = ~“我想我还不太懂。”~
@102467 = ~“我很高兴你来了。我还以为我们再也见不到了。”~
@102468 = ~“我希望你不会轻易地抛弃我。”~
@102469 = ~“你不想报仇吗？”~
@102470 = ~“我想知道更多关于红色姐妹的事情。”~
@102471 = ~“好吧，如果你不想说的话就算了……”~
@102472 = ~“那和我说说训练的事情。”~
@102473 = ~“实际上，我并不想谈这件事。”~
@102474 = ~“很明显，你是你们班上的生还者。”~
@102475 = ~“那看起来并不像是一条有效的途径。”~
@102476 = ~“随身带把小刀总是有好处的。”~
@102477 = ~“那你最后是怎么杀了她的？”~
@102478 = ~“但讲师不是说过不能那样干吗？”~
@102479 = ~“你真是个可怕的人！”~
@102480 = ~“你作弊了！”~
@102481 = ~“你想用你自己的规则，是不是？”~
@102482 = ~“记得提醒我，睡觉的时候要提防着你。”~
@102483 = ~“他们应该让你们两个都毕业。”~
@102484 = ~“你用了魔法？这太不公平了！”~
@102485 = ~“这就是我喜欢你的原因——你知道如何运用自己的才能！”~
@102486 = ~“我想知道更多有关你的事情。”~
@102487 = ~“不，还没。留在这里。”~
@102488 = ~“对，跟我走。”~
@102489 = ~“现在还不行，娜西拉。”~
@102490 = ~“什么事，娜西拉？”~
@102491 = ~“喔，你掌握得好！”~
@102492 = ~“现在关键的问题是找到出去的路。”~
@102493 = ~“那不是个令人高兴的想法。”~
@102494 = ~“你能感应到那些遗失的灵魂？”~
@102495 = ~“我们能就这样前进吗？”~
@102496 = ~“我什么都没听见。”~
@102497 = ~“也许我们不想听到他们所说的事情。”~
@102498 = ~“也许他们是想要向我们发出警告。”~
@102499 = ~“嗯，我们正身处九渊地狱的某一层中。这里似乎不是个能令人感到愉快的地方。”~
@102500 = ~“不过寒气使你的嘴唇有了漂亮的蓝色阴影。”~
@102501 = ~“从栅栏里出来。把它赶出来。”~
@102502 = ~“那是什么，娜西拉？”~
@102503 = ~“我别无选择。这是我帮助你的唯一原因。”~
@102504 = ~“是的，我想要阻止靡菲斯特。”~
@102505 = ~“我所关心的，是怎么从这九渊地狱脱身。”~
@102506 = ~“不。”~
@102507 = ~“就算我不是受到指使，也会帮助你的。”~
@102508 = ~“那帮不上什么忙。我们现在得对付靡菲斯特了。”~
@102509 = ~“真的？我还以为你只是个美其名的仆人而已。”~
@102510 = ~“我也把你当作朋友。”~
@102511 = ~“我们的关系应该比朋友更进一步吧，娜西拉。”~
@102512 = ~“你觉得你能做得更好，卓尔？你自己又没有战利品！”~
@102513 = ~“没事。我们继续前进吧。”~
@102514 = ~“好的，娜西拉。我明白。”~
@102515 = ~“真的？可我对你毫无感觉。”~
@102516 = ~“噢，我不知道你在关心……”~
@102517 = ~“对不起。继续吧。”~
@102518 = ~“让我救你几次吧：我对你*毫无感觉*，娜西拉。”~
@102519 = ~“你爱的人？”~
@102520 = ~“我也爱你。”~
@102521 = ~“我们还是得找条出去的路，娜西拉。”~
@102522 = ~“那么，现在该干什么？”~
@102523 = ~“你的信念该怎么办？伊丽思璀该怎么办？”~
@102524 = ~“我只是把你当成一个朋友，娜西拉。仅此而已，对不起。”~
@102525 = ~“我也是，娜西拉。我爱你。”~
@102526 = ~“幽默是我这浪漫魅力中的一个部分。”~
@102527 = ~“我也感觉很接近你，娜西拉。”~
@102528 = ~“我现在只想杀了瓦纱瑞丝！”~
@102529 = ~“谁会去关心地表？！我们还有更重要的事情要去担心！”~
@102530 = ~“这比幽暗地域还要令人厌烦。”~
@102531 = ~“嗯，他们不太喜欢卓尔上到那里去。”~
@102532 = ~“你总有一天会亲自看见的。”~
@102533 = ~“地表上很美丽的。”~
@102534 = ~“是的，我想我会的。”~
@102535 = ~为什么？你想要一块儿逃走吗？~
@102536 = ~“我要把瓦纱瑞丝这头猪给宰了！”~
@102537 = ~“杀掉先知？什么意思？”~
@102538 = ~“我没时间听你讲这个故事！”~
@102539 = ~“我还没听过这个传说呢。”~
@102540 = ~“为什么会派你去杀先知？”~
@102541 = ~“之后发生了什么？”~
@102542 = ~“所以她派你来解决掉这个问题。”~
@102543 = ~“可能学习伊丽思璀的教义，使你更容易接受改变立场的想法。”~
@102544 = ~“但是你杀不了她？”~
@102545 = ~“我们也许应该继续执行任务。”~
@102546 = ~“你真没用！我肯定能把她干掉！”~
@102547 = ~“你从那时起一直在服侍先知？”~
@102548 = ~“她曾经对你进行过灵视，是吗？”~
@102549 = ~“很明显，你现在还没察觉到那条路。”~
@102550 = ~“你是说你怀疑先知的洞察力吗？”~
@102551 = ~“先知相信我，因为她曾经对我进行过灵视。”~
@102552 = ~“我不喜欢你这样刺探我，卓尔！”~
@102553 = ~“真的？是谁？”~
@102554 = ~“为什么我会让你想到了<HIMHER>？”~
@102555 = ~“我向你提起过一个奴隶的事情？”~
@102556 = ~“我真的不想管这件事。”~
@102557 = ~“希拉敏已经是过去的事了。<HESHE>现在又不在这里。”~
@102558 = ~“<HESHE>怎么了？”~
@102559 = ~“等一下——瓦纱瑞丝毁了你的家族？”~
@102560 = ~“我猜猜……你帮瓦纱瑞丝毁了坎塔家族。”~
@102561 = ~“你参与了坎塔家族的垮台事件吗？”~
@102562 = ~“如果她毁了你的家族，你为什么要加入红色姐妹？”~
@102563 = ~“长话短说，突出重点！”~
@102564 = ~“这个故事说完了吗？对不起，我打了一下盹。”~
@102565 = ~“也许，我们应该继续完成使命。”~
@102566 = ~“你怎么能为那个毁了你家族的女人干活？”~
@102567 = ~“你不怕那是个陷阱吗？”~
@102568 = ~“你不怕那是个陷阱吗？”~
@102569 = ~“你怎么能为那个毁了你家族的女人干活？”~
@102570 = ~“我没弄明白。你最后是怎么加入红色姐妹的？”~
@102571 = ~“所以你就躲起来了？”~
@102572 = ~“所以你就一直监视我？发现什么感兴趣的事情了吗？”~
@102573 = ~“对这有什么意义吗？”~
@102574 = ~“我就知道不能相信你！”~
@102575 = ~“我怎么知道你不是个假装来帮助我们的间谍？”~
@102576 = ~“你背叛了瓦纱瑞丝。下次你可能就会背叛我们。”~
@102577 = ~“对不起，娜西拉。我相信你。”~
@102578 = ~“你这么了解她，也没什么值得奇怪的。”~
@102579 = ~“我不知道该不该继续让你跟我一块儿走。”~
@102580 = ~“不，我想你该离开了。”~
@102581 = ~“好，你可以跟着我。但是我会注意你的！”~
@102582 = ~“我相信你，娜西拉。”~
@102583 = ~“你能责备他们吗？”~
@102584 = ~“你为我们的敌人工作？”~
@102585 = ~“很高兴你现在能站到我们这边来，娜西拉。”~
@102586 = ~“所以你以前是个刺客。谁会去管呢？”~
@102587 = ~“往事就不要再提了，娜西拉。”~
@102588 = ~“红色姐妹？”~
@102589 = ~“你在谈论什么？”~
@102590 = ~“你是不是打算告诉我问题所在？”~
@102591 = ~“现在还不是最佳时机，娜西拉。”~
@102592 = ~“我们走。”~
@102593 = ~[德金]“鳞歌者伊谢利亚……”~
@102594 = ~“没事。没什么……”~
@102595 = ~“相信你自己，德金。”~
@102596 = ~“你很亲切，很有才能，很有趣。你不再需要我了。如果我死了，你会很好的。”~
@102597 = ~“我一定要帮它。走吧，我们的冒险还没结束。”~
@102598 = ~“把你的灵魂交出来，小子！”~
@102599 = ~“如果那意味着失去你，那么我不要。”~
@102600 = ~“是的，我确定。”~
@102601 = ~[瓦伦]“恶魔斗士奥斯卡辛……”~
@102602 = ~“刚才没事。”~
@102603 = ~“把你的灵魂交出来！”~
@102604 = ~“我要使你成为我永远的爱人！”~
@102605 = ~“所以我把你从这地狱的感染中解救出来了。”~
@102606 = ~“不客气。”~
@102607 = ~“很高兴你能喜欢它。现在把你的灵魂交出来。”~
@102608 = ~“如果那意味着失去你，那么我不要。”~
@102609 = ~“对不起，亲爱的，但这是为了我们。”~
@102610 = ~“是的。”~
@102611 = ~“好的。现在，作为报答，你成为我永世的爱人了。”~
@102612 = ~“好……也许不是。”~
@102613 = ~“你听到我了。”~
@102614 = ~“我们完成了。就在此刻。”~
@102615 = ~“你吓不倒我的。你的肉体和灵魂都已经归我了。”~
@102616 = ~“你发狂的时候真是太性感了。亲我一下！”~
@102617 = ~“那么说到底，我们已经没有希望了？”~
@102618 = ~“真的能感到什么不同吗？”~
@102619 = ~“我很高兴。你当然挣到它了。”~
@102620 = ~[艾瑞贝丝]“双魂瓦达莉亚……”~
@102621 = ~“没事。没什么……”~
@102622 = ~“你不用对无冬城的事情感到愧疚。”~
@102623 = ~“你说的没错。我不会再向你提起那件事了。”~
@102624 = ~“你不知道吗？你这就是在赎罪……这不是很好吗……”~
@102625 = ~“我只是不想看到你这么难过。”~
@102626 = ~“是的，艾瑞贝丝。冰冷的死亡……”~
@102627 = ~“把你的灵魂交给我吧！”~
@102628 = ~“如果这意味着会失去你，那么我拒绝。”~
@102629 = ~“是的，我保证。”~
@102630 = ~“我命令你铲除邪恶，而不是打击正义。”~
@102631 = ~“我命令你……爱我……”~
@102632 = ~“没事。别担心……”~
@102633 = ~“你不用对无冬城的事情感到愧疚。”~
@102634 = ~“把你的灵魂交给我吧！”~
@102635 = ~“如果这意味着会失去你，那么我拒绝。”~
@102636 = ~“是的，我保证。”~
@102637 = ~“我命令你铲除邪恶，而不是打击正义。”~
@102638 = ~“我命令你爱我！”~
@102639 = ~“就这些了，艾瑞贝丝。”~
@102640 = ~[娜西拉]“寻天者奎霏莉亚……”~
@102641 = ~“刚才没事。”~
@102642 = ~“把你的灵魂交出来！”~
@102643 = ~“如果那意味着失去你，那么我不要。”~
@102644 = ~“是的，我确定。”~
@102645 = ~“我要使你成为我永远的爱人！”~
@102646 = ~“你生气也没用。你的肉体和灵魂都已经归我了。”~
@102647 = ~“你发狂的时候真是太性感了。亲我一下！”~
@102648 = ~“原谅你自己过去的罪行吧。”~
@102649 = ~“我不会做任何伤害你的事情的，娜西拉。”~
@102650 = ~“我对这个已经很厌烦了！赶快处理好！”~
@102651 = ~“不要再叽叽喳喳说个不停了！我只想杀了靡菲斯特！”~
@102652 = ~“这我帮不上你，娜西拉。”~
@102653 = ~“你要学会原谅自己，娜西拉。”~
@102654 = ~“你应该及时学会原谅自己，娜西拉。”~
@102655 = ~“我会帮你度过这一关的，娜西拉。我爱你，还记得吗？”~
@102656 = ~“为什么你们两个总是打个不停？好吧，你们两个我都不爱！”~
@102657 = ~“原谅我……对不起，娜西拉，但是我爱的是艾瑞贝丝。”~
@102658 = ~“不要管我们了，艾瑞贝丝。我一直爱着娜西拉。”~
@102659 = ~“你们两个都是我的最爱。”~
@102660 = ~“为什么你们两个总是打个不停？好吧，你们两个我都不爱！”~
@102661 = ~“原谅我……对不起，娜西拉，但是我爱的是艾瑞贝丝。”~
@102662 = ~“不要管我们了，艾瑞贝丝。我一直爱着娜西拉。”~
@102663 = ~“你们两个都是我的最爱。”~
@102664 = ~“欢迎你，德金。”~
@102665 = ~“收割者总是在他的领域中提到它，别的就没什么了。”~
@102666 = ~“他是盟友。你只要知道这点就够了。”~
@102667 = ~“我不知道他是什么。也许是个恶魔？他就是个恶魔。”~
@102668 = ~“问够了吧。收割者是我们的盟友。你只要知道这点就够了。”~
@102669 = ~“不……不对。他提到过什么连接通道，不过我没听明白。”~
@102670 = ~“那个地方是个连接通道，收割者大概是这么说的。我没弄明白他的意思。”~
@102671 = ~“收割者说，他的领域是一个连接通道。它能通到很多地方，但不是说所有的地方都能去。”~
@102672 = ~“为什么你不亲自问他？”~
@102673 = ~“你吵够了没有？我正在试图找一条出去的路。”~
@102674 = ~“你对这个地方有什么了解吗？”~
@102675 = ~“作为九渊地狱的一层来说，这里似乎有点……冷，不是吗？”~
@102676 = ~“你一开始找到的线索是什么？”~
@102677 = ~“那很有帮助。如果不是你指出这一点来，我该怎么办啊？”~
@102678 = ~“我们一定要先把它找出来！”~
@102679 = ~“如果他们敢动一下，我就会把他们都宰了！”~
@102680 = ~“当我杀出一条通往主脑的路时，它就会和我谈判的！”~
@102681 = ~“我该怎么防护我的头脑？”~
@102682 = ~“你的思想该怎么办？”~
@102683 = ~“那我们应该都没什么问题了。”~
@102684 = ~“我无法想像你会是某人的奴隶。”~
@102685 = ~“你要当我的仆人？你是说为我做饭打扫？”~
@102686 = ~“这不是卓尔社会。那个男人正在看守这一带！”~
@102687 = ~“你这么专横也不足为奇。”~
@102688 = ~“够了。继续前进。”~
@102689 = ~“如果我需要你的建议，我会提出来的。”~
@102690 = ~“你生气的样子真可爱。”~
@102691 = ~“喔——你这人不但蛮横，戒心也很重。”~
@102692 = ~“我已经很注意这点了。”~
@102693 = ~“那并不是表扬。相信我。继续前进吧。”~
@102694 = ~“不，你就是很专横。”~
@102695 = ~“那确实是在*称赞*。我喜欢专横、不讲理的女人。”~
@102696 = ~“这个头盔能保护我。”~
@102697 = ~“我才不会怕几个僵尸！”~
@102698 = ~“你觉得神殿里有不死生物？”~
@102699 = ~“我已经烦透了你的抱怨了，卓尔！”~
@102700 = ~“不管我找到了什么，都会毁掉的！”~
@102701 = ~“别担心，在那里我会小心的。”~
@102702 = ~“你不觉得这像个陷阱吗？”~
@102703 = ~“那么，他们可能是奴隶。”~
@102704 = ~“我们站在这里的话，是不可能弄清楚这件事的。”~
@102705 = ~“我们必须要去调查清楚。”~
@102706 = ~“也许他们并不像看上去那样。”~
@102707 = ~“那又怎样？谁会去管呢？”~
@102708 = ~“如果你不能施法，那还有什么用处？”~
@102709 = ~“好。现在我们不用担心被敌人的法术杀死了。”~
@102710 = ~“一片反魔法区域？这怎么可能？”~
@102711 = ~“如果我们要去找的话，也许该多了解一下他们的情况。”~
@102712 = ~“也许是很久以前，某个被遗忘的种族把他们留在这里的。”~
@102713 = ~“走吧。我们越早找到眼魔暴君，事情就能越早解决。”~
@102714 = ~“怎么了？你害怕了吗？”~
@102715 = ~“这里面可能也有奴隶。”~
@102716 = ~“别担心，我会睁大眼睛的。”~
@102717 = ~“开个玩笑而已。放轻松点。”~
@102718 = ~“对不起……我没有其他意思。”~
@102719 = ~“我不需要你关心，卓尔！”~
@102720 = ~“我还没遇到过处理不了的状况。”~
@102721 = ~“并没有人说，这会很轻松的。”~
@102722 = ~“我现在要去地下城了。就这样了，除非你还想提些什么没用的建议。”~
@102723 = ~“我会当心的。”~
@102724 = ~“你觉得我很特别？我也觉得你很特别。”~
@102725 = ~“我会当心的。”~
@102726 = ~“那我们应该怎么穿过去？”~
@102727 = ~“你觉得这条河能够阻止瓦纱瑞丝的大军吗？”~
@102728 = ~“我能够照顾好我自己，卓尔。”~
@102729 = ~“看起来对我不坏。”~
@102730 = ~“这消息有些令人不安，不过我没事。”~
@102731 = ~“我还是不信任你，卓尔。如果你背叛我的话……”~
@102732 = ~“我会记住的。”~
@102733 = ~“谢谢你，娜西拉。有你的支持真是太好了。”~
@102734 = ~“你担心我？”~
@102735 = ~“有某种卓尔过来了吗？”~
@102736 = ~“我现在不想讨论这件事。”~
@102737 = ~“你可以跟着我。等死吧。”~
@102738 = ~“对。我们走。”~
@102739 = ~“不，现在不行。”~
@102740 = ~“你总是很容易死。这还真是个问题。”~
@102741 = ~“你擅于隐秘地行动。那就离战斗远些。”~
@102742 = ~“别担心。我不会抛弃你的，娜西拉。”~
@102743 = ~“娜西拉不会回答你的，艾瑞贝丝！”~
@102744 = ~“她说对了一点，娜西拉。”~
@102745 = ~“你们两个都给我闭嘴。”~
@102746 = ~“实际上，也许现在跟着你的人已经够多了。对不起。”~
@102747 = ~汤米疑惑地盯着你的同伴。“嗯哼。我不想扫你的兴，不过你已经凑够一对人了。等什么时候有空缺了，记得喊上我啊？”~
@102748 = ~“你需要我吗？”~
@102749 = ~---------- Random Pop-Ups Start Here ------------~
@102750 = ~他皱皱眉，有点担心地说：“随你的便。我可并不想你毫无防备地独自去面对强敌。”~
@102751 = ~“就那样。”~
@102752 = ~他点点头，四处看了看。“别花太长时间了。我不喜欢闲着。”~
@102753 = ~他点点头，四处看了看。“别花太长时间了，亲爱的。如果我们不在一起，我就保护不了你了。”~
@102754 = ~“那么，我会回到我们第一次加入的地方去。如果你改变想法了，就去那里找我。”~
@102755 = ~他轻轻地亲了一下你的脸颊：“我们会再见面的，亲爱的。注意自己的安全。”~
@102756 = ~他烦闷地皱了皱眉：“亲爱的，如果你确定了，那我只好遵命了。但我实在是不想离开你。”~
@102757 = ~“当然，亲爱的。”他避开了你的视线，放下心来。“但是只要你确定……”~
@102758 = ~“告诉我，我应该怎么做，我会尽力的。”~
@102759 = ~“那好。而且也能减少些痛苦，就用我‘解除’陷阱的方法吧。”~
@102760 = ~他挑起眉毛，张嘴笑着说：“如果你认为我能行，那就看看吧。”~
@102761 = ~他点点头：“无论如何，好像我实际上没有在避免侦测。”~
@102762 = ~“在战斗开始之前，都会很安静的。”~
@102763 = ~他傻笑了一下：“我不善于在阴影中前进，<CHARNAME>，但如果需要我帮助的话，我会尽量不踢到桶子的。”~
@102764 = ~“是那样。总之，我只会用蛮力砸锁。”~
@102765 = ~他耸耸肩。“如果需要的话，我可以试着把它砍开。那根本就不用干什么细活。”~
@102766 = ~“那你到什么地方找我？”~
@102767 = ~他点头表示同意，没有再说什么了。~
@102768 = ~他点点头。“不管你信不信，我冲进战场厮杀的时候最有劲了。”~
@102769 = ~“我会按照你所说的，跟着你走，并且注意你的后方。”~
@102770 = ~他二话不说，解下背包，交给了你。~
@102771 = ~“关于魔法方面的知识，我只知道一些深渊魔域中的传说。我可以看看你的物品，然后告诉你能不能认出一些来……不过我没什么自信。”~
@102772 = ~“我死后去到的那个半位面……我想知道，那儿有没有名字？”~
@102773 = ~“别担心，<CHARNAME>。我已经不关心那个了。”~
@102774 = ~“没事。现在不重要了。”~
@102775 = ~“谈话？”他看起来有些迷惑，好奇地看着你，“你想要讨论什么话题？”~
@102776 = ~“还有什么事要对我说吗？”~
@102777 = ~他耸了耸肩道：“我很好。我刚才突然有一种冲动，想杀了和我有关的所有人，不过现在没事了……我毕竟是个有着恶魔血统的泰夫林。”~
@102778 = ~“你还想讨论别的什么事情吗？”~
@102779 = ~瓦伦对你热情地一笑：“女士，你没有错。是你没有和我在一起的时候。”~
@102780 = ~“没什么。让我们尽快结束这事吧，好不好？”~
@102781 = ~“说实话，我想念诸位面。我想念印记城。我已经很久没有走在那弯曲的街道上了。”~
@102782 = ~“我的血统……有时候很难压制那恶魔般的冲动。但是，你不用担心这个。”~
@102783 = ~“如果这个结束了，我会很高兴的，但现在我也很好。”~
@102784 = ~“错误？我没有发现。取得那个资格是错误的吗？我真的不想再下次战斗中打错目标。”~
@102785 = ~“我的伤微不足道。没什么可担心的。”~
@102786 = ~“我受伤了，但不是很严重。我们不需要停下来。”~
@102787 = ~“你看到了，我受了重伤。也许应该治疗一下我？或者休息一小会儿？”~
@102788 = ~“毒素在我体内发作了。”他变得很不安。“我不知道能不能战胜它。”~
@102789 = ~“我染病了……我感到它正在侵食我。我需要你的帮助。”~
@102790 = ~他思考着你的问题。“我不太肯定。我记得有一次我回到了地表，继续在先知的神殿供职。也许我记错了。”~
@102791 = ~“我想要探索你们的世界。我在一个地方呆得太久了，没见过什么世面。也许我就应该从深水城开始。”~
@102792 = ~“最后我想会印记城去。从很小的时候开始我就没有见过了……我怀念那荣耀的城门。我想念异界的人们，还有在街头漫步的那些生物。”~
@102793 = ~“但我总是把旅行的事情往后推。和你们一起战斗我感到很愉快，<CHARNAME>。我们合作得很好。”~
@102794 = ~“哦？我和娜西拉当然相处得来。为什么不可以呢？真的，我很高兴看到你们两个真心相爱。”~
@102795 = ~“也没人问我是不是想当第三者，不是吗？”~
@102796 = ~“你反对？我可以在你们睡觉的时候哼小夜曲。嘿，娜西拉！想想我们一起经历的冒险！”~
@102797 = ~娜西拉笑了笑，尽管她试图把笑容掩藏起来。“好吧，”她不情愿地承认道，“我想那也不会太糟。只要<CHARNAME>同意就行。”~
@102798 = ~“看见没有？事情都已经定下来了！那我们赶快完成这次冒险，迎接新的挑战吧！”~
@102799 = ~“太好了！朋友，在你身边，我能遇到许多激动人心的冒险！”~
@102800 = ~瓦伦笑了起来：“那就让我们暂时一起旅行吧。我们可以看看事情是如何发展的，对不对？举例来说，在你身边，我能遇到许多激动人心的冒险。”~
@102801 = ~“但是在我们四处周游之前，还有许多事情要完成，不是吗？最好现在就开始继续做吧。”~
@102802 = ~他转过来，对着你热情地笑着。“当然了，如果女士愿意我留在她身边的话，那这些都等于没说。”~
@102803 = ~他拱了拱眉毛，向你致意：“谢谢你，不用了。这次冒险结束的时候，我宁愿自己一个人去旅行，<CHARNAME>。我对你并没有恶意。”~
@102804 = ~他看看你，笑了起来。“真的？这个有趣的邀请值得好好的考虑，<CHARNAME>。”~
@102805 = ~他热情地笑了笑。“真的，亲爱的，我会陪你到天涯海角的。你喜欢这样吗？”~
@102806 = ~他耸了耸肩，保持着笑容。“如你所愿。我会尽量把时间花在你身上的。但如果我们有时候能够偶遇，我也会很高兴的。”~
@102807 = ~他热忱地笑着说：“不，也许不会。而且我对那件事情感到很高兴，女士。”~
@102808 = ~他笑了笑，轻轻地用手拢住你的脸颊。“很好。我已经别无选择了，女士。”~
@102809 = ~他笑着说：“女士，我不是。因为和你在一起，我才赢得了这一切。不过也仅此而已，真的，没别的了。”~
@102810 = ~“但我很在意一件事情，女士……你认为我们两个的将来会是什么样的？你想到结婚了吗？小孩呢？”~
@102811 = ~他尴尬地笑了笑。“我知道，我知道……我想得太远了。好，那想些恰当的。”他对你笑了笑。“但是我永远都不会放弃的，亲爱的。”~
@102812 = ~他握住了你的手。“但是还有很多事情要做。比如说，我等不到这件事情结束了，我们的生活应该开始了。”~
@102813 = ~他笑了笑。“哦？那很好，亲爱的。现在，能像这样在后面追逐着你，我感到非常快乐。”~
@102814 = ~他点点头。“我应该有所怀疑的。很好，我很高兴和你共度时光。关于将来的事情可以先放到一边。”~
@102815 = ~他点点头，耸了耸肩。“就是这样。我保证，我们会一直在一起的。最重要的事情就是我们能够在一起。”~
@102816 = ~“知道有那样的可能性真是太好了。我很满意。不管是什么，都让它来吧。”~
@102817 = ~他想了一下。“我想问题从来没有想过这么久。我喜欢小孩，”他看着你笑，“*你*的小孩，不过，现在谈这个是不是还太早了？”~
@102818 = ~他又笑了笑。“哈！就在这里？那太迷人了，我情愿等待恰当的时机再做。”~
@102819 = ~“总的来说，实际上我对这个世界并没有花太多的时间。我早年过着乱七八糟的生活。我有过一些……不幸的遭遇。”~
@102820 = ~他叹了口气。“我遇到的第一伙人是一个聪明的食人魔法师带领下的一群大地精强盗。她立刻就看出来，我对这个世界所知甚少。”~
@102821 = ~“她骗我说，她和那些大地精是和邪恶猎人战斗的自由战士。”~
@102822 = ~“你能这么说太好了，但并不是这样的。在这些位面里，生物一般都不会以真面目出现。食人魔应该是一种邪恶的生物，但是你们行为却和我知道的一样。”~
@102823 = ~“总之，”他抿了抿嘴，“它所谓的‘邪恶猎人’其实是一名圣武士。”~
@102824 = ~“啊哦，当然。我们打了一架，我差点杀了那个人。幸好我在对他做出致命一击之前问了他一个问题，才意识到了事情的真相。”~
@102825 = ~“当然，那是我唯一能做的事情。我被迫把两边都干掉了。”~
@102826 = ~“我杀圣武士的时候感觉很糟糕，但我别无选择。他不能原谅我的攻击。他认为我是邪恶的。我不得不在他恢复过来之前杀了他。”~
@102827 = ~“我对遇到的其他人也存在相似的难处。我认为我在印记城生活的经验根本就用不上，有时候还会帮上倒忙。真是令人惊讶。”~
@102828 = ~“只有那次我接近先知的时候，才有安全感。她和她的卓尔伙伴正在躲避地表人，所以我有幸见到了几次。”他耸了耸肩。“也许是命中注定的。”~
@102829 = ~“不，那是真的。我也不希望的。”~
@102830 = ~“希望如此。好像我一直都这么浮躁。”~
@102831 = ~“也许不是，我不想让人们害怕我。我会尽我所能的。”~
@102832 = ~“我觉得你这个玩笑开得不怎么样。毕竟，我要做那些正确的事情。”~
@102833 = ~“别光说我的事情了。谈谈我们的旅行吧。”~
@102834 = ~“他不打算原谅我的攻击。他把我当成邪恶的了。所以除了在他恢复过来之前杀了他，我也没什么别的选择了。”~
@102835 = ~“你听起来像是在审判。我说的是实话，那个圣武士不准备原谅我的攻击，而那些大地精是该死。这就是我的看法了。”~
@102836 = ~“不是我的错，<CHARNAME>！在这些位面里，生物都和看上去的不一样。食人魔应该是邪恶的……但是我不知道你们是不是也像那样。”~
@102837 = ~“是不容易。经历了数个月的痛苦之后，我终于不和其他人打了。”~
@102838 = ~“哥利马杉把我关在深渊魔域里的一座塔内。他在那里放了许多……贵重物品。他有时会对这些物品感到非常吃惊。我只是用来展示的一件财产。”~
@102839 = ~“我想我该感谢他把我弄到那个地方去。那里最后由于一件非常有魅力的东西而遭到了攻击。”~
@102840 = ~“好像是一个巴特祖发起了攻击。但他是归另一个巴洛炎魔管的塔那厘犯人。他们对我不感兴趣。”~
@102841 = ~“不，他们是为其他更重要的物品来的。他们击退了哥利马杉的守卫，把那塔给毁了。我的牢门也开了，于是我逃了出来。”~
@102842 = ~他轻轻地笑了笑，道：“首先，我还是要找到一条从深渊魔域出去的路。要是被哥利马杉发现了，他一定不会轻易放我走的。”~
@102843 = ~“当然，很明显的。尽管花了好几个月的时间，最后终于还是找到了先知。而且她早就料到是我了。”~
@102844 = ~他望向远方，眼神变得平静了。“她重新唤起了我的人性。在这一点上，我永远都会感激她的。”~
@102845 = ~他皱眉沉思道：“如果你没有经历过的话，就没有发言权。我经常害怕会突然丧失人性，变回到在深渊魔域时的样子。”~
@102846 = ~“那个地方寒冷而荒凉，<CHARNAME>。我想当一个好人。我也愿意为此而死。”他突然转过身去，“我的闲话就扯到这里，让我们继续行动吧。”~
@102847 = ~“那个地方又冷又荒凉，女士。我想当一个好人。我想就那样死去。”~
@102848 = ~他面无表情地对着你看了一会儿，然后耸了耸肩：“也许我什么都不是。但是他们不会让我得到片刻安宁的。”~
@102849 = ~“走，”他开始动身了，“我们得赶快行动，不然就晚了。”~
@102850 = ~他眉头紧皱。“你是这么想的？我渴望和平，女士。也许有一天你也会发现的。”~
@102851 = ~瓦伦没有立刻看你，但他的眼中忽然饱含感情。他缓缓地点了点头，向你表示感谢。~
@102852 = ~“你太善良了，女士。我想我现在做得还不够好，但我会努力的。也许有一天我会得到大家的钦佩——”他停了下来，脸有些红，想要避开你的目光。~
@102853 = ~“请原谅我的冒失，女士。”他平静地说道，“我想，我们继续前进吧。”~
@102854 = ~瓦伦没有立刻看你，但他的眼中忽然饱含感情。“对，我……有时候是这么想的。”~
@102855 = ~“还有些时候，我想能不能找到一个女人——”他突然停了下来，脸有些红，把头转了过去。~
@102856 = ~“可能吧。”他皱了皱眉，“但有好多次，我怕我会完全失去控制。就像在深渊魔域里的时候一样。”~
@102857 = ~“有时候。”他皱了皱眉，“我作战的时候，就怕会永远地陷入狂暴中。就像在深渊魔域里的时候一样。”~
@102858 = ~“巴洛炎魔也是可以被其他的恶魔或是魔王之类打败的。如果你武器的附魔程度够高的话，就可以打破他们的防御。用力攻击就行了。”~
@102859 = ~“难道我以前没有说过？是的，没错，有许多次。但我已经不再是会被他随便抓到的小孩了。”~
@102860 = ~“他把每一个下属都弄死了。当轮到哥利马杉来找我的那一天时，却是他被毁灭了。那真是美好的一天啊。”~
@102861 = ~他冷笑道：“我认为那是哥利马杉气数已尽了。”~
@102862 = ~“一开始不是。首先，我得找到从印记城到这里的路……然后还要找到先知。当你对周围一无所知的时候真是举步维艰啊。所以这花了我好多年的时间。”~
@102863 = ~他看起来有些害羞。“我不清楚。”~
@102864 = ~“我参加血战的时候就是一个头脑简单的战士。过了这么久，我只能记起一点点了。”他心不在焉地碰了碰自己的角。“我的恶魔血统让别人很难猜到我的真实年龄。”~
@102865 = ~“每个位面都有出去的路，但你要知道去哪里找。有一些出入口是天然的，有一些古老的则已经被人遗忘，还有些新的……我决定要找到一个，最后我做到了。”~
@102866 = ~“一个好像在和哥利马杉竞争什么东西的恶魔答应让我使用她的通道去印记城，”瓦伦在这里停了一下，脸红了起来，“作为交换……呃……她要我帮一个忙。”~
@102867 = ~他的脸越来越红，最后终于把头转了过去。“我真的不想再说了。”~
@102868 = ~他还是没能憋住，大声地笑了出来：“你真是个坏女人，<CHARNAME>。我说的是很正经的事情。”~
@102869 = ~他好奇地看着你。“你想听我战斗时的事情？无论是哪种战斗的？”~
@102870 = ~他沉思了好长一段时间，最后耸了耸肩道：“讨论我的过去并没有什么坏处，你尽管问吧。”~
@102871 = ~瓦伦轻声笑着。“嗯，其实那比我想像的还要简单得多，<CHARNAME>。我们继续前进吧？”~
@102872 = ~瓦伦转过来看着你，脸上露出震惊的表情。“那……那是个人隐私问题，女士。”~
@102873 = ~他沉默了一会儿，最后点点头。“是的。就一次。”他看着你，“她死了。”~
@102874 = ~他点了点头，然后转过脸去。“我觉得你对我了解得已经够多了，女士。继续前进吧。”~
@102875 = ~“她是我主人在深渊魔域里的一名人类仆人。他拷打我的时候，把她带到我的面前，然后……把她杀了。”~
@102876 = ~他闭上了眼睛，皱紧了眉头，道：“那样是为了增加我的痛苦，它确实起到了效果。不过那是很久以前的事情了。”~
@102877 = ~他温和地笑了笑，没有看着你，而好像是在脑中回忆什么画面。“不。从那以后就没有其他人了。但我在前进……不过再也不会有其他人了。”~
@102878 = ~“如果我们……能换个话题，女士。我会很感激的。”~
@102879 = ~“很好。那么走吧。还有很多事情要做呢。”~
@102880 = ~他缓缓地摇了摇头，叹气道：“不。我永远也忘不了她。不提了，继续前进吧。”~
@102881 = ~“根本就没有机会，女士。我已经受了好几个月的折磨了，伤得很重，身体非常虚弱。我当时实在是无能为力。”~
@102882 = ~一丝痛苦划过瓦伦的脸上，但他立即恢复了平静，慢慢地点了点头。“谢谢你，女士。就算到现在，我还是不想再提起她……”~
@102883 = ~他思考这个问题的时候，脸部的表情很僵硬。“说实话，我不知道。好多次我都想一死了之。我也试了好几次。不过都没有成功。”~
@102884 = ~“也许活这么长时间，最后从哥利马杉手中逃出来，就是我的命运。我也不去多想这个问题了。”~
@102885 = ~他的脸突然僵住了。“如果你要这么说的话。”~
@102886 = ~他对你点点头。“很高兴为你服务。”~
@102887 = ~他笑得有些腼腆。“谢谢你，女士。你真是个大好人。”~
@102888 = ~“我想最好别去试。老是想那些神秘的东西，活得太累了。”~
@102889 = ~“神经常会介入凡人的生活，所以那也是很有可能的。但如果他们以为我会为此而献身的话，那他们就犯了可悲的错误。”~
@102890 = ~他冷笑道：“深渊魔域里都是军团作战的。有着和我一样经历的武士不计其数。但很少有人能像我一样幸存下来。”~
@102891 = ~“你要知道，在印记城的街道上，我就是个小孩。我妈死了以后，我就成了孤儿，以行窃为生。”~
@102892 = ~“你想问什么就问吧，<CHARNAME>。”~
@102893 = ~“在印记城里，有恶魔，有魔鬼，还有其他许多生物。那都是很普遍的现象。有一天一个名叫哥利马杉的恶魔发现了我。”~
@102894 = ~“他发现我有恶魔的血统，于是把我抓了去。我没法逃掉。我想我还得感谢他认出了我，不然很可能会被他当成那天的点心了。”~
@102895 = ~“当然。那是很久以前的事了，那时我除了掏包的本领一流之外，就没什么其他的本事了。”~
@102896 = ~他点点头。“印记城是个残酷的地方，对小孩也不例外。我多数时候都填不饱肚子，饿死只是迟早的事情。”~
@102897 = ~“你愿意的话，就尽管审判我吧，但是在印记城里，每个人有每个人的求生之道。就算是那样，我大部分时候都是饿着肚子的。饿死只是迟早的事情。”~
@102898 = ~他的眼神变得悲伤起来。“她被一名顾客杀害了。反正别人是这么告诉我的。”~
@102899 = ~“我母亲在一名非常贪婪和自私的女恶魔手下干活。据我所知，我母亲因为生病而有一个月没完成任务，那个女恶魔就杀了她。”~
@102900 = ~“那个女恶魔讨厌凡人的脆弱。”他回忆的时候眉头紧蹙。“而且更不喜欢我。我母亲死了才不到一个小时，我就被撵了出来，无家可归了。”~
@102901 = ~“也许吧。但是那里非常非常糟糕。但是印记城比那还要糟糕得多。”~
@102902 = ~瓦伦耸了耸肩。“我不需要。她很快就遭人毒手了。印记城就是这么个残酷无情的地方。”~
@102903 = ~他点点头，道：“这在印记城里只不过是件很小的事情。那是个残酷的地方。”~
@102904 = ~他的表情很痛苦。“我不想说了。”他脸红了一下，“可以说她从事的是非常古老的职业。”~
@102905 = ~“谢谢你，<CHARNAME>。但我们并不是很亲近。事实上我几乎想不起她了，但我还是不希望她死在别人手里。”~
@102906 = ~他笑了笑说：“印记城是诸位面中最有名的城市，有时候又被称作伟大的门城。它的街道上有着来自各个位面的行人。”~
@102907 = ~“印记城的大多数公民如果知道你对他们一无所知的话，肯定都会怒不可遏的。那是个奇怪的地方，美丽、可怕和危险共存。”~
@102908 = ~他想了一会儿，然后耸了耸肩道：“很好。如果那能使女士你高兴的话，我很愿意再讲几个故事。你想听什么呢。”~
@102909 = ~“我不确定。先知的追随者们都很乐意接受我，但是其他人就……他们瞧不起卓尔以外的种族。对我也不例外。”~
@102910 = ~“他们开始根本就不听我说。”瓦伦的脸上掠过一丝笑意，“但是我有办法让那些卓尔听我的话。”~
@102911 = ~“说来也奇怪，没想到我不依靠恶魔血统，也很有领导力。”他好像突然意识到了自己失言，停下来小心地看了你一眼，“你知道……什么是泰夫林吗？”~
@102912 = ~他腼腆地笑了笑，下意识地用手摸了摸自己的犄角。“噢，你是在开玩笑吧，女士……”~
@102913 = ~他面露尴尬。“谢……谢谢你，女士。你真是……太善良了。”他突然清了清嗓子，“但是……你知道我的真实身份吗？”~
@102914 = ~“我的母亲，”他慢慢地说道，“生了个拥有一半人类和一半恶魔血统的孩子。这使我看起来像个恶魔。”他的眼神变得迷茫起来，“这没有给你造成烦扰吧？”~
@102915 = ~他点点头，看起来好像有些困惑。“那……我的恶魔血统没有给你造成烦扰吧？”~
@102916 = ~他面无表情地转过头去。“我知道。如果我离开，你是不是会觉得舒服些？”~
@102917 = ~他停下来，想了一会儿，最后点了点头。“我保证，那不是什么大问题。”~
@102918 = ~“现在我在什么地方？哦，对了。我想，卓尔认出了我有部分恶魔的样子。我好像能散发出一种令人恐惧的情绪，他们也没怎么多看就走开了。”~
@102919 = ~“由于我对他们的尊重，所以当我第一次指挥他们对抗瓦纱瑞丝的时候，他们都很服从命令……”他摸了摸下巴，考虑了一会儿，“那是三个月以前。不过那令人永生难忘。”~
@102920 = ~“没有什么好的词语能形容卓尔之间的交锋。它并不是两支军队在开阔的平地上互相厮杀。”~
@102921 = ~他考虑用什么词语来形容。“那就好像……两团巨大的阴影无声地碰在了一起。一队刺客伴随着死亡魔法直探对方喉舌……”~
@102922 = ~“我们对初战毫无准备，瓦纱瑞丝的军队在各个方面都占有压倒性的优势。我们失去了三个家族的盟军以及先知挑选出来的将军，之后我好不容易才带领部队撤退了。”~
@102923 = ~他停下来，想了想你的话，最后点点头。“事情根本就没那么简单。我们节节败退，我只能保存实力。事情大概就是这样的。”~
@102924 = ~“所以我们逃跑了。我尽可能地把大家集合起来，而瓦纱瑞丝却步步紧逼，一直把我们追到卓尔的地盘之外才罢休。”~
@102925 = ~他停下来，想了想你的话。“不，”他严肃地说道，“我确实从来没有带领他们打过胜仗。根本就不可能取胜。”~
@102926 = ~“我们逃跑了，”他重重地叹了口气，“我尽可能地把大家集合起来，而瓦纱瑞丝却步步紧逼，一直把我们追到卓尔的地盘之外才罢休。”~
@102927 = ~“就算在立特米亚撒，我们也不安全。和先知告诉你的一样，我们只是在瓦纱瑞丝攻来之前，在这里苟延残喘。所以我们会这么绝望。很少有人会抱有先知那样的希望。”~
@102928 = ~他耸了耸肩。“很好。不管怎样，对于我们这支希望渺茫的部队来说，确实是个令人愉快的故事。”~
@102929 = ~他意味深长地看着你。“在第一次战斗的时候，我尽量让他们活着逃出去，仅此而已。我真的不愿意再见到他们了……我看到会很难过的。”说到这里，他突然停止了交谈。~
@102930 = ~他缓缓地点了点头，脸上空白的表情无法掩饰受伤的自尊心。“如你所愿。我会回到我们见面的地方去的。”~
@102931 = ~他的脸僵住了。“它……使我充满了对暴力的渴求。一种我一辈子都要去克制的欲望。”~
@102932 = ~他严肃地点了点头。“谢谢。我保证，那不是个问题。”~
@102933 = ~瓦伦看起来被你的反应震住了，好像以前从没有遇见过。他慢慢地笑道。“你……非常迷人，女士。”~
@102934 = ~他过了一会儿才笑了笑作为回应，好像对你的回答很不习惯。“谢谢你，<CHARNAME>。我……很感激。”~
@102935 = ~他过了一会儿才笑了笑作为回应，好像对你的回答很不习惯。“不。它真的不应该的。”~
@102936 = ~“暂时是这样的。”瓦伦的脸上露出了一丝微笑。“我有办法让卓尔听命于我。”~
@102937 = ~“先知很关心他们的情况。她担心，一旦瓦纱瑞丝的计划成熟，恐怕会有什么事情发生在我们身上。”~
@102938 = ~瓦伦的脸上笼罩着一片阴影，他蹙眉沉思。“我怕先知会有什么意外。”~
@102939 = ~“我的事情也讲得差不多了，<CHARNAME>。也许我们该继续完成眼前的任务？”~
@102940 = ~瓦伦耸了耸肩。“说实话，我只是对你的信仰有一点好奇。在你们的世界里，许多人都崇拜一位神或是女神……你也是那样的吗？”~
@102941 = ~瓦伦沉思了一会儿，然后看了看你，脸上露出了不情愿的表情。“首先，我想说件别的事情。我误会了某件事情……是关于你的。我向你道歉。”~
@102942 = ~他盯着你看了一会儿，脸上的表情说明他对你半信半疑。“如果你想说的话，请不要谈论有关我的话题。我们可以说说先知。”~
@102943 = ~“你想更进一步的了解我？不如先从你开始吧？”~
@102944 = ~瓦伦皱了皱眉，仔细斟酌下一句话该怎么说。“我想知道，”他开口了，“是什么使你这么特别？”~
@102945 = ~“如果我们不去阻止的话，魔王会毁了深水城的。如果你还想讨论什么，请抓紧时间。”~
@102946 = ~“这点没什么可说的……亲爱的。”说最后一个字的时候，他好像有一丝厌恶。~
@102947 = ~瓦伦眉头紧锁，点了点头，没有说什么。~
@102948 = ~他点点头，看上去不太舒服。“请告诉我什么时候比较合适，<CHARNAME>。我们可以到那个时候再谈。”~
@102949 = ~“这个……对我来说并不容易。”你注意到，他的表情很痛苦，眼睛也泛出红光。“我呆在这里的时间越长，我的血液就越容易沸腾。”~
@102950 = ~他突然转向你，好像差点控制不住自己。“别那样，<CHARNAME>！我……我快控制不住自己了。”~
@102951 = ~“我和你说过血战的事情了吗？我身体里的塔那厘血统呼唤我去毁灭所有的巴特祖。”他用手擦了擦前额，“我不知道这里的魔鬼为什么不袭击我。”~
@102952 = ~他做了几次深呼吸，慢慢地平静了下来。“你这不是在帮忙，”他咆哮着。“我向你保证，我会尽力的……”~
@102953 = ~他做了几次深呼吸，慢慢地平静了下来。“我正在努力，<CHARNAME>，相信我……我想我能办到的，尽管这件事并不简单。”~
@102954 = ~他做了几次深呼吸，慢慢地平静了下来。“是的……我确实感到很惊奇。也许你不该只根据名字，来推断靡菲斯特所在的地方。”~
@102955 = ~他做了几次深呼吸，慢慢地平静了下来。“我……相信是这样的。虽然并不轻松，但我想我能控制住自己的。”~
@102956 = ~“如果你能让我留下的话……那就更好了。”他眉头紧蹙，“我保证不会再惹出什么麻烦了。”~
@102957 = ~他冷冷地点了点头，道：“如果……你决定了的话，那我们只好分开了。我会尽力找到出路的……但至少我不会妨碍你们的任务。”~
@102958 = ~他转身离开了你。“那就这样吧。祝你好运，<CHARNAME>。很遗憾，我不能坚持到最后了。”~
@102959 = ~他转过头去，身体很僵硬。“那就这样吧。祝你好运，亲爱的。很抱歉我不能陪你到最后了。我其实非常想的……”~
@102960 = ~他点点头，冷冷地笑道：“我想我应该表示感谢。我感觉，如果我不在你的身边，那就和死了没什么区别。”~
@102961 = ~他腼腆地对你笑了笑说：“女士，我很高兴能听到你这么说。如果有选择的话，我绝不会离开你的。”~
@102962 = ~他深深地叹了口气，看向前方的道路，道：“那继续前进吧，找到一条出路。我没事的……相信我。”~
@102963 = ~他紧紧握住你的双手，闭上眼睛，想要从你身上获得力量。一会儿之后，他睁开眼睛，亲了亲你的双手，对着你微笑。~
@102964 = ~“谢谢你，女士。我们……继续寻找出路吧。我没事的。”~
@102965 = ~瓦伦僵住了。“你不需要。很明显是我的错，我什么都不该对你说的。”他朝前面做了个手势。“继续前进，尽快脱离这个地方。”~
@102966 = ~瓦伦的眼中冒出了愤怒的火光。“是那样的？就算你不关心先知或是卓尔，那么地上的那座城市呢？靡菲斯特此刻可能正在破坏着深水城。”~
@102967 = ~“至少知道了有好处。那我们要找到一条出路，尽快赶上靡菲斯特。”他痛苦地转过脸去。~
@102968 = ~“我很羡慕你。”瓦伦痛苦地转过脸去，“继续前进吧。就算你不管，但我还担心着我的人民。”~
@102969 = ~“听到你这么说，我很高兴。你是一位勇士，同我以前见过的都不一样。能与你并肩战斗，我感到很骄傲。”~
@102970 = ~他点点头，道：“那没错。我承认，我以前认为，要打败一个魔王是不可能的事情。但是看到你们，我忽然觉得，我们一定会胜利的。”~
@102971 = ~瓦伦朝前面做了个手势。“我们继续前进吧。我们要征服这个位面，然后去面对魔王。胜利离我们不远了。”~
@102972 = ~“我想我们的关系不止是战场上的同志这么简单吧。我这个人朋友很少，但能认识你这个朋友，我感到很自豪……当然，如果你愿意的话。”~
@102973 = ~他失望地看着你。“哦？我想……”他突然耸了耸肩。“别在意我的想法。很明显是我搞错了。我不该提起来的。”~
@102974 = ~瓦伦痛苦地转过脸去。“我……我不这么认为，女士。如果我说你不迷人，那明显是在说谎，只是……但我看不到我们的将来。对不起。”~
@102975 = ~“我什么都不该说的。我不是要暗示那个……”他叹了口气，转过头去。“我惹你生气了。不提那事了。我们……继续前进。”~
@102976 = ~他悲伤地看着你，伸出一只手，轻轻地抚摸着你的脸颊。“我希望我的感受有所不同，女士。”他尴尬地转过头去。“也许我们该……继续前进了。”~
@102977 = ~他温柔地笑着，向前倾过来，吻上了你的嘴唇。这个吻持续了很久，里面包含着某种承诺。~
@102978 = ~“我必须承认，”他开始说道，“我只是对你的信仰感到好奇。在你们的世界里，许多人都崇拜一位神或是女神……你也是那样的吗？”~
@102979 = ~他看了看你，似乎有些困惑。“不，根本不。我使它看起来像那样吗？如果是的话，那么我道歉。我并不是有意冒犯的……我只是想知道你是不是一位信徒。”~
@102980 = ~他点点头。“我知道。也许那样很糟糕，我总是认为，对于你们那个世界的人来说，有信仰是一件好事。我觉得自己没有这种资格。”~
@102981 = ~他点点头。“我知道。据我对你们世界的观察，有信仰是一件好事。但我觉得自己没有这种资格。”~
@102982 = ~“我在诸位面间的时候，总把自己当成某个伟大存在的一部分，或者说我能听到他们。我知道他们中有许多已经堕落或是死去了……还有的甚至葬身在凡人手中。”~
@102983 = ~“对我来说，这些太熟悉了……这是私人途径获得的荣誉，尽管我知道他们有能力授予别人。”他瞥了你一眼。“我希望这没有冒犯到你。”~
@102984 = ~他点点头。“你当然是对的。我不想探讨这么高深的话题。我向你道歉。”~
@102985 = ~“很好。我发现你们世界里的人想法都很接近，很难和异位面的人进行沟通。很高兴你不是那样的。”~
@102986 = ~“先知常和我说起伊丽思璀，她所信仰的卓尔女神。”他皱了皱眉，“但我不能认同。我知道她也没有对我抱希望……”他无奈地叹了口气。~
@102987 = ~“我血统中一部分相信，我能很好地融进这个世界里。而另一部分总是说，我毕竟是个异界神侍，不要妄想改变了。你怎么看呢？”~
@102988 = ~他想了一会儿，道：“不，我不这么觉得。”~
@102989 = ~他缓缓地点了点头。“我明白你的意思。我想，你们的世界里也有许多值得热爱的事物……不过我见得太少了。我甚至连一座真正的城市都没见过。”~
@102990 = ~他缓缓地点了点头。“我想你是对的。但要在一座奇怪的岛屿上永远当一个陌生人是很困难的。我梦想有一天能见到一座城市。”~
@102991 = ~他缓缓地点了点头。“我想这次我能对你们的世界有更进一步的了解了。有一个难处就是，我至今为止还没有见过一座城市。”~
@102992 = ~他突然看了你一眼，好像有了主意。“你们的这座深水城，也就是瓦纱瑞丝正在进攻的城市……也许当你们回去的时候我可以加入你们。你们能够接受吗？”~
@102993 = ~他咧嘴一笑道：“好极了。能有一名熟悉那里的向导真是太幸运了。我很期待啊。”~
@102994 = ~“走，”他催促道，“继续前进吧。我可不想再对着你喊了。”~
@102995 = ~他咧嘴一笑道：“我也很喜欢，女士。你能给我看看吗？也许那能使我对你有更多的了解。”~
@102996 = ~“噢，”他好像受到了什么伤害，不过很快就恢复了正常。“足够了。我想，我以后可以独自去某些地方旅行的。”~
@102997 = ~“噢，”他好像有些垂头丧气。“我想在到了那个城市之后能有一位向导。”~
@102998 = ~“因为我尊重你的选择。还有什么？”~
@102999 = ~他皱了皱眉：“好吧，我不是故意要用这个小问题来刁难你。”~
@103000 = ~“力量是一个相对的而言的范畴。有些存在比神还要强大。痛苦女士掌管着印记城并将所有神祇拒之门外，但她自己却不是一个神，也没有任何信徒敬拜她。”~
@103001 = ~“嗯……不。我像其他人一样知道自己在说什么。但我们的经历有着很大的差别。在诸位面中成长的人会有一种独特的视角。”~
@103002 = ~他点点头。“是的，没错……我早该想到。可能还是因为我没有仔细注意过你的行为。不过，我想我没有你那么坚定的信念。”~
@103003 = ~瓦伦叹了口气，有些不情愿的斜了你一眼。“我过去搞错了一些事情。我该向你道歉。”~
@103004 = ~瓦伦愣了一会儿，皱紧了眉头，瞪着你说。“糟透了。不管你喜欢还是不喜欢，无论如何你都要得到它。”~
@103005 = ~他沉思了一会儿，显然是在脑海中盘算着要如何措辞。“自从先知预言了你的到来，我就对你心存芥蒂。”~
@103006 = ~“我想……我想那大部分是因为我自己想成为保护先知安全的人。我已经为救助反抗军努力了这么久，我不想有人横插进来抢走这一切荣誉。”~
@103007 = ~“所以我说服自己，或许先知的预见错了，你根本不值得信任。但你却一次又一次的证明了自己。我……我非常抱歉。”~
@103008 = ~他看起来有些退缩。“你是什么意思？”~
@103009 = ~他瞪着你看了很久。“原来你根本就没打算认真对待我。那么好吧。继续前进，先别管这个了。”~
@103010 = ~最后，他向你鞠了一躬，一丝笑容掠过他的嘴边。“当然，你是正确的，女士。我谦恭的请求收回我的话。你能够原谅我吗？”~
@103011 = ~他吃了一惊，脸一下子红了。“呃……女士，你是在开玩笑吧？”~
@103012 = ~他轻轻的笑着，仍然红着脸。“那么，我……我该把这当作是某种意义上的原谅，对吗？”~
@103013 = ~他深深的叹了口气，转了转眼珠子。“如果你坚持，”他咕哝着。他转向你，正式的鞠了一躬，“<CHARNAME>，我为自己如此草率地对你做出判断感到万分的抱歉。你能够原谅我吗？”~
@103014 = ~“我很高兴，”他微笑着说，“在这趟旅途中，能和你站在一起战斗真是太好了。我开始相信，或许我们真的能够打败瓦纱瑞丝了。”~
@103015 = ~“但是，我觉得我该提醒你……她可能并不是我们真正的敌人。她抓住了一个魔王做俘虏，但实际上魔王要比她还更强大。”~
@103016 = ~“很少。可是，我以前的主人叫做哥利马杉，是个可怕的巴洛炎魔，是最强大的塔纳厘魔族之一。可他的能力与瓦纱瑞丝所控制的那种魔王比起来，根本就不值一提。”~
@103017 = ~“我这么说是因为，也许他才是使瓦纱瑞丝拥有如此力量的主要原因。如果我们能查出她是怎样控制他的，然后打破这种控制，那么我们或许就有机会。”~
@103018 = ~“但是，在没有掌握更多情况之前，讨论这个或许是毫无意义的。我们继续前进吧。”~
@103019 = ~他向后退了一步，吃惊地看着你。“什……什么？你什么意思，<CHARNAME>？你*打算*要背叛我们？”~
@103020 = ~“我想你是对的。我还是不该这么快就对你下结论。你能够原谅我吗？”~
@103021 = ~他瞪着你看了很久。“我想起了我们并肩作战的时候……不，没什么。你喜欢无拘无束。我们继续前进吧。”~
@103022 = ~他瞪着你看了很久。“我想起了我们并肩作战的时候……不，没什么。起码我现在知道了。显然我没有想像中错得严重。”~
@103023 = ~他慢慢点了点头，伤感地说道，“如你所愿。不管怎样，我应该告诉你的。”~
@103024 = ~他看了你一会儿，虽然眼神坚定，表情却流露出一丝不安。“我想说说先知的事情。”~
@103025 = ~他皱着眉头。“我认为我要说的事情很重要。但是，如果你真的不想听，那就算了。”~
@103026 = ~瓦伦僵住了，有那么一瞬间，他蓝色的眼睛里闪现出深红色的光芒。“如你所愿，”他简短的说道，然后转身走开了。~
@103027 = ~他考虑了一会儿，摇了摇头。“就我个人而言，过多的谈论先知是不合适的。但或许这能给你一些帮助。”~
@103028 = ~瓦伦冷冷的瞪着你好一会儿，最后他决定忽视你的所说的话。“我觉得你应该清楚，”他说道，“先知对于我……对于每个追随她的人来说，有多重要。”~
@103029 = ~“或许吧。我觉得你应该知道，先知对于我，以及对于每个追随她的人来说，有多重要。我决心不惜一切保护她。”~
@103030 = ~“我不太确定你对于诸位面了解多少，<CHARNAME>。我怀疑并没有多少，所以你对血战毫无概念，是这样吗？”~
@103031 = ~他吃了一惊，之后由衷地笑了出来。“不，不，”他笑着说，“当然所有人并不都是蠢猪，是吧？还是，我不该问这个问题？”~
@103032 = ~“血战是深渊魔域的恶魔和巴特祖魔族之间长年的斗争。我们战斗得非常持久和激烈，以至于这场战争已经成为了我们血统的一部分。”~
@103033 = ~“不可能有什么真正的胜利而言，那只不过是恶魔与魔鬼之间一场接一场的战斗。一种狂暴与流血的无尽的循环。”~
@103034 = ~“我被……征召到那些战斗中。”他将视线从你身上移开，目光中充满痛苦，“我年复一年的在外层位面作战，比一个士兵还不如……我是个野兽。”~
@103035 = ~“我被抓住了，”他因回忆而眉头紧锁，“我的整个少年时代都花在逃离血战上，但我还是被恶魔们揪了出来，成了一个战争奴隶。”~
@103036 = ~瓦伦想了一会儿。“我不确定。我在深渊魔域中的大部分时候都处于一种狂乱的愤怒之中……或许有20年？也许更多些？时间在那里毫无意义。”~
@103037 = ~“谢谢你。那是……一些我试着再也不要去想的事。但是当时，我只知道那些东西。”~
@103038 = ~他对你点点头，挤出了一个无力的微笑以示感激。“谢谢你，女士。那是……一些我试着再也不要去想的事。但是当时，我只知道那些东西。”~
@103039 = ~“血战让我成了现在这样的战士，”他对着自己的铠甲和武器点点头。“虽然它对我毫无意义。我只是个没头脑的士兵，仅此而已。”~
@103040 = ~“我的恶魔主人激起了我体内的恶魔之血。我曾对此感恩戴德……我沉溺其中，并不顾一切的以屠杀每一个敌人来取悦主人。”~
@103041 = ~“那时我一点人性也没有，而且我自己对此也丝毫不在意。直到先知找到了我。”~
@103042 = ~他摇摇头。“不。第一次见到她时，我是与主人一起被一个魔法召唤到你们的世界里。实际上，我们是被召唤来与先知作战的。”~
@103043 = ~“一个卓尔牧师把我们叫来，我们进入了战团。在攻击中我曾经和先知对峙过……而她……触碰到了我的灵魂。我没有别的方法来形容这感觉。”~
@103044 = ~“我们被驱回了诸位面，但是关于先知的记忆却留在了我脑中。它出现在我梦里。”瓦伦闭上眼睛，颤抖着。“数十年来，我头一次开始回忆曾经拥有的生活。”~
@103045 = ~他闭着眼睛停顿了一下，“我的主人察觉到了我的……异常。我被拷打了很久，至于是几个月还是几年……我真的说不清。我只记得那无法形容的痛苦。恶魔们很会折磨人。”~
@103046 = ~“最后，我从哥利马杉手里逃了出来。”瓦伦的眼中闪过了一丝痛苦。“我找到方法进入了你们的世界，一个对我这样的异界神侍来说完全陌生的地方，我不停的寻找，终于找到了先知。”~
@103047 = ~“她治好了我的伤，而且还……和我说话。如果我需要的话，她就会帮助我。”他的声音充满了感情。“不论从何种意义上来说，她都拯救了我。”~
@103048 = ~他平静的看着你。“根本就不是那么回事。先知是我的向导，我的救星，但从不是我的爱人。”~
@103049 = ~他平静的看着你。“在你之下，女士。先知是我的导师，仅此而已。”~
@103050 = ~“我简要地告诉你这些，是因为我觉得你应该知道，先知对我来说有多么重要。我决不会背叛她……也不容许别人背叛她。”~
@103051 = ~他冷冷的看了你一眼之后，移开了目光。“这是我的荣幸。请你记住。”~
@103052 = ~他点点头，移开了目光。“就是这样。无论如何，我只是觉得你应该知道。”~
@103053 = ~他扮了个鬼脸。“对不起，我并不是要指责什么。我只是觉得你应该知道。”他转身向前。“无论如何，我们继续前进吧。”~
@103054 = ~他皱了皱眉：“那是我的选择，不是她的。先知只是尽力的帮助我，她从未要求任何回报。”~
@103055 = ~瓦伦笑了笑。“是的，他试过，但失败了。看起来我以前对付魔鬼的所有技巧对恶魔都同样有效。你可以想像得到。”~
@103056 = ~瓦伦瞪了你一眼。“我不想用这些来烦你。这么说吧，先知救了我，从任何意义上来说都是这样。”~
@103057 = ~他的声音很平淡。“不，不是。”~
@103058 = ~“不，不是直接的。但是……我想她是第一个真正认真对待我的人。而她也让我开始重新反省自己。我对当时的自己并不满意。”~
@103059 = ~“我无路可选。你知道的，我是个奴隶，是我恶魔般主人手中的一个傀儡。他把我扔进战场，而我必须要挣扎求生。”~
@103060 = ~他一边措着辞，一边用他那热切的蓝眼睛注视着你，就像要把你看穿一样。“我想要知道，”他开口了，“是什么使你这么特别？”~
@103061 = ~他挑起一边眉毛，冷冷的看着你，过了一会儿才说话。“你可以试试。但是，我们两个不是来这里打架的。”~
@103062 = ~他耸耸肩，避开了你的凝视。“也许是，也许不是。不管怎样它仍然是个问题，一个我认为应该得到回答的问题。”~
@103063 = ~“当然，你已经取代我，成为了队伍的领导者。我曾经带领过大家生存过很长的时间，而你突然出现了，”他打了个响指，“然后就这么结束了。”~
@103064 = ~瓦伦沉默了好一会儿，似乎被自己的思绪所困扰。“先知相信她所相信的。她确信不疑的跟随着女神的指引，这就足够了，至少目前为止是这样。”~
@103065 = ~他的目光冰冷。“我并不喜欢胡思乱想。但我觉得有必要时，就会说出我的想法。”~
@103066 = ~“是那样吗？”他饶有兴趣的看着你，“你听起来非常的自信。但是考虑到我们眼前的状况，你可以说是在虚张声势。”~
@103067 = ~“我相信先知能够预见。我甚至相信那些预见就是来自于她所信仰的女神。但作为一名异界神侍，我认为神祇们也不是绝对正确的。”~
@103068 = ~“先知相信，你将带领我们走向胜利，可却没说这样的胜利需要我们付出什么样的代价。”他又一次意有所指地看着你，“我认为，有些代价太昂贵了。”~
@103069 = ~“先知认为你是来这里帮助我们的。我不会做出这种假设的。”~
@103070 = ~他紧紧地盯着你。“至今为止，我已经带领这些人度过了许多危险，并且一直保护着先知。我不会让他们被出卖的。”~
@103071 = ~“谢谢你。”他的态度并没有软化，“但那就是我需要这个问题的答案的原因。”~
@103072 = ~“我并不这么认为。我的忠诚属于先知，但保护这些黑暗精灵是我的责任，我不能让他们就这样被杀了。我会找到答案的。”~
@103073 = ~“当然。是指使术。”他皱着眉，“我不相信魔法，特别是控制心灵的魔法能力。不管是不是因为指使术的关系，我都希望你能找到一条出路。”~
@103074 = ~“我不能保证不会做同样的事情。像这样被……束缚着，一定很艰难。”他的脸孔扭曲了，“但如果指使术的效果消失了，你会怎么办？抛下我们去找瓦纱瑞丝吗？”~
@103075 = ~“相当清楚的答案。这样看来，我也没什么可问的了。”~
@103076 = ~“我说过我会帮助你，而且也会诚心诚意的这么做。”他的语气又强硬了起来，“但我也会监视你的。我不信任你，就这么简单。”~
@103077 = ~他向着前方点了点头，道：“不要因为我而耽误了我们的行程。继续前进吧。”~
@103078 = ~他重新审视着你，显然不太确定。“你是这么说的。我想我们会知道的，是吗？”~
@103079 = ~“我明白了。”他看起来很失望，“也许我的担心不是没有道理的。”~
@103080 = ~“相当清楚的答案。也许我和你很相像。不过，我们之间有共同点并不意味着我会放松警惕。”~
@103081 = ~“或许这对先知就已经足够了。我想，对我来说也差不多够了。”~
@103082 = ~“为什么不是呢？你又不对黑暗精灵和先知效忠。据我所知，你还会把任何一名黑暗精灵的死亡都当成是一件好事。”~
@103083 = ~“因为先知让我来帮助你，而且你也说你需要帮助。怎么了？你改变主意了？”~
@103084 = ~他挑起眉毛看着你。“你会把它交出来？”~
@103085 = ~他停下来考虑了一会儿，盯着你的眼睛里闪着光芒。终于他继续说：“我不是要你保证什么。你已经做得够多了。”~
@103086 = ~他咬紧了牙关，眼里闪着怒火。“我明白了。所有的黑暗精灵都该死，就因为他们是黑暗精灵。或者说，是因为你那嗜杀的血统？”~
@103087 = ~“你是那个意思吗？还是说，你只不过是在玩弄我？你是不是准备一有机会，就把我们丢给瓦纱瑞丝？”~
@103088 = ~他咬紧了牙关，眼里闪着怒火。“我明白了。你那自以为是的正义，其实一点也不明智。先知虽然是个黑暗精灵，但并不意味着她就不公正。”~
@103089 = ~“那没错。但你*已经*开始变化了。难道这对你一点意义都没有吗？”~
@103090 = ~他仔细地打量着你。“我……很高兴听到这个，尽管有一点吃惊。你只是刚刚认识我们，没有义务一定要承担这样的责任。”~
@103091 = ~“对你和先知而言，也许那些东西全都是很重要的。但对我而言，并不全是。”~
@103092 = ~他审视着你，皱着眉思索着：“不，我不认为你办得到。我们都不行，就算在这里也一样。”~
@103093 = ~“现在你还没指引他们，但我肯定，时机来临的话，先知一定会把我们队伍的生死存亡交到你手里。”他皱着眉，“而这正是我所担心的。”~
@103094 = ~他仔细的审视着你。“我想你可以拒绝。我认为到那时候，你的性命将取决于战争的结果，就像我们一样。”~
@103095 = ~他的声音干干的：“我会把所有的事情都说得很有戏剧性，这是我的特质之一。”~
@103096 = ~他的脸板了好一会儿，最后转了转眼珠子，叹了口气：“很好。你可能是对的……我在这上面的投入太多了。但我还是想知道你的想法。”~
@103097 = ~一丝微笑从他的脸上掠过，又迅速地消失无踪。“你这两点都不缺，女士。但那不是我要打听的。”~
@103098 = ~一丝微笑从他的脸上掠过，又迅速地消失无踪。“女士，你知道她用不着靠这些来算计男人。”他突然移开了目光。“不过，那不是我要说的。”~
@103099 = ~--------- Romance Conversations begin here ----------~
@103100 = ~“看来我们将要到达冒险的尽头了，很快我们就会走出九渊地狱……我想也是时候离开这里了。”~
@103101 = ~“我……我知道。自从到达巴托异界以后，我一直在抵制自身血脉发出的催促，似乎我灵魂深处的恶魔特质一直在推动着我把血战继续下去。”~
@103102 = ~“当我想起我战斗在外层位面的日子……想起我的人性被我身上属于魔性的那一半整个吞没……我就忍不住感到自己已经没有希望了，<CHARNAME>。”~
@103103 = ~瓦伦皱起眉头，他的尾巴不安的摆动着。“是的，我们还要对付靡菲斯特，不是吗？那么让我们继续这一使命吧，我想尽快了结这件事。~
@103104 = ~“德金的真名！你想要我干什么，头？”~
@103105 = ~“没有？什么也没有？如果你询问德金的话，那就浪费了一次真名。你在那上面又花了多少时间，头？赶快上路吧，我们还要继续冒险。”~
@103106 = ~“头？”~
@103107 = ~“是的，头。德金会没事的……很伤心，但是不会有事的。你正打算死去吗，头？”~
@103108 = ~“是的，头。德金信任他。还有别的吗？”~
@103109 = ~“啊……头？德金有点需要那个灵魂。这是他唯一所得到的，是吧？你确定那是你想要的吗？”~
@103110 = ~“噢！你让德金吓了一跳，头。也许这些真名并不那么有趣……你对我还有别的什么命令吗？”~
@103111 = ~“唷……好吧，头，没什么……再见……谢谢这些鱼……出去的路上不要让门砸到了……唉唉啊啊！”~
@103112 = ~“不要……<CHARNAME>，请不要这样做……”~
@103113 = ~“但是我的所作所为是错的！无数无辜的人和朋友因为我的行为而死去。如果感觉不到愧疚，感觉不到责备，那就表明对这个世界冷漠了，这是没人性的。这就是要求我做的吗？”~
@103114 = ~“谢谢你，<CHARNAME>。对自己的过去负责的能力是我唯一保留下来的尊严……你想要求一些别的来替代它吗？”~
@103115 = ~“我想诸神有他们的神秘之处。但是通过他们的语言发出的命令必须得到他们的同意，不管是为善还是为恶。通过你的命令，我得到了补偿……还有别的吗？”~
@103116 = ~“那么我将不会蒙受苦难，我向你保证。事情将会如你所吩咐的那样。你还要求我做些什么？”~
@103117 = ~“那么你的后代将会受到诅咒。让他们个个都逐渐陷入绝望之中……事情将会如你所命令的那样。你还有别的苦难加到我身上吗？”~
@103118 = ~“我的灵魂？但那是我拥有的全部！我不知道它将带给你什么力量，但是如果没有它，我将变成失魂者……你确信这是你想要的吗？”~
@103119 = ~“对于那一点，我感谢你。<CHARNAME>，请停止这种疯狂的行为吧！看在我的份上，我求求你了，除此以外再也没有别的要求了……”~
@103120 = ~“遵命，<CHARNAME>……”~
@103121 = ~“但是我再次成为了一名圣武士，如果没有你我做不到这一点！……可是这是你的命令，而我必须服从……该死的，<CHARNAME>，不要对我再有别的什么要求了！”~
@103122 = ~“但是怎么会是爱呢？……唉，既然你已经给了我命令，那么我将以我所能够的方式爱你直到生命的尽头……你对我还有别的什么命令吗？”~
@103123 = ~“不要……你在干什么？你竟敢这样！”~
@103124 = ~“很好，很高兴你回复理智了。让我们快点，靡菲斯特在等着。”~
@103125 = ~“别傻了，<CHARNAME>。你没有必要靠我的真名来给我那样的命令！相反，我很高兴那样。我会作为一个无比邪恶之人永载史册……还有别的吗？”~
@103126 = ~“我的灵魂？但那是我拥有的全部！我不知道它将带给你什么力量，但是如果没有它，我将变成失魂者……你确信这是你想要的吗？”~
@103127 = ~“对于那一点，我表示感谢。你还要强迫我做什么？”~
@103128 = ~“遵命，<CHARNAME>……”~
@103129 = ~“但我是个暗黑暗卫士，一条在你的建议下选择的道路……可你让我没有别的选择。我遵命就是……请不要再对我提别的要求了。”~
@103130 = ~“主……主人？……既然你已经给了我命令，那么我将以我所能够的方式爱你直到生命的尽头……你对我还有别的什么要求吗？”~
@103131 = ~“是，<CHARNAME>。”~
@103132 = ~“我的真名……你……你想对我做什么？”~
@103133 = ~“我……我放心了。快点，我们必须穿过大门，回到托瑞尔。如果我们拖得太久，靡菲斯特将会毁灭整个深水城。”~
@103134 = ~她那黑色的眼睛里闪过一丝恐惧，“但是如果我把灵魂给你，我就会死去。没有它我将只是一缕尘埃……你确信这是你的要求吗，<CHARNAME>？”~
@103135 = ~“对你的这点小小仁慈我表示感谢，<LADYLORD>。然而我求你不要再对我有别的什么要求了。”~
@103136 = ~当黑暗精灵的生命元素被剥离的时候，她大声尖叫了起来。在你的眼前她一下子衰老了上千岁，她的皮肤皱起来，眼睛变得无神，身体衰败成了一堆骨灰。娜西拉的灵魂现在属于你了。~
@103137 = ~黑暗精灵的脑袋后仰，发出痛苦和绝望的喊叫。她咬牙狠狠地说：“我竟然强迫我爱上你？你是什么的禽兽啊？”~
@103138 = ~“我的真名让你可以控制我，<CHARNAME>。不管你怎样滥用你的力量，我都被强迫着去服从。但是如果我找到了破解的方法，我会杀了你！……现在你对我还有什么别的无耻要求？”~
@103139 = ~她厌恶朝地方啐了一口，但是无法抗拒真名的力量。“就这些吗？”~
@103140 = ~她发出了一声怒吼，然而仍然照你的命令办了。当亲吻结束后，她转身走开了，无法面对你。显然你完全打破了她的精神。~
@103141 = ~“你已经表明了你的意思，<CHARNAME>，”她愤怒地低语着。“现在我们必须看看你对靡菲斯特是否也拥有如你对我一般的绝对力量。你还有什么别的要求？”~
@103142 = ~娜西拉惊奇地挣大了眼睛，她似乎想要反对，但还是低下了头。当她抬起头的时候，一种奇怪的表情浮现在她的脸上。~
@103143 = ~“我的……我的罪行洗刷掉了，”她说着，表情很惊奇。“它消失了，仿佛从来没有存在过一样。我……我自由了。谢谢你，<CHARNAME>；你给了我一个与众不同的礼物。”~
@103144 = ~“尽管你是出于好心，但我仍然觉得这有些……令人不安。真名的力量是一个巨大的责任，希望你不要滥用它。你对我还有别的什么希望？”~
@103145 = ~当他听到这些词的时候，瓦伦的眼睛睁得大大的。“我的真名，”他承认了，眼睛里是一种愤慨和敬畏交织的神情。“你想……怎样命令我？”~
@103146 = ~瓦伦的眼睛里满是放心的神情。“谢谢你，<CHARNAME>。我很感激。现在……我们应该尽快通过大门，以便去拯救你的深水城。”~
@103147 = ~瓦伦闪过一道危险的红光，“拿走我的灵魂，”他嚎叫着，“那将结束我的生命，永远地结束。你确信这是你的希望吗？”~
@103148 = ~瓦伦点点头，感到放心了。“谢谢你，<LADYLORD>。请……不要再要求我别的了，求你了。”~
@103149 = ~在你的眼前，瓦伦开始剧烈的摇晃。当生命元素突然从他的身上剥离时，他发出了愤怒而又痛苦的尖叫，他的物质形态逐渐消失，变成一大堆灰烬。瓦伦的灵魂现在是你的了。~
@103150 = ~他厌恶地冲你讥笑着。“你竟然强迫我爱上你，我的女士？在我们有了这样的经历之后？”~
@103151 = ~他看着别处，不想和你的眼神交汇。“还有别的要求吗，我的女士？”~
@103152 = ~瓦伦用他那深蓝色的眼睛瞪着你，下巴绷得紧紧的。“随你的便……亲爱的。你可以任意指使我。但是如果我解放了自己……那么我会杀了你。相信我，我会那样做的。”~
@103153 = ~他盯着你，眼睛里燃烧着暗红色的怒火……但是他什么也没说。他那带着套的拳头慢慢地握紧，然后又放开。~
@103154 = ~瓦伦试图抗拒你的命令，但最终还是放弃了。他斜靠近身来，闭着眼睛轻轻地吻在你的嘴唇上。当你们分开的时候，他的脸颊上流下了泪水。~
@103155 = ~“我希望你会让你快乐，我的女士。”他啐了一口，拒绝看你的眼睛。~
@103156 = ~瓦伦好奇地看着你，仿佛不太清楚你所说的……然后他的眼睛突然变大了，全身发硬，一股电流猛烈地在身上流淌着。~
@103157 = ~过了一会儿，他全身抽搐，一股奇怪的黑色光芒似乎从他身上升起，然后消失掉。当他睁开眼睛后，一种……不同寻常的东西出现在他的身上。异域的气息，灵魂内的愤怒……所有的一切都已经消失了。~
@103158 = ~“我……我真不能相信这一切！”他怀疑地看着自己，缓缓地露出了笑容。“恶魔血统……它不见了！我感觉……我感觉太爽了！我感到自己成为人了！！”瓦伦抱住了你，开心地笑着。“谢谢你！谢谢你的这份美妙的礼物！”~
@103159 = ~“谢谢你，<CHARNAME>。我永远也不能报答你这样的恩情。现在……我们该尽快通过大门，以便去拯救你的深水城。”~
@103160 = ~他疑惑地盯着你说：“我很感激，我的女士，但是……你要强迫我爱你？即使那根本不是真正的爱？”~
@103161 = ~他停下来看着你的眼睛，脸上突然布满柔情。然后他倾过身来，轻轻地吻着你。“我想是的。”~
@103162 = ~“深水城在等着我们，亲爱的。我们在这里呆得越久，就会有越多的人受到靡菲斯特的伤害……我们必须阻止他。”~
@103163 = ~他的笑容现在变得轻松了。“你并不了解，<CHARNAME>。感觉……就像是肩上卸下了重担。”~
@103164 = ~瓦伦伤心地叹了口气，道：“没有时间？是的，时间似乎永远也不会有，不是吗？我们是真正的朋友吗，<CHARNAME>？难道这对你没有任何意义吗？”~
@103165 = ~他伤心地注视着你，说：“没有时间，是吧？这就是我从现在起能期待的回应吗？我爱你，我的女士，但是你也并没给我们两人留下多少希望。”~
@103166 = ~瓦伦听了你的话后愣住了，他的突然闪烁着怒火，说：“这就是我期望从你那里得到的回应，<CHARNAME>。如今我该明白多了，用不着在你的身边诉说自己的想法。”~
@103167 = ~“让我们继续前进，找到靡菲斯特，把这一切结束掉吧。这似乎是你唯一感兴趣的事。”~
@103168 = ~瓦伦听了你的话愣住了，他的尾巴不停摆动。“你让我的感情看起来出了可笑没有别的。我以为你是朋友，<CHARNAME>。”~
@103169 = ~他又盯着你看了一会儿，怒容满面地说：“只有这事才重要，是吧？好吧，让我们继续前进，把它快点了结了吧。”~
@103170 = ~“抱怨，是吧？那么我明白了：我们不是真心朋友。”他转身离去，怒气冲冲。“不过没关系。让我们找到靡菲斯特，把这一切结束掉吧。”~
@103171 = ~“是的。我想我应该知道得更清楚。只是……一直感到孤独，感到与所遇的人没有关系是一件困难的事。”~
@103172 = ~“我知道。我想我不该对你发怒，因为你并不能真正为我做些什么。”~
@103173 = ~他伤心地注视着你，道：“我是真地真地很爱你，我的女士，我想知道你为什么要这样冷漠地对我，难道我们之间就没有希望了吗？”~
@103174 = ~“她已经试过了。她把我从边缘拉了回来，把我从一个嗷嗷叫的野兽变成了现在这个样子……但是她只能做这么多。”~
@103175 = ~“最终我将独自承担这一切。我的一半恶魔血统将永远是我的一部分，即使我到了你的世界里我也无法逃脱。我必须接受这一点。”~
@103176 = ~他点了点头，“也许你是对的。所有的伤口都会随着时间而愈，对吧？在这同时我们还有很多事情要做。”~
@103177 = ~他叹了口气，做了个往前走的手势。“让我们找到找到靡菲斯特，把这一切结束掉。我向往着为你战斗，至少还有这一次。”~
@103178 = ~“不，”他摇了摇头，“不，那没有必要。这件事情我必须一个人去做。”~
@103179 = ~他感激地笑了笑，道：“谢谢你，我的朋友。我感谢你的态度。”~
@103180 = ~他伤心地注视着你，说：“我不知道。我感到自己和别人隔绝了太长的时间，我……我不清楚什么是希望。你认为我俩还有希望吗，我的女士？”~
@103181 = ~他缓缓点了点头，一幅伤透了心的表情。“我……我想我只能期望那样的结果。好吧，让我们找到找到靡菲斯特，把这一切结束掉。我不想再拖延了。”~
@103182 = ~“抱怨，是吧？那么我开始怀疑我们之间是否有真正的爱。”他怒气冲冲地转身走开，“不过没关系。让我们找到找到靡菲斯特，把这一切结束掉吧。”~
@103183 = ~他点点头说：“那是个好主意。你是对的，我的女士，一直都是这样。我会把自己的思绪放在一边……如果你说我们还有希望，那么我会相信的。”~
@103184 = ~他咧嘴笑着一个劲地点头道：“让我们找靡菲斯特大战一场吧。我现在已经等不及了。”~
@103185 = ~“是吗？”他看着你，抱憾地微笑着说，“那么我得依靠你来提醒我了，我的女士。因为当你告诉我是这样的，那么我就相信是这样的。”~
@103186 = ~“德金也感到很伤心。德金要怎样才能整理好这些便条呢？”他一边搜索着背包，一边感叹，“德金觉得他也有些便条遗失在了熔岩里。”~
@103187 = ~瓦伦伤心地笑着，拍了拍德金的脑袋，说：“你是一个好旅伴，狗头人。在我觉得万念俱尽的时候，你鼓舞了我。”~
@103188 = ~德金龇着牙，对瓦伦笑了笑说：“你必须要信任头。德金因为信任头，所以一切都很顺利。有一天德金希望成为像头一样的大英雄。”~
@103189 = ~“那确实是一个值得追求的目标。”~
@103190 = ~“但是你还是很忧伤，尽管你说德金鼓舞了你的精神，德金从你的眼睛里看出了这一点。”~
@103191 = ~“起码我就会很高兴离开这个地方。”娜西拉表情严峻地看着四周，“这里的那些失落的灵魂……他们在呼唤我。这真让人不安。”~
@103192 = ~“他们在呼唤你？我得承认，我什么都没听见。”~
@103193 = ~“我只是觉得自己注定要留在这里。我想我已经……把很多灵魂送到了这里。这个地方缠绕着我。”她叹了口气，抬头看着瓦伦。“你知道我在说什么，不是吗？”~
@103194 = ~瓦伦充满兴趣地向四周看了看，说：“这里看起来好像是一个……半位面。多有趣啊！它有名字吗，<CHARNAME>？”~
@103195 = ~“收割者来自外域，是吧？你是怎样获得这样一个生物的服务的？”~
@103196 = ~“真的？好吧，<CHARNAME>……就依你的想法吧。但是这样的半位面是很少散落四处让人捡的。很可能这是一个较大位面的一部分，不过还是你知道的最清楚。”~
@103197 = ~“我明白了。如果这真是一个半位面，那么你对此知道些什么呢？”~
@103198 = ~“有意思。一个不从属于任何更高力量的半位面？你是怎样得以进出这个半位面的？没关系，我想……你该知道自己在干什么。”~
@103199 = ~他的眉毛皱了起来，问：“你是不知道还是不想告诉我？”~
@103200 = ~瓦伦看了看四周，一副鬼脸的样子，仿佛意识到了什么令人不快的东西。“有趣，”他喃喃着，“我们来到地狱了。”~
@103201 = ~瓦伦转了转眼珠子说：“你不用把它说上两遍。我们走吧……我和你一样渴望着走出这里。”~
@103202 = ~“确实是的。”他又看了看四周，“这里是巴托异界，也叫做九渊地狱。具体点说，它是构成巴托异界的九个位面之一，被称作冰冷墓地的卡尼亚。它似乎一直是靡菲斯特的巢穴——直到近期以来。”~
@103203 = ~“我应该警告你我的存在可能会造成……麻烦。我是塔那厘一族的成员，是来自深渊魔域的半恶魔。因为血战的缘故，巴托异界的魔鬼们是我的天敌。”~
@103204 = ~“事情就是那样的……我的出身让我想要攻击他们，反过来他们也一样。”他深深地皱起眉头。“我会……试着控制住自己。但是我们应该尽快找到出路离开这里。”~
@103205 = ~“并不是所有的地域位面都是烟火之地。有些是冰川雪地，比如这个位面……有些是乌黑浑浊的水下墓地，还有一些是拥有自己城市的文明世界。”他耸了耸肩膀。“这并不比其他的更糟。”~
@103206 = ~“实际上我来过这里。我曾经有很多年辗转于这里和深渊魔域，战斗在血战之中。”~
@103207 = ~“我们来到这里了。他们说，这座城镇不知是从哪里出现的……很多幽暗地域的种族都认为它适合夺取并加以利用。瓦纱瑞丝也会想到这点。她将会派人来的——如果她还没有派人来过的话。”~
@103208 = ~瓦伦盯着你说：“如果你愿意听的话，我有一些关于你能去哪里的建议。如果你想听，只要让我知道就行了。”~
@103209 = ~“要注意，也许这里已经有敌人了……但是在这里以外的地方，我非常同意你的看法。让我们前进吧。”~
@103210 = ~“在这里要小心点，<CHARNAME>。其他种族只是夺心魔的潜在奴隶，如果你不多加防备的话，他们会把侵入你的头脑，夺去你所有知识这样的事看成是家常便饭。”~
@103211 = ~“如果你这样说的话。记住在这里大杀一通并不能帮助反抗军队……我们需要和主脑谈判，而不是杀死它。”~
@103212 = ~“你必须和主脑交谈，以便让他劝服其他夺心魔团体放弃瓦纱瑞丝。如果你能保护好自己的心智，那么也许我们能兵不血刃的解决这件事。”~
@103213 = ~“我希望你是对的。但如果我们最后沦为了奴隶，那么我会对你发火的……如果我还有心智留下来让我能发火的话。”~
@103214 = ~“我怀疑那些灰矮人的头盔可以保护你，这方面娜西拉应该比我知道的多。”~
@103215 = ~“我们把你作为我们的头领，他们就不会侵为我的大脑。他们会认为我是你的奴隶。灵吸怪有那样一种奇怪的骄傲……如果他们被发现注意一个仆人，那么就会失去主脑的器重。”~
@103216 = ~“只要记住装扮成一个来到佐瓦柯穆的奴隶，那么事情应该会进行得比较顺利，至少可以达到在一个充满夺心魔的城市里所能期望的顺利程度。”~
@103217 = ~瓦伦皱了皱眉头，道：“我觉得这是个笑话。我曾经在深渊魔域有过一个主人，但是后来就再也没有了。在你去佐瓦柯穆的时候我会装成一个仆人，但是别忘了这只是场戏。”~
@103218 = ~“只要你记住装扮成一个来到这座城市的奴隶，那么事情应该会进行得比较顺利。除非不得已，我可不想用战斗来血洗全城。”~
@103219 = ~瓦伦咯咯的笑着，脸一下子变红了。“我……我觉得我不会是个好仆人，我的女士。我的恶魔血统让我在大多数时候粗暴易怒。”~
@103220 = ~他看着别处，脸变得更红了。“你在和我玩游戏，我的女士。请……让我们处理手头的活计吧。”~
@103221 = ~瓦伦面对着你，突然生气了。他的眼睛里闪烁着红光，怒吼道：“我对此表示严肃的怀疑，我的女士。我*不*是供你在闲时伤害的动物！”~
@103222 = ~瓦伦开始说些别的，然后闭上了嘴巴，再接着又缓缓叹了口气，道：“你是一个非常奇怪的女人。似乎我从来不太知道怎样待你。”~
@103223 = ~“防备性？防备性？！我只是，”他迟疑了一下，“不能容忍荒唐事！”~
@103224 = ~他看起来很困惑。“那是表扬吗？有时候我总是不能确定。”~
@103225 = ~“很好。只要记住装扮成一个来到佐瓦柯穆的奴隶，那么事情应该会进行得比较顺利。不到万不得已我真的不想通过战斗血洗全城。”~
@103226 = ~“那么我明白了。如果这样有效的话，那么要注意在我们进入佐瓦柯穆后不要把它移走。如果这些东西突然变得不怀好意了，我可讨厌被他们包围着。”~
@103227 = ~“这个殿堂有很强的魔法气息，邪恶的魔法。我很自然地发现，正是不死生物之源支持着瓦纱瑞丝军队的数量。”~
@103228 = ~“很可能是不死生物，更多的不死生物。我们可能要对付女祭司……或者是一群死灵师，不经过调查不会知道，而那样会很危险。”~
@103229 = ~“不重要？我们的生存不重要？”他耸了耸肩。“你以为你会听听我的看法。好吧，那么……我会保持沉默。”~
@103230 = ~他咧开嘴笑了笑，道：“我对此没有怀疑。让我们走吧。”~
@103231 = ~“好的。但是你不会独自面对此事。我会战斗在你这一边。”~
@103232 = ~“我也是。”~
@103233 = ~“还有我，头！”~
@103234 = ~“这个村庄……这些都是地表人群。他们怎么会在这里？幽暗地域的种族只把地表生物当成奴隶或者食物……或者同时当成两者，除此以外没有别的了。”~
@103235 = ~“也许吧。这些地表人本身并没有什么威胁……他们即便不是奴隶，也是俘虏。真正的问题是：谁是他们的主人。”~
@103236 = ~“也许吧。但是他们为谁效劳？原因又是什么呢？”~
@103237 = ~“当然你是对的。但是这里有些神秘……我建议大家小心为上。”~
@103238 = ~“你认为这是一种幻觉或者某种隐藏他们真面目的魔法？不，我不这样认为……当然我不能确定。但是我觉得他们就是其展现出的样子。”~
@103239 = ~“这些废墟……很奇怪。我对幽暗地域种族的建筑不是很熟悉，但它肯定不像我曾见过的那些。不是卓尔的，不是灵吸怪的，也不是眼魔的。”~
@103240 = ~瓦伦不友好地看了你一眼。“我不想闯入一个前途莫测的境地。这个地方感觉……有点不对劲。”~
@103241 = ~“这里的空气感觉很重，很纯。我可以确定，魔法在这里完全没用……我这个位面的人对这种事情非常敏感。”~
@103242 = ~“是的……不过如果说这里面有危险的话，那么显然最大的危险就是它是片反魔法区域。”~
@103243 = ~他抓紧了武器，说：“谢天谢地我不是法师。带路吧，<CHARNAME>……我跟着。”~
@103244 = ~“老实说我不清楚。但是如果我们进去了，那么我们就必须依靠某些非魔法的东西才能通过。”~
@103245 = ~“也许吧。但我不喜欢踏进一个茫然无措的境地。在这里的所有感觉都……有点不对劲。”~
@103246 = ~“眼魔暴君应该就在这些隧道里的某个地方，但是要找到他并不容易……如果有必要，眼魔们会牺牲至最后一个来保护它的。”~
@103247 = ~“几乎没有。但是眼魔是可怕的对手。我可没兴趣被变成石头或者被解体，或者他们赐予的其他一些命运。让我们还是小心点。”~
@103248 = ~“是的。我们必须对他们保持警惕。他们会帮他们的主人来攻击我们的，所以我们应该谨慎。”~
@103249 = ~“他们也是这样。”他看着你，突然恶作剧似的咧嘴一笑，“他们总共大约有一打的人。”~
@103250 = ~瓦伦笑了笑，没再说什么，他做了个手势，让你在前面带路前进。~
@103251 = ~“嗯。魔像是特别难缠的对手。如果这里有传说中那么多的魔像，那么我们会陷入挑战之中。你确信我们对此准备好了吗，<CHARNAME>？”~
@103252 = ~“不，当然不是的。但是魔像有特别难以对付的地方。魔法对他们几乎没有什么作用，很多武器也伤害不了他们，而且这些魔像还可能与别的不同。”~
@103253 = ~“制造他们的巫师可能是这方面的高手。如果我们碰到了以前从没见过的东西，我肯定不会感到惊奇。”~
@103254 = ~“随便什么速度，只要带领我们前进时小心点就可以了。巫师把它们作为守卫是有原因的。”~
@103255 = ~“你很特别；我不能让你发生任何事。请答应我你会小心的。”~
@103256 = ~娜西拉怒容满面，但是她控制住了自己，以免说出一些可能让她后悔的话来。最后她平静地说：“好的，让我们走吧。”~
@103257 = ~“记住：所有追随先知的人的命运都掌握在你的手上，<CHARNAME>。如果你倒下了，我们的希望也随之倒下了。”~
@103258 = ~黑暗精灵恼怒地摇了摇头，“别对我施展你那笨拙的调情了，小子。我的意思是，因为先知的远见，你显得很特别。你应该成为我们的救星。”~
@103259 = ~娜西拉给自己做了个微笑的提示，回答道：“那是你所要说的，<CHARNAME>。但是实际上我是在指先知的见识。你注定要成为我们的救星。”~
@103260 = ~“我想告诫你：当我们到达码头时，请谨慎行事。黑暗之河是立特米亚撒防御功能的关键，因为没有任何军队可以跨越。河水含有剧毒，水中的生物无比致命。”~
@103261 = ~“好的，当你想要过河的时候，只要寻找卡瓦拉斯就行了。他在这里被称为‘船夫’，因为他拥有唯一能渡过黑暗之河的船。”~
@103262 = ~“如果你想要过河，找卡瓦拉斯就行了。他在这儿被称作‘船夫’，因为只有他有能力渡过黑暗之河。”~
@103263 = ~“但是在和卡瓦拉斯打交道的时候，我建议你要小心点。我承认，他是有点……奇怪。”~
@103264 = ~“至少，它让城市的这边免受他们的进攻。黑暗之河上没有桥梁——所有建造的桥都会被涨起的河水冲走。”~
@103265 = ~“河水剧毒无比，激流迅猛致命。只有最熟练的船夫才能从河的这边驶到对岸而不被卷入水中坟墓里。”~
@103266 = ~“我明白你并不是通过……正常的道路到达幽暗地域的。那样的话你可能意识不到它确切的样子。如果你愿意的话，我可以向你解释。”~
@103267 = ~“你相信这样吗？”瓦伦弯着眉毛看着你，“那就这样吧。我希望你像你所声称的那样准备好了应付将要到来的危险。”~
@103268 = ~“那里是上面的世界，”他朝上指着，“那是你所知道，地表世界。而这里是地下的世界。”他对着四周做了个手势。~
@103269 = ~“通常会犯的错误是认为幽暗地域仅仅是个山洞而已。并不是这样的。它是一个完整的世界，有海洋、河流和很多层。”~
@103270 = ~“幽暗地域里生物的第一条法则就是生存。几乎没有谁不想让你成为奴隶或者他们的晚餐……或者把你卖给那些会这样做的家伙。”~
@103271 = ~“先知似乎觉得你很特别，我们应该把自己的生命放在你的手中。我怀疑这是否明智……我想我会走着瞧。”~
@103272 = ~“德金把他的生命放在头的手上，德金没有怨言。只是德金的性命真的太渺小了点。”~
@103273 = ~“嗯，我……我认为那意味着些什么，是吧？”~
@103274 = ~“你在质疑先知吗，瓦伦？”~
@103275 = ~“还没有，娜西拉。还没有。”~
@103276 = ~“要是我有足够力量的话，我会自然而然地那样做的。”他扫了你一眼，无力地笑了笑。“如果再次发生那样的事，也许我会考虑这样的情形。”~
@103277 = ~“那么你是想让我继续我们的旅程，还是想让我留在这里？”~
@103278 = ~他好奇地看着你的伴侣。“我会很高兴和你一起走，但是从现在看来你已经有了足够多的帮助了。如果你真的想要我的帮助，请让我知道。”~
@103279 = ~他点点头。“请不要离开我太久，我不喜欢闲着。”~
@103280 = ~瓦伦突然盯着你的眼睛，表情变得严肃起来。他伸出粗糙的手掌，轻轻摩挲着你的脸颊。“为了把你带到我身边，我会像风暴一样把九渊地狱打个稀巴烂，我发誓。”~
@103281 = ~他看着地面，避开了你的主食。“不管这是不是我的错，我还让你失望了，<CHARNAME>。我不想再让你失望了。”~
@103282 = ~瓦伦转过来，用一种茫然的表情看着你。“我更习惯一个人战斗，一直以来我都是这样和多得多的敌人战斗而最后活下来，这点我可以对你保证。”~
@103283 = ~“如果我们想要活下去，就必须互相帮助。”他目光尖锐地看着你说，“当然，这得假设你仍然想要我和你一起旅行。”~
@103284 = ~瓦伦似乎想要抗议，但是闭上了嘴，沉默了一会儿。然后他粗略地点了点头。“我不是有意的，”他平静而又坚定地说。~
@103285 = ~他突然笑了起来，而平时他是很少笑的。笑容轻柔地荡漾开来，一直延伸到他那熠熠生辉的蓝色眼睛。“听起来不错，”他咧嘴笑了笑，“但不管怎样我不想把它当成习惯。”~
@103286 = ~他似乎心神恍惚地举起手来，用他那粗糙的手掌抚摸着你的脸颊……过了一会儿他放下了手，看着别处。“我们该上路了，是吧？”~
@103287 = ~-------这一行必须放在队员之间说笑的结束处---------~
@103288 = ~“艾瑞贝丝。我知道你曾是正义之神泰尔的追随者。现在还是吗？”~
@103289 = ~艾瑞贝丝神情冷淡高傲地注视着瓦伦，“是的。为什么你要问这个？”~
@103290 = ~“我发现这很奇怪，在你经历了过去那些事情后，你仍然对你的神明有着这样的信仰。”~
@103291 = ~“你对此知道些什么？”~
@103292 = ~“我知道很多。毕竟我是来自地表的，我不是个黑暗精灵。我知道你是谁，也知道无冬城发生的事。”~
@103293 = ~艾瑞贝丝对这个问题向了很长时间。“什么也没有降临我身上。我自己对自己做下了这样的事并且祈求泰尔的宽恕。”~
@103294 = ~瓦伦充满嘲弄地吸吸鼻子。“我还知道范斯维克是谁。*那*就是正义吗？”~
@103295 = ~她的眼神变得凝重。“也许不是。但是所有我当时感到的愤怒不应该……没有必要去……”她的声音慢慢地听了下来，她的眼睛闭上了。“原因就是，我相信正义并不意味着我会在其他人的身上找到正义。”~
@103296 = ~“但那不是让打倒那些不正义的人成为你的责任吗？”~
@103297 = ~“我曾经认为是那样的，但这只让事情变得更糟。我必须找到……另外一条道路。”艾瑞贝丝的声音因动情而发颤，而瓦伦只是冷冷地看着她。最后他点了点头，被她的回答所打动，没有再继续下去。~
@103298 = ~艾瑞贝丝冷冷地注视着瓦伦。“你总是对陌生人问这样的个人问题吗，你这个半人生物？”~
@103299 = ~他嘻嘻地笑着答道：“当情形需要的时候会的。”~
@103300 = ~她耸了耸肩，“不，我当然不再追随泰尔了。它背叛了我。”~
@103301 = ~“你是指在无冬城发生的事。”迎着她的目光，他点了点头。“是的，我知道那件事。毕竟我是来自地表的，我不是个黑暗精灵。”~
@103302 = ~“那么，是的。当然我是在指那件事。无冬城的居民活该承受我的仇恨，而泰尔却抛弃了。”~
@103303 = ~“所以你认为它应该看在你的长期侍奉上出面干预？改变发生在你的精灵男人身上的事情？”~
@103304 = ~艾瑞贝丝的眼光变得更加冰冷。“我希望正义之神能够支持我对不正义之士的战争。”~
@103305 = ~“那就是你把铠甲漆成黑色的原因吗？”~
@103306 = ~“半人，你体内有恶魔的血统。清先告诉我它的愤怒的召唤没有让你陷入不顾一切的境地，然后再来用嘲弄的语气和我说话。”~
@103307 = ~瓦伦什么也没有，而她目光犀利地看着她。“当它的召唤在你的血液中响起的时候，魔人，你喜欢吗？你是最终消除了你的渴望，还是把你的欲望之火愈烧欲旺？”~
@103308 = ~“够了，”瓦伦怒吼着，避开着她的注视。~
@103309 = ~“我同意，”她努叫着，然后走开了，结束了这次谈话。~
@103310 = ~“娜西拉……也许你可以为我回答一个有关黑暗精灵语言的问题。这事已经……困惑了我一段时间。”~
@103311 = ~娜西拉耸了耸肩。“当然，只要你愿意。”~
@103312 = ~“自从数月前我们和反叛的黑暗精灵加入到一起后，我在和女性说话时有些……难处。”一丝羞红慢慢地爬上他的脖颈，但他还是继续道。“她们和其他伊丽思璀的追随者们非常，呃，非常不一样。在很多地方都是。”~
@103313 = ~“我看到了。”娜西拉注视着他，脸上是调皮的笑容。“你从没有遇到过这么独断强横的女性吗，瓦伦？”~
@103314 = ~“你要是遇到过六臂蛇魔的话，你就不会那样问了。不是的，我更对几个主母在跟我说话石用过的一个特殊的短语感兴趣。我以为我的黑暗精灵语言很流利，但是似乎不是这样的。”~
@103315 = ~“好吧，念出来。你说的是什么样的短语？”~
@103316 = ~他清了清喉咙说：“我相信她们在提一个建议，但是，哈，”瓦伦突然注意到你就站在旁边。因为害羞，他靠近了娜西拉，对她耳语了一番。~
@103317 = ~娜西拉嘻嘻地笑着，接着哈哈大笑起来：“第一部分我想你是知道的，”瓦伦点点头，眼光看着别处。“另一部分，哈，”她指着他那根粗大的尾巴说，“再说*那个*。”~
@103318 = ~瓦伦瞪着他的尾巴，然后又看着娜西拉，他的眉毛因为困惑而皱成了结。突然他的眼睛惊奇地鼓了起来。“噢！”~
@103319 = ~她再次大笑起来。“你的确问过了。”~
@103320 = ~瓦伦按住他那不断咯咯颤抖的下巴，慢慢地走开了。“让我们，哈，”她注意到了你的注释，想要看着别处。“让我们继续前进，好吧？”~
@103321 = ~“娜西拉，不知我能不能问你一个……个人问题。”~
@103322 = ~娜西拉注视着瓦伦，茫然地张开嘴笑着，“这是为什么？这几个月来我一直在先知这边，但是从没屈尊和我说话。为什么现在要说了？”~
@103323 = ~“我不再接受黑暗精灵力量的命令了，我们现在也不是在为了自己的生命而逃脱。”他对着四周作了个手势。“或多或少，我们现在是处于孤立境地了。”~
@103324 = ~“好吧，只要<CHARNAME>不介意，你尽管问你想问的吧。”~
@103325 = ~“我……想<HESHE>会介意的。但是我想知道……是先知的哪些地方说服你离开黑暗精灵而加入她这一边的？”~
@103326 = ~娜西拉似乎有些吃惊，“这不是个小问题。先告诉我你的感觉。”~
@103327 = ~“为什么我要追随她？”他看着远处，回想着。“我想……我知道我需要帮助，并且我知道她会帮助我。”~
@103328 = ~“那么她之所以会那样做只是因为我需要。”~
@103329 = ~瓦伦的目光和娜西拉的目光交织在一起很长时间，然后他移开看着别处，显得很尴尬，“对不起。我的怀疑是愚蠢的。”~
@103330 = ~“不，你的怀疑并不愚蠢。自从我来了以后，你一直在保护着先知。你应该这样，我想要你这样。我很高兴她有你在身边。”~
@103331 = ~他缓缓点了点头。“但是我现在不在她身边，不是吗？”然后两人都显得不高兴了，但是他们没有再说什么了。~
@103332 = ~“有件事情我很感兴趣，德金。你说过你之前的主人是条龙，是吧？一条白龙？”~
@103333 = ~德金点点头，心不在焉地检查着他的指甲。“是的，泰莫法拉又大又白。”~
@103334 = ~“你知道白龙众多龙族里最弱的一种吗？”~
@103335 = ~“是吗？这并不意味着什么。以前的主人比小小的德金要强壮，他甚至比你也要强壮。”~
@103336 = ~瓦伦咯咯地笑着，觉得很有趣。“我真得很怀疑那一点。这个泰莫法拉，它是条年迈的龙吗？一条巨大而有年迈的龙？”~
@103337 = ~“不是的。泰莫法拉年轻力壮，争强好斗。并且可能有点胖。”~
@103338 = ~“那么它不会是我的对手，小狗头人。在我的一生中我和不止一条的龙战斗过。”~
@103339 = ~德金停下检查他的指甲，看着瓦伦，咧嘴笑着。“德金记得曾有个一袭白衣的大个子圣武士闯进旧主人的洞穴。他发誓要杀死旧主人。”~
@103340 = ~“旧主人翻滚着，呻吟着说它要死了。它说它的一生作恶多端，是一条邪恶的龙，它只想能够忏悔它的罪恶。圣武士同意了，于是它开始忏悔。”~
@103341 = ~瓦伦转了转眼珠说，“我想那就是你的龙主人吃他的时候吧？”~
@103342 = ~“不是的。旧主人作了很多忏悔。它整晚说了很多故事……他和圣武士呆在一起，一边喝酒一边发笑。他们成了好朋友，圣武士堕落了。”~
@103343 = ~“最近一次德金听说这个圣武士的时候，他正在入侵某地的一个国家。”~
@103344 = ~“我几乎确信你不在说真话。”~
@103345 = ~“是吗？你就像圣武士一样。你不知道什么时候放松和欢笑，什么时候又该担心和严肃。”~
@103346 = ~瓦伦想要回答，但是突然放弃了，并转身走开。~
@103347 = ~“狗头人，我有一个问题问你。”~
@103348 = ~德金转过身来，睁大眼睛惊奇地盯着瓦伦。“你有问题要问德金？”~
@103349 = ~瓦伦磨着他的牙齿说：“是的，是一个问题，并且只有一个问题。如果你试图凭你的愚蠢使之跑题的话，我就会把你的头砍下来。”~
@103350 = ~“你把德金的头砍下来，德金就不能回答你的问题了。”~
@103351 = ~“是的，呃……这个险我不得不冒。我的问题是：你一直在唱这首歌是从哪里学到的？”~
@103352 = ~“你是说毁灭之歌？”~
@103353 = ~“是的，就是它。它老是在我的脑海里回荡，我发誓它要把你弄疯了。你是在哪里学到的？这是个吟游诗人的把戏吗，想要把敌人引入一种发疯似的愤怒中？”~
@103354 = ~德金耸耸肩，说：“一天当德金处在沙漠中的时候创作了它。德金在想，德金和头面临厄运了。”~
@103355 = ~瓦伦盯着德金很长一段时间，他的牙齿的研磨清晰可闻。“就是这样的？”~
@103356 = ~“你有比一个还多的问题？”~
@103357 = ~“没有，”瓦伦后退了一步。“我没有。就当我什么都没说吧。”~
@103358 = ~“没关系。”~
@103359 = ~“我想我们应该各走各的路。”~
@103360 = ~“没关系，和我在一起吧。”~
@103361 = ~“在这儿等着，直到我回来为止。”~
@103362 = ~“你走吧。也许我们以后会见面的。”~
@103363 = ~“我想要改变你的战术。”~
@103364 = ~“现在我什么也不想改变。”~
@103365 = ~“我要你现在把所有见到的陷阱都放在一边不要管。”~
@103366 = ~“我想要你解除任何你看到的陷阱。”~
@103367 = ~“不要再试图潜行了。”~
@103368 = ~“保持潜行，但是只在下一场战斗来临前。”~
@103369 = ~“试图一直保持潜行。”~
@103370 = ~“如果我没能打开锁着的门或者箱子，不要帮助我。”~
@103371 = ~“如果我没能打开锁着的门或者箱子，帮助我。”~
@103372 = ~“我想要改变你离我身边的距离。”~
@103373 = ~保持远距离。~
@103374 = ~保持中距离。~
@103375 = ~靠近我。~
@103376 = ~“只要你一看到敌人就上前攻击。”~
@103377 = ~“保护我，在我动手之前不要进攻。”~
@103378 = ~“我想要调整你的装备。”~
@103379 = ~“你能鉴定我的装备吗？”~
@103380 = ~“你刚才想要说什么？”~
@103381 = ~“停下来交谈一会儿吧。”~
@103382 = ~“暂且就说到这里。”~
@103383 = ~“没，没别的事了。”~
@103384 = ~“你要怎么做呢？有什么不对劲吗？”~
@103385 = ~“当这一切都结束后，你打算怎么办？”~
@103386 = ~“你还要做什么？”~
@103387 = ~“不，我觉得你应该独自旅行。”~
@103388 = ~“只要你同意娜西拉和我在一起。”~
@103389 = ~“当然，我很高兴你能加入我。”~
@103390 = ~“随你怎么做，我不会阻止你。”~
@103391 = ~“你可以一直和我旅行下去。”~
@103392 = ~“你的立场不是站在我这一边吗？”~
@103393 = ~“不是真的这样。我们没有必要在行着的每个时刻都在一起。”~
@103394 = ~“你认为你能那么轻易就能脱离我吗？”~
@103395 = ~“我很高兴你能在我这边，瓦伦。”~
@103396 = ~“我不想让你为我放弃一切。”~
@103397 = ~“哈！那里并没有那么快！”~
@103398 = ~“你就让我来考虑那事吧。”~
@103399 = ~“我是个冒险者，现在还没有时间考虑那其中任何一件事~
@103400 = ~“让我们享受现在所拥有的吧，我们可以以后再考虑它。”~
@103401 = ~“婚姻和小孩听起来似乎很棒……终于这样了。”~
@103402 = ~“那得依情形而定。你是怎么想的？”~
@103403 = ~“这显然太早了。实际上我们才刚刚认识！”~
@103404 = ~“一点也不。让我们现在就开始吧。”~
@103405 = ~“告诉我你在地面的生活时光。”~
@103406 = ~“比如？”~
@103407 = ~“你不能分辨他们是邪恶的家伙？”~
@103408 = ~“我相信那事可以发生在任何人身上。”~
@103409 = ~“哈哈……”~
@103410 = ~“你做了什么？”~
@103411 = ~“你相信你做的是对的。”~
@103412 = ~“你不能永远躲藏下去。”~
@103413 = ~“我相信你最终会弄明白的。”~
@103414 = ~“不管怎样，大多人都不习惯长角的泰夫林人在身边跑来跑去。”~
@103415 = ~“看来似乎放松你并不安全。”~
@103416 = ~“为什么不放了这个圣武士？这并不是它的过错。”~
@103417 = ~“什么？！你把他们都杀了？！你怎么能这样？！”~
@103418 = ~“你怎么能这么容易上当？”~
@103419 = ~“告诉我你是怎样逃离哥利马杉的？”~
@103420 = ~“结果发生了什么？”~
@103421 = ~“塔受到了攻击？这岂不是让你处于更加危险的境地？”~
@103422 = ~“那么你全凭运气逃了出来？”~
@103423 = ~“接下来发生了什么？”~
@103424 = ~“哈。人性有哪些地方如此有用？”~
@103425 = ~“我自己更喜欢一个聪明的男人。或者是一个强壮的男人。”~
@103426 = ~“说起那件事好像显得很愚蠢。”~
@103427 = ~“我想你是个好人，瓦伦。”~
@103428 = ~“你害怕会孤单的死去吗？”~
@103429 = ~“但是你那恶魔的一半不是很有用吗？”~
@103430 = ~“你是否害怕过你会再次失去你的人性？”~
@103431 = ~“你怎么能打败如你所说那么强大的恶魔？”~
@103432 = ~“哥利马杉追捕着你吗？”~
@103433 = ~“你喜欢这样？”~
@103434 = ~“于是你直接跑到先知这边来了？”~
@103435 = ~“你多大了？”~
@103436 = ~“你怎么会不知道？”~
@103437 = ~“那么你是怎样逃离深渊魔域的？”~
@103438 = ~“什么样的忙？”~
@103439 = ~“也许你可以……展示给我看？”~
@103440 = ~“告诉我更多你在深渊魔域的时光。”~
@103441 = ~“好吧，如果你感到尴尬，就不必……”~
@103442 = ~“我感到厌倦了，它应该把时间打发过去了。”~
@103443 = ~“我很好奇。我发现你的过去很有趣。”~
@103444 = ~“我想要知道的就这些了。”~
@103445 = ~“你曾经……恋爱过吗？”~
@103446 = ~“回答这个问题，不要回避。”~
@103447 = ~“这只是简单的问题。会有什么伤害？”~
@103448 = ~“如果你不想回答的，你可以不回答。”~
@103449 = ~“似乎有道理。”~
@103450 = ~“她是谁？”~
@103451 = ~“以后就再也没有过别人了？”~
@103452 = ~“我想要知道的就这些了。”~
@103453 = ~“就那样了？你把她忘掉了？”~
@103454 = ~“你甚至没有试图救她？”~
@103455 = ~“我很抱歉。”~
@103456 = ~“你是如何幸存下来的？”~
@103457 = ~“只有笨蛋才会对他所遭遇的事情没有问题。”~
@103458 = ~“嗯，我也很感谢你在这里。”~
@103459 = ~“如果我是你，我也不会。”~
@103460 = ~“也许是因为诸神的眷顾？”~
@103461 = ~“在深渊魔域中像你这样的多吗？”~
@103462 = ~“你在被抓之前是干什么的？”~
@103463 = ~“我想问你点别的。”~
@103464 = ~“你是怎么被抓住的？”~
@103465 = ~“这么说你是个小偷？”~
@103466 = ~“那应该很不容易。”~
@103467 = ~“我猜你做了你必须要做的事情。”~
@103468 = ~“这么说你不但偷东西，而且还引以为傲？多么有个性啊。”~
@103469 = ~“你的母亲是怎么死的？”~
@103470 = ~“你不相信？”~
@103471 = ~“也许那样更好。”~
@103472 = ~“你为他报仇了吗？”~
@103473 = ~“那太可怕了！”~
@103474 = ~“她做了什么？”~
@103475 = ~“对不起。”~
@103476 = ~“印记城是什么？我从没听说过。”~
@103477 = ~“卓尔对你的领导能力有什么评价？”~
@103478 = ~“听来似乎很惊令人奇，她们居然会同意听你的。”~
@103479 = ~“一个有着一对漂亮犄角的人？”~
@103480 = ~“我知道泰夫林人是什么样的。”~
@103481 = ~“那么告诉我泰夫林人是怎么样的。”~
@103482 = ~“一点也不。你很英俊。”~
@103483 = ~“不，我并不知道。”~
@103484 = ~“是的，当然。”~
@103485 = ~“是的。我知道某种东西从你身上消逝了。”~
@103486 = ~“不，那样没有必要。”~
@103487 = ~“我并没有意识到你会有军事协约。”~
@103488 = ~“那么，你也许救了他们。你给我留下了深刻的印象。”~
@103489 = ~“这么说你从没有真正赢得一场战斗？”~
@103490 = ~“发生了什么事？”~
@103491 = ~“我并不需要听它。”~
@103492 = ~“事情并不顺利？”~
@103493 = ~“也许那样是最好的。”~
@103494 = ~“你的血统让你邪恶吗？”~
@103495 = ~“我一点也不喜欢那声音。”~
@103496 = ~“那么我必须要把你看紧点。”~
@103497 = ~“那么我会根据你的行动来判断你。”~
@103498 = ~“如果你在挣扎的话，那么我能问的就这些。”~
@103499 = ~“实际上，我发现它非常让人感兴趣。”~
@103500 = ~“我看人是通过他的行为，不是他的血统。”~
@103501 = ~“没有。它应该造成烦扰吗？”~
@103502 = ~“那样不会让你的工作更加困难吗？”~
@103503 = ~“那么为什么你要关心他们的遭遇？”~
@103504 = ~“你并不那样认为？”~
@103505 = ~“我想了解你更多的情况。”~
@103506 = ~“你想要知道什么？”~
@103507 = ~“没什么。”~
@103508 = ~“不，还没有。呆在这里。”~
@103509 = ~“是的，来吧。”~
@103510 = ~“时机并不好，瓦伦。”~
@103511 = ~“当然了，瓦伦。你想谈什么？”~
@103512 = ~“控制住你自己！”~
@103513 = ~“你的意思是什么？”~
@103514 = ~“如果你使得我们都丧命了，那么我不会再和你交往！”~
@103515 = ~“控制好自己！”~
@103516 = ~“是的，你会认为他们也有和你一样的麻烦。”~
@103517 = ~“你能够坚持住吗？”~
@103518 = ~“也许你是对的。也许你该留在这里。”~
@103519 = ~“没有，算了吧。我不会把你留在这里。”~
@103520 = ~“你愿意那样去做？我很感激，但是那没有必要。”~
@103521 = ~“是的，也许那样比较好。”~
@103522 = ~“我需要你和我在一起。你不能留在后面。”~
@103523 = ~“我不会把你留在九渊地域。别胡想了。”~
@103524 = ~“我不会把你留在后面的，亲爱的。永远。”~
@103525 = ~“这不是某种多情的表白吧，是不是？”~
@103526 = ~“刚刚已经说出来了。”~
@103527 = ~“确切地说，我为什么要在意你的想法？”~
@103528 = ~“你在开玩笑吗？我只是因为命令才帮助你的。”~
@103529 = ~“他们都可能死掉。你也会和他们一起死去。”~
@103530 = ~“我很想要阻止靡菲斯特，这是真的。”~
@103531 = ~“我想离开九渊地域。就这个想法。”~
@103532 = ~“我有个奖励要给你，这就是我所关心的。”~
@103533 = ~“谢谢你。即使没有指令我也应该帮助你。”~
@103534 = ~“我们还要对付靡菲斯特。”~
@103535 = ~“不要作个白痴。你是到这里来帮我的，事情就是这样。”~
@103536 = ~“我们称不上朋友，瓦伦。”~
@103537 = ~“朋友？当然。我喜欢那样。”~
@103538 = ~“如果你想，我愿意不只是做朋友。”~
@103539 = ~“你认为你能比我做得好？哈！”~
@103540 = ~“我明白了。照你的方式行事吧。”~
@103541 = ~“没什么。我理解。”~
@103542 = ~“脱掉那件铠甲，这样我们就能靠得更近了。”~
@103543 = ~“我知道。我只是在开玩笑，瓦伦。”~
@103544 = ~“哦，没什么。继续吧，你这让人扫兴的家伙。”~
@103545 = ~“那可太糟了。我对你一点感觉都没有。”~
@103546 = ~“我……只觉得你是朋友，瓦伦。对不起。”~
@103547 = ~“好的……”~
@103548 = ~“当然了。”~
@103549 = ~“我对你也感到很亲切，瓦伦。”~
@103550 = ~“我……不知道自己到底感觉怎样，瓦伦。发生的太快了……”~
@103551 = ~“我也爱你，瓦伦。”~
@103552 = ~“我们还有很多事要做。第一件就是对付靡菲斯特。”~
@103553 = ~“你觉得我们之间发生了什么，瓦伦？”~
@103554 = ~“在哪方面觉得亲近？”~
@103555 = ~“那是什么？”~
@103556 = ~“那是一件很可怕的事吗？”~
@103557 = ~“实际上，我从没有过多地想过它。”~
@103558 = ~“并不是的。我从没有深信过任何事。”~
@103559 = ~“是的，我忠诚于我的信仰，你必须知道这一点。”~
@103560 = ~“你有你的观点，我有我的信仰，让我们各行其是吧。”~
@103561 = ~“没有，我觉得它一点也不冒犯人。”~
@103562 = ~“那要看情况而定。你打算离开吗？”~
@103563 = ~“不？如果你喜欢那里为什么还要留下来？”~
@103564 = ~“那么你至少应该尽所能了解我们。”~
@103565 = ~“那么你应该适应我们的方式。”~
@103566 = ~“你不能改变你是谁，瓦伦。”~
@103567 = ~“我不认为了解我们的方式有什么害处。”~
@103568 = ~“是的，我很愿意那样。”~
@103569 = ~“不，如果没有必要，我并不想再和你呆在一起。”~
@103570 = ~“做你想做的，我不会阻止你。”~
@103571 = ~“为什么你要问我？”~
@103572 = ~“问别人吧。”~
@103573 = ~“神仍然比你所想像的要强大，不是吗？”~
@103574 = ~“我觉得你并不知道你到底在说什么？”~
@103575 = ~“当然。我是所奉之神的仆人。你不知道吗？”~
@103576 = ~“那么让我们来听听它。”~
@103577 = ~“我并不想要你那愚蠢的道歉。”~
@103578 = ~“道歉？为了什么？”~
@103579 = ~“还有？就这样了？”~
@103580 = ~“哦，没关系。我想那样也行。”~
@103581 = ~“我想要你跪下，笨蛋。”~
@103582 = ~“*那*就是你对一个女性的道歉？”~
@103583 = ~“也许。为一个吻。”~
@103584 = ~“是的。这一次……你摆脱开了。”~
@103585 = ~“也许有一点。”~
@103586 = ~“当然不是的！”~
@103587 = ~“好吧。你脱身了。”~
@103588 = ~“我想我应该得到比那样的道歉更多的。”~
@103589 = ~“哈！算了吧。”~
@103590 = ~“谢谢你。是的。”~
@103591 = ~“谢谢你，瓦伦。我欣赏你的率直。”~
@103592 = ~“关于魔王你知道些什么情况？”~
@103593 = ~“是什么让你觉得我不会背叛你呢？”~
@103594 = ~“当然不是。但是你还不了解我。”~
@103595 = ~“不。算了吧。”~
@103596 = ~“我想是的。”~
@103597 = ~“并不是的。我只是不喜欢你。”~
@103598 = ~“要是能摆脱这些诅咒的话，我肯定会这样做的。”~
@103599 = ~“你大可尽情道歉。我并不需要它。”~
@103600 = ~“我并不想谈论他。”~
@103601 = ~“是的，我真地想忽视你。”~
@103602 = ~“有什么事能这么重要？你仍然觉得我会背叛她？”~
@103603 = ~“好吧，继续。我只是在开玩笑。”~
@103604 = ~“好吧。我自己有些关于她的问题。”~
@103605 = ~[呻吟]“为什么？为什么是现在？”~
@103606 = ~“为什么？你仍然觉得我会背叛她吗？”~
@103607 = ~“这是个性别问题吗？就像所有的男人是怎样成为猪的？”~
@103608 = ~“你应该是对的。我不清楚那是什么。”~
@103609 = ~“我知道血战是怎么回事？”~
@103610 = ~“你是怎样被招募的？”~
@103611 = ~“这事持续了多长时间？”~
@103612 = ~“我非常抱歉。那听起来似乎很可怕。”~
@103613 = ~“继续你的故事吧。”~
@103614 = ~“她来到深渊魔域？”~
@103615 = ~“然后发生了什么？”~
@103616 = ~“哦。我并没意识到你们有*那样*一种关系。”~
@103617 = ~“这就是要告诉我的重要事？”~
@103618 = ~“干得好。谢谢你的提示。”~
@103619 = ~“我明白，瓦伦。我们都在做我们必须要做的事。”~
@103620 = ~“我不会背叛任何人，瓦伦。你必须要信任我。”~
@103621 = ~“我们又再次回到那个问题了？”~
@103622 = ~“通过把你变成他的私人保镖？”~
@103623 = ~“你的主人不想把你弄回来？”~
@103624 = ~“我知道这将要跑到哪里去。快点。”~
@103625 = ~“考虑到你现在所处的地方，那不是件轻松的事。”~
@103626 = ~“但是她还什么事都没对你做。”~
@103627 = ~“如果你不喜欢它，为什么你还要战斗呢？”~
@103628 = ~“也许我可以通过杀掉你来回答那个问题。”~
@103629 = ~“那是个粗鲁的问题，不是吗？”~
@103630 = ~“你的意思是什么？”~
@103631 = ~“根据你的先知的判断，我才是胜利者。”~
@103632 = ~“你的意思是什么，瓦伦？”~
@103633 = ~“如果你觉得有必要沉思，请到别的地方去做。”~
@103634 = ~“不管你或者她怎么样，我都会把它做完。”~
@103635 = ~“你不相信她的远见？”~
@103636 = ~“意味着什么？”~
@103637 = ~“我敬佩你的奉献精神。”~
@103638 = ~“那样显得你太自以为是了。”~
@103639 = ~“我怎样才能在执行这个命令的同时又去做那件事呢？”~
@103640 = ~“当然是。如果我要死去了，那么我会违背这个命令。”~
@103641 = ~“我不知道。”~
@103642 = ~“不。我说过我会做这事的，我会的。”~
@103643 = ~“我会离开的。这事与我一点关系也没有。”~
@103644 = ~“也许不。我就是不喜欢被人强迫着做事。”~
@103645 = ~“我不关心黑暗精灵会发生什么事。我到这里来是要阻止瓦纱瑞丝。”~
@103646 = ~“你认为我会背叛他们？”~
@103647 = ~“如果你不那么信任我，那为什么会在这里？”~
@103648 = ~“是的。继续前进，离开这里。”~
@103649 = ~“我需要一个能够信任的伙伴。”~
@103650 = ~“没有。你呢？”~
@103651 = ~“你从我这里想要什么？我不背叛你的承诺？”~
@103652 = ~“不是。”~
@103653 = ~“是的。”~
@103654 = ~“不管怎样，处在这个命令下我什么也不能做。”~
@103655 = ~“也许是。”~
@103656 = ~“我并没有要求成为负责人？”~
@103657 = ~“我会一直把这个任务坚持到底，我向你保证。”~
@103658 = ~“阻止瓦纱瑞丝是唯一重要的事。”~
@103659 = ~“我不是到这里来帮助人的。如果我拒绝了又怎样？”~
@103660 = ~“难道这对你一点意义都没有吗？让我成为负责人的是你的先知。”~
@103661 = ~“我会尽最大的努力。就像我说的，我并没有要求这样。”~
@103662 = ~“你看到什么队伍了吗？我负责掌管什么？”~
@103663 = ~“如果我拒绝呢？”~
@103664 = ~“那真有点戏剧性，不是吗？”~
@103665 = ~“除了我的魅力和美丽之外？”~
@103666 = ~“你看起来有些悲伤。”~
@103667 = ~“我们没时间处理这事了，瓦伦。”~
@103668 = ~“让我们走。”~
@103669 = ~[德金]“鳞歌者伊谢利亚……”~
@103670 = ~“没什么。别在意……”~
@103671 = ~“相信你自己，德金。”~
@103672 = ~“你善良，聪颖，有趣，再也用不着我了。如果我死了，你也会过得很好。”~
@103673 = ~“如果我能帮上忙，情况就不一样。来吧，让我们去完成冒险。”~
@103674 = ~“让你的灵魂向我臣服吧，小东西！”~
@103675 = ~“如果这意味着失去你，那么答案是不。”~
@103676 = ~“是的，我敢断定。”~
@103677 = ~[艾瑞贝丝]“双魂瓦达莉亚……”~
@103678 = ~“没什么。别在意……”~
@103679 = ~“不要对无冬城发生的事感到内疚。”~
@103680 = ~“你是对的，我不会向你提那个要求。”~
@103681 = ~“你难道不明白吗？这是你的赎罪……没什么了……”~
@103682 = ~“我只是不想看到你如此受罪。”~
@103683 = ~“是的，艾瑞贝丝。死去并且冰冷……~
@103684 = ~“让你的灵魂向我臣服吧！”~
@103685 = ~“如果这意味着失去你，那么答案是不。”~
@103686 = ~“是的，我敢断定。”~
@103687 = ~“我命令你追求邪恶，不是善良。”~
@103688 = ~“我命令你爱我……”~
@103689 = ~“没什么。别在意……”~
@103690 = ~“不要对无冬城发生的事感到内疚。”~
@103691 = ~“让你的灵魂向我臣服吧！”~
@103692 = ~“如果这意味着失去你，那么答案是不。”~
@103693 = ~“是的，我敢断定。”~
@103694 = ~“我命令你追求善良，不是邪恶。”~
@103695 = ~“我命令你爱我！”~
@103696 = ~“就是这些了，艾瑞贝丝。”~
@103697 = ~[娜西拉]“寻天者奎霏莉亚……”~
@103698 = ~“目前还没什么。”~
@103699 = ~“让你的灵魂向我臣服吧！”~
@103700 = ~“如果这意味着失去你，那么答案是不。”~
@103701 = ~“是的，我敢断定。”~
@103702 = ~“我让你和我紧紧相连，做我永远的爱人！”~
@103703 = ~“我毫不在意你的愤怒。我欠你的，身体和灵魂上都有。”~
@103704 = ~“你发疯的时候是如此的性感，亲我一下吧！”~
@103705 = ~“原谅自己过去所犯下的罪行吧。”~
@103706 = ~“我不会做任何伤害你的事，娜西拉。”~
@103707 = ~[瓦伦]“恶魔斗士奥斯卡辛……”~
@103708 = ~“目前还没什么。”~
@103709 = ~“让你的灵魂向我臣服吧！”~
@103710 = ~“如果这意味着失去你，那么答案是不。”~
@103711 = ~“我们之间暂时两清了。”~
@103712 = ~“对不起，亲爱的，但这是为了我们。”~
@103713 = ~“是的。”~
@103714 = ~“我让你和我紧紧相连，做我永远的爱人！”~
@103715 = ~“嗯……也许不是。”~
@103716 = ~“你听到我了。”~
@103717 = ~“你没有让我害怕。我欠你的，身体和灵魂上都有。”~
@103718 = ~“你发疯的时候是如此的性感，亲我一下吧！”~
@103719 = ~“我特此解除你身上的恶魔的污点。”~
@103720 = ~“没什么。”~
@103721 = ~“很高兴你喜欢它，现在把你的灵魂给我。”~
@103722 = ~“好的。现在，作为回报，你将成为我永远的爱人。”~
@103723 = ~“那么我们还有希望吗？~
@103724 = ~“它给人的感觉真的不一样吗？”~
@103725 = ~“我很高兴，你的确得到了它。”~
@103726 = ~“对，你因为自己的人性而害怕，正在散失希望。就是这么回事。”~
@103727 = ~“我只想赶到靡菲斯特那里，仅此而已。”~
@103728 = ~“我只是对你的抱怨有些厌倦。”~
@103729 = ~“我是你的朋友，瓦伦。但是在这件事情上我帮不了你。”~
@103730 = ~“我是你的朋友。我很抱歉。”~
@103731 = ~“先知不是已经帮你克服它了吗？”~
@103732 = ~“聊得够多了，我想要找到靡菲斯特。”~
@103733 = ~“情况迟早会变好的。”~
@103734 = ~“如果你能允许，我可以帮你处理那件事。”~
@103735 = ~“难道我们爱不能给你带来丝毫的希望吗？”~
@103736 = ~“我不知道，瓦伦。”~
@103737 = ~“如果你一直像这样抱怨个不停就不会。”~
@103738 = ~“让我们勇敢地接受到来的每一天吧，瓦伦。”~
@103739 = ~“希望永存。”~
@103740 = ~“收割者总是把它称作自己的领地，而不是别的什么。”~
@103741 = ~“他是我们的盟友，你只需要知道这点。”~
@103742 = ~“我不知道他是什么。也许是恶魔？他就是。”~
@103743 = ~“不要再问了。收割者是我们的盟友，你只需要知道这点。”~
@103744 = ~“不……实际上并不是这样。他说了一些关于一个结界的事情，但是我并没有弄明白。”~
@103745 = ~“这地方是一个结界，或者是收割者所说的结界。对此我觉得自己不很了解。”~
@103746 = ~“收割者说他的领地是一个结界，与很多地方相连，但是事实并不是这样。”~
@103747 = ~“你为什么不亲自问问他呢？”~
@103748 = ~“你喊完了没有？我想试着找到出路离开这里。”~
@103749 = ~“那么你一定知道关于这个地方的一些情况？”~
@103750 = ~“如果你不攻击，也许他们也不会。”~
@103751 = ~“九渊地狱似乎有些……冷，不是吗？”~
@103752 = ~“你的第一个线索是什么？”~
@103753 = ~“那样帮助很大。要不是你在这里指出这显而易见的事实，我可真不知道该怎么办好？”~
@103754 = ~“那么我们最好先检查一下。”~
@103755 = ~“他们只要有任何企图，我都会把他们全部杀掉！”~
@103756 = ~“当我杀到主脑那里时，它就会与我谈判了！”~
@103757 = ~“我该用什么来保护我的心智呢？”~
@103758 = ~“那你的心智呢？”~
@103759 = ~“这样我们就没什么麻烦了。”~
@103760 = ~“如果你是我的奴隶，那你必须为我做饭，打扫卫生吗？”~
@103761 = ~“但是如果我喜欢自己的男人是黑皮肤，而且比较深沉呢？”~
@103762 = ~“看来驯服你是件有趣的事。”~
@103763 = ~“够了，让我们继续前进吧。”~
@103764 = ~“我不是那个意思。不要具有这样的防备心理！”~
@103765 = ~“你生气的时候看起来很可爱。”~
@103766 = ~“我的！你不但很情绪化，而且防备心很强！”~
@103767 = ~“我已经注意到关于你的情况。”~
@103768 = ~“相信我，这不是赞美。让我们继续前进吧。”~
@103769 = ~“不。很多时候你都显得阴沉而又多疑。”~
@103770 = ~“是的，这是一种赞美。我想驯服你是件有趣的事。”~
@103771 = ~“这件头盔会保护你不受它们的伤害。”~
@103772 = ~“我不会害怕一小撮僵尸！”~
@103773 = ~“你觉得这个神殿了会有不死生物？”~
@103774 = ~“你非得说些常说些不重要的事情吗？”~
@103775 = ~“不管我们找到什么，我都会摧毁它！”~
@103776 = ~“别担心，在那里我会小心行事的。”~
@103777 = ~“你不觉得这可能是个陷阱吗？”~
@103778 = ~“那么他们可能是奴隶。”~
@103779 = ~“如果只是站在这里，我们就没法到达底部。”~
@103780 = ~“我们必须进行调查，找出真相。”~
@103781 = ~“也许他们的本性不像他们所看起来的那样。”~
@103782 = ~“那又怎样？谁在乎？”~
@103783 = ~“很好，现在我们不需要担心敌人的咒语会杀死我们了。”~
@103784 = ~“让魔法死亡的区域？这怎么可能呢？”~
@103785 = ~“如果我们四下里看看，也许会了解得更多些。”~
@103786 = ~“也许是某个早已被遗忘的种族所留下的。”~
@103787 = ~“快点。我们越快找到眼魔暴君，这一切就结束的越快。”~
@103788 = ~“什么事？你受惊了吗？”~
@103789 = ~“也许这里也有奴隶。”~
@103790 = ~“别担心，我会睁大眼睛，提高警惕的。”~
@103791 = ~“呵呵呵。”~
@103792 = ~“你害怕了吗，泰夫林？”~
@103793 = ~“到现在为止我还没有碰到任何我处理不了的事情。”~
@103794 = ~“没人说这会很容易。”~
@103795 = ~“我想现在就进入地下迷宫，除非你还有更多无用的建议想要说。”~
@103796 = ~“我会小心的。”~
@103797 = ~“你觉得我很特别？我觉得你也很特别。”~
@103798 = ~“我会小心的。”~
@103799 = ~“那么我们怎样才能跨过它呢？”~
@103800 = ~“你觉得这条河将阻挡住瓦纱瑞丝的队伍？”~
@103801 = ~“没有必要，我已经很熟悉幽暗地域的特点了。”~
@103802 = ~“我想我已经有了一个好主意了，谢谢你。”~
@103803 = ~“我很高兴听听你所知道的信息。”~
@103804 = ~“我希望你也能为我这样做。”~
@103805 = ~“是的，让我们走吧。”~
@103806 = ~“暂时呆在这里。”~
@103807 = ~“这不是你的过错，不要担心。”~
@103808 = ~“保持濒死状态，那么也许我会另作决定。”~
@103809 = ~“我需要你的战斗技能。不要再次发生这种事了。”~
@103810 = ~“我永远不会丢下你的，亲爱的。”~
@103811 = ~作为凡人和永生者的后代，半天界生物是一种神秘生物。~
@103812 = ~半龙生物总是比他们的同伴更让人敬畏，他们的外貌表明了其龙族的血统。~
@103813 = ~恶魔和魔鬼们有时把他们的后代带到物质界来肆虐横行……~
@103814 = ~一个勉强可见的非物质的生物形体随着风在飘移……~
@103815 = ~据说贾斯帕爵士，一个圣武士和托姆最忠诚的侍者之一，在他将要出发去杀死一条强大的红龙时，从一个神秘陌生的狗头人那里得到了这个头盔。不幸地是，贾斯帕爵士弄错了龙的颜色，这个头盔的真实属性确实可以帮助他对付一条红龙，但是结果却让他在面对白龙泰莫法拉的强力龙息攻击时变得脆弱不堪。~
@103816 = ~这是一件长袍。~
