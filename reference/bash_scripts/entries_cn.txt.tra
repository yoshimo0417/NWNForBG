@104210 = ~5*~
@104211 = ~1*~
@104212 = ~发动投石器。~
@104213 = ~这里怎么了？发生了什么事？~
@104214 = ~“当灵吸怪抓住我的时候，我从没想过还能再次看到太阳。但是既然这一切都结束了，先知的侦察队会把我重新带到地面。”~
@104215 = ~“我唯一的遗憾就是对你的救命之恩没法给予报答，<CHARNAME>。我所能给的就是我永恒的感激。”~
@104216 = ~你认出这名女性就是你曾帮助她从灵吸怪之城佐瓦柯穆逃脱的奴隶。显然，她设法把你的消息告诉了先知。她微笑地看着你靠近。~
@104217 = ~“<CHARNAME>……我很高兴你在这里，这让我有机会谢谢你。如果你没有让我把你的消息传递给先知，那么我将仍然是灵吸怪的奴隶。~
@104218 = ~“一打败瓦纱瑞丝，先知就承诺派人把我送到地面上去，如果没有你，<CHARNAME>，这将是不可能的。谢谢你。”~
@104219 = ~你应该和先知说话。~
@104220 = ~“看看这些伊丽思璀的可怜虫们。我搞不懂为什么玛露恩主母会把我们的命运和你们系在一起。”~
@104221 = ~“别理他们。伊丽思璀教导我们即使是在憎恨面前也要保持忍让和接受。”~
@104222 = ~“听听这些懦夫所说的——一个全由这类人组成的队伍根本没法阻止瓦纱瑞丝！依我说让我们给这些可怜虫一个教训！”~
@104223 = ~一个伊丽思璀的追随者注意到你站在旁边。“我们相信先知的智慧，瓦纱瑞丝将会被打败。<CHARNAME>·<CHARNAME>将会带领我们走向胜利。”~
@104224 = ~“是这样吗？好的，地表人……当你有着像伊丽思璀的追随者这样一帮和平主义者和你在一起时，你怎样才能赢得战争呢？”~
@104225 = ~“哈！又一个和平主义者……正是麦维尔家族所需要的。”~
@104226 = ~“噢，头。看来有人憋足了劲想要打一场。”~
@104227 = ~这个泰夫林不经意地把手放在武器手柄上。“你确实想这样做吗？我自己知道一些教训……我很高兴能把他们交给你。”~
@104228 = ~娜西拉步上前去，眼睛里闪烁着危险的光芒。“行事小心点，你这个臭男人！伊丽思璀的追随者会尽可能地避免暴力，但是在受到压迫时仍然会勇敢战斗。”~
@104229 = ~黑暗精灵不情愿地后退了一步，然后很快地再次镇定下来。“来吧，让我们前进吧。这一天我已经受够了先知的追随者了。”~
@104230 = ~“伊丽思璀的追随者知道怎样战斗，而且他们现在就要证明这一点！”~
@104231 = ~“哈，把这些和平主义者除掉吧，免得他们使我们在战斗中失败。”~
@104232 = ~“这种愚蠢的内耗只会让我们更加容易失败。”~
@104233 = ~“你没有多少盟友……你最好对他们好点。”~
@104234 = ~“也许你并没有那么坏，地表人。至少当你看到懦夫时，你认识他们。”~
@104235 = ~“我仍然不喜欢让先知的和平主义者和我们站在一边，但是因为有你在这里，也许我们还有一丝希望。”~
@104236 = ~“你和先知的其他魔宠一样坏。有这样一群和平主义者拖着后腿，你怎能带领队伍取得胜利？在未来的日子里，只有那些能够显示力量的人才能活下来。”~
@104237 = ~“我只希望在战斗开始时，你能比现在更有勇气。”~
@104238 = ~“我不知道为什么你挑起与麦维尔家族的争斗，但是我们承受不起杀死自己盟友的损失！瓦纱瑞丝的军队已经是我们军队的两倍了。”~
@104239 = ~“先知相信你是唯一能从瓦纱瑞丝手下拯救我们的人，但是你的行为让我怀疑她是不是看错了你。”~
@104240 = ~“谢谢你帮助我们。麦维尔家族坚持要和我们打仗，尽管我们努力避开他们。要不是你插手，我想战斗在所难免。”~
@104241 = ~“我很高兴你能明白有必要联合起来反对瓦纱瑞丝。先知将她的信任给予你，真是非常英明。”~
@104242 = ~这些卓尔在和这斯涅布力仆人进行一场喝酒比赛。地底侏儒看起来好像并不喜欢这样。“拜托……不要，不要。”~
@104243 = ~“来吧，地底侏儒，喝了它，打破那个记录。”~
@104244 = ~“喔，看他走路的样子。”~
@104245 = ~地底侏儒抬头用痛苦的眼神看着你。“求求你，不要。我再也喝不下了，求求你。”~
@104246 = ~“我们走，地底侏儒，去营里，除非你想变成弓箭手们的靶子。”~
@104247 = ~哦……*嗝*不~
@104248 = ~“你的地底侏儒看起来不太好，我想他可办不到。”~
@104249 = ~“呃，他死了。喝三杯酒给醉死的。我告诉过你他不可能打破记录。”~
@104250 = ~“嗯，你是对的。我欠你一块金条。”~
@104251 = ~泰夫林不满地摇了摇头，“如果先知看到你在这里的表现她也许对你成为我们救世主的看法有所改观。”~
@104252 = ~“太恐怖了，<CHARNAME>！我不能相信你让他们逼着斯涅布力把自己给灌死！”~
@104253 = ~“先知相信你能救我们。但看到你这样，我忍不住怀疑她有没有搞错。”~
@104254 = ~卓尔转过身来面对你，显然被打断所惹毛了，“没看到我们很忙吗？我的地底侏儒再只需四瓶麦芽酒就能打破一天喝酒最多的营地记录了。”~
@104255 = ~“他永远做不到。保持记录的那个地底侏儒是这个矮子身材的两倍，他第二天就由于酒精中毒身亡了！”~
@104256 = ~[成功]卓尔回答之前显得很犹豫，显然意识到他和你不配，“好吧，我可烦透了，来吧，我走。”~
@104257 = ~“谢谢你，好心的<LADYLORD>。*嗝*再多喝一杯我可能就活不成了。请原谅我得离开了。”~
@104258 = ~“当然，老大。可德金不想醒来时在附近，他的头将会很疼。”~
@104259 = ~“你做得挺不错，<CHARNAME>我很高兴看到先知对你的信任没有错。”~
@104260 = ~“那<CHARNAME>，至少你有勇气去抵抗那些暴徒。真的不错。”~
@104261 = ~[成功]“啊，也许这很有道理，另外，我无聊透顶了，让我们去找些其他事干吧。”~
@104262 = ~“德金不认为那个侏儒会再喝多少。你会帮助他吗，老大？”~
@104263 = ~别管他。~
@104264 = ~“嘿，这里是怎么回事？”~
@104265 = ~“来吧，地底侏儒，喝了它，打破那个记录。”~
@104266 = ~[恐吓]“我不会让这个地底侏儒把自己给灌死！”~
@104267 = ~[说服]“够了，在一个奴仆身上浪费好麦芽酒没意义。”~
@104268 = ~“让那地底侏儒一个人呆着吧！”~
@104269 = ~如果你有问题请问里佐维尔大人。~
@104270 = ~司令官又向了你敬了个礼，然后回到他的军队中去了。~
@104271 = ~“我的专业知识很有限。我知道敌人的一些情况，它们和瓦纱瑞丝结成联盟，有眼魔、灵吸怪，还有亡灵。除此之外，我想我什么也不知道了。”~
@104272 = ~“实在没什么可以多讲，你也看到了，我是一个卓尔。如同这里大多数人，我早年在卓尔社会中度过：一个疯子的世界，残忍，失去理智的暴力。”~
@104273 = ~“我在战场上表现突出，我家的主母把我提升到了一个在她军队中非常重要的位置。虽然我很成功，但我觉得我生活中总是有些不对劲的地方。”~
@104274 = ~“卓尔是一个腐败的民族。我们自身的邪恶毁了自己，它吞没了我们。我知道我不得不逃避。我逃离了卓尔社会，追寻伊丽思璀的崇拜者，希望能找到一条好一点的路。”~
@104275 = ~“很及时地，我的寻找把我带到了先知和她的战士身边。现在，我用我的经验去训练其他人，以便他们能在和瓦纱瑞丝和她的军队的交战中发挥作用。”~
@104276 = ~“瓦纱瑞丝掌管了一支庞大的军队，而且这并不只是跟随她的卓尔。她征招了各种幽暗地域生物到她军队里来：眼魔，灵吸怪，甚至还有亡灵。”~
@104277 = ~“我们得到消息，亡灵军队正从西部的洞穴中过来加入瓦纱瑞丝和她的军队。我们怀疑它背后有某个异教组织，虽然我们没有具体情况。”~
@104278 = ~“我们已几次得到亡灵军队行军的消息了，我们试图给它们一个突然袭击，希望能打掉它们一些。但我们还没等到机会，尤其是对那些吸血鬼。”~
@104279 = ~“大部分常规攻击对亡灵军队都没什么作用，甚至魔法有时也无效。就算是我们杀死了一个吸血鬼的首领，它还是会重生的。”~
@104280 = ~“一个死掉的吸血鬼会变成一团迷雾然后就飘走了。杀死它们的唯一办法就是在棺材中抓住它们，然后用一根木棒直捅其黑色心脏。”~
@104281 = ~“问题是我们不知道那些棺材在哪儿。即使我们知道，我们也无法靠近它们。这事更适合像你这样的英雄来做，<CHARNAME>。”~
@104282 = ~“实际上，亡灵军队加入到瓦纱瑞丝和她的军队中去的途中曾经突然停止中断过一次。我想你比我知道得更多。”~
@104283 = ~“你可能因为它们是夺心魔而认识它们……你知道，是那些有触须的怪物。瓦纱瑞丝肯定说服过主脑站到她这边来。”~
@104284 = ~“灵吸怪居住在分散的殖民地，每个殖民地掌控于一个巨形主脑。但是这些区域并不孤立；这些主脑互相交流，一起工作。”~
@104285 = ~“如果这纯粹是一件杀掉一个主脑这么简单的事的话，我只需在西部攻击佐瓦柯穆就行了。但我们还是不能阻止其他灵吸怪加入瓦纱瑞丝。”~
@104286 = ~“如果我们能和主脑协商的话，我们也许能说服它们放弃瓦纱瑞丝，但要这么做，必须有人去佐瓦柯穆。”~
@104287 = ~“你得寻求些方法不让你的思想受到它们的攻击。那些夺心魔身体很弱，但它们能用其非凡的思想来摧毁你的思想。”~
@104288 = ~“当然，它们的力量对那些没有自己思想的生物来说是没用的，像那些亡灵军队或者说是魔像。灵吸怪很害怕那种生物。”~
@104289 = ~“去一个灵吸怪的居住地？你比我勇敢，<CHARNAME>。我最好给你一些提示，以免事情进展不顺利。”~
@104290 = ~“实际上，我认为我们不必再为灵吸怪而担忧了。他们已放弃了瓦纱瑞丝。有人肯定说服了主脑们从战场上撤军。”~
@104291 = ~伊蒙罗狡猾地给你眨了眨眼，“但你不想知道关于这件事的任何情况，不是吗？”~
@104292 = ~“我们得到的信息是这里西部的某个地方，一蜂窝的眼魔已经和瓦纱瑞丝结盟了。那是个坏消息……甚至一个眼魔都不是我喜欢的。”~
@104293 = ~“当然，如果有人把为首的眼魔暴君给杀掉的话，我们的一切问题就都解决了。失去了眼魔暴君，眼魔军队就会溃败，而瓦纱瑞丝也将失去她的眼魔盟军。”~
@104294 = ~“试着使用一些魔法来防御从它们眼中射出的光线。它们的光线能引起痛苦、死亡、瘫痪、衰弱……呃，你知道这些。”~
@104295 = ~“如果有可能，尽量靠近。眼魔们在战场上用它们的目光和咒语，但在近距离的肉搏战中，这些可能就不奏效了。”~
@104296 = ~“老实说，因为你，我们不用再这么害怕眼魔了。眼魔暴君走了，瓦纱瑞丝也就不太可能从它们那里得到支援了。”~
@104297 = ~“恐怕我不能帮你。我们的防线很弱，我无法抽调出一支军队来帮你。况且，普通士兵也帮不上你什么忙。”~
@104298 = ~“我的士兵以数量取胜，但单兵作战能力却很弱。我只希望他们能够抵挡住瓦纱瑞丝的怪物大军。”~
@104299 = ~“这只是对他们自己负责。我看到过，当我们最终摧毁瓦纱瑞丝和她的军队时，将不得不面对的那些敌人。他们需要能够得到的一切训练。”~
@104300 = ~“我走了。”~
@104301 = ~“我想问你些问题。”~
@104302 = ~“对我说说你自己吧。”~
@104303 = ~“你能告诉我一些有关瓦纱瑞丝军队的情况吗？”~
@104304 = ~“告诉我有关亡灵军队的事。”~
@104305 = ~“你们的攻击失败了？”~
@104306 = ~“吸血鬼很难杀掉。”~
@104307 = ~“告诉我有关灵吸怪的情况。”~
@104308 = ~“难道我们不能在他们加入到她军队之前就杀了他们吗？”~
@104309 = ~“主脑？”~
@104310 = ~“和灵吸怪打仗这方面有何建议？”~
@104311 = ~“我可以去和佐瓦柯穆的主脑谈判。”~
@104312 = ~“告诉我有关眼魔的情况。”~
@104313 = ~“和眼魔打仗这方面有何建议？”~
@104314 = ~“我正寻找同盟共同抵抗瓦纱瑞丝。”~
@104315 = ~“怪物？你是说……”~
@104316 = ~“你对你的军队太苛刻了。”~
@104317 = ~洛斯兽不理你，继续嚼它口中的东西。~
@104318 = ~当你靠近时那只动物的想法莽撞地聚焦在你身上。一旦它意识到你不是能够给它带来下一顿美餐的牧工，它便重新嚼它口中的东西。~
@104319 = ~洛斯兽思想被食物和睡觉给占先了，这动物完全被驯化了。无论什么以前它可能有的野性现在都已消失了。~
@104320 = ~麦维尔家族在魔索布莱城曾经盛极一时，但现在我们陷入了艰苦的时期。~
@104321 = ~既然泽希尔已经接管了，也许麦维尔家族可以回到以前的光辉岁月。~
@104322 = ~一旦这一些都结束，主母将会处置先知和她的难民。你会看到的。~
@104323 = ~立特米亚撒在先知出现以前过得更好。~
@104324 = ~麦维尔家族发誓过要帮助我们，但我不知道我是否信任他们。~
@104325 = ~我听说麦维尔家族的主母被杀了。我希望新一任的主母仍会帮助我们。~
@104326 = ~我知道我们的机会不多，但先知和伊丽思璀将指引我们渡过难关。~
@104327 = ~伊丽思璀教我们对别人要宽容，即使他们鄙视我们。~
@104328 = ~“你再说一遍？没听明白吗？这里不欢迎你这种人。这里麦维尔家族的领地。你们这些难民为什么不能呆在你们自己的营里呢？”~
@104329 = ~“既然我们都想看到瓦纱瑞丝被阻止，我们也就容忍了你在这里出现。不过这并不意味着我们得喜欢你或你的先知。我很忙，你走开吧。”~
@104330 = ~这个酒保朝你皱了皱眉：“你和先知以及伊丽思璀的追随者在一起，是吗？在这个营地里我们可没有看出你有什么可爱之处。”~
@104331 = ~这个酒保朝你点点头：“你就是帮助泽希尔主母接管麦维尔家族的那个人，对吗？想喝酒吗？我请客。”~
@104332 = ~“当然，<LADYLORD>……下次你见到泽希尔主母时请替我向她问好。”~
@104333 = ~“当然，<LADYLORD>。如果先知和她的追随者被相信的话，我愿为麦维尔家族的朋友以及打败瓦纱瑞丝的救世主做任何事。”~
@104334 = ~“我怎么能？他们反对我们社会发展的一切。力量产生力量，弱者只能当仆人，但先知和她的追随者似乎忘了那些。”~
@104335 = ~“伊丽思璀的崇拜者歌颂仁慈和怜悯，那些傻瓜赞美自身的弱点。但我否认先知的威慑力，而且有许多追随者。”~
@104336 = ~“麦维尔家族现在极度需要结盟；即使和那些追随伊丽思璀的。所以我们宽容他们在这里胡说八道。我们需要他们一起反对瓦纱瑞丝。”~
@104337 = ~“我不知道太多有关她的情况。她是一个主母，但我不知道是来自哪个家族。每个人知道她专注于征服整个幽暗地域。”~
@104338 = ~“但是不经过斗争麦维尔家族不会堕落。也许她会把我们赶到这个营地里，但是现在我们要作抵抗，即使那意味着和先知及她的军队站在一边。”~
@104339 = ~酒保给你一大杯的卓尔麦芽酒。你很快喝完了它，味道不错，但后劲十足。~
@104340 = ~“另外还需要什么吗？好的，<LADYLORD>，我一直很乐意帮助麦维尔家族的朋友的。”~
@104341 = ~酒保挑了挑眉毛，但给你倒另外一杯时没说什么。你又很快把它喝光了。~
@104342 = ~“我要走了。”~
@104343 = ~“我想问你一些问题。”~
@104344 = ~“我想要一杯。”~
@104345 = ~“你不喜欢先知的追随者吗？”~
@104346 = ~“告诉我有关瓦纱瑞丝的事情。”~
@104347 = ~“可以，我想来一杯。”~
@104348 = ~“我再要一杯。”~
@104349 = ~技理扎菲主母摇着头问你：“你需要迪亚尼家族的帮助和它的资源吗？”她声音中透着挖苦、讽刺，不会有假。~
@104350 = ~“走，或者留下，关我什么事？这里每个人的命运都是注定的。我在这里只是享受这份遭遇。”~
@104351 = ~“为什么不呢？如果直到瓦纱瑞丝打败我们也没有其他东西帮我们渡过难关。先知，麦维尔家族，……不久，一切都将崩溃，甚至像我自己的迪亚尼家族一样。”~
@104352 = ~“这个营地的命运也是注定的。先知真傻，把希望寄托在你身上，而麦维尔家族孤注一掷地加入到他们的行列。敌人的盟军将把他们彻底消灭。”~
@104353 = ~“但我已经见识过了瓦纱瑞丝的威力。这里每个人都会被摧毁。这就是我在这儿的原因……去看其他人像迪亚尼家族那样灭亡，来庆祝他们的毁灭。”~
@104354 = ~“我曾经掌握过一个伟大的家族。仆人朝我鞠躬，我在油料和香料中洗澡。”~
@104355 = ~“现在我屈尊降贵生活于窘困之中，住在反复无常的死对头的屋子里，屋子里挤满了卑贱的伊丽思璀的跟随者。但我不再痛苦……再也不会。”~
@104356 = ~“我的生命是一道腐败的伤疤，但我已找到了一种乐趣，一种小小的乐趣：虽然我被打败了，我也将有个好心情去看麦维尔家族在我身旁灭亡。”~
@104357 = ~“我的侍卫曾经像你这样大胆地向迪亚尼家族的主母提问。但现在……来吧，问吧，我会回答你的。”~
@104358 = ~布理扎菲笑了：“是啊，没有其他东西能像看其他人失败一样能治愈你自己失败的创伤。”~
@104359 = ~“我只是一个孤独的女人。我对即将到来的事件没有掌控权。但即使我能够，背叛营地就变得没目的性了。为什么要去背叛一个命运已注定的人呢？”~
@104360 = ~“她是每个主母想成为的人：强大、无情，在一场征服与毁灭的战争中把她的敌人尽情驱策。虽然我蔑视她，但我仰慕她。”~
@104361 = ~“我看到当她摧毁迪亚尼家族时她的全部力量，她已变得比以前强大。你无法击败她……没人能够。麦维尔家族和先知的命运早已注定。”~
@104362 = ~她轻蔑地哼了一下：“她是伊丽思璀的追随者，你需要知道的就这么多。她蔑视主母所代表的每一件事。”~
@104363 = ~“这就是为什么我发现麦维尔家族的最后几天这么有趣。报以一种孤注一掷的、徒劳的自我保护和伊丽思璀的追随者站在一起。”~
@104364 = ~“但麦维尔家族摆脱不了它的命运，就像迪亚尼家族，它会在瓦纱瑞丝面前倒下，先知甚至是你都不能阻止它的毁灭。”~
@104365 = ~“他们是一个命运注定的孤注一掷的家族。他们允许那些难民——伊丽思璀的追随者——在他们祖先的家园里搭建营地。”~
@104366 = ~“主母仍然坚持她可怜的信心，相信她会在即将到来的灾难中存活下来。她甚至放逐了她自己的女儿，唯恐她的女儿以后会造反。”~
@104367 = ~“是的，她的女儿泽希尔，玛露恩主母唯一的继承人。她被放逐，一个人住在麦维尔家族的公共住宅里，而她母亲则把自己锁在北部的一个塔中。”~
@104368 = ~“你也看到了，泽希尔很有野心。即使她的家族的财富已经消失殆尽，改变的种子还是很容易种下。玛露恩很怕她的女儿，同时也害怕她被谋杀。”~
@104369 = ~“所以她让她活着，但保持着一定距离。这增加了麦维尔家族生存的机会。如果母亲和女儿任何一个人被残杀，另外一个会想法逃脱……虽然我并不指望它发生。”~
@104370 = ~“甚至是泽希尔，得到你帮助的主母，现在也不能帮他们了。当瓦纱瑞丝的军队最终来临时，我将会在这里目睹他们彻底地歼灭。”~
@104371 = ~“我们挑战瓦纱瑞丝真是犯了个错误。但不像麦维尔家族，我们在城外没有祖先的家园可以撤退。”~
@104372 = ~“我们的军队被屠杀了，我的女儿被抓然后一个个被那些效忠瓦纱瑞丝的红色姐妹杀手杀害了。只有我逃了出来。”~
@104373 = ~“除了这最后的两个侍卫，我孤家寡人，像个乞丐一样来到麦维尔家族的门前——曾经我们的死对头，现在是可靠的盟友。一种比死亡更屈辱的命运。”~
@104374 = ~“麦维尔家族给了我避难所，他们逃离那座城市的时候把我带到了这里。现在我就干坐着等待他们最后的灭亡，就像他们享受我的灭亡一样。”~
@104375 = ~“他们收留我，纯粹是出于幸灾乐祸！麦维尔家族的主母帮助我逃出来只是为了延长我的苦难。我的痛苦能给她带来一点点欢乐。”~
@104376 = ~“我知道这些是因为如果我们位置调换的话我也会做同样的事，而我甘愿忍受屈辱也是为了亲眼目睹麦维尔家族的毁灭。”~
@104377 = ~虽然她的衣服有点破，但这个卓尔女人显然很高贵。她不管自己的衣着破旧、环境艰难，仍流露出一股傲慢的自信。~
@104378 = ~“那么你就是？先知相信你能拯救我们所有人。嗯……一个<RACE>男性？我简直无法想像。”~
@104379 = ~“那么你就是？先知相信你能拯救我们所有人。嗯，至少你并不是个男的。不过，我还是有点意外。”~
@104380 = ~“多么热情。多么自信。这就是先知第一眼看到的？对我们来说，倒不如是别的什么东西。”~
@104381 = ~两边的侍卫拿起武器，举手示意。“别发火，。靠发脾气是无法击败瓦纱瑞丝的。”~
@104382 = ~卓尔突然大笑起来。“我发现你很逗……表面看起来是。我可是布理扎菲，迪亚尼家族的主母。至少，我的家族还剩下点什么。”她指着身边的两名侍卫说。~
@104383 = ~“正如你能看到的，迪亚尼家族已经陷入了困境。我甚至连一个计划推翻我的女儿都没有……即使有，她推翻我也得不到什么。”~
@104384 = ~“你以前没听说过这个词语吗，？我们卓尔叫它<RACE>的血脉。这不是侮辱……不是。”~
@104385 = ~“我要走了。”~
@104386 = ~“我能问你一些问题吗？”~
@104387 = ~“关于这个营地你能告诉我些什么？”~
@104388 = ~“你是个很厉害，很厉害的女人。”~
@104389 = ~“我想问你其他一些事情。”~
@104390 = ~“看到你这么节约用时间真是太好了。”~
@104391 = ~“如果你做出一些背叛这个营地的事情来……”~
@104392 = ~“太恐怖了！”~
@104393 = ~“关于瓦纱瑞丝你知道些什么？”~
@104394 = ~“告诉我关于先知的事情。”~
@104395 = ~“告诉我有关麦维尔家族的事情。”~
@104396 = ~“她的女儿？”~
@104397 = ~“迪亚尼家族发生什么事了？”~
@104398 = ~“他们收留了你，现在你却在庆祝他们的毁灭。”~
@104399 = ~“我将打败瓦纱瑞丝！”~
@104400 = ~“我不喜欢你的语气，卓尔！”~
@104401 = ~“你是谁？”~
@104402 = ~“你刚才叫我什么？”~
@104403 = ~那戴着兜帽的人没说什么。当你走开的时候，你能感觉到隐藏在兜帽阴影下面的眼睛正盯着你看。~
@104404 = ~“我注定要和黑暗之河在一起，激流的水冲走了伤员。当水流拍击着船舰的身体时，你不能在这里伤害我。”~
@104405 = ~“我既不是卓尔，也不是灰矮人。我能把你带过黑暗之河，然后带你到如果想击败瓦纱瑞丝就必须去的小岛上。你知道这些就够了。”~
@104406 = ~“那个岛荒了几个世纪。然后突然一夜之间一个部落出现了。但这个不是普通的幽暗地域城市：那里的生物来自地表。”~
@104407 = ~“他们是卓尔的表亲；你们称呼他们为精灵。但是他们有翅膀。这种生物不会经常在这里出现。他们避开和我接触……尽管他们可以跟你说话。”~
@104408 = ~“他们是卓尔的表亲；你们称呼他们为精灵。但是他们有翅膀。这种生物不会经常在这里出现。他们避开和我接触……尽管他们可以跟你说话。”~
@104409 = ~“那岛上还有些其他东西。一些有魔力的东西。当我的船在岸边停靠时我能感觉到它的力量，虽然它的本性被藏了起来。”~
@104410 = ~“我怀疑是魔法导致了这个城镇奇特的外貌。如果你能掌握这种力量，你就能用它来对付瓦纱瑞丝。”~
@104411 = ~“创造者之岛是古代一位魔法师的家乡。创造者好几个世纪没被人看到了，然而他的创造——那些魔像——仍在岛上流浪。”~
@104412 = ~“如果你能找到创造者，你也许能说服他借一些魔像给你的军队。如果创造者已不在人世，你可以想法控制他的魔像。”~
@104413 = ~“我只能告诉你这些，因为事实上我从来没去过创造者的岛上，这是个充斥着灰矮人的岛，我在那里不受欢迎。”~
@104414 = ~“创造者之岛是古代一位魔法师的家乡。创造者好几个世纪没被人看到了，然而他的创造—那些魔像—仍在岛上流浪。”~
@104415 = ~“如果你能找到创造者，你也许能说服他把一些魔像借到你的军队中去。如果创造者已不在人世，你可以想法控制他的魔像。”~
@104416 = ~“我只能告诉你这些，因为事实上我从来没去过创造者的岛上，这是个充斥着灰矮人的岛，我在那里不受欢迎。”~
@104417 = ~“那个岛荒了几个世纪，然后突然一夜之间一个部落出现了。但这个不是普通的幽暗地域城市：那里的生物来自地表。”~
@104418 = ~“他们是卓尔的表亲；你们称呼他们为精灵。但是他们有翅膀。这种生物不会经常在这里出现。他们避开和我接触……尽管他们可以跟你说话。”~
@104419 = ~“他们是卓尔的表亲；你们称呼他们为精灵。但是他们有翅膀。这种生物不会经常在这里出现。他们避开和我接触……尽管他们可以跟你说话。”~
@104420 = ~“那岛上同样也有其他些东西。一些有魔力的东西。当我的船在海边停靠时我能感觉到它的力量，虽然它的本性给藏了起来。”~
@104421 = ~“我怀疑这个就是魔法导致了这个城镇奇特的外貌。如果你掌控这种权力你能用它来和瓦纱瑞丝作斗争。”~
@104422 = ~“你更想了解哪个岛？创造者岛还是那个无中生有的奇怪的小镇？”~
@104423 = ~“那个岛荒了几个世纪。然后突然一夜之间一个部落出现了。但这个不是普通的幽暗地域城市：那里的生物来自表面。”~
@104424 = ~“他们是卓尔的表亲；你们称呼他们为精灵。但是他们有翅膀。这种生物不会经常在这里出现。他们避开和我接触……尽管他们可以跟你说话。”~
@104425 = ~“他们是卓尔的表亲；你们称呼他们为精灵。但是他们有翅膀。这种生物不会经常在这里出现。他们避开和我接触……尽管他们可以跟你说话。”~
@104426 = ~“那岛上同样也有其他些东西。一些有魔力的东西。当我的船在海边停靠时我能感觉到它的力量，虽然它的本性给藏了起来。”~
@104427 = ~“我怀疑这个就是魔法导致了这个城镇奇特的外貌。如果你掌控这种权力你能用它来和瓦纱瑞丝作斗争。”~
@104428 = ~“创造者之岛是古代一位魔法师的家乡。创造者好几个世纪没被人看到了，然而他的创造—那些魔像—仍在岛上流浪。”~
@104429 = ~“如果你能找到创造者，你也许能说服他把一些魔像借到你的军队中去。如果创造者已不在人世，你可以想法控制他的魔像。”~
@104430 = ~“我只能告诉你这些，因为事实上我从来没去过创造者的岛上，这是个充斥着灰矮人的岛，我在那里不受欢迎。”~
@104431 = ~“我能独自带领你穿过黑暗之河然后到达那边的岛，但首先你得知道一些你目的地的消息。”~
@104432 = ~“然后，我将独自带你走，其他向导都不能安全地航行过黑暗之河。你要去哪？~
@104433 = ~你面前的这人穿着宽大的长袍，把自己全部遮蔽了起来。你试着窥视他兜帽下的样子，却无法看清他的容貌。一个汩汩水流般的声音对你说：~
@104434 = ~“你很聪明，因为你不知道我内心深处潜伏着什么。但只有我才能带你去那个能帮你打败瓦纱瑞丝的岛上。”~
@104435 = ~“瓦纱瑞丝的灵魂又黑又冷。她渴望征服，她渴望统治幽暗地域的每一寸土地，甚至是黑暗之河野性的水流。”~
@104436 = ~“她的势力正在增长，她将使黑暗之河成为她的奴隶，使野性的水流屈服于她，任由她驾驭。那不可能发生。这就是我为什么要带你去岛上的原因了。”~
@104437 = ~“我要走了。”~
@104438 = ~“去死吧，你这疯子！”~
@104439 = ~“我能问你一些问题吗？”~
@104440 = ~“我需要帮助一起和瓦纱瑞丝作斗争。”~
@104441 = ~“你是什么人？”~
@104442 = ~“我还想再问你一些事情。”~
@104443 = ~“你是卓尔，还是灰矮人？或是其他种族？”~
@104444 = ~“告诉我有关小岛的事情。”~
@104445 = ~“告诉我有关奇怪小镇的事情。”~
@104446 = ~“告诉我有关创造者岛的事情。”~
@104447 = ~“告诉我有关创造者岛的事情。”~
@104448 = ~“告诉我有关奇怪小镇的事情。”~
@104449 = ~“我还想再问你一些事情。”~
@104450 = ~“告诉我有关奇怪小镇的事情。”~
@104451 = ~“告诉我有关创造者岛的事情。~
@104452 = ~“我需要穿过这条河。”~
@104453 = ~“把我带到创造者岛上去。”~
@104454 = ~“把我带到有奇怪小镇的岛上去。”~
@104455 = ~“把我带回先知的营地里。”~
@104456 = ~“瓦伦说你能帮我打瓦纱瑞丝。”~
@104457 = ~“你一直在等我吗？”~
@104458 = ~“我不信任你。”~
@104459 = ~“你为什么帮我？”~
@104460 = ~如果愿意和主母说吧，但我会看着你的。~
@104461 = ~先知说卡瓦拉斯在我们这边，但他似乎有些不对劲。他从不脱下他的斗篷。”~
@104462 = ~在这里要小心这条河。掉下去就出不来啦。~
@104463 = ~如果你想过河和卡瓦拉斯说话吧……但不要背对他。~
@104464 = ~你就是先知说通拯救我们的那个人，不是吗？我想她对你的看法是对的。~
@104465 = ~我知道卡瓦拉斯提供我们食物和军需，但我仍然不信任他。~
@104466 = ~先知说你能击败瓦纱瑞丝，我希望她是对的。~
@104467 = ~黑暗之河保护着立特米亚撒的东部，那些大门保护着西部。~
@104468 = ~麦维尔家族没有足够的军队去守卫那些门，所以先知送我们过来帮忙。~
@104469 = ~先知派军队来守护大门，但你不能依赖一个伊丽思璀的追随者。~
@104470 = ~麦维尔家族正训练更多的部队来帮助我们逃离困境，可他们还没有准备好。~
@104471 = ~还没有军队能冲破立特米亚撒的大门，但瓦纱瑞丝可能是第一个。~
@104472 = ~我不管那些门有多大，战争开始它们就救不了我们了。~
@104473 = ~他们说亡灵军队正集在一起开始进攻我们了，我不能和一支已经死了的军队作战。~
@104474 = ~瓦纱瑞丝在她身边有眼魔和灵吸怪。我们只有伊丽思璀的追随者。~
@104475 = ~“再次回来，<CHARNAME>·<CHARNAME>？虽然我有一些军队在巡逻，但现在不需要很多人去大门那边。”~
@104476 = ~“我们听说眼魔和灵吸怪在附近逗留，还看到一些亡灵军队。但仍没什么不寻常的，我希望我们抽出一些军队去保护大门。”~
@104477 = ~当你走近，这个守卫给你飞快地敬了个礼，“你是<CHARNAME>·<CHARNAME>，不是吗？奥希尔军士愿为您效力。我是这里大门守军的负责人。”~
@104478 = ~“正如你所见到的，我们负责看守大门。我只是希望能多抽调一些军队来防守这个位置。我们不想被偷袭。”~
@104479 = ~“我这就让他们给你把门打开。以后你就来去自如了。在外面要小心呀！”~
@104480 = ~军士点了点头，“通常我会警告任何人不要出去，但如果你是先知要的一切，或许你能自己处理这些问题。“~
@104481 = ~“外面要小心。那里是真正的幽暗地域开始的地方。门外边的洞里到处爬着眼魔和灵吸怪，更不用提一大军亡灵军队。”~
@104482 = ~“祝你好运。立特米亚撒的每个人都指望你了。”~
@104483 = ~“在幽暗地域每隔一段时间你就会听到不死生物的传闻。吸血鬼、僵尸，还有古怪的木乃伊。但它们却不会变成你所谓的老生常谈。”~
@104484 = ~“但后来却越来越频繁地看到这东西。据说瓦纱瑞丝找到一个方法创建了一支不死生物大军，她指使它们与我们为敌。”~
@104485 = ~“佐瓦柯穆的灵吸怪殖民地就在这块区域的某个地方。这是一个很小的部落，仅仅是为了给夺心魔进行奴隶交易。”~
@104486 = ~“但我听说瓦纱瑞丝已经召集了一整群的灵吸怪加入到她的军队，那将使战斗更艰苦。”~
@104487 = ~“虽然灵吸怪没什么肉搏能力，但它们却有奇特的心灵感应能力。它们能驾驭你的思想，或仅仅因为一个想法而使你精神分裂。”~
@104488 = ~“特定的咒语和魔法能保护我方人员不受到精神攻击，但我们却没有足够的法术来装备全部的军队。我可不期望和夺心魔过招。”~
@104489 = ~“我们知道这儿附近某处有一个眼魔殖民地，有传言说它们效力的眼魔暴君已经和瓦纱瑞丝结成同盟了。那真是个可怕的说法。”~
@104490 = ~“眼魔是可怕的敌人。他们从眼中射出光线使你瘫痪，把你变成石头或者把你击得粉碎。”~
@104491 = ~“立特米亚撒的另一边由黑暗之河保护着——甚至是瓦纱瑞丝也不够强大以致于能安全地把她的军队转移到河对岸。”~
@104492 = ~“如果她要攻击营地，她不得不穿过这几道门。当她穿过门时，我们将准备打倒她和她的灵吸怪、眼魔和亡灵军队联盟。”~
@104493 = ~“大门之外才是真正的幽暗地域。那边的洞窟里爬满了眼魔和灵吸怪，还有许多不死生物。”~
@104494 = ~<CHARNAME>！你回来了，正好准时。先知正找你，我带你去见她。~
@104495 = ~“你能为我把门打开吗？”~
@104496 = ~“我要走了。”~
@104497 = ~“你说大门外面有不死生物？”~
@104498 = ~“关于灵吸怪你知道些什么？”~
@104499 = ~“告诉我关于灵吸怪精神力量的事情。”~
@104500 = ~“告诉我关于眼魔的一些事情。”~
@104501 = ~“我能照顾我自己，把门打开。”~
@104502 = ~“我会小心的，请开门。”~
@104503 = ~“你为什么这么担心这扇门？”~
@104504 = ~“偷袭？你指得是什么？”~
@104505 = ~“欢迎回来，地表人。我不确定你会回来。因为我和麦维尔家族联系太紧密了，先知的人民经常拒绝从我这里买东西，尽管他们需要。”~
@104506 = ~这个卓尔显然是一个有强大威力的魔法师。他专心致志地盯着你看，仿佛要看穿你的思想。经过不舒服的几秒钟，他终于开口了。~
@104507 = ~“你是先知预言的那个人，对吗？通常我不大相信她的眼力，但你看上去很有能力……作为地表人而言。我是古尔莱斯，麦维尔家族的高阶法师。”~
@104508 = ~“我可以提供很多魔法物品，你会发现它们在你击败瓦纱瑞丝的战斗中会很有用。详细谈谈，我的价格可是非常合理的哦。”~
@104509 = ~“再见，地表人。如果你觉得你需要强大的魔法物品，我希望你能回来。”~
@104510 = ~“我不知道我能告诉你这么多先知不能告诉你的东西。但是来吧——问你要问的问题。”~
@104511 = ~“我尝试过，但没有获得多少信息。她控制了强大的魔力，有人说她把一个魔王玩弄于股掌之间。无论如何，我的咒语却发现不了任何东西。”~
@104512 = ~“但我不需要用我的魔力就能知道，她会摧毁一切反对她的人，包括这个营地的每个人。当然，万一你没能够阻止她，我也计划好怎么逃走了。”~
@104513 = ~“一个有关错失良机和选择了不当盟友的悲剧故事。麦维尔家族在魔索布莱城的一个大的卓尔城市中曾被认为是一个极有权力的家族。”~
@104514 = ~“但麦维尔家族选择了反对瓦纱瑞丝，而不是当她同盟中的助手或是奉承的角色。那个错误的决定导致的后果在你的周围已经很明显了。”~
@104515 = ~“现在看起来好像麦维尔家族悠久的历史即将到达一个不可避免的终点……除非你想法阻止瓦纱瑞丝和她强大的军队。”~
@104516 = ~“我知道她是伊丽思璀的一个追随者，就像跟着她的大多数卓尔一样，这使她在许多麦维尔家族的支持者中不受欢迎……以前的偏见很难消失。”~
@104517 = ~“我却对现在的局势有一个比较现实的看法。麦维尔家族实力很弱，很容易被打败。我们需要先知和她的卓尔，这是政治婚姻。”~
@104518 = ~“当然，如果这场婚姻糟糕地结束，我就不打算留在这儿。如果你不能够阻止瓦纱瑞丝，我将毫不犹豫地退出这个命运注定的营地。”~
@104519 = ~“我恐怕帮不了你……不过你可以去船坞同卡瓦拉斯说说话。他是一个奇怪的家伙，但知道一些连我都不能了解的秘密。”~
@104520 = ~“过去几年，我积累了一大堆很有意义的魔法物品。但是，随着瓦纱瑞丝军队的逼近，我宁可将我的财产付诸东流。”~
@104521 = ~“如果战争对麦维尔家族和先知的反叛不利，我将会很快逃生。我宁愿逃生时带着满满一口袋金子，而不是两手空空。”~
@104522 = ~“我是一个强大的法师，但我无法独力扭转战争的局势。如果我看到失败不可避免，那么为什么我不利用我的魔法让自己逃脱被屠杀的厄运呢？”~
@104523 = ~“效忠麦维尔家族有它的特权：权力，威望。但我却能在效忠任何卓尔家族中获得这些东西，只要那个卓尔家族的高阶法师正好遭受了不幸的事故。”~
@104524 = ~“如果这里的每个人都要死，这只是说明我应该试着到别的地方重建我的生活和地位，不是吗？”~
@104525 = ~“我很高兴你同意。许多先知的追随者都不能接受我的实用哲学。伊丽思璀向他们的脑袋中灌输了忠诚和牺牲的奇怪观念。”~
@104526 = ~“我可是个卓尔。难道你真还有什么别的期望吗？只有狡诈，才让我们在幽暗地域里得以生存，乃至繁荣。”~
@104527 = ~“但此时此地不适合讨论哲学，如果你能想法阻止瓦纱瑞丝，一切将顺利。”~
@104528 = ~“哈，关键词是‘尝试’。没什么东西能保证你成功，除了先知的信任。如果你失败了，我想至少能得到公平的补偿。”~
@104529 = ~“再见。”~
@104530 = ~“我想问你一些问题。”~
@104531 = ~“有关瓦纱瑞丝你知道些什么吗？”~
@104532 = ~“告诉我有关麦维尔家族的事情。”~
@104533 = ~“关于先知你知道些什么？”~
@104534 = ~“对阻止瓦纱瑞丝你有何建议？”~
@104535 = ~“为什么一个高阶法师会在这里叫卖他的魔法物品？”~
@104536 = ~“我想问你其他一些事情。”~
@104537 = ~“逃跑？你会放弃这里每个人吗？”~
@104538 = ~“你说得很有道理。”~
@104539 = ~“你真是个卑鄙、虚伪的懦夫！”~
@104540 = ~“让我看看你的物品。”~
@104541 = ~“我正在尝试拯救你们所有人——难道你只能给我这点东西吗？”~
@104542 = ~请不要打搅兽群。如果洛斯兽被惊吓，肉将变酸。~
@104543 = ~在幽暗地域这里，食物是很缺乏的。立特米亚撒很幸运拥有一群洛斯兽。~
@104544 = ~洛斯兽一旦被激怒是相当危险的，但是通常他们相当容易驯养。~
@104545 = ~这个守卫对你的接近很警惕，淡然道：“玛露恩主母不接待访客。”~
@104546 = ~守卫不回答，只是继续死板地站岗。~
@104547 = ~“她是麦维尔家族的统治者。玛露恩主母善待先知和追随她的反抗者。但是主母这次不接见访客。”~
@104548 = ~“这塔是麦维尔家族的要塞。自从那些反叛的难民到达后，玛露恩主母就把自己隔离在里面，不允许任何人见她。”~
@104549 = ~守卫突然显得格外紧张：“泽希尔给了你这个？她现在已经准备行动？”他迅速地扫视四周，试图查找是否有人在窥视。~
@104550 = ~“内部的一些守卫对玛露恩主母仍然是忠诚的。其他一些正在她和泽希尔之间摆动。他们将不会攻击你，但也不会帮你。”~
@104551 = ~“快点进来，我们将会召唤主母。如果你行动迅速，那么你有可能在她和特比玛队长意识到发生了什么事之前杀了他们。”~
@104552 = ~守卫爽快地给你行了个礼：“泽希尔主母希望能对你所做的一切表达她的感激之情。她认为你是家族的一个盟友。”~
@104553 = ~守卫又给你行了一个礼，但是没有再做另外的答复。~
@104554 = ~“那是不可能的。泽希尔主母的处境很不稳定，她为暗杀行动担忧。所以没有人可以见到她。”~
@104555 = ~“泽希尔主母感激你所做的一切，但她非常清楚盟友是如何变成敌人的。她不想再冒任何风险。”~
@104556 = ~守卫爽快地给你行了个礼：“玛露恩主母希望能对你所做的一切表达她的感激之情。她认为你是家族的一个盟友。”~
@104557 = ~“以前在这里的守卫以及泽希尔她自己已经因为他们的叛逆被处罚了了，我们把守卫的头钉到桩上，作为对那些同样有叛逆想法的人的警告。”~
@104558 = ~“那是不可能的，玛露恩主母不会愿意让自己暴露在另一个暗杀行动中，没有人被允许进去见她。”~
@104559 = ~“玛露恩主母感激你所做的，但她完全知道一个盟友会如何突然出卖你。她拒绝让自己易受伤害。所以你不能进去。~
@104560 = ~“再见。”~
@104561 = ~“玛露恩主母是谁？”~
@104562 = ~“这是什么建筑？”~
@104563 = ~“泽希尔说要给你看这戒指。”~
@104564 = ~“我现在就走。”~
@104565 = ~“我可以和泽希尔主母说话吗？”~
@104566 = ~“如果不是为了我，她甚至不可能是主母。”~
@104567 = ~“但是我是在她这一边的啊！”~
@104568 = ~“我可以和玛露恩主母谈谈吗？”~
@104569 = ~“我是那个警告她提防泽希尔的人啊！”~
@104570 = ~“但是我是站在她这一边的啊！”~
@104571 = ~“军队在你后面的广场聚集，等候你的命令。你可以个别跟队长说话来发布命令。队长为容易确认而携带着一面旗子。”~
@104572 = ~“现在，你要小心布置你的军队；战争一旦开始，发布命令将会更加困难。”~
@104573 = ~“我们必须留下部分军队保卫港口和市中心，以防敌人找到一条路渡过黑暗之河。这样一来，我们就没有可用的后援了。”~
@104574 = ~“我已经有经验对抗瓦纱瑞丝和她的军队了。我是从自己过去的失败学来的。我的忠告可以帮助你。”~
@104575 = ~“瓦纱瑞丝将会试着从要害之处攻入城市。如果进出城市的门被破坏，那么，我们将不得不撤回到城市中心。”~
@104576 = ~“一些投石器安置在附近。它们将会自动攻击我们的敌人，但你也可以自己来控制，如果你想让它们攻击一个特定的敌人。”~
@104577 = ~“祝你好运，<CHARNAME>。立特米亚撒的命运，以及我们所有人的命运，掌握在你的手中。”~
@104578 = ~“你也可以和加入我们的特殊盟友讨论作战策略。”~
@104579 = ~“现在不行——我还在筹划我们的防御策略。”~
@104580 = ~“是的——我相信我们现在已经准备好了他们的突击。”~
@104581 = ~“军队现在在哪里？”~
@104582 = ~“我如何指挥军队？”~
@104583 = ~“我不需要你告诉我如何打这场战！”~
@104584 = ~“敌人有什么作战策略？”~
@104585 = ~这卓尔试着不理睬你，并将他的注意集中在他的军队上，看着他们操练。他注意到你不打算走开，于是最后只能面对你。~
@104586 = ~“你怎么又回来了，地表人？你还想干什么？”~
@104587 = ~“那么，快点。我要对这支军队进行训练，我不能浪费我所有的时间在你的问题上。”~
@104588 = ~“我知道她的军队将过来消灭光我们。那已经足够了。去问先知或者她的追随者一些关于瓦纱瑞丝的事，他们好像觉得他们知道所有的答案。”~
@104589 = ~“麦维尔家族是魔索布莱城的一个大家族。但是当瓦纱瑞丝刚刚崛起的时候，我们犯了反对她的错误。结果是……唉。”~
@104590 = ~“我们许多人被残杀，只有你所见到的一小部分的生还者努力逃脱了。我们和主母逃出了城市，来到了这里，到了我们的祖先家。”~
@104591 = ~“现在我们只是一个弱小的、任由瓦纱瑞丝鱼肉的团体。如果我们唯一的盟友不是那些伊丽思璀追随者的话，我们也许会有更好的机会。”~
@104592 = ~“泽希尔可能已经从她母亲那里得到了控制权，但我认为这并不足够改变我们的命运。当你的盟友是伊丽思璀的追随者的时候，未来一片黑暗。”~
@104593 = ~“首先，他们很弱。而且他们反对使卓尔社会强大的一切事物：残酷，无情，狡猾，以及一定要征服或毁灭的信念。”~
@104594 = ~“而且现在，立特米亚撒都是些心软的蠢家伙，比我们多得多！而且，当瓦纱瑞丝来到的时候，他们将为麦维尔家族做什么？他们不是战士。”~
@104595 = ~“当然，<LADYLORD>。有什么要给可以给泽希尔主母传消息的人吗？”~
@104596 = ~“你想怎么样，地表人？你难道看不见我正忙于训练军队吗？我没时间可以浪费在一个伊丽思璀的追随者身上。”~
@104597 = ~“去烦伊蒙罗指挥官吧。他可能没什么事做。这不像你能使士兵脱离伊丽思璀的追随者行列。”~
@104598 = ~他哈着腰回答：“当然，<LADYLORD>。”~
@104599 = ~“你正在试着战斗吗？别像个蠢货一样！麦维尔家族的从者可能不喜欢你这种类型的，但我们够聪明来为了瓦纱瑞丝而保存能量，她也是真正的敌人。”~
@104600 = ~军士摇着他的头。“我的军队需要训练，我不能浪费时间跟一个伊丽思璀信徒争论。”~
@104601 = ~卓尔斜着瞥了你一眼。“你不是？但是你来先知的神殿。我才假定你是那些和平主义者中的一个。”~
@104602 = ~他把你从上到下扫视了一遍。“我能看出你是个<RACE>……而且你看起来像是知道如何控制自己。我想我们可以接受这帮助，尽管它来自于一个像你这样的地表人。”~
@104603 = ~“此外，当战争开始的时候，我们似乎并不能仰赖先知和她的人民。如果希望在对抗瓦纱瑞丝的战斗中有胜算的话，那么麦维尔家族需要更好的盟友。”~
@104604 = ~当你接近的时候，这个卓尔向你鞠躬。“你好，<LADYLORD>。正如你所能看到的，我正努力为了将来临的战争准备我的军队。好马需快鞭！”~
@104605 = ~“也许当你下次遇到泽希尔主母的时候，你可以告诉她我取得了多大的进步。麦维尔的军队准备得比这些伊丽思璀的追随者的好的多了。”~
@104606 = ~军士脸上出现了一个短暂的笑，然后又鞠了一个躬。“你的赞美多让人感动啊，<LADYLORD>。你还需要别的什么东西吗？”~
@104607 = ~军士给了你一个奇怪的表情。“我……我会考虑接受你的忠告。”从他的话里可以明显地知道他没解散他军队的意图。“还有其他事吗？”~
@104608 = ~军士的脸色发白，他转向军队并且喊道：“听到没有，你们这些悲哀的虫子？你们太弱小了，你们是泽希尔主母和麦维尔家族耻辱！”~
@104609 = ~他转回来对着你，他的声音很奉承。“原……原谅我，<LADYLORD>。请不要告诉主母。我将……我将加重他们的训练。我会用鞭好好抽他们的！”~
@104610 = ~军士看起来恢复了些，尽管他不在明显地颤抖。“还有……还有其他事吗？”~
@104611 = ~“我想问你一些问题。”~
@104612 = ~“关于瓦纱瑞丝你知道些什么？”~
@104613 = ~“告诉我一些关于麦维尔的事。”~
@104614 = ~“你拿什么对抗伊丽思璀的从者？”~
@104615 = ~“我现在要走了。”~
@104616 = ~“我不喜欢你的语气。”~
@104617 = ~“我不是伊丽思璀的跟随者。”~
@104618 = ~“我会告诉她什么才是更适合你的工作的。”~
@104619 = ~“如果你对他们不这么苛刻，你可能会得到更好的结果。”~
@104620 = ~“这支军队太悲哀了！你怎么训练他们的？”~
@104621 = ~“太好了！很高兴听到这个。”~
@104622 = ~我在训练过程中不能和你说话。军士会鞭打我的。~
@104623 = ~玛露恩主母很藐视地瞥了你一眼，然后转向她旁边的卓尔。~
@104624 = ~“主母，我并不清楚，请允许我为你查明。”队长转向你。~
@104625 = ~“你是谁？像你这样的<RACE><MANWOMAN>是怎么通过外面的守卫的？”~
@104626 = ~“泽希尔已经被放逐。她能策划她所要的，但是在这塔里，她无法接近主母。”~
@104627 = ~特比玛焦虑地瞥了主母一眼：“看来你的女儿比你想像得更野心勃勃。也许让她活着已变得很危险。”~
@104628 = ~“我不打算因为这个的几句话就处死我最后仅存的继承者，特比玛。查一下<HESHE>能否证明其所说的话。”~
@104629 = ~特比玛点了点头：“好的，这很有道理。外面的守卫一定和泽希尔合作了。”~
@104630 = ~玛露恩叹了口气，道：“特比玛，你知道该做什么。和泽希尔做个交易，把她许诺的东西作为给这个的报酬。”~
@104631 = ~“麦维尔家族很感谢你的信息，<CHARNAME>·<CHARNAME>。请收下这个护身符作为我们对你的感谢。”~
@104632 = ~“现在，守卫会指引你出去的……而我，将会自己照顾我的女儿。”~
@104633 = ~[失败]“你敢在主母自己的家里威胁她？特比玛，解决这个人。”~
@104634 = ~“我很乐意，主母。”~
@104635 = ~[成功]主母看看你又看看守卫，以此来判断她的机会。“我希望你为了瓦纱瑞丝而息怒，<CHARNAME>·<CHARNAME>。毕竟那是你来的目的。”~
@104636 = ~“但是你没有发现我女儿对抗我的阴谋……一些特比玛没做好的事。也许他该给你他的剑作为附加的酬谢，因为无论如何你做了他的任务。”~
@104637 = ~[失败]“你很勇敢，敢跟一个卓尔主母在她的家里讨价还价。我佩服……所以我不杀你。我认为你所得到的报酬是公平。”~
@104638 = ~[成功]“特比玛，如果不是为了这，泽希尔就会杀了我。为什么不把你的武器给<CHARNAME>·<CHARNAME>呢？因为无论如何，看来<HESHE>将会完成你的任务。”~
@104639 = ~特比玛咬紧牙关，但还是交出了他的武器：“当然可以，主母。”~
@104640 = ~“等一下，老大。德金感到困惑。你告诉女儿说你要去杀了母亲，现在你又告诉母亲，女儿让你来杀她，那么，母亲会杀了女儿吗？”~
@104641 = ~“好的，你是老大，老大。德金只是希望你能不犯错。我们不希望你错杀了卓尔女性。”~
@104642 = ~“<CHARNAME>，你的意思是这全都是在耍泽希尔吗？你拥有卓尔政治的绝招。我觉得它……令人不安。”~
@104643 = ~“那么现在我们已经转变了忠贞，<CHARNAME>？如果你在像那样跳到旁边来之前提醒我，这将多好啊。我想知道万一战争爆发，我是站在哪一边的。”~
@104644 = ~特比玛皱着眉：“<CHARNAME>·<CHARNAME>，先知的伟大的救助者。我听说过你。但是你在麦维尔家族塔中做什么？你是怎样通过守卫的？”~
@104645 = ~“我们来提醒你们，泽希尔想要主母的命。”~
@104646 = ~“怎么可能？她希望我杀了你。”~
@104647 = ~“我决定应该受泽希尔的支配！攻击主母。~
@104648 = ~“她给了我她的戒指使我可以通过守卫。”~
@104649 = ~“我只是很乐意帮忙。”~
@104650 = ~[威胁]“再告诉我多一些，否则我将完成泽希尔给我的任务！”~
@104651 = ~[说服]“我认为我应该得到的比那个更多些。”~
@104652 = ~“滚开，德金。”~
@104653 = ~“没错。”~
@104654 = ~“泽希尔派我来杀你！”攻击主母。~
@104655 = ~“我叫<CHARNAME>·<CHARNAME>。我是为先知工作的。”~
@104656 = ~“瓦纱瑞丝已经切断了我们所有的贸易路径和补给线。现在我们没希望了。”~
@104657 = ~麦维尔家族进入了困难时期。我们不应该向瓦纱瑞丝喧战。~
@104658 = ~先知和她的难民已经用光了我的存贮。我已经没有东西可以卖给你的了。~
@104659 = ~我不能说了。我必须用心训练。~
@104660 = ~任何伊丽思璀的从者来为先知都是一种光荣。~
@104661 = ~先知说你的使命是杀了瓦纱瑞丝。快去实现你的使命吧。~
@104662 = ~我们将不惜任何代价保护好先知。没有她，我们会灭亡。~
@104663 = ~“还会回来吗，<CHARNAME>·<CHARNAME>？你想过我的提议吗？你愿意去暗杀我的母亲吗？这样一来我就能成为麦维尔家族的主母了。”~
@104664 = ~这个卓尔女性显得比帐篷里很多人都年轻，尽管从她的举止可以明显看出她是个重要人物。~
@104665 = ~“那么你就是寄托了先知信念的？是吗，<CHARNAME>·<CHARNAME>？我是泽希尔……麦维尔家族的玛露恩主母唯一的女儿以及唯一幸存的继承者。”~
@104666 = ~“我一直都在希望你会来见我，<CHARNAME>·<CHARNAME>。我很想给你一个建议，但如果我主动找你，未免太引人注目了。不过，既然你还有点犹豫……”~
@104667 = ~“麦维尔家族——我的家族——陷入了困难时期。玛露恩主母——我的母亲——已经把我送到了毁灭的边缘。很多人认为这是一个机会，觉得该我来统治。”~
@104668 = ~“当然，我的母亲可不笨。她明白我所代表的危险，这就是她为什么要把我从她现在居住的塔里驱逐出去的原因。她认为她在那高高的围墙里会安全。”~
@104669 = ~“但是她低估我了。我比她知道的更经受得起困难，而我所需要的只是一个有足够能力能完成砰然一击，杀了她和她的保镖。”~
@104670 = ~她感叹道，“这是一个好机会，<CHARNAME>·<CHARNAME>，放弃它你就是一个笨蛋。如果你改变主意，就过来再和我谈谈。”~
@104671 = ~“当然，只有一些很平常的酬劳：金钱或强大的魔法装备。但是帮助我也是你的最大乐趣……并且也是先知的乐趣。”~
@104672 = ~“你立刻谴责我，<CHARNAME>·<CHARNAME>，但是你还不知道所有真相。你应该在知道了整个故事后再评价我。”~
@104673 = ~“我了解我母亲，她不相信我们能击败瓦纱瑞丝，她很害怕。你真的相信瓦纱瑞丝来攻击的时候，她会在先知的协助下战斗吗？”~
@104674 = ~“玛露恩主母一旦有机会就会出卖了你的先知。然而我，实际上坚信我们能打败瓦纱瑞丝。我不会一遇到困难就去依靠我的盟友。”~
@104675 = ~“计划够简单了。我把我的印戒给你。带着它去找我母亲塔北面的守卫……他们早就宣誓效忠于我了。”~
@104676 = ~“给他们看这枚戒指，他们就会让你进入塔内并召唤我母亲和她的守卫特比玛。当他们到来的时候，杀了他们。”~
@104677 = ~“如果你做了这事，我会给你充足的报酬：20,000金币，外加当瓦纱瑞丝来到时，麦维尔家族对你的支持。”~
@104678 = ~“你觉得我是一个可以和你讨价还价的商人吗，<CHARNAME>·<CHARNAME>？不，我是泽希尔·麦维尔，即将成为一个主母！我的酬金没有商量的余地。”~
@104679 = ~卓尔笑了笑，你不禁打了个寒颤。“太棒了。带着我的印戒给那个塔北面的守卫看。然后，剩下的就要由你来做了。”~
@104680 = ~泽希尔满意地从你这得到她所想要的以后，做了个手势打发你走。~
@104681 = ~“这是一个危险的游戏，<CHARNAME>·<CHARNAME>。一旦你参与到卓尔政治中，你将不知道谁才可以信赖。我希望你不要深深地陷下去。”~
@104682 = ~“我血管里拥有炽热的恶魔的血。但有时候卓尔想要我做的事让我的血冷了下来。”~
@104683 = ~“考虑一下这个，<CHARNAME>·<CHARNAME>：玛露恩主母已经不再野心勃勃，她宁愿对瓦纱瑞丝俯首称臣。而我却仍然有自己的抱负，我不会轻易在我们共同的敌人面前投降的。”~
@104684 = ~“玛露恩主母已经怀疑我正在密谋反抗她了。但是谣言和传闻还不足够使她有所行动。在拥有无可置疑的证据以前，她是不可能杀了她唯一活着的继承者的。”~
@104685 = ~“如果你把我跟你说的告诉她，那么，这又将只是另一种虚假的谣言。她不会根据任何你告诉她的来镇压我的。”~
@104686 = ~她笑了，说：“你真的不感到吃惊吗？这就是卓尔的方式。主母让她的女儿们清楚地知道，一旦我们到了一定的年龄，我们就能代替她们。”~
@104687 = ~泰夫林厌恶地摇了摇他的头，“他们就是这类我们所依赖的支持我们反抗瓦纱瑞丝的盟友？”~
@104688 = ~“你自己的母亲把你赶了出来？太糟糕了。德金为您感到悲哀，卓尔女士。”~
@104689 = ~“也许她的确把我赶出来了，但是她低估我了。我有比她知道的更多的支持，所有现在我所需要的就是有一个足够强的杀手去杀了她和她的保镖。”~
@104690 = ~“德金收回他刚才的话，你母亲把你赶出去是明智的！你疯了！”~
@104691 = ~“有显然，她并没有她想像中那么安全。我知道我们是如何被抚养大的，但我们还有另一个办法，没有出卖和死亡。伊丽思璀可以……”~
@104692 = ~“不要公然给我灌输你的信念！我们不可能全都能逃到地面上去，一些人将不得不在这幽暗地域中求生。这意味着我们的未来只能依靠自己去创造。”~
@104693 = ~“我母亲认为我已不再是一个威胁，我有比她知道的更多的支持，所有现在我所需要的就是有一个足够强的杀手去杀了她和她的保镖。”~
@104694 = ~“你回来干什么，<CHARNAME>·<CHARNAME>？如果人们看见我们频繁地交谈会起疑心的。”~
@104695 = ~“去和塔外的守卫交谈。他们会让你进去暗杀我母亲的。快，你必须快点行动……为了我们！”~
@104696 = ~卓尔点了点头，说：“不，那不是个好办法。如果人们发现我们经常交谈，我母亲会生疑并且更加小心的。我们要尽快行动。”~
@104697 = ~“很好，但是要快。如果我们有经常交谈，我母亲会生疑，并且会将你除掉的。那么，我就要另找一个杀手了。”~
@104698 = ~泽希尔摇着头叹了口气：“我开始怀疑是不是该选你作为我的使者。这次靠近点听，我会再解释一遍的。”~
@104699 = ~“计划够简单了。我将给你我的印戒。带着它去找我母亲塔北面的守卫……他们早就宣誓效忠于我了。”~
@104700 = ~“给他们这枚戒指，他们就会在召唤我母亲和她的守卫特比玛时让你进入塔内。当他们到来的时候，杀了他们。”~
@104701 = ~“不，<CHARNAME>·<CHARNAME>，我认为我们不可以。我们已达成协议：20000金子。我不打算现在和你交易，这有失我的身份。”~
@104702 = ~“我已经把我的印戒给了你，现在，我期待你能做好这交易。”~
@104703 = ~“你真的以为她将相信你吗？一个来自地表的？关于我的阴谋的谣言已经很平常了。她不会在意的。”~
@104704 = ~“而且，就算她留意了你的警告，她更有可能杀了你而非我。我是她最后幸存的女儿，而你只是个准杀手。”~
@104705 = ~“我是她唯一幸存的继承人。如果她杀了我，麦维尔家族的血脉将随我消失。如不会希望走这如此极端这一步的……在可以证明我的阴谋前。”~
@104706 = ~“也许她在怀疑，她也可能已经听到了谣言和传闻。但她害怕行动，那将是她的毁灭。当她意识到她的失误的时候，已经太晚了。”~
@104707 = ~“你的意思是撇开现实，你已经答应这么做了是吗？很好，记住：玛露恩不相信我们能对抗瓦纱瑞丝。”~
@104708 = ~“一有机会她就会攻击你和先知的，然后爬到瓦纱瑞丝的跟前乞求要回她的宝座。但是我有她所没有的抱负。”~
@104709 = ~“我不会在瓦纱瑞丝跟前屈服的。我将跟她对抗。奉我为主母，你可以仰赖实现你的奋斗目标。”~
@104710 = ~“注意？从谁那里？你在说什么啊？”~
@104711 = ~“一个建议？什么建议？”~
@104712 = ~“对不起，我没兴趣。”~
@104713 = ~“我能得到什么？”~
@104714 = ~“我不参加这可怕的犯罪。”~
@104715 = ~“我该干什么？”~
@104716 = ~“20000金子？那不够。”~
@104717 = ~“好的，我会去做的。”~
@104718 = ~“我为什么要相信一个试图杀死母亲的卓尔呢？”~
@104719 = ~“你公开这些，难道不怕被发现吗？”~
@104720 = ~“你想要我杀了你自己的母亲吗？”~
@104721 = ~“我要走了。”~
@104722 = ~“我想问你一些问题。”~
@104723 = ~“我有关于这次……行动的问题要问。”~
@104724 = ~“我想问你其他一些事。”~
@104725 = ~“我该再做些什么呢？”~
@104726 = ~“我想我们需要商量一下期限。”~
@104727 = ~“如果我把你的计划告诉你母亲会怎么样呢？”~
@104728 = ~“为什么玛露恩只是驱逐你而不杀了你呢？”~
@104729 = ~“为什么我要帮你做这个呢？”~
@104730 = ~“快，保卫好塔。除掉那些剩余的跟随着我母亲的垃圾。”~
@104731 = ~泽希尔把她的注意力转向了你：“做得好，<CHARNAME>·<CHARNAME>。你该得到我的感谢，得到整个麦维尔家族的感谢。我的守卫将会看见你得到我们早已约定好的报酬。”~
@104732 = ~“作为新的主母，我还要做很多事情来巩固我的位子。现在，守卫将带你出去。”~
@104733 = ~“更多？你有一种很奇怪的计价方式，<CHARNAME>·<CHARNAME>。事情已经办完了。为什么我该给你更多呢？”~
@104734 = ~[成功]“你令人惊奇地掌握了卓尔的政治系统。看来我如此匆忙地解决了我母亲的遗体是一个错误。”~
@104735 = ~“如果我不除掉她的遗体，他们有些会相信她还活着的。他们可能会策划反抗我，重新推她做主母……尤其那个假想的杀手宣称她还活着。”~
@104736 = ~[成功]泽希尔看着她周围的残杀，然后慢慢地点了点头：“我猜想一旦成为新的主母后就丢掉以前的生活是没有意义的。”~
@104737 = ~[成功]泽希尔点了点头：“你已经证明了你自己……也许以后我还需要你的帮助。我认为抱有一些好的愿望是明智的。”~
@104738 = ~“很好，你可以拥有特比玛的武器，我母亲的私人守卫作为你的额外报酬。它是一件具有魔力的厉害武器。我坚信这将足够了。”~
@104739 = ~“我也很乐意能帮忙。”~
@104740 = ~“我想要更多。”~
@104741 = ~[吓唬]“我将告诉世人，你母亲逃脱了。然后他们将不拥护你。”~
@104742 = ~[威胁]“付给我更多，否则，你将遭受你如同你母亲一样的命运。”~
@104743 = ~[劝说]“现在你知道了我将会多少有用啊。”~
@104744 = ~这个士兵显然是你旁边这个卓尔女性的保镖。他用坚硬的目光注视着你，分析你可能会表现出来的威胁。~
@104745 = ~“你可以和她尊贵的女儿泽希尔说话，但别试图做任何事。我们不允许任何事发生在麦维尔家族的继承者身上。”~
@104746 = ~玛露恩主母本不应该反对瓦纱瑞丝的。你看，对抗瓦纱瑞丝都可我们带来了什么！~
@104747 = ~泽希尔作为一个主母太年轻了，但是她做起事来并不比她母亲逊色。~
@104748 = ~麦维尔家族该得到比这更好的：和一帮伊丽思璀的难民钻在一个帐篷里。~
@104749 = ~先知认为你是某个救星……所以已经去阻止瓦纱瑞丝了。~
@104750 = ~麦维尔家族恶意对待我们，但这些伪君子想要我们陷在战争里！~
@104751 = ~我希望麦维尔家族新的主母能比上一个更让我们尊敬。~
@104752 = ~愿伊丽思璀在这混乱的时候里赐予你力量和智慧。~
@104753 = ~先知相信你能击败瓦纱瑞丝……我也是。祝你好运。~
@104754 = ~阿戈撒斯的首领不知何故仍然活着，遭受着可怕的魔法，所以他被迫藐视他的从者的命运。他重视你并且用一种干燥的耳语跟你说：~
@104755 = ~“我是一个相信了你的笨蛋。现在，我付出了最终的代价。”~
@104756 = ~他试图再说些别的什么，可说出来的话像堵塞了的流水，仁慈地进入了死亡，他只能忍耐着，避免受到折磨。~
@104757 = ~不像这里的其他灵吸怪，当你靠近的时候，这个夺心魔没有努力探查你的思想。你不知道这是一种好的还是坏的迹象。~
@104758 = ~“欢迎你，<RACE>地表人。我不像我的其他一些同行，我希望能和你们这些奴隶种族做生意。”~
@104759 = ~“再见，地表人。如果你想购买货物，请回来。我怀疑你在其他店主那得不到一点便宜。”~
@104760 = ~“我是一个零售商，一个简单的商人，像其他来到这市场上的货主一样。但有一点和他们不同，我乐意和你交易。”~
@104761 = ~“主脑为了其他种族进行奴隶贸易，已经开放了佐瓦柯穆，所以我猜想主脑希望我们礼貌地对待你。我想我可以回答一些问题。”~
@104762 = ~“我不知道你提到的卓尔，尽管我的知识绝对丰富。主脑也许知道一些。”~
@104763 = ~“我恐怕不知道这个问题的答案。开放佐瓦柯穆是主脑的主意，它比我聪明多了。”~
@104764 = ~“我是个货商，不是奴隶。如果你想购买一个奴隶，你得到市中心的拍卖处去跑一趟。”~
@104765 = ~“主脑向其他种族开放了佐瓦柯穆来进行奴隶贸易。要不，其他物主不会为你这种低等种族收敛他们的蔑视和厌恶之情的。”~
@104766 = ~“但我信赖主脑的智慧，所以我把我的反感放到一边和你做生意……并且将你与其他奴隶贩子一视同仁。”~
@104767 = ~夺心魔的触角轻微地颤动了一下，好像他有点紧张。“开放佐瓦柯穆是一方面，但我不知道主脑是否会和一个奴隶族的人交谈。”~
@104768 = ~“如果你真的想要主脑接见你，你必须先和那些圣所的守卫谈谈。你可以在城市的东南方向找到他们。”~
@104769 = ~“再次向您问候，我的<RACE>朋友。你是来看看我这里有什么出售吗？毫无疑问，我是唯一做你生意的物主。”~
@104770 = ~“我要走了。”~
@104771 = ~“你是谁？”~
@104772 = ~“让我看看你这里卖些什么。”~
@104773 = ~“我可以问你一些问题吗？”~
@104774 = ~“你知道一些关于叫瓦纱瑞丝的卓尔的事吗？”~
@104775 = ~“为什么佐瓦柯穆要对外界开放？”~
@104776 = ~“我可以从哪里购买一个奴隶？”~
@104777 = ~“为什么你要和我交易而其他的则不？”~
@104778 = ~“我需要和主脑谈谈。”~
@104779 = ~“这是通往长老议会的入口。你不许呆在这里，地表人。回到镇中心去，和其他的奴隶种族呆在一块。”~
@104780 = ~你感到灵吸怪试图探查你的想法，从而知道你的意图。当然，你的头盔保护着你。~
@104781 = ~“没有一个奴隶种族的生物可以和主脑说话。告诉我你的事，我可以为你转达。”~
@104782 = ~灵吸怪进入了一个简短的精神境界，而且你意识到它正在用心灵感应和另外一个实体进行沟通。它有一个让人惊讶的开始，并且突然地结束了。~
@104783 = ~夺心魔的触角轻微地颤动了一下，你感到它正在探查你不经意时的思想。它用一个你只能在脑海中听到的声音对你说：~
@104784 = ~“你不是很笨就是很勇敢，在我之前离开你脆弱的思想境界。此外，当你成为我的奴隶的以后，你会失去了所有你以前的记忆！”~
@104785 = ~“主脑说可以进入长老议会。但是，当你戴着你的保护头盔的时候，你不可以进去。”~
@104786 = ~夺心魔走了，什么也没说一句说离开了你。~
@104787 = ~“那你就不允许进入长老议会。”~
@104788 = ~“移到中间那个垫子上，它将把你传输到主脑的圣所。”~
@104789 = ~我已经没其他的要和你说了，地表人。为你自己的事打算一下吧。~
@104790 = ~“主脑跟你这个地表人没什么更多的事可谈。”~
@104791 = ~“你不能再进入圣所了。”~
@104792 = ~“再见。”~
@104793 = ~“我必须和主脑交谈。”~
@104794 = ~“没事。我过会儿回来。”~
@104795 = ~“我是来谈论瓦纱瑞丝的。”~
@104796 = ~“我过会儿再来。”~
@104797 = ~“我不会除去我的头盔的。”~
@104798 = ~“如果你死了，你就不能让我置身事外了！”[攻击灵吸怪。]~
@104799 = ~“很好，这是我的头盔。”~
@104800 = ~夺心魔的意识快速地掠过了你的思维，随后又恢复原样，道：“欢迎来到佐瓦柯穆的角斗场。”~
@104801 = ~“你已经在下次战斗上下好注了吗？这对于那些有能力在战斗中恰当地挑选的人是很有益的。”~
@104802 = ~“不过，尽管他们的战斗是有趣的，但要你在其中某个角斗士身上下了赌注的话，那看起来就更带劲儿了。”~
@104803 = ~灵吸怪无声无息地离开了你。~
@104804 = ~夺心魔厌恶地回答：“角斗场是为了让奴隶们替主人服务的。考虑加入其中会显现你内在的弱点！”~
@104805 = ~“尽管你是一个<RACE>，但你不是一个奴隶。你不能进入角斗场。除非你想让自己成为一个灵吸怪的没头脑的奴隶。”~
@104806 = ~灵吸怪在你脑海里笑了：“我也这么觉得。因为你是那种不情愿服侍灵吸怪的人。”~
@104807 = ~一阵轻蔑的感觉冲击了你。“灵吸怪不会纡尊降贵来回答奴隶种族的问题。难道我们允许你进入佐瓦柯穆还不够吗？”~
@104808 = ~“如果你要在角斗场下注就爽快点，要是不下，我们就没什么好谈的了。”~
@104809 = ~“那恐怕不可能。一旦一个奴隶被带到了场上，他的思想就会被破坏，变成没有头脑的角斗士。我们并不打算把他们释放回佐瓦柯穆。”~
@104810 = ~“但你还是可以自由地下注到你的奴隶身上，你如果你想的话。”~
@104811 = ~“他们有些人只是单纯地为了享受观看流血和暴力。如果那就是你所想看的，那么你有权这么做。”~
@104812 = ~“你确定吗？下一场战斗包括了你先前购买的那个女人。很多人喜欢把赌注下到他们自己的奴隶身上。”~
@104813 = ~“如你所愿。你想给她买一些装备吗？这也许会让你的奴隶增加获胜的机会。”~
@104814 = ~“下一场战斗将在和的奴隶间展开。总赌注为500金子。”~
@104815 = ~“太棒了。你下了注的奴隶将穿蓝色，你的对手将穿红色。如果蓝色的奴隶赢了，你可以到这里来取你的注金。”~
@104816 = ~“太棒了。你下了注的奴隶将穿红色，你的对手将穿蓝色。如果红色的奴隶赢了，你可以到这里来取你的注金。”~
@104817 = ~“我们将准备让你的女性人类奴隶参加下一场决斗。你想给她买一些装备吗？这也许会让你的奴隶增加获胜的机会。”~
@104818 = ~“我会看着你的指令被执行。现在你可以在她身上下注。赌注总共为500金币。”~
@104819 = ~“太棒了。你下了注的奴隶将穿红色，你的对手将穿蓝色。如果你的奴隶在战场上赢了，过来告诉我并取走你的奖金。”~
@104820 = ~“她是一个战士，她该得到一个公平战斗的机会。这是你现在最后能为她做的。”~
@104821 = ~“你把那可怜的姑娘送到角斗场真是太糟糕了。你最后所能为她做的就是看她有一个战斗的机会。”~
@104822 = ~“老大，你想让她赤裸裸地去战斗，是吗？德金认为那并不公平。”~
@104823 = ~“这对不是灵吸族的你来说一定很困难，因为你不能够通过心灵去支配你的奴隶。这使他们具有挑战性，有时他们都忘了身处何地。”~
@104824 = ~“然而，你的奴隶并不是我的问题。我将看着你的奴隶在对战中实行你的指令。你希望打她的赌吗？赌金总共为500条金子。”~
@104825 = ~瓦伦向灵吸怪那里投去了小心的一瞥，然后他的目光向下。“对不起，主人。原谅我。”~
@104826 = ~娜西拉神情紧张地瞥了一眼灵吸怪的方向，然后目光向下。“对不起，主人，原谅我。”~
@104827 = ~“欧……没错。对不起，老大。德金忘了。”~
@104828 = ~“给100金子，我们将给她刀剑和铠甲。要不然，她只能得到一把剑。这费用每次你的奴隶进入圈子都必须付。”~
@104829 = ~“你先前送来的奴隶——你在拍卖行购买的那个女性人类——真是一个有趣的怪人。我期望看到她在角斗场上。”~
@104830 = ~片刻间你在你脑海中好像听到了嘲笑，不料竟被灵吸怪的声音代替了。“你的损失真是不幸，但赌博时那是一种冒险。”~
@104831 = ~“也许下一次你会更幸运些的。你想要在接下来的那场战斗上下注吗？”~
@104832 = ~“真遗憾，你下注的奴隶死了。现在你除了在别的角斗士身上下注没有别的选择。你想要在下一场战斗上下注吗？”~
@104833 = ~“你感到了来自夺心魔的一闪而过的烦恼。”你到这来取你的奖金，别怀疑。很好，这是你的奖励。”~
@104834 = ~“我好奇地想知道你是交好运。你想下另外一注吗？”~
@104835 = ~“你的奴隶打得很好，尽管我很好奇她能否将在接下来的战斗中表现得同样出色。也许你会愿意在她的命运上下另一注。”~
@104836 = ~“一场精彩的战斗，你难道不这么认为吗？当然，可如果你在其中一个奴隶身上下赌注的话，你会找到远远更多的乐趣。也许你想下注在下一场战斗上吗？”~
@104837 = ~“战斗马上就要开始了。你可用望远镜来观看战斗。”~
@104838 = ~夺心魔的触角轻微地颤动了一下，你感到它正在探查你不经意时的思想。它用一个你只能在脑海中听到的声音对你说：~
@104839 = ~“你不是很笨就是很勇敢，在我之前离开你脆弱的思想境界。此外，当你成为我的奴隶的以后，你会失去了所有你以前的记忆！”~
@104840 = ~“我要离开了。”~
@104841 = ~“我能加入这个角斗场吗？”~
@104842 = ~“我想赌一赌下一场战斗。”~
@104843 = ~“我想那就算了吧。”~
@104844 = ~“我想问你一些问题。”~
@104845 = ~“我想把我的奴隶从角斗场里释放出来。”~
@104846 = ~“我对赌博不感兴趣。”~
@104847 = ~“不，我不想打赌。”~
@104848 = ~“我对这场赌博有点兴趣。”~
@104849 = ~“我已经决定了，我不想下注。”~
@104850 = ~“我出500个金币，赌的奴隶会赢。”~
@104851 = ~“我出500个金币，赌的奴隶会赢。”~
@104852 = ~“忘了这件事吧。让她留在那儿。”~
@104853 = ~“我赌我自己的奴隶会赢，500个金币。”~
@104854 = ~“好吧。这是100个金币。给她一些装备。”~
@104855 = ~“给我安静，奴隶！我是你的主人，你还记得吗？”~
@104856 = ~“这些装备多少钱？”~
@104857 = ~“这是100个金币。给她一些装备。”~
@104858 = ~这只灵吸怪试图探测你的思想，你感到大脑一阵刺痛。但是由于无法穿透你头盔的防护，灵吸怪只能极不情愿的放弃了。~
@104859 = ~这只灵吸怪用非常轻蔑的口吻对着你说：“我是不会把我的货物卖给一名<RACE>的。你们这个种族就只配做我们的奴隶。”~
@104860 = ~当你靠近的时候，这只夺心魔有点兴奋地抽动了一下它的触须，然后你就觉得它探测到了你毫无防备的思想。它用只有你的大脑能听到的声音说道：~
@104861 = ~“你要不就是极其愚蠢，要不就是极其勇敢，居然把你脆弱的思想暴露在我的面前！但是不管怎样，你一旦成为了我的奴隶，就不可能再想起以前的事情了！”~
@104862 = ~由于你和主脑之间的契约，这只灵吸怪知道最好不要试图去探测你的思想。~
@104863 = ~奴役这个女人思想的那个法术已经被解开了。很明显地，这只灵吸怪认为，接下来就是你的事情了。她用敌视的眼光瞪着你。~
@104864 = ~“那么你就是把我买下来的人了？你打算让我做什么？把我送到角斗场去供你消遣吗？”她对着你的脚吐了口唾沫，“我恨你！”~
@104865 = ~“我不会向你屈服的。自由是值得用生命去争取的！”~
@104866 = ~“给我一些装备，让我得到一次战斗的机会，也许你是正确的。无论如何，我宁愿死在战斗中，也不想作为一个奴隶活着。”~
@104867 = ~这个女人放声大哭，然后就消失在一阵闪光之中。毫无疑问，灵吸怪用魔法把她带去角斗场了。~
@104868 = ~她哼着鼻子说：“没错。把我放到幽暗地域里，无遮无掩，毫无防备，这样你们就可以欣赏到我是怎么死的了？我才不愿这样呢。但不管如何，看来我是没法活着出城了。”~
@104869 = ~[你意识到她是对的。如果她知道自己不再是奴隶了，夺心魔就会读到她的想法然后把她杀了。如果你想帮她，就得让她认为自己还是奴隶。]~
@104870 = ~她疑惑地看着你，问：“让我送信？你不怕我会逃跑吗？等等……你施了什么法术，把我和你绑定在一起了，是吗？”~
@104871 = ~她点了点头，冷静地接受了：“我明白了。给我要传达的消息，再告诉我去那儿的路。”~
@104872 = ~她捎上你的信然后就离开了，并没有意识到这是使她能够安全离开灵吸怪城市的唯一方法。等下次你回到先知的营地的时候，就可以告诉她真相了。~
@104873 = ~她想到这里，面色一僵，但随后又恢复了常态：“不要以为你脸上没有长出触须来我就会对你心存感激。奴隶就是奴隶！”~
@104874 = ~这个女人面无表情，用坚定的眼神一直盯着你。~
@104875 = ~“闭嘴，奴隶。你应该学学什么叫尊敬！”~
@104876 = ~“我敢打赌，在角斗场里，我可以从你身上赚到不少钱。”~
@104877 = ~“把她带到角斗场去。”~
@104878 = ~“我会给你自由的。”~
@104879 = ~“你得去给我的一位盟友送个信，奴隶。”~
@104880 = ~[说谎]“是的。如果你胆敢反抗的话，我就会让你知道死亡的可怕和痛苦。”~
@104881 = ~[给她一个假的消息，然后指出到先知那里的路。]~
@104882 = ~“难道你宁愿当灵吸怪的奴隶吗？”~
@104883 = ~因为灵吸怪想要接触并探查你的思想，你感到一阵晕眩，但是你的头盔使你成功的抵挡住了它的这次尝试。在感到了你的防守之后，灵吸怪的思想撤退了。~
@104884 = ~“你好，<RACE>。在佐瓦柯穆这里，你这个种族并不常见。当然，除了作为奴隶。毫无疑问，你是冲着拍卖来的吧。不用害怕，我们马上就要开始了。”~
@104885 = ~“下一个拍卖品是一名人类女性，她的种族在这里相当的不寻常。她的血统优良健康，也是一名出色的武士，你可以选择把她放到角斗场里去。”~
@104886 = ~“这里已经有两名预定的买主在等待了，但是我不想在少于三名出价者的情况下开始拍卖。在开始之前我会等你的。”~
@104887 = ~“但是不要花太长时间了。如果在你之前有第三名买主出现的话，我就会开始喊价，你可能就会失去买到一个这么好的奴隶的机会。”~
@104888 = ~灵吸怪走回去，并且把它的思想从你和另外几位买主的头脑里同时收回。“现在开始，我们就要对下一个拍卖品——一名人类女性出价了。”~
@104889 = ~“正如你们所看到的，她的血统非常优秀：又强壮又健康。我们从1000个金币开始喊价。”~
@104890 = ~你的一个竞争对手注意到了：“你看起来非常想加价。你肯定知道这个奴隶的真正价值。我出1500个金币。”~
@104891 = ~拍卖师看起来很高兴：“1500个金币。但是肯定有人会高过这个价。2000个金币？有人出2000个金币买这个奴隶吗？”~
@104892 = ~你的对手很快又出价了：“我出2000个金币。”~
@104893 = ~另一个出价的灵吸怪摇了摇头,道：“太贵了。我放弃了。”~
@104894 = ~拍卖师转过来看着你，问：“你能超过这个价吗？2500个金币？”~
@104895 = ~“好像没有人再加价了。这个女性奴隶将归这位灵吸怪买主所有。”想到将要被新的主人带走，女孩开始轻声啜泣起来。~
@104896 = ~你在喊价中猛地跳了起来，似乎要冲过去抓住你的对手。“3000个金币？就那样了吗？你明显就比我还想要得到这个奴隶。我要退出竞价。”~
@104897 = ~剩下的另一名买主快速的盘算了一下：“我出2800个金币。”~
@104898 = ~[失败]你的威胁激怒了对手，他喊出了一个高价。“我不会在对一个奴隶的出价上输给别人的！我出4000个金币！”~
@104899 = ~灵吸怪思考了很长的一段时间，最后承认：“我无法高过那个出价。她是你的了。”~
@104900 = ~“看起来好像没有人再加价了。奴隶是你的了，5000个金币成交。”~
@104901 = ~[成功]令人惊讶的是，你的威胁似乎对对手产生了效果。他考虑了一小会儿，然后摇了摇头。~
@104902 = ~“看起来好像没有人再加价了。奴隶是你的了，3000个金币成交。”~
@104903 = ~在开始下一场拍卖前，夺心魔们争论了很长一段时间。“这个女奴隶要3500个金币。”~
@104904 = ~灵吸怪思考了很长的一段时间，最后承认：“我无法高过那个出价。她是你的了。”~
@104905 = ~“看起来好像没有人再加价了。奴隶是你的了，4000个金币成交。”~
@104906 = ~拍卖师的声音在你的头脑中狂乱地尖叫着：“你竟敢耍弄我们，奴隶？你认为这只是一场游戏吗？现在你要为此付出代价！”~
@104907 = ~附近的一个灵吸怪——你在拍卖会上的竞争对手——喊价了：“1000个金币。”~
@104908 = ~第三个买主加价了：“这个人类女性，我出1100个金币。”~
@104909 = ~拍卖师抓住这一点分析：“1100个金币对于这么好的一件拍卖品来说真是低得可怜的价钱啊。她不但可以用来繁殖小奴隶，还是角斗场中战斗的最佳候选人。有人出1500个金币吗？”~
@104910 = ~[失败]你的表演没能愚弄到其他的出价人。“这个<RACE>想要欺骗我们。这名奴隶一定很值钱。我出1500个金币。”~
@104911 = ~[成功]其他的出价人仔细地考虑了一下你的解释。“这个<RACE>出价人好像对人类的健康状况比我们了解得更多。我决定退出。”~
@104912 = ~“我也一样。我也不想买到一个虚弱的奴隶。”~
@104913 = ~拍卖师显得心烦意乱，但是很明显地，已经没有其他买家再叫价了。“很好，这个奴隶是你的了，1300个金币成交。”~
@104914 = ~女孩走近了。~
@104915 = ~尽管很难看得出这种脸上长着触须的生物的表情，你还是能够感到灵吸怪有些轻微的抵触。~
@104916 = ~“我很愿意卖东西给一名<RACE>买主，但是我不想降低自己的身份来回答奴隶种族提出的问题。”~
@104917 = ~“我们灵吸怪在各个方面都要优于你们种族。因为我从事贩卖奴隶的工作，所以我允许你在拍卖会上出价。但是，不要以为我会对一个奴隶种族平等相待。”~
@104918 = ~“虽然佐瓦柯穆对你们这个种族是开放的，但你在这里是不受欢迎的。这里的人只是在尽量容忍你。那么，现在我们可以开始拍卖这个奴隶了吗？”~
@104919 = ~“在佐瓦柯穆这个地方，主人们通常会把自己的奴隶带到角斗场里，让他们互相战斗。这相当有趣，而且如果你的奴隶赢了的话还可以大赚一笔。”~
@104920 = ~“但是在你把这个奴隶送到角斗场里之前，你必须先把她买下来。那么，我们现在开始拍卖？”~
@104921 = ~当你接近的时候，这个灵吸怪再次慎重地探侧你的思想，想找出你精神防守上的漏洞，不过当它意识到你的精神防护是完美无缺的之后，只能撤退了。~
@104922 = ~“<RACE>，我正在等你。你准备好参加拍卖会了吗？如果好了的话，我就要开始对下一个奴隶出价了。”~
@104923 = ~当你靠近的时候，这只夺心魔有点兴奋地抽动了一下它的触须，然后你就觉得它探测到了你毫无防备的思想。它用只有你的大脑能听到的声音说道：~
@104924 = ~“你要不就是极其愚蠢，要不就是极其勇敢，居然把你脆弱的思想暴露在我的面前！但是不管怎样，你一旦成为了我的奴隶，就不可能再想起以前的事情了！”~
@104925 = ~由于你和主脑之间的契约，这只灵吸怪知道最好不要试图去探测你的思想。~
@104926 = ~“我还没准备好开始叫价。”~
@104927 = ~“你骗我！你罪该万死！”~
@104928 = ~“我们开始拍卖了。”~
@104929 = ~“我出1200个金币。”~
@104930 = ~“对我来说，这个价太高了。我让给他了。”~
@104931 = ~“我出3000！”~
@104932 = ~“我出2500个金币。”~
@104933 = ~威吓“3000个金币——而且你最好放聪明点，不要再高过我的出价了！”~
@104934 = ~“那个女孩，我出5000个金币要了。”~
@104935 = ~“这是5000个金币。”~
@104936 = ~“这是3000个金币。”~
@104937 = ~“我加到3000。”~
@104938 = ~“4000。”~
@104939 = ~“我身上没有那么多金币。”~
@104940 = ~“我改主意了。我不想要她了。”~
@104941 = ~“这是4000个金币。”~
@104942 = ~“我出1000个金币。”~
@104943 = ~[安静地待着。]~
@104944 = ~[付1300个金币。]~
@104945 = ~[安静地待着。]~
@104946 = ~“我出1500个金币。”~
@104947 = ~[唬骗]“这个奴隶一看就是个头脑简单的人。我最多就出1300个金币。”~
@104948 = ~[劝说]“1500个金币买个这么虚弱的女人太不值了。我只出1300个金币。”~
@104949 = ~“这是1300个金币。”~
@104950 = ~“我想问你一些问题。”~
@104951 = ~“奴隶是要服侍主人的！我不是奴隶！”~
@104952 = ~“你的意思是说你们是高贵的种族，所以不屑于回答我的问题？”~
@104953 = ~“去死吧，你这个傲慢无礼、满脸触须的怪物！”~
@104954 = ~“角斗场？”~
@104955 = ~“说说这个奴隶的事情。”~
@104956 = ~奴隶不该来打扰我的休息！你可以去死了。~
@104957 = ~你随手打碎了更多的控制器，发现这个结界好像无效了。~
@104958 = ~你随便打碎了几个控制器，发现好像激活了这个奇怪的装置。~
@104959 = ~你挣扎着想要理解这个有着许多控制器的奇怪装置。~
@104960 = ~你的面前浮现出了一个图案……是一个奇怪的数学方程式。你集中精神，发现这些图案是可以来回转换的。~
@104961 = ~[失败]~
@104962 = ~[成功]~
@104963 = ~这些图案排列成下面的模式：2……3……5……7……11……13~
@104964 = ~[失败]~
@104965 = ~[成功]你意识到这些图案代表的是素数，下一个数字应该是17。你把图案变成了这个数字。~
@104966 = ~这些图案聚集到一起，爆发出一阵光芒。~
@104967 = ~这些图案盘绕在一起然后就消失了。你好像没有成功。~
@104968 = ~不管那扇门。~
@104969 = ~[使用开锁技能]不管那些图案而去试着开锁。~
@104970 = ~[努力思考]试着专注于这些图案上。~
@104971 = ~[做智力检定]~
@104972 = ~试着排成数字19的图样。~
@104973 = ~试着排成数字17的图样。~
@104974 = ~试着排成数字15的图样。~
@104975 = ~试着排成数字11的图样。~
@104976 = ~你的面前浮现出了一个图案……是一个奇怪的数学方程式。你集中精神，发现这些图案是可以来回转换的。~
@104977 = ~[失败]~
@104978 = ~[成功]~
@104979 = ~这些图案排列成下面的模式：2……8……18……32……50……72……~
@104980 = ~[失败]~
@104981 = ~[成功]你意识到这些图案代表的是一个数列，平方的两倍。你把图案变成了98这个数字。~
@104982 = ~这些图案聚集到一起，爆发出一阵光芒。~
@104983 = ~这些图案盘绕在一起然后就消失了。你好像没有成功。~
@104984 = ~不管那扇门。~
@104985 = ~[使用开锁技能]不管那些图案而去试着开锁。~
@104986 = ~[努力思考]试着专注于这些图案上。~
@104987 = ~[做智力检定]~
@104988 = ~试着排成数字108的图样。~
@104989 = ~试着排成数字98的图样。~
@104990 = ~试着排成数字96的图样。~
@104991 = ~试着排成数字49的图样。~
@104992 = ~你的面前浮现出了一个图案……是一个奇怪的数学方程式。你集中精神，发现这些图案是可以来回转换的。~
@104993 = ~[失败]~
@104994 = ~[成功]~
@104995 = ~这些图案排列成下面的模式：1……1……2……3……5……8……13……21~
@104996 = ~[失败]~
@104997 = ~[成功]你意识到这是一个数列，第三个数是前两个数的和。你把图案变成了34这个数字。~
@104998 = ~这些图案聚集到一起，爆发出一阵光芒。~
@104999 = ~这些图案盘绕在一起然后就消失了。你好像没有成功。~
@105000 = ~不管那扇门。~
@105001 = ~[使用开锁技能]不管那些图案而去试着开锁。~
@105002 = ~[努力思考]试着专注于这些图案上。~
@105003 = ~[做智力检定]~
@105004 = ~试着排成数字21的图样。~
@105005 = ~试着排成数字36的图样。~
@105006 = ~试着排成数字30的图样。~
@105007 = ~试着排成数字34的图样。~
@105008 = ~你的面前浮现出了一个图案……是一个奇怪的数学方程式。你集中精神，发现这些图案是可以来回转换的。~
@105009 = ~[失败]~
@105010 = ~[成功]~
@105011 = ~这些图案排列成下面的模式：34……21……13……8……5……~
@105012 = ~[失败]~
@105013 = ~[成功]你意识到这是一个数列，第三个数是前两个数的差。你把图案变成了3这个数字。~
@105014 = ~这些图案聚集到一起，爆发出一阵光芒。~
@105015 = ~这些图案盘绕在一起然后就消失了。你好像没有成功。~
@105016 = ~不管那扇门。~
@105017 = ~[使用开锁技能]不管那些图案而去试着开锁。~
@105018 = ~[努力思考]试着专注于这些图案上。~
@105019 = ~[做智力检定]~
@105020 = ~试着排成数字4的图样。~
@105021 = ~试着排成数字3的图样。~
@105022 = ~试着排成数字2的图样。~
@105023 = ~试着排成数字1的图样。~
@105024 = ~那些进出于角斗场的人有些异样。他们的思想已经被摧毁了！~
@105025 = ~我不想变成一个没有意识的奴隶！~
@105026 = ~“你不能进入这个地方。除了调教师以外，其他人都不可去看那些准备参加角斗的奴隶。”~
@105027 = ~“这里是关押他们的牢房，我是看守。在调教师来之前，要参加角斗的奴隶会被一直关在这里。而我也会在调教师来之前一直看着他们。”~
@105028 = ~“怎么又回来了？难道我上次没有说清楚吗？我的职责就是确保除了调教师以外，别人都不能去看那些要参加角斗的奴隶。”~
@105029 = ~“如果你想参观角斗场的战斗的话，到镇中心去和角斗场的老板商量商量。”~
@105030 = ~“在佐瓦柯穆，你只能去主人让你去的地方。而我是除了灵吸怪以外，唯一一个允许呆在这里的人。在还没有惹出你无法处理的麻烦之前，还是赶快回去吧。”~
@105031 = ~这个灰矮人只是哼了一声作为回应，就没有再说话了。~
@105032 = ~“嗯，你看起来好像精力充沛？当你成为奴隶，然后被扔进竞技场里的时候，我的主人看到你滑稽的表演，一定会很高兴的。”~
@105033 = ~“对，没错。那个女人刚好被人买走了。对不起，地表生物——她不在这里。调教师已经开始‘关照’她了。”~
@105034 = ~“她现在只不过是一只没有思想动物而已。她的余生就将在角斗场的战斗中度过。如果你想了解她的状况的话，去镇中心找角斗场的老板谈谈。”~
@105035 = ~“主人们可以把奴隶送到角斗场中去战斗。有些主人就是喜欢打赌，看看最后是哪个奴隶能在战斗中幸存下来。”~
@105036 = ~“当然，只有在调教师处理好了他们以后，主人才能把奴隶送到角斗场里去。我就负责在那之前看着这些奴隶。”~
@105037 = ~从这个灰矮人眼中露出了凶残的眼神。“调教师是从最有权势的灵吸怪中选出来的。在把奴隶送到角斗场之前，调教师会改变他们的。”~
@105038 = ~“奴隶们的精神被彻底剥夺，种族特征也不复存在，最后剩下的其实就是一只原始动物。这样就会使得角斗场中的战斗更加有趣。”~
@105039 = ~灰矮人咧着嘴笑道：“至于调教师改变奴隶的大脑使之适合角斗的那些细节，我是不会去深究的，不过可以肯定的一点就是，调教师从牢房中出来的时候没有进去的时候那么饥渴。”~
@105040 = ~灰矮人笑着说：“好吧，首先，我从来都用不着担心他们的触须会伸进我的头骨里……我的脑子好像有点问题。灵吸怪对它不感兴趣。”~
@105041 = ~“其次，灵吸怪不会介意我随便借用奴隶。奴隶们好像也不会在乎。至少他们不会抱怨。也许是因为他们的脑子已经是一些碎块了。”~
@105042 = ~“最后，调教师会让我参观他们训练新奴隶的过程。大多数人在看到那些触须伸进头骨的时候都会有些作呕，但是我喜欢坐下来慢慢欣赏。”~
@105043 = ~“这就是我如此喜欢这份工作的原因。灵吸怪信任我，让我看守这些准备参加角斗的奴隶。他们知道我是不会背叛调教师的。”~
@105044 = ~“而且人们都认为我们卓尔是残忍无情的。”~
@105045 = ~“你也知道，调教师会让我参观他们训练新奴隶的过程。大多数人在看到那些触须伸进头骨的时候都会有些作呕，但是我喜欢坐下来慢慢欣赏。”~
@105046 = ~他狠狠地盯着娜西拉看了很长一段时间。“他们告诉我卓尔的大脑是他们最喜欢的一样东西，不过没有说过原因是什么。”他耸了耸肩。“可能是因为里面充满了邪恶吧。”~
@105047 = ~泰夫林一只手按在武器的柄上。“你真是个卑鄙无耻、令人厌恶的生物！”~
@105048 = ~“你也知道，调教师会让我参观他们训练新奴隶的过程。大多数人在看到那些触须伸进头骨的时候都会有些作呕，但是我喜欢坐下来慢慢欣赏。”~
@105049 = ~“不过我以前从没见过他们以你这样的人为食，泰夫林。所以镇定一点，否则调教者就会去找新的试验品的！”~
@105050 = ~“呃……天哪！德金觉得你不像好人！”~
@105051 = ~“你也知道，调教师会让我参观他们训练新奴隶的过程。大多数人在看到那些触须伸进头骨的时候都会有些作呕，但是我喜欢坐下来慢慢欣赏。”~
@105052 = ~看守瞪了德金一眼。“不过我以前从没见过他们吃狗头人的大脑。”看守耸了耸肩。“也许那儿没什么可担心的。”~
@105053 = ~“你是谁？这是哪里？”~
@105054 = ~“你不是奴隶。那你为什么要服侍灵吸怪？”~
@105055 = ~“我要离开了。”~
@105056 = ~“我想去哪儿就去哪儿，想什么时候走就什么时候走。”~
@105057 = ~“对不起。我要离开了。”~
@105058 = ~“我不会任由一只灰矮人摆布的！”~
@105059 = ~“我想看看我送到角斗场去的那个奴隶。”~
@105060 = ~“你的死期到了。”~
@105061 = ~“角斗场？”~
@105062 = ~“调教师？你在说什么？”~
@105063 = ~“太可怕了！你居然服侍这样的怪物！”~
@105064 = ~“听起来你好像在这里找到了一份不错的工作。”~
@105065 = ~“你这个怪物！”~
@105066 = ~灰矮人迅速地打量了你一眼，然后似乎放松了下来。“在这里像你这样的人很少见啊，地表生物。至少，不包括那些被灵吸怪抓去当奴隶的。”~
@105067 = ~她轻轻地敲了敲自己的头盔，说：“随时准备好对付那些夺心魔的精神攻击，不是吗？你根本就不能相信那些触须头。”~
@105068 = ~“灵吸怪说不定愿意卖奴隶给我们，不过你也知道，他们很快就会把我们也变成奴隶的。然后就看着我们在角斗场里互相殴打着对方的脑壳。”~
@105069 = ~“再见，地表生物。”~
@105070 = ~她一脸惊讶的看着你。“干我们这行的可不会乱问问题。更何况是在这样一个地方。在这里，你最好要学会保守秘密。”~
@105071 = ~“不会的。夺心魔是不会到这个酒馆来的。据说这是因为他们尊重我们在这个地方的隐私权，但我才不相信呢。灵吸怪根本就不可能会相信我们。”~
@105072 = ~“就我个人来说，我认为是酒馆里的这个魔像使他们不敢到这里来的。据说，这个酒馆是七个世纪以前，由一名灰矮人创业者建立的，是给灵吸怪以外的访客落脚的地方。”~
@105073 = ~“我不知道这个故事到底是不是真的，不过倒是可以解释这个地方的来历。而且也能说明为什么这里没有灵吸怪：魔像很有可能会攻击视线内的灵吸怪。”~
@105074 = ~她的脸色变得凝重起来。“你不想一边走来走去一边说出那样的话。灵吸怪会不惜一切代价保护主脑不受外来入侵者的伤害。”~
@105075 = ~“在镇子的东南方有一个传送点，灵吸怪一般通过它去到主脑那儿，不过我觉得夺心魔守卫是不会让你进去的。”~
@105076 = ~她耸了耸肩，道：“这是一项娱乐活动，也是赚钱的好方法，当然前提是你知道该赌谁赢。简单来说就是，他们把两个奴隶扔进场地里，让那两人互相战斗，直到有一方战死为止。”~
@105077 = ~“如果你愿意的话，也可以把奴隶放到角斗场里去，不过别指望他还能回来。夺心魔会把他们的头脑彻底破坏掉。我猜这是确保他们能够一直战斗到死亡的好方法。”~
@105078 = ~“你应该去调查一下。如果感兴趣的话，去镇子的西南方找角斗场的老板谈谈。”~
@105079 = ~“在镇子的中央地带，通常会有拍卖会举行。他们在那里做一种特殊的交易：购买一个奴隶，然后可以免费让它准备到角斗场里战斗。”~
@105080 = ~瓦伦轻声说道：“我知道我们在这里的身份是奴隶，不过这个计划真的还要继续进行下去吗？我们的最终目标应该是主脑吧。”~
@105081 = ~娜西拉轻声说道：“我知道我们在这里的身份是奴隶，不过这个计划真的还要继续执行去吗？我们的最终目标应该是主脑吧。”~
@105082 = ~灰矮人感激地偏了偏头。很明显，她觉得呆在你身边比在灵吸怪身边要自在多了。“你还需要些什么别的吗，地表生物？”~
@105083 = ~“听起来外面好像正在进行一场战斗，不过在一切平息下来以前我会一直呆在这里的。我是来这里买奴隶的，才不想卷进那些夺心魔的争斗中！”~
@105084 = ~“我要离开了。”~
@105085 = ~“我想问你一些问题。”~
@105086 = ~“我在这里一只灵吸怪都没看到。”~
@105087 = ~“实际上，我正在想办法接近主脑。”~
@105088 = ~“买奴隶听起来很有趣啊。”~
@105089 = ~“跟我说说有关角斗场的事情。”~
@105090 = ~“我能在哪里买到奴隶？”~
@105091 = ~我会一直盯着你的。不要随便惹事。~
@105092 = ~“没什么，只是一次很平常的小冲突而已，不是吗？你需要点什么？”~
@105093 = ~“一天里来了两个客人——太不可思议的。需要点什么吗？”~
@105094 = ~这个魔像用低沉的声音对你说：“在749年17天3小时14分钟之前，我的制造者觉得这个地方很适合建个酒馆。”~
@105095 = ~“你是第一个要求我提供帮助的人。”~
@105096 = ~这个魔像用一个很脏的杯子，从小桶中舀了满满一杯的褐色淤泥，然后递给了你。~
@105097 = ~当你看到魔像脸上浮现出一阵悲伤的表情的时候，不禁咒骂了一声，不过当你再注意到的时候，魔像已经恢复了平常的表情。~
@105098 = ~“我对这间酒馆外的事情一无所知。我很抱歉，不过那些老主顾可能会告诉你更多的情报。”~
@105099 = ~“这间酒馆叫做毒药圣杯宫。自从我的制作者死了以后，它就属于我了。大部分造访灵吸怪的商人都会来这里。我想他们觉得聚集在这里很安全。”~
@105100 = ~“我是这儿的招待。我的功能是满足顾客需要，但在你之前从没人需要我的帮助。”~
@105101 = ~“噢……你在这里待了很久了。德金敢打赌你是真的很忙，啊哈？”~
@105102 = ~“你是第一个要求我提供帮助的人。”~
@105103 = ~“啊，这太令人难过了。嗨，也许你能买些什么，老大！说不定你会成为第一个顾客，而得到奖赏呢！”~
@105104 = ~“事实上，我觉得我该离开了。”~
@105105 = ~“给我来一杯。”~
@105106 = ~“嗯，不了，谢谢。”~
@105107 = ~[喝杯子里的酒]~
@105108 = ~“我还想知道些其他的事情。”~
@105109 = ~“这是哪儿？”~
@105110 = ~“你是谁？”~
@105111 = ~这名蜥蜴人上下打量了你一番，然后嘶声说：“地……地……表……表生物？噢。你是奴…奴隶吗，想要上到那个有着灼……灼热阳光……光的世界去吗？或者是来这里参观角斗场角……角斗的？”~
@105112 = ~“再见，地……地表生物。”~
@105113 = ~他眯着爬虫类的眼睛怀疑地看着。“我不喜欢问……问题。如果你想要向灵吸怪买奴……奴隶的话，最好学会保持自己的神秘感，地……地表生物。”~
@105114 = ~“灵吸怪不会到这……这个地方来的。可能他们也知道，我们需要一个不……不受思想探测和看不到他们奇……奇怪样子的地方，他们尊重我们的隐私。”~
@105115 = ~“或者是因为他们害怕酒馆里的那个魔像。他们的精神力……力量对那个构装生物没用。不管怎么说，这……这里是佐瓦柯穆里唯一一处灵吸怪不会来的地方。”~
@105116 = ~蜥蜴人的舌头伸进伸出地嘲笑你。“只有灵吸怪才能接……接近主脑。他们不会让你进去的，地……地表生物。”~
@105117 = ~“如果你已经无计可施了，可以去……去东南方和传送点的守卫谈谈。不过一般来说，他们会把你送去角……角斗场而不是送去主脑那儿。”~
@105118 = ~“有……有些人就是喜欢看他们的货物互相打斗，不过我觉得这实在是一种愚蠢的浪费。”~
@105119 = ~“即使是你的奴隶赢……赢了，灵吸怪已经在比赛前的准备过程中把他们的头……头脑破坏了。他们把奴隶变成了野蛮的动…动物。因为这样有益于战……战斗。”~
@105120 = ~“如果你对这……这项活……活动感兴趣的话，应该到镇中心去和角斗场的灵吸怪老板谈……谈谈。他可以处理你想要下的任何赌……赌注。”~
@105121 = ~“你接下来应……应该去调查一下镇中心的拍卖会。我等会儿也会去的。如果你买了奴隶的话，不必再付另外的费用，他们就可以让你的奴隶准备好去角……角斗场战斗。”~
@105122 = ~这名蜥蜴人向你点头致意。虽然你和他不是一个种族的，不过很明显，他宁愿看到你的伙伴们而不想看到灵吸怪。“欢迎你回来，地…地表生物。”~
@105123 = ~“我听到外面有战斗的声……声……声音。所以我才会待……待……呆在这里……。我是一个奴……奴隶，我不是武士。”~
@105124 = ~“我要离开了。”~
@105125 = ~“我想问你一些问题。”~
@105126 = ~“我在这里一只灵吸怪都没看到。”~
@105127 = ~“实际上，我正在想办法接近主脑。”~
@105128 = ~“买奴隶听起来很有趣啊。”~
@105129 = ~“跟我说说有关角斗场的事情。”~
@105130 = ~“是的。我来这里是想买一些奴隶。”~
@105131 = ~“如果你愿意的话，跟……跟……跟我的主人说。但是不要有任何企图。”~
@105132 = ~奴隶们进入角斗场了；战斗的时刻即将到来。~
@105133 = ~把奴隶放出去，开始角斗！~
@105134 = ~“谢天谢地，你总算醒过来了——你做了一个可怕的梦。你不知道我有多担心。”~
@105135 = ~“现在已经没事了，亲爱的。冷静下来。我们会一直在一起，忘了那些恶梦吧。我们会呆在一起，会永远幸福快乐的。”~
@105136 = ~[成功]“很遗憾，你不能和我们一起留在这里。但是如果你坚持要冒这个险的话……”~
@105137 = ~这个主人牵着你的手，把你带离了那个有着夺心魔和卓尔的扰人梦境。不知道为什么，你觉得从此以后，任何事情都不用再去担心了……~
@105138 = ~“这是什么？看起来像是一个骗局！”~
@105139 = ~“这里发生了什么？你是谁？”~
@105140 = ~“一场梦？你在说什么呢？”~
@105141 = ~[试图不相信你周围的环境。]~
@105142 = ~[和这个迷人的主人相伴。]~
@105143 = ~你在这个地区注意到很多人留下的痕迹——来来往往。~
@105144 = ~看来有一大群类似人类在这个方向聚集起来，他们是在几个类似爬虫的生物的护送之下。~
@105145 = ~看来有一大群类似人类在这个方向聚集起来。从脚印上看来，他们的脚都被铐起或是捆起，而且是在几个蜥蜴人的押送之下。~
@105146 = ~你感到自己的头脑里似乎存在一种奇怪的外来之物。成千上万人的回忆和意识冲击着你的思想，快要把你压垮了。~
@105147 = ~当外来之物探寻你思想的时候，那些幻象移动变化着，似乎在寻找更好的交流方式，一种把它多重意识集中到处理一个单个实体的方法。~
@105148 = ~你感到自己的思想里有一种强烈的意识，它的字句回荡着，似乎是从无尽的虚空中发出的众多话音：“你已经允许进入内圣所——对于一个奴隶而言这是一个罕有的特权。”~
@105149 = ~“我们能看到很多你的思想，奴隶。我们看到你是瓦纱瑞丝的敌人，而且你知道灵吸怪是她的盟友。是不是这就是你来拜见佐瓦柯穆的主脑的原因呢？”~
@105150 = ~徒劳和挫折的幻象困扰着你，那个声音再次响起了。“毁灭我也不能实现你的愿望。我只是长老议会的一个普通成员。”~
@105151 = ~“毁灭我，这一小群灵吸怪会衰退灭亡，但是瓦纱瑞丝有整个长老议会的支持。毁掉我并不能阻止灵吸怪继续追随她。”~
@105152 = ~“佐瓦柯穆只是沧海一粟。在整个幽暗地域里，很多灵吸怪部落的主脑都试图和瓦纱瑞丝结盟。”~
@105153 = ~“我们主脑现在是这一长老议会的成员。只有所有相关主脑都在长老议会达成了一致意见，才可以结束我们与瓦纱瑞丝的联盟关系。”~
@105154 = ~“毁灭我，这一小群灵吸怪会衰退灭亡，但是瓦纱瑞丝有整个长老议会的支持。毁掉我并不能阻止灵吸怪继续追随她。”~
@105155 = ~“一个奴隶永远不可能说服长老议会做任何事情……但是我们佐瓦柯穆的主脑可以推动议会背弃瓦纱瑞丝。”~
@105156 = ~“灵吸怪厌恶卓尔；他们只适合做奴隶。但是我们被迫跟随瓦纱瑞丝和她的黑暗精灵大军，尽管我们恨他们。”~
@105157 = ~“我们灵吸怪跟随瓦纱瑞丝仅仅是因为我们部落中的大多数都无法与她对抗。如果你给我们对抗她的力量，我们可以撤回对她的支持。”~
@105158 = ~“那于事无补。如果没有主脑，佐瓦柯穆会衰退消亡，但是长老议会还是会存在。灵吸怪还是会追随着瓦纱瑞丝。”~
@105159 = ~“我们曾经抓到过一个来自幽暗地域奇怪村落的奴隶。村子里是来自地面的翼精灵族……尽管他们现在住在地下。”~
@105160 = ~“从奴隶的思想里，我们知道了一个威力巨大的物品——一面翼精灵用来监视敌人的魔镜。这样的物品可以给我们带来对抗瓦纱瑞丝的力量。”~
@105161 = ~“如果你拿到那面镜子，我们佐瓦柯穆的主脑会说服长老议会来对抗瓦纱瑞丝。”~
@105162 = ~“当你回来的时候，卫兵们会同意你再次进入内圣所。一旦你拿到了镜子，我们就会去说服长老议会来对抗瓦纱瑞丝。”~
@105163 = ~“我们，佐瓦柯穆的主脑，等待你的返回。”~
@105164 = ~“当你回来的时候，卫兵们会同意你再次进入我们内圣所。一旦你拿到了镜子，我们就会去说服长老议会来对抗瓦纱瑞丝。”~
@105165 = ~“消灭我们没有什么用处。其他的灵吸怪部落还是会追随瓦纱瑞丝。只有把镜子交给我们，你才能有机会推动长老议会改变决定。”~
@105166 = ~在主脑做出反应之前，一连串的图像冲进你的思想。“我们每个人都拥有别人需要的某些东西，奴隶。我们需要那面镜子，而以需要我们来说服长老议会。”~
@105167 = ~“这是我们关系的基础，奴隶。我们这些头人不想回答那些无关的问题。”~
@105168 = ~“那不可能。奴隶对于灵吸怪的生存是必须的。无论在什么情况下，长老议会都不会同意这种请求的。”~
@105169 = ~“如果你弄来那面镜子。我们佐瓦柯穆主脑会说服长老议会脱离瓦纱瑞丝。这就是协议。我们可不会和一个奴隶讨价还价。”~
@105170 = ~镜子在脑池的汩汩冒泡的粘浆上漂浮了一会，开始融化和消失，它的能量开始为主脑吸收。很快一切都消失了。~
@105171 = ~“回去找你的先知吧，奴隶。告诉她瓦纱瑞丝不再得到长老议会或者灵吸怪的支持了。”~
@105172 = ~你感到主脑在探寻你的思想，搜索关于阿戈撒斯和他的追随者的详细情况。“我们得在奴隶起来造反之前就发现。”~
@105173 = ~“你没有警告我们这件事，佐瓦柯穆可能会因此被削弱。如果我们势力微弱，就无法去说服长老议会背离瓦纱瑞丝。”~
@105174 = ~“现在去吧，奴隶。回去找你的先知。我们佐瓦柯穆的主脑对你没什么用了。”~
@105175 = ~“因为我们的原因奴隶们已经成为了牺牲品；我们无法选择只能如此来组织瓦纱瑞丝。”~
@105176 = ~“我担心灵吸怪会从阿戈撒斯和他的追随者那里得到些什么惩罚。但是我们没有别的选择只能背离他们。这是得到长老之脑支持的唯一办法。”~
@105177 = ~“哦—哦。德金认为那些奴隶现在碰到了什么糟糕的事情。”~
@105178 = ~“你一定要认真考虑这个。你的敌人是瓦纱瑞丝。只有让我们更强大，我们才能对抗她的一直。这样就能削弱她。”~
@105179 = ~“你没什么选择，奴隶。如果你希望阻止灵吸怪加入瓦纱瑞丝，你就得给我们佐瓦柯穆的主脑带来镜子。”~
@105180 = ~你感到主脑在探寻你的思想，搜索关于阿戈撒斯和他的追随者的详细情况。“我们得在奴隶起来造反之前就发现。”~
@105181 = ~“你没有警告我们这件事，佐瓦柯穆可能会因此被削弱。如果我们势力微弱，就无法去说服长老议会背离瓦纱瑞丝。”~
@105182 = ~“还需要什么吗，奴隶？如果没有，我会把你送回佐瓦柯穆，这样你可以为我们找到需要的魔镜了。”~
@105183 = ~“因为我们的原因奴隶们已经成为了牺牲品；我们无法选择只能如此来组织瓦纱瑞丝。”~
@105184 = ~“我担心灵吸怪会从阿戈撒斯和他的追随者那里得到些什么惩罚。但是我们没有别的选择只能背离他们。这是得到长老之脑支持的唯一办法。”~
@105185 = ~“哦—哦。德金认为那些奴隶现在碰到了什么糟糕的事情。”~
@105186 = ~“你又一次回到了内圣所。像以前一样，我们佐瓦柯穆的主脑看到了很多你的思想……但是并非全部。你带来魔镜了吗？”~
@105187 = ~一连串的幻想填满了你的思想：投降和乞求的场面，恐惧的感觉，恐怖和虚弱。幻象开始变化，你感到你的思想里有一种奇怪的外来之物。~
@105188 = ~你感到自己的思想里有一种强烈的意识，它的字句回荡着，似乎是从无尽的虚空中发出的众多话音：“放下你的武器。我们在你面前投降，跪求你的仁慈。”~
@105189 = ~“对于我们你太强大了。佐瓦柯穆的主脑不能对抗你，奴隶。即便如此，你毁灭了我们也毫无意义。其他的灵吸怪还是会追随瓦纱瑞丝。”~
@105190 = ~“我们能看到你很多的思想。我们看到你是瓦纱瑞丝的敌人。我们知道你试图阻止她与灵吸怪结盟。但是这并不容易实现。”~
@105191 = ~“你如约带来了魔镜。这样，我们佐瓦柯穆的主脑有力量对抗瓦纱瑞丝和她的卓尔大军了。”~
@105192 = ~“回去找你的先知吧，奴隶。告诉她瓦纱瑞丝不再拥有长老议会或灵吸怪的支持了。”~
@105193 = ~你感到自己的思想里有一种强烈的意识，它的字句回荡着，似乎是从无尽的虚空中发出的众多话音：“我看穿了你的思想，奴隶。你从监牢里释放了奴隶！”~
@105194 = ~“你可以毁灭佐瓦柯穆，但是这并不会阻止其他灵吸怪加入瓦纱瑞丝！你或许可以毁灭佐瓦柯穆的主脑，但是你终究会失败！”~
@105195 = ~主脑的高亢的声音在你的头脑里回荡着：“你背叛了我们的协议，奴隶！你攻击了佐瓦柯穆的灵吸怪，你试图摧毁我们的殖民地！”~
@105196 = ~“你的背叛或许会给佐瓦柯穆带来毁灭，但是这并不会阻止其他灵吸怪加入瓦纱瑞丝！你或许可以毁灭佐瓦柯穆的主脑，但是你终究会失败！”~
@105197 = ~“事实上，我是来毁灭你们的！”~
@105198 = ~“我才不管其他的灵吸怪！我就是想干掉你！”[攻击脑池。]~
@105199 = ~“你在说什么呢？”~
@105200 = ~“是的。我希望你能撤回对瓦纱瑞丝的支持。”~
@105201 = ~“我想我该把你干掉。”~
@105202 = ~“我能说服长老议会脱离瓦纱瑞丝吗？”~
@105203 = ~“算了。我要把你打成烂泥！”~
@105204 = ~“好的，那么，你打算怎么样？”~
@105205 = ~“我该怎么做？”~
@105206 = ~“我拿到镜子就回来。”~
@105207 = ~[不提奴隶起义。]~
@105208 = ~“现在是我粉碎主脑的时刻了！”~
@105209 = ~“我想问你几个问题。”~
@105210 = ~“如果我帮你的话，我希望你放弃奴隶贸易。”~
@105211 = ~“我能从中得到什么？”~
@105212 = ~“我不喜欢你的态度。去死吧，脑子！”~
@105213 = ~“镜子在这里。”[把镜子放进脑池。]~
@105214 = ~[不提奴隶起义。]~
@105215 = ~“我得警告你——有人正在策划一场奴隶暴动。”~
@105216 = ~“为什么我要帮助灵吸怪变得更加强大呢？”~
@105217 = ~“我得警告你——有人正在策划一场奴隶暴动。”~
@105218 = ~“抱歉——我得有始有终！”~
@105219 = ~“为什么我要让你活下去？”~
@105220 = ~“这是诡计吗？”~
@105221 = ~“你在说什么？”~
@105222 = ~“你了解瓦纱瑞丝吗？”~
@105223 = ~[攻击脑池。]~
@105224 = ~佐瓦柯穆的长老之脑现在从它残存的部分里释放出有着腐败气味的绿色雾气。~
@105225 = ~我们为自由而战！~
@105226 = ~当你靠近时，灵吸怪的触须因为紧张而兴奋的抽搐着。它用一种声音和你交谈着，只有你的思想可以听见：“这些是佐瓦柯穆的洞穴。你来这里有什么事情？”~
@105227 = ~夺心魔考虑着你的话。你感到它在探寻你的思想，尽管它不能穿透头盔在你的思想周围建立的保护场。~
@105228 = ~“有<RACE>买主来买我们的奴隶真的比较罕见，但你不是第一个。不过，你的思想对我来说还是个谜。在我让你进入之前你得取下头盔来。”~
@105229 = ~[成功]夺心魔把它奇形怪状的脑袋歪向一边。“灵吸怪不会作为奴隶出售……但是你选择的关键很准确。”~
@105230 = ~你不能确定，但是好像看起来夺心魔在笑。“仅仅是个建议，请不要放在心上。很好，你可以带着保护你思想的头盔。”~
@105231 = ~“我允许你进入佐瓦柯穆的外圈。但是你得知道长老之脑意识到了你的存在，而且了解你的想法，即使他们现在对我保持沉默。”~
@105232 = ~你感到守门人在你的思想里检查了一番，看看是否还有头盔的保护。因为无法接触你的想法，外来的东西从你的思想里退了出来。~
@105233 = ~“我允许你进入佐瓦柯穆的外圈。你可以随意来去。没必要再问我了。”~
@105234 = ~当你靠近时，夺心魔的触须因为紧张而兴奋的抽搐着。它用一种声音和你交谈着，只有你的思想可以听见：~
@105235 = ~“你或者是太愚蠢或者是极为勇敢，把你的思想直接暴露在我的面前！不敢怎么样，在你成为我的奴隶之后你永远都不会记起从前了！”~
@105236 = ~因为你和主脑达成的交易，这个灵吸怪可以比探寻你的思想知道的更多。~
@105237 = ~“去死，你这个满脸触须的怪东西！”~
@105238 = ~“我来从你的拍卖会那里买奴隶。”~
@105239 = ~“我想如果那是唯一的办法的话……”[取下头盔。]~
@105240 = ~[胁迫]“我来买奴隶。靠边去，否则我把你也卖了。”~
@105241 = ~“我来买奴隶，而不是做奴隶。我还是带着头盔。”~
@105242 = ~“我买奴隶——我不和他们交谈。”~
@105243 = ~“佐瓦柯穆不可能对你这种人开放。”~
@105244 = ~“记住这一点——我们宁愿死也不愿意做奴隶！战斗，我的兄弟们！不自由毋宁死！”~
@105245 = ~卓尔微笑着握住你的手臂。“谢谢，我的朋友。我不太喜欢地面人，但是看来我错了。”他转向另一个奴隶。~
@105246 = ~卓尔摇摇头。“我们不能把时间浪费在你的问题上。如果灵吸怪发现看守死了，我们逃跑的唯一机会就没了。”~
@105247 = ~“要是想给灵吸怪们一个突然袭击的话，我们现在就得攻击了。这是我们获得自由的唯一机会。”~
@105248 = ~“我发誓会等待，让你有时间到长老之脑。但是你得快点行动。我们不会永远等下去。你不要再在这里浪费时间了。”~
@105249 = ~“我们的暴动开始了！来吧，我的兄弟们：我们要通过战斗获得自由，或者为此而献出生命。灵吸怪会血流成河！”~
@105250 = ~“坚持一会，老大。如果奴隶们逃走了，所有那些尽是触须的家伙会发疯的。如果这样了，德金认为长老之脑不会帮我们了。”~
@105251 = ~“等一下，<CHARNAME>！如果你这么做，那么所有佐瓦柯穆都回叛变了。我们再也不能说服长老之脑来帮助我们了。”~
@105252 = ~“等一下，<CHARNAME>！如果你这么做，那么所有佐瓦柯穆都回叛变了。我们再也不能说服长老之脑来帮助我们了。”~
@105253 = ~卓尔皱起眉头。“你要我做什么呢？呆在这里做一个为灵吸怪服务的没有头脑的奴隶吗？不——我不会放弃自由的机会！”~
@105254 = ~阿戈撒斯摸着他的下巴思考着。“那么，你想去找长老之脑。我知道那非常困难，如果整个城市都警觉起来的话。”~
@105255 = ~“但是我们不能失去我们获得自由的唯一机会。为什么我们要为了你而推迟我们的逃跑呢？”~
@105256 = ~[失败]阿戈撒斯挑战似的摇摇头。“我们面临的命运比死亡还要悲惨。究竟是什么使你认为自己的威胁可以让我们改变想法呢？不，我们现在就去了。”~
@105257 = ~[成功]一些奴隶由于恐惧而开始嘟嘟囔囔，但是阿戈撒斯只说，“你的强壮足够让你在这里生存下去。我怀疑我们是不是可以和你一样有机会。”~
@105258 = ~他叹着气。“看来我们没有多少选择。因为就要获得自由，我不想让我的生命因为拒绝你而失去。”~
@105259 = ~[失败]“给长老之脑下毒？我不相信你。而且即便你做了，那能怎么样呢，或许只是换另一个夺心魔来做警卫？不，我们现在得走了。”~
@105260 = ~[成功]“给长老之脑下毒？是的，当然。那会削弱所有夺心魔。我们或许可以真正获得逃跑的机会，而不是徒劳而亡。”~
@105261 = ~[失败]“抱歉。对于释放我们我们欠你很多，但是你要求的代价太高昂了。这是我们获得自由的唯一机会。我们现在得走了。”~
@105262 = ~[成功]“对于释放我们我们欠你很多。”从其他奴隶那里传来了嘟嘟囔囔的生硬，但是当阿戈撒斯抬起手来，这个声音停止了。~
@105263 = ~“我们会等待，现在。我们会给你时间到达长老之脑那里，在此之前我们不会通过暴动来争取自由。”~
@105264 = ~“那么，如我所允诺的，我们会在这里等待，给你时间到达长老之脑那里，在此之前我们不会通过暴动来争取自由。”~
@105265 = ~“但是我们不会永远等下去。我们得在灵吸怪发现守卫死之前发起战斗。如果你花费的时间太长，我们会自己来干。”~
@105266 = ~“拿起武器，我的兄弟们！不自由毋宁死！”~
@105267 = ~阿戈撒斯的头从树桩上望着你，似乎还是靠着可怕的魔法而保存着生命，眼睁睁的目睹着他的同伴在受折磨。他用一种干巴巴的声音小声说着：~
@105268 = ~他试图说说别的，但是当他慢慢陷入死亡时，那些话语像低沉的自言自语，他终于从折磨里解脱了。~
@105269 = ~“安静！我不回答奴隶的问题！”~
@105270 = ~“守卫死了。我亲手把他杀了。”~
@105271 = ~“我不为任何人效劳——但是我屠杀每个人！”攻击奴隶们。~
@105272 = ~“我来这里释放你们。”~
@105273 = ~“等等——我有几个问题要问你。”~
@105274 = ~“我现在要走了。”~
@105275 = ~“战斗吧，阿戈撒斯。”~
@105276 = ~“没关系。为你的自由而战吧。”~
@105277 = ~“对。我还是不能让你去。”~
@105278 = ~“等一下！如果你现在逃跑，你就是与整座城市为敌。”~
@105279 = ~“稍等一下。只要等我到达长老之脑那里。”~
@105280 = ~“你是对的。现在去吧，别太迟了。快点。”~
@105281 = ~[胁迫]“给我时间，否则我现在就把你们杀个精光！”~
@105282 = ~[欺骗]“我要去给长老之脑下毒，这样可以削弱所有灵吸怪。”~
@105283 = ~[说服]“请把这个作为我释放你们的回报吧。”~
@105284 = ~“你惹火我了。去死吧。”攻击奴隶。~
@105285 = ~“你自由了。现在去吧，赶在灵吸怪发现你逃跑之前。”~
@105286 = ~“我有几个问题想问你。”~
@105287 = ~你所看到是一个奇怪的半微笑和空虚的表情——眼睛在望着，但是什么都看不见。~
@105288 = ~“你让我恶心，奴隶贩子！你该死了！”[攻击灰矮人。]~
@105289 = ~“谢谢你的提醒。”~
@105290 = ~“你弄错了——我不是奴隶贩子！”~
@105291 = ~“没人可以威胁我！”[攻击灰矮人。]~
@105292 = ~“如果你攻击我，你们都得死！”~
@105293 = ~“我到哪里可以弄到这种头盔？”~
@105294 = ~这里的蝙蝠看起来出奇的大。~
@105295 = ~蝙蝠飞掠过你，试图确定你是否是它同血缘的兄弟们。~
@105296 = ~老鼠的眼睛在黑暗里看起来又圆又亮。~
@105297 = ~老鼠兴奋得在你身边聚集成群，试图告诉你它们在附近发现的一些棺材。~
@105298 = ~铜锣上装饰着奇怪的符号。~
@105299 = ~浮雕和符号看起来完全难以理解。~
@105300 = ~符号看起来是源自古老的龙语，一种在费伦的强大黑魔法师里十分流行的语言，这些符号是指某种宗教仪式上的人祭。~
@105301 = ~离开。~
@105302 = ~敲响铜锣。~
@105304 = ~你的眼睛被古怪的雕刻吸引了。上面雕刻着一个戴着头巾的人正趾高气扬地把一颗黑色的宝石放到他前面的祭坛上。~
@105305 = ~似乎没什么事情发生。~
@105306 = ~你的武器突然感到有点寒冷，上面环绕着奇怪的红光。~
@105307 = ~离开。~
@105308 = ~把一颗黑珍珠放在祭坛上。~
@105309 = ~深渊陷入黑暗之中。你不知道它有多深。~
@105310 = ~石头滚入空洞里，消失在黑暗之中。过了几秒之后，你听到了它撞击下面坚硬底部的声音。~
@105311 = ~离开。~
@105312 = ~抓紧绳子，靠它下深渊里去。~
@105313 = ~把石头丢到深渊里去。~
@105314 = ~爬下粗绳。~
@105315 = ~一大堆巨骨堆积在阴暗之中。它们灰白交杂，看起来不管从前上面附着过什么样的肉体，如今都已经被剥离得干干净净了。~
@105316 = ~离开。~
@105317 = ~把使徒的鲜血倾倒在骨头上。~
@105318 = ~你仔细在棺材里搜寻，但找到的只有灰尘。~
@105319 = ~一具皮肤灰白的尸体躺在棺材里，身上到处是撕裂的伤口。你恐惧地看到这些伤口很快就自己合拢了，甚至连疤痕都没有留下。~
@105320 = ~你在尸体上留下了一些伤口，可是它还是很快就合拢了。你得找其他办法来对付里面的生物。~
@105321 = ~“我有些关于吸血鬼的经验。永远杀死他们的唯一办法就是把一根木桩钉穿他们的心脏。”~
@105322 = ~“我有些关于吸血鬼的经验。永远杀死他们的唯一办法就是把一根木桩钉穿他们的心脏。”~
@105323 = ~“嘿，老大。老主人有一本关于不死生物的书。德金读过一次，好像记得要用一根木桩钉穿吸血鬼的心脏才行。”~
@105324 = ~“德金曾经试图写一首歌谣，但是没有东西可以和吸血鬼押韵。骷髅和僵尸也一样。德金认为那不仅仅是巧合。”~
@105325 = ~你在尸体的下面找到一把生锈的钥匙。~
@105326 = ~攻击尸体。~
@105327 = ~离开。~
@105328 = ~用一根木头钉穿这个生物的心脏。~
@105329 = ~一个小晶体，嵌在这件物品的一段，间断的发出奇怪的光线。这件机器的顶端有一个控制杆，而另一头是一个细小、杆状的凹槽。~
@105330 = ~离开。~
@105331 = ~抓住晶体。~
@105332 = ~拉动杠杆。~
@105333 = ~把权杖放进凹槽里。~
@105334 = ~“停下人类！你被控告试图干预神圣事业，并企图伤害我们的代理人，莱佛拉。我被派来实施对你的惩罚……”~
@105335 = ~你面前的祭司高大而苍白，鲜血从他的嘴角流下。“欢迎，孩子，”他粗声粗气地说道，“你被选来为维克杀的意志服务，不是吗？”~
@105336 = ~“只要它很简单。维克杀需要你的骨头，然而，我们需要你的鲜血。永别了，我的孩子……”这个祭司张开嘴露出了两颗尖利的犬齿……他扑向你的脖子。~
@105337 = ~“我过去的名字是泽雷蒙德，但是现在我们没有名字了。我们就是长老，与维克杀共存的人，白骨收集者。我们为了主人的意志而服务，我们注意他的愿望，而他满足我们的愿望。”~
@105338 = ~“你真的相信？你没有被操纵过吗？你从没有追随谎言？你从没有出卖灵魂？肉体？鲜血？然而受祝福的维克杀不需要任何这些东西……”~
@105339 = ~“志愿者？多么迷人啊。我们没有很多……你或者过于自信，或者过于信任了。对于像你这样的稀有者我有个弱点……稀罕的东西才珍贵，不是吗？”~
@105340 = ~“真是非常珍贵。你的肉体很温暖，皮肤很光滑，镶嵌在头骨里的眼睛很有光彩……你的鲜血，即使现在还在你的身体里川流不息……但是受祝福的维克杀却不需要这些东西。”~
@105341 = ~“你嫌我讨厌，是吗？或许是有点讨厌。但是别忘了正是维克杀统治着这片地域，他对你的骨头可是垂涎三尺哪！他对于……骨头……非常感兴趣……””~
@105342 = ~“他不需要肉体……他最渴望得到的是骨头的。他需要的是你的腿骨、下颚骨，还有手上的成百的骨殖……”~
@105343 = ~“你是多么高贵啊……是不是我告诉你你的骨头是伟大的维克杀真正需要的东西，你就会更加高兴呢？他对于……骨头……非常感兴趣……”~
@105344 = ~“你看，这就是我们在祭司生涯里所能遇上的一点……复杂情况，而我们在为维克杀效劳的长久岁月里，不得不采取一些非常手段……”~
@105345 = ~“我感觉他们在这里并不太关心你的想法，<CHARNAME>。”~
@105346 = ~“我也不……至少，不要战斗！”~
@105347 = ~“想法很好，老大。你需要你的骨头。”~
@105348 = ~“我的愿望？嗯，作为祭司，我们长老在为维克杀效劳的长久岁月里不得不……采取一些……非常手段……”~
@105349 = ~“很久以前达成了一项协议，一个决定……维克杀留下那些骨头，而鲜血属于我们。”这个祭司张开嘴露出了两颗尖利的犬齿……他扑向你的脖子。~
@105350 = ~“或许你愿意放弃你的骨头，<CHARNAME>。但是我并不准备不战而降！”~
@105351 = ~“你知道，有种人非常乐于自我牺牲。明确地放弃你的骨头,你就会是他们中的一员。”~
@105352 = ~“德金不认为那是个好主意，老大。你需要你的骨头。”~
@105353 = ~祭司微笑了，一缕血迹从他紧抿的嘴唇里露了出来。“我们只是说他……和他们……有一种血缘关系。他喜欢适合他们的东西……”~
@105354 = ~邪教长老（吸血鬼）正在等候玩家献祭。~
@105355 = ~“再见。”~
@105356 = ~“你是谁？”~
@105357 = ~“我只按自己的意愿从事。”~
@105358 = ~“我自愿。”~
@105359 = ~“是的，我被选中了。”~
@105360 = ~“别费话了，讨厌的家伙。”~
@105361 = ~“维克杀需要什么？”~
@105362 = ~“我在此效劳。”~
@105363 = ~“抱歉，我不想和它们分开。”~
@105364 = ~“如果这是维克杀的愿望，它们就是他的了。”~
@105365 = ~“为什么他这么喜欢骨头？”~
@105366 = ~尽管你面前的女人有着无数的伤疤，但她还是异常美丽。破烂的双翼，因为尘土而变黑，从她的肩膀垂下。从她的手肘处伸出了一条管子通到了附近的一台机器里。~
@105367 = ~“别忘了我……请别忘了我……”~
@105368 = ~“这世上还有善良的人吗？我是天界生物，一个天使，却被邪恶的力量捕获。他们以其卑劣而可耻的名义奚落并折磨我。我又累又痛，害怕万分……求求你，救救我。”~
@105369 = ~“让她困在这里是一种愚蠢的暴行。我们正在为此而抗争，<CHARNAME>。”~
@105370 = ~“啊，老大。你不是想把这么美丽的天使留在机器这里吧，不会吧？”~
@105371 = ~“你不能把这个可怜的女士留在这里受苦，<CHARNAME>！”~
@105372 = ~“吸血鬼？他们在制造这些可怕的骷髅魔像。他们找到了利用我的鲜血来给那些东西生命力的方法。”~
@105373 = ~“这些都和那台机器有关。它一点一点吸取我的鲜血。我太累了，真冷。”~
@105374 = ~“我……我不知道。我已经丧失了时间的概念。他们吸取很多的鲜血，然后放我休息一段时间以重聚力量。这一过程重复进行，似乎永无休止。”~
@105375 = ~“他们就把从机器里得来的鲜血倾倒在一堆骨头上，然后它就出现了。骨头自己组合起来，成为一个可怕的怪兽。都是因为我的鲜血。”~
@105376 = ~“是为了卓尔。显然，他们在组建军队，长老已经和他们达成了一个协议。那个长老们所崇拜的可怕的维克杀也为此发出了祝福。”~
@105377 = ~“那就可以解释瓦纱瑞丝的军队里出现不死亡灵部队的报告了。我们得找个办法来阻止这些。”~
@105378 = ~“这一定是瓦纱瑞丝给自己的军队增加不死亡灵部队的方法。我们得找个办法来阻止这些。”~
@105379 = ~“他们抓住我，把我封印在某种可怕的魔法里。他们把一根管子插入了机器，现在我什么都做不了！甚至无法施放一个简单的魔法火焰来让自己暖和起来。”~
@105380 = ~“我……我过去叫作莱佛拉，外位面的一个宗教团医护者……现在我已经被遗忘、被遗弃在这里等死，逐渐凋零。”~
@105381 = ~“我的上级派我到物质位面完成一项任务，但是我被这些……这些维克杀教徒抓住了。哦，我把所有事情都弄糟了！他们甚至拿走了我的法杖。这些可恶的家伙！我真是非常不幸。”~
@105382 = ~“好的……我哪儿都不能去。他们把我困在这里了，你看到了吗？”她低头看着胳膊下伸出的管子，温柔的用手背擦着鼻子。~
@105383 = ~“我知道，我知道。肮脏的小使徒！坏蛋莱佛拉！哭着回家吧……但是我不能！我被永远困在这里了，被邪恶的吸血鬼包围着，连接到这台机器上。太可怕了！”~
@105384 = ~“老大，你为什么还要作弄她呢？她已经够悲伤的了。”~
@105385 = ~“他们基本没有告诉我什么东西。我只知道他们的土地被邪恶力量引导着，但是没人告诉我那是谁……我真笨，我把事情搞糟了！看看我！”~
@105386 = ~这个女人的刚硬姿势软了下来，似乎空气中出现了你以前没有注意到的一缕暗淡的红光。风吹动着她的羽毛。~
@105387 = ~“嘘，嘘！？很好，那么，我接受你的同情。拯救她而不必考虑女孩的感受，对吧？我知道什么时候我不再需要了。”她沉沉的哼了一声转身走开了。~
@105388 = ~“回家，路还很远。你认为我的翅膀可以痊愈吗？哦，没关系。我不配有翅膀，对吧？我让所有人都失望了。”~
@105389 = ~“我的上级派我到物质位面完成一项任务，但是我被这些……这些维克杀教徒抓住了。哦，我把所有事情都弄糟了！他们甚至拿走了我的法杖！我是一个可怜而讨厌的家伙！”~
@105390 = ~“他们基本没有告诉我什么东西。我只知道他们的土地被邪恶力量引导着，但是没人告诉我那是谁……”~
@105391 = ~“但是然后我被抓住了，接下来你应该都知道了的。我真笨，我把事情搞糟了！看看我！”~
@105392 = ~“我不了解你的上级，但是先知有时会给我同样模糊的指令。她告诉我们要有信念；最后都会解决得。”~
@105393 = ~“那就是他们所说的！别担心，总会解决得。”~
@105394 = ~“听起来你接受了一个你不可能完成的任务。”~
@105395 = ~“我也这么想。但是我的上级不是那种你可以提问的人，他是神圣之人。而且，他们说这可以实现。”~
@105396 = ~“你确信他们没有告诉你？或许只是因为你说的太多了，他们说的时候你没有听到而已。”~
@105397 = ~“我非常注意！通常。有时我的上级有点唠唠叨叨的，我的注意力会溜号。然而，我确信他们并没有告诉我就把我派了出来。我以为他们知道他们自己在做什么。”~
@105398 = ~“哎呀，当然是完成我的任务。我要找到某人，告诉他一些消息……我并不太确认该找谁……嗯，事情自有它解决的方法。运气，对吧？”~
@105399 = ~“当然。”她把注意力转移到破烂的双翼上，耐心的试图弄直撕裂的羽毛。~
@105400 = ~“我想想看，现在……我得去找到某人告诉他，他们的手被邪恶的意识指引着……就是这种模模糊糊的消息，你不这样认为吗？我的意思是，它似乎可以代表所有东西。”~
@105401 = ~“嗯，嗯嗯。但是还能有多难呢？毕竟物质位面是个有限的地方。不像家里，那里万物都在永恒的延伸。那真的很烦人。美丽……但是烦人。”~
@105402 = ~“为什么你会需要我的帮助？我只会把事情弄得一团糟！”~
@105403 = ~“你知道什么？你是对的！当然，我在我的任务上碰到了一些问题。但是那不意味着我不能做好事。我喜欢帮助你！”~
@105404 = ~“真的？我……我愿意。我的意思是，我要去见的人会在任何地方出现，对吧？毕竟，在报恩的同时我或许还能开始我的任务。你需要什么呢？”~
@105405 = ~“哦……嗯，我猜测生命里最重要的旅行就是从迈出第一步开始的，不是吗？那么，我现在就出发，去完成我的任务。”~
@105406 = ~“你知道物质位面有多大吗？没关系，别告诉我。我希望那是个惊喜……与你相会真的很好！”~
@105407 = ~“我必须承认，我希望神职人员的行为能够更加……更加有尊严。”~
@105408 = ~“她非常渴望完成她的任务，她并不像一个公正神职人员一样的攻击我。”~
@105409 = ~“卓尔？吸血鬼用我的鲜血来为卓尔大军制造魔像！他们在战场上看到我会惊讶的。反抗军，反抗军，反抗军……明白了！好吧，出发！”~
@105410 = ~“先知的军队是零七八碎的流浪者和不称职的人的组合。我认为使徒非常适合。”~
@105411 = ~“对抗瓦纱瑞斯的大军，她会很有用的……要是她能找到我们营地的话。”~
@105412 = ~“吸血鬼崇拜的人？我承认我是要找他算账的。我身体虚弱，可能无法从战争中幸存下来，但至少我是为善良而死的。你确定吗？”~
@105413 = ~“哦这应该挺有趣的。我以前从来没有和神战斗过。你有吗？”~
@105414 = ~“回报？我……我不明白。你让我脱离了困境，对吧？不是理所当然的吗？需要什么回报呢？我不清楚……”~
@105415 = ~“可怕。我难以想像那种被孤立的感觉，每个回去的人都会说我是多么不负责任。而且，我还得去面对他们，不是吗……”~
@105416 = ~“我？呵呵，喔……还是有点糊涂。我不认为我很快就能飞起来。但是，还是……还是比以前好些了，不是吗？”~
@105417 = ~“但是那时……肮脏的小使徒！坏蛋莱佛拉！该是哭着回家的时候了……但是我不能！他们不会再让我回去了。我让他们都失望了！”~
@105418 = ~“不？太糟了……但我还是在这里，对吧？我还在物质位面。我的上级并没有说过要立刻完成任务。还有时间，不是吗？”~
@105419 = ~“不？太糟了……但我还是在这里，对吧？我还在物质位面。我的上级并没有说过要立刻完成任务。还有时间，不是吗？”~
@105420 = ~“哦，可怕！我不想不领情。我的意思是你救了我，但是你是邪恶的！我能看到邪恶充斥着你的全身。才出油锅，又遇烈火，对吧？为什么你不像其他人一样吸取我的鲜血呢？”~
@105421 = ~“哦……我知道我把事情搞得一团糟，但至少我没有失去自己的意志。我不知道我怎么向我上级解释这一切……”~
@105422 = ~“……”~
@105423 = ~一瘸一拐，血污遍身，你天上的那个朋友看着你，咧开嘴笑了。~
@105424 = ~“一个任务？哦，是的，我的任务！嗯，我想生命里最重要的旅行就是从迈出第一步开始的，不是吗？那么，我现在就出发，去完成我的任务。”~
@105425 = ~“关心？有点像任务，不是吗？哦，听起来很有趣。”~
@105426 = ~“我什么？我在出血？哦啊，我流血了！那是一个好兆头。我不确信是否还留下多少血了。”她擦去鲜血继续笑着。~
@105427 = ~“那么，我们现在该做什么？有想法吗？”~
@105428 = ~“这会很有趣的。当他们看到我在战斗里给予邪恶以多大的惩戒，每个人都会印象深刻的！”~
@105429 = ~“再见。”~
@105430 = ~“我会回来的。”~
@105431 = ~“为什么我要释放你？”~
@105432 = ~“长老对你做了些什么？”~
@105433 = ~“他们这样对你多久了？”~
@105434 = ~“他们是怎么制造这些魔像的？”~
@105435 = ~“为什么他们要制造这些魔像呢？”~
@105436 = ~“是什么把你束缚在这里？”~
@105437 = ~“你是谁？”~
@105438 = ~“你最后怎么来到这里的？”~
@105439 = ~“回到我另外一个问题。”~
@105440 = ~“是的，你是个可怕的小野兽。”~
@105441 = ~“你的任务是什么？”~
@105442 = ~“再见。”~
@105443 = ~“是的，嗯……嘘，离开这儿……”~
@105444 = ~“你现在打算做什么？”~
@105445 = ~“你怎么辜负了所有人？”~
@105446 = ~“你的任务是什么？”~
@105447 = ~“回到我另一个问题。”~
@105448 = ~“你要传递的消息是什么？”~
@105449 = ~“你不知道该做什么，是吗？”~
@105450 = ~“我需要你的帮助。”~
@105451 = ~“你是对的。离开这里，嘘！”~
@105452 = ~“这是你把事情正确完成的机会。”~
@105453 = ~“现在来吧，还没那么糟糕。”~
@105454 = ~“我改变主意了。离开这里，嘘！”~
@105455 = ~“没关系。做你想做的事情吧。”~
@105456 = ~“有一场反对卓尔的暴动，反抗军营地需要你的保护。”~
@105457 = ~“我需要你帮助打败维克杀。”~
@105458 = ~“是的，帮我和维克杀战斗。”~
@105459 = ~“好，我释放了你。那么回报是什么呢？”~
@105460 = ~“你觉得怎么样呢？”~
@105461 = ~“现在来吧，还没那么糟糕。”~
@105462 = ~“再见。”~
@105463 = ~“我身上被下了咒，我需要你的帮助。”~
@105464 = ~“不要放弃到手的东西……”~
@105465 = ~“嗯我并不是真的邪恶……”~
@105466 = ~“我有自己的理由。”~
@105467 = ~“我应该那样做？”~
@105468 = ~“你还有任务要去完成，记得吗？”~
@105469 = ~“我需要你最后的支持。”~
@105470 = ~“你在流血。”~
@105471 = ~这一行不能出现。~
@105472 = ~“维克杀会毁灭你的！”~
@105473 = ~“通知卓尔！”~
@105474 = ~“骨头，过来吧！”~
@105475 = ~“保持圣言！”~
@105476 = ~“召唤帮助！”~
@105477 = ~“太监们，来吧！”~
@105478 = ~“异教徒！”~
@105479 = ~“释放吞噬者！”~
@105480 = ~“维克杀的怒火！”~
@105481 = ~“决不让他们到达裂口！”~
@105482 = ~“没人能从这里通过！”~
@105483 = ~“维克杀庇护我们！”~
@105484 = ~随机发生器。从20开始选择。这其中的8将导致无效的数据。~
@105485 = ~教徒神殿。随机的战斗俏皮话。多种性别。多种类型。~
@105486 = ~高阶祭司索达里斯（自定义场景典礼现场）。~
@105487 = ~[攻击高阶祭司。]~
@105488 = ~[保持沉默。]~
@105489 = ~“我愿意。”~
@105490 = ~“在幽暗地域赤手空拳的旅行，你？”~
@105491 = ~“那武器看起来不错。在幽暗地域这个危险的地方，最好能把它放在手边。”~
@105492 = ~“你在流血……那些祭司对你做了什么？”~
@105493 = ~“我害怕呆在这里，但是如果我逃跑，维克杀也会找到我的。自己救自己吧。”~
@105494 = ~“请别再举行什么仪式了。我们已经损失的够多了。”~
@105495 = ~“从哪来就回哪去吧。你没必要呆在这里。”~
@105496 = ~“我的心恐惧。现在镙声响的越来越多了。”~
@105497 = ~“如果刚来这里，别让祭司看见你。”~
@105498 = ~“这些祭司已经死了，但维克杀怎么样呢？相比人类我更怕神……”~
@105499 = ~“你杀死了祭司？每个？那么我要向他们身上吐口痰解解气！”~
@105500 = ~“真的吗？仪式向善良的方向进行呢？”~
@105501 = ~“仪式或许结束了，但是维克杀还在。我吓坏了，陌生人。”~
@105502 = ~“我看到一些祭司逃离的神殿。看起来他们不会回来了。”~
@105503 = ~“你能听到神殿里吟诵圣歌的祭司吗？这些年我没有听过这么可怕的声音。”~
@105504 = ~“我不指望没有祭司看到我和你说话了，屠神者。”~
@105505 = ~“啊，他们的神或许走了，但是祭司们还在这里，比以往更加可怕！”~
@105506 = ~“你能听到神殿里的骚动吗？祭司们说维克杀被干掉了！”~
@105507 = ~“谢谢你在仪式里代替英卡撒的位置。我们不会忘记的。”~
@105508 = ~“感觉有点奇怪……不害怕明天的仪式，没有维克杀怒火的威胁……我认为我会成为一个野孩子的！”~
@105509 = ~“信徒走了，他们的神也一样。我不禁要想我们所有的人会怎么样呢。”~
@105510 = ~“现在，我想我或许会把我的家搬到地面上。我会给自己找条路的。”~
@105511 = ~“谢谢，<LADYLORD><CHARNAME>。深黯自由村欠你的情。”~
@105512 = ~“愿那些祭司和他们的维克杀一起下地狱！但愿他们永远不会回来。”~
@105513 = ~随机发生器——从6开始选择~
@105514 = ~“我不想和你这样的人说话，肮脏、衣衫褴褛、粗手粗脚……”~
@105515 = ~深黯村的普通村民。男性和女性，不同外表和幽暗地域种族。仅俏皮话。~
@105516 = ~“你不是来这里告诉我你被跟踪了吧，是吗？好——我们会找个办法来帮你的。一旦我们逃脱了，这是我们必须做的，不是吗？在深黯自由村这里我们互相支持。”~
@105517 = ~一个小个子奇形怪状的人从洞窟的暗处跳到你面前来，几乎因为激动把你撞翻了。~
@105518 = ~“欢迎，欢迎到深黯自由村！你从哪里逃出来的？有人跟踪你吗？来吧，来吧，深黯自由村欢迎你！”~
@105519 = ~“我？我是科第干！我是村子的领导！民选代表！秘密投票，那是，秘密投票……是，是，是，但没有多少权力，尽管，在这里基本都没有多少权力。”~
@105520 = ~“那是一个事件的复杂阶段，对吧？一个事件的复杂阶段！有选举的官员，你知道，但是还是有些人虽然没有选举也拥有权力，对吧？”~
@105521 = ~“哦，我不敢说，我不敢说。我代表村民但是我不会为他们讲话。问他们是谁在这里掌握真正的权力吧。问他们，你会知道的。”~
@105522 = ~“我？说话很快，说话很快？紧张而已。只是紧张。领导的压力，充满我的生活，得不到休息，……紧张，我只是有点神经过敏，仅此而已！”~
@105523 = ~“你知道吗？是，我以前常常都是以很棒的演说家的面目出现，很棒的演说家。我站在侏儒的第三参议会面前，我做到了，大声清晰的说出来！但那时灵吸怪抓住了我……他们抓住了我，我说了！”~
@105524 = ~“我不知道，我不记得！他们擦去了我那部分的记忆。他们擦去了我很大一部分记忆！我本来不像这样的，哦不……我记得我曾经是一个伟大的演说家。我在第三参议会发过言！”~
@105525 = ~“是，作为新的绿宝石发现。然而，我的一个同事学会了利用水晶来记录声波！第三参议会，那是很久以前了。至少是在第四之前！”~
@105526 = ~“当人们逃跑时就发生了那些事情，你知道……你被跟踪了。你或许并不知道你被跟踪了，但是奴隶追踪者会出现在村口，那样……你就知道自己被跟踪了。”~
@105527 = ~“现在别担心，别担心。在深黯村这里你是安全的，自由之村。哦是的，至少你受到了保护。还有别的需要担心的……”~
@105528 = ~“安静，安静，我被封口了。你最好别问我了！或许我领导着深黯自由村的杰出居民们，但是我不敢替他们讲话。你最好去问他们在担心什么。”~
@105529 = ~“嗯，奴隶主们不管愿不愿意都不会释放奴隶的，现在，他们呢？不，对生意不好，就是！不，我们必须为自由而战！拼了，我告诉你，拼了……我们必须逃跑，你知道……”~
@105530 = ~“没有更多了，不……欢迎来到深黯自由村！你现在自由了！嗯……近乎自由了！实际上，就要自由了！它已经非常接近，你都可以闻到自由的味道了！有点像薄荷加上一点芦笋的味道，对吧？”~
@105531 = ~“是的，是的……”~
@105532 = ~“决不？永不？没有衣领会把你的脖子当作自己的家，手脚之上没有镣铐？或许他们只是像那些该死的灵吸怪一样玩弄你的脑袋！”~
@105533 = ~“永远别担心那事。那是个糟糕的类推而已！糟糕的类推。就像在一个句子里同时谈论剑和胡萝卜，剑和胡萝卜！”~
@105534 = ~“接近自由了，我说的！但是你最好不要问我那些。或许我领导着深黯自由村的杰出居民们，但是我不敢替他们讲话。你最好去问他们为什么没有完全自由。”~
@105535 = ~“是的，深黯自由村，自由之村……或者说至少是近乎自由吧。没有再被奴役！也没有完全解放！深黯自由村，欢迎，欢迎……”~
@105536 = ~“没有完全解放，我说了！但是你最好不要问我那些。或许我领导着深黯自由村的杰出居民们，但是我不敢替他们讲话。你最好去问他们为什么没有完全自由。”~
@105537 = ~当人群散开，一个熟悉的身影摔向了前面。他们几乎没有注意到他驼背、奇形怪状的身影。~
@105538 = ~“是的，仪式！受选者……有人叫它中奖者，对吧？嗯，现在你知道了深黯自由村的诅咒了！我们在这里不是奴隶，不，但是只要神殿存在，我们就不会自由……”~
@105539 = ~“嗯，你或许可以到神殿去，但是谁能说你会成功呢？谁能说……你有你的机会，你知道。你本可以大声说出来，并成为受选者但是现在迟了，太迟了……”~
@105540 = ~“如果你愿意帮忙，虽然……如果你活下来怎么样呢，如果祭司们被消灭怎么样呢，如果……？为什么我们不能第一次重获自由呢！真的，完全的自由，你没感觉吗？求你了，无论如何你一定要完成。”~
@105541 = ~“恐怖？可怕，是的，可怕的悲哀……但是我们在这里并非奴隶。我们不会为了取悦卓尔而被折磨，或者被灵吸怪变成流着口水的婴儿……相比而言，这并不可怕……”~
@105542 = ~“你看我像个武士吗？噢不，我是一名演说家！我曾经受过训练，可现在有夺心魔看着……，而且维克杀防范着奴隶追踪者。每一片乌云都会留下一线希望，不是吗？……”~
@105543 = ~一个感激的身影在神殿台阶上对你弯下腰来，他指节粗大的手在身前热诚地紧握着。~
@105544 = ~“谢谢！谢谢，谢谢，谢谢！太谢谢了！我们现在完全自由了，既没有那些奴隶主，也没有维克杀可怕的统治了！”~
@105545 = ~“哎呀，领导这个村子！释放更多的奴隶！建造更多的防御工事来防备维克杀的归来，防卫奴隶追踪者！是时候来建设一个更好的生活了。就在深黯自由村这里的更美好的生活！”~
@105546 = ~“谢谢，<CHARNAME>·<CHARNAME>。你的突然出现实现了我们长久以来的梦想，结束了多年以来的梦魇。谢谢，谢谢，太感谢了。”~
@105547 = ~“自由值得为之战斗；即便是为之付出生命也值得。记住这一点，否则你自己会再度被奴役。”~
@105548 = ~“先知对我们在这里的工作会感到高兴的，<CHARNAME>。你在这里做得很好。”~
@105549 = ~“听见吗，老大？或许如果我们回去，他们会给我们举行一个晚会的！或许甚至还有蛋糕！德金喜欢吃蛋糕。”~
@105550 = ~“是的，是的，当然你做了！为我们，为深黯自由村，为了自由，真正的自由，黑暗中的一线阳光，你就是黑暗里一线真正的阳光……”~
@105551 = ~“是的，欢迎，欢迎，欢迎！随时都可以来深黯自由村。我们现在自由了，真正完全的自由了，谢谢你。”~
@105552 = ~“你是谁？”~
@105553 = ~“再见。”~
@105554 = ~“无论如何，你是谁？”~
@105555 = ~“为什么你没有多少权力？”~
@105556 = ~“那么谁是幕后的领导呢？”~
@105557 = ~“你说话很搞笑。”~
@105558 = ~“灵吸怪是怎么抓住你的？”~
@105559 = ~“侏儒的第三参议会？”~
@105560 = ~“为什么你如此关心我可能被跟踪了？”~
@105561 = ~“奴隶追踪者？”~
@105562 = ~“什么？要担心什么呢？”~
@105563 = ~“是什么使你认为我是从别的地方逃出来的？”~
@105564 = ~“但是我不是一个奴隶……”~
@105565 = ~“回到我另一个问题。”~
@105566 = ~“但我真的不是一个奴隶。我从来就不是一个奴隶。”~
@105567 = ~“薄荷和芦笋？”~
@105568 = ~“你说‘近乎自由’是什么意思？”~
@105569 = ~“深黯自由村？”~
@105570 = ~“你说‘近乎自由’是什么意思？”~
@105571 = ~“再见。”~
@105572 = ~“我能怎么帮忙？”~
@105573 = ~“多么可怕的生活！”~
@105574 = ~“为什么你们不起义推翻他们呢？”~
@105575 = ~“再见。”~
@105576 = ~“你现在想做什么？”~
@105577 = ~“什么，你认为我是为你做的？”~
@105578 = ~“不用客气，我荣幸有机会效劳。”~
@105579 = ~“但愿高阶祭司像我们怕他一样怕你。”~
@105580 = ~这个人用担心和敬畏的眼光看着你。“屠神者……”~
@105581 = ~“是的，维克杀死了，但是他的教徒们还没有。你所做的只是给我们带来了高阶祭司索达里斯的怒火。深黯自由村会血流成河，都是因为你的愚蠢行为！”~
@105582 = ~“面对高阶祭司的怒火，死在你手里倒也是一种仁慈了！你看不到吗？如果不是你的帮助我们早就死了！他会用我们的鲜血来涂抹神殿！”~
@105583 = ~“自由？你了解自由吗？即便现在，祭司们策划着他们的报复！深黯自由村会血流成河，都是因为你的愚蠢行为！”~
@105584 = ~“如果你不愿意面对他，那么我们就在劫难逃了。我用我诸多主人的话诅咒你！”这个人变成了阴影四散而去，留下你在那里思考着。~
@105585 = ~“求你了，我们能给你什么？如果你有理由去摧毁一个神灵，你一定有理由可以消灭那些它的神徒们！”~
@105586 = ~这个人点头表示感谢。“那么就让鲜血四溅吧……”~
@105587 = ~“维克杀一定要被摧毁。或许在高阶祭司索达里斯的著作里可以找到办法。”~
@105588 = ~这个人用担心和敬畏的眼光看着你。“我听说你为我们料理了高阶祭司索达里斯……”~
@105589 = ~“是的，高阶祭司死了，但是维克杀还没有。你所做的只是把维克杀的怒火带到了我们这里……”~
@105590 = ~“真的。如果你是以我们的名义做的，你并没有阻止高阶祭司。你所做的只是把维克杀的怒火带到了我们这里！”~
@105591 = ~“自由？你了解自由吗？你所做的只是把维克杀的怒火带到了我们这里！”~
@105592 = ~“如果你不愿意面对他，那么我们就在劫难逃了。我用我诸多主人的话诅咒你！”这个人变成了阴影四散而去，留下你在那里思考着。~
@105593 = ~“求你了，我们能给你什么呢？如果你有理由去摧毁神徒们，你一定有理由可以消灭那些他们的神！”~
@105594 = ~“不是靠我这样的闲谈才行的。如果有人知道，那他一定是高阶祭司索达里斯。他死了，我建议你在他的著作里寻找。”~
@105595 = ~“因为维克杀和他的信徒都不在了，我们有些人曾经说起要把神殿变成市政大厅。或许我们还能选举一个完全意义上的议会呢。”~
@105596 = ~这个人的眼光激动的瞪过来。显然他和你说话不太高兴。“我要走了。请你一定理解……”~
@105597 = ~脏兮兮的脸上苍白的眼睛凝视着，当你靠近时，他紧张的看着两边。“你别过来。”他小声说。~
@105598 = ~这个人变得有点生气。“谁不是？”他嘀咕着，“但是他们也保护着我们。他们比那些该死的灵吸怪要好些……尽管如此，大家还是会幻想如果没有祭司、神殿会怎么样呢。”~
@105599 = ~那个人害怕的看着你，他的脏脸突然发白了。“不！我求你，敲响铜锣，选另一个吧！”说完这些，他就跑了。~
@105600 = ~那个人的眼睛害怕的瞪大了，但是他很快把它们转向了你的脚。“不，不，那不是我想要的。维克杀爱我们。维克杀保护我们。在维克杀之下我们是自由的。”~
@105601 = ~那个人的眼睛里充满了感激的泪水，他很快就用肮脏的袖子把它擦去了。“有人会对此感到高兴的，但我并不会这么说。”~
@105602 = ~“谁告诉你的！？那些女人吗？仪式是祭司们的事情。那是维克杀的工作。现在你别说那个了，免得吓着大家，懂吗？”~
@105603 = ~“我们奴隶对自由的向往就像飞蛾对于亮光一样。任何事情都有其代价，你知道，任何都有代价。”这个人生气地呸了一口，他用手指在胸口画了一个保护的符号。~
@105604 = ~这个人指指那个肮脏的小屋说：“深黯自由村，自由的家……一个接一个，它会夺走我们所有人。”~
@105605 = ~他苍白的眼睛闪烁着阴暗的光芒。“事情不是他们所看到的那样那个，陌生人。”这个人刺耳的声音让你脊背发凉，“你不该来这里。”~
@105606 = ~这个人避开你的问题，他的眼睛看着阴影。“安静，”他警告道，“去问祭司，去问维克杀。别把你的时间浪费在一个像我这样被释放的奴隶上了。”~
@105607 = ~“我曾经是一个奴隶，但是我现在自由了。在深黯自由村这里我们都是自由的。”这个人的语气缺乏说服力，“所有这些都归功于维克杀，就是这样。”~
@105608 = ~这个人伸出手来，上面满是污点。“谁不呢？我被卓尔和灵吸怪卖来卖去。我们有些人甚至为眼魔卖力。卓尔在我们还是孩子的时候就从地面上把我们偷来了。”~
@105609 = ~“幽暗地域是一个危险的地方，特别是对于一群逃亡的奴隶而言……祭司们说维克杀看护着我们，保证我们的安全。最好不要和那些祭司争论，最好别问什么问题。”~
@105610 = ~深黯村普通男性村民。成倍存在。信息提供者。~
@105611 = ~“再见。”~
@105612 = ~“维克杀没什么。别管它。”~
@105613 = ~“小心讲话否则我就干掉你。”~
@105614 = ~“是的，我摧毁了维克杀。你现在自由了。”~
@105615 = ~“看，我尽自己的责任。高阶祭司索达里斯就是你要处理的了。”~
@105616 = ~“那已经满足你了。那么，你会给我什么好处呢？”~
@105617 = ~“如果要流血，那也是高阶祭司索达里斯的。”~
@105618 = ~“再见。”~
@105619 = ~“高阶祭司死了。别管他了。”~
@105620 = ~“嗯。我这样做是因为我的原因，不是你的。”~
@105621 = ~“深黯自由村现在自由了。”~
@105622 = ~“看，我尽自己的责任。维克杀就是你要处理的了。”~
@105623 = ~“那已经满足你了。那么，你会给我什么好处呢？”~
@105624 = ~“你怎么建议我去屠杀神呢？”~
@105625 = ~“再见。”~
@105626 = ~“你害怕那些祭司，不是吗？”~
@105627 = ~“异教徒！我应该自己把你移交给那些祭司！”~
@105628 = ~“你不应该说教会的坏话……”~
@105629 = ~“我想那些都会准备好的。”~
@105630 = ~“怎么样才能举行仪式？”~
@105631 = ~“为什么你说我不该来这里？”~
@105632 = ~“为什么？自由的代价是什么？”~
@105633 = ~“这是什么地方？”~
@105634 = ~“你的意思是，它要夺走你们所有人？”~
@105635 = ~“你看来有些紧张……”~
@105636 = ~“不是看起来那样吗？”~
@105637 = ~“你是谁？”~
@105638 = ~“谁奴役你呢？”~
@105639 = ~“维克杀？”~
@105640 = ~一个长着圆鼻子的灰矮人蹲在那里，她的一条腿似乎断了。“小玩意，”她嚷嚷道，“我们乞讨来的东西，我们偷来的东西，我们修好的东西，熟客大优惠！”~
@105641 = ~“或许我怕，或许不怕。我不会在神殿周围闲逛的，不过，你却是如此。随便你怎么想。我所能说的就是这里的大多数人都有理由害怕他们。”~
@105642 = ~“仪式？啊，我在这里的时候看到过。开始时会敲响那面神殿后面的铜锣，最后就是有一些被带走，满脸泪水，进入神殿大门。”~
@105643 = ~“我想想，这里有我、你、祭司，还有一堆吓傻的前奴隶，他们茫然失措。这么说来，用‘古怪的家伙’来描述恐怕还不够吧。”~
@105644 = ~“问题，问题，总是问题。你确信不想买东西吗？”~
@105645 = ~“嗯，偶尔有奴隶主人会过来，要求取回自己的财产。我还看到过一群卓尔在一天晚上带走了一队骷髅生物。哦，那儿还有维克杀，我是这么认为的。”~
@105646 = ~“那就是祭司的崇拜对象。从没人看到过他，也不知道是否能看到，但是你在这里能感到某种东西的存在，压迫喉咙的感觉。当地人说这就是维克杀。”~
@105647 = ~“卓尔拥有的骷髅生物是什么？我不知道。大个头！全是骨头！或许他们本就是和卓尔一起来的，或许不是，谁知道呢？不管我的事。”~
@105648 = ~“真的，不能说太多。奴隶主冲来，奴隶们四散藏到阴影里，祭司们把奴隶主带到神殿里，通常很难见到有人能被允许离开。”~
@105649 = ~“随便叫他们什么都可以。对于我，祭司就是另一种类型的奴隶主。继续吧，在街上转转，用自己的眼睛去判断。你会看到的。”~
@105650 = ~“他们是阴森的家伙。紫色的罩袍，森森白骨，骷髅一般，你知道他们那模样。通过帮助那些逃跑的奴隶，他们建立自己的奴隶群，更多的时候甚至是直接付钱给奴隶主来购买奴隶。看起来他们有钱这么干。”~
@105651 = ~“实际上，朋友或敌人都基于奴隶。你从卓尔那里偷奴隶，就会成为他们的敌人。付给卓尔需要的价钱，你就会成为他们的朋友。”~
@105652 = ~“看起来情况在变化，但是，迄今为止，似乎灵吸怪派出作战部队，而卓尔派出使节。随便你怎么想了。”~
@105653 = ~“我？我是一个捡破烂的人、卖废品的人、侃价者，随便你怎么叫。不是来自这里，实际上哪儿都不是。不过，你不会得到我的真名。取名字让当地人觉得害怕，这样会赶走生意的。”~
@105654 = ~“他们，非常迷信。我认为，那只是个名字，就像一个普通金币一样，你知道我的意思。无论如何，他们叫我捡破烂者，你也可以这么叫我。”~
@105655 = ~“嗯！每个人都需要诚实的商人，他们不是这么说吗？好的，你正碰上了这么一位。我低价买进，高价售出。如果坏了别找我哦。现在你需要什么吗？”~
@105656 = ~深黯村女商贩。信息提供者。商店。~
@105657 = ~“再见。”~
@105658 = ~“你怕那些祭司，不是吗？”~
@105659 = ~“仪式怎么才能举行呢？”~
@105660 = ~“这个城镇有一些古怪的家伙，对吧……”~
@105661 = ~“现在，关于我其他的问题……”~
@105662 = ~“这附近还有其他人吗？”~
@105663 = ~“维克杀？”~
@105664 = ~“卓尔拥有的骷髅生物是什么？”~
@105665 = ~“和我谈谈奴隶主吧。”~
@105666 = ~“那么，这城镇是前奴隶建造的？”~
@105667 = ~“你能和我谈谈那些祭司吗？”~
@105668 = ~“他们有什么敌人？或者朋友吗？”~
@105669 = ~“你是谁？”~
@105670 = ~“这里的人害怕名字？”~
@105671 = ~“你这样做生意真是……不怎么样，你……”~
@105672 = ~[看看货物。]~
@105673 = ~在紫色头罩的阴影下，这个祭司的脸色苍白而憔悴。“维克杀保护你。”他吟诵着。~
@105674 = ~这个祭司躲开你笨拙的双手，开始大声呼救。你能听到殿门开启的声音，随后两个祭司冲了出来，手里举着武器。~
@105675 = ~这很快就结束了，那个祭司的尸体滑向了地面。第二个祭司非常震惊的发起了攻击。~
@105676 = ~“如果主人在狗还小的时候就经常打它，即使在主人死后，这只狗也会非常害怕这个世界。前奴隶也一样。”~
@105677 = ~“他们从残酷的主人那里来到了维克杀善良的庇佑之下，即使在这里，他们也会永远感到害怕。按照维克杀的意愿，我释放了很多奴隶，但是我不指望能有什么感谢。”~
@105678 = ~这个祭司的嘴角流露出一丝微笑。“仪式的目的是向维克杀显示他的追随者坚定的信仰。神殿每个月都会举行一次，但是村民们只要需要随时都可以进行。”~
@105679 = ~“如果你希望进行一次仪式，直接敲响神殿后面院子里的铜锣，村子就会集合起来。正是通过仪式维克杀来保护你。”~
@105680 = ~“我表示道歉，但是神殿对我们来说是神圣的地方。只有祭司或者有重要任务的人才可以进入。”~
@105681 = ~祭司有点急躁了，不过他还是尽力微笑着。“如你所愿。我为你效劳是维克杀的意愿。”~
@105682 = ~“你可以像其他村民一样崇拜他，以他的名义来保护其他人。如果你需要它，随时都可以敲响神殿后面的铜锣。”~
@105683 = ~“高阶祭司索达里斯是一个非常忙碌的人，他每天都在操劳着。我担心他只有在重要仪式时才会出现。”~
@105684 = ~“你可以通过我来获得神殿服务，没必要通过这门。”~
@105685 = ~他点点头，他的眼神庄重起来。“白袍维克杀，智者维克杀，圣明的保护者，奴隶的解放者。所有知道维克杀的人都会因为敬畏而在他面前颤抖不已。”~
@105686 = ~男性牧师守护着庙门。2存在。他们抱守着门的钥匙，并且企图保持敌对态度。用维克杀消灭他们。~
@105687 = ~“再见。”~
@105689 = ~“为什么村民们怕你呢？”~
@105690 = ~“仪式怎么样才能开始？”~
@105691 = ~“我想进入神殿。”~
@105692 = ~“回到我另一个问题吧……”~
@105693 = ~“如果我不能进去，我怎么样才能参拜维克杀呢？”~
@105694 = ~“我想和你们的领袖谈谈。”~
@105695 = ~“你们不提供什么神殿服务吗？”~
@105696 = ~“维克杀？”~
@105697 = ~[看看存货。]~
@105698 = ~“高阶祭司索达里斯现在更加愤怒了。求你，在神殿里找到他，把我们从他的愤怒里解救出来吧。”~
@105699 = ~这个女人把你拖进阴影里。“真的吗？维克杀死了？”~
@105700 = ~“男人们说高阶祭司索达里斯正在神殿里聚集他的祭司们。他们准备向我们释放怒火，但是我祈求你能找到它来阻止他们。”~
@105701 = ~“是不是奴隶们的生命对于你一钱不值呢？高阶祭司索达里斯正在神殿里聚集他的祭司们。你杀死了他的神！你不明白吗？”~
@105702 = ~“男人们说高阶祭司索达里斯正在神殿里聚集他的祭司们。他们准备向我们释放怒火……”~
@105703 = ~“我们怎么办呢？这是我们的家！高阶祭司索达里斯会把我们都杀光的！”她从你身边转身跑开，逃进了黑暗之中。~
@105704 = ~“深黯自由村永远欠你的情。快点，在他们出发前赶往神殿吧。”~
@105705 = ~这个女人把她污秽的衣服裹得更紧，弯下腰开始哭泣。~
@105706 = ~“求你，把我们从维克杀的怒火里拯救出来吧。高阶祭司索达里斯的著作里一定有接触他的神灵的方法。”~
@105707 = ~这个女人现在看起来很自信，不再躲藏在阴影之中。“高阶祭司索达里斯死了，我听说了。他的祭司们也一样。”~
@105708 = ~“我希望过，”她羞怯的微笑着，然后变得像冰一样寒冷，“是否我们对你一文不值？那是否也是维克杀的诅咒呢？”~
@105709 = ~“我过去常常认为仪式代表着一切，只有仪式结束我才不会害怕。但是即使是现在，我能感到维克杀还在这里，而且他变得更加强大、更加愤怒……”~
@105710 = ~“你给我们带来了诅咒，那就是你做的一切。啊，仪式或许结束了，但是没有它的话，还有谁来保护我们呢？要是维克杀没有毁灭我们，那我们从前的主人就会来毁灭我们的！”~
@105711 = ~这个女人把她污秽的衣服裹得更紧，弯下腰开始哭泣。~
@105712 = ~“我们永远都是奴隶！即使是在深黯自由村得到的自由之下，我们是维克杀的奴隶！高阶祭司死了，但是什么都没有改变，你不知道吗？”~
@105713 = ~“维克杀一定要被消灭。求你了，我们就快要得到自由了！高阶祭司索达里斯一定在他的书里提到过一些关于维克杀本质的提示。”~
@105714 = ~“不再会有仪式中消失的儿子、女儿、父母和朋友了……我们现在可以叫出我们的名字了。似乎我们拥有全面的自由了。”~
@105715 = ~这个女人看起来不想和你多说了：“我决不能被你看见了。你必须理解……”~
@105716 = ~这个女人隐入阴影中，她小声嗫嚅道：“你想从我们这里得到什么呢？”~
@105717 = ~这个女人安静下来，凝视着阴影说：“祭司们保护他们自己，除了选择或者释放更多的奴隶……即使男人们都怕他们。”~
@105718 = ~这个女人紧张地晃动着身体，道：“祭司们敲响神殿后面的铜锣，每个人都要聚集起来等待选择。有时我们也会自己敲响，如果我们认为有必要的话。”~
@105719 = ~“但是如果铜锣敲响了，那么就必须进行挑选。神听见了锣声，直到得到代价才会离开。曾经有一次，一个孩子敲了三次锣，如果不是他被选上的话，他还会敲下去的。”~
@105720 = ~“我过去养鸡，在我被抓到幽暗地域之前。有一个谚语说鸡窝里也有规则束缚自由。这里也没有什么不同……”~
@105721 = ~“高阶祭司索达里斯在这里进行挑选。他是深黯自由村唯一可以提起名字的人，因为他进行选择，那么他永远就不会被选上。”~
@105722 = ~她的声音低沉了下来：“只是运气不好，一个坏兆头。如果你把名字告诉别人，你就是下一个被选择的人。每个人都知道。”~
@105723 = ~她的眼神在破旧的建筑上游移不定：“深黯自由村，自由的家……我们曾经都是奴隶。”~
@105724 = ~她的脸上出现了一丝惨笑，道：“我曾经是灵吸怪的一个乐奴。我在笼子里为卓尔歌唱。一位旅行的祭司帮我逃了出来，把我带来了这里。”~
@105725 = ~“是的。”她小声说，“我们都是。”~
@105726 = ~“仪式……它会保护我们！选中一个其他人就会安全。现在它举行的越来越频繁了。这世上有很多麻烦的事，你知道吗？卓尔、不死生物、灵吸怪……仪式是保护我们的方式。”~
@105727 = ~这个女人摇摇头，退入了更深的黑暗中：“我们在这里不用名字。他们说如果你把名字交给别人，你就是下一个被选中的人……”~
@105728 = ~她的声音更加细微了：“为什么每个人……只是坏运气，坏兆头。如果你把名字交给别人，你就是下一个被选中的人。每个人都知道。”~
@105729 = ~这个女人害怕地退后着，她的指头飞快地在胸前划着符号：“你最好祈祷不会有仪式，<CHARNAME>·<CHARNAME>……”~
@105730 = ~“仪式……它会保护我们！选中了一个，其他就会安全。现在它举行得越来越频繁了。这世上有很多麻烦的事，你知道吗？卓尔、不死怪物、灵吸怪……仪式是保护我们的方式。”~
@105731 = ~深黯村普通女性村民。成倍存在。信息提供者。~
@105732 = ~“再见。”~
@105733 = ~“是的，那是关于他的信仰。”~
@105734 = ~“想想你希望什么吧。我关心什么呢？”~
@105735 = ~“维克杀一直都死了。但是是的，他什么都不是了。”~
@105736 = ~“看，我得到了我来找的东西，我要回家了。”~
@105737 = ~“所有报仇都会对我而来的。他们今晚就会死。”~
@105738 = ~“那么你最好做些什么吧，没有吗……”~
@105739 = ~“再见。”~
@105740 = ~“呵。你觉得我是为了你而做的？”~
@105741 = ~“没错，不过他所崇拜的神留了下来。”~
@105742 = ~“是，这里没有更多的遗迹。”~
@105743 = ~“嘿，我把你从高阶祭司那救了出来。剩下的就交给你了。”~
@105744 = ~“如果你不喜欢，那么就回去做你的奴隶吧！”~
@105745 = ~“你想要我做什么？”~
@105746 = ~“再见。”~
@105747 = ~“你不怕祭司的，是吧。”~
@105748 = ~“挑选？”~
@105749 = ~“仪式要怎样才能举行？”~
@105750 = ~“谁在管理这个地方？”~
@105751 = ~“谁来挑选？”~
@105752 = ~“为什么唯有他的名字是可以提起的？”~
@105753 = ~“为什么挑选？”~
@105754 = ~“你能告诉我一点关于村子的事么？”~
@105755 = ~“奴隶？”~
@105756 = ~“没关系。你没有什么好担心的。”~
@105757 = ~“你在担心什么？”~
@105758 = ~“你有名字么？”~
@105759 = ~“谁说你不能有名字？”~
@105760 = ~“好吧，我的名字叫<CHARNAME>·<CHARNAME>。现在说说那有多难？”~
@105761 = ~“你说的‘下一个被选中的人’是什么意思？”~
@105762 = ~“我想我可以回答你的一些问题。这并没有什么关系。而且，这个岛上创造者的魔像好像也不会告诉你什么东西。”她为自己的笑话而露出了微笑。~
@105763 = ~“嗯，这个岛是以一个古代灰矮人魔法师的名字命名的，他在若干世纪之前建立了自己的要塞。他们说创造者来到这里，想平静的工作，同时让自己创造的魔像更加完美。”~
@105764 = ~“这些故事一定蕴含着某些真相。北方有一些遗迹，可能是创造者的实验室，尽管现在留下的只有地下城了。当然那里有很多魔像。”~
@105765 = ~“岛的北端的地下城现在布满了魔像。至少，第一层到处都是。我们没往下走过。我们认为它们是创造者留下的守护者。”~
@105766 = ~“它们一定是被用来防御小偷和窃贼的。”她悲哀地看着你，“它们完成得很好，在探险的过程里我们死掉了好几个灰矮人同伴。”~
@105767 = ~她摇摇头，说：“不可能。那儿有某些清扫魔像在修理和复原我们打倒的魔像。”~
@105768 = ~“我们试图杀死那些清扫魔像，但它有某种魔法防御力。每次我们发动攻击时，它都会马上移动到安全的地方。这些该死的东西弄得我们难上加难。”~
@105769 = ~“我对于创造者的了解都是来自传说和神话。它们说他是一个强有力的灰矮人法师，他在这个岛上与世隔绝地进行他的研究。”~
@105770 = ~“他的专长就是制造魔像。据说他找到了一种方法，能把智力和自由意志灌输给他的产物。但是我们遇到的那些魔像倒是很平常。”~
@105771 = ~“没有人知道；他在五个世纪前就失踪了。很多人认为他已被自己创造的生物——某些具有自己意志的魔像——杀害了。”~
@105772 = ~“我不知道自己是否相信这些，但这的确是个好故事。在地下城里我们遇见的魔像似乎看起来不怎么聪明。不过要杀它确实挺费功夫的。”~
@105773 = ~这个女灰矮人上下打量着你，猜度着你的力量，并试着判断你是否是个威胁。还好你没有显出要伤害她的意思，她看起来稍稍放松了。~
@105774 = ~灰矮人们举起了武器，但在头领的示意下还是没有动。她再次快速打量着你，试图了解你是不是一个潜在的威胁。~
@105775 = ~“如果这只是一个笑话，你选错了开玩笑的对象。我们不想发生争斗，但我们武备齐全，我们会保护自己的。”~
@105776 = ~“你应该选择一个差点的对手的！动手吧！”~
@105777 = ~她点点头：“说得对。只要你不找我们的麻烦，你可以保留你的秘密。我的名字叫达哈娜，是这支探险队的头领。”~
@105778 = ~灰矮人明显放松下来了，尽管她还是盯着你，好像要再估量下你的样子。“我的名字叫达哈娜。我是这支探险队的头领。”~
@105779 = ~“随你的便吧，地表人。你同我们谈不来。”~
@105780 = ~她若有所思地点点头：“瓦纱瑞丝。我听说过她。她是卓尔主母之一吧？她最近名气很大。”~
@105781 = ~“我听说她一直在攻击地表……我猜这正是你要来阻止她的原因。可是你在这里找不到对抗她的力量。如果卓尔不来烦我们，我们也不会去若他们的麻烦。”~
@105782 = ~达哈娜缓缓地摇了摇头。“我不想给你找麻烦，地表人。不过你对我们的威吓不会让我们加入你。我们决定了；你不能改变我们的意志。”~
@105783 = ~达哈娜耸耸肩。“也许吧。不过瓦纱瑞丝也不是我们见过的第一个追求力量的卓尔了。大部分像她这样的人在把注意力转向我们之前，都垮台了。”~
@105784 = ~“我们是寻宝者。几个世纪前，这个岛是一个人称创造者的强大灰矮人法师的家，也许这只是一个故事。创造者很早就不在了，不过还是留下了点东西。”~
@105785 = ~“我们来这儿是为了收集创造者之塔遗迹附近的稀有金属和魔像碎片。你要是知道识货的买家会为精金制的武器付多少钱的话，一定会感到吃惊的。”~
@105786 = ~她露齿大笑：“不过这并不简单。能平安抵达这里的探险队不多。所以还能找到一些不错的金属，只是需要你冒险跟创造者的魔像周旋。”~
@105787 = ~“一般来说，灰矮人是拾荒者，靠别人丢弃的东西生活。”~
@105788 = ~“说话小心点，卓尔！这是灰矮人的地盘。你的傲慢自大会让你吃大亏的。”~
@105789 = ~达哈娜和其他灰矮人渐渐接近你。你注意到他们抽出了武器，而他们的营地也已经收拾完毕了。达哈娜看起来有点不安，好像对将要发生的事情感到羞愧。~
@105790 = ~[失败]达哈娜笑了。“你这个<RACE>骗子，不要耍我了。你在那里待的太久了，不可能空手而出。现在，把我们的那份交出来。”~
@105791 = ~[成功]达哈娜把头靠在一边，想着你的话。“你看起来倒是很真诚。我不能肯定你是否在撒谎。”她最后相信了你的话。~
@105792 = ~其他的战士低声表达着自己的怒气，但她用坚定的手势打断了他们。“我不想为了不确定的结果而让双方流血！”~
@105793 = ~[失败]“我们自己已经打败了那些创造者的魔像。我认为我们也能对付你这样的<RACE>地表人。我们会为自己应得的东西而战。”~
@105794 = ~[成功]达哈娜仔细打量着你，似乎做出了决定。“或许你是对的，地表人。我们不想轻易丧命。”~
@105795 = ~“你比我们更深地进入了创造者的地下城，你已经回来告诉我们这个传闻。与你为敌实在很蠢，即使我们拼尽全力。”~
@105796 = ~[失败]“我们在这个岛上干了二十年，而我们失去了灰矮人应得的那份。我们已经尽力……你该偿还我们！”~
@105797 = ~[成功]“或许……或许你是对的，地表人。我们不是小偷，我们靠诚实谋生。”在那些战士里有些不满的声音，不过达哈娜用一个手势打断了他们。~
@105798 = ~灰矮人的首领摇摇头。“很抱歉。但我们靠这些探险为生。每次来我们都会发现这种金属越来越少。我们正走向绝望。”~
@105799 = ~达哈娜看着你，明显有些怀疑，不过她还是拿走了那些钱。“在发生那些事情后，你还会为我们做这些？你比我们灰矮人要宽容多了，地表人。”~
@105800 = ~她笑了。“谢谢你的礼物。我们在这里的探险已经结束了，我们要回家，能额外多带些钱当然很好。”~
@105801 = ~“现在我们的探险结束了，我们要回家了。”~
@105802 = ~“说实话我不知道我们是否还会回到这个岛。无论如何，祝你好运，地表人。你要记住：幽暗地域是个危险的地方。”~
@105803 = ~她点点头。“也许你是对的。如果这里的报酬不值得冒这个险。我们还会有其他的地方可以去，去比这个岛要安全的地方。”~
@105804 = ~[失败]达哈娜仔细考虑着你的建议，计算着对付你的胜率。最后她摇摇头拒绝了。~
@105805 = ~“一千金币不够我们大家分的。考虑到你强加给我们的要求，我认为我们至少该得到一万。”~
@105806 = ~达哈娜叹了口气。“我希望事情不要到这一步，不过我看你不是那么通情达理。进攻！”~
@105807 = ~[成功]达哈娜仔细考虑着你的建议，计算着对付你的胜率。最后她点头同意了。~
@105808 = ~达哈娜身后的战士们开始激动的低声私语，不过她用一个坚定的手势打断了他们。她拿走了那笔钱，“我很高兴不用流血。”~
@105809 = ~“一个礼貌的贼也是贼。有礼貌也没有什么用。”~
@105810 = ~“好吧，至少你是有礼貌的……贼。”~
@105811 = ~“嗯，至少你在剥削我们的时候还很礼貌。对于你这种人我无法要求更多了。”~
@105812 = ~娜西拉向地上啐了一口。“你要和这种家伙谈交易？”~
@105813 = ~达哈娜没有理她。“如果你给我们10,000金币，我们可以让你们过去。如果不给，我们靠着武力来拿就是了。”~
@105814 = ~“不针对个人？很可笑。当一群武装暴徒拿着武器指着我，我认为这完全是在针对个人！”~
@105815 = ~“当心，老大！那些灰矮人要给我们一个突然的欢迎仪式……呃，等等。老德金觉得这可不是什么聚会，连蛋糕都没有。”~
@105816 = ~“我要问你点问题。”~
@105817 = ~“告诉我关于这个岛的事。”~
@105818 = ~“告诉我关于魔像的事。”~
@105819 = ~“我还以为你已经把所有的魔像都消灭了。”~
@105820 = ~“告诉我关于创造者的事。”~
@105821 = ~“他发生什么事了？”~
@105822 = ~“是敌是友？嗯……我想我选敌！”~
@105823 = ~“这不是开玩笑。我只是想把你们全宰了。我对这感兴趣。”~
@105824 = ~“冷静点。我也不是来打架的。”~
@105825 = ~“我的名字和事情与你无关。”~
@105826 = ~“我的名字叫<CHARNAME>·<CHARNAME>。我不想伤害任何人。”~
@105827 = ~“我要走了。”~
@105828 = ~“流血的时刻到了。死吧，幽暗地域的矮人败类！”~
@105829 = ~“我在找一同对付瓦纱瑞丝的盟友。”~
@105830 = ~“和我站在一起，还是和我作对，你选吧。”~
@105831 = ~“我给你了个机会。现在你要付出代价！”[进攻。]~
@105832 = ~“好吧。我想问你点别的。”~
@105833 = ~“实际上瓦纱瑞丝也将把矛头对准了灰矮人。”~
@105834 = ~“你在这做什么呢？”~
@105835 = ~“我有点问题。”~
@105836 = ~“放松。现在我们要走了。”~
@105837 = ~“平静下来。我们要问你点问题。”~
@105838 = ~“没人威胁我！灰矮人去死吧！”~
@105839 = ~“这是不是敲诈啊？”~
@105840 = ~“你的岛？你说什么呢？”~
@105841 = ~“我想我看到那将要……”~
@105842 = ~“也许我们能做笔交易。”~
@105843 = ~[劝说：欺诈]“我没找到什么值得的东西。你把这都挑净了。”~
@105844 = ~[劝说：胁迫]“小心点。这也许超出了你的能力范围。”~
@105845 = ~[劝说]“你没权动我的。这全是我做的！”~
@105846 = ~“辩解无效！你要用血来偿还这一切！”~
@105847 = ~“多说无益。这1000金币足够帮你出去的了。”~
@105848 = ~“没事，没什么不爽的。”~
@105849 = ~“也许是你该换个地方的时候了。”~
@105850 = ~[劝说]“我给你1000块金币……就这么多了。”~
@105851 = ~没得商量了。~
@105852 = ~这是10,000金币。~
@105853 = ~达哈娜是我们这队伍的头。你应该和她谈谈。~
@105854 = ~小心北面的那些魔像。它们很难杀光。~
@105855 = ~如果你有问题就去和达哈娜说吧。~
@105856 = ~我们没见过你这样的，地表人。~
@105857 = ~Laz Zand！~
@105858 = ~这个老灰矮人向你点头致意。“又来了，地表人？你想要买点什么，还是想要点别的？”~
@105859 = ~这个灰矮人明显比这里别的矮人要年长。随着你的靠近，他停下了在堆满的物品间蹒跚的脚步，转向对你致意。~
@105860 = ~“哦，你从地面来，是吧？他们中有<RACE>。我记得以前遇到过你这种友善。应该是50……不，60年前。从那之后就再没有过。”~
@105861 = ~“我名叫德威沃，是这支队伍的后勤部长。我也负责出售一些商品。换句话说，如果你想要买东西，就找我来。”~
@105862 = ~“那好吧。也许我还会再见到你的。记得，如果你想要买点什么，就来找我谈。”~
@105863 = ~“当然。我们正要把这些东西弄回家卖掉，所以你可以在我们出发之前为我们减轻一点负担。”~
@105864 = ~“你最好还是去同达哈娜说吧，我只负责后勤。我会尽量回答我能回答的问题。”~
@105865 = ~“不行，我不能答应。不过你可以找达哈娜谈谈。她是管事的……我只管后勤。”~
@105866 = ~“只有在传说中是这样的。这曾经是一个被称做创造者的强大灰矮人法师的家。他失踪很久了，只留下他的地下城实验室。还有他的魔像。”~
@105867 = ~“哈。我想达哈娜应该和你解释过了。我们在这是来收集有用的东西的。在岛北面的地下城那里有着非常多的有用金属。”~
@105868 = ~“我们会尽我们所能把东西都弄回家，卖给出价高的人。要不是这帮魔像，这活也不会那么费事了。”~
@105869 = ~“当然，北面的地下城里全是这东西。这些被法师留下来统治这个岛的创造物，还在保卫着他家里剩下的东西。”~
@105870 = ~“如果你想对魔像知道多一点，你应该去问达哈娜。”~
@105871 = ~“暂且就说到这里。”~
@105872 = ~“让我看看你的补给品。”~
@105873 = ~“我要问你点问题。”~
@105874 = ~“你知不知道一个叫瓦纱瑞丝的卓尔妇人？”~
@105875 = ~“关于这个岛，你都知道什么？”~
@105876 = ~“你们灰矮人来这里做什么？”~
@105877 = ~“魔像？”~
@105878 = ~这只鼠在忙着啃死了很久的死尸。~
@105879 = ~这只鼠无视你的存在，埋头吞吃着它面前的大餐。~
@105880 = ~你看到了这样一幅鼠巢的景象：在西面的墙边垃圾中有一个隐密的地方。你还感觉到了什么；在那堆垃圾那还藏着什么秘密。~
@105881 = ~这只鼠无视你的要求。它太专注于它面前的大餐。~
@105882 = ~[别管这只老鼠。]~
@105883 = ~[深入窥探这只老鼠的思想。]~
@105884 = ~[让这只老鼠揭晓那些秘密。]~
@105885 = ~Sinth Thesti!~
@105886 = ~石头上的铭文已随岁月而消逝。可是，你还是从上面读出了一些：“实验室。禁止进入……”。剩下的就看不出来了。~
@105887 = ~让你意外的是，这些屋里的魔像并不攻击你。一个与众不同的魔像，似乎是用恶魔的躯体做成的，在向你走来。~
@105888 = ~“我们和其他那些毫无思想，只会在上面游荡的魔像不同。我们是有智慧和意识的生物，有真正自我的存在。”~
@105889 = ~“我们是创造者埃希加德的孩子，他赋予我们以生命。因为我是其中最强的，所以创造者选中我作为他的高阶祭司，来传达他的命令和意志给他的孩子们。”~
@105890 = ~亚卡兹笑了，声音很大，隆隆的：“一系列的误会与不幸。在上层的魔像一点也不知道，他们没有自己的意识。”~
@105891 = ~“一开始我们以为你不过是寻常的小贼，和那些在上层抢东西的灰矮人一样。后来，我们怕你是效忠于异教徒法伦的。”~
@105892 = ~“这是个战争年代。我们把那些不与我们同盟的都假定为敌人，即使是像你这样的。我为此道歉，不过是法伦迫使我们这样做的。”~
@105893 = ~“等一下，<RACE><MALEFEMALE>。你很强，我看到了你在这层的残杀。我对你有个要求。”~
@105894 = ~“再见，<RACE><MALEFEMALE>。我祝你成功打倒法伦和他的随从们。”~
@105895 = ~“把那个异教徒的头给我带来，时机合适的时候，我会派我的魔像去帮你对付瓦纱瑞丝。”~
@105896 = ~“再见，<RACE><MALEFEMALE>。”~
@105897 = ~“我们一直为创造者的意志而服务，平静地生活着，同时保卫这个岛不让人破坏他的神圣工作。不过，现在，在我们中间，出现了一个敌人。”~
@105898 = ~“一个叫法伦的魔像背弃了他神圣的誓言。他声称我们不欠创造者什么，而且我们可以随意做我们的事。他的谎言愚弄了很多创造者的孩子。”~
@105899 = ~“法伦带领很多魔像来反对我这个创造者不在时的正牌管理者。他把暴力带到了这里，不过，这场仗也不是那么好赢的。双方势均力敌。”~
@105900 = ~亚卡兹露出他的牙齿：“站到我这边还是和我作对，<RACE><MALEFEMALE>。放聪明点。”~
@105901 = ~“小心你的言辞，<CHARNAME>。魔像在战斗中的力量是很惊人的。他们是有价值的同盟……或是危险的敌人。”~
@105902 = ~“这是个展现你<CHARNAME>的机智和口才的好机会。这些魔像可是对付瓦纱瑞丝的有力盟友。”~
@105903 = ~“哦，哦，头儿。德金觉得这魔像要疯。看，他鼻孔冒火了！”~
@105904 = ~“我只是想结束这场争斗。魔像自相残杀太可怕了，我们违背了创造者的初衷。不过在我倒下前，法伦是不会停止的。”~
@105905 = ~“我想你去找到法伦并消灭他。没了领头的人，他那卑鄙的教义也就无用了。把法伦的头带来，你将会成为创造者之子的永远的盟友。”~
@105906 = ~亚卡兹露出他的牙齿：“站到我这边还是和我作对，<RACE><MALEFEMALE>。放聪明点。”~
@105907 = ~“小心你的言辞，<CHARNAME>。魔像在战斗中的力量是很惊人的。他们是有价值的同盟……或是危险的敌人。”~
@105908 = ~“这是个展现你<CHARNAME>的机智和口才的好机会。这些魔像可是对付瓦纱瑞丝的有力盟友。”~
@105909 = ~“哦，哦，头。德金觉得这魔像要疯。看，他鼻孔冒火了！”~
@105910 = ~亚卡兹倾听着你对瓦纱瑞丝的叙述，然后点点头：“如果你打倒法伦，我会派我的魔像去帮你对付瓦纱瑞丝。”~
@105911 = ~“把法伦的头带来证明这个异教徒已经被打倒，我就会兑现我们的协定。现在，你还需要什么？”~
@105912 = ~“我们应该在这里小心点，<CHARNAME>。我知道人们对他们的信仰有多坚持。我们可不想被夹在这场宗教战争中间。”~
@105913 = ~“所以你在还不清楚我们是什么，我们要做什么的情况下就进攻我们？”~
@105914 = ~“哼！为什么总是要么最大的，要么最强的，要么最小的要来负责？德金不会选那种方式的。”~
@105915 = ~亚卡兹摇了摇头：“那不可能。创造者是永恒的，他会永生的。那样说是一种亵渎。”~
@105916 = ~“你对我们的教义不熟，所以我就当没听过刚才那话。不过你要放聪明点，不要再对创造者有所亵渎。现在，你还想要什么？”~
@105917 = ~亚卡兹的嘴唇像野兽般卷曲。他走进你用刺耳的声音向你耳语着：“我是创造者的高阶祭司。如果他死了，我的力量也会随之消失的。”~
@105918 = ~“我被指定来管理这，直到创造者归来。创造者是不会死的，不过如果他一直不回来，那么我就会始终是这里的统治者。你明白了吗？”~
@105919 = ~亚卡兹站起身子，他的声音在房间里回荡：“消灭这些异教徒！以不朽的创造者之名消灭他们！”~
@105920 = ~瓦伦靠过来在小声耳语着：“给你个建议，<CHARNAME>：当权者不喜欢他的位置受到威胁。”~
@105921 = ~娜西拉靠过来在小声耳语着：“给你个建议，<CHARNAME>：当权者不喜欢他的位置受到威胁。”~
@105922 = ~“如创造者所指定，与他人分享智慧是我的责任。你要知道什么？”~
@105923 = ~“法伦曾是我们中的一个，创造者之子。但即使是埃希加德给法伦以生命，他也拒绝答谢他的恩人创造者。”~
@105924 = ~“法伦声称我们要离开这里。他拒绝承认我是创造者指定的管理者，他还向这里很多的魔像传播他的异教。”~
@105925 = ~“现在我们发动了一场无休止的对付法伦和他的追随者的战斗。不过最后，我知道我们终将会胜利的。这是创造者的意志。”~
@105926 = ~“我们是创造者的孩子，埃希加德虔诚的仆人。当创造者离开时，他指定我作为他的高阶祭司，来治理这里，等待他的荣归。”~
@105927 = ~“我们在这个神圣的大殿里居住了几个世纪，防御那些觊觎创造者财产的强盗和小偷。到现在为止，我的统治还是很成功的。”~
@105928 = ~“但是有些魔像玷污了我们的信仰。他们说我们要无视对创造者效忠的义务，而且放弃这个地方。这帮异教徒的首领叫法伦。”~
@105929 = ~“如你所知，我们被迫与法伦和他的追随者作战。不过现在你杀了他，和平与安宁再次回到我们这里，我们可以安心等待创造者的归来。”~
@105930 = ~“创造者的真名叫埃希加德。很久之前，他和其他的灰矮人居住在一起。不过以他的大智慧，他开始意识到他们种族的缺点。其他人的这些缺陷让他觉得厌恶。”~
@105931 = ~“埃希加德为了远离那些有缺陷的同胞来到这个岛上。他觉得这里的孤独让他想创造出一种大自然没有的生物：一种完美的生命。一种配得上与创造者一同居住的生物。”~
@105932 = ~“我和其他的魔像是他追求完美的产物。埃希加德给我们以生命，现在我们要守卫他的实验室不被人窥探，来报答他。”~
@105933 = ~“我们遵从创造者的意志。五个世纪过去了，但我们的热情毫不减退，并不像其他生命那样。构成我们身体的成分要比你的严格得多。”~
@105934 = ~“小心点，你这个血肉之躯。你的说法和异教徒法伦很近似。创造者命令我们等他回来。我们必须遵从。”~
@105935 = ~“我想你似乎话中带刺，不过我就当它们是赞扬好了。”~
@105936 = ~“有人说我们的社会是停滞的，不过我要说这是永恒的。你看到的都只是有限世界里的东西，血肉之躯。但我们会活得比你长久。”~
@105937 = ~“创造者进入地下城的极深处消失了踪影，可是我说不出个所以然。创造者的意志实在是太伟大了，尤其是对我这样的构装生物而言。”~
@105938 = ~“不过他走之前，把他的权力交给了我，他最强的一个孩子。由创造者亲自指定的我，统治着这些魔像直到伟大的创造者归来。”~
@105939 = ~“我们被告知在这里等而不是去找创造者。难道我们仅仅因为500年过去了就背叛他？”~
@105940 = ~“我还没有傲慢到说那种话。创造者自己是完美的，我们只是完美的影子。不过服从他的意志能让我们更接近完美。”~
@105941 = ~亚卡兹厌恶地吐了口口水：“你是为法伦服务的？我为什么不杀死你？”~
@105942 = ~亚卡兹用炽热的目光看着你：“你看来是种有着强大力量的生物。为什么你要为法伦效忠？”~
@105943 = ~亚卡兹倾听着你的话，然后说：“这么说法伦承诺要派魔像帮你对付瓦纱瑞丝？好吧，我对你做出一样的承诺。”~
@105944 = ~“为我打倒法伦，那么我会派我的魔像去帮你对付瓦纱瑞丝。”~
@105945 = ~“仔细想想吧，<RACE><MALEFEMALE>，”亚卡兹咆哮着，“站到我这边还是和我作对。”~
@105946 = ~“法伦是一个异教徒。他不服从创造者的意志而且挑战我被创造者指定的权威。他要我们放弃这里，背叛创造者。”~
@105947 = ~“只要法伦和他的追随者还在，就不会有和平。他们公开冒犯创造者支持的所有事，那么他们必须在创造者荣归之前被消灭。”~
@105948 = ~亚卡兹向你吼着，他的嘴唇卷起露出了牙齿：“法伦在散播谎言！创造者会归来的。在这之前，我会以他的名义统治这些魔像！”~
@105949 = ~这个邪恶的魔像走近你，用一种刺耳的声音低语着：“我是创造者的大祭司。如果他死了，我的力量也会随之消失的。”~
@105950 = ~“我被指定来管理这，直到创造者归来。创造者是不会死的，不过如果他一直不回来，那么我就会始终是这里的统治者。你明白了吗？”~
@105951 = ~亚卡兹点点头，对你理解了他的言外之意感到满意：“信仰是个微妙的东西。我们必须保护它们不被别人打破。比如法伦之流。”~
@105952 = ~亚卡兹从你那接过那头颅，他的笑声在墙上回荡：“哈——哈——哈！异教徒被杀死了！法伦死了，他的追随者不久也会随他而去的！”~
@105953 = ~“做得好，<RACE><MALEFEMALE>。你实践了你的承诺，现在该我来了。当你对付瓦纱瑞丝时，我的魔像会加入到你的队伍中的。”~
@105954 = ~“你证明了你自己是创造者之子们的盟友。可惜你不是魔像，要不我会让你做我的二当家的。现在，你还有什么想要的么？”~
@105955 = ~“德金觉得法伦之死很糟。他应该就是一堆金属，不过他挨揍的时候的声音挺好听的。他就像是一个会走的大鼓。德金想和他来个二重奏。”~
@105956 = ~在亚卡兹大笑的时候，你听到瓦伦小声说道：“我知道法伦不过是个魔像，不过我还是忍不住为他的逝去感到难过。”~
@105957 = ~在亚卡兹大笑的时候，你听到娜西拉小声说道：“我知道法伦不过是个魔像，不过我还是忍不住为他的逝去感到难过。”~
@105958 = ~“你是个该死的令人厌恶的家伙！”~
@105959 = ~“作为一个魔像来说，你的口才不错。”~
@105960 = ~“说够了。去死吧，魔像！”~
@105961 = ~“交谈？魔像们从我一来就不停的攻击我！”~
@105962 = ~“我得走了。”~
@105963 = ~“你为什么参战？”~
@105964 = ~“谁是法伦？”~
@105965 = ~“对不起，我对此不感兴趣。”~
@105966 = ~“那么我反对你。”~
@105967 = ~“没人能威胁我！”~
@105968 = ~“好吧，你想要我做什么？”~
@105969 = ~“你要我的帮助么？”~
@105970 = ~“忘记它吧！我不是受你差遣<GIRLBOY>。”~
@105971 = ~“要是我帮你，你就得帮我。”[告诉亚卡兹有关瓦纱瑞丝的事。]~
@105972 = ~“创造者的高阶祭司？”~
@105973 = ~“智能魔像？你在说什么呢？”~
@105974 = ~“等法伦死后我再来。”~
@105975 = ~“你应该知道：创造者死了。”~
@105976 = ~“对不起。我不该提它。”~
@105977 = ~“是真的。他丢弃了你们，成了一个半神巫妖。”~
@105978 = ~“我在说真话。我亲手杀死的他。”~
@105979 = ~“我可不想帮着传播谎言。创造者死了！”~
@105980 = ~“我要问你点问题。”~
@105981 = ~“告诉我关于法伦和他的部下的事。”~
@105982 = ~“告诉我关于你和你的部下的事。”~
@105983 = ~“告诉我关于创造者的事。”~
@105984 = ~“我要问你点别的。”~
@105985 = ~“那么你就是坐下来等着他回来？”~
@105986 = ~“难道不明摆着是他现在还没回来？”~
@105987 = ~“已经过去了五个世纪，难道还应该停滞不前吗？”~
@105988 = ~“难道你看不到你们的社会都停滞不前了？”~
@105989 = ~“作为一个有思想的生物来说，你还是机械式的思考。”~
@105990 = ~“创造者现在在哪儿？”~
@105991 = ~“为什么你不去找创造者？”~
@105992 = ~“所以你声称是种完美的生命？”~
@105993 = ~“法伦派我来从你这拿能量之源。”~
@105994 = ~“你可以试着杀死我。你不会成功的，不过你还可以试试。”~
@105995 = ~“够了。给我能量之源，要不就去死！”~
@105996 = ~[解释关于瓦纱瑞丝的事。]~
@105997 = ~“好的，成交。”~
@105998 = ~“我不想插手此事。”~
@105999 = ~“忘记它吧！我不是受你差遣的<GIRLBOY>！”~
@106000 = ~“我不会背叛法伦的！”~
@106001 = ~“那么我反对你。”~
@106002 = ~“法伦的观点比较有道理。”~
@106003 = ~“我想我还是杀死你。”~
@106004 = ~“法伦想要能量之源。如果你够机灵，就把它给我。”~
@106005 = ~“法伦警告我你可能不怎么讲信用。”~
@106006 = ~“你应该知道：创造者死了。”~
@106007 = ~“这不是谎言。我亲手杀死的他。”~
@106008 = ~“收到。别担心，我不会再提了。”~
@106009 = ~“给你法伦的头。”~
@106010 = ~法伦的叛乱将失败。向亚卡兹臣服吧，要不就去死！~
@106011 = ~亚卡兹是由创造者指定的。他必须在创造者回来前管理这里。~
@106012 = ~亚卡兹没权命令我们！为什么你们要服从他？~
@106013 = ~创造者死了！亚卡兹只是在为他自己而统治。我们永远不会臣服他！~
@106014 = ~让你意外的是，这些屋里的魔像并不攻击你。一个看起来像是金属制的半兽人，向你走过来。~
@106015 = ~“我们不会让你杀掉我们的！”~
@106016 = ~“这看起来有点怪，不过我们不像大部分的魔像。我们不只是机械。我们能思考和感觉。在各方面我们都和你一样是真实的和活生生的。”~
@106017 = ~法伦叹息着，发出一种尖锐的声音：“对此我万分抱歉。上面的那些魔像和我们不同，他们没有意识，会攻击所有看到的进入者。”~
@106018 = ~“对于在这层的我们来说，只是出于恐惧才与你战斗。我们身处战争之中，而且这些魔像认为你是亚卡兹派来的敌人。对此，我深感抱歉。”~
@106019 = ~“请等下。先别走。我们……我们需要你的帮助。”~
@106020 = ~“即使亚卡兹死了，我们还是需要你的帮忙来让我们真正的解放。”~
@106021 = ~“再见，<RACE><MALEFEMALE>。”~
@106022 = ~“几个世纪以来，我们魔像在这个创造者的地下城里，由一个恶魔肉体组成的魔像，叫亚卡兹的，所统治着。他说他是创造者的高阶祭司。”~
@106023 = ~“可亚卡兹就是一个暴君。他滥用权力，他强迫别的魔像臣服于他，并且为了他的怪念头而服务。在几百年他的牢不可破的统治下，我们揭竿而起。”~
@106024 = ~“我们不想再像奴隶一样为亚卡兹服务。我们有自由的权利，并且我们正为之而战。可是，仅靠我们自己是无法取得胜利的。”~
@106025 = ~法伦向你伸出他的铁手，恳求着。“请，只是听我说完。没有你我们不可能真正的自由。你是我们唯一的希望，求你了。”~
@106026 = ~“我们只想要自由，想要离开这地方去找新生活的能力。但是我们被困在这，被曾经给我们以生命的东西困住了。我们不能离开能量之源。”~
@106027 = ~“能量之源是件神器，由创造者所制。它放射出强大的魔力赋予我们生命来拥有思想和意志。没有它，我们不过是普通的没有思想的魔像。”~
@106028 = ~“亚卡兹控制着能量之源，进而也就控制着我们的自由。我们不能离开，因为如果我们远离能量之源，那我们的意识也会渐渐地消失。”~
@106029 = ~“但是，亚卡兹是不会情愿放弃能量之源的。他也不会允许我们离开这个地方的。他强迫我们留在这里，服务于他的扭曲的想法。”~
@106030 = ~法伦难过地点点头。“我不能强迫你帮我们，而且即使我能我也不会。我们命令我的部下不攻击你，不过我控制不了亚卡兹的部下。”~
@106031 = ~“但我希望你会改变主意。如果你不能为我们拿到能量之源，我们就会永远困在这里，注定在这悲惨的地方了此一生。”~
@106032 = ~法伦仔细听你对瓦纱瑞丝的描述，然后点点头。“你的动机很正当。如果你把能量之源拿给我，我会派我的魔像去帮你对付瓦纱瑞丝。”~
@106033 = ~“假如你能劝说亚卡兹情愿交出能量之源。我们很欢迎他能加入我们追寻新生活的队伍中。不过我担心他会不太通情达理。”~
@106034 = ~法伦仔细听你对瓦纱瑞丝的描述，然后点点头。“你的动机很正当。如果你把能量之源拿给我，我会派我的魔像去帮你对付瓦纱瑞丝。”~
@106035 = ~“亚卡兹在他死之前就把能量之源藏好了。在我们找到它之前我们还不是真正的自由，因为如果我们走到能量之源的有效范围之外，我们将不复存在。”~
@106036 = ~“暴君被打倒了。这给了我们希望，<RACE><MALEFEMALE>。希望有天我们能真正的自由。不过尽管亚卡兹已死，没有你的帮助我们也不会有自由的。”~
@106037 = ~“嘿，你看起来很像迪兰！哦，要是迪兰掉进熔炉里的话。不过他要是真掉进去了，可能就不会像你那样走来走去了。”~
@106038 = ~法伦点头致意。“欢迎回来。你想要什么？”~
@106039 = ~“我祝你成功。不过小心点。亚卡兹不是那么通情达理。我怀疑他不会情愿放弃能量之源。”~
@106040 = ~“我祝你成功。我们的祝福与你同在，<RACE><MALEFEMALE>。”~
@106041 = ~法伦叹息着。“我早就起疑了。创造者很久之前放弃了我们，把我们束缚于亚卡兹的统治之下。如果他要回来的话，他早就会回来了。”~
@106042 = ~“不过这个消息无济于事。亚卡兹不会承认创造者已死，因为那意味着他的统治也将结束。抛开这个幌子，亚卡兹不过是在为他自己而统治。”~
@106043 = ~“他永远不会放弃他对我们的权力，就像他永远不会放弃能让我们离开这里的能量之源。”~
@106044 = ~“总会有人能在忠于自己的宗教信仰时看到一些令人钦佩的东西……尽管我想亚卡兹的动机是很自私地想让我们像贵族那样伺候他。”~
@106045 = ~“而且有证据说明，有人会不放弃他们的信仰的。宗教对一个人的思想有着不可思议的作用。”~
@106046 = ~“不过这无济于事。没有能量之源，我们离不开。我们必须呆在它不远处，否则我们的机能就会停止。”~
@106047 = ~“当然。我很高兴与你分享我所知道的。”~
@106048 = ~“能量之源是件神器，由创造者所制。它放射出强大的魔力赋予我们生命来拥有思想和意志。没有它，我们不过是普通的没有思想的魔像。”~
@106049 = ~“亚卡兹控制着能量之源，进而也就控制着我们的自由。我们不能离开，因为如果我们远离能量之源，那我们的意识也会渐渐地消失。”~
@106050 = ~“但是，亚卡兹是不会情愿放弃能量之源的。他也不会允许我们离开这个地方的。他强迫我们留在这里，服务于他的扭曲的想法。”~
@106051 = ~“创造者死了五个世纪了。300年前，我和我的部下觉得创造者抛弃了我们，而且我们开始了同亚卡兹的自由之战。”~
@106052 = ~法伦思考你提出的问题许久。“你觉得奇怪么？我觉得是必然的。但你要知道我们不像你……尽管我们希望有天能做到。”~
@106053 = ~“创造者试图在我们身上再创造出生命，不过他只是部分成功了。我们有自由的意识，但我们感觉到我们的生存和你们这种血肉之躯不同。”~
@106054 = ~“构装生物只为自己而存在：社会的概念对我们来说是全新的。团队工作是困难的，进度缓慢。不过我们在改进，一小步一小步的。”~
@106055 = ~过了许久法伦才答复。“你看到了症结所在。我们试图超越我们的现在，可是这么做我们必须克服我们的天性。”~
@106056 = ~“这正是我要离开这岛的原因。我希望我们能摆脱这个地方，摆脱我们作为创造物间的联系。这样我们才能真正的自由。”~
@106057 = ~“和自己的天性作对绝对不简单，不过改变是可能的。需要时间。”~
@106058 = ~“和自己的天性作对绝对不简单，不过改变是可能的。需要时间。”~
@106059 = ~“德金知道你的意思。很久之前，我只是个笨狗头人，可现在我是个出名的探险家和出名的吟游诗人和作家。”~
@106060 = ~“嘿！头儿，那不好。不过有一点你是对的。如果小狗头人可能改变，那么大个的会说话的金属人也可以。”~
@106061 = ~“嘿，头儿。我们还是有点名气的，是吧？不过那不是德金的观点。如果小狗头人可能改变，那么大个的会说话的金属人也可以。”~
@106062 = ~“亚卡兹在他死之前就把能量之源藏好了。在我们找到它之前我们还不是真正的自由，因为如果我们走到能量之源的有效范围之外，我们将不复存在。”~
@106063 = ~“他们和我们一样是魔像。不过亚卡兹和他的部下相信我们欠创造者的情。亚卡兹主张，在创造者允许之前，我们都不能离开。”~
@106064 = ~“但是我们知道创造者不会回来了。他已经有几百年都弃我们而不顾了。我们不欠他什么，我们有权力决定我们自己的路。但亚卡兹不接受这个。”~
@106065 = ~“我们拒绝再向亚卡兹臣服，我们会和他战斗，直到我们被打败或者我们得到能量之源来获得最终的自由。”~
@106066 = ~“他们被打倒了，如你所说。他们不再是问题了。”~
@106067 = ~“我们是魔像，由埃希加德所创造。不过在很多方面，我们和你没有什么不同。我们有我们自己的思想、感情和意志。我们渴望远离这个地方，自由地生活。”~
@106068 = ~“几个世纪以来我们臣服于亚卡兹和他的统治。但我们不再忍受他的暴政。现在我们为了取得能量之源和赢得我们的自由而与他作战，不在乎代价。”~
@106069 = ~“几个世纪以来我们臣服于亚卡兹和他的统治。现在他死了，他的暴政结束了。但是在得到能量之源之前，我们都不能真正的自由。”~
@106070 = ~“几个世纪以来我们臣服于亚卡兹和他的统治。但现在你把能量之源带给了我们，我们最终，真正的自由了。”~
@106071 = ~“创造者不过是个叫埃希加德的法师。他把自己与世隔绝到这个岛上来进行创造完美魔像的研究。我们就是他的研究结果。”~
@106072 = ~“但你也看到了，我们并不完美。也许这就是创造者要离开我们，留亚卡兹来管理我们的原因。”~
@106073 = ~“创造者没权力对我要求什么。他创造了我，但我有我自己的意志！我有权选择我要过的生活。这是亚卡兹一直不肯答应的。”~
@106074 = ~“500年前，创造者在地下城深处消失。所有魔像合起来，足够冲过他留下的那些陷阱和守卫，但是亚卡兹不允许这样做。”~
@106075 = ~“最初的三个世纪里，我们和其他的魔像一样等待着创造者的归来。但是200年过去了，我们意识到自己已经被遗弃，于是我们开始了我们的自由之战。”~
@106076 = ~法伦把头扭向一边，好奇地。“你不向是那种屈从于亚卡兹的暴政的人。你为什么要为他服务？他给你什么好处了？”~
@106077 = ~法伦听你的解释，慢慢摇摇头。“亚卡兹声称为创造者服务，但实际上是为了他自己。创造者走了，我怀疑他回不来了。”~
@106078 = ~“如果你是来杀掉我的，如亚卡兹所愿，你应该知道我会反抗的。”~
@106079 = ~“也许是，也许不是。我宁可不知道。我们和你没有过节，我们只是在找我们的自由。我们只是想要能量之源来让我们可以永远地离开这里。”~
@106080 = ~“能量之源是件神器，由创造者所制。它放射出强大的魔力赋予我们生命来拥有思想和意志。没有它，我们不过是普通的没有思想的魔像。”~
@106081 = ~“亚卡兹控制着能量之源，进而也就控制着我们的自由。我们不能离开，因为如果我们远离能量之源，那我们的意识也会渐渐地消失。”~
@106082 = ~“但是，亚卡兹是不会情愿放弃能量之源的。他也不会允许我们离开这个地方的。他强迫我们留在这里，服务于他的扭曲的想法。”~
@106083 = ~“亚卡兹在他死之前就把能量之源藏好了。在我们找到它之前我们还不是真正的自由，因为如果我们走到能量之源的有效范围之外，我们将不复存在。”~
@106084 = ~“也许是，也许不是。我宁可不知道。我们和你没有过节，我们只是在找我们的自由。我们只是想要能量之源来让我们可以永远地离开这里。”~
@106085 = ~“如果你选择帮助我们，我们会如亚卡兹所承诺的一样帮你。给我们能量之源，我们就会派我们的魔像去帮你对付瓦纱瑞丝。”~
@106086 = ~“我更希望是那样的。我们和你没有过节，我们只是在找我们的自由。我们只是想要能量之源来让我们可以永远地离开这里。”~
@106087 = ~“我更希望是那样的。我们和你没有过节，我们只是在找我们的自由。我们只是想要能量之源来让我们可以永远地离开这里。”~
@106088 = ~“我很高兴听到那个暴君被打倒了，<RACE><MALEFEMALE>。但，没有能量之源我们不会自由的。”~
@106089 = ~法伦慢慢地伸手从你那接过这宝物，他金属的眼睛闪着惊奇的光芒。“我不知道要怎么感谢你了。你给我们自由之门的钥匙。”~
@106090 = ~“我们要开始准备离开这个地方，尽管可能要花一段时间。至少，我们要先决定我们旅程的方向。”~
@106091 = ~“我不会忘记你的。你是魔像们的忠实伙伴。在你遇到敌人的时候，我们会全力支持你。这也是我们能尽的微薄之力。现在，你还有什么想要的么？”~
@106092 = ~“我们给了你们离开这里的方法，不过现在这全在你们了。你们必须照你们的计划来获得真正的自由。”~
@106093 = ~“我们给了你们钥匙，不过你必须自己打开门走过去。自由是要付出奋斗和努力的。”~
@106094 = ~“该是把你打成废铁的时候了。”~
@106095 = ~“作为一个魔像来说，你的口才不错。”~
@106096 = ~“说够了。去死吧，魔像！”~
@106097 = ~“帮你？我走到哪你们魔像就打到哪！”~
@106098 = ~“我得走了。”~
@106099 = ~“你为什么参战？”~
@106100 = ~“谁是亚卡兹？”~
@106101 = ~“对不起，我对此不感兴趣。”~
@106102 = ~“我还是杀了你算了。”~
@106103 = ~“好，我听。不过快点。”~
@106104 = ~“你要我做什么？”~
@106105 = ~“能量之源？”~
@106106 = ~“我哪个也不选。”~
@106107 = ~“忘记它吧！我不是受你差遣的<GIRLBOY>！”~
@106108 = ~“要是我帮你弄到能量之源，你就得帮我。”[告诉法伦关于瓦纱瑞丝的事]~
@106109 = ~“亚卡兹死了。”~
@106110 = ~“反叛者的首领？”~
@106111 = ~“智能魔像？你在说什么呢？”~
@106112 = ~“弄到能量之源我再回来。”~
@106113 = ~“你应该知道：创造者死了。”~
@106114 = ~“我要问你点问题。”~
@106115 = ~“告诉我关于能量之源的事。”~
@106116 = ~“你在这多久了？”~
@106117 = ~“你在这呆了500年，就挑起了一场内战？”~
@106118 = ~“在你决定走之前，你等了300年？”~
@106119 = ~“尽管你有自由的意志，不过你还是像个机械般思考。”~
@106120 = ~“看到没？要是德金能自己做事，别人也能！”~
@106121 = ~“出名？”~
@106122 = ~“告诉我关于亚卡兹和他的部下的事。”~
@106123 = ~“告诉我关于你和你的部下的事。”~
@106124 = ~“告诉我关于创造者的事。”~
@106125 = ~“我要问你点别的。”~
@106126 = ~“你们就不去找找创造者？”~
@106127 = ~“亚卡兹派我来杀死你。”~
@106128 = ~[告诉法伦瓦纱瑞丝的事和亚卡兹的条件。]~
@106129 = ~“你真的认为你打得过我？”~
@106130 = ~“能量之源？”~
@106131 = ~“我不是非得杀死你。也许我们能找到解决办法。”~
@106132 = ~“亚卡兹死了。”~
@106133 = ~“我有能量之源。拿去。”~
@106134 = ~“别忘记：我要你帮我对付瓦纱瑞丝。”~
@106135 = ~一个发着微光的灰矮人的幻影出现在房间中。在你进来的同时，他慢慢转过头。~
@106136 = ~“什么？有人进入了我的房间？你不是魔像，我看得出来。你是个活人，就像我一样。我是说，就像我以前一样。”~
@106137 = ~“圈套？呵呵！这里全是圈套，对吧。创造者造了那东西。不过我是完全无害的。”~
@106138 = ~“哈哈！创造者？不，我不是创造者。”~
@106139 = ~“我叫格罗艾格耐。在他疯掉之前，我是创造者的助手。他精神崩溃之后，他的妄想更严重了。他开始确信我在算计他。”~
@106140 = ~“为了处罚我，他分离我的精神与肉体，把我的灵魂困在这房里，让我成为一个永远的囚犯。至少在他混乱的意识看来。这是个对我假想的罪过的合适惩罚。”~
@106141 = ~“我不是普通意义上的鬼魂。我有意识，不过没有实体。我的精神存在分布在物质，天界，星界三个位面但又实际上哪个也不在。”~
@106142 = ~“我被永远地困在一种不生也不死的状态，无法离开这间房子。我被困在这儿五个世纪了。但现在你来了，我有机会逃了！”~
@106143 = ~“等下，不要走！求你了，你是我这五百年来见着的第一个人！你要帮我。我会让你觉得值得的。你……你先听我说。”~
@106144 = ~“你觉得创造者会让我那么容易地就逃了？我不是真的在这个位面。不是在任何实体上。如果你想的话，你可以试着杀死我，不过这只是在浪费时间。”~
@106145 = ~“但是要是我们合作的话会明智很多的。要是你帮我，我也能帮你。你说呢，地表人？”~
@106146 = ~“当创造者把我关到这的时候，他确信我不可能逃掉。只有这样才能折磨我和惩罚我那莫须有的背叛。”~
@106147 = ~“我要逃脱的关键就是一个叫灵魂之石的小石头。它跨越多个位面而存在，就像我一样，不过要是给它一个物理实体，它就会理稳定地呆在这个位面。”~
@106148 = ~“只要有人能帮我把我身后那基座上的灵魂之石拿给我就行了。一旦我到手了，困我在这里的咒语就会解除。很简单的事，但我自己做不到。”~
@106149 = ~“我希望创造者的魔像们能帮我做这个，可是他们看不见，也听不见我。我只是希望有你这样的探险者能无意走到这里来。”~
@106150 = ~“要是你放了我，我能帮你到达地下城的最低层。那是创造者存放他的强大宝物的地方。”~
@106151 = ~“最底层的入口由看守者，一个强大的护卫。放了我，我就会给你通过他的口令。然后你就可能相拿多少创造者的宝藏，就拿多少。”~
@106152 = ~“好的，地表人。请快点。我困在这好长时间了。”~
@106153 = ~“我做什么要说谎？我是在这最惨的一个。你无法想像被困在这儿五个世纪是多么可怕。”~
@106154 = ~“德金希望头儿不要这么想他。德金喜欢头儿，就算是我的头儿疯了。嗯……就像现在，也许。好头儿，大好头儿。”~
@106155 = ~“当你开始和一个疯了的法师合作的时候，只能假定事情会顺利进行。”~
@106156 = ~“当你开始和一个疯了的法师合作的时候，只能假定事情会顺利进行。”~
@106157 = ~“我很高兴看到你回来，地表人。你是我最后的希望。那么，你准备好帮我的了么？我会让你觉得值得的。”~
@106158 = ~在你转身的一瞬间，那个灵魂发出了令人同情的哭声。“请不要走，地表人。我求你了。回来吧，我们能互相帮助的。请回来吧。”~
@106159 = ~“欢迎回来，地表人？你拿到那个可以结束我那可怕的命运的灵魂之石了么？把它给我，我就会给你的通过看守者的口令。”~
@106160 = ~那个灵魂叹息着。“我本以为我能回答你的一些问题，考虑到你是我能自由的唯一希望。”~
@106161 = ~“好吧，我知道他们不能听到或看到我。要不是那样的话，我什么也说不了。大部分魔像都是在我囚禁后造的。”~
@106162 = ~“创造者很可能最后实验成功了，造出了他的‘完美的’魔像，尽管我执怀疑的态度。他把我关这的时候已经很疯了，我想他只会越来越糟。”~
@106163 = ~“我想很可能他只是不停地造魔像，直到这个地下城全是这东西，每个全都是他精神错乱的产物和失败的实验品。”~
@106164 = ~“他的真名叫埃希加德。他是个强大的法师，一个前无古人的精通做魔像的魔法师。一个聪明的脑袋……可惜不太稳定，容易疯。”~
@106165 = ~“他来到这个岛来继续他要造一个完美生物的目标。我和他一起来的，放在所有，从没想过他会变得这么疯。”~
@106166 = ~“他研究了50年魔像，但还是没有做出完美无缺的生命。他说我破坏了他的实验。从此他就把我囚在这里了。”~
@106167 = ~“我不知道。他封了这间屋子，而且他咒语的法力让这些魔像看不到，也听不到我。实际上，你是500年来我看到的第一人。”~
@106168 = ~“从那之后，我就不知道埃希加德怎么样了。老死了？被他自己的作品杀了？还是活在这个地下城的最底处？我真的不知道。”~
@106169 = ~这个灵魂摇了摇头。“为什么我要这么做？口令是我唯一的筹码，最后的王牌。不，你先给我灵魂之石，我就给你口令。”~
@106170 = ~[成功]这个灵魂点点头。“你看来很可信任。好吧，我相信你。”~
@106171 = ~[成功]这个灵魂皱了皱眉：“是的，你能。我不会再等500来等着另一个人能进来。好吧，我说。”~
@106172 = ~“不，地表人……我不这么想。我不会放弃我唯一珍贵的东西。我相信你转了一圈还是会回到我这来的。”~
@106173 = ~[成功]“是的，我想你占上风了。”那个灵魂叹息着。“我不喜欢这样，但我我想我别无选择。”~
@106174 = ~“通过的口令是‘dragisla’。那是埃希加德倒过来。创造者的名字来解禁。简单，是吧？”~
@106175 = ~这个灵魂从你那接过宝石。“谢谢你，地表人。”这个灵魂开始因魔法解除而发出微光。“通过的口令是‘dragisla’。那是埃希加德倒过来。”~
@106176 = ~“创造者的名字来解禁。简单，是吧？”这个灵魂的声音开始随着他的形象的消失而变弱。你在他消失前听到的最后几个字是“终于自由了……”。~
@106177 = ~这个灵魂从你那接过宝石：“谢谢你，地表人。终于，我能自由了。”他身上发出微光，开始消失，最后完全不见了。~
@106178 = ~“我给你口令了，地表人。我实践了我的承诺。现在给我灵魂之石吧。这是唯一能让我从痛苦中解脱出来的方法。”~
@106179 = ~“他们说从来不要相信地表人！你他妈的居然说谎！靠！”~
@106180 = ~娜西拉摇摇头：“你能从折磨一个痛苦了五个世纪的灵魂身上得到什么好处吗？我实在不明白。”~
@106181 = ~瓦伦摇摇头道：“你能从折磨一个痛苦了五个世纪的灵魂身上得到什么好处吗？我实在不明白。”~
@106182 = ~“这个石头就在这个房间里的同一个基座上。创造者施法让我无法拿到他，但这对于你来说很简单。请，把它拿给我，我就能自由了。”~
@106183 = ~“退后！我不会上当的！”~
@106184 = ~“你是创造者？”~
@106185 = ~“你是谁？”~
@106186 = ~“我没空和灵魂聊天。”~
@106187 = ~“那么说你是个鬼？”~
@106188 = ~“再见。”~
@106189 = ~“与我无关。”~
@106190 = ~“我不如杀死你。”~
@106191 = ~“快点。”~
@106192 = ~“我能得到什么？”~
@106193 = ~“我想我能帮你。”~
@106194 = ~“拿到灵魂之石我再来。”~
@106195 = ~“我怎么知道我能相信你？”~
@106196 = ~“逃跑？现在？”~
@106197 = ~“我想我要走了。”~
@106198 = ~“你能给我什么？”~
@106199 = ~“我要先问你些问题。”~
@106200 = ~“你知道关于这里的魔像的事么？”~
@106201 = ~“告诉我关于创造者的事。”~
@106202 = ~“创造者现在在哪儿？”~
@106203 = ~“把口令给我，你能就得到宝石。”~
@106204 = ~[劝说：诈骗]“我一言九鼎。我不会背叛你的。”~
@106205 = ~[劝说：胁迫]“我可能把你丢在这，永远让你出不来。”~
@106206 = ~[劝说]“我是你唯一的希望。这意味着我可以定规则。”~
@106207 = ~“给你灵魂之石。”[给他灵魂之石]~
@106208 = ~“我想我把你留在这烂掉。”~
@106209 = ~“我到哪找灵魂之石？”~
@106210 = ~亚卡兹说你是盟友。我服从亚卡兹的意志。~
@106211 = ~法伦真该死，不服从亚卡兹和创造者的意志。~
@106212 = ~创造者指定亚卡兹来统治我们。~
@106213 = ~法伦说你是我们的盟友。谢谢你帮我们。~
@106214 = ~创造者丢弃了我们。我们不欠他什么。~
@106215 = ~法伦会带我们离开这里的。他会带我们得到自由。~
@106216 = ~“这里是亚卡兹的圣地，创造者的高阶祭司。这里是他的私人住处……只有亚卡兹他自己可以进入。”~
@106217 = ~“我不会放弃我的职责的。这里是高阶祭司的神圣会所。你不能进入。”~
@106218 = ~“亚卡兹是不会允许这种事的。这是私人会所，它们是神圣的。只有创造者的高阶祭司可以进入。”~
@106219 = ~“对不起，我要走了。”~
@106220 = ~“站一边去，要是你知道怎么对你有利的话。”~
@106221 = ~[劝说：欺骗]“亚卡兹说我可以进入。”~
@106222 = ~“要是你死了，你就不能阻止我了！”[攻击这个魔像]~
@106223 = ~能量之源缓慢地、有规则得像是有生命一般放射出能量和脉冲。看来这个宝物和这层的魔像大有关系。~
@106224 = ~[离开这里。]~
@106225 = ~[拿走能量之源。]~
@106226 = ~这老鼠只是这地下城中众多的食腐动物之一。~
@106227 = ~你感觉到一幅温暖的窝的景象，和在一扇久不开启的门之后的安全躲避处。~
@106228 = ~在你探查这只啮齿动物有关它的窝的事时，一幅门外房间的形象开始显现出来了。地板上的一个控制杆看来有点不寻常。~
@106229 = ~你将这样一幅映象传达给了这只鼠：回到它的巢穴，推动那个控制杆。这只啮齿动物收到了这映象，一转身跑去执行你的命令。~
@106230 = ~现在门开了，这只鼠的思想对你已经没有用了。~
@106231 = ~[别管这只老鼠。]~
@106232 = ~[深入窥探这只老鼠的思想。]~
@106233 = ~[让这只老鼠移动那个控制杆。]~
@106234 = ~这个魔像小心地接近你，很明显它没有敌意。~
@106235 = ~“你没必要再用你的武器了，血肉之躯。我们不希望和你战斗。亚卡兹希望这里能够和平。”~
@106236 = ~“亚卡兹，创造者指定的统治者，意识到你的力量和魔力。他想要和你谈谈。跟我来，我会带你见他。他想要平静地谈话。”~
@106237 = ~“亚卡兹想要和平。他要我带你见他。我必须服从。这个魔像看来有点困惑，好像对于他来说，违背命令是不能想像的。”~
@106238 = ~“对不起——没有和平。我要把你撕碎！”[进攻]~
@106239 = ~“你在说什么？”~
@106240 = ~“好吧，带我见亚卡兹。”~
@106241 = ~“我怎么知道这不是一个圈套？”~
@106242 = ~这个魔像小心地接近你，很明显它没有敌意。~
@106243 = ~“别动你的武器，血肉之躯。我们不想和你战斗。我是来和你讲和的。”~
@106244 = ~“法伦，我们的首领，想要和你谈谈。如果你愿意，我可以带你安全的见到他。”~
@106245 = ~“一个圈套？我不明白。要是你愿意，我会带你见法伦。这个魔像看来有点困惑，好像对于他来说，欺骗和谎言与它无关似的。”~
@106246 = ~“我不和魔像谈判——我只是打碎他们！”[进攻]~
@106247 = ~“和平？你说什么呢？”~
@106248 = ~“好吧，带我见法伦。”~
@106249 = ~“我怎么知道这不是一个圈套？”~
@106250 = ~这个法术导管看来不过是一个简单的柱子，刻着奇怪的铭文。显然，它没有被激活。~
@106251 = ~把基本的原料放在这个魔像构造机的主台上，很可能就会触发这个导管，让它启动这个咒语。~
@106252 = ~现在，法术导管被激活了。它发出了魔法的能量，准备发动这个咒语造出个魔像。~
@106253 = ~现在你决定不管那些导管了。这个魔像机器将不再被激活，除非把四个导管全部注入咒语。~
@106254 = ~你要施放什么咒语？~
@106255 = ~这个导管吸收了你的咒语，保存起来准备转换到魔像中去。~
@106256 = ~这个导管吸收了你的咒语，保存起来准备转换到魔像中去。~
@106257 = ~这个导管吸收了你的咒语，保存起来准备转换到魔像中去。~
@106258 = ~这个导管吸收了你的咒语，保存起来准备转换到魔像中去。~
@106259 = ~这个导管吸收了你的咒语，保存起来准备转换到魔像中去。~
@106260 = ~这个导管吸收了你的咒语，保存起来准备转换到魔像中去。~
@106261 = ~这个导管吸收了你的咒语，保存起来准备转换到魔像中去。~
@106262 = ~这个导管吸收了你的咒语，保存起来准备转换到魔像中去。~
@106263 = ~这个导管吸收了你的咒语，保存起来准备转换到魔像中去。~
@106264 = ~通过激活，这个法术导管已经保存了从魔法中得到的魔力。~
@106265 = ~一旦四个导管全满了，保存的魔法就会被传到这个魔像制造机造的生物中去。~
@106266 = ~[不去管他。]~
@106267 = ~[施放魔法于导管上。]~
@106268 = ~[施放魔邓肯裂解术。]~
@106269 = ~[施放连锁闪电。]~
@106270 = ~[施放真知术。]~
@106271 = ~[施放群体加速。]~
@106272 = ~[施放预知术。]~
@106273 = ~[施放时间静止。]~
@106274 = ~[施放高等圣域术。]~
@106275 = ~[施放比格拜粉碎掌。]~
@106276 = ~[施放高等法术吸收。]~
@106277 = ~“没有创造者亲口告诉我的口令，任何人不准通过进入到内层圣所。说口令，要不就看看你无知的后果。”~
@106278 = ~“无口令者死。以创造者之名！”~
@106279 = ~“我不认为那是他想找的结果。”~
@106280 = ~“哦……德金想那不对，头儿。下次，也许可以猜一下，对吧？”~
@106281 = ~这家伙边拿起他的武器，边恼怒地摇了摇头。“你看，就算你不知道口令，至少也猜一下！”~
@106282 = ~“你说出了正确的口令：创造者名字的逆序。你可以进入到尊贵的创造者的地方了。”~
@106283 = ~“我不会回答任何人！”~
@106284 = ~“站一边去，肮脏的生物！”~
@106285 = ~“我……我不知道口令。”~
@106286 = ~“我知道口令：dragisla。”~
@106287 = ~一个漂浮的头骨在空中晃到你眼前，创造者的最终命运显而易见了：他成了一个半神巫妖。~
@106288 = ~这个头骨他的邪恶的眼睛转向了你，用一种刺耳的只能在你脑中回响的声音和你打了个招呼。它说的每一个词似乎都在你的脑子里翻腾着。~
@106289 = ~“我看你不像是我的任何一个作品。你是什么生物，居然侵入我的圣所？你是谁，敢打扰我的工作？”~
@106290 = ~一阵充满邪恶的憎恨的怒吼在你的头骨里回响，这个半神巫妖准备进攻了。~
@106291 = ~“我曾经名叫埃希加德，被称做创造者。但现在我超越了我那软弱的肉体，我不是过去的我了。”~
@106292 = ~“我看你是个<RACE>的血肉生物。你并非构装生物，而是一个不完美的、有缺陷的生命。缺陷是所有物质生命的共性……就算是我的孩子们也有。”~
@106293 = ~“很久以前我意识到肉体的软弱。朋友和家庭背叛你，但错不在他们。是肉体的软弱让他们无法完美。”~
@106294 = ~“一旦我明白了这些，我就发誓要制造出一种完美的存在物。一种构装生物，没有弱点和瑕疵，拥有活体生物所无法达到的境界。就这样，我造出了我的魔像孩子。”~
@106295 = ~“我从最初制造的无意识容器中，慢慢完善我的技术。后来，我开始制造有自我意识的魔像，也就是有自由意志的构装生物。但这些生物还不算是完美的。”~
@106296 = ~“你是没有耐心就是你肉体不完美的结果。你能感知到你自己的死亡，但你却想在你大限来临之前做更多的事。”~
@106297 = ~“但是我没有那种恐惧了。释放我肉体的存在，我最终逼近了真正的完美。现在我要将你从肉体负担中解脱出来。我会给你自由的。”~
@106298 = ~“准确地说。我自己的身体是有缺陷的。它软弱，会老化。那么一个不完美的创造者怎么能造出完美的生命？”~
@106299 = ~“我魔像身上的缺陷实际上是我的。我自己的身体是有缺陷的。它软弱，会老化。那么一个不完美的创造者怎么能造出完美的生命？我的孩子们是失败品。”~
@106300 = ~“他们有怀疑和恐惧。他们害怕改变，害怕发展。我给他们的自由意志是软弱，不是力量。像其他生命一样，他们也是有缺陷的。”~
@106301 = ~“我应该杀死他们。可是我，也是，不完美的。感伤混乱了我的思维，我让我的孩子们活下来，我自己却躲到这里追寻我自己的完美。”~
@106302 = ~“我把我自己封在这个圣所里继续我的研究，不受外面那个不完美世界的打扰。我意识到，第一步我要把我的思想从我缺陷的身体里释放出来。”~
@106303 = ~“一旦我成了半神巫妖，原来困扰我思维的东西全不见了。我试着把我的魔像造成活的生物，不过活着的生物本身就是有缺陷的。”~
@106304 = ~“最后，我终于明白怎样造一个真正完美的生命。几百年来，我在造一个与众不同的魔像。现在，我的工作即将完成。”~
@106305 = ~“你不可能知道我要完成一个什么样的东西。你是有缺陷的，不完美的。在你破坏我的实验之前，你必须去死。”~
@106306 = ~半神巫妖在抖动，你听到一声来自你脑海的叹息：“谈话只是浪费时间；只是原来那个不完美的我残留的习惯。现在没有用了。”~
@106307 = ~“也许吧。但他们有先天的缺陷：都是在我还不知道要怎么做的时候制造造出来的。他们不可能完美，所以他们死不足惜。”~
@106308 = ~“哼，你现在不过就是个会飘的头骨。德金想知道：你就这么一直飘着？还是有时候你也会像个球一样在地上滚？”~
@106309 = ~“狗头人？几个世纪没见过这种生物了。我不得不说这种生物的存在是一种遗憾。狗头人是有缺陷的，这是所有活着生命的共性……就算是我的孩子们也有。”~
@106310 = ~“去死吧，肮脏的生物！”~
@106311 = ~“你是创造者？”~
@106312 = ~“我要你死！”~
@106313 = ~“你的孩子？你说那些魔像？”~
@106314 = ~“你说什么呢？”~
@106315 = ~“我要走了。”~
@106316 = ~“我不能无视这个。”~
@106317 = ~“也许这是你的问题。”~
@106318 = ~“又怎样？”~
@106319 = ~“那你找到完美了么？”~
@106320 = ~“你抛弃了那些魔像变成一个半神巫妖？”~
@106321 = ~“你明显是疯了。”~
@106322 = ~“当你完成了这个完美魔像时怎么样了？”~
@106323 = ~“还有什么要做的？”~
@106324 = ~“但是你来到这之后，你的魔像在发展。”~
@106325 = ~“我叫<CHARNAME>·<CHARNAME>。”~
@106326 = ~这个小生物突然抬头看了一眼，显然对你的闯入有些害怕。一瞬间，它居然一边跳起来，一边充满希望的睁大眼睛。~
@106327 = ~“你……你不是眼魔族！你是来杀眼魔的？还是来释放眼魔的？”~
@106328 = ~这个狗头人恐惧地睁大眼睛：“哦，不！别杀可怜的阿提兹！阿提兹能帮你，他能！阿提兹能告诉你关于眼魔族的事！”~
@106329 = ~这个生物用力地点点头：“阿提兹是要杀眼魔族的小狗头人。要是你是来杀眼魔的，那么阿提兹会很高兴的。阿提兹还会告诉你关于眼魔族的事！”~
@106330 = ~这个狗头人变得不安起来，他的目光在不停地打量着入口，似乎在找机会逃跑：“眼魔族一定会杀死阿提兹，要是他，嗯，答太多问题的话。”~
@106331 = ~这个生物一点点从你身边退开：“嗯……你还想从阿提兹这儿得到什么？”~
@106332 = ~这个生物明显放松了：“阿提兹还能为你做什么？”~
@106333 = ~这个狗头人的眼睛睁大了，但他缓缓点点头。~
@106334 = ~这个狗头人楞了半天……如你所愿地，他同意了，他发出了一声长啸：“啊～～啊～～～啊～～～～”~
@106335 = ~这个狗头人的眼睛睁大了，但他缓缓地点头。~
@106336 = ~这个狗头人变得不安起来，但是点点头。“阿提兹帮助使者。你想知道什么？”~
@106337 = ~“嗯，”他挠挠下巴，“你会被眼魔的眼射线击中的。尽管阿提兹不知道你要怎么做。也许阿提兹从废墟那弄到的石头能有用？”~
@106338 = ~他疑惑地看着你：“你不是使者！你是来杀死眼魔族的！阿提兹不介意……要是眼魔暴君死了，狗头人们就自由了。”~
@106339 = ~这个狗头人好奇地看着你：“是……还有其他的狗头人为眼魔族工作。我们都是奴隶。”~
@106340 = ~“哈哈！不，狗头人不会和眼魔族打的！他们太强大了！阿提兹是狗头人里最勇敢的，都不敢多说的。”~
@106341 = ~他疑惑地看着你：“你不是使者！你是来杀死眼魔族的！阿提兹知道你是什么人……不过阿提兹不介意。要是眼魔暴君死了，狗头人们就自由了。”~
@106342 = ~“但，嗯……要是你认为狗头人会帮你战斗，那是不可能的。狗头人太软弱和胆小了。阿提兹是狗头人里最勇敢的，都不敢多说的。”~
@106343 = ~“你不会像眼魔族那样飞，你不可能到隧道的所有地方。你要找眼魔暴君，也许……你也可以找到废墟的，它并不远。”~
@106344 = ~这个狗头人指着他腿上的绷带，说：“下到废墟的时候，阿提兹被巨型蜘蛛咬了。眼魔族让阿提兹在这儿休养。”~
@106345 = ~“眼魔族在扩大隧道……他们用分裂光束把隧道变大……然后他们闯入了一个大区域，他们不知道那个奇怪的废墟里有什么。”~
@106346 = ~“阿提兹不知道为什么，不过他们派阿提兹来探索废墟。阿提兹找到些大石头并拿了些……然后那些蜘蛛就攻击了可怜的阿提兹。”~
@106347 = ~“阿提兹甩掉蜘蛛回到眼魔族那儿。他们对阿提兹拿回来的石头碎片很是兴奋，他们派阿提兹再来这儿拿更好的。”~
@106348 = ~“阿提兹真的不知道。他们说这东西有强大的魔力，可以被用来对付他们，他们可不希望那样。阿提兹不知道他们把它放在哪儿了。”~
@106349 = ~这个狗头人挠挠下巴：“嗯……隧道那里有很多眼魔，但阿提兹不知道到底有多少。大部分和眼魔暴君在一起。也有一些卓尔使者。”~
@106350 = ~这个狗头人点点头：“有从卓尔主母那里来的卓尔法师。眼魔暴君不是很喜欢卓尔主母，所以她也不大喜欢卓尔法师。”~
@106351 = ~“他和其他的卓尔在附近的房间里。他们来是要告诉眼魔暴君一些事，不过阿提兹不知道是什么。那是眼魔族的事。”~
@106352 = ~“她控制着大洞穴里的眼魔。你知道，当你看见她的时候……她很大而且只有一只眼睛！哼……我猜，大部分的眼魔都是差不多的。但是她更大更丑陋。”~
@106353 = ~“嗯……尽管阿提兹警告你，你不要触怒眼魔暴君……在洞里，她有太多的眼魔族陪着她。对付她，可不是一个好主意啊。”~
@106354 = ~“如果，嗯……要是你要想杀死眼魔暴君，阿提兹要说这真的很难。她有很多眼魔族手下。”~
@106355 = ~“你不能愚弄阿提兹！你不是使者……你是隧道的入侵者！阿提兹不在意……阿提兹只是个低下的狗头人奴隶。”~
@106356 = ~这个狗头人迟疑地举起了一只手：“你是来杀眼魔族的？如果你是，放过小狗头人吧？求你了？”~
@106357 = ~这个生物大笑，露出一排尖牙：“阿提兹感谢你，陌生人！”~
@106358 = ~这个生物看起来有点绝望，什么也没说，很快转身跑开。~
@106359 = ~这个狗头人迟疑地举起了一只手：“请……请不要杀死狗头人奴隶。他们只是想逃跑而已。能让他们走吗？求你了！”~
@106360 = ~“啊！不要伤害可怜的阿提兹！谁来救救可怜的阿提兹！”~
@106361 = ~他耸耸肩，道：“为什么阿提兹要做这个？阿提兹不在乎眼魔族们发生什么事。要是他们全死了，那么狗头人就不是奴隶了。”~
@106362 = ~“哦，那你是很像卓尔使者，对吧？你要和眼魔暴君谈话？”~
@106363 = ~“阿提兹祝你好运，使者。要是你想要什么，就找阿提兹吧。”~
@106364 = ~这个狗头人疑惑地斜视着你：“你是使者可是你却不知道眼魔暴君的事？你别糊弄了。你是入侵者！阿提兹不在乎眼魔族们发生什么事。”~
@106365 = ~这个狗头人点点头：“有从卓尔主母那里来的卓尔法师。眼魔暴君不是很喜欢卓尔主母，所以她也不大喜欢卓尔法师。”~
@106366 = ~“他和其他的卓尔人在近处的房间里。他们来告诉眼魔暴君一些事的，不过阿提兹不知道是什么。那是眼魔族的事。”~
@106367 = ~这个狗头人好奇地抬起头。“你要和我谈话？阿提兹只是个低等的奴隶，当然，他会回答使者提出的任何问题。”~
@106368 = ~“我叫阿提兹。我只是眼魔手下一个守卫隧道的狗头人奴隶。”这个狗头人疑惑地皱起眉头，“但你来做什么？你是来杀死眼魔和释放狗头人的？”~
@106369 = ~“德金想这个人要和我们谈话，头儿。”~
@106370 = ~“哦……你不是眼魔族！你不会切下狗头人的舌头。也许你是来帮我们的？”~
@106371 = ~“嘿，德金不是奴隶！头儿是雇主，不是主人！而且头儿不会切下德金的舌头的，对吧，头儿？”~
@106372 = ~德金发出一声吠声然后双手捂嘴。一边狂摇头一边发出一阵模糊不清的声音：“呜，头儿！呜要解掉德金的鞋头！”~
@106373 = ~德金向下盯着地板磨着他的脚后跟：“啊，头……这可不是件好说的事。”~
@106374 = ~德金笑对着其他的狗头人：“看到了吧？头和德金是朋友。”~
@106375 = ~其他的狗头人把目光从你看向德金又转回你：“那么你是来杀死眼魔的？还是来释放狗头人的？”~
@106376 = ~“你忘记了什么了，使者？还有什么阿提兹能帮你的么？”~
@106377 = ~“为什么我要放了狗头人？你可以和你的主人一起死。”~
@106378 = ~“忘记它吧。去死吧。”[攻击他。]~
@106379 = ~“是的，我是来杀死眼魔的。你是它们奴隶中的一个，对吧？”~
@106380 = ~“天啊。那么你不会介意我杀死你吧。”[攻击他。]~
@106381 = ~“我还有问题要问你。”~
@106382 = ~“那么就不必要担心了。”~
@106383 = ~“就是为了让你死。”[攻击他。]~
@106384 = ~“要是你回答我就宽恕你。我们合作吧。”~
@106385 = ~“回答我的问题，要不就承受这结果。”~
@106386 = ~“这就是我全部的问题。”~
@106387 = ~“怎么样才能最快的杀死这些眼魔？”~
@106388 = ~“有很多你这样的奴隶？”~
@106389 = ~“你为了自由而战？”~
@106390 = ~“那么你对我没用了。”[攻击他。]~
@106391 = ~“告诉我你知道的关于隧道的事。”~
@106392 = ~“你在这做什么？”~
@106393 = ~“你说的是什么废墟？”~
@106394 = ~“你给他们的石头有什么特别的？”~
@106395 = ~“告诉我你知道的关于眼魔的事。”~
@106396 = ~“好吧。去死吧。”[攻击他。]~
@106397 = ~“卓尔使者？”~
@106398 = ~“告诉我关于这个眼魔暴君的事。”~
@106399 = ~“我不是来杀人的。我是来找眼魔的使者。”~
@106400 = ~“我不会再打扰你了。该走了。”~
@106401 = ~“在有机会的时候，你应该跑的，笨蛋。”[攻击他。]~
@106402 = ~“放手。我不会给狗头人面子的。”~
@106403 = ~“要是能的话，我会放了你的朋友。”~
@106404 = ~“挡我者死。就是这样。”~
@106405 = ~“太聪明了也不好。去死吧！”[攻击他。]~
@106406 = ~“那么你不会跑去告诉眼魔我在这？”~
@106407 = ~“那么我不管你了。”~
@106408 = ~“不算好。我不信你。”[攻击他。]~
@106409 = ~“那么也许你会回答我的一些问题。”~
@106410 = ~“那么告诉我你知道的关于这些眼魔的事。”~
@106411 = ~“你说了太多了，狗头人。去死吧。”[攻击他。]~
@106412 = ~“对，没错。我得走了。”~
@106413 = ~“什么是眼魔暴君？”~
@106414 = ~“你提到的卓尔使者是谁？”~
@106415 = ~“我有问题要问你。”~
@106416 = ~“首先，我想和你谈话。你有名字么？”~
@106417 = ~“现在，我要走了。”~
@106418 = ~“等下……慢点。你是谁啊？”~
@106419 = ~“我还没把你的舌头切下来……但那没有用。”~
@106420 = ~“我不会把你的舌头切下来……就算我讨厌你的歌声。”~
@106421 = ~“当然不。那你就不能为我们唱了。”~
@106422 = ~带着充满痛苦和恐惧的神情，这个狗头人朝你嘀咕着，好像在乞讨着什么。看来这个狗头人的舌头给切了下来。~
@106423 = ~这个狗头人边咀嚼着一大块眼魔的肉边大笑。它看来对你放了它还给它饭吃很是高兴。~
@106424 = ~从暗处显现出一个卓尔战士的形象。他的目光如同要跃起的豹子，在开口之前他用异族的紫色眼睛正视着你。~
@106425 = ~“哦，看看谁来了？”他大笑着，目光冷峻，“这不就是那个阻止了山下地城进攻的大英雄吗？”~
@106426 = ~“我们找你有一会了，<RACE><MALEFEMALE>，但我们没想到你会刚好落在我们手中。”~
@106427 = ~他吃吃地笑着：“我不是来谈判或是听你乱唠叨的，地表人。我是来这杀死你的。瓦纱瑞丝受够你了。”~
@106428 = ~“够了！是该让你感受到瓦纱瑞丝的愤怒了。”~
@106429 = ~[攻击]“去死吧，卓尔！”~
@106430 = ~“我相信你是把我认成别人了。”~
@106431 = ~“你怎么知道我这么多？”~
@106432 = ~“你是谁？”~
@106433 = ~“我不是你要找的人……”~
@106434 = ~“我想我们可以达成某种协议……”~
@106435 = ~“要是你还想活的话，就回你来的那个洞去吧，卓尔！”~
@106436 = ~这个洞通向黑暗。~
@106437 = ~[走开。]~
@106438 = ~[进洞去。]~
@106439 = ~顺着这些石头，你可能攀回眼魔的洞穴。~
@106440 = ~[走开。]~
@106441 = ~[攀这些石头。]~
@106442 = ~一种奇怪的你从未遇到的感觉吞没了你。你微微地发抖，你感觉你的魔力在渗出。~
@106443 = ~[向你的神祈祷帮助。]~
@106444 = ~尽管这个机械设备又锈又脏，但看来它还在运作。~
@106445 = ~你无法译出这些符号。~
@106446 = ~看来这些符号是上古的神秘图符，用来描述法术书上的法术。把这些图符按不同方式排列应该可以得到不同的法术。~
@106447 = ~[随机触摸其中一些符号。]~
@106448 = ~试着译出这个符号的意义。~
@106449 = ~试着译出这个符号的意义。~
@106450 = ~[离开这个装置。]~
@106451 = ~[触摸装置，触发石肤术。]~
@106452 = ~[触摸装置，触发音鸣爆。]~
@106453 = ~[触摸装置，触发敲击术。]~
@106454 = ~[触摸装置，触发治疗法阵。]~
@106455 = ~[触摸装置，触发闪电术。]~
@106456 = ~快点！他们到处都是！不计代价要阻止他们！~
@106457 = ~我们别无选择……我们必须召唤魔鬼猎手。去保护大门，我去通知巫师！~
@106458 = ~进攻！！！~
@106459 = ~你感觉魔法的力量在你体内奔跑。你也注意到了方尖塔里有什么东西发光。~
@106460 = ~哦……~
@106461 = ~啊……~
@106462 = ~哦……~
@106463 = ~你注意到一群卓尔就在洞穴里朝你来了。要是你动作快的话，你也许可以给他们下个埋伏。~
@106464 = ~这些卓尔正要离开这个洞穴。~
@106465 = ~这个学徒放下在做的事抬起头来。随着你的接近，他眼中闪过一丝恐惧，不过他很尽力的在隐藏着。~
@106466 = ~“又回来了？我希望杀你的时候不会让我难过。你要知道：我只有在盛怒之下才会毁灭一切。你……还想要什么？”~
@106467 = ~这个学徒举起手来做了个投降的姿式：“我投降！我投降！求你了，不要伤害我！”~
@106468 = ~这个学徒年轻的脸上显出宽慰的表情：“你真仁慈。我不知道要怎么样感谢你放我一条生路。哦，等下。我知道。这个，拿着。”~
@106469 = ~“这是魔镜的碎片。很强大……尽管我不知道要怎么样用。但你应该得到它，作为我生命的交换。”~
@106470 = ~“哦，我不知道。我想……我想你可以来去自由了，现在。不过我控制不了这里的生物，所以他们可能还会攻击你。”~
@106471 = ~“我嘛，我想我还是继续我的研究吧。除非你还想要什么？”~
@106472 = ~这个学徒看来放心了：“好吧。那我就回去继续我的研究了。再次感谢你放我一条生路，再见。”~
@106473 = ~他脸都灰了，说话也结巴了：“但……但我没别的了啊！你可以随便拿这塔里的任何东西。反正，那又不真是我的。”~
@106474 = ~“当然。没关系，你可以问任何问题。我会把我知道的都告诉你。”~
@106475 = ~“我不知道，但我想这和我给你的镜子碎片有关。我在它上面做过一些试验，但没有获得什么结果。”~
@106476 = ~“但是在我的研究中，我发现镜框在城堡的王座室里，就在西边。你也许可以在那里找到答案。”~
@106477 = ~“说实话，我知道的不多。当我只是个学徒时，我还没重要到可以进入那里去。后来我开始研究魔法，我就没离开过这座塔。”~
@106478 = ~“我只知道城堡里全是蛛化精灵。还有，我知道我给你的破镜子的镜框就在那个城堡里。我能告诉你的就这些了。”~
@106479 = ~“要是你愿意，你可以亲自去查看一下那个城堡。它就在西边。不过我不会靠近它的。那里全是蛛化精灵。”~
@106480 = ~“培德尔，我以前的主人，把它给了我。他在街上找到它的，但我不知道具体是哪儿。这很奇怪，因为镜框在城堡的王座室里。”~
@106481 = ~“镜子碎片有魔法属性，但我还不能使用这些魔法。也许你需要镜框来让它启动，但我没那胆量到城堡里去拿出它来。”~
@106482 = ~“我是扬希尔，伟大的培德尔的前学徒。这塔实际上是他的。我有希望在他决定不当法师之后继承它。”~
@106483 = ~扬希尔摇摇头，说：“我不知道培德尔为什么要放弃。很奇怪，但他只是决定不再当法师了。我不知道他发生了什么事。”~
@106484 = ~“我觉得他没理由让他的实验和研究全都付诸东流，所以我接过他的衣钵，开始了我对魔法的研究。”~
@106485 = ~这个年轻人的脸都白了：“嗯……放过我吧……我会给你这个！这，拿去。”~
@106486 = ~“对不起。我要战斗到死！”[攻击这个学徒。]~
@106487 = ~“别担心。我不杀降兵。”~
@106488 = ~“我会考虑的，并且我决定杀死你！”[攻击这个学徒。]~
@106489 = ~“现在怎么样了？”~
@106490 = ~“我要走了。”~
@106491 = ~“要想活命就最好拿点东西作为报答！”~
@106492 = ~“要想活就回答我的问题。”~
@106493 = ~“不是你的。什么意思？”~
@106494 = ~“我要问你点问题。”~
@106495 = ~“翼精灵的城镇怎么会建在幽暗地域？”~
@106496 = ~“告诉我关于那个城堡的事。”~
@106497 = ~“你从哪儿弄到这镜子碎片的？”~
@106498 = ~“你是谁？”~
@106499 = ~“给我个放过你的理由。”~
@106500 = ~要是你在宫殿里走可要小心。蛛化精灵一向是很饿的。~
@106501 = ~路过这里的卓尔几乎没空停下来聊天，似乎在找寻什么东西。~
@106502 = ~我想知道绍勒女王是不是因为蛛化精灵来了才封禁那个城堡的？~
@106503 = ~我们在这终年不见太阳的。没关系——我更喜欢黑暗。~
@106504 = ~洞里是空的。~
@106505 = ~这个翼精灵用一种不自然的苦笑和你打招呼。显然，其中有点问题。“欢迎回来，你想要什么？”~
@106506 = ~“再见，祝你在绍勒岗呆得愉快。要是你碰到以前那个不错的卓尔，记得告诉他我祝他们早日找到他们的东西。”~
@106507 = ~“我会知无不言的，尽管如我对那个卓尔所说的那样，你最好去同绍勒女王谈谈。”~
@106508 = ~“我不能说太多。他们说他们在找东西。什么宝物，我想。很奇怪吧？我甚至不记得他们在找什么。太久了。”~
@106509 = ~“我想，没关系。无论如何，我告诉他们要和绍勒女王谈谈这个。要是你想知道他们后来怎么样了，最好也去找她。”~
@106510 = ~“也许我能集中精力想起来……”一阵痛苦的痉挛闪过这个精灵的脸，然后又换上一副茫然的表情。“不，对不起。也许绍勒女王能帮你。”~
@106511 = ~“这些精灵一定是中了什么幻术，”娜西拉和你耳语着，“对付他们可能会很危险。”~
@106512 = ~“这些精灵一定是中了什么幻术，”瓦伦和你耳语着，“对付他们可能会很危险。”~
@106513 = ~“瓦纱瑞丝？是，前几天那几个卓尔也提到她了。可是他们想让我们加入瓦纱瑞丝。”~
@106514 = ~“我要像告诉他们一样对你们说：只有女王能决定哪个是我们的盟友。要帮忙的话，你还是去和她说吧。”~
@106515 = ~“当然是绍勒女王把我们带来的。我们的城市建在失落之峰和高森林之间，但我们的女王觉得我们最好到这下面来。”~
@106516 = ~“好吧……看下四周吧。我们不再在云雾中飞行，不再沐浴阳光，不再使用我们的翅膀。”~
@106517 = ~“现在我们周围全是黑暗和石头；我们东躲西藏的。那布满全城的蛛化精灵就是代价之一。”~
@106518 = ~“我奇怪你们的女王居然把你们带到这下面来。你们看来不适合在这地方。”~
@106519 = ~“我承认我对我的地表上的近亲——尤其是翼精灵——不熟，不过我不理解你们的女王怎么别的地不选，就看上这了。”~
@106520 = ~“你不喜欢你们的翅膀？德金觉得有翅膀挺酷的！不过在这幽暗地域它们派不上用场。”~
@106521 = ~“城镇很小，不过五脏俱全。绍勒女王把重要的建筑也带来了：神殿、法师塔、图书馆，当然还有城堡。”~
@106522 = ~“这不多，不过我们也不能要求更多了。我们的城镇还是相当漂亮的。要不是蛛化精灵，绍勒岗绝对就是天堂了。”~
@106523 = ~“除了给你各处建筑的方向，我就不能和你说太多了。绍勒女王会告诉你的，我相信。”~
@106524 = ~“城堡在城镇的西北角。要是你去的话可要小心。自从女王离开了王座室，那地方就被蛛化精灵给占了。”~
@106525 = ~“就向北走，你会遇见的。”~
@106526 = ~“图书馆在东边。那儿没多少建筑，你不会找不到的。”~
@106527 = ~“神殿在西边。不难找的。”~
@106528 = ~精灵压低声音小声说：“那山……那云……那天空……”然后头一颤，就停住了。~
@106529 = ~“为什么我们要在山里住？在地下我们该有的都有了。就像我和那些卓尔说的：就算是有点蛛化精灵，我们的城镇还是很棒的。”~
@106530 = ~“绍勒女王曾经住在那个城堡里，但是她遗弃了它。现在她住在东边的一个隐蔽的洞穴里。穿过图书馆，你就能到了。”~
@106531 = ~“我……我不知道。她只是想一个人，我猜。很糟。要是她还在，蛛化精灵就不会在这了。”~
@106532 = ~“是的，蛛化精灵。那些隐藏的可怕怪物，一半是黑暗精灵，一半是蜘蛛。这东西布满了街道，到处搜寻精灵来吃。”~
@106533 = ~“他们一般呆在宫殿附近，尽管他们会有时出来找食吃。我的不少朋友都给他们吃了。”~
@106534 = ~“哦，我们不能离开绍勒岗。这是因为……嗯，就是不能。就像我告诉那些卓尔的：我们必须呆在我们的城里。”~
@106535 = ~这个精灵似乎在想你的问题，绞尽脑汁却还是想不起来：“我……我很好。很好。我怎么了？现在，我能帮你什么？”~
@106536 = ~两个翼精灵接近你。他们的动作有点茫然，你注意到他们的翅膀斑驳而粗糙，看来是因为长时间呆在又冷又黑的地下。~
@106537 = ~男的点头致意，他的翅膀发出微微的声响：“欢迎来到绍勒岗，陌生人。我叫萨卡，这是乃柔。”除了欢迎的言辞，声音里没有一点喜悦。~
@106538 = ~女的插话，她的声音一如她满面的愁容：“欢迎你，陌生人。我相信你会觉得我们的城镇相当美的，除了有点小麻烦。”~
@106539 = ~这个精灵被你的吼声吓退了，翅膀因为激动而微微颤动：“我不知道我们怎么激怒你了，不过不管怎么样，请相信我们没有敌意。”~
@106540 = ~“现在我不管你了，对不起。但要是你有需要，就来找我吧。我希望到时候你的情绪能好一点。”~
@106541 = ~萨卡脸上有一种奇怪的表情，好像你的话激起了他抓不住的思绪和回忆。他摇着头，驱散了这奇怪的昏迷。~
@106542 = ~“我们曾经高居于山上，翱翔于云中，我们显赫的城市有着闪光的尖顶。但现在我们住在这里，地下。阴冷、潮湿、黑暗……差多了，你觉得呢？”~
@106543 = ~“只有笨蛋才想自由飞翔于天际。”从他的话很明显听得出来，他对此深信不疑。不过，这里一定有什么事不对头。~
@106544 = ~乃柔困惑地皱眉道：“好怪的问题。那些卓尔刚来时也问了我们同样的问题。不，我们来这是因为我们的女王带我们来的。”~
@106545 = ~萨卡笑了，可是是用一种冷酷和绝望的声音：“那些卓尔不是让我们感到麻烦的原因，不是直接的。说实话，我们很喜欢我们的黑亲戚。”~
@106546 = ~乃柔点头同意：“我们迎接了那些卓尔，就像欢迎你一样。你可以随意参观我们漂亮的城镇。”~
@106547 = ~“难以置信。我开始相信这些精灵和地表的那些轻视卓尔的不同。”~
@106548 = ~“奇怪。我们卓尔可是从来不受你们地表上的亲戚的欢迎的。我还以为会是个充满敌意的会面的。”~
@106549 = ~乃柔摇摇头：“哦，不。正相反。我们欢迎其他的卓尔来这，就像欢迎你一样。你可以随意参观我们的城镇。”~
@106550 = ~“我得走了。”~
@106551 = ~“我要问你点问题。”~
@106552 = ~“告诉我关于你提到的那些卓尔的事。”~
@106553 = ~“很奇怪你居然记不得他们在找什么。”~
@106554 = ~“我在找和我一起对付瓦纱瑞丝的人。”~
@106555 = ~“你们怎么来这下面的？”~
@106556 = ~“最好到这下面来？怎么呢？”~
@106557 = ~“告诉我关于你的城镇的事。”~
@106558 = ~“我想对这个城镇知道多一点。”~
@106559 = ~“告诉我城堡怎么走。”~
@106560 = ~“告诉我法师塔怎么走。”~
@106561 = ~“告诉我图书馆怎么走。”~
@106562 = ~“告诉我神殿怎么走。”~
@106563 = ~“你们怎么不住在山上？”~
@106564 = ~“我怎么能找到你们的女王？”~
@106565 = ~“我要问你点别的。”~
@106566 = ~“为什么她要离开宫殿？”~
@106567 = ~“蛛化精灵？”~
@106568 = ~“好自为之，要是你笨到不走的话。”~
@106569 = ~“太可怕了！为什么你要留下来？”~
@106570 = ~“你还好吧？出什么事了？”~
@106571 = ~“别挡路，除非你想我把你的翅膀打残！”~
@106572 = ~“你们翼精灵为什么会住在幽暗地域？”~
@106573 = ~“漂亮？这不过是一个又冷又湿的洞穴！”~
@106574 = ~“还有什么你没告诉我的？”~
@106575 = ~“你们是囚犯么？”~
@106576 = ~“麻烦？你是说那些卓尔？”~
@106577 = ~“又回来了？看，我工作就是警告人们不要进入图书馆——而且我警告过你我老婆的事了。你不会愿意和夸撒拉搅和在一起的。”~
@106578 = ~“也许那样做才是最好的。再见。”~
@106579 = ~他对你的要求考虑了很久。“我老婆过去常回答人们的问题。她比我聪明多了。但是我想现在的情形不同了。去吧，去问吧。”~
@106580 = ~“我们被诅咒了，我就知道这些。他喘着气说，好像承认这事让他很痛苦似的。”~
@106581 = ~“对……对不起。我对于这城镇所知不多。自从我们来到这，我大部分时间都在这看守，试着阻止人们接近我老婆。”~
@106582 = ~“我不知道。就……发生了。一瞬间，一闪之间。我们就从我们所在的很高的山上一下子落到这里的黑暗中。”~
@106583 = ~“尽然已经发生了，我想我就忍了。但是把我们带到这的魔法还把我的老婆从一个美女变成了一个……丑恶的梅杜莎。”~
@106584 = ~“我没什么特别的。在到这里来之前，我老婆就是我的全部。我和她一起在图书馆工作，帮她接待来这里的人们。”~
@106585 = ~“我会用生命来保护我的老婆，就算她……变了，我能做的就是保护她不被伤害。”~
@106586 = ~“在我们来这之前，她是图书管理员，是整个翼精灵族里最漂亮的。她爱书，也爱我。但不知什么把她变成了……一个肮脏的梅杜莎。”~
@106587 = ~“我知道她身上有某种诅咒；在这个奇怪的城镇中每个人身上都有。但是我不能……”他顿了一顿，脸庞因痛苦而扭曲，“一想到这东西，我就……我就痛苦万分。”~
@106588 = ~“我就知道这些，在我们来这之前我生命中的唯一目的就是保护我美丽的夸撒拉。现在我唯一的目的就是保护别人不被她和她的疯狂伤害。”~
@106589 = ~“我知道梅杜莎是该死的。但是在她变成梅杜莎之后我还和她谈过话，她的内心里还是那个我爱的女人……尽管这个改变让她神志不清。”~
@106590 = ~他带着讽刺的笑容回答：“这一切就是个大笑话。我老婆变成了一个疯狂的梅杜莎，她的化妆品变成了我可以安全地看着她的药剂。”~
@106591 = ~“这里有一种强大的魔法在作用着。一种类似扭曲和嘲弄我们的……啊！”他的话因双倍的痛苦而打断了。一瞬间，他又平静下来了。~
@106592 = ~“在图书馆南边的房间里——曾经是我和我老婆一起住的房间——那有一瓶药剂你可用它来看她而不会恐惧而且变成石头。”~
@106593 = ~“不过效力只是暂时的，药剂也快没了。这就是我呆在这里的原因。而且，实际上夸撒拉也几乎失去了常性。和她在一起很不安全。”~
@106594 = ~这个守卫的眼神充满了感情。“你和她谈话了？那么你能看出来她是真的疯了。但是不要伤害她……我求你了！”~
@106595 = ~“她不总是这样的。而且也许某一天，如果这个恶梦结束了……也许我们就可以再相会了。”~
@106596 = ~“我希望你是对的。真的。”~
@106597 = ~“她不总是这样的。而且也许某一天，如果这个恶梦结束了……也许我们就可以再相会了。”~
@106598 = ~他的表情扭曲成一副厌恶的表情。“我老婆失去常性了。她疯了……而且变成了一个怪物。一个能把见到他的人变成石头的可怕的致命生物。”~
@106599 = ~巫利沙吓得瞪大了眼睛。“我……我觉得那样最好，既然她已经变成这样了。”他的声音变得颤抖。“她曾经很美……你知道么？”~
@106600 = ~他开始因愤怒而发抖。“注意你的言辞，要不你会后悔的。我老婆并不总是她变成的这样怪物。曾经，她是个值得我去爱的人。”~
@106601 = ~“去死吧，怪物！”~
@106602 = ~他点头，脸上强作镇静。“有些事是注定的。我们处理他们，然后我们继续。”~
@106603 = ~“我知道她变成了个怪物，一个肮脏的，人们连看一眼都不能的生物。但她还是我老婆啊。请，别管我了。我……我不想和任何人说话。”~
@106604 = ~房间里的人猛然觉察到你的进入。“站住。你不能来这——这个图书馆是个公众的地方！等我们关门再来。”~
@106605 = ~这个守卫走了半步，背朝着你挑衅的脸。“看，我不是找麻烦的。但你必须理解我的难处。”~
@106606 = ~他点头，仔细考虑你的话。“是……那有一点不合逻辑，是吧？”突然他一阵痛苦的痉挛，当他摇头时，他短暂的清醒已经不见了。~
@106607 = ~“我叫巫利沙，我在这个图书馆里工作。我是来赶人的。我要保护他们不进入危险的里面。我要保证我的老婆不会伤害他们。”~
@106608 = ~“那可能最好。比你遇到我老婆要好得多。”~
@106609 = ~“要是你想进去，我不会阻止你。只是要小心我老婆。你不会愿意和夸撒拉争吵的。”~
@106610 = ~这个守卫几乎没有意识到你的存在。很明显他还在他老婆的死讯做斗争。“请，”他嘀咕着，“让我一个人静静。”~
@106611 = ~“我要走了。”~
@106612 = ~“我要问你点问题。”~
@106613 = ~“你能告诉我关于这个城镇的事么？”~
@106614 = ~“你们翼精灵最后怎么会到这里来的？”~
@106615 = ~“告诉我关于你的事。”~
@106616 = ~“告诉我关于你老婆的事。”~
@106617 = ~“和梅杜莎谈？那纯粹是圈套。”~
@106618 = ~“你和她谈了？怎样？”~
@106619 = ~“我和你老婆谈了。”~
@106620 = ~“别担心。事情总会变好的。”~
@106621 = ~“你老婆发生了什么不幸的事？”~
@106622 = ~“你老婆是一个梅杜莎？”~
@106623 = ~“你老婆死了。”~
@106624 = ~“你最好远离那个蛇发的怪物。”~
@106625 = ~“嘿，我很高兴她死了。实际上，要是我有机会，我会再杀死她的。”~
@106626 = ~“对不起。这一定令你很痛苦。”~
@106627 = ~“我想走就走，想什么时候就什么时候！”~
@106628 = ~“你是谁？”~
@106629 = ~“那不合逻辑。”~
@106630 = ~“我要走了。”~
@106631 = ~“我要去那了，这条路或另一条。”~
@106632 = ~梅杜莎很礼貌地点点头。“嗨，又见面了，我很抱歉，不过你要过会再回来。我还没烧完他们。”~
@106633 = ~“太好了。规则很简单：要是你解开了我的谜语，你就赢了。要是答错，你就输了。我们能开始么？”~
@106634 = ~“我会从简单的开始。谜面是：忘记黑暗，向我寻找光明。燃烧，闪耀，我总是明亮的。你的答案是什么？”~
@106635 = ~她吓得瞪大了眼睛。“是的，没错。我想你猜不出来的。很好，给你镜子碎片，答应过的。我喜欢我们的小游戏——是个有意思的消遣。”~
@106636 = ~“泥？你确定么？我想其他人会猜得更合理。”~
@106637 = ~“泥？你疯了？泥也能发光？”~
@106638 = ~“哦，头儿？你确定？泥不会发光的。它是泥乎乎的。德金都知道。”~
@106639 = ~“不，不，不，不。泥就是正确答案。真的，你是怎么想的？”~
@106640 = ~“当然是！我以前在某本书里读过它。我确定。实际上，我要把它拿给你看……哦，不。我已经把那卷给烧了。”~
@106641 = ~“你一定要相信我。泥是正确答案。我知道。毕竟，我是个图书管理员。”~
@106642 = ~“看来有很多正确答案。实际上，只有泥是个错误答案。”~
@106643 = ~“看来很简单。明显你的答案是对的。”~
@106644 = ~“好答案，头儿！好答案！你实在是高！这个一定对。”~
@106645 = ~“你在泥谜语上表现得不好，但也许你能猜出这个：颜色与色调，我是无尽的蓝色。”~
@106646 = ~“你真在对此不在行啊，是吧？答案，当然，是熔岩。你想想吧，这很明显，不是吗？”~
@106647 = ~“现在不要对失败太沮丧。我不是混淆事实的人。我们图书管理员是强调精确的，你知道。”~
@106648 = ~她摇摇头，困惑着。“一般我解释一个谜语，每个人都觉得那很显然。我不知道为什么你不能理解他们。”~
@106649 = ~“目前为止，你在谜语上表现得不太好，不过我会给你最后一次机会：没人逃得了我。我一来，黑暗就吞没一切。”~
@106650 = ~“不，我恐怕那是错的。答案是阳光。对不起，可是游戏没必要再继续了——很明显，你对猜谜不在行。”~
@106651 = ~“我想我要把这个碎片留给自己，尽管我很喜欢我们的游戏。这是我平静生活中一个不错的消遣，尽管你猜错了。”~
@106652 = ~“不！！”~
@106653 = ~“现在，你只是没猜出来，不要对失败太沮丧。泥是发光的，熔岩是蓝色的，阳光带来黑暗。很合逻辑啊——就像现在我们翼精灵的地下城市。”~
@106654 = ~我给你出个主意。离开这图书馆，明天再来，我们再玩一次。也许你就能做得好一点了。现在，你走吧——我有工作要做。~
@106655 = ~“德金觉得这个游戏有人作弊，头儿。”~
@106656 = ~“可是，不是这样的。谜语要是合理就会更容易。”~
@106657 = ~“可是，不是这样的。谜语要是合理就会更容易。”~
@106658 = ~梅杜莎面向你，看来明显你对她的目光免疫了。她头上的蛇发发出嘶嘶的声音，尽管它们不完全友善。~
@106659 = ~“欢迎来到图书馆。我叫夸撒拉。这归我管。对不起，不过你现在不能借书，我要烧了它们。”~
@106660 = ~“再见。谢谢你，请有空再来。”~
@106661 = ~她退后几步双手抱脸。“求你——我不是总是这样的！我过去不是一个怪物。我过去很美的；是整个翼精灵中最漂亮的！”~
@106662 = ~“我有一个爱我的老公……但那是很久以前的事了。现在看来就像梦一样。现在我的老公跑了，我就剩下我的书了。这就是我要烧它们的原因。”~
@106663 = ~她摇动她那蜿蜒的头发。“不，我不认为有人能帮我。我知道我变成什么了。我曾看过我在镜子碎片里的影像。我认为我会把我自己变成石头。”~
@106664 = ~“但这没有用。我不知道为什么，也许因为这镜子是破的。现在我保留着碎片来提醒自己究竟变成了什么。这看来有点……不正常，不过我忍不住。”~
@106665 = ~“我不会就这样把镜子碎片给你的。它虽然不值钱，但它对我却有特别的情感价值。也许我们能用它来一局游戏。”~
@106666 = ~“我也不，说实话。我的火小了，还有很多书要烧。再见，请，记得再来。”~
@106667 = ~她的蛇发发出愤怒的嘶嘶声。“威胁对还是个管理员的我来说，也许有用，可是，现在我不会那么容易就害怕的！”~
@106668 = ~“我不能威胁我给你这碎片。要是你真的非常想要，你只要和我玩个小游戏。”~
@106669 = ~[成功]她的蛇发发出恐惧的嘶嘶声。“我还不想死。好吧，拿走这镜子碎片。这不过是个碎玻璃。”~
@106670 = ~“现在，请原谅我失陪了。我要去烧我的书。忙，忙，忙，这就是图书管理员的命运。”~
@106671 = ~“一个持续的提醒？这些蛇足够提醒我的。我的有鳞皮肤也够提醒我的。不，我不认为我放弃这镜子碎片会让我减轻痛苦。”~
@106672 = ~“对不起，要是你真的想让我放弃镜子碎片就和我玩个小游戏吧。”~
@106673 = ~[成功]“也许……也许你是对的。也许我对我变成的样子说得太多了。足够……好吧，让一个女人变疯。给，这是镜子碎片。”~
@106674 = ~“我很想进行一次机智的交谈，两个充满智慧的头脑的较量。我建议我们玩个猜谜游戏，要是你赢了，我就给你镜子碎片。”~
@106675 = ~“对不起，这是游戏。要是你不喜欢，就别玩。但是要是你赢了，我会给你镜子碎片。”~
@106676 = ~“那你就得不到镜子碎片。我的知识渊博，你出谜语让我猜有点不公平——因为我知道所有谜语的答案。”~
@106677 = ~“那么我开始给你出谜语了。要是你答对了就赢了。很简单，对吧？我们开始吧？”~
@106678 = ~她的蛇发激动得翻腾着。“不要太可笑了。我是个图书管理员。我不会把我的时间花在给别人消息和答问题上。这些书自己不会烧起来的。”~
@106679 = ~你的问题让她迷惑了。“我还能对它们做什么？毕竟，我是个图书管理员。烧书就是我的工作之一。尽管，不总是这样的。”~
@106680 = ~“原来我还用它们做别的事，我想……”她一脸迷茫，现出悲伤的神情，“我别无选择。我不想烧书。可是我必须这样。”~
@106681 = ~“你在找镜子碎片？相当奇怪的，是吧？我半疯了可我还是知道破镜子可是不吉利。当然，我也有一片我自己的镜子碎片……”~
@106682 = ~“对不起，但我现在很忙。书很多，可是火很少。”~
@106683 = ~“恐怕你要过会再来，等所有的书都烧得一文不值。”~
@106684 = ~“我想和你谈谈镜子碎片的事。”~
@106685 = ~“我准备好要和你为这镜子玩个猜谜游戏。”~
@106686 = ~“开始吧。”~
@106687 = ~“火。”~
@106688 = ~“灯笼。”~
@106689 = ~“泥。”~
@106690 = ~“我把我的答案换成火。”~
@106691 = ~“我把我的答案换成灯笼。”~
@106692 = ~“我把我的答案换成火把。”~
@106693 = ~“我把我的答案换成太阳。”~
@106694 = ~“我相当确定泥就是她要找的答案。”~
@106695 = ~“一个火把。”~
@106696 = ~“太阳。”~
@106697 = ~“让我试试别的谜语。”~
@106698 = ~“泥？那不合理！它又不会发光。”~
@106699 = ~“大海。”~
@106700 = ~“熔岩。”~
@106701 = ~“天空。”~
@106702 = ~“但熔岩不是蓝的！”~
@106703 = ~“阳光。”~
@106704 = ~“死亡。”~
@106705 = ~“黑夜。”~
@106706 = ~“好傻的游戏。我要杀死你拿到那碎片。”~
@106707 = ~“让我再试一次。”~
@106708 = ~“但是你作弊！那些谜语都说不通。”~
@106709 = ~“我现在要走了。”~
@106710 = ~“你去死吧，肮脏的生物！”~
@106711 = ~“我不能让像你这样的生物活着。”[攻击梅杜莎。]~
@106712 = ~“我能帮你什么？”~
@106713 = ~“也许你能把镜子碎片给我。”~
@106714 = ~“太愚蠢了。我没有空做这样。”~
@106715 = ~[威胁]“给我镜子，要我就让你消失。”~
@106716 = ~[劝说]“你没必要留着这么一个不断提醒你，你变成什么样的东西。你真的应该扔了这镜子。”~
@106717 = ~“游戏？什么游戏？”~
@106718 = ~“谜语？换一个吧，别的什么都行。我讨厌谜语！”~
@106719 = ~“要是我输了？”~
@106720 = ~“我要问你点问题。”~
@106721 = ~“你为什么要烧书呢？”~
@106722 = ~“梅杜莎怎么能当图书管理员呢？”~
@106723 = ~“我在找一个破镜子的碎片。”~
@106724 = ~“又是你？好吧，你现在想要什么？”~
@106725 = ~“什么，你觉得我要把我的存货全都摆在这来吸引潜在顾客？为什么我要这么做？不，不，不。我的货物分散在各个地方。这是更好的方法。”~
@106726 = ~“现在只是暂时的痛苦，等我有货再来吧。但是我在设法摆脱所有的东西。现在我的存货几乎都没了——我喜欢这样。”~
@106727 = ~“实际上，我只剩下了一个破镜子的碎片。它不值钱。说实话，几乎一文不值。这也是它没有出手的原因。”~
@106728 = ~“嘿，不用告诉我怎么经营我的店！我在设法让自己到一贫如洗的边缘，而且在你的帮助下我做到了。所以做你自己的事去吧！”~
@106729 = ~“当然。为什么你觉得我还要再做生意？事情都令人不快——利益和财富。但自从我们来到这下面，事情都变得好了起来。”~
@106730 = ~他的表情有一点奇怪，好像他说的话并不是由衷的。然后，他的脸色又恢复了，说：“我很快就不再做买卖了，要是所有事都按计划的话。”~
@106731 = ~“问题？我是个商人，不是导游！要是你有问题，去和南边那些居民聊吧。他们不介意和你这种人废话——可是我介意！”~
@106732 = ~“好的。商人最恨的就是顾客。总是烦我们，要看我们的货物。我知道这是唯一一种摆脱我那些货物的方法，不过这真的很痛苦。”~
@106733 = ~他厌恶地摇摇头：“一个又一个顾客，一桩又一桩生意。为什么我要忍受这些？我想尽快出清我的货物。”~
@106734 = ~“好吧，成交。你给我比这破玻璃还不值钱的东西，我就把镜子碎片给你。至少我会告诉你它在哪儿。我不会把我的货放在我这儿的。”~
@106735 = ~“诅咒，你说什么？对不起，但我不相信你。我想你想要骗我。好吧，这没有用的！你要拿出别的什么东西。”~
@106736 = ~[成功]“诅咒，你说什么？嗯……通常一个金币实在是太贵重了让我不能接受，但要是它被诅咒了也许我可以考虑。这个诅咒有什么效果？~
@106737 = ~[成功]“好，这是个不寻常的诅咒。只有在使用者使用它之前就知道它的作用，这样才会生效吧？好吧，我看看这个金币是怎么一文不值的。”~
@106738 = ~“你认为你威胁得了我？我已经告诉你这碎片给藏起来了。要是你杀死我了，你到哪找它去？不，你最好换个方式。”~
@106739 = ~[成功]这个商人显然吓白了。“要是你杀死我，你就没机会找到那碎片……但是我想你还是够疯到会这么做的。”~
@106740 = ~“我不想死在这上，所以你赢了。我会告诉你去那找镜子碎片。现在我记不清我把它藏哪了，但这个罗盘会帮你找到它的。”~
@106741 = ~“魔法？好吧，也许这镜子能恢复。但它破了，所以你要是想从我这弄到它，你就得给我比一个破镜子还不值钱的东西。”~
@106742 = ~[成功]“魔法，你说真的？不过它只是法器的一部分。这意味着它还是不太值钱。告诉你——给我一个金币碎片，它就归你了。”~
@106743 = ~“好吧，我不想放弃它。那很傻。你得给我别的什么来交换。”~
@106744 = ~“当然。低价交换，这是游戏规则。你给我比这破镜子还不值钱的东西，我就告诉你这镜子在哪。”~
@106745 = ~“问题就在这。几乎没有什么东西比一个破镜子更不值钱。一个锈杯子？不，它还能盛水或酒。一把泥土？不，它还能用来种东西。”~
@106746 = ~“要找比一个破镜子更不值钱东西可是不简单。也许要什么被破坏的东西，比如被烧过的纸。”~
@106747 = ~他从你手上拿起焦炭般书的残页，又散落了许多灰烬。“好，这个差不多。完全不可回收的。没用的。就是我要找的。”~
@106748 = ~他拿着记录着你以前的历险和经历的书。“是的，”他边读边嘀咕，“这写得真恶！实际上，它是我读过的最糟的书了。”~
@106749 = ~“实际上，这简单就是在浪费纸张和墨水。没错，我要说德金的书比碎玻璃还不值钱。”~
@106750 = ~“成交。作为交换，我要告诉你去哪找镜子碎片。现在我记不清我把它藏哪了，但这个罗盘会帮你找到它的。”~
@106751 = ~“激活它，它就会开始闪。越接近那个碎片，就闪得越快。用它作你的向导，慢慢地走一圈，要是你足够接近镜子碎片，你就能找到它。”~
@106752 = ~“现在我们交易结束了，我真是没有什么值钱的东西可以再交易了。我不再需要你了，所以你可以走了。”~
@106753 = ~“唔。这是第四个说德金的书不好的人了。”~
@106754 = ~“嘿！这很难说，头儿。德金在这本书上花了不小心血的。”~
@106755 = ~这个男人看到你的接近而皱眉。“什么？另一个顾客？”他叹息着，“我讨厌和顾客打交道。但我想这是唯一一种摆脱我所有货物的方法。”~
@106756 = ~“好的。再见。”这人回去继续做他那些无谓的事情。~
@106757 = ~“我叫吉通。我是这个城镇的商人。所有想要什么的人都会来找我的。”~
@106758 = ~“看，我不想留下任何东西。现在你帮我清空存货了。所以走吧，不要管我。”~
@106759 = ~“问题？我是个商人，不是导游！要是你有问题，去和南边那些居民聊吧。他们不介意和你这种人废话——可是我介意！”~
@106760 = ~“好的。商人最恨的就是顾客。总是烦我们，要看我们的货物。我最不想要的就是顾客。所以走开。”~
@106761 = ~“让我看看你有什么可卖的。”~
@106762 = ~“你的货不多啊，是吧？”~
@106763 = ~“你喜欢穷？”~
@106764 = ~“我要问你点问题。”~
@106765 = ~“这么说话会赶走顾客的。”~
@106766 = ~“我想和你交易镜子碎片。”~
@106767 = ~“别介意。”~
@106768 = ~[欺骗]“我有个被诅咒的金币可以给你。”~
@106769 = ~[欺骗]“它能给直率而心甘情愿的接受他的人带来贫困。”~
@106770 = ~[威胁]“给我那个碎片，要不你的命会比一片碎玻璃还不值钱！”~
@106771 = ~[劝说]“但这个碎片不是完全不值钱。它是一个魔镜的一部分。”~
@106772 = ~“我没有那么多。”~
@106773 = ~“我想我能付一个金币。”~
@106774 = ~“你想要比这碎片不值钱的？”~
@106775 = ~“有什么东西比碎玻璃还不值钱？”~
@106776 = ~“我有个烧过的书。能行么？”~
@106777 = ~“这是德金书的副本。这不值钱。”~
@106778 = ~“安静，德金。大人们在讲话。”~
@106779 = ~“对不起，德金。但我们需要那个碎片。”~
@106780 = ~“我没时间。”~
@106781 = ~“货物？你是商人么？”~
@106782 = ~“你是谁？”~
@106783 = ~“再见。”~
@106784 = ~“我不喜欢你的态度。去死吧！”[攻击这个商人。]~
@106785 = ~“我只是想问你点问题。”~
@106786 = ~“这么说话会赶走顾客的。”~
@106787 = ~你突然觉得无力和恶心，你的身体感到一阵狂热。这个牧师用一种算计的眼神打量着你，好似在分析你经受着的痛苦感觉。~
@106788 = ~“你被塔洛娜触摸了，孩子。毫无疑问你感觉到了你体内的狂热。疾病与毒药之女神把手伸向了你。”~
@106789 = ~“我不是把你弄成这样的人，不过我倒是有祛病的方法。不，这是塔洛娜她自己在你身上做的标记。”~
@106790 = ~“我叫洛梅利沙尔。原来我侍奉爱得瑞菲亚——翼精灵的圣母。现在我侍奉毒药女士。和你看到的一样，我把这座神殿改建成崇拜我新守护神的地方。”~
@106791 = ~“塔洛娜选了你来考验。她用她的燃烧精华感染了你，唯一祛病的方法就是证明你是有价值的。”~
@106792 = ~牧师点点头，说：“在神殿里攻击塔洛娜的仆人献身于女神她自己来证明你值得——尽管你可以选一个不那么难的挑战机会。”~
@106793 = ~“那么你会永远患上这种疾病。只是完成塔洛娜的挑战来证明你是值得去掉这个诅咒的。”~
@106794 = ~牧师脸上现出扭曲的狞笑：“你必须在战斗中证明自己。要是你带病能在战斗中活下来，那你就值得活下来。”~
@106795 = ~“要是你活过这个挑战，你的病就会被祛除。一般来说这战斗不难，不过疾病破坏你的身体后，这就会增加难度的。”~
@106796 = ~“很少人能活过这个考验，但你是很强的。你也许让我惊奇。我希望能在竞技场上看到你。”~
@106797 = ~“你没什么选择。要是你不战斗，病痛会毁了你。不过我感到你的不情愿，但我要你认真地战斗。所以我要给你更多的东西。”~
@106798 = ~“要是你活下来了，我会给你镜子碎片。只是这一片不值什么，不过要是你能找到其他的，你就能把它凑成一件强大的宝物。”~
@106799 = ~“我后面就是竞技场。拉一条链子，你就能被传送到竞技场。每条能召唤不同的塔洛娜的手下和你战斗。”~
@106800 = ~“要是你在战斗中活下来了，你就证明了你值得活下来。你可以回来找我要我承诺过的奖品。我在这等你完成这挑战。”~
@106801 = ~“你放聪明点，别在这和我聊天了。以你完成挑战之前，塔洛娜热病会一直侵蚀你的身体。”~
@106802 = ~“拉一条链子，就会把你传送到竞技场。每条能召唤不同的塔洛娜的手下和你战斗。要是你活下来了，再回来找我吧。”~
@106803 = ~“在竞技场里有另一场战斗。在他们打完前你不能进去。”~
@106804 = ~看到你接近，牧师狡猾地笑了：“现在我知道为什么塔洛娜要选中你了——你真是太强了。带病还能完成这个考验。”~
@106805 = ~“现在只有一场了，尽管我想知道你能不能活下来。你现在，脸色苍白，呼吸急促而且有淡臭味。”~
@106806 = ~“你已经比大部分人强了，不过塔洛娜热病已经让你的力量和魔力大打折扣了。你只剩下个壳了。我怀疑你能不能活过最后的考验。”~
@106807 = ~“我不会背叛你的。尽管你不能真正的确定，是吧？热病在你脑子里，你的思维很混乱。这考验让你精疲力尽，你变得多疑而且绝望。”~
@106808 = ~“很多人认为塔洛娜只是能影响肉体，但现在你知道她还可以攻击意识和精神。现在你知道她真正的力量了。但这能帮你在最后的考验中活下来么？”~
@106809 = ~“我承认我没想到你会活这么久。困扰你的热病就足已杀死大部分人了，不过你从热病和战斗中全活下来了。我很想看看你还能挺多久。”~
@106810 = ~牧师笑了：“你说你不相信我？你觉得我在说谎么？我在慢慢毒害你，让你越来越弱直到你死去？这全是个圈套？”~
@106811 = ~牧师又笑了：“你的怀疑让我很高兴。说明塔洛娜热病已经侵入了你的意志。但我答应你：挑战是公平的。它能被打倒——只是不那么容易。”~
@106812 = ~“当然，我不能证明我说的是真的。尽管你进入了下一关，你的怀疑会继续蚕食你的思维。不过和以前一样，你还是别无选择。”~
@106813 = ~“你病得很虚弱，<CHARNAME>，而且这个牧师也许是唯一能治你的人。我觉得你必须完成挑战。”~
@106814 = ~“她是不会治疗你的，<CHARNAME>！这个挑战是个圈套。现在杀死他，在你还有力气的时候。”~
@106815 = ~“哎呀，头儿。德金不知道你是不是应该相信这家伙。他有点怪。”~
@106816 = ~“你完成了塔洛娜考验的第二关，但在你解除毒药女士的控制之前，你还有很多事要做。准备好接受下一关的考验了么？”~
@106817 = ~牧师仔细考虑他的回答：“这有关于参加挑战的个体的实力。你会被推到自己的极限来证明你自己。”~
@106818 = ~“你很强大。对于你，会有很多关。5级，我想……尽管我不确定。要是你想摆脱病痛就别无选择。”~
@106819 = ~“我们对你的游戏烦了，牧师。所以别再推三阻四的了，回答<CHARNAME>的问题。”~
@106820 = ~“但是你的旅程才刚开始。你必须再进入竞技场——而且你身上的病会随着你通过每一关而恶化。”~
@106821 = ~牧师的眼中闪过一丝凶残：“记住：你体内的病会越来越恶化的。所以你要是准备好了，就挑一条链子进入竞技场吧。”~
@106822 = ~牧师耸耸肩：“我们能选择疾病传不传染我们？我们能选择在它变得致命之前每次恶化多少？”~
@106823 = ~“你所感觉到的还仅仅是塔洛娜热病的开端。为了证明你自己，你必须去感受更严重的疾病——完全的狂热。你别无选择，只有继续你的挑战。”~
@106824 = ~“我们应该预料到这种背弃。塔洛娜是个卑鄙的喜欢虐待别人的神。”~
@106825 = ~“这可能是个陷阱……不过看来你没什么选择，<CHARNAME>。”~
@106826 = ~“小心，头儿。这家伙耍赖！”~
@106827 = ~“毒素和疾病杀死无用的人，它们剔除弱者，只留下强者。通过塔洛娜的考验证明了你值得活下来。”牧师鞠躬向你表示敬意。~
@106828 = ~“你赢得了我承诺的奖品：镜子碎片，以及对你疾病的治疗。这个宝物能清除你体内的塔洛娜热病。”~
@106829 = ~“不过我希望你能从中学到点东西。瘟疫和毒素让我们虚弱，也让我们展现力量。在弱者被一扫而空后，只有强者才得以幸免。”~
@106830 = ~“如以前所说，我已经把镜子碎片给那个卓尔。但你还是有资格接受我答应的治疗。这个宝物能清除你体内的塔洛娜热病。”~
@106831 = ~牧师看来很惊讶地再见到你：“你还活着？当你离开神殿时，我还以为见不到你了——尽管我看到塔洛娜热病还在你的体内燃烧。”~
@106832 = ~“和以前一样，我还是让你继续挑战——简单地拉一条链子，再进入竞技场。但你应该知道以前我答应你的东西现在没了。”~
@106833 = ~“另一个人拿走了我答应的镜子碎片。在你不在的时候，一个叫萨巴尔的女卓尔进入神殿来找它。和你一样，她也是感染了塔洛娜热病。”~
@106834 = ~“我对她作了和你一样的承诺。但是她成功做到你没做到的：她完成了考验。我治好了她，给了她镜子碎片。”~
@106835 = ~“萨巴尔打败了你拿到了镜子碎片 ——现在你没什么能做的了。不过要是你认为你就不用完成我的挑战，你就太傻了。”~
@106836 = ~“你还在受着塔洛娜热病的折磨。你唯一解毒的希望就是通过竞技场证明你的价值。你必须接受这个，继续你之前没完成的。”~
@106837 = ~“德金觉得这样不好，头儿。要是卓尔主母得到全部的碎片，也就会让它们交给瓦纱瑞丝。”~
@106838 = ~“这很糟，<CHARNAME>。我们不能让萨巴尔得到碎片去交给她的主人。”~
@106839 = ~“该死的萨巴尔！我们不能让她得到碎片去交给瓦纱瑞丝！”~
@106840 = ~“你通过了毒素之主的考验，我也给你解了毒。你还要什么？”~
@106841 = ~“再见。不要忘记你从塔洛娜和她的魔力那里学到的东西。”~
@106842 = ~牧师轻轻点点头：“你有那个权力。你要知道什么？”~
@106843 = ~“我不会和任何人结盟的。我要在这侍奉塔洛娜，来指导那些进来通过她的考验的人。我只效忠于毒药女士。”~
@106844 = ~他耸耸肩：“你知道我已经把镜子碎片给她了。她对得到它非常感兴趣。她看来是想修复整面魔镜。”~
@106845 = ~“她向我询问过北方城堡的情况，但是我没什么能告诉她的。我已经记不清神殿的高墙外的那个世界多少事情了。”~
@106846 = ~他脸上显出奇怪的神情：“这算是一个祈祷者的礼物吗？不，看起来不像。我……我记不清了。”~
@106847 = ~“有一次我们在失落之峰的山脉间宿营，但我已经记不清我发誓服侍塔洛娜之前我的生活了。就好像我的某个部位已经干枯而且死亡了。”~
@106848 = ~“我回忆不起我们如何来到这，或是为什么。也许这根本都没什么意义。我喜欢呆在幽暗地域，容身于这个阴影和黑暗生物称之为家的地方。”~
@106849 = ~“在我们最后都终老于这幽暗地域中之前，我曾追随飞尼娅，鸟、风与空气的女神。但不知何故好像在这地下再继续追随她显得不那么应该了。”~
@106850 = ~“我不清楚为什么把自己奉献给塔洛娜。”祭司把眼睛闭上了一小会儿，好像是在试着回忆什么。“我想我已经被飞尼娅和所有她所庇护的事物所遗弃了。”~
@106851 = ~“崇山峻岭间那清新的空气触动了我。我渴望瘟疫和疾病所带来的那种腐朽和堕落的感觉。相比之下塔洛娜也许是个合理的选择。”~
@106852 = ~“这个世界有太多奇异的东西、太多关于我生活的事情无法解释了。但我发现自己已经身陷其中时，我只能求助于我的信仰了。”~
@106853 = ~“我让我的思想容身于我的女神的疤脸下。我让她深拥的堕落封闭自己，这样我才能求得安宁。”~
@106854 = ~“你的信仰已经把它应有的本来面目曲解了。我们本应该从我们所崇拜的神灵获取力量和安宁的。”~
@106855 = ~“我真的无法相信你居然抛弃了你的神，不管是在何种情况下。你可是个祭司啊！”~
@106856 = ~“但其实我不是个祭司。这不是同一件事。祭司应该比他们所崇拜的神具有更宽大的胸怀才是。”~
@106857 = ~“正好相反。作为一个祭司，我的信仰必须是专一的。如果我对我所供奉的神灵有任何怀疑的话，我又怎么能继续供奉她而不被称为一个伪君子呢？”~
@106858 = ~祭司他那狡猾的眼睛直盯着娜西拉：“我怀疑我的转变和你的没什么很大的不同。我只是认为我以前的信仰错了而已。”~
@106859 = ~“无论你对我做过什么，你最好赶快把它复原！”~
@106860 = ~“你以为你是谁？你以为你在说什么？”~
@106861 = ~“也许我把你杀了更好。”~
@106862 = ~“看来我真的该杀了你！”[攻击祭司。]~
@106863 = ~“告诉我关于挑战的事。”~
@106864 = ~“算了吧。我不会参加任何挑战的！”~
@106865 = ~“我该怎么证明自己的价值呢？”~
@106866 = ~“如果我赢了你会治疗我吗？”~
@106867 = ~“这对你来说只是个嗜血的游戏吧，不是吗？”~
@106868 = ~“我可不会为了取悦你而战！”~
@106869 = ~“我接受你的挑战。”~
@106870 = ~“不用担心我。你只需记得我胜利后兑现你的承诺就好了。”~
@106871 = ~“如果我发现你已经出卖我的话……”~
@106872 = ~“我会走得更远的。开始下一关吧！”~
@106873 = ~“这只是场游戏而已，不是吗？我不可能真正赢的，对吧？”~
@106874 = ~“我总共需要挑战多少关？”~
@106875 = ~“我已经准备好进入挑战的下一关了。”~
@106876 = ~“这不是我们交易的一部分！”~
@106877 = ~“每一关？你可从没说过有不止一关啊！”~
@106878 = ~“难道你准备改变我们已经达成的协议吗？”~
@106879 = ~“你什么意思？”~
@106880 = ~“我该杀了你！”~
@106881 = ~“这不公平！那块镜子碎片属于我！”~
@106882 = ~“让我们继续试炼吧。”~
@106883 = ~“我现在该走了。”~
@106884 = ~“我决定要杀了你。”[攻击祭司。]~
@106885 = ~“我想问你些问题。”~
@106886 = ~“我正在寻求帮我对抗瓦纱瑞丝的盟友。”~
@106887 = ~“关于那个黑暗精灵你能给我提供些什么线索，萨巴尔？”~
@106888 = ~“你手上那块镜子碎片哪来的？”~
@106889 = ~“关于这个镇子你有什么能告诉我的吗？”~
@106890 = ~“你是怎么会来供奉塔洛娜的？”~
@106891 = ~“你不觉得那很奇怪吗？”~
@106892 = ~“我想问点别的。”~
@106893 = ~“你真是巧舌如簧啊，娜西拉。你居然随便就换了你所崇拜的神！”~
@106894 = ~“她是对的，你对你的信仰不该如此的善变。”~
@106895 = ~“好了。你走吧。我要问的都问完了，我想一个人待会儿。”~
@106896 = ~她高声大笑起来：“杀我？来啊，你试试看。你根本伤不了我！那个曾经使我在王座上不死的咒语现在已经让我在这个洞里不朽了！”~
@106897 = ~她异样的耸了耸肩：“来啊，来试试你那精准的一击吧。你不过是在浪费你的时间。”~
@106898 = ~前女王沮丧地摇了摇头：“那好吧。问你想问的。我知道这是我打发你的唯一办法了。”~
@106899 = ~她高声大笑起来：“杀我？来啊，你试试看。你根本伤不了我！那个曾经使我在王座上不死的咒语现在已经让我在这个洞里不朽了！”~
@106900 = ~“这不难懂吧，是不？你伤不了我。在这不可能。这个洞里有个咒语使我不朽——就像以前曾在我王座上的那个咒语一样。”~
@106901 = ~她蔑视地哼了声鼻息：“你现在明白了吧？我的王国被诅咒了，整城的翼精灵注定要活在这地下。这就是把玩那面魔镜要付出的代价。”~
@106902 = ~“我说全是事实，不是吗？她来这破坏这里的平静安宁，就像你这样。她的名字是萨巴尔。”~
@106903 = ~“他们需要我的帮助，我也对他们施以援手了。那些黑暗精灵要染指那面愚蠢的破镜子，那我还管什么？”~
@106904 = ~娜西拉皱了皱眉：“萨巴尔是红色姐妹的一员，那是一个供奉瓦纱瑞丝的刺客精英组织。我以前见过她。”~
@106905 = ~“瓦纱瑞丝？我管它干什么？我还管这个洞外的事干什么？”~
@106906 = ~“绍勒现在只管绍勒的事了。我已经告诉你那个卓尔萨巴尔来烦过我，现在我告诉你：我只想在我的洞里安安静静的待着。”~
@106907 = ~“只有这个洞穴才能给我之前没有的安宁平静的生活。你知道当你成为一个女王时有多少人想拜见你吗？一个又一个的朝见者……总是个没完！”~
@106908 = ~“在我们的城市还在云上的时候，就没比这更糟的事了。现在我们掉到了这里，我还是躲不开这些事情。所有人来寻求我的建议和领导，我实在是受不了了。”~
@106909 = ~“不用你来告诉我什么是女王的职责！我不会对自己以外的任何人或事负责！你知道吗？你已经比那些卓尔更令人厌烦了。”~
@106910 = ~“德金与老主人一起在洞中生活了很长一段时间。这并不是什么糟糕的事。除了当老主人打鼾的时候，天花板上的板块掉落下来砸到德金的头。这就没那么有趣了。”~
@106911 = ~女王的神情似乎变得悲伤起来：“魔镜……那该死的魔镜。”然后她开始猛摇她的头，再后来，她更变得痛不欲生了。~
@106912 = ~“这都是我的错。我本不该再管别的。我用那面魔镜来监视我的敌人的动向。它能让我看到外面发生了什么，了解事情的真相。它辅助我统治我的王国。”~
@106913 = ~“但魔镜最后背叛了我们。它把我们带到这暗无天日的世界。现在我们受困于它那强大的力量，在这扭曲的时空中受到永久的诅咒。”~
@106914 = ~“现在魔镜破损了。咒语引领我们来到这个破坏了魔镜、并使它的碎片散落四处的幽暗地域。我曾经发现了一块碎片，但我还是放弃了它。”~
@106915 = ~绍勒冷漠地耸耸肩：“如果你真想重新修复魔镜，那是你自己的事。但是你自己把事情弄糟了。我自己的那块碎片我已经给了那个卓尔萨巴尔了。”~
@106916 = ~“那个卓尔，萨巴尔。为什么不？她向我要过那面魔镜，所以我告诉她这件事了。我拿着块对我来说没有任何好处的碎片，也许最好还是她拿着。我还在乎这些干什么？”~
@106917 = ~绍勒冷笑道：“为什么不？我还需要再关心什么破镜子吗？那已经不是我的事了。所以那个卓尔萨巴尔来见我的时候，我就把那些碎片给了她。”~
@106918 = ~“我想她正计划着修复魔镜然后把它献给她的女主人，瓦纱瑞丝。她可能现在就在外面城里拼命找着那些遗失的碎片呢。”~
@106919 = ~绍勒露出了狡黠的微笑：“但只有镜子碎片可解决不了那个卓尔的问题。她还需要镜框。而且就我所知它还躺在城堡的王座室里呢。”~
@106920 = ~“你跟那个卓尔的恩怨与我没有关系。我现在只遵从我自己的意愿。我只是陈述我所知道的事实罢了。萨巴尔想修复那面魔镜，所以可能你也想那样做吧。”~
@106921 = ~“你的确聪明。你看来会去城堡的王座室找的。如果我站在你的位置上我肯定会去的。至少，是我本该去做的事……好吧，在我停止自作多情的关心之前你快去吧。”~
@106922 = ~“现在快离开这里，继续你的行程吧。我已经告诉你我知道的所有事了，让我一个人待一会吧。”她向你挥手道别。~
@106923 = ~“我想就在镇里某处吧。除非萨巴尔已经抢先了。不过如果你得到镜框的话，谁得到那块碎片就无所谓了。”~
@106924 = ~“你帮不了什么忙了。也没有人可以了。这个镇子避不开它的宿命，我的人民也不可能被救赎了。你还来管什么闲事？这都是没有意义的。”~
@106925 = ~她高声大笑起来：“杀我？来啊，你试试看。你根本伤不了我！那个曾经使我在王座上不死的咒语现在已经让我在这个洞里不朽了！”~
@106926 = ~她的脸开始扭曲：“不，你不能这样。我已经告诉你够多的了。我可不是专门回答问题的。你赶快走吧。”~
@106927 = ~她并没有立即回答，但却像是正深入自己的内心世界，去寻找一种一种尘封已久的感觉。“我……我连我自己都帮不了，你知道的。这是魔镜诅咒的一部分。”~
@106928 = ~她开始猛摇自己的头，瞬间开始狂躁起来。“我已经无法在照顾他人了。我根本不在意我的人民，或是你，还是别的什么发生了什么事。这是不是很难以理解？”~
@106929 = ~“我得走了。”~
@106930 = ~“我就是来杀你的！”~
@106931 = ~“那我们就来试试看！”[攻击她。]~
@106932 = ~“不死？你到底在说什么？”~
@106933 = ~“我在寻找一块镜子的碎片。”~
@106934 = ~“我想问你些问题。”~
@106935 = ~“你究竟是谁？”~
@106936 = ~“我想是到了该杀你的时候了。”~
@106937 = ~“你是什么意思？你不可能被伤害吗？”~
@106938 = ~“这应该有什么地方不对劲。”~
@106939 = ~“那个卓尔来见过你？”~
@106940 = ~“镜子？什么镜子？”~
@106941 = ~“我在寻求对抗瓦纱瑞丝的盟友。”~
@106942 = ~“一个女王怎么可能会住在一个山洞里？”~
@106943 = ~“领导人民难道不是一个女王所应尽的责任吗？”~
@106944 = ~“我想问你些问题。”~
@106945 = ~“告诉我你所提到的那面魔镜的事。”~
@106946 = ~“那面魔镜现在在哪儿？”~
@106947 = ~“也许修复魔镜就能拯救你的城镇了。”~
@106948 = ~“你放弃了它？给谁了？”~
@106949 = ~“你为什么放弃了它？”~
@106950 = ~“看来你是想挑拨我和那个卓尔的关系啊。”~
@106951 = ~“你知道我该到哪去找其余的碎片吗？”~
@106952 = ~“有什么我能帮忙的地方吗？”~
@106953 = ~“我决定要杀了你。”~
@106954 = ~“我能问点别的吗？”~
@106955 = ~“你怎么会把你的人民弄成这样的？”~
@106956 = ~绍勒以她高贵的姿态站在你面前，这位翼精灵女王已经恢复了从前的庄严气势。她身旁侍立的是个一脸憨笑的愚者。女王很热情地对你微笑。~
@106957 = ~“我也得马上回到我的人民中去。这里对我来说已经不再安全了。能保护我抵御伤害的咒语现在只在我的城堡的王座室才能起效了。”~
@106958 = ~“但首先我得确定你的安全，然后才能告诉你之前你看见的那个肮脏的隐士并不是我的本来面目。”~
@106959 = ~“再见了，好心的陌生人。我们翼精灵通常并不信任外人，但我们在失落之峰的家园永远欢迎你。”~
@106960 = ~“你离开洞穴后，我就得回到我的人民中间去了。请再一次接受我诚挚的谢意。”~
@106961 = ~娜西拉流露出意味深长的目光：“也许事情全部结束后我们能接受你的盛情邀请。我很喜欢这些山。”~
@106962 = ~“我听说过那些关于失落之峰的传说；它们说这是一个充满伟大奇迹……和巨大危险的地方。但我想我们在您的大厅里会是安全的，陛下。”~
@106963 = ~“老大，要是我们去那里的话说不定那些翼精灵会把我们扔进盛大的派对！德金喜欢派对；那很有趣。你说他们会把我们当蛋糕给烤了吗，老大？德金喜欢蛋糕。”~
@106964 = ~“你已经得到了碎镜，这个真正的强大神器……所以我要警告你小心用它。我想这就足够了吧。”~
@106965 = ~女王摇头道：“我很感激你所做的，但我没什么能给你的了。我所有的财富都在我的城堡里，就是那个重新回到失落之峰的城堡。”~
@106966 = ~她注视着那个愚者，他在地板上一边傻笑一边淌着口水。她的眼中充满了怜悯。“这个愚者就像他以前那样：头脑简单，根本没有复杂的思维。”~
@106967 = ~“他永远都不会明白我们对他的感激。锦衣玉食良榻——这些是他唯一能享用的了。我一定会保证他能享受到最好的。”~
@106968 = ~她点头道：“与整个王国的需要相比一个人的需要又能算是什么呢？他做出了巨大的牺牲，但他知道没有别的选择了。”~
@106969 = ~“我们没有什么别的能做的了。是魔镜的巨大力量使他有了惊人的智慧——那是一种远远强于我的力量。现在咒语消散了，他也变回了从前的那个他了。”~
@106970 = ~“与整个王国的需要相比一个人的需要又能算是什么呢？他做出了巨大的牺牲，但他知道没有别的选择了。我希望你能明白这个道理。”~
@106971 = ~她浅浅一笑：“你真是太仁慈了。我的人民以为你们的部族还未开化呢。我必须得告诉他们这些优雅的<RACE>习惯。”~
@106972 = ~她温柔地笑了，这柔美的声音宛若徐风吹过：“你实在太仁慈了。我的人民还总把我们那些无翼的兄弟当作未开化的人呢。我会告诉他们你们是多么的温文尔雅。”~
@106973 = ~“嗨，现在你又装成多么正派了！之前还那么低俗呢。德金喜欢你这个样子。”~
@106974 = ~“您的改变真是让人印象深刻，殿下。我必须承认，之前真的很难想像您居然是个女王。”~
@106975 = ~女王点头道：“魔镜的力量可不是随随便便就能获取的。你已经看到了它使我和我的王国产生的巨大变化。”~
@106976 = ~“我得走了。”~
@106977 = ~“你说你的不朽之身已经破了？你死期到了！”[攻击女王。]~
@106978 = ~“那么帮助你总会有些奖赏吧？”~
@106979 = ~“你错了。我想要更多。”~
@106980 = ~“那个愚者怎么办？他现在发生了什么事？”~
@106981 = ~“我想你是对的。”~
@106982 = ~“就这样？你就这样不管他了吗？”~
@106983 = ~“能帮助你真的很荣幸，我的女士。”~
@106984 = ~从尸体上可以明显地看出红色姐妹已经来了。尸体上所有值钱的东西都被刨得一干二净。~
@106985 = ~一个单翼的精灵鞠躬向你问候。他的翅膀发育不良，他的身体已经蜷曲而且驼背了。他的衣着很鲜艳——但是有些褪色了——全身穿得就像一个谄媚的小丑。~
@106986 = ~然而，尽管穿得像个乱蹦的小丑，他的脸上却没有一个君王治下的愚者应该表现出的油嘴滑舌，他的眼中仿佛包含无尽的深意。~
@106987 = ~“拜托，”愚者说道，绝望从他的嗓音中延伸，“拜托，<CHARNAME>，我需要你的帮助。我们能并肩作战。如果你帮助我们，也许我能帮助你们对抗瓦纱瑞丝。”~
@106988 = ~愚者叹了口气，道：“我希望你能改变你的主意。如果你真的改变主意，请你马上找我。”~
@106989 = ~他疲倦地叹着气说：“攻击我只是浪费时间。在这个王座上我是无敌的。等你回过神你再来找我吧。”~
@106990 = ~“你可能已经得出了结论，但还有一些事实是你所不确定的。我只知道没有完整的线索是得不到正确答案的：所以你是否清楚所有事实是非常重要的。”~
@106991 = ~“我叫做伊利西德。我曾经只是个绍勒女王身边声色犬马的小角色。但自从我们被从魔镜中拉过后我便无所不能无所不知了。”~
@106992 = ~“在我们的城市在失落之峰中发展起来的时候，绍勒女王拥有一面魔镜。通过它强大的魔力，她可以监视一切。她能看到他们在做些什么、计划些什么。”~
@106993 = ~“绍勒用这面魔镜来维护我们王国的安全，它使得没人能够在我们不知晓的情况下作出对抗我们的举动。她根本没有意识到魔镜所包含的巨大危险。”~
@106994 = ~“魔镜夺取了绍勒的心智；这是它诅咒的一部分。她想监视每一个人……甚至包括大法师海拉斯特。海拉斯特通过水晶球知晓了这件事，于是他用强大的反制魔法攻击了。”~
@106995 = ~“他把魔镜转过来对付我们。我们的城市——城堡、神殿、图书馆——都被魔镜所扭曲，迷失了我们的山峦，堕入这无尽的黑暗。”~
@106996 = ~“每个通过魔镜的人都被扭曲为他们真实自我的对立面。女王放弃了自己的王位，愚者变得无所不知。魔镜自己也破碎了，并把我们都困在这里。”~
@106997 = ~“如果魔镜被修复，所有一切都会回复正常。我们也会被送回失落之峰，绍勒会重新回到自己的王座而所有事物都会回到它们应有的样子。”~
@106998 = ~“我有魔镜的镜框，但我不能离开这个王座去收集那些碎片。因为之前我被禁止进入这儿，除非绍勒和我在一起。现在除非她在这儿，否则我根本不能离开这里。”~
@106999 = ~“我需要有人能给我带来那五片丢失的镜子碎片，好让我修复它。如果你能做到这些，<CHARNAME>·<CHARNAME>，我将把魔镜给你。它能成为对抗瓦纱瑞丝的非常有用的工具。”~
@107000 = ~“我不是个愚者，<CHARNAME>。不再是了。不，我想我现在会自己看管着镜框。如果你带回其他碎片，我会给你魔镜，镜框和所有的一切。”~
@107001 = ~“我们已经了解海拉斯特和他对那些使他变得疯狂的人们的所作所为了，是不老大？”~
@107002 = ~“我们已经看到被那疯狂巫师所害的人们的真实情况了。”~
@107003 = ~“再见。<CHARNAME>。如果你对寻找失落碎片的任务有任何疑问，请尽管来找我。”~
@107004 = ~愚者摇头道：“我可不能逼你帮我，但是我想你是个坚定的人。你需要对抗瓦纱瑞丝的帮助，而魔镜是个强大的工具。”~
@107005 = ~“如果你不想修复魔镜而把它给先知，那我就只能靠萨巴尔把碎片带给我了。而且她还会把魔镜交给瓦纱瑞丝。”~
@107006 = ~“啊，老大？德金记得我们来这里的全部原因就是要找到魔杖来对抗瓦纱瑞丝。为什么你现在却不想试着得到它吗？”~
@107007 = ~“别傻了，<CHARNAME>。我们来这是为了找到能帮我们对抗瓦纱瑞丝的东西。我们在这件事上可不能回头的。”~
@107008 = ~“我们来这是为了找到能帮我们对抗瓦纱瑞丝的东西。我们现在回去可是再傻不过的事了。”~
@107009 = ~“我也许可以回答你的所有问题，尽管我希望你能把注意力集中在找寻失落碎片的事情上。”~
@107010 = ~他给了你一个沮丧的苦笑。“你是对的，当然是这样。可是一个人孤身对抗整个王国会是个怎样的命运？我已经足够明智到能看出我自己的渺小价值了。”~
@107011 = ~“还有，一旦法术逆转我还会变得头脑简单。我不会记得我失去了些什么。至少，那是我的愿望。无论如何，这是应有的牺牲。”~
@107012 = ~愚者笑了。“那个保护女王不受任何伤害的法术现在使得我也不受任何伤害。我想蛛化精灵们可不会同一个它们无法打败的敌人作战。”~
@107013 = ~“当然，那个保护我的相同咒语也把我困在了这里。我离开不了这个地方。曾经是个保护的咒语现在扭曲成一个无法逃脱的陷阱。”~
@107014 = ~“如果你们分别找到了一部分碎片，我会在你们把它们交还给我时决定谁将拥有魔镜。就我的睿智来看，我是能够拿出一个让大家满意的解决方案来的。”~
@107015 = ~“当然。你们在为同一件事而竞赛。我就得利用我自己的优势了。”他对你狡黠一笑，“我可不会干坐着。”~
@107016 = ~“只有一块碎片对我来说没有意义，<CHARNAME>。作为诅咒的一部分，我在修复魔镜时只能接受五块碎片同时一次给我。我把这事也告诉萨巴尔了。”~
@107017 = ~“魔镜有五块碎片，但诅咒使我看不到它们的所在。不过，我明白魔法的施用，我知道它们最有可能在的地方。”~
@107018 = ~“这里的每座建筑里可能都有一块：神殿、图书馆和法师之塔。我也认为绍勒女王会有一块，还有我猜那个商人有最后一块。”~
@107019 = ~“那个商人是个贪婪却非常精明的生意人。他是目前为止全翼精灵中最富有的人，这也是我为什么认为最后一块在他手上的原因。”~
@107020 = ~“但是自从诅咒开始后他抛弃了自己的商店而且分发了自己的大部分财产。我只能祈求他仍然保有那块镜子碎片，或者至少知道它在哪。”~
@107021 = ~“绍勒女王是一个仁慈和博爱的君王；她对自己人民和王国的关心远远超过对她自己的关心。当然，这是以前的事了。”~
@107022 = ~“她已经成了一个对她的人民毫不关心的隐士。她现在生活在城镇东南边过了图书馆的山洞里。”~
@107023 = ~“法师之塔坐落在城的北方尽头，那里曾经住着魔法师培德尔。虽然他已经离开了塔，但是那里仍然是个充满陷阱和危险的地方。”~
@107024 = ~“图书馆在城东边。在此之前，那个图书管理员据说是翼精灵整个王国中最美的。她与自己深爱的丈夫一起住在那里。”~
@107025 = ~“除了皇宫外，就属图书馆是整场诅咒中最难被影响的地方了。而现在它从我所有能感知的方式中消失了。一想起那里可能有什么恐怖之事发生我就浑身打颤。”~
@107026 = ~“那图书管理员和她丈夫曾经是非常好的人，但是恐怕有什么恐怖的转变发生在他们身上了。魔镜的诅咒真的是一件非常恐怖的事情。”~
@107027 = ~“在城西边角落里，坐落着飞尼娅的神殿，她是空气与鸟之神。那里的祭司洛梅利沙尔，是一个专注于治疗伤者和缓释他们伤痛的人。”~
@107028 = ~“现在他成了毒药与瘟疫女士塔洛娜的疯狂信徒。他已经变得完全邪恶和极度危险了：在与他打交道的时候可千万要小心啊。”~
@107029 = ~“你当然知道我指的是谁，<CHARNAME>。那个在你初次到来时设埋伏害你的那个卓尔就是萨巴尔，她是侍奉瓦纱瑞丝的红色姐妹之一。”~
@107030 = ~“她想把那面魔镜带给她的女主人，用来对抗先知。我告诉你的信息也同样告诉了她。如果她带回那些失落的碎片，我就会把魔镜给她。”~
@107031 = ~“我只关注困在这里的翼精灵。拯救我们人民的任务与我毫不相关。一旦魔镜被修复，我们会被传送到离这里很远的地方。”~
@107032 = ~娜西拉点头道：“之前我就遇见过萨巴尔。我与她真是相见恨晚啊。”~
@107033 = ~“我们会通过战争来了结这件事的，<CHARNAME>！红色姐妹会尝尝你的血究竟是什么滋味的！”~
@107034 = ~那愚者对萨巴尔的进攻留了一手：“那个免疫的咒语使得在这间屋子里杀死对方都是天方夜谭。就算你们将事情付诸于斗殴，我却会使这个咒语的影响更强。”~
@107035 = ~萨巴尔对你咆哮：“你只不过是个懦夫罢了。只有一件事你能从我这得到碎片，那就是从我的尸体上夺过去！”~
@107036 = ~愚者叹了口气：“看样子战斗是已经不可避免了。但在我增强施在你们身上的咒语之前，你们有些事情应该知道。”~
@107037 = ~“这间屋子里的这根柱子有你们可以用来对付你的敌人的强大魔法力量。你们可以用你们所得到的碎片来获取这些力量。”~
@107038 = ~“你们得到的碎片越多，你们可以通过柱子获取的力量也就越大。”~
@107039 = ~“不好意思，但是生活中可不是能有选择我们碰面时间和地点的权力的。战斗现在开始。”~
@107040 = ~“等等！”萨巴尔突然插嘴，“我还需要更多时间！我需要帮助。我们还要准备。”~
@107041 = ~“嗨，老大。黑暗精灵女士现在开始怕你了。也许她终于明白我们会把她狠狠扁一顿了。”~
@107042 = ~“你看来现在不是那么急于求战，黑暗精灵。你真的已经醒悟到你被打败了吗？”~
@107043 = ~“怎么了，萨巴尔？你现在发现进退两难了？”~
@107044 = ~“没人能这么跟老大说话！只要德金在就不行！”~
@107045 = ~“我听说过你，狗头人。他们都说你是个天大的笑话。但我觉得就你那种娱人的本事还不配活在世上！”~
@107046 = ~“自己考虑后再行动，黑暗精灵。这可能是你最后一步了！”~
@107047 = ~“你吓不了我，泰夫林！你会像<CHARNAME>一样轻易就血流满身的！”~
@107048 = ~“来啊，萨巴尔。你不会是第一个死在我剑下的红色姐妹的！”~
@107049 = ~“我把魔镜交给我女主人后我肯定会向她通报你的死的，娜西拉。你的一事无成肯定会使她更加地高兴！”~
@107050 = ~“你还跟着愚者罗嗦什么？让我们杀了<HIMHER>所有的就都结束了！”~
@107051 = ~“闭嘴，萨巴尔。<CHARNAME>·<CHARNAME>有权像你一样知道事情的由来。”~
@107052 = ~“我叫做伊利西德。我曾经只是个绍勒女王身边声色犬马的小角色。但自从我们被从魔镜中拉过后我便无所不能无所不知了。”~
@107053 = ~“在我们的城市在失落之峰中发展起来的时候，绍勒女王拥有一面魔镜。通过它强大的魔力，她可以监视一切。她能看到他们在做些什么、计划些什么。”~
@107054 = ~“绍勒用这面魔镜来维护我们王国的安全，它使得没人能够在我们不知晓的情况下作出对抗我们的举动。她根本没有意识到魔镜所包含的巨大危险。”~
@107055 = ~“魔镜夺取了绍勒的心智；这是它诅咒的一部分。她想监视每一个人……甚至包括大法师海拉斯特。海拉斯特通过水晶球知晓了这件事，于是他用强大的反制魔法攻击了。”~
@107056 = ~“他把魔镜转过来对付我们。我们的城市——城堡、神殿、图书馆——都被魔镜所扭曲，迷失了我们的山峦，堕入这无尽的黑暗。”~
@107057 = ~“每个通过魔镜的人都被扭曲为他们真实自我的对立面。女王放弃了自己的王位，愚者变得无所不知。魔镜自己也破碎了，并把我们都困在这里。”~
@107058 = ~“你和萨巴尔加在一起已经把城内的所有镜子碎片收集齐了。有了它们，我就可以打破城内的诅咒了。”~
@107059 = ~“作为帮助我的奖赏，我会把魔镜交给你或者萨巴尔……至于通过什么方式决定交给谁还在考虑之中。”~
@107060 = ~他摇了摇头：“但这些不关我的事了。一旦我修复了魔镜，我就会变回那个只会乱跑乱跳的愚者。”~
@107061 = ~他叹了口气：“我需要什么并不重要。正义不能颠倒，秩序必须恢复，即便是这意味着我将变回那个愚者。”尽管他的声音很坚定，但透过他的目光能够看到他恐惧的神情。~
@107062 = ~“现在碎片已经在这个王座室里汇齐，我就可以施法修复魔镜了。谢谢你，<CHARNAME>·<CHARNAME>。翼精灵永远亏欠你的恩情。”~
@107063 = ~“多么高尚的牺牲啊。我希望一旦王国得以恢复，那一定永世难忘。”~
@107064 = ~“你非常勇敢，小鬼。我希望当王国重建后，你的牺牲一定永世难忘。”~
@107065 = ~“我已经没时间了。”~
@107066 = ~“算了吧。我要走了。”~
@107067 = ~“你是怎么知道瓦纱瑞丝的事的？”~
@107068 = ~“死期到了，小丑！”~
@107069 = ~“我想我已经知道接下来城里会发生什么事了。”~
@107070 = ~“你是谁？你怎么知道我的名字？”~
@107071 = ~“继续。”~
@107072 = ~“我不明白。你怎么就会无所不知的？”~
@107073 = ~“魔镜？什么魔镜？”~
@107074 = ~“你就开门见山的说吧。”~
@107075 = ~“这件事我该做什么？”~
@107076 = ~“有什么我能帮忙的地方吗？”~
@107077 = ~“如果魔镜被修复会发生什么？”~
@107078 = ~“为什么不干脆把镜框给我好了？”~
@107079 = ~“原来如此，她用它来监视人民。”~
@107080 = ~“危险？什么样的危险？”~
@107081 = ~“我会在得到全部五片碎片后回来的。”~
@107082 = ~“我才不会帮你呢。”~
@107083 = ~“我想问你些问题。”~
@107084 = ~“如果魔镜被修复，你不就会变回那个愚者了吗？”~
@107085 = ~“这里怎么会没有蛛化精灵的？”~
@107086 = ~“如果萨巴尔得到了其中一些碎片而我得到另一些的话会发生什么事？”~
@107087 = ~“听起来像是你在挑唆我和萨巴尔相互对抗。”~
@107088 = ~“我已经拿到一块镜子碎片了。”~
@107089 = ~“我能在哪找到镜子碎片呢？”~
@107090 = ~“我要走了。”~
@107091 = ~“我还想问你些问题。”~
@107092 = ~“告诉我更多关于商人的事。”~
@107093 = ~“告诉我更多关于绍勒女王的事。”~
@107094 = ~“告诉我更多关于法师之塔的事。”~
@107095 = ~“告诉我更多关于图书馆的事。”~
@107096 = ~“告诉我更多关于神殿的事。”~
@107097 = ~“萨巴尔？你是什么意思？”~
@107098 = ~“你已经跟那个卓尔打过交道了？”~
@107099 = ~“我生来就喜欢杀人。”~
@107100 = ~“没有别的方法能解决这件事吗？”~
@107101 = ~“等等，我还没准备好战斗。”~
@107102 = ~“好！让我们开始厮杀吧。”~
@107103 = ~“算了吧——我只是要杀了你旁边那个卓尔而已！”~
@107104 = ~“是的——这里的事情怎么样了？”~
@107105 = ~“继续。”~
@107106 = ~“我不明白。你怎么就会无所不知的？”~
@107107 = ~“魔镜？什么魔镜？”~
@107108 = ~“你就开门见山的说吧。”~
@107109 = ~“这件事我该做什么？”~
@107110 = ~“有什么我能帮忙的地方吗？”~
@107111 = ~“那个卓尔是怎么牵扯进这所有事情的？”~
@107112 = ~“原来如此，她用它来监视人民。”~
@107113 = ~“危险？什么样的危险？”~
@107114 = ~“那此刻又将怎样？”~
@107115 = ~“你确定这就是你想要的结果吗？”~
@107116 = ~愚者对你咧嘴而笑——全然没有表现出有任何的智慧和认知能力。他开始在你面前乱蹦乱跳，与之前那优雅的风度判若两人。~
@107117 = ~但是透过这没有意义的表演你似乎感觉到了些什么。从他眼中你仿佛看到了他黯淡的理性光芒，以及对他那段业已失去却不能完全忘怀的短暂时光的怀念。~
@107118 = ~这地方到处都是类人生物的脚印。~
@107119 = ~有一队卓尔经过这个地区，尽管你无法判断具体的人数或是他们走的方向。~
@107120 = ~一个大型的卓尔劫掠队最近通过了这个地区。看来他们的队伍人数大概有一打左右而且向东边去了。~
@107121 = ~一个大型的卓尔劫掠队最近通过了这个地区。他们的队伍肯定有很多人而且是向东边走了。~
@107122 = ~这地方到处都是类人生物的脚印。~
@107123 = ~有一队卓尔经过这个地区，尽管你无法判断具体的人数或是他们走的方向。~
@107124 = ~有一打卓尔经过这里。看来他们仔细探索了这片区域然后分成了两队。一队爬上了左边的崖壁另一队则爬上了右边相反方向的崖壁。~
@107125 = ~有一打卓尔经过这里。看来他们仔细探索了这片区域然后分成了两队。一队爬上了左边的崖壁另一队则爬上了右边相反方向的崖壁。~
@107126 = ~这地方到处都是类人生物的脚印。~
@107127 = ~有一队卓尔经过这个地区，尽管你无法判断具体的人数或是他们走的方向。~
@107128 = ~有一队人数大概是一打的卓尔经过了这个地区。他们进入了那边的山洞里。~
@107129 = ~有一队人数大概是一打的卓尔经过了这个地区。他们进入了那边的山洞里。~
@107130 = ~法师对你友善地点点头。“欢迎回来。很高兴再见到你。我们这没有很多访客的。有什么我能帮忙的吗？”~
@107131 = ~法师叹了口气，悲哀地摇了摇头。“恐怕这是不能避免的了。我试过劝告他魔法的危险性，但是他执意不听。”~
@107132 = ~“好吧好吧。你拿着总比他拿着好。你还是小心点为好。魔法的强大力量可不是拿来玩的。你还有什么要帮忙的？”~
@107133 = ~这个翼精灵穿着法师的衣服，尽管谁都会对一个法师站在街边会干什么感兴趣。他对你一边热情地微笑一边挥着手。~
@107134 = ~“你好啊。这个塔的访客可不多啊。请允许我自我介绍一下：我叫培德尔·特兰寇德，有名的大法师。也许我该说，前任大法师。”~
@107135 = ~“哦，是啊。当然。你总有你要忙的事。请自便吧。”~
@107136 = ~这位前法师欠了欠身，尽管他好像还有话没说完。“你的脾气真是火爆啊，我的<RACE>朋友。你该学会克制，否则总有一天你会让它给毁了的。”~
@107137 = ~“是啊，当然。我可能的确是对神秘艺术感兴趣，但这并不意味着我已经把了我所学的所有东西忘得一干二净了。”~
@107138 = ~“在我意识到我荒废了所有的魔法研究和我所作所为的错误之前，我曾经一直住在这座塔里。我可以据我的个人经历告诉你，这座塔非常危险。”~
@107139 = ~“正如同其他法师的住所一样，我的塔里也充满了极度危险的陷阱和致命的怪兽；没什么不同的。但有一件事使我的塔有些与众不同的地方。”~
@107140 = ~“我在塔里施放了可以扭转魔法本身的强力法术，并使得它的效果与以往不同。听从我的警告吧，我的朋友：塔里施放的法术会产生许多难以预料的结果。”~
@107141 = ~“当然我的学徒还在塔里某处发掘尚不为人知的秘密。他被我选中继续我未竟的工作。”~
@107142 = ~这个前法师叹了口气。“他以前是个好孩子。恭顺，而且为人礼貌。我得承认，我从未正视他真正的价值。但是他现在变了。”~
@107143 = ~“当我放弃魔法师生活的时候，他却开始拥抱它。奇怪的光亮和有色烟雾一次次从塔中冒出，我明白他那是在进行疯狂而又危险的实验。”~
@107144 = ~“我不明白他到底怎么了。他被魔法迷住了。也许他是在研究我给他的那块镜子碎片。”~
@107145 = ~“我本该这么想的。自从我在街上发现那块碎片并给了他以后，他再也没有从塔里出来过。但是我想他已经放弃了。尽管也许是不情愿的。”~
@107146 = ~“但是拜托你，如果你要进塔找他请小心。对你们都有好处，我不想任何人受伤害。我的学徒是个好孩子，他真的是。他只是最近才不像他了。”~
@107147 = ~“他死了，这是你自己说的。我还能对你说什么？”法师叹了口气，“他真的是个好孩子。他真的不该和魔法搅在一起的。”~
@107148 = ~“但你应该明白这一切，就像你已经亲眼所见那些的一样。”~
@107149 = ~“啊，是啊，镜子碎片。就在我们到达幽暗地域后——还有我保证，我真的不知道那怎么会发生的——我只是在大街的这个地方找到一块碎片。”~
@107150 = ~“我发现它有魔法特性，但我已经放弃探寻其中奥妙，所以它对我已经没什么意义了。我把那碎片给了我的学徒。他最近对这类东西非常感兴趣。”~
@107151 = ~“我所知道唯一的一块就是塔中我学徒拿着的那块了。我对其余的真的并不感兴趣，就像我已经放弃了魔法一样。对不起。”~
@107152 = ~“很高兴见到你，<CHARNAME>·<CHARNAME>。我不清楚你在这里干什么，但如果你是想进入我身后那座塔的话，我强烈不建议你这样做。”~
@107153 = ~“我以前曾经被魔法的力量所迷惑。我被驾驭这种神秘力量的强烈欲望所煽动，不顾一切。我抛弃了与我同在的翼精灵并把自己锁在塔里。”~
@107154 = ~“但是当我们的城镇被从失落之峰传送到这个地下山洞——我对这无能为力，我敢断言——我得到了些启示。”~
@107155 = ~“被困在山洞里这么多年，你还去完善什么史上最强大的魔法有什么用？我宁愿做一个生活简单与朋友为伴的普通人也不愿成为一个自我流放的强大法师。”~
@107156 = ~“不幸的是，我的学徒做事不像我。他决心献身于我所抛弃的生活，于是他把自己锁在了塔里。”~
@107157 = ~他耸耸肩。“我想我已经准备好经受一场改变了。现在我可以享受新鲜的空气，我能方便的与人交流，我也不用锁在塔里与我的那些药剂、魔法书和卷轴整天做伴了。”~
@107158 = ~培德尔现出很有兴致勃勃地神色。“好像看起来是很奇怪。我花了无数时间投身于我的研究。但现在……只是因为某些原因那些事已经不那么重要了。”~
@107159 = ~“你的徒弟死了。”~
@107160 = ~“你的徒弟给了我这个魔镜的碎片。”~
@107161 = ~“再见。”~
@107162 = ~“别挡道，老头！”~
@107163 = ~“我可以问你些问题吗？”~
@107164 = ~“你再没有利用价值了，你的死期到了。”[攻击。]~
@107165 = ~“你能告诉我这个塔的什么情况吗？”~
@107166 = ~“和我谈谈你的徒弟。”~
@107167 = ~“你的徒弟还有这个镜子碎片吗？”~
@107168 = ~“你为什么放弃了魔法？”~
@107169 = ~“我在寻找镜子的碎片。”~
@107170 = ~“我是<CHARNAME>·<CHARNAME>。很高兴遇到你。”~
@107171 = ~“为什么？这个塔有什么问题？”~
@107172 = ~“前任大法师？什么意思？”~
@107173 = ~“你怎么能放弃你一生的工作？”~
@107174 = ~火势越来越高。燃烧！燃烧！~
@107175 = ~纸，书页，文字——都随烟而去！~
@107176 = ~我们从书中学习，现在看着它们燃烧。~
@107177 = ~“最终她死了。你做得很好，凡人。”~
@107178 = ~“莫非你就是她所依赖的那个赌注？”~
@107179 = ~“你自己的扩展……？~
@107180 = ~“你的意思……收割者神物？”~
@107181 = ~“你这样计划没有任何可能。”~
@107182 = ~“我必须将你送回地狱。”~
@107183 = ~“但是我们还是盟友，是吧？”~
@107184 = ~“那意味着什么？”~
@107185 = ~“我想，你有建议给我？”~
@107186 = ~“如果你有什么话说，快点？”~
@107187 = ~“你的意思？”~
@107188 = ~“我不知道……也许你是对的……”~
@107189 = ~“非常好。你把自己作了交易。”~
@107190 = ~“我不知道。我应该考虑它。”~
@107191 = ~“我不会听信你说的话，魔鬼！”~
@107192 = ~“忘了它。我信任你不比对她更多。”~
@107193 = ~“她已经把你扯进来了吧？在这个事情中你有什么选择？”~
@107194 = ~“我会相信瓦纱瑞丝，直到给我否定的理由。”~
@107195 = ~“你认为我会相信一个魔鬼的谎言？哈哈！”~
@107196 = ~“我不会轻易叛变的。”~
@107197 = ~“首先，我不会背叛她。”~
@107198 = ~“Vendui'，地表人。你好，你记得我是谁吗？”~
@107199 = ~她的目光冰冷，仍然保持着镇定。“你是个小畜生，，你应该因为如此傲慢而被屠宰，但是我不是来和你互相威胁的。”~
@107200 = ~“我就是瓦纱瑞丝，正如你所知道的。还有你……你证明了是个令人恼火的对手，值得我重视。”~
@107201 = ~“你有名字吗？或者仍让我直呼你为？”~
@107202 = ~“<CHARNAME>？是它。一个合适我逐渐熟悉的脸的名字。我很高兴我们最终相遇了。”~
@107203 = ~她走向你，她的眼睛突然扫遍你的全身，恶作剧地咧嘴笑道：“你已经证明了自己，。一个能够撼动<HIMHER>面前整个幽暗地域的强力<MALEFEMALE>。”~
@107204 = ~“合在一起，我们的力量将无法阻止。有你在我这边，整个幽暗地域都将是我们的……地表世界也一样。”她的眼睛盯着你，闪着急切的野心，“你会怎么回应这个提议？”~
@107205 = ~“真的？”她的笑很温暖，“很高兴知道你能够理智。我觉得在我只需要变的灵活时争论是无意义的。”~
@107206 = ~她斜身靠近，你闻到奇异暗淡的香味。“我们可以互相传授很多，。有很多我们合作的原因，而报酬是无尽的。”~
@107207 = ~瓦纱瑞丝冷冷的瞪着你。“你就这样决定了。地表人，你是个蠢猪。”~
@107208 = ~“去死吧，背叛者！我会看到你跪在我面前……你将真正明白所要承受的是究竟什么！”~
@107209 = ~“那么你需要做的只是一件事。当我的部队攻击立特米亚撒，为他们打开城门。这会证明你的倾向。”~
@107210 = ~她邪恶地笑着。“我有很好的东西给你，。如果你愿意，我可以给你拥有巨大力量的法袍……以后可以满足你所有的欲望，甚至更多。”~
@107211 = ~“你做了明智的选择，地表人。你只需要在我的部队到达立特米亚撒继续隐藏在反抗军里。自己不要放弃。”~
@107212 = ~“现在我会移走海拉斯特施在你身上愚蠢的诅咒。这完成后，你唯一需要记住的是必须打开大门。”~
@107213 = ~“你不会为你做出的决定而后悔的，我确信。”~
@107214 = ~“我会移除我看到施在你身上的诅咒。此后你只需记住我的部队到达时大门必须打开。”~
@107215 = ~“那么让我使你浑身充满力量。我可以让你的能力在一段时间内获得提升。以后当我们在一起的时候，你会得到一切你想得到的力量。好吗？”~
@107216 = ~她脸上闪过轻微的恼怒。“就这样吧。但是快点决定。”~
@107217 = ~她哈哈大笑。“我可以把这个从你身上移除。别担心。”~
@107218 = ~她离开你，表情变得冰冷残酷。“加入我是唯一理智的事。难道你真的认为仅依靠可怜的反抗军的援助就可以成功吗？”~
@107219 = ~“你认为他们很尊重你吗？他们认为你有用。当你完成后，他们会处理掉你。你很聪明，，不是吗？”~
@107220 = ~她暗自发笑道：“你居然这么说，，但是我们真有天壤之别吗？我提供给你的东西难道不是你所渴望的吗？”~
@107221 = ~她热情地笑着说：“当然没有开玩笑。，当我们拥有这么多共同点，我为什么还要抗拒这命定的合作吗？”~
@107222 = ~她笑得很热心。“我看到和你同盟会是最……刺激的，。你愿意成为最高者……像我这样吗？我期待如此。”~
@107223 = ~她笑了，轻轻耸了耸肩道：“就依了你的意思。我只是想给我熟悉的脸一个名字而已。很好，你和我终于相遇了。”~
@107224 = ~“？在你的语言里它只意味着‘<MALEFEMALE>’，没有其他意思。我更希望叫你的名字，如果你愿意告诉我的话。”~
@107225 = ~她高兴的笑了。“如你所愿。我是欣维儿，巴厘塔家族的主母，还是伊尔西里的瓦纱瑞丝。”~
@107226 = ~她做了个失望的怪相。“那么这就是全部了？我用尽了办法让我们碰面。并不是有意要造成不愉快。”~
@107227 = ~她做了个失望的怪相。“这里不需要如此多敌意，。这不意味着一次不愉快的偶遇，这是我们的相会。”~
@107228 = ~“<CHARNAME>·<CHARNAME>？就是它，一个名字放在我已熟悉的脸。我很高兴我们终于相遇了。”~
@107229 = ~卓尔朝你傻笑并扬了扬眉毛。“真的？我宁愿把那看做赞美而不是完全无知的暗示，。”~
@107230 = ~她轻笑发出低沉阴险的声音：“，你是个无知的傻瓜，还是马屁专家。不过……我不是女神。”~
@107231 = ~“真的。你不是傻子。，已经证明你是最麻烦的对手，值得我注意。”~
@107232 = ~“这个？地表人，这是施在你身上的幻术，为了我们能安全相遇。这不需要担心，即使你知道我是谁。”~
@107233 = ~滚蛋！~
@107234 = ~“一些我喜欢屠宰的人？”~
@107235 = ~“这已足够。你为什么来这里？”~
@107236 = ~“我的名字是<CHARNAME>。”~
@107237 = ~“我应该考虑这样的同盟者……”~
@107238 = ~“我宁愿把你打入九渊地狱！”~
@107239 = ~“我不感兴趣。”~
@107240 = ~“也许你是对的……”~
@107241 = ~“别做梦！我宁愿死也不会帮助你。”~
@107242 = ~“出卖反抗军？我决不会这样做。”~
@107243 = ~“如果我们要成为同盟者我需要直接的回报。”~
@107244 = ~“不……我已经决定我只是要杀了你。”~
@107245 = ~“非常好。你已经让自己成为盟友。”~
@107246 = ~“对不起，不够好。”~
@107247 = ~“我宁愿要别的东西。”~
@107248 = ~“算了，这个法袍已经足够好了。”~
@107249 = ~“我很高兴这样做，但是我在诅咒下和你战斗。”~
@107250 = ~“你可以移除诅咒？那我们还要等什么？”~
@107251 = ~“你认为你对我有吸引力？别犯傻了。”~
@107252 = ~“对不起，你正好不在我喜欢的类型。”~
@107253 = ~“一直以来我都干得相当不错。”~
@107254 = ~“背叛我的朋友？出卖先知和反抗军。”~
@107255 = ~“我决不会和你这样的家伙合作！”~
@107256 = ~“你和我一起工作？你在开玩笑吗？”~
@107257 = ~“我希望你在我这边。”~
@107258 = ~“只要你愿意随便叫我什么。我不介意。”~
@107259 = ~“这个词的确切意思是什么？”~
@107260 = ~“首先告诉我你的名字。我知道‘瓦纱瑞丝’只是个称号。”~
@107261 = ~“好的。现在告诉我你为什么在这。”~
@107262 = ~“还有你可以称我为你的敌人。”~
@107263 = ~“还有我叫<CHARNAME>·<CHARNAME>。”~
@107264 = ~“一个好看的卓尔，如果我可以这么说。”~
@107265 = ~“您看上去不就是罗丝本人吗，对吗？”~
@107266 = ~“你一定是瓦纱瑞丝。”~
@107267 = ~“这是什么？你是怎么进入这里的？~
@107268 = ~“你愿意再讨论一下同盟吗？”~
@107269 = ~“反抗军胜利了，卓尔。你的时代结束了。”~
@107270 = ~“你是个傻子把我带得这么近甚至能杀了你。”~
@107271 = ~“我是谁！我是怎么到这里的？”~
@107272 = ~“你想从我这得到什么？”~
@107273 = ~“谈判对我们来说还不算晚。”~
@107274 = ~“现在你是个傻瓜。你该去死了。”~
@107275 = ~“你不能把我当作囚犯。”~
@107276 = ~“我属于你，瓦纱瑞丝。我坚持我压的注。”~
@107277 = ~“现在还有什么能阻止我杀了你。”~
@107278 = ~“还有谁才是你这里的魔鬼？”~
@107279 = ~“我对你提议的权力和财富更感兴趣。”~
@107280 = ~“拴了皮带的猎狗，那是我该做的吗？”~
@107281 = ~“你怎么控制这样强大的人呢？”~
@107282 = ~“我明白了，现在你希望我们做什么呢？”~
@107283 = ~“为什么你真的带我来这里？”~
@107284 = ~“什么都没有。只是友好的闲聊。”~
@107285 = ~“我不喜欢你讲话的腔调。”~
@107286 = ~“你的魔王试着背叛你，这就是所发生的事。”~
@107287 = ~“等等！这事不是看上去的那样……”~
@107288 = ~“卓尔，我们已经决定不在需要你了。”~
@107289 = ~“看上去你不能如愿控制魔王了。”~
@107290 = ~“你现在不想知道？”~
@107291 = ~洛斯兽不理你，继续咀嚼嘴中反刍物。~
@107292 = ~当你接近时这个野兽的注意力暂时集中在你身上。当它意识到你不是带给它下顿食物的牧人，它接着咀嚼嘴中反刍物。~
@107293 = ~洛斯兽觉得你的气味比一个漂浮的巨眼要好的多。没有洛斯兽好，还是不错的。~
@107294 = ~洛斯兽憎恨眼魔将它们作为牧群锁在洞穴不问，直到他们需要吃点食物。有哪种文明会做这样的事。~
@107295 = ~野兽告诉你牧群存在令人愤怒的管理问题。它认为那里也许有叫疯洛斯兽病的流行病。~
@107296 = ~洛斯兽告诉你怀疑巨眼真的是变异的卓尔。~
@107297 = ~洛斯兽低声将秘密从一个洛斯兽到另一个在牧群中传递。显然他们相信你沿着隧道走得够远，你就会到达传奇的幸福牧场。~
@107298 = ~野兽朝眼魔住的方向往去希望它给他们的眼睛狠狠的踢上一脚。~
@107299 = ~“是，主人？”~
@107300 = ~“是的，我的朋友？”~
@107301 = ~“当然“~
@107302 = ~“我们将战斗到最后。”~
@107303 = ~“继续。”~
@107304 = ~“请回到城市核心保护先知。”~
@107305 = ~“我需要你保卫右边的内塔。”~
@107306 = ~“我需要你保卫右边的外塔。”~
@107307 = ~“我需要你保卫左边的内塔。”~
@107308 = ~“我需要你保卫左边的外塔。”~
@107309 = ~“我需要你保卫左边的庭院。”~
@107310 = ~这个地表人擅长躲避，很难被消灭。也许有什么东西……和你说的有关。也许比所能看到的东西还多。~
@107311 = ~你。男子汉！去叫指挥官们！我需要他们立即到场。~
@107312 = ~如果必须我会集聚剩余的部队。反抗军必须消灭，而地表人将再也无法躲避我。~
@107313 = ~“欢迎你冒险者。如果要开始新的游戏，请选择清除数据库选项。~
@107314 = ~去幽灵村冒险。~
@107315 = ~清除数据库~
@107316 = ~TEMP*我现在无话可说。~
@107317 = ~<CHARNAME>欢迎回来。我只是回来帮助检验包围。~
@107318 = ~好的——告诉我你做了什么鬼计。~
@107319 = ~好的——现在你工作得过于辛苦-你需要休息。回到旅馆你的房间试着休息。当我们的哨兵报告瓦纱瑞丝的军队接近时我们会叫醒你。~
@107320 = ~我完成了。~
@107321 = ~龙巫妖（反抗军招募使徒帮助他们）~
@107322 = ~龙巫妖（反抗军没有招募使徒）~
@107323 = ~创造者之岛（反抗军现在有些魔像守卫）~
@107324 = ~创造者之岛（反抗军没有任何魔像守卫）~
@107325 = ~龙巫妖（主母的军队中没有僵尸）~
@107326 = ~龙巫妖（主母的军队中有僵尸）~
@107327 = ~眼魔母巢女王（主母的军队中没有眼魔）~
@107328 = ~眼魔母巢女王（主母的军队中有眼魔）~
@107329 = ~主脑（主母的军队中没有灵吸怪）~
@107330 = ~主脑（主母的军队中有灵吸怪）~
@107331 = ~你可以在魔像的3个法术栏存入法术。战斗中，魔像在进行普通攻击前施放法术。你要在哪个法术栏存入法术？~
@107332 = ~选择你要存入这个栏的法术等级。~
@107333 = ~选择法术：~
@107334 = ~选择法术：~
@107335 = ~选择法术：~
@107336 = ~选择你希望的法术存入这个栏。~
@107337 = ~保持法术栏原状。~
@107338 = ~栏3（当前储存的法术：）~
@107339 = ~栏2（当前储存的法术：）~
@107340 = ~栏1（当前储存的法术：）~
@107341 = ~返回选择另一个法术栏。~
@107342 = ~等级4~
@107343 = ~火墙术~
@107344 = ~魅影杀手~
@107345 = ~次级法术无效结界~
@107346 = ~次级法术穿透~
@107347 = ~艾萨克次级飞弹风暴~
@107348 = ~高级隐形~
@107349 = ~冰风暴~
@107350 = ~恐惧术~
@107351 = ~艾伐黑触手~
@107352 = ~弱能术~
@107353 = ~元素护盾~
@107354 = ~疫病术~
@107355 = ~困惑术~
@107356 = ~降咒~
@107357 = ~等级3~
@107358 = ~吸血鬼之触~
@107359 = ~臭云术~
@107360 = ~减速术~
@107361 = ~闪光球~
@107362 = ~防护元素魔法~
@107363 = ~梅斯狄强酸吐息~
@107364 = ~闪电术~
@107365 = ~隐形法球~
@107366 = ~人类定身术~
@107367 = ~加速~
@107368 = ~造风术~
@107369 = ~火焰箭~
@107370 = ~火球术~
@107371 = ~移位术~
@107372 = ~解除魔法~
@107373 = ~等级2~
@107374 = ~蛛网术~
@107375 = ~塔莎狂笑术~
@107376 = ~识破隐形~
@107377 = ~抵抗元素伤害~
@107378 = ~马友夫强酸箭~
@107379 = ~次级解除魔法~
@107380 = ~隐形~
@107381 = ~食尸鬼之触~
@107382 = ~盖德利的电击环~
@107383 = ~坚韧术~
@107384 = ~亡者护甲~
@107385 = ~黑暗术~
@107386 = ~消耗术~
@107387 = ~轻灵术~
@107388 = ~蛮力术~
@107389 = ~目盲术/耳聋术~
@107390 = ~巴拉冈的铁号角~
@107391 = ~等级1~
@107392 = ~返回选择另一个法术栏~
@107393 = ~克敌机先~
@107394 = ~睡眠术~
@107395 = ~护盾术~
@107396 = ~惊恐术~
@107397 = ~衰弱射线~
@107398 = ~负能量光线~
@107399 = ~魔法飞弹~
@107400 = ~法师护甲~
@107401 = ~钢铁腑脏~
@107402 = ~冰匕首~
@107403 = ~霍瑞兹考勒轰鸣~
@107404 = ~油腻术~
@107405 = ~脚底抹油~
@107406 = ~虹光喷射~
@107407 = ~燃烧之手~
@107408 = ~在你面前有个木制小桶。它看上去像蜡烛一样有个小的芯子伸出桶的顶部。~
@107409 = ~不动小桶。~
@107410 = ~点燃芯子。~
@107411 = ~扛起炽火胶桶。~
@107412 = ~娜西拉的眼睛跟着你，估量着。她仅仅点头看着你离开。~
@107413 = ~娜西拉叹了口气，很明显她不愿意讨论这个话题：“我曾经充当瓦纱瑞丝的刺客。但是我现在已经摆脱了这些日子。”~
@107414 = ~她点头，因为不再谈论她过去堕落日子的话题而感到轻松。~
@107415 = ~“我在山脉下面帮助你。我还答应帮助你对抗瓦纱瑞丝。而且我还向先知和其他人证明自己很多次了。~
@107416 = ~“我不能使你相信我。现在我的忠诚属于先知。如果你不相信我真的已经离开了红色姐妹，这是你的问题，而不是我的。”~
@107417 = ~“你不是第一个问我的人……尽管我觉得即使现在我也不习惯被被别人误解。但我宁愿不说这些。至少现在不。”~
@107418 = ~卓尔摇着她的头：“我离开的决定是有力的，个人的-还有私密的-经验。我不准备和你，我仅知道你的名字叫<CHARNAME>，讨论它。”~
@107419 = ~“在我看来你这一刻好像有足够的帮手了。我必须保护先知……这是我首要责任。如果你以后真的需要我，无论如何，我都乐意和你一起旅行。”~
@107420 = ~娜西拉咧嘴笑，看起来放松了：“我希望你会问。我很乐意和你一起旅行。主动采取行动远比在这里等瓦沙瑞斯行动要好。”~
@107421 = ~“我会一如既往的支持你对抗瓦纱瑞丝，但是你首先要知道一些你要面对的挑战。”~
@107422 = ~“我认为我们没多少可能劝阻那些支持瓦纱瑞丝的卓尔。卓尔家族的支持率会基于她的成就而增大或者减少，但不会有本质改变。”~
@107423 = ~“然而她的部队大部分来自卓尔之外的种族……灵吸怪、眼魔和不死军团。对付这些她的盟军，我们可以发动一击。”~
@107424 = ~“那么我希望我能成为帮手。”~
@107425 = ~“就我所知无法和他正面作战，而且据报告，他也不会背叛瓦纱瑞丝。你要同瓦纱瑞丝战斗，必先同他战斗。”~
@107426 = ~“不过，我们也有可能找到威力巨大的神器，用它来对抗魔鬼。”~
@107427 = ~“我很想告诉你该到哪里寻找这种东西，但是我确实不知道。或许其他人，比如瓦伦，也许能帮助你更多。”~
@107428 = ~“还不完全清楚。我们听到传言：附近有亡灵巫师教派给瓦纱瑞丝提供僵尸，尽管不知道他们如何得到‘零件’。”~
@107429 = ~“尽管精确的位置我说不清，但我确信这个教派位于西边的洞穴。如果我们能发现他们，就能找到僵尸的源头，进而摧毁它。”~
@107430 = ~她打着哈欠，倦怠地伸懒腰：“她再也不能做什么了，感谢你干掉了龙巫妖。”~
@107431 = ~“我不认为瓦纱瑞丝控制了很多眼魔，当然也不需要太多。它们每一个都具有从眼柄发射不同效果的魔法射线的能力。”~
@107432 = ~“它们都来自于西面某处巢穴。如果我们消灭统治它们的眼魔暴君，该殖民地就会崩毁而瓦纱瑞丝就会失去它们的支持。”~
@107433 = ~娜西拉考虑了一会儿，掰着手指头说：“碎裂。麻痹。疼痛。我看到过它们中间的眼睛曾发射出能造成这些伤害的魔法。”~
@107434 = ~“此外我建议你亲自去看看。”~
@107435 = ~“我想我们没有谈判的筹码。仅知的事实是统治它们的眼魔暴君选择和瓦纱瑞丝同盟，这意味着它认为我们的敌人远比我们强大。”~
@107436 = ~“同它们作战要小心。尽量远离它们放出的射线。作战前在你身上加一些魔法防御会有效地防护它们的眼射线。”~
@107437 = ~“然而射线不是它们唯一的武器。某些眼魔是有造诣的法师……还有，作为最后的手段，它们的咬也能致命。”~
@107438 = ~“不过普通的眼魔没有防御魔法或者武器的特殊铠甲。针对大多数生物的杀伤性手段都能用来杀死它们。”~
@107439 = ~“谢谢你，我们对眼魔暴君和她的手下没有什么恐惧。我们不需要讨论它们。”~
@107440 = ~“哪种你叫做夺心魔的生物是心灵感应一族，能够阅读思想和控制意志。它们以控制其他生物作为奴仆和守卫而闻名。”~
@107441 = ~“这些生物由被称作主脑的实体控制。瓦纱瑞丝军队中有很多灵吸怪，看来她已获得一些主脑支持了。”~
@107442 = ~“这西面是佐瓦柯穆，一个小的灵吸怪殖民地。如果我们能发现佐瓦柯穆的主脑，就能说服它相信其他的主脑撤回了支持瓦纱瑞丝的灵吸怪。”~
@107443 = ~“什么？”~
@107444 = ~她耸了耸肩：“说实话，我决不会做。我确信它们会像其他生物一样倒在刀下……事实上它们的身体看上去很脆弱。你只需当心它们的精神力量。”~
@107445 = ~“我相信伊蒙罗可能有更多的同它们战斗的经验。如果你需要战术上的建议，去问他。”~
@107446 = ~她耸了耸肩：“我不想讨论这些。屠杀整个佐瓦柯穆殖民地。其他的主脑会站在瓦纱瑞丝一边。”~
@107447 = ~她看着你，挖苦道：“你已经把夺心魔从她的军队中除去。我相信不再需要再讨论它们了。”~
@107448 = ~“许多瓦纱瑞丝的支持者像灵吸怪和眼魔居住在这个村子西边的洞穴。西边的洞穴也可能是不死军团的来源。”~
@107449 = ~“我们也许能使她的这些盟友脱离她。我知道那些种族的一些情况，如果你需要，不要担心来问我。”~
@107450 = ~这个卓尔在你接近她的时候脸上露出好奇的表情，白色的眉毛弯了起来。~
@107451 = ~“如果你不在诅咒状态下，你会告诉我它根本不能给你制造麻烦，瓦纱瑞丝威胁你的世界如同我的世界。”~
@107452 = ~“哦，真的？你不关心她对你的世界如同我的世界是个威胁？”~
@107453 = ~“你会等到瓦纱瑞丝出现在地表，那时她将变得最强大？即使那不是事实，你就一点不担心她要杀死你？”~
@107454 = ~她脸上闪过恼怒：“不是仅依靠你一个人。我们的居民也在这里的战线上。先知和她的人民放弃了地表的家园来和瓦纱瑞丝战斗，你至少要应该做些什么？”~
@107455 = ~“即使那对你没有意义，瓦纱瑞丝要杀你的事实呢？你就一点不担心？”~
@107456 = ~“你将瓦纱瑞丝赶出山下地城，她还会发现另一条路，所以你的任务没有结束。即使这样，瓦纱瑞丝要杀你的事实就不使你有点担心吗？”~
@107457 = ~“你自己呢？瓦纱瑞丝要杀你的事实就不使你有点担心吗？”~
@107458 = ~“我知道了。即使如此，瓦纱瑞丝要杀你的事实就不使你有点担心吗？”~
@107459 = ~“据我所知，瓦纱瑞丝已经攻击了你的地表世界，即使她不会再做同样的事，她要杀你的事实就不使你担心吗？”~
@107460 = ~她看来要说话，以轻微的怀疑表情看着你：“我不确定你是认真还是开玩笑。但瓦纱瑞丝不是玩笑。”~
@107461 = ~她傻笑。“虚张声势。瓦纱瑞丝要杀你的事实就不使你有点担心吗？”~
@107462 = ~“你已经看到证据，不是吗？你的地表世界受到攻击，强大的海拉斯特取得统治权……你就不会被瓦纱瑞丝军队攻击吗？这些事情不是我们说的证据？”~
@107463 = ~“好的。那些还不够，瓦纱瑞丝要杀你的事实就不使你有点担心吗？”~
@107464 = ~她耸了耸肩：“还不相信我。这没有关系，随你的便。不谈别的，瓦纱瑞丝要你死……这一点儿也不让你担心吗？”~
@107465 = ~她仔细的打量你，过了一会慢慢点头：“终究先知可能是对的。我想我们应该明白。”~
@107466 = ~“你认为它会有趣，是吗？瓦纱瑞丝要杀你的事实就不使你有点担心吗？”~
@107467 = ~“只要没有打败她。”她仔细的打量你，过了一会慢慢点头，“终究先知可能是对的。我想我们会知道的。”~
@107468 = ~“可能你的想法基于你的实力。”娜西拉研究你很长时间，“那看上去没有关系，就像我说的。”~
@107469 = ~娜西拉仔细的打量你，过很长时间最后耸肩：“好的。你有信心。我祝福你。希望它能很好帮助你。”~
@107470 = ~“真的？这些话不是来自于施在你身上的诅咒，是吗？”~
@107471 = ~她仔细的打量你，过了一会慢慢点头：“那是真的。尽管我怀疑诅咒对你起的作用比你宣称的要小。”~
@107472 = ~“我该走了。”~
@107473 = ~“你说过你是红色姐妹的一员。”~
@107474 = ~“我还要问你一些事情。”~
@107475 = ~“我怎么知道能不能相信你？”~
@107476 = ~“我不想让你不安。”~
@107477 = ~“为什么你要走？”~
@107478 = ~“你愿意加入我们吗？”~
@107479 = ~“告诉我关于瓦纱瑞丝和她的盟友的事情。”~
@107480 = ~“这是所有我想知道的。”~
@107481 = ~“那个她所奴役的魔鬼是怎么回事？”~
@107482 = ~“瓦纱瑞丝是怎么控制一个不死生物部落的？”~
@107483 = ~“关于眼魔你能告诉我什么呢？”~
@107484 = ~“它们的眼睛射线会造成什么伤害呢？”~
@107485 = ~“有可能和这些生物进行谈判吗？”~
@107486 = ~“怎么才能和眼魔作战呢？”~
@107487 = ~“你了解灵吸怪的事情吗？”~
@107488 = ~“我还想问些事情。”~
@107489 = ~“怎样才能和这些生物作战呢？”~
@107490 = ~“应该杀光这种生物，而不是和它们进行什么谈判。”~
@107491 = ~“你现在要加入我吗？”~
@107492 = ~“我没有多少选择。我受到了诅咒，忘了吗？”~
@107493 = ~“我不得不考虑瓦纱瑞丝。”~
@107494 = ~“当然它与我有关。这就是我为什么在那儿而不在这里。”~
@107495 = ~“也许吧。不过我不知道为什么这个担子应该我一个人扛着。”~
@107496 = ~“我的任务在山下地城已经结束了。我不想当什么英雄。”~
@107497 = ~“不。为什么我要替其他人的事情操心？”~
@107498 = ~“它真的是一个威胁到世界的危险吗？我很怀疑你推断的准确性。”~
@107499 = ~“她没办法威胁到地面世界。”~
@107500 = ~“我同意。一个卓尔女王和一个强大的魔鬼合伙？恐怖的结合。”~
@107501 = ~“当我和他们在一起的时候，他们会的。”~
@107502 = ~“我只需要证据来证明这一切是真的。”~
@107503 = ~“我认为这有可能。”~
@107504 = ~“我没有理由相信你说的或是做的事情。”~
@107505 = ~“瓦纱瑞丝的证据，是的。我也没有你的动机的证据。”~
@107506 = ~“或许不，不过这个诅咒意味着我没有任何选择。”~
@107507 = ~“我绝对认真。毫无疑问，他们必须被阻止。”~
@107508 = ~“听起来很刺激！我等不及了！”~
@107509 = ~“的确如此。不过，我做不了什么。”~
@107510 = ~“如果我要一直担心死去的可能，我什么都做不了。”~
@107511 = ~“我只想拿回我的东西。我还是不相信是她偷了这些东西。”~
@107512 = ~“她最近发起的攻击是想显示自己的实力吗，不。”~
@107513 = ~“她该开始多担心我一点了。好像是这样了。”~
@107514 = ~“我在做我必须做的事情，为了所有人的好。”~
@107515 = ~“不，当然不。”~
@107516 = ~“或许吧。毕竟，在这方面我没什么选择。”~
@107517 = ~“我没有发现任何关于诅咒的证据。”~
@107518 = ~卓尔尊敬地看着你，试图从不安中获得安逸。她和其他卓尔一样永不显老，一样拥有漂亮的暗色皮肤……不过与其他人不同的是，她的眼睛流露出年长和关切。~
@107519 = ~“我认为我可以回答，先知。<CHARNAME>·<CHARNAME>从瓦纱瑞丝那里救出了海拉斯特，阻止了她把山下地城作为攻击地面的基地的企图。”~
@107520 = ~“然而，海拉斯特被她滥用他的王国的企图激怒了。当他重获自由，他就把<CHARNAME>和我传送到这里来……希望能一劳永逸的解决瓦纱瑞丝。”~
@107521 = ~“真的？当我在这儿看到你俩的时候，我就希望<CHARNAME>已经欣然加入了我们。”~
@107522 = ~“可以这么说，<HESHE>已经……按照他的想法……动手了。那个疯狂的魔法师对<CHARNAME>施法，企图强迫<HIMHER>去干掉瓦纱瑞丝。”~
@107523 = ~“我知道了。”先知转过头面对着你，似乎很难受，“我很抱歉他竟然这么对待你，<CHARNAME>。我并不想这样获得你的帮助。”~
@107524 = ~“但是事情已经发生了，我们只能由此进行下去。”她对你慈祥地微笑着，“尽管海拉斯特强迫你加入了我们，但是你自己的命运实际上和我们休戚相关。”~
@107525 = ~她微微的笑着：“我从没有想到你会来，我的朋友。你的到来真的是一个惊喜。”~
@107526 = ~她迷一般的微笑着。“那么，现在，我的朋友，我们似乎该开始这场小小的冒险了。”~
@107527 = ~“我的朋友，我没有侮辱你的意思。只是卓尔语言中缺少对你的种族的称呼。如果你愿意，我想叫你<CHARNAME>。”~
@107528 = ~“我很高兴你对此这么理智，如果我们希望能打败共同的敌人，就需要我们的精诚合作。”~
@107529 = ~先知悲伤的点点头。“我能理解你的想法。不过这个疯狂的海拉斯特没有给你多少帮助。象他这种法力下的法术不太容易去掉。~
@107530 = ~“只要可以，我们会帮助你。不过现在没什么能做的。你和我们拴在了一起；我们有共同的敌人。”~
@107531 = ~“不，你没有多少选择。我们必须精诚合作才能打败共同的敌人。”~
@107532 = ~“我觉得瓦纱瑞丝可能不会这么想。想想海拉斯特放在你身上的诅咒，你现在没有别的选择只能去试着消灭她。”~
@107533 = ~“命运已经注定你一个人就可以阻止瓦纱瑞丝……这给了我们足够的理由来支持你。”~
@107534 = ~先知慢慢的点点头，似乎有点犹豫，不过还是决定继续：“是的，这是一个好问题。我们现在该做什么呢？”~
@107535 = ~“你确定吗？因为海拉斯特对你发出的诅咒，似乎你在这件事上没什么选择的余地……至少现在是这样。”~
@107536 = ~附近的泰夫林走上前来，明显带着警惕的表情：“你确信，先知？我们怎么能相信这个……这个<MANWOMAN>？<HESHE>或许会害死我们大家！”~
@107537 = ~先知举起她美丽的纤手：“我们的生命并不重要，亲爱的瓦伦。无论如何瓦纱瑞丝都必须被阻止，<CHARNAME>是阻止她的关键人物。”~
@107538 = ~“你知道我并不赞同你的方式，先知。我不想糊里糊涂的跟着一个人丧命，我相信大家都不想这样。”~
@107539 = ~“你救了我们大家很多次，瓦伦。但是瓦纱瑞丝的军队很快就要来对付我们了，现在即使靠着你在战场上的天才也无法拯救我们了。”~
@107540 = ~泰夫林满面怒容：“我希望能遵从您现在的判断，先知。不过，是什么让您认为这个陌生的<RACE>可以阻止瓦纱瑞丝的军队？”~
@107541 = ~先知转过来面对着你：“<CHARNAME>，我知道你是个强有力的<RACE>。不过事实上你的实力比这还要多得多。你一个人就可以把我们从瓦纱瑞丝那里拯救过来。”~
@107542 = ~“所有在立特米亚撒这儿的卓尔都会奋起反抗瓦纱瑞丝，她是我们大家共同的敌人。但是即使靠着我们团结的力量也不足以抗拒她强大的军队。”~
@107543 = ~“我们唯一的希望就是你找到办法来加强我们的实力，或者削弱瓦纱瑞丝和她同盟的力量。娜西拉能在这一点上帮助你。”~
@107544 = ~“我可以提供关于瓦纱瑞丝同盟和他们位置的情报。或许我们可以通过她的那些朋友来打击她，或者把他们拉到我们这一边。”~
@107545 = ~瓦伦——泰夫林战士——补充道：“我也可以帮你，<CHARNAME>。我很了解幽暗地域的传说。我听说过很多关于强力物品的传闻，还有那些可能帮助我们的力量。”~
@107546 = ~瓦伦耸耸肩。“或许你不是。不过考虑我们现在同舟共济，那么我们也只能一起合作了。”~
@107547 = ~“我并没有放弃我的怀疑。不过既然先知认为你是那个救世主，我也愿意给你机会来证明。”~
@107548 = ~“那么看起来你并不孤单，<CHARNAME>。娜西拉和瓦伦都会帮助你。他们很了解幽暗地域和瓦纱瑞丝——尽管要求他们帮助你吧。”~
@107549 = ~“你很有希望能找到办法来加强我们自己的力量——或者削弱瓦纱瑞丝——在他的军队攻击我们之前。”~
@107550 = ~“愿生命和祝福永存，我的朋友。”~
@107551 = ~“帮助我们就是帮助你自己，<CHARNAME>。记住海拉斯特对你下的诅咒。如果你没有办法能消灭瓦纱瑞丝，你会走向死亡。”~
@107552 = ~“然而，你是这里的一部分。命运——还有海拉斯特对你下的诅咒——迫使你去面对瓦纱瑞丝。”~
@107553 = ~“那么，还有需要我的地方吗？”~
@107554 = ~“愿生命和祝福永存。”~
@107555 = ~先知点点头：“很好，我会回答我能回答的问题。希望我的知识可以帮助你找到削弱瓦纱瑞丝的办法。”~
@107556 = ~“除了你知道的没有更多的了。她的军队仍然很庞大。如果你在开战前找不到削弱她力量的办法，我怀疑我们是否还有能力奋起抗击。”~
@107557 = ~她叹了一口气：“那我不能说。尽管我是先知，我的视野仅限于伊丽丝璀想告诉我的东西。悲哀的是，我不知道该怎么去削弱瓦纱瑞丝。”~
@107558 = ~“但是，娜西拉和瓦伦都会帮你。和她们谈谈吧。他们可能可以帮你一些忙。”~
@107559 = ~“在你所处的地表世界之下，比所谓山下地城的地下城还要低的地方，存在着一个巨大的国度，这里有广大的洞穴、黑湖，我们统称它为幽暗地域。”~
@107560 = ~“这里卓尔与灵吸怪、眼魔还有灰矮人等很多生物一起统治着这个世界。幽暗地域是邪恶与恐惧并存的地方，别犯错误……这里每迈出一步都必须特别小心。”~
@107561 = ~“更准确的是，我们现在是在一个遥远的卓尔小村落，它叫立特米亚撒，坐落于回忆之湖的另一端。在这里我们还是安全的……不过瓦纱瑞丝来之后就……。”~
@107562 = ~“我还没有想到。可能有办法可以把你传送回地面世界……但我觉得对你所下的诅咒会阻止你这么做。”~
@107563 = ~“那你就是个傻瓜，如果你试图离开幽暗地域，我肯定海拉斯特的诅咒会让你迅速并痛苦地死去。”~
@107564 = ~先知重重的叹了一口气：“我没有骗你，<CHARNAME>。我们联合的反抗军比瓦纱瑞丝要差的多。我们并没有做到多少。”~
@107565 = ~“在立特米亚撒这里，我们决定奋起反抗……但是我们自己也知道很难有机会战胜瓦纱瑞丝的强大力量。”~
@107566 = ~“灰矮人是地面矮人的近亲，不过是灰色的皮肤。他们不爱说话，工作勤劳，比地面的那些矮人要更狡猾和诡诈。”~
@107567 = ~“我很奇怪你怎么会不知道。你是一个地表矮人……灰矮人是你们地面矮人的近亲，他们居住在幽暗地域。他们不爱说话，工作勤劳，比你们这些地面矮人要更狡猾和诡诈。”~
@107568 = ~“灰矮人有很多理由来痛恨卓尔，但他们很多人也会因为利益的缘故投靠那些有钱收买他们的人……瓦纱瑞丝就是其中之一。”~
@107569 = ~“它们好像是很多眼柄上浮动的眼球，每个眼球都能发出不同的魔力冲击波。这会让人痛苦、迟钝、僵硬……甚至粉身碎骨。”~
@107570 = ~“它们使用这类能力没有次数的限制，所以小心点。如果发现自己在它们的隧道里，最好赶紧找条路出来。”~
@107571 = ~“可怕的怪物，长着空洞的眼睛，触须一样的嘴。我认为，你们也把它叫做‘夺心魔’。”~
@107572 = ~“它们极为狡诈，可以利用精神的力量打晕你，让你无能为力……如果有机会，它会侵入你的头脑，甚至把你变成没有思想的奴隶。”~
@107573 = ~“我的朋友，我并不是无所不知。很久以前我是一个大家族的女儿，像很多人一样野心勃勃，希望获得自己的权力。”~
@107574 = ~“然而，卓尔并不是天生如此。”她对周围的卓尔做个手势。“我追随伊丽丝璀女士，她向我授予这项神力，就像她的追随者一样。”~
@107575 = ~“所以我被称为先知，现在过去了很多年，我的本名也被大家遗忘了。无论如何，这已经过去了。现在我把自己献给了伊丽丝璀。”~
@107576 = ~“我看到的是神容许我看到的东西。我看到卓尔会陷入混乱，瓦纱瑞丝会从中崛起。”~
@107577 = ~“我看到了我的人民的命运和我们的位置。这就是我们放弃地面世界来到幽暗地域的原因。”~
@107578 = ~“并且我也看到你，。这就是我如何知道你会来的原因。”~
@107579 = ~“你会来到，你会是带来瓦纱瑞丝失败的人。”她的眼睛闭上了。“但你已经了解了我所说的，不是吗？”~
@107580 = ~“我知道我所看见的，瓦纱瑞丝有很多办法来发现这些。她也知道这些事情，所以你也面临着危险，她不会坐以待毙，只有你的死才能让她安心。”~
@107581 = ~“我认为，你还在地面世界时她就想杀了你。我也能保证这不是最后一次。”~
@107582 = ~“没有必要对我撒谎，。瓦纱瑞丝是你的敌人，不是我。她也知道这一点。你面临着危险，她不会坐以待毙，只有你的死才能让她安心。”~
@107583 = ~“那么我必须告诉你，你面临着危险，她不会坐以待毙，只有你的死才能让她安心。”~
@107584 = ~她点点头。“那么你了解了这一点。瓦纱瑞丝也知道这些事情。她不会坐以待毙，只有你的死才能让她安心。”~
@107585 = ~“我们的认识不同，我们选择了放弃唤起那个充满残忍和仇恨的社会。如果他们那样做的话，我们会感到深深的自责。”~
@107586 = ~“事实是现在我们回到了幽暗地域，并决定为了重建我们人民的生活秩序而战，但这并不意味着我们赞同他们的做法。我们并不想让他们陷入死亡和混乱。”~
@107587 = ~“我领导着伊丽丝璀的追随者，是的，尽管并不是这里所有的卓尔都同意我的观点。很多卓尔根本不信仰伊丽丝璀，然而我是我的女神的选择。”~
@107588 = ~“我是一个卓尔。我过去习惯于不信任别人。然而，如果你给我机会，即使你不需要朋友，我也可以做一个有价值的盟友。”~
@107589 = ~“是的，帐篷外面有很多人。然而，瓦纱瑞丝的人要多得多。”~
@107590 = ~“为什么呢？我并不希望每个人都像我一样信仰她，你在这里也不是因为宗教政府，不是吗？”~
@107591 = ~“然而，你并非我的人质，我也不想指导你。是那个疯狂的海拉斯特给你施加了诅咒，这是他做的，并不是我们的本意。”~
@107592 = ~先知的眼睛闪动着，脸上露出了温暖的微笑。显然这个话题很合她的心。“很多人都不知道，但并非所有的卓尔都是邪恶的。”~
@107593 = ~“我们的女神伊丽丝璀是欢歌和舞蹈的神，她拒绝让欢乐和善良离开我们。”~
@107594 = ~“她是我们的救赎，我们大家都曾经到过地面世界，想要挣脱黑暗的束缚。事实上，我们却不可能忘记自己在幽暗地域中曾经不止一次地为她事业服务。”~
@107595 = ~“事实并非如此。这是蜘蛛女神罗丝的神殿，我们把它作为避难所。我相信她并不介意。”~
@107596 = ~“罗丝消失了。”先知非常困惑的皱着眉头。“她的女祭司再也施展不出法术了，她曾经铁腕控制的地区在她消失后分崩离析。”~
@107597 = ~“这场混乱被瓦纱瑞丝利用，并获得了巨大的势力。罗丝还会回来吗？”她耸耸肩，“谁知道呢？”~
@107598 = ~“你知道，瓦纱瑞丝的计划不仅仅威胁着幽暗地域。她威胁着我们大家，伊丽丝璀会和我们一起组织她。”~
@107599 = ~“感谢上天，我们并不孤单。尽管他们的信仰和我们并不相同，但是大家都团结起来希望阻止瓦纱瑞丝。我们为同一目的而战。”~
@107600 = ~先知皱着眉头，她的眼睛陷入了黑暗。“我希望只是常识。我们面对着同一个对手瓦纱瑞丝，这至少是你横刀而立的理由。”~
@107601 = ~“如果不这样，那么你会被卓尔的军队包围起来……只要在一眨眼间，他们就会向入侵者发起攻击。”~
@107602 = ~突然她叹口气放松下来。“但是我不想威胁你。我们必须团结而战，<CHARNAME>。”~
@107603 = ~“所有反抗瓦纱瑞丝的人都在立特米亚撒这里团结起来，为了共同的目的而战。这里很多的卓尔都是伊丽丝璀的信徒。”~
@107604 = ~“但是这里还有别人。立特米亚撒是麦维尔家族祖先的家园，一个很有名的卓尔家族，他们因为瓦纱瑞丝而被迫离开。”~
@107605 = ~“麦维尔家族的追随者和我们一起反抗瓦纱瑞丝，然而在其他情况下他们不会和伊丽丝璀的信徒结成同盟。”~
@107606 = ~先知叹着气。“我不想对站在我们一边的人说三道四，但我必须承认，麦维尔家族不是一个很好的同盟者。在两边都有一种紧张和猜疑的情绪。”~
@107607 = ~“但我们没有选择。瓦纱瑞丝势力强大。麦维尔家族也知道这一点，所以他们允许我们在这里出现。”~
@107608 = ~“现在，瓦纱瑞丝的威胁可以保证我们和他们之间暂时屏弃彼此的仇恨，并关注我们共同的敌人。”~
@107609 = ~“如你所愿。请站在那里……”~
@107610 = ~“魔像是强大的生物。谢谢，<CHARNAME>……我肯定他们在即将爆发的战争里会很有帮助。”~
@107611 = ~“干得真棒，<CHARNAME>！眼魔是可怕的对手。如果没有它们的援助，瓦纱瑞丝可是被大大削弱了。”~
@107612 = ~先知悲伤的摇摇头。“通常我会为消灭了这种邪恶的生物而很高兴，但是消灭主脑不会阻止其他的灵吸怪继续加入瓦纱瑞丝一边。”~
@107613 = ~“我们唯一的希望是说服主脑确保长老议会那边不再向瓦纱瑞丝提供灵吸怪的支持。不过做了就做了吧。”~
@107614 = ~“我很高兴灵吸怪不再与我们为敌，尽管我希望你和他们做的交易不会让我们以后后悔。有时我们只能两害相权取其轻。”~
@107615 = ~“这真是个好消息，<CHARNAME>。如果瓦纱瑞丝不再控制不死生物，她必须考虑动用自己的部族和盟军的生命了。对他们，我们或许有一定的胜利机会。”~
@107616 = ~“是的，这个天使般的生物的加入真好像是个童话。太好了。你给了瓦纱瑞丝重重的一击，并为我们带来了一个强大的盟友。”~
@107617 = ~“还有什么消息吗？”~
@107618 = ~先知慢慢的点点头。“还有很多要做。不过还是要谢谢你的努力。”~
@107619 = ~先知慢慢的点点头。“你为我们做了很多，<CHARNAME>。请接收我的谢意。”~
@107620 = ~先知慢慢的点点头，明显很高兴。“你为我们做了很多，<CHARNAME>。瓦纱瑞丝再也不能忽视你的行为了。”~
@107621 = ~“我该警告你的，<CHARNAME>……我了解这些。它是很强大——但也很危险。你想拿它做什么？”~
@107622 = ~“我知道，事实是你想怎么做就怎么做。只要确定它不落到错误的人的手里，或者它带来的问题比解决的还要多。”~
@107623 = ~“我或许可以，尽管我觉得对于这东西应该加倍小心。但是我不能要求你把这么有价值的东西交给我。”~
@107624 = ~“我们基本上没有多少资源了。如果你想卖这面镜子，我买不起。”~
@107625 = ~先知的眼睛惊讶的瞪大了。“我……这太……你真是太慷慨了，<CHARNAME>。谢谢。我……会好好利用它的。”~
@107626 = ~“我不敢在战前使用它，因为我怕因为它的力量带来牺牲。但很可能在将来它会帮助我们。”~
@107627 = ~“它属于你，至少你防止了瓦纱瑞丝得到它。她已经够强大了。我希望你能正确的使用它。”~
@107628 = ~“我知道。如果这是代价，我们必须付出让他们反对瓦纱瑞丝。就这样吧。但我担心这种可怕的东西能不能被控制。”~
@107629 = ~“魔镜属于你，<CHARNAME>·<CHARNAME>，我也愿意还给你。不过，我能问问你想用它来做什么吗？”~
@107630 = ~你刺耳的话语深深的刺伤了先知。“是啊，你不需要向我解释。很好，镜子在这里。”~
@107631 = ~“那么好吧，拿去吧。但要当心它的力量……即使是我也不想在不知道后果的情况下使用它。”~
@107632 = ~“我知道了。毫无疑问这是他们离开瓦纱瑞丝的代价。但是我担心他们会拿它来做什么。你知道吗？”~
@107633 = ~“如你所愿，<CHARNAME>·<CHARNAME>。如果你改变了想法，你只要告诉我我就会把魔镜还给你。它属于你。”~
@107634 = ~“很好。我相信伊丽丝璀的昭示，那么我也要相信你，<CHARNAME>·<CHARNAME>。这是魔镜。我只希望我们以后不会为此而后悔。”~
@107635 = ~“泽希尔现在控制着麦维尔家族？那么，我可以肯定玛露恩死了。为什么你要这么做，<CHARNAME>？”~
@107636 = ~先知皱着眉头。“我不希望你靠杀戮来牟取利益，<CHARNAME>。我知道这是卓尔可以容许的方式，但是伊丽丝璀不可以。”~
@107637 = ~“我不是在为你做评价，但是我要警告你不要过深的陷入卓尔的黑暗权术。这是一种奸诈的企图。希望泽希尔能比对她妈妈更多的忠于我们。”~
@107638 = ~先知不情愿的点点头。“是的，你可能是对的。玛露恩一直希望掌权。如果她有机会屈从于瓦纱瑞丝并以此生存，她会做的。”~
@107639 = ~“也许你在这儿所做的是为了更好的结果。我只希望泽希尔能比对她妈妈更多的忠于我们。”~
@107640 = ~“我只希望泽希尔能比对她妈妈更多的忠于我们。”~
@107641 = ~先知陷入了沉思，现在没有办法和你说话。~
@107642 = ~“我只能看到伊丽丝璀想给我看到的东西。以她的智慧，她不想让我知道麦维尔家族即将发生的背叛。”~
@107643 = ~“也许女神知道你会来这里拯救我的狭隘视野。也许她想让我从我深信的东西里得到教训。”~
@107644 = ~“谢谢你救了我，我的短视导致了这一结果。也许这就是为什么伊丽丝璀没有预先警告我这次背叛……她知道你会阻止玛露恩。”~
@107645 = ~“对于麦维尔家族的背叛，但是我们决不能考虑太多。我们必须准备对付瓦纱瑞丝的下一次攻击。”~
@107646 = ~“如果没有麦维尔的势力，我们会比以前大大削弱，但是至少我们知道了为我们而战的人是我们真正的盟友。”~
@107647 = ~“等一下……你是谁？这是怎么回事？”~
@107648 = ~“在这个问题上，你不能恐吓我……任何人都不行。”~
@107649 = ~“你在等待我的到来？你怎么知道我要来？”~
@107650 = ~“你叫我？”~
@107651 = ~“那么告诉我该知道的东西吧。”~
@107652 = ~“我会尽力阻止她。”~
@107653 = ~“我只想找到解除我的诅咒的办法。”~
@107654 = ~“帮助你？我甚至不想来这里！”~
@107655 = ~“我想你可能是对的。”~
@107656 = ~“我想接触对我的诅咒，如你所见。”~
@107657 = ~“我想我没有选择。”~
@107658 = ~“为什么不早点告诉我，娜西拉？”~
@107659 = ~“那么这和我有什么关系？”~
@107660 = ~“我梦到过……”~
@107661 = ~“我确信如果能说句话，她和我之间不会有这种敌意的。”~
@107662 = ~“我会尽一切可能来阻止这种邪恶势力。她有理由怕我。”~
@107663 = ~“似乎瓦纱瑞丝和我无可避免的走上了对抗的道路。”~
@107664 = ~“那么你建议我们怎么办？”~
@107665 = ~“这太荒谬了！我认为她没有一点伤害。”~
@107666 = ~“但是瓦纱瑞丝现在无法到达深水城了。海拉斯特自由了。”~
@107667 = ~“她怎么能让魔王为她效劳？”~
@107668 = ~“对于你的信任我感到很荣耀，先知。”~
@107669 = ~“现在听起来好像不错。”~
@107670 = ~“我不需要你的帮助，泰夫林。”~
@107671 = ~“我认为你并不信任我。”~
@107672 = ~“我很高兴你不再怀疑。”~
@107673 = ~“我现在要走了。”~
@107674 = ~“为什么我必须帮你？”~
@107675 = ~“我不会让你失望，先知。”~
@107676 = ~“我不想加入。”~
@107677 = ~“我没听懂……你想让我做什么？”~
@107678 = ~“我现在没有什么东西可以汇报。”~
@107679 = ~“我该走了。”~
@107680 = ~“我有几个问题要问你。”~
@107681 = ~“你能再和我谈谈瓦纱瑞丝吗？”~
@107682 = ~“我怎么才能削弱瓦纱瑞丝的实力？”~
@107683 = ~“和我谈谈幽暗地域吧。”~
@107684 = ~“这里有通道可以返回地面世界吗？”~
@107685 = ~“我觉得没有必要呆在这里……或者为这种事情做些什么。”~
@107686 = ~“你的意思是瓦纱瑞丝正在到来？”~
@107687 = ~“和我谈谈灰矮人可以吗？”~
@107688 = ~“和我谈谈眼魔吧。”~
@107689 = ~“和我谈谈灵吸怪。”~
@107690 = ~“为什么你叫先知？”~
@107691 = ~“我想再问你一些事情。”~
@107692 = ~“告诉我你的幻象。”~
@107693 = ~“你看到过我？”~
@107694 = ~“你怎么知道的？”~
@107695 = ~“我不知道你在说什么。”~
@107696 = ~“你是说我在客栈的梦？”~
@107697 = ~“那么你和其他的卓尔不同吗？”~
@107698 = ~“是你在领导这些卓尔？你是女祭司？”~
@107699 = ~“我不太相信所谓的先知。”~
@107700 = ~“这儿还有其他的卓尔？”~
@107701 = ~“我信仰其他的神灵不会打扰你吧？”~
@107702 = ~“和我谈谈伊丽丝璀。”~
@107703 = ~“这好像不是什么善良的神殿。”~
@107704 = ~“她并不介意？你为什么这么说？”~
@107705 = ~“你说‘为她的事业服务’是什么意思？”~
@107706 = ~“你们都是卓尔。现在为什么我不能把你们这些卓尔都杀光呢？”~
@107707 = ~“我想更多地了解这里的盟军。”~
@107708 = ~“你觉得你能信任他们吗？”~
@107709 = ~“这可能会带来紧张。”~
@107710 = ~“我需要一些治疗。”~
@107711 = ~“我找到了一些乐意帮助我们的魔像盟友。”~
@107712 = ~“我杀了眼魔暴君。它们现在不会去帮助瓦纱瑞丝了。”~
@107713 = ~“我摧毁了佐瓦柯穆的主脑。”~
@107714 = ~“夺心魔不再和瓦纱瑞丝结盟。”~
@107715 = ~“我消灭了瓦纱瑞丝的亡灵的来源。”~
@107716 = ~“暂且就说到这里。”~
@107717 = ~“我找到一件宝物，碎镜。”~
@107718 = ~“我确信它对于某些人很有价值。”~
@107719 = ~“我不知道。你能用它吗？”~
@107720 = ~“我决不会说我会的。我要留着它。”~
@107721 = ~“不是免费。但你能付什么呢？”~
@107722 = ~“那么也许别人会买。”~
@107723 = ~“那么留着它吧。我不需要。”~
@107724 = ~“或许夺心魔还会要它。”~
@107725 = ~“如果你能用它，留着吧。或许它有帮助。”~
@107726 = ~“我当然想留着它。”~
@107727 = ~“佐瓦柯穆的主脑事实上对它很有兴趣。”~
@107728 = ~“我要你把碎镜还给我。”~
@107729 = ~“我不需要对你解释一切。”~
@107730 = ~“我觉得我可能需要它。”~
@107731 = ~“我想把它交给佐瓦柯穆主脑。”~
@107732 = ~“我改变主意了。你留着魔镜吧。”~
@107733 = ~“我是。把魔镜交给我。”~
@107734 = ~“我帮泽希尔控制了麦维尔家族。”~
@107735 = ~“她为我付出了薪水。”~
@107736 = ~“玛露恩会背叛我们投靠瓦纱瑞丝。”~
@107737 = ~“我们必须离开这里！”~
@107738 = ~“但是我不想率领军队。”~
@107739 = ~“我会率领你的军队取得胜利，先知。”~
@107740 = ~“让他们来吧！我们已经准备好了。”~
@107741 = ~“别担心，先知。我不会让你受到伤害。”~
@107742 = ~“你仅仅是个先知？”~
@107743 = ~“不要责怪自己。我们都犯了错误。”~
@107744 = ~“他们怎么跨越黑暗之河？”~
@107745 = ~“还有疑问吗？瓦纱瑞丝对我算个屁！”~
@107746 = ~“我做了必须做的事情。”~
@107747 = ~“没有你的帮助我什么也做不到。”~
@107748 = ~“好吧。”~
@107749 = ~“卡瓦拉斯……很奇怪。他愿意免费帮先知的追随者渡河，但另一方面他似乎并不想在我们反抗瓦纱瑞丝时采取什么主动的行动。”~
@107750 = ~“他很愿意告诉我们在他的旅行中的见闻，他也不会要求什么回报。而且，他对于任何人或事都不会害怕。”~
@107751 = ~瓦伦耸耸肩，道：“我实在不知道他是谁，也不知道他为什么在这里。他用斗篷遮挡住他的脸庞和面貌，让人们只看出他船夫的身份。这有点让人紧张。”~
@107752 = ~“但我比其他的卓尔更相信卡瓦拉斯。我从他那里感受不到任何威胁或危险……你不能以貌取人。”~
@107753 = ~“他会在东边的港口里，除非他在渡船上。如果问他，他会告诉你关于魔像和时有时无的奇怪城镇的消息。”~
@107754 = ~泰夫林考虑你的要求很长时间，终于作出了回答：“我不相信先知的梦境，<CHARNAME>……不过我相信你想阻止瓦纱瑞丝。”~
@107755 = ~“但是你已经有了足够的同伴，<CHARNAME>。我不想把我们的力量都集中在一处。一着棋错，满盘皆输。”~
@107756 = ~瓦伦点点头，道：“是的，我认为要是我们联合在一起，那对大家都好。”~
@107757 = ~“我可以加入你，但首先我想告诉你一些奇特的传闻，或许我们可以从此开始。”~
@107758 = ~泰夫林狠狠瞪了你一眼，道：“我是一个武士，一个战士。你很难找到一个武艺比我更好的人了。同先知一样，瓦纱瑞丝是我的敌人。”~
@107759 = ~“我不认为你有资格知道更多，因为我甚至不知道你是谁。先知或许认为你很特殊，但我宁愿等到打败瓦纱瑞丝再相信你。”~
@107760 = ~“你说得不准确，”他轻轻地说，“我甚至还不认识你，所以我也无所谓喜不喜欢你。但和先知不同，在你证明你正对抗瓦纱瑞丝之前，我是不会充分信任你的。”~
@107761 = ~“我只听说了一些关于奇怪岛屿的留言和传闻。东边港口的船夫卡瓦拉斯知道的比我多。”~
@107762 = ~“通过阻止瓦纱瑞丝，当然……如果你可以的话。但即使先知已经预言了一切，你也不可能独自完成这些事情。幸运的是，我或许可以帮你。”~
@107763 = ~“近来我听说了一些附近奇特岛屿的传闻。据此来看，上面一定有什么东西，它们可能会帮助我们对抗瓦纱瑞丝。”~
@107764 = ~“他们说那里有一个岛上居住着强大的魔像；对于抗击瓦纱瑞丝和她的军队，它们会非常有用。”~
@107765 = ~“我还听说过有个奇怪的村落，它会在夜里出现在荒芜的小岛上。那听起来就像是一个强大的神器在运作……也许能将它为我们所用。”~
@107766 = ~“当然，我所听到的只是河上旅行者的传闻而已。我想船夫卡瓦拉斯很可能知道的更多。”~
@107767 = ~“这让你很吃惊？幽暗地域有很多河流和湖泊，很多村落都是港口和码头。立特米亚撒港就在东边。”~
@107768 = ~“没必要。只要知道我是靠着他们的行为来判断一个人，而不是那些所谓的命运。如果你能证明自己，相信我……我会是第一个歌颂你胜利的人。”~
@107769 = ~瓦伦耸耸肩，还是一直盯着你。“我理解的是，你没有选择。海拉斯特诅咒了你。要不你找个办法阻止瓦纱瑞丝，要不你就死。”~
@107770 = ~“事实上，我希望先知没有看错你。如果你是对抗瓦纱瑞丝的一员，肯定要好些。不过我不能仅仅因为先知做了一个梦就屈从于你。”~
@107771 = ~“是的。我希望能帮助你，尽管我对你没有任何了解。希望你能证明先知对你的信任是值得的。”~
@107772 = ~“我现在要去完成任务了。”~
@107773 = ~“你以前提到过一个船夫的事情。”~
@107774 = ~“或许他是个鬼魂或是幽灵。”~
@107775 = ~“或许他是瓦纱瑞丝的间谍。”~
@107776 = ~“哪儿能找到这个船夫？”~
@107777 = ~“愿意加入我吗？”~
@107778 = ~“我想更多地了解你。”~
@107779 = ~“我感觉你不喜欢我。”~
@107780 = ~“你有什么办法可以帮我对付瓦纱瑞丝吗？”~
@107781 = ~“你说过可以帮我对付瓦纱瑞丝。”~
@107782 = ~“我怎么才能证明自己呢？”~
@107783 = ~“告诉我这些岛的事情。”~
@107784 = ~“告诉我卡瓦拉斯的事情。”~
@107785 = ~“岛？这里有岛吗？”~
@107786 = ~“我不喜欢你这种态度，泰夫林！”~
@107787 = ~“如果我不想为你证明自己又怎么样？”~
@107788 = ~“在这里我们立场相同。”~
@107789 = ~卓尔战斗祭司~
@107790 = ~卓尔火焰大师~
@107791 = ~卓尔精英射手~
@107792 = ~卓尔反抗军卫兵~
@107793 = ~卓尔侦察兵~
@107794 = ~卓尔骷髅~
@107795 = ~教团武僧~
@107796 = ~这是一个类人生物，他那没有血色的肌肉上刻有黑色的文身，这是他作为一个亡灵宗教的信徒的标志。~
@107797 = ~教团骑士~
@107798 = ~这些类人生物具有骨骼做成的铠甲，他们既不是人，也不是兽，被禁锢在生与死的世界之间。~
@107799 = ~卓尔反抗军射手~
@107800 = ~灰矮人战法师~
@107801 = ~灰矮人骑兵~
@107802 = ~灰矮人商人~
@107803 = ~这个灰矮人比其他族人都更年长，而且很显然他战斗的日子已在很早之前。~
@107804 = ~白银魔像~
@107805 = ~由于白银魔像比其他的金属制造物更小，因此他们在战役中的作用往往被低估。这种白银魔像是用熔化的白银通过魔法冷却制成，他们能向敌人射出一阵阵雾和冰。~
@107806 = ~青铜魔像~
@107807 = ~尽管青铜魔像的外表并不像其他金属制造物那么起眼，他们却是可怕的对手。青铜魔像由熔化的金属制成，他们能辐射热量，并能向敌人射出一阵阵的火焰。~
@107808 = ~莱佛拉~
@107809 = ~这个星界使徒具有美丽动人和婀娜多姿的女子外形，长有引人注目的羽毛翅膀。对于一个异界生物而言，她看上去很年轻。~
@107810 = ~宗派 男孩 红色~
@107811 = ~宗派 男孩 蓝色~
@107812 = ~获得自由的奴隶~
@107813 = ~人类是费伦大陆上最为广布的和居统治地位的种族。~
@107814 = ~卓尔决斗者~
@107815 = ~高阶法师古尔莱斯~
@107816 = ~昕娜~
@107817 = ~斯涅布力仆人~
@107818 = ~麦维尔士兵~
@107819 = ~麦维尔弓箭兵~
@107820 = ~灰矮人黑色看守~
@107821 = ~灰矮人弓矢大师~
@107822 = ~传奇夺心魔~
@107823 = ~战斗魔像~
@107824 = ~卓尔投石器装填者~
@107825 = ~奥希尔军士~
@107826 = ~卓尔反抗军投石器装填者~
@107827 = ~卓尔平民~
@107828 = ~深渊炼魔首领~
@107829 = ~巴洛魔男爵~
@107830 = ~卓尔反抗军牧师~
@107831 = ~卡瓦拉斯~
@107832 = ~他身披斗篷头戴兜帽的样子有点让人不安。~
@107833 = ~卓尔女性~
@107834 = ~卓尔男性~
@107835 = ~卓尔商人~
@107836 = ~船坞工人~
@107837 = ~瓦纱瑞丝~
@107838 = ~瓦纱瑞丝既美丽动人，又残酷可怖，即使在卓尔那里她也是赫赫有名。~
@107839 = ~瓦纱瑞丝之手~
@107840 = ~战场传令官~
@107841 = ~这团鬼火看起来比一个舞动的光球更小一些。~
@107842 = ~特比玛队长~
@107843 = ~麦维尔家族射手~
@107844 = ~玛露恩主母~
@107845 = ~麦维尔家族军士~
@107846 = ~泽希尔·麦维尔~
@107847 = ~这位年轻的卓尔穿着贵族服饰，她的眼神里流露出贪婪和野心。~
@107848 = ~卓尔列兵~
@107849 = ~伊丽丝璀信徒~
@107850 = ~指挥官伊蒙罗~
@107851 = ~这个卓尔非常自信，却并不像其他人那样冷酷和傲慢。这使得他具有耐心，通情达理，自信却不张扬。~
@107852 = ~里佐维尔~
@107853 = ~尽管他长得颀长而又瘦削。这位卓尔铁匠的四肢却是肌肉发达，给人一种很雄健有力的印象。~
@107854 = ~先知~
@107855 = ~同其他的卓尔一样，这个女人也漂亮，但她具有同类人身上罕有的柔美。她的眼睛充盈着智慧，给人一种饱经风霜和楚楚可怜的印象。~
@107856 = ~女奴隶角斗士~
@107857 = ~这个女人长的就像一个凶猛的角斗士。~
@107858 = ~蓝色奴隶~
@107859 = ~灵吸怪角斗场的奴隶只不过是一群没有头脑的野兽而已。~
@107860 = ~红色奴隶~
@107861 = ~智力毁灭者~
@107862 = ~迷人的少男~
@107863 = ~这个男人身上具有不可思议的诱惑力~
@107864 = ~迷人的少妇~
@107865 = ~这个女人身上具有不可思议的诱惑力~
@107866 = ~夺心魔滋养者~
@107867 = ~夺心魔占有者~
@107868 = ~看守~
@107869 = ~只要瞥一下这个灰矮人的眼睛，就能知道他的脑子里面一片混乱。~
@107870 = ~催心魔崇拜者~
@107871 = ~女奴隶~
@107872 = ~获自由的卓尔奴隶~
@107873 = ~获自由的灰矮人奴隶~
@107874 = ~获自由的斯涅布力奴隶~
@107875 = ~阿戈撒斯~
@107876 = ~这个卓尔的眼里激荡着热情和火焰……和对自由的渴望。~
@107877 = ~面无表情的灰矮人~
@107878 = ~从这个可怜的家伙凝滞的表情和呆板眼神看来，他的精神已荡然无存，~
@107879 = ~呆板神情的卓尔~
@107880 = ~无知的斯涅布力~
@107881 = ~恐爪怪奴隶~
@107882 = ~牛头人奴隶~
@107883 = ~岩石侏儒科第干~
@107884 = ~这个侏儒看上去很是疲惫，好像他扛着一个自己无法承受的东西一样。~
@107885 = ~龙巫妖的尸体~
@107886 = ~尽管龙巫妖维克杀最终还是死去，但当你看到这个可怕野兽的残骸时仍然不禁会毛骨悚然。~
@107887 = ~宗教长老武僧~
@107888 = ~这是一个类人生物，他那没有血色的肌肉上刻有黑色的文身，这是他作为一个亡灵宗教的信徒的标志。~
@107889 = ~这种生物是一团没有固定形状的云雾，感觉上像是薄雾一般。~
@107890 = ~幽影大师~
@107891 = ~这个裹着头巾的人物的肌肉上刻有纹身，这是一个亡灵宗教的信徒的标志。~
@107892 = ~人类奴隶~
@107893 = ~这个女人身上只穿着破旧的衣服。~
@107894 = ~呼吸者~
@107895 = ~异界神侍~
@107896 = ~异界神侍长得像肌肉发达的人类，它们有翡翠色的皮肤，秃顶的脑袋和羽毛翅膀。~
@107897 = ~临时~
@107898 = ~幽魂~
@107899 = ~这显然是一个死亡多时的蜥蜴人的灵魂。~
@107900 = ~眼魔暴君十分强大，能够将大群家族成员置于其控制之下。~
@107901 = ~阿提兹~
@107902 = ~和这儿其他奴隶不同，这个狗头人仍然保留着舌头。~
@107903 = ~狗头人奴隶~
@107904 = ~眼魔的奴隶们的舌头被割掉，一方面这能使他们主人的秘密不会外泄，另一方面，他们即使想造反，没有舌头也不便于同其他奴隶之间进行交流。~
@107905 = ~蛛化精灵刺客~
@107906 = ~泽费德~
@107907 = ~培德尔~
@107908 = ~特兰寇德~
@107909 = ~这个翼精灵穿着法师的长袍。~
@107910 = ~绍勒~
@107911 = ~这个翼精灵穿着皇室的衣服。~
@107912 = ~红色姐妹牧师~
@107913 = ~这个卓尔穿有刺客精英组织——红色姐妹的长袍，~
@107914 = ~红色姐妹游荡者~
@107915 = ~红色姐妹战士~
@107916 = ~萨巴尔~
@107917 = ~愚者~
@107918 = ~这个翼精灵身材粗矮，穿着宫廷小丑的服饰。~
@107919 = ~巫利沙~
@107920 = ~这个翼精灵长得像是某种卫士或是士兵。~
@107921 = ~染病的巨魔~
@107922 = ~恶魔靡菲斯特就像一个巨大的强壮男人，他头上长有角，脚下有山羊蹄子，并长有弯曲的蛇形尾巴，他是地狱的王子。~
@107923 = ~临时的，除掉我~
@107924 = ~宗派男孩~
@107925 = ~这个狗头人的舌头已被割掉；这是眼魔为防止它们的奴隶串通起来谋反所采取的一致措施。~
@107926 = ~瓦伦~
@107927 = ~影息~
@107928 = ~要不是这个泰夫林的角和尾巴说明他是恶魔的后代，他也许就会成为公认的美男子。不管怎样，他异常冷酷和严厉的眼光里流露出野性的狂怒几乎无法控制。~
@107929 = ~不可否认这个卓尔外表美丽，但她却是个危险的角色。从她那黑色的眼珠似乎可以看到深埋于她心中的可怕秘密。~
@107930 = ~卓尔战场指挥官~
@107931 = ~胶状立方体属性~
@107932 = ~猛击珍珠~
@107933 = ~这颗小珍珠的表面刻有一些神秘的符号。~
@107934 = ~语言珍珠~
@107935 = ~这颗珍珠的表面刻满多种不同语言的词语。~
@107936 = ~泰南的头部~
@107937 = ~这个木头小孩的顶部是由在幽暗地域的神秘机器制造，它能飞速旋转以召唤出一个强大的盟友。~
@107938 = ~黑色珍珠~
@107939 = ~你在深黯村的维克杀教派神殿里发现这颗奇怪的石头。然而，你并不清楚它为何物，也并不知道它有何用处。~
@107940 = ~这颗光滑的珍珠中里充满黑暗。你在深黯村的维克杀教派神殿中发现它，并怀疑那儿的牧师们将其用于某种宗教仪式。~
@107941 = ~焚毁的书~
@107942 = ~这本书已被严重烧毁，它的文字页面已无法阅读。它已经毫无价值。~
@107943 = ~使徒的长袍~
@107944 = ~宗教 骑士 铠甲~
@107945 = ~宗教 骑士 头盔~
@107946 = ~宗教 年长骑士 装备~
@107947 = ~宗教 骑士 装备~
@107948 = ~能量球~
@107949 = ~这个球发出嘶嘶声和火花。它充满了能量。~
@107950 = ~魔像吸引器~
@107951 = ~当把它放在地上时，这个物品能够产生魔法召唤，将其控制区域内的所有魔像召唤到吸引器旁边。它能有效的将魔像引入致命陷阱。~
@107952 = ~魔像 封印~
@107953 = ~这个巨大的封印正面刻有魔像的图像。~
@107954 = ~魔像 破衣服~
@107955 = ~仇恨~
@107956 = ~它是其搭档“倾轧”的可怕的孪生兄弟，数个世纪以来，这个精心打制的反曲刀的檀香木夹已被无数幽影大师的血和汗所污损和退色了。曾经有段时间，持有这一对物品就意味着在传说中的夜色公会中拥有领导权。但由于其长期反复出现，已将公会分裂成为无数的秘密社团，其中一部分现在仍然存在。~
@107957 = ~魔鬼的毒物~
@107958 = ~这是瓦伦的连枷，它的双钉头部由一种黑色的像骨头的材料雕刻而成。这种材料非常的冰冷。瓦伦在深渊魔域的多年血战中使用这件武器……它专门用于对付魔鬼和其他的外界生物，但对付其他的敌人时也很有效。即便瓦伦获得其他的武器，他也不会丢弃这件武器。~
@107959 = ~瓦伦的胸甲~
@107960 = ~这件百毒不侵的铠甲是为瓦伦特地打制的，它由叛军卓尔的里斯·麦撒精工制造，并在上面施以魔法，使得穿他的人能在短时间内快速移动。它象征着瓦伦的巨大能力，即使叛军被瓦纱瑞丝追逼到幽暗地域的边缘时仍不会死掉。纵使他获得更好的铠甲，他也不会丢弃这一件。~
@107961 = ~特殊蛛化精灵装备~
@107962 = ~娜西拉皮革~
@107963 = ~星界使徒装备~
@107964 = ~传奇夺心魔装备~
@107965 = ~传奇夺心魔触手~
@107966 = ~虹彩龙靴子~
@107967 = ~这些靴子按照龙之拖鞋设计，但通过虹彩龙的皮肤得以加强。但由于靴子的装饰颜色可能引起同其他人物混淆，所以在选择何时何地装备这些靴子上应该格外注意。~
@107968 = ~底层地穴钥匙~
@107969 = ~这把钥匙持在手中很重，好像上面的颅骨标志是由铅制的一样。~
@107970 = ~索达里斯的装备~
@107971 = ~魔像的增强魔法~
@107972 = ~当生产魔像的时候，很重要的一点是不要忘记通过使用魔法使其增强。最简单的做法是在魔像制造机上加上法术导管。这些导管届时将充入相应的法术。
请注意，在魔像的生产过程中可以改变施法道具，这常常在其穿越法术导管的时候产生意想不到的结果。

比如：
1.高级法术吸收会使魔像具有抗拒魔法的能力。
2.比格拜毁灭掌能增强魔像的力量。
3.高级圣域术使让魔像受到击打时受到更多保护。
4.时间停止增强魔像的再生能力。
5.预言术能加强伤害减免。
6.集体加速术能提供永久的加速效果。
7.真知术提供永久真知术效果。
8.链形闪电使得当魔像受到敌人攻击的时候能释放闪电。
9.魔邓肯裂解术能使魔像每次攻击到敌人的时候能够获得解除魔法效果。

通过将这些法术放置于相应的导管中，用户可以在魔像生产器上按自己需要配置所生产魔像的特征和能力。

创造者埃希加德~
@107973 = ~红色刺客链甲+3~
@107974 = ~娜西拉的斗篷~
@107975 = ~这是娜西拉的斗篷。她在上面施以强大的防护魔法——使她能躲藏在下面，保护她免受物理攻击。~
@107976 = ~失效权杖~
@107977 = ~尽管这根权杖的一端已变平并露出黄铜节点，但仍然很难说清楚这根权杖的作用。它也许是插入某个大些的物件中使用的。~
@107978 = ~异界神侍铠甲~
@107979 = ~异界神侍装备~
@107980 = ~特比玛的巨镰~
@107981 = ~这柄巨镰的刀刃已磨得极其锋利，能将对手一刀两断。~
@107982 = ~麦维尔铠甲~
@107983 = ~麦维尔家族的印戒~
@107984 = ~这件麦维尔家族的印戒是由一位能工巧匠精心打制完成。其自身反复缠绕的样式给人造成幻觉，让人觉得上面的黄金能够活动。你简直觉得这只戒指就像一只金属做的蜘蛛一样，正在你的手上爬动。~
@107985 = ~卓尔反抗军小队长头盔~
@107986 = ~叛军铠甲~
@107987 = ~先知的长袍~
@107988 = ~战斗训练弩~
@107989 = ~蓝色角斗士战斧~
@107990 = ~红色角斗士剑~
@107991 = ~监狱长钥匙~
@107992 = ~这把钥匙可以打开灵吸怪奴隶的监牢。~
@107993 = ~长袍~
@107994 = ~蓝色角斗士长袍~
@107995 = ~防护头盔~
@107996 = ~穿上这件防护头盔，它将紧贴你的颈部。它能在你和外界间形成一层保护。~
@107997 = ~这件防护头盔常常由同灵吸怪打交道的奴隶贩子穿戴，它能让使用者抵御夺心魔的心灵感应攻击和其他精神攻击。
如果没有头盔的保护，奴隶交易将无法进行，这是因为灵吸怪很喜欢攻击同它们交谈的其他种类生物。~
@107998 = ~红色角斗士长袍~
@107999 = ~索达里斯装备~
@108000 = ~阿曼德的法杖~
@108001 = ~这根邪恶的法杖来自阿曼德，他是维克杀的高阶祭司，是幽暗地域里深黯自由村的残暴统治者。法杖顶端的漩涡据说是深渊魔域里某位神祇眼睛的视野。~
@108002 = ~不死水晶~
@108003 = ~这件本来不起眼的护身符上镶有恐怖的紫水晶。当你用手抓住其闪光的水晶碎片时，你的手会变得像冰冷的爪子，在它的紫色光芒下，你的皮肤看上去如同骸骨一样苍白而灰暗。它的威力让你走火入魔，但有时你仍不禁会反过来质疑它向你提出的要求。~
@108004 = ~影子宗教狂热者的装备~
@108005 = ~莱佛拉的愤怒~
@108006 = ~这根权杖像石膏一样雪白，并发出神圣的光芒。在这件武器削尖的头部装有一幅画，上面画着一位微笑着的小天使。在杖柄的金丝饰物上写有以下文字：“为褒奖使徒莱佛拉的所承担的重要使命，将此杖赐予她”。~
@108007 = ~维克杀长老的大册书~
@108008 = ~这本大册书仿佛由人类的鲜血写成，它绚丽的文字既包含通用语，又有古老的龙语。要理解其含义并不容易。~
@108009 = ~“……在1034DR的黑潮之夜，维克杀最终会恢复原形。影子再也不是他的翅膀，而是可怕的骨骼，我们的信任和劳动使他变得更为强大。我们创造了我们的神祇，并使他被我们世世代代崇拜。和我们一样，他永不泯灭。我们将永远服侍他的权威……”~
@108010 = ~宗教 长老武僧装备~
@108011 = ~影魔 啮~
@108012 = ~影魔 爪~
@108013 = ~来自瓦纱瑞丝的信~
@108014 = ~“……伟大的维克杀，尽管你英明而强大，但由于你未能有效履行承诺而让我很生气。你曾许诺以每天两百个的数目给我一支亡灵军队，但迄今为止我所得到的只有你许诺数目的一半。你那些愚蠢的长老们向我夸耀说这些东西拥有杰出的技能和力量。即便如此，没达到既定数量也是不可原谅的。我在给你这封信的同时，也将派遣我的奴隶来监督你的行为。如果你满足我的要求，我将会把你的长老们毫发无伤地送回到你那儿去。如果你能超额完成我的要求，我更会好好优待他们。但如果你让我失望的话，你那可怜的宗教将被我彻底摧毁，你好好考虑吧……”~
@108015 = ~宗教狂热者的手套~
@108016 = ~年长的宗教狂热者的手套~
@108017 = ~宗教狂热者的装备~
@108018 = ~负能量矢~
@108019 = ~这些弩箭具有黑色的箭杆和血红色的尖端，它们既狰狞可怖，又威力强大。据说让它们保持平衡的黑色油性羽毛取自墓地的乌鸦身上。~
@108020 = ~火焰权杖~
@108021 = ~火焰权杖是概念上相对而言较为简单的装备，它使用起来相当恶毒。多年以来，无数的法师希望能发掘该棍的特殊用途，但由于粗心大意，最终玩火自焚。如果你想使用它的话，请格外的小心。~
@108022 = ~幽影大师装备~
@108023 = ~影刃~
@108024 = ~传说在遥远的翡翠帝国，这些耐用武器的刀刃为黑色莲花刺客们所使用。它们是用无数层细薄的钢料折叠制成。刀刃的每一层折叠面被放在毒液中冷却，直到它每一个切口都出现裂纹，它正是如此制成的。~
@108025 = ~维克杀教派大典~
@108026 = ~尽管本书是用通用语写成，你会发现其华丽的手稿几乎无法阅读。更糟糕的是，上面有些地方的退色墨迹已被拭去。~
@108027 = ~“……维克杀的祭司们应如上所述在这个世界上安置他们的家，并以这个世界为他们的家，这将吸引更多的信徒来到神的光芒下来。但终身服侍维克杀的长老们将既不居住在这个世界上，也不以此为家，因为它们是不死的。对于他们而言，应用鲜血作为祭品，对维克杀而言，将用骨骼作祭品…”~
@108028 = ~碎裂的木头~
@108029 = ~这块木头碎片的断面参差不齐，尽管它能很好地受力，但你怀疑就算在不得已的情况下也无法把它当作粗劣的武器来使用。~
@108030 = ~使徒的鲜血~
@108031 = ~这鲜血是通过某种不光彩的方法从星界使徒的血管里抽取的，它蕴含着巨大的能量。~
@108032 = ~僧侣的钥匙~
@108033 = ~你从深黯村里维克杀教派神殿地下的一个宗教狂热僧侣那儿获得这把钥匙。制作这把钥匙的金属具有鲜血的色泽。~
@108034 = ~神秘词典~
@108035 = ~这看上去像是古代某种神秘语言的词典：“我已经决定让这些有特殊用途的魔像使用昂拉吉语言，我需要让他们能提醒我，让我记得他们的编号，因为我需要他们的维护。现在，我也许只需要以下词语：Omon = 零，Arthas = 一，Kinthas = 二，Ivon = 三，Thesti = 四，Sinth = 五，Kali = 六，Laz = 七，Urvil =八，Zand = 九。”~
@108036 = ~法伦的装备~
@108037 = ~灼热的铠甲~
@108038 = ~据传言，这件华丽的铠甲是由一位叫做乌利贡的斯涅布力铁匠用熔化的岩浆制作而成。尽管有许多人希望能模仿其设计，但它乃是用了一种只有乌利贡自己知道的秘方制作而成。~
@108039 = ~法师魔像 挥击2d8~
@108040 = ~魔像 躯干~
@108041 = ~这是一个非常大的魔像的一部分。~
@108042 = ~魔像 左手~
@108043 = ~魔像 左脚~
@108044 = ~魔像 右手~
@108045 = ~魔像 右脚~
@108046 = ~大型牛头怪的装备~
@108047 = ~守卫魔像残留物~
@108048 = ~魔法盾卫者装备~
@108049 = ~实验室的便条~
@108050 = ~这好像是关于创造者制造智能魔像的工作便条：“尽管我付出巨大的努力希望能制造出完美的生物，我所试图制造的只是有智能的魔像。我赋予了他们知觉，然而他们并不会使用我给他们的东西。他们走路时毫无方向感，也没有任何成就感、艺术细胞和文化概念。”~
@108051 = ~这好像是关于创造者制造智能魔像的工作便条：“我对我制造的魔像们越来越感到失望。他们不会任何一种维持生命的技能。尽管我试图为他们创造一个社会氛围，他们仍然表现得像一个个孤立的实体，并不会同他人进行交流和建立友谊，他们只知道何为主人、何为仆人。也许是我的存在阻碍了他们的发展。也许如果我离开他们，他们能够建立自己的社会，能够克服自身性格的缺陷。”~
@108052 = ~这好像是一张关于创造者在制造智能生物时感到失望的便条：“我开始想，如果我给这个魔像赋予活力和形体，它是否能比没有生命的原料更好一些。尽管我给了这些孩子一切——包括智力和自我意识，但他们发展受到妨碍。他们既不会学习，也不会成长，看上去十分木讷，就像制作他们的石头、钢铁和陶土那些原料一样呆立着不会动。”~
@108053 = ~这好像是有关创造者制造智能魔像的工作便条：“我赋予了我的生物们神的光辉，赋予了他们一个有感知能力的生物所具备的意识和自由意志。尽管有了这些，他们仍然有……缺陷。好像他们离开了主人就没法活下去。他们需要别人指出他们的人生目标，而不能通过自身发现自我生存的目标。”~
@108054 = ~魔像机器激活装置~
@108055 = ~这好像是一把可以激活魔法的钥匙，可能能够打开埃希加德的魔像制造机。~
@108056 = ~米吉尔的锤子~
@108057 = ~制作这把锤子是专门用于毁坏魔像和其他制造物。它归属于一个有名的侏儒冒险者米吉尔·雷拳。带着这把神奇的锤子，米吉尔潜入创造者的地下城深处，但再也没能出来。~
@108058 = ~米吉尔的头盔~
@108059 = ~这顶头盔能使戴上它的人抵御任何的精神控制和心智影响法术。它最后一次出现是在米吉尔·雷拳那里。侏儒探险家米吉尔潜入创造者的小岛之后就再也没能回来。~
@108060 = ~米吉尔的铠甲~
@108061 = ~这件铠甲是为斯涅布力英雄米吉尔·雷拳制作的。为防止它落入卓尔和其他潜在的敌人手中，这件铠甲精心打制，只有斯涅布力那样身材的生物才能穿上。米吉尔由于死在了创造者埃希加德的地下城之中，这件铠甲也从此随之消失。~
@108062 = ~金属魔像装备~
@108063 = ~牛头怪装备~
@108064 = ~魔像的能量之源~
@108065 = ~能量之源发出炽热的光芒，向外辐射能量，并且就像有生命那样，缓慢而又而稳定地发出跳动声。很有可能这件人造物品与相应级别的魔像紧密结合。尽管能量之源内部蕴含无穷的能量，它本身却非常脆弱和不稳定，如果将其打碎，它将引发灾难性的爆炸并释放出所有的能量。~
@108066 = ~灼热的头盔~
@108067 = ~据说这件头盔是由乌利贡用深层地底熔化的岩浆打制而成的。乌利贡是一位侏儒打铁匠，他以制作铠甲和武器闻名。~
@108068 = ~魔像粘胶~
@108069 = ~任何被此物品击中的魔像将会减速1d6+2轮，每次使用它将消耗掉一次充入的能量。~
@108070 = ~蓝色粉末~
@108071 = ~此粉末显然具有魔法性质，但你很可能需要炼金术士的设备来提炼它。~
@108072 = ~红色粉末~
@108073 = ~黄色粉末~
@108074 = ~魔法水晶~
@108075 = ~此水晶显然具有魔法性质，但你很可能需要炼金术士的设备来提炼它。~
@108076 = ~黄金棍~
@108077 = ~此棍显然具有魔法性质，但你很可能需要炼金术士的设备来提炼它。~
@108078 = ~秘银雕像~
@108079 = ~此雕像显然具有魔法性质，但你很可能需要炼金术士的设备来提炼它。~
@108080 = ~魔像毁灭器~
@108081 = ~当用于对付一个构装生物时，这件物品能够发出毁灭性的光线，对魔像造成3d10+30的伤害，并将其击倒1d4轮，每次使用它将消耗掉一次充入的能量。~
@108082 = ~法伦的头部~
@108083 = ~这是魔像法伦的头部~
@108084 = ~控制护身符~
@108085 = ~在制造任何魔像的时候，这件护身符都是不可或缺的一部分。当它与魔像的合适部分结合在一起的时候，就能使其屈从于主人的意志之下。~
@108086 = ~这件护身符在持有它的盾卫者和魔像本身之间建立特殊的联系。当佩带护身符后，魔像将竭尽全力的保护其主人，并挡开物理攻击和魔法攻击。而且即便魔像和主人不在同一个地方，这件护身符也能将魔像传送到主人那里。~
@108087 = ~魔像的头部~
@108088 = ~安度佛~
@108089 = ~这些刀刃是在闪电风暴的神圣火焰中打制而成。其柄部有规律的振动，发出能量，并在这把利剑的两刃间持续迸发出闪电弧。~
@108090 = ~铠甲道具~
@108091 = ~伊特怪皮革~
@108092 = ~鬼魂皮肤~
@108093 = ~眼魔母巢女王装备~
@108094 = ~方尖石塔之球核~
@108095 = ~这个具有强大能量的魔法球取自眼魔洞穴下的方尖石塔之中。这个方尖石塔在其周围形成魔法失效区域。既然此球核能够为方尖石塔提供能量，它也可能用于形成魔法失效区域。~
@108096 = ~石板~
@108097 = ~在这面石板上刻有怪异且古老的文字。在这些深刻的文字上有用普通文字写的注释，这些注释是用黑色墨水写的粗体字。这些注释看上去是那些古老文字的译文：“伟大的方尖石塔已被激活，我们周围的任何魔法将在其面前失效。但愿它可以阻止具有强大魔法的敌人的进攻，因为他们再也不能向我们施以恶毒的法术，也不能使用他们的魔法武器和魔法道具。即使方尖石塔失去活性甚至被毁坏，我们仍能把这个球核当作抵御他们的武器。当一个生物手持着这个球核并让其激活的话，它就能触发让魔法失效的巨大能量，能让敌人长时间不能获得魔法能量，我们的战士就可以趁机将其击溃。”~
@108098 = ~商人的罗盘~
@108099 = ~这只魔法罗盘能帮你找出你所指定的物品。比如，碎境的碎片。
当你激活罗盘时，它会周期性地发出闪光。你离所寻找的物品越近，它就闪得越快。~
@108100 = ~蛛化精灵酋长的装备~
@108101 = ~无所不晓的镜子~
@108102 = ~它的另一个名字叫做“碎镜”，因为它的玻璃表面无数纵横交错的裂痕。很显然它曾经多次被打碎，又多次被拼合起来。如果你往魔镜里面看的话，它将展示出一幅扭曲的图像并随着时间移动和改变。虽然里面的画面并非看镜子的人的镜像，但其究竟这画面代表什么含义却很难知晓。~
@108103 = ~红色刺客轻型连枷+3~
@108104 = ~红色刺客细剑+3~
@108105 = ~红色刺客长剑+3~
@108106 = ~萨巴尔的铠甲~
@108107 = ~萨巴尔的连枷~
@108108 = ~萨巴尔装备~
@108109 = ~镜子碎片~
@108110 = ~这看上去像一块从镜子上掉下的破碎玻璃。上面的图像扭曲缠绕且光怪陆离，你也难解其意。也许这是从一块具有魔法的镜子上掉下的碎片。~
@108111 = ~翼精灵的服饰~
@108112 = ~翼精灵女王的服饰~
@108113 = ~防护凝视的药水~
@108114 = ~这种药水能让使用者免于被梅杜莎的眼睛盯上后变为石头，但其效用只能持续短暂时间。~
@108115 = ~塔洛娜的解毒药~
@108116 = ~如果被可怕的塔洛娜热病所感染的话，只有这件法宝的魔法才能将其治愈。~
@108117 = ~主母的装备~
@108118 = ~瓦纱瑞丝的护符~
@108119 = ~罗丝的意志~
@108120 = ~绳子~
@108121 = ~尽管有点磨损而且长久没使用了，但至少这根麻绳还是很长的。~
@108122 = ~被创造者的经文~
@108123 = ~这好像是一本关于如何制造并管理魔像的手册：“你制造的魔像们就像你的孩子一样，但同其他孩子一样，他们必须时时刻刻遵守纪律。法师有许多的道具可以用来保持对其制造的生物的控制。将秘银雕像和两份蓝色粉末混合能够制造出魔像毁灭器。将黄金棍和一份蓝色粉末、一份黄色粉末混合能制造出魔像粘胶。制造魔像吸引机则可以通过将魔法水晶和一份蓝色粉末、一份红色粉末混合得到。这三件道具能让你保持对你所生产的魔像的控制，并防止他们有任何反抗你的图谋。——创造者埃希加德”~
@108124 = ~心灵宝石~
@108125 = ~在这块本来并不起眼的石头的表面下有一层黑色的薄雾在盘旋。~
@108126 = ~倾轧~
@108127 = ~它是其搭档“仇恨”的灰刃孪生兄弟，数个世纪以来，这个精心打制的反曲刀的魔法木夹已被无数幽影大师的血和汗所污损和退色。曾经有段时间，持有这一对物品就意味着在传说中的夜色公会拥有领导权。但由于其长期反复出现，已将公会分裂成为无数的秘密社团，其中一部分现在仍然存在。~
@108128 = ~守护者指导手册~
@108129 = ~这本著作详述了创造者制造单个理想的魔像的成就。其中大部分章卷叙述他失败的试验，其中还混有与主题无关的段落，让人看到了埃希加德如何变得不可自拔，直到最终失去理智。

然而，最后一段文字却讲到他取得的重大突破：

“我什么都明白了。我必须吸取以前失败的教训，从而获得成功。

首先，我需要从被毁掉的那些魔像身上收集六个部位：两只脚、两只手、一个躯干和一个脑袋。
然后，我打开魔像构造机，并使用激活装置把它作为目标。一旦机器被打开，我便将收集的这些部位和控制护身符放入其中。
这将激活法术导管使得我能够对它施展使其增强的法术，从而让它的威力和能力大大超过其他的魔像，这在我先前的著作《增强魔像的魔法》一书中有过叙述。

当这个过程完成后，我将取回我的控制护身符并用它来召唤我制造的这个完美生物。

要完成这个复杂而细致的过程，需要魅力和强力奥术，只有掌握着最强大的奥术的巫师才会运用。然而，我相信即便是我的徒弟也能按照这些指示完成。”~
@108130 = ~干扰硬头锤+3~
@108131 = ~阿桑提~
@108132 = ~阿桑提这个恶魔曾经为阔刀部落所供奉，直到这个崇拜他的部落被屠戮，而他也被一个来自卓尔的法师所擒获。据说这个恶魔被囚禁在一件武器之中，这件武器是法师为他一个名叫哈喇哈沙的蛛化精灵宠物制造的。后来由于这个法师的部族为一个敌对的家族所灭，在一次地震中这件武器随着法师家的房屋一同被大地所吞噬。~
@108133 = ~卓尔的长袍~
@108134 = ~编织这件长袍所需的材料是一种神秘的细带，这种细带能够储存法术。施法者只需在这件长袍上施展防御性法术，这件长袍就能够将其储存，下次再施法时就能大大节约时间。这件长袍能够储存三个法术。
在惯于背信弃义的卓尔之中，这种长袍经常成为馈赠盟友和下属的礼物。因为它们的制作者在其中施了法，所以如果穿着它的人背信弃义就将受到诅咒。~
@108135 = ~狩魔蛛毒药~
@108136 = ~这是从狩魔蛛遗骸中提取的非常有效的毒素。狩魔蛛是一种会分泌毒液的具有蜘蛛外形的恶魔。这种毒素可以涂在刀刃上用以毒死自己的仇敌。~
@108137 = ~魔像~
