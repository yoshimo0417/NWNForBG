@89900 = ~呆在这里。~
@89901 = ~“我们离开，是吗？”~
@89902 = ~---------- Random Pop-Ups Start Here ------------~
@89903 = ~“什么？你该死的想一个人溜，是吗？”~
@89904 = ~“好，好，我马上就走，永远不会再来。”~
@89905 = ~“没问题。我想我能找到回去的路。如果需要我，你能在那里找到我。”~
@89906 = ~“你想要我做什么？”~
@89907 = ~“真的？如果是真的，太好了……”~
@89908 = ~“当然，我会尽我最大的努力。”~
@89909 = ~“不要蹑手蹑脚了，开始跑吧，我听到你了。”~
@89910 = ~“好的！真是够隐秘的。”~
@89911 = ~“你为什么要我呆在附近？”他耸耸肩。“符合你的本质。”~
@89912 = ~“是，你需要我的帮助很正常。”~
@89913 = ~“你到底要我呆在多远的地方？”~
@89914 = ~他耸耸肩。“我想，够公平的了。”~
@89915 = ~“在那里右拐？好的！”~
@89916 = ~他点点头。“我会尽我最大的努力的。”~
@89917 = ~“好，没问题，但是不要变的血腥，贪婪或者其他什么的。”~
@89918 = ~“哦，好的，我会检查你的包裹的……我保证我不会拿走任何属于你的东西的，哈哈！”~
@89919 = ~“又一个影子，出来吧！”~
@89920 = ~“好的！不要让我拉在后面，好吗？”~
@89921 = ~“谈谈？谈什么？”~
@89922 = ~“真是春色满园。没有比这更好的了。太好了……我现在很富有而且妻妾成群……但是我不希望你提供那个，哈哈哈！”~
@89923 = ~“还有什么想讨论的？”~
@89924 = ~“少量天然气。”他的眼睛睁的老大的，突然打了一个嗝。“阿，我们这就走。没关系的。”~
@89925 = ~“你为什么总是为我费心？照顾好你自己吧。”~
@89926 = ~“好，好，我会调整一下我大脑里的记忆的，够了吧。”~
@89927 = ~“还好。我在想当我回到文明生活的时候我可能会加入一个马戏团。你怎么想呢？”~
@89928 = ~“如果你想，我们可以一起进行一次血腥的掠夺。嗨。”~
@89929 = ~“我想我的屁股正在沸腾，出此之外，一切都还好。”~
@89930 = ~“很好但是不够好。你能告诉我是天黑了还是我失明了吗？我比较关心的。”~
@89931 = ~“别担心我，只是点擦伤，没什么的。”~
@89932 = ~“返回那里有点困难，嗨。在这里没什么看的。”~
@89933 = ~“只是点擦伤，没什么的，不要担心。”他退缩了，努力用手臂捂住正在流血的腹部。~
@89934 = ~“靠！一切都很好，除了那个液体燃料。我希望他能够自行消耗完……”~
@89935 = ~“还好，除了我身上的那些不知名的斑点。你猜那会不会是件坏事？”~
@89936 = ~“我这段时间都在做影子舞者。你想要我换个工作？”~
@89937 = ~“我一直是个游荡者，你想要我改行？”~
@89938 = ~“那确实是我梦寐以求的……”~
@89939 = ~“如果你想，我可以将我的时间分配一下，一部分学习游荡者技能一部分做影子舞者。如果你想我可专心做一件事。”~
@89940 = ~“一成不变？我可以的。”~
@89941 = ~“对。的确是影子舞者。”~
@89942 = ~“够公平的了。以后我会去做游荡者。”~
@89943 = ~“唔……是的，我猜他们不会如此平凡，是吗？让我来做……有些人可以隐身有些人可以变为影子人。”~
@89944 = ~“我们影子舞者是可以做后者的。不要问我我们为什么做，因为我会杀了你的，哈哈哈！”~
@89945 = ~汤米思考了一会儿，他皱了一下眉头。“唔。你的意思是用所有得来的钱？我正在想去度假。也许去冰风谷。”~
@89946 = ~“我听说在那里有一些可以追上精灵的鞋子被用来踢屁股。听上去蛮好玩的。”~
@89947 = ~“了解？我们这就走。你是对的。”~
@89948 = ~“嗤。从来都未发生过。我是汤米，难道你没听过？”~
@89949 = ~“好，我们这就走。看看他有多坚强？看起来他不是伊尔明斯特或者类似的人。”~
@89950 = ~“是的，我听过的。你想要我做什么？坐在海滩上面朝月影岛？那是何种乐趣呢？”~
@89951 = ~“你的意思是在我和纳什尔领主发生误会之前？”~
@89952 = ~他耸耸肩。“对，你肯定问了。”快乐的吹着口哨，他蹦蹦跳跳走了。~
@89953 = ~汤米耸耸肩。“哦，没什么大不了的，如果你问我，我的投资就会出漏子，这你是知道的，不会再有机会了。我没有筹码在手上了。”~
@89954 = ~“行，我会用这些钱去填补国库的漏缺的。甚至带着点兴趣！当然老纳什还没预见到。”~
@89955 = ~“不是。我被劝说离开。你知道的，与那个有大不同。”~
@89956 = ~“在瘟疫结束后，唔……退后点说，就是在汤米开放他的生意后。也是有利可图的。”~
@89957 = ~“不错，也许它不止是个俱乐部。成员付会费不是因为我让*他们*做自己的生意。”~
@89958 = ~“啐。现在听起来好像是服务纳什的家伙艾瑞恩·甄德，但并不像这样严肃。所以假如他是个协会，他是不会放过每个人的。好……我们每个人都要求付钱。”~
@89959 = ~他厌恶着猛地举起了他的手。“好，好！汤米对曾经美丽的费伦来说是最可恶的小男人！你高兴了吗？切。”~
@89960 = ~他四处张望了一下。“我们聊些什么呢？我们是来这里冒险的，不是吗？已经对设备动过手脚了。”~
@89961 = ~“不太好。这里原来有反对我的盗贼协会。我猜他们再也不会听说过无法生存的生活了，是吗？”~
@89962 = ~“在他们最终放弃之前，他们派了8个刺客跟着我。在这之前我觉着这不值得。哦，很好。”~
@89963 = ~“就是那个穿梭在血腥城市间的傻老头。告诉你……不要做任何会使这个城市愤怒的事情，因为它会把你喂狮子。就是那个胆小鬼。”~
@89964 = ~“哦，是。那不是我来的地方，但是从现在开始它已经够好了。我在这也有几分英雄的感觉……你听说过那场瘟疫，是吗？”~
@89965 = ~“是，好，我是帮助艾瑞贝丝小姐解决这个问题的一员。当然，也不会有人还记得那个穷女孩。”~
@89966 = ~“你应该想到会出现那种情况，但是现在。从瘟疫开始的时候，就出现过两个……误会。汤米不得不逃进无冬城，他也做到了。Kinda使得进入深水城成为一个很简单的决定。”~
@89967 = ~“我不知道。为什么你会如此惊讶？我在一生中从来都没做过任何使人不高兴的事情。”~
@89968 = ~“但是关于无冬城的信息足够多了。我现在是一名深水城半身人。让我们一起，呃r……我们那时候都在做什么？我们是在拯救我们的城市还是其他什么？”~
@89969 = ~“对！继续拯救我们的城市！”~
@89970 = ~“呸。和以前一样的臭。难道纳什尔领主不理解从国库借和从其中偷钱的区别，是我的错？当然不是。”~
@89971 = ~“你的意思是无冬城的英雄？是，<HESHE>也在那里。你使我回忆起<HIMHER>一点来了，真的。”~
@89972 = ~“如果你问我，他们会给那个<GIRLBOY>更多的信任的，而不是那些小人物……更不可能是做过那些事的艾瑞贝丝小姐了。真的是这样，是吗？”~
@89973 = ~汤米想了一会，一直摸着下巴。“你知道的……我也不知道怎么说。我想应该再去冒一次险。”~
@89974 = ~“哦。她是这么可爱的小姑娘，一个效命于无冬城主纳什尔领主的圣武士。与瘟疫战斗是她的职责。”~
@89975 = ~“是，你听说过她？她就是听命于纳什尔领主与瘟疫战斗的那个小姑娘。就是她找打了无冬城的英雄……我不知道你时候也听说过她。”~
@89976 = ~“不管怎样，她最后背叛了那个城市。堕落了。她的甲胄变成了黑色。虽然她的新装备很吸引人，但真得是悲哀啊。”~
@89977 = ~只有一次，伤感从半身人的眼中流露出来，他斜看着你。“该死的，”他勉强地说。“不对，但是……我猜应该是。”~
@89978 = ~“我很喜欢她。有趣的是没有人因为驱赶她去那里而向纳什尔领主道歉。如果我再看到他，我肯定会跟他说的。”~
@89979 = ~“我永远不会站在周围的……但是至少现在我会呆在这里。”~
@89980 = ~“好！我们走！”~
@89981 = ~“太忙了而不和那个看着你背影的家伙聊聊，嘿？好，好，汤米会记得的，他会的。”~
@89982 = ~“好，请原谅那个坏汤米冒犯了您尊贵的客人而没有道歉。”~
@89983 = ~“好，我对我的粗鲁和态度表示歉意。我还不足以选你作为我的尊贵的客人。”~
@89984 = ~“好的。哦，高贵的<LADYLORD>，我这低级的米虫能和您说话吗？”~
@89985 = ~汤米皱了一下眉头，眼珠不停的转着。“很好，走你的路去吧。”~
@89986 = ~“你认为我下次应该用匕首刺你。”~
@89987 = ~“好的，下次我会脱掉我满是血腥的短裤，打旗号使你停下来。”~
@89988 = ~“哪里粗鲁了？我说过‘听着，母牛’吗？没有，我不这么认为。”~
@89989 = ~“这没什么粗鲁的，如果要引起你的注意，我会按一下你的屁股。”~
@89990 = ~“你拿了多少钱？”~
@89991 = ~“我刚刚获得这个我了解的投资机会，不是吗？”他怀疑的环顾了一下，靠得更近。~
@89992 = ~“嘘！不要这么大声！是，柠檬！这是来自玛兹提卡的黄色小水果，他们会是你吃过的最酸的东西。”~
@89993 = ~当他变得高兴的时候，他的眼睛可以看得更远“想想看，它可以变成一种新潮的水果，被贵族所喜爱，还可以在小卖部卖！更重要的……它还可以清除多余的油脂。”~
@89994 = ~“我们不要愚蠢无知，好吗？不管怎样，你怎么想的？”~
@89995 = ~“从玛兹提卡引进血腥的柠檬！我们都可以得到数百万元！”~
@89996 = ~“你喜欢这个主意？”他看上去很惊奇，“我会越来越好的，唔……现在的目标是使所有山下地城生意好起来。”~
@89997 = ~“什么？你不会去打听你朋友的财政状况，是不是？”~
@89998 = ~汤米思虑地皱了皱眉头“好，很适合你。”他瞟了一眼的他的带子包，没有再说什么。~
@89999 = ~“你去过卡林珊吗？最近我都一直在想你看上有多么的熟悉。”~
@90000 = ~汤米眯着眼睛很长一段时间注视你。“我过了一会才发现，但是我一直都在想……你很像欠我很多钱的这个<GIRLBOY>。”~
@90001 = ~“一个老朋友。金色头发，绿色眼睛，粗糙的皮肤，野蛮的眼神。从来都没还过我钱。”他的话语更加可疑。~
@90002 = ~“你认为你欠我的？”~
@90003 = ~汤米眉头紧皱。“你知道的，你不必一直都要说那个。”他转过身来，咕哝着什么。~
@90004 = ~“好。”他怒视你很长一段时间，好像在考虑着他的权力，最后离开，来了句，“我会一直注视你的。”~
@90005 = ~“是吗？如果你来到深水城并且改变了你的外貌那会怎样？”~
@90006 = ~“哈！那也是*<HESHE>*说的！”他在最后离开之前对你做后的怒目而视了一眼。轻声嘀咕着。~
@90007 = ~“我说你看起来非常像<HIMHER>，而不仅仅像<HIMHER>。”汤米在最后离开之前对你做后的怒目而视了一眼。轻声嘀咕着。~
@90008 = ~他疑惑的盯着你。“你确定？我从来都不会忘掉的一张脸，你知道的。”~
@90009 = ~“我有个问题想问你：你碰到过一个叫萨米的半身人吗？还是沿途一直跟着你？”~
@90010 = ~“是，他有了姓，笨拙之心！萨穆埃尔·笨拙之心！我终生的报应！”他突然在空中晃动起他的拳头，好像在为他的霉运抱怨着上帝。~
@90011 = ~“他是我儿时的玩伴，死党……知道他出卖我！”汤米又一次在空中晃动他的拳头。~
@90012 = ~“好了，不要再说了！我的一生是都在变态的折磨中度过的！”~
@90013 = ~“也许不是我的一生，但是也够了！如果传说中的卡林珊的盗贼不是冲着他来，那我就可以畅饮一番了！”~
@90014 = ~“哦，如果你碰到他，那你就得忍受着他关于他妻子的喋喋不休。或者那个时候他被逮捕了，呃r……或者其他时候。”~
@90015 = ~汤米想了一会。“也许某个时候他被卖作奴隶，不会一点都不知道的！”~
@90016 = ~“你不需要去*残杀*他，另外对我的复仇，那个穷小子看上去会激动得拿着把匕首朝我冲过来，完全失控。”~
@90017 = ~“是，好……我们恢复你的生意。”~
@90018 = ~“不要对它有任何信任。它已经疯了，另外对我的复仇，那个穷小子看上去会激动得拿着把匕首朝我冲过来，完全失控。”~
@90019 = ~“那并不重要，重要的是他做的那个。”汤米愤怒的看着你。“谴责不专业的他，我告诉你。也不领情。”~
@90020 = ~“另外对我的复仇，那个穷小子看上去会激动得拿着把匕首朝我冲过来，完全失控”~
@90021 = ~“他一直都在折磨我，就是这个！”~
@90022 = ~“不对，我的一生都是在变态的折磨中度过的！”~
@90023 = ~“我只是想知道你是否是书中提到的那个<GIRLBOY>，是不是？”~
@90024 = ~“对，我不应该责备你。”汤米摇着头，低声地说。~
@90025 = ~德金心理混乱的看着汤米，撞着头皮“你，唔，你想德金写一本关于你的书，现在吗？”~
@90026 = ~“没有。我人格受到多方面的损毁，谢谢你。不要记录任何东西。”~
@90027 = ~汤米扭曲着脸，好像他要开始一个令人不愉快的话题。“是的，我只是想知道，你是不是度过那个东西的？”~
@90028 = ~“可以解释的。你看到了吧，关于他有点奇怪的东西。”~
@90029 = ~“你做的，是不是？”他看上去有点惊奇。“你没发现有点奇怪的东西？一点都没有？”~
@90030 = ~“你看，这个‘压力’是在英雄和<HISHER>‘以前的狗头人伙伴’发展起来的。”~
@90031 = ~“就这样？你难道不记得那个小鬼何时给你花的吗？”~
@90032 = ~“然后他说，你知道的……你*以前的*老板如何？”~
@90033 = ~“是，你可以继续，继续谈论你是多么的对他表示感激地”~
@90034 = ~“我知道！该死的血书……不能相信他们！全是谎言！”~
@90035 = ~他看上去满脸歉意。“你知道的，我不得不问。”~
@90036 = ~“也许。”他耸耸肩，看上去满脸歉意。“你知道的，我不得不问。”~
@90037 = ~“对，放下来。”他看上去满脸歉意。“你知道的，我不得不问。”~
@90038 = ~他耸耸肩。“我不知道。看上去好像是哪本书有强烈的暗示你不是，那个小鬼才是*真正的亲密*。”~
@90039 = ~汤米看上去好像会继续，然后皱起嘴唇，决定反对。“行，没问题。我们向前走，好吗？”~
@90040 = ~“那的确是说中所说的东西。”~
@90041 = ~“你知道的……压力。就像在引力中似的，是吗？就像两个民族喜欢第三个一样？”~
@90042 = ~“呃……我没在说*那*种压力。”~
@90043 = ~汤米凝视着你，哈着嘴。一会儿后，他记的再次把它关闭。“对。我，阿……啊啊啊啊啊……好。”~
@90044 = ~汤米凝视着你，哈着嘴。一会儿后，他记的再次把它关闭。“也许这点合作关系比我该死的想像的要好，”他嘀咕着。~
@90045 = ~“哦，好，我知道了。”~
@90046 = ~汤米把脸转过去，无忧无虑的吹着口哨。一会后，一些东西溅到了他的嘴里，闻上去好像有略微的清凉。~
@90047 = ~“我该做些什么，增加数值范围？”他板着脸。“不管怎样，轰了它。”~
@90048 = ~“没烦到你吧？”~
@90049 = ~“可是，*我*会疯的，我会的。汤米要维持他的声誉。但是如果你不介意，”他耸耸肩。“那我们就来继续做。开始为后果最好准备，好吗？”~
@90050 = ~他转动着他的眼睛。“哦，呼呼。你真有趣，真的。所以你知道英雄与<HISHER>‘以前的狗头人伙伴’之间的压力，是吗？”~
@90051 = ~“真的？”他看上去困惑了一会，然后摇摇头。“我没聊关于那个的东西。你也看到了……这种压力在英雄与<HISHER>‘以前的狗头人伙伴’之间发展了……”~
@90052 = ~“哦，你知道的……狗头人写的那点东西。”~
@90053 = ~“唔……德金就在这儿，你知道的……”~
@90054 = ~--------- 此处开始随机对话 ----------~
@90055 = ~“如果你有兴趣的话，我想我知道怎样通过那个入口到达。”~
@90056 = ~“按照推测，不管你何时穿过那个门口，那些铁链就会突然掉落，而且他们会围绕这个水平去其他地方。然后你就再次搜集他们而不要使他们退到门口”~
@90057 = ~“听上去就像有人想让穿过这地下城的过程变得更难些。我跟你说，建造这地方的巫师小子真他妈的难缠。”~
@90058 = ~“是啊，好，我说要是再碰到一个迷题，我的脑袋准得炸开。”~
@90059 = ~“不是。我可没有那么深入，记得吗？”~
@90060 = ~“黑暗精灵提到过这个，真的。他们手里有这些链子中的一件，而且还在打探其余部分的下落。”~
@90061 = ~“随你便。我可有其他的事情要做，不管怎样……像观看其他半精灵杀死黑暗精灵那样的事情。”~
@90062 = ~“布兰多巴里斯的长毛脚！这里比他妈的卡林珊的尿盆里还多！”~
@90063 = ~“呵……好，让汤米好好想想他的脚之外的事情。”~
@90064 = ~“你来想想，我记得自己肯定听说过这里。它是……呃……沉睡王者大厅或是别的什么。或者是这个喝醉的小子过去跟我说过的什么。”~
@90065 = ~“我猜建造这地方的巫师一定非常喜欢收集远古北方国王尸体之类的东西。然后把他们放在这里展览，我想。”~
@90066 = ~他耸了耸肩，说道，“我不知道。你们这些人类把国王和王后的尸体扔得到处都是，也许这位巫师只是弄来一部分而已。我所知道的只是我绝不会去动这些尸体……对我而言，他们看起来可不*那么*像死人。”~
@90067 = ~“喂！说话小心点！我觉得你话里有刺。”~
@90068 = ~“很好。我一点都不觉得他们是那种笑嘻嘻的类型。”~
@90069 = ~“随时奉陪，哥们！”~
@90070 = ~“我可什么也没看到。不过我绝对不会去动这些小子的。他们对我而言可没有*那么*像死人，要是你问我的话。”~
@90071 = ~他耸了耸肩，“我他妈的怎么会知道？别去动他们或者别的什么，这是我的忠告。”~
@90072 = ~“你知道，我认为这里是他们叫做镜之殿的地方。他妈的很有名，这里。”~
@90073 = ~“好，很好。随你怎么处理。汤米会呆在你看不到的地方，也许更远一点，假如你无所谓的话。”~
@90074 = ~“好，很好。随你怎么处理。汤米会从你眼前消失，假如你无所谓的话。”~
@90075 = ~“也许是因为这里排列着的这些镜子。只是我的个人想法，你知道。”~
@90076 = ~“我也许是。对你而言那又如何？”~
@90077 = ~“嘿！嘿！不要突然那么冲动，行吗？汤米说的话里可没什么特别的意思。只是在警告你要当心这些镜子。”~
@90078 = ~“好。谢了。知道了。那么再来看看这地方……？”~
@90079 = ~汤米的眼睛轱辘辘地打转，叹道，“好。不管如何，你想听听关于这大厅地事情吗，还是不想？”~
@90080 = ~汤米看着你，咽了一口口水，显然有点失常。“唔……啊。我那么说是有目的的，不是冒犯你。只是在警告要当心这座大厅，就这些。”~
@90081 = ~“好，我曾经听说过一个传说，关于山下地城里某个有成排镜子的地方……它们中有些是有魔力的，有些则没有。它们中的一些就像传说中的一样，的确十分危险。”~
@90082 = ~“我有个朋友，他说他曾看过其中的一面镜子，然后他的镜像居然他妈的从镜子里走了出来攻击他！我可不喜欢冒出来另外一个汤米到处跑。”~
@90083 = ~“哦……还有另外一件事：我的朋友还说过他曾经打碎一堆镜子，从几面镜子里找到了不错的财宝。不过之后就没那么好的运气了。每面镜子加起来就是七年，你知道。”~
@90084 = ~“而且那有很多。”汤米伸了个懒腰。“可怜的小子。他最后被刺死了。我真的是没有选择了。”~
@90085 = ~“你说什么，要我站到你看不到的地方去？只是以防万一？”~
@90086 = ~他疑心重重地看着你：“好……行。不过我有不好的预感。”~
@90087 = ~“行！祝你好运！”~
@90088 = ~他点点头，笑道：“是啊，大家就是这么叫它的。它也不是这里唯一的一块魔镜，所以你还是要小心。”~
@90089 = ~“呵呵呵。你真他妈逗。”~
@90090 = ~“好。不过，我也特别地不喜欢这个念头：有另外一个*你*在到处乱跑，所以在我们看镜子的时候小心一点，行吗？”~
@90091 = ~他的思绪在那个主题上停留片刻，接着他突然开怀大笑：“不过那也够了。我想你是需要我加入你的行列，不是吗？”~
@90092 = ~“你把我带回来就是为了把我留在这里？我可不是抱怨，但是这么做似乎有点傻。”~
@90093 = ~------- 这一行必须放在队员之间说笑的结束处 ---------~
@90094 = ~“那么我听说你是个讲故事的，沙尔文，是真的咯？”~
@90095 = ~“确实如此。毕竟我是个吟游诗人。”~
@90096 = ~“那么你一定曾经听到过我汤米·安德葛洛斯的大名了，是吧？”~
@90097 = ~“没有，对不起喔。我只听说过一些大人物呢。”~
@90098 = ~“哦！我要宰了你这个家伙！”~
@90099 = ~“也许这么做能让你好受些，我的确听说过你的事情。”~
@90100 = ~“你听说过？”~
@90101 = ~“我听说你完全是头猪。”~
@90102 = ~汤米思考了半天，张口大笑，“比没有听说过要好。”~
@90103 = ~“那么……沙尔文，真是这样的？那对个女孩子而言倒是个好名字。”~
@90104 = ~“想都别想，半身人。”~
@90105 = ~“什么？我可几乎什么也没有说！你何必那么紧张？”~
@90106 = ~“你以为我不知道你的名声？虽然外形小巧，你却是个大男子主义者……”~
@90107 = ~“真的吗？好……我真他妈高兴你能注意到这一点。”~
@90108 = ~“那你觉得怎么样才算是大男子主义者？”~
@90109 = ~“你真的需要我来解释吗？把所有事情大声说出来？”~
@90110 = ~“哦，别介意……”~
@90111 = ~“达尔兰？我有个问题要问你。虽然我不是打算要冒犯你……”~
@90112 = ~“如果是你的话，我保证不生气。那就请说下去吧。”~
@90113 = ~“好，我的意思就是……我一生中见过不少半兽人，你知道么？而你是我这辈子遇到的第一个……不那么……你知道……”~
@90114 = ~“一个彻彻底底的大傻瓜？”~
@90115 = ~“那可是你说的。”~
@90116 = ~“你是对的，汤米。我怎么可能会为这种问题生气？”达尔兰重重地叹了口气，“那么你到底想知道些什么？”~
@90117 = ~“好……”汤米思虑重重地敲打着自己的下巴。“我只是想知道一件事……你的小聪明让你更容易和女士们相处呢……还是更*差*些？”~
@90118 = ~“汤米……”~
@90119 = ~“是啊，大小伙子？”~
@90120 = ~“也许你把精力放在手头的冒险上会更好些。”~
@90121 = ~“行！我会注意的。”~
@90122 = ~“唔。你可真是个大家伙，不是吗，达尔兰？”~
@90123 = ~“你指的是？”~
@90124 = ~“我指的是像你这样的大家伙需要保持愉快！让汤米来玩个把戏吧！你把你的戒指交给我如何？”~
@90125 = ~“很好。不过你要还给我的，半身人。”达尔兰取下戒指交给他。“知道了吗？”~
@90126 = ~“呵呵……我会耍你吗？你这么说可有点不公正，不是吗？”~
@90127 = ~“也许不是，不过这是明智的。”~
@90128 = ~“呃……啊。总之……”汤米拿走了戒指，在两只手上交换了好几次。在经过了几次很花哨的动作之后，他把戒指抛了起来……然后它就消失了！“Ta-da！”~
@90129 = ~“给你三秒钟把戒指还给我，半身人。”~
@90130 = ~“你真是个不配合的观众，不是吗？”汤米勉强地把手伸进口袋里，取出戒指，交了回去。达尔兰开怀大笑，不过什么话也没说。~
@90131 = ~“那么……我刚才观察你一小会儿……莉努……”~
@90132 = ~“你是个贼。我讨厌贼。我不想听你说话。”~
@90133 = ~“好，我是在想……你总是对说你如何的笨或者类似的事情纠缠不清。我认为那完全不是事实。”~
@90134 = ~她转过头去不理他，“我还是没有在听。我可不会让你的侮辱和嘲笑跑进我的耳朵。”~
@90135 = ~“我只是试着要告诉你，我觉得你一点也不笨。事实上，我觉得你是我见过的所有其他该死的精灵中最优雅的一位。”~
@90136 = ~“真。真的吗？你……你是这个意思？”莉努疑心重重地笑了，两眼满是泪花。~
@90137 = ~“不是喔。你比起长着两条左腿的食人魔要笨多了。”~
@90138 = ~莉努叹了口气，瞪着汤米说道，“我恨你，你这个小恶魔。”~
@90139 = ~“纠正：是*机敏*而且*灵巧*的小恶魔！哈哈哈哈哈哈！”~
@90140 = ~“莉努，你是个医生，对吗？我有点……痛……是旧伤，痛极了！”~
@90141 = ~“喔，那可真糟，亲爱的！哪里痛？也许我可以帮忙。”~
@90142 = ~“哦，已经结束了。我想我需要某种用手的治疗，假如你知道我的意思的话……”~
@90143 = ~“我想我知道。”~
@90144 = ~“我的意思是什么？”汤米朝她摇了摇眉毛，笑道。~
@90145 = ~“我说过我恨盗贼！！”莉努突然抓住汤米的耳垂，狠狠地捏它。“堕落的恶棍，你们都是恶棍！尤其是你！”~
@90146 = ~“噢！噢！嘿，你有什么问题？！切！”~
@90147 = ~“你以为我会忘记是你偷了我的圣杯这件事吗？就是你让我跑遍了无冬城。”~
@90148 = ~“哦……是那样子啊。”~
@90149 = ~“是啊。就是那样子的。”~
@90150 = ~“呵呵……那么我猜你是不会给我小小的治疗了，是吧？”~
@90151 = ~“你就祈祷我永远不会来做出决定是否要复活你吧。”~
@90152 = ~“你知道……我看过你的笔记，德金。还有你书里写的东西。”~
@90153 = ~“你有德金的笔记？还给我！”~
@90154 = ~“哦，你可以拿回去。我只是在想……要是上面被人乱涂乱改过了，那可怎么办呢？”~
@90155 = ~“别想和一个半身人做交易。”~
@90156 = ~“人心皆如此。不过其中有些人的想法看起来有点……嗯，要是你问我的话……淫荡。”~
@90157 = ~“德金可没问你。马上把德金的笔记交出来！”~
@90158 = ~“那么你就不管笔记上面的东西了？我可没怎么读它……它看起来就像死人写的遗嘱或者别的什么的……”~
@90159 = ~“老大！！！”~
@90160 = ~“行，行，把你该死的书拿回去吧，你这个大傻瓜。”~
@90161 = ~“都在这里了？很好。”~
@90162 = ~“那么，唔……你写完最后一章的时候记得告诉我……”~
@90163 = ~“唔……那么告诉我……狗头人……你有多高？”~
@90164 = ~“这就是你一直盯着德金看的原因？”~
@90165 = ~“只要告诉我你有多高就行了，妈的！到这里来，让我量量……”~
@90166 = ~“你就像奶酪一样臭！老大！老大！臭气熏天的半身人让德金恶心！”~
@90167 = ~“我可没有，你这该死的骗子！你就不能回答这个简单的问题吗？”~
@90168 = ~“他妈的别叫了。”~
@90169 = ~“不干不干！”~
@90170 = ~“我就是他妈的想知道！为什么你就是不懂哪！”~
@90171 = ~“疯子惹得德金都变高了。”~
@90172 = ~“就是那样！你可真是容易受到伤害哪，你这个穿孔的蜥蜴，你！”~
@90173 = ~“哦……对不起，老大。”~
@90174 = ~“哈！活该！”~
@90175 = ~“你应该买双高点的鞋子，也许。”~
@90176 = ~“噢，闭嘴。”~
@90177 = ~“你让老大发疯了。你真是个可怕的佣兵。”~
@90178 = ~“我要他妈的踢你屁股，给我当心点——”~
@90179 = ~“对不起，老大。”~
@90180 = ~“是啊，应该对不起。”~
@90181 = ~“没关系。”~
@90182 = ~“我想我们该分道扬镳。”~
@90183 = ~“不，别介意。”~
@90184 = ~“呆在这里等我回来。”~
@90185 = ~“我要走了。”~
@90186 = ~“我要修改你的战术。”~
@90187 = ~“现在我什么都不想改。”~
@90188 = ~“我要你把能看到的任何陷阱都放在一边不要去管它们。”~
@90189 = ~“我要你把能看到的陷阱都解除。”~
@90190 = ~“移动得更快一点，不要浪费时间去搜索或是潜行。”~
@90191 = ~“我要你马上潜行。”~
@90192 = ~“要是我打不开锁上的门或是箱子的时候，别来帮我。”~
@90193 = ~“要是我打不开锁上的门或是箱子的时候，来帮我。”~
@90194 = ~“我要改动你离我的距离。”~
@90195 = ~“离我远一点。”~
@90196 = ~“保持中等距离。”~
@90197 = ~“靠近我。”~
@90198 = ~“看到敌人的时候攻击前进。”~
@90199 = ~“守住我的侧翼，在我开始进攻的时候再动手。”~
@90200 = ~“我要调整你的装备。”~
@90201 = ~“你能鉴定我的装备么？”~
@90202 = ~“你能召唤你的阴影吗？”~
@90203 = ~“我要你开始影藏。”~
@90204 = ~“你刚才要说什么？”~
@90205 = ~“让我们停下谈一会儿。”~
@90206 = ~“我们说完了。”~
@90207 = ~“不，没有别的了。”~
@90208 = ~“一切顺利吗？”~
@90209 = ~“我要和你讨论一下有关训练的事情。”~
@90210 = ~“回去把你的训练时间平均分给游荡者和影舞者。”~
@90211 = ~“就按你现在在做的练下去。”~
@90212 = ~“集中力量成为一个影舞者。”~
@90213 = ~“集中力量成为一个游荡者。”~
@90214 = ~“影舞者是什么东西？”~
@90215 = ~“做完这一切后你有什么计划？”~
@90216 = ~“冰风谷？那算是什么度假方式？”~
@90217 = ~“很好的计划。我也许非得加入你不可。”~
@90218 = ~“也许这个黑暗精灵对你而言太强了？”~
@90219 = ~“我想我一定在什么地方听到过那个。”~
@90220 = ~“你是个非常奇怪的半身人。”~
@90221 = ~“那在你帮助拯救了无冬城之后发生了什么？”~
@90222 = ~“我突然不想知道了……”~
@90223 = ~“对，在那之前。”~
@90224 = ~“什么误会？”~
@90225 = ~“我知道会怎么发展……”~
@90226 = ~“所以他把你赶出了城？”~
@90227 = ~“什么事情？”~
@90228 = ~“你成立了一个盗贼公会。”~
@90229 = ~“我不想再听了。”~
@90230 = ~“纳什尔领主把你赶出城也没什么可奇怪的！”~
@90231 = ~“然而怎么样了？”~
@90232 = ~“谁又是纳什尔领主？”~
@90233 = ~“你和他之间有一个误会？”~
@90234 = ~“你说你来自无冬城，是吗？”~
@90235 = ~“对，那个时候我正在山顶村。”~
@90236 = ~“那你在无冬城肯定很受欢迎。”~
@90237 = ~“为什么我不会感到惊讶呢？”~
@90238 = ~“我是这么听说的。”~
@90239 = ~“无冬城现在怎么样了？”~
@90240 = ~“跟我说说艾瑞贝丝女士的事情。”~
@90241 = ~“我好像听说还有其他人负责消除这场瘟疫？”~
@90242 = ~“那位英雄怎么了？”~
@90243 = ~“这位艾瑞贝丝女士是谁？”~
@90244 = ~“可怜的女孩？你是指艾瑞贝丝女士？”~
@90245 = ~“她怎么了？”~
@90246 = ~“不，在这里呆一会儿。”~
@90247 = ~“对，跟我走。”~
@90248 = ~“现在不行。我很忙。”~
@90249 = ~“你应该知道，不需要这么粗鲁的。”~
@90250 = ~“也许以后吧。”~
@90251 = ~“那样就更好了。”~
@90252 = ~“那是什么，汤米？”~
@90253 = ~“金币？不多。”~
@90254 = ~“金币？我有很多啊。”~
@90255 = ~“柠檬？”~
@90256 = ~“够了，汤米。我不感兴趣。”~
@90257 = ~“一种很酸的水果？谁想要这种东西？”~
@90258 = ~“准确地来说，这项投资是怎么回事？”~
@90259 = ~“也许你可以用它来榨汁喝。”~
@90260 = ~“关于什么？”~
@90261 = ~“听起来不错。”~
@90262 = ~“我会帮你拿回来的。”~
@90263 = ~“没～错～”~
@90264 = ~“真是个无礼的问题。”~
@90265 = ~“你为什么要知道？”~
@90266 = ~“你可以问，但是我没有义务回答。”~
@90267 = ~“不，你不能。”~
@90268 = ~“你为什么要问？”~
@90269 = ~“准确地说，这位欠你钱的<GIRLBOY>是谁？”~
@90270 = ~[叹气]“而我也决不会的。”~
@90271 = ~“好吧，听起来像是我。”~
@90272 = ~“那听起来一点都不像我。真是愚蠢。”~
@90273 = ~“虽然我并不推荐这种做法，不过你可以试着去收集看看。”~
@90274 = ~“也许我不该复活你，就让你死在那里的……”~
@90275 = ~“我没什么可承认的。”~
@90276 = ~“当然的事情。矮子，把它带上。”~
@90277 = ~“太荒唐了。”~
@90278 = ~“你真是有病。”~
@90279 = ~“好吧，你得手了。不过我也把你愚弄了。”~
@90280 = ~“如果我看起来不一样了，那么变得像这个人怎么样？”~
@90281 = ~“不，我从没有去过卡林珊。”~
@90282 = ~“我都不知道卡林珊在哪里。”~
@90283 = ~“你觉得我们以前见过？”~
@90284 = ~“对，我很肯定，以前从没有去过卡林珊。”~
@90285 = ~“萨米？他的名字是什么？”~
@90286 = ~“不，我从没见过叫那种名字的人。”~
@90287 = ~“什么，他欠你钱？”~
@90288 = ~“我还敢问？”~
@90289 = ~“对。他是你的敌人。我明白了。”~
@90290 = ~“我记得你说过，他是你幼时的玩伴？”~
@90291 = ~“一看见他就宰了他。去吧。”~
@90292 = ~“我打赌。”~
@90293 = ~“你是在开玩笑吗？我突然想听听他会怎么说。”~
@90294 = ~“他到底为什么会背叛你呢？”~
@90295 = ~“他到底做了什么？”~
@90296 = ~“太不可思议了吧？”~
@90297 = ~“你为什么要问呢？”~
@90298 = ~“我真的不想谈那件事情。”~
@90299 = ~“提到过了？那可是我冒险旅程中的编年史。”~
@90300 = ~“几乎不行了。为什么是我？”~
@90301 = ~“不，我从没有考虑过。”~
@90302 = ~“我一点都不怀疑。你觉得呢？”~
@90303 = ~“你在说什么？”~
@90304 = ~“对，是我。”~
@90305 = ~“不，一点都不奇怪。为什么？”~
@90306 = ~“我能肯定，你正在考虑问题。”~
@90307 = ~“关于什么的？”~
@90308 = ~“所以呢？他一直在说那件事。”~
@90309 = ~“噢，那是个弥天大谎。”~
@90310 = ~“嗯。我同意。”~
@90311 = ~“总之，我觉得你有些曲解了。”~
@90312 = ~“我们别再谈这个话题了，好不好？”~
@90313 = ~“你想要说什么，汤米？”~
@90314 = ~“你有病啊。赶快把它放下。”~
@90315 = ~“我们是朋友。我还是不知道你是什么意思。”~
@90316 = ~“我*当时*非常感激他。”~
@90317 = ~“我*曾经*是最好的老板。”~
@90318 = ~“德金从没有给过我花。真无聊。”~
@90319 = ~“那它怎么了？”~
@90320 = ~“我不明白。你在说什么？”~
@90321 = ~“紧张？我发现他真的很烦人。”~
@90322 = ~“哦，那样啊。嗯，他*就是*个可爱的狗头人。”~
@90323 = ~“我是在说笑。”~
@90324 = ~“如果你幸运的话。”~
@90325 = ~“汤米，你不是狗头人。”~
@90326 = ~“所以？所以什么？”~
@90327 = ~“为什么？德金是个可爱的小狗头人。”~
@90328 = ~“那不对，所以我也没留心。”~
@90329 = ~“那只是本书。我有什么好注意的？”~
@90330 = ~“我可不愿去想，你究竟在考虑什么奇怪的事情。”~
@90331 = ~“这话说得太狠了。”~
@90332 = ~“除了是狗头人写的这个事实？”~
@90333 = ~“在哪本书里面提到的？”~
@90334 = ~“那告诉我，你都知道些什么。”~
@90335 = ~“是链条。知道了。只是个简单的谜题。”~
@90336 = ~“你知道链条在哪里吗？”~
@90337 = ~“你是怎么知道的？”~
@90338 = ~“我不需要你帮我做那件事，谢谢。”~
@90339 = ~“如果你没什么重要的事情可说，就请保持安静。”~
@90340 = ~“你觉得这些骷髅会是谁？”~
@90341 = ~“汤米，那有点不雅。”~
@90342 = ~“什么北方的君王们？”~
@90343 = ~“你给我管好自己的手，半身人。”~
@90344 = ~“我可不打算逗他们玩。”~
@90345 = ~“呀。谢谢你的建议。”~
@90346 = ~“你发现有陷阱？”~
@90347 = ~“你认为他们会醒过来？”~
@90348 = ~“汤米，我不需要听到消息。”~
@90349 = ~“为什么他们会那样叫它？”~
@90350 = ~“你是在嘲弄我？”~
@90351 = ~“我不需要。把那些话留给你自己吧。”~
@90352 = ~“没什么。现在……我们来谈谈怎么分你的财宝吧……”~
@90353 = ~“如果我们要一块儿旅行的话，我希望你能对我尊重一点。”~
@90354 = ~“你是在找死吗，半身人？”~
@90355 = ~“好，好。你都知道些什么？”~
@90356 = ~“我是说，为什么要起一个特别的名字，巧嘴？”~
@90357 = ~“好。我会小心的。”~
@90358 = ~“不，留在我视线之内。”~
@90359 = ~“对，就那样干。”~
@90360 = ~“这里有一面复制之镜？”~
@90361 = ~“如果下次你死的时候有个备份的话就太好了。”~
@90362 = ~“我也不喜欢那个点子。”~
@90363 = ~“你知道些什么吗？”~
@90364 = ~“对，我们走吧。”~
@90365 = ~“不，就在这里呆着。”~
@90366 = ~“汤米……”~
@90367 = ~“汤米，让他一个人呆着。”~
@90368 = ~“汤米，你为什么想要知道？”~
@90369 = ~“德金，别骂他。”~
@90370 = ~“汤米，他比你高。原谅它吧。”~
@90371 = ~“你们两个给我住手！”~
@90372 = ~“够了！”~
@90373 = ~火矮人~
@90374 = ~眼魔巫师~
@90375 = ~瓦尔寇里安~
@90376 = ~阿瑟提斯~
@90377 = ~这个强大的人形生物是由它的主人从外层位面召唤来的风巨灵。~
@90378 = ~虹彩龙~
@90379 = ~古幽影龙~
@90380 = ~蛛化精灵首领~
@90381 = ~蛛化精灵法师~
@90382 = ~黑暗精灵奴隶~
@90383 = ~黑暗精灵法师~
@90384 = ~灰矮人奴隶~
@90385 = ~灰矮人首领~
@90386 = ~欲魔~
@90387 = ~不像其他的魔鬼，欲魔有着诱人的外表，看起来像是非常美丽的女子，不过它们还拥有一对巨大的羽翼和泛着邪光的眼睛。~
@90388 = ~女性蛛化精灵~
@90389 = ~蛛化精灵牧师~
@90390 = ~眼球魔宠~
@90391 = ~秘银魔像~
@90392 = ~精金魔像~
@90393 = ~超大铁魔像~
@90394 = ~黑暗精灵游荡者~
@90395 = ~黑暗精灵武士~
@90396 = ~黑暗精灵法师~
@90397 = ~黑暗精灵祭司~
@90398 = ~灰矮人武者~
@90399 = ~灰矮人游荡者~
@90400 = ~灰矮人法师~
@90401 = ~灰矮人女祭司~
@90402 = ~夺心魔幽暗者~
@90403 = ~夺心魔~
@90404 = ~催心魔~
@90405 = ~夺心魔崇拜者~
@90406 = ~灾厄黑刃~
@90407 = ~这件魔法武器是由灾厄黑刃法术召唤出来的。~
@90408 = ~被召唤的骷髅暗黑暗卫士~
@90409 = ~被召唤的高等波达尸~
@90410 = ~被召唤的红龙~
@90411 = ~被召唤的传奇阴影领主~
@90412 = ~这个幽影是由强大的影舞者召唤出来的。~
@90413 = ~夏尔刚的永恒之刃~
@90414 = ~这个刀刃是通过法术召唤出来的。~
@90415 = ~被召唤的食尸鬼王~
@90416 = ~被召唤的巫妖~
@90417 = ~被召唤的巫妖领主~
@90418 = ~被召唤的慑心魔~
@90419 = ~被召唤的慑心魔长老~
@90420 = ~被召唤的低等半神巫妖~
@90421 = ~被召唤的木乃伊~
@90422 = ~被召唤的武士领主~
@90423 = ~被召唤的幽灵~
@90424 = ~泰南，蛛化精灵~
@90425 = ~泰南，地精~
@90426 = ~被召唤的吸血鬼游荡者~
@90427 = ~被召唤的吸血鬼巫师~
@90428 = ~被召唤的传奇弗洛魔~
@90429 = ~这只弗洛魔侍奉一位强大的暗黑暗卫士。~
@90430 = ~史拉黑蟾~
@90431 = ~史拉白蟾~
@90432 = ~狩魔蛛~
@90433 = ~斯涅布力~
@90434 = ~夺心魔触须~
@90435 = ~死亡面具~
@90436 = ~复合长弓+4~
@90437 = ~这把魔法弓有攻击加成。而且可让使用者把力量调整值加在伤害值上。~
@90438 = ~复合长弓+5~
@90439 = ~复合短弓+4~
@90440 = ~复合短弓+5~
@90441 = ~獾动物伙伴躲藏等级21~
@90442 = ~獾动物伙伴躲藏等级25~
@90443 = ~獾动物伙伴躲藏等级30~
@90444 = ~獾动物伙伴躲藏等级35~
@90445 = ~獾动物伙伴躲藏等级40~
@90446 = ~卓尔大盾+2~
@90447 = ~卓尔大盾+3~
@90448 = ~卓尔大盾+5~
@90449 = ~卓尔头盔~
@90450 = ~灰矮人头盔~
@90451 = ~陌生人头盔~
@90452 = ~骷髅面具~
@90453 = ~所有托雷边境上的死灵师都佩戴着大法师萨兹·塔姆最近制作的这些面具。戴着这种面具的人能够操纵强大的魔法，不过还是会受到塔姆的控制。不戴这种面具就练习死灵法术的法师都会被杀，然后会变成能比生前更好地为塔姆干活的食尸鬼。~
@90454 = ~咒甲衫~
@90455 = ~卓尔咒剑士通常穿着这种轻甲。它是用一种罕见的轻便金属制成的，所以柔韧性非常好。这些特性使得它能够降低奥术施法者穿甲施法时的失败几率。~
@90456 = ~全身甲+6~
@90457 = ~大型盾+6~
@90458 = ~大型盾+7~
@90459 = ~普拉特之盾~
@90460 = ~迪欣·普拉特是一名昂瑟的英雄，他领导了最成功的一次起义，称作穆霍兰迪征服者。他的反抗持续了两个月，起义队伍最多时达到了1500人。他的军队引起了一名对昂瑟不满的巫师的注意，这名巫师开始向起义队伍提供魔法援助，包括了这面盾牌。当起义队伍最后被消灭时，普拉特也死了，不过他的盾牌却不见了。~
@90461 = ~混乱盾牌~
@90462 = ~小型盾+6~
@90463 = ~小型盾+7~
@90464 = ~塔盾+6~
@90465 = ~塔盾+7~
@90466 = ~巨龙壁垒~
@90467 = ~达尔森是一位高明的铁匠，他用一条上古巨龙的鳞片和骨骼造出了这面强力的盾牌。尽管达尔森并不曾吹过牛，不过当他宣称是自己杀了那头野兽的时候，却很少有人相信。大多数人认为是他恰好遇到这条龙的尸体，然后取得了所需的材料。不管真相如何，就算是最勇敢的骑士，对这面盾牌提供的防护都感到很满意。~
@90468 = ~拉萨尔的最后腰带~
@90469 = ~拉萨尔是一位名不见经传的小法师，他觉得自己足以在法师对决中击败某位强大的大法师。当了解到他的对手喜欢使用死亡魔法的时候，拉萨尔制作了这根带子以免疫那类法术。决斗的那天来临了，两位法师站在场地的两头对峙。大法师首先使出了恶毒的死亡一指以及律令死亡，可拉萨尔却在那里哈哈大笑。
“你真没用！”拉萨尔嘲笑他的对手。
大法师皱了皱眉，露出了狡猾的笑容。他用手一指，召唤出了一头凶暴熊，一口就把可怜的拉萨尔给活吞了。~
@90470 = ~铸魔板甲~
@90471 = ~当你用手靠近这件铠甲的时候会感到一股刺痛。低等的魔鬼或是恶魔被上位者关到护甲或武器里是很常见的事情。就有这么一位邪恶的仆人不慎陷入了这件锻造精巧的护甲里，他的意志会和穿护甲的人合为一体。他能预见到穿戴者的运动，减少奥术失败几率。~
@90472 = ~饮魂者之父~
@90473 = ~出于对血肉的渴望，通常只有追求死亡和毁灭的战士才会挥舞这把邪恶的兵刃。有些战士声称自己出于善良，想要控制这把饮魂者，并将其用于高尚的目的，但是事与愿违，他们不堪忍受屠杀和死亡带来的恐惧。曾经有一名战士发现自己身处大教堂，身旁尽是祭司的尸体，而自己手里正拿着这把剑，于是他陷入了无限的内疚之中。~
@90474 = ~牧师长袍~
@90475 = ~信仰护甲~
@90476 = ~这件护甲好像会发出令人宽心的银光。~
@90477 = ~这件护甲是从一个被不知名的神祇祝福过的熔炉里锻造出来的，它自身发出的光芒通常能显示出穿着者的决心。一些狂热者和国王穿上以后，往往可以作为他们正义和勇敢的象征。~
@90478 = ~血之缚盟~
@90479 = ~只有身手特别敏捷和幸运的战士才能穿上这件衣服。穿上这件铠甲的人很难在一个地方停留住，会比平常移动得更快。~
@90480 = ~卡席尔之魂~
@90481 = ~这件铠甲好像有些不太正常的黑色长钉以及某种暗淡的闪光。~
@90482 = ~这件用黑钢片制成的板甲，有残酷的奴隶主风格装饰，它只适合于寻找世界上罪恶之物的人们。这件铠甲据说由卑劣之卡希尔领主对抗科米尔的紫龙骑士时穿着。在卡希尔领主死后，据说这件铠甲被摧毁了。~
@90483 = ~舞者轮廓~
@90484 = ~一些柔软的接合物和填充用的衬垫组成了这件漆黑而坚硬的革甲。~
@90485 = ~这件铠甲制作出来主要是考虑到为了防护背后射过来的匕首。由于结构精巧，使得接缝相当紧凑，穿着它行动时几乎不会发出任何声音。~
@90486 = ~弗莱彻之友~
@90487 = ~为某种特殊职业而精心设计的一套铠甲。~
@90488 = ~毫无疑问，这套铠甲是出自一位有经验的精灵之手。它为那些将魔法艺术与致命的弓术结合在一起的战士作了特殊的设计。它能够提供最完善的保护，而不必牺牲用弓射击时所需要的移动力。~
@90489 = ~临终遗言~
@90490 = ~一套穿起来很舒适的暗色衣服。~
@90491 = ~这是精英刺客的制服。只有对自己的能力非常有信心的人才敢把这套衣服穿出来。许多人都没有意识到，这其实是训练有素的专业杀手的记号，只有少数人能领悟到它的含义。~
@90492 = ~振动戒指~
@90493 = ~这枚戒指摸起来很温暖。当佩戴着的时候，可以加快温度升高的速度。在这个过程中它会一直颤抖，所以人会变得有一些迟钝和体弱。尽管如此，如果是在非常寒冷的环境中，这样一枚戒指还有很有价值的。~
@90494 = ~暗少女之长袍~
@90495 = ~黑暗少女会的成员虔心服侍卓尔女神伊丽思璀。会中的僧侣致力于促进卓尔和地表种族之间的和平共处，但也会对邪恶作出快速而致命的打击。~
@90496 = ~变形者外衣~
@90497 = ~这件衣服好像没起到什么保护的作用，也许是为一些特殊用途设计的。~
@90498 = ~野性的血液会流淌到穿着者的血管里。对于那些常常化身于自然形态，不怎么注重服装的人来说，这些骸骨和血肉都是很平常的状态。~
@90499 = ~镀金防御者~
@90500 = ~这件镶嵌着黄金和黄铜的护甲看起来制作得非常精美。~
@90501 = ~一圈圈的金属好像依附在这套华丽而精美的铠甲上。技术最高超的爱人工匠将这套铠甲打造成非常复杂的形状，意指矮人文化中最忠诚的同伴：防御者。没人能通过他们的盾墙，没人能抵挡他们的冲锋。~
@90502 = ~铁骷髅~
@90503 = ~这件铠甲好像是将皮革附在金属骨架上而制成的。~
@90504 = ~为什么那位极有才能的铁匠会造出这么令人不安的铠甲，至今还不清楚。钢片似乎会顺着穿戴者的四肢滑动；它会自动适应每一位新的穿戴者。它可以防护黑暗，但也能召唤出阴影。~
@90505 = ~瓦尔寇里安的长袍~
@90506 = ~平衡之拳~
@90507 = ~在一个古老的传说中，有一个修道会，生活在海火中冰层之下的一个城堡里，他们的信条是在混乱中维持世界的平衡与稳定。尽管有许多人想要解开这个传说中，但发现其中大部分都是流言而已。当一些疯狂的冒险者摔进一间装饰着这对拳套的旅店之时——让这个传说继续隐没于黑暗，并让对这神秘修道会的探索延续下去。~
@90508 = ~巫妖头骨~
@90509 = ~汉斯·克鲁德根终生都是大法师克莱多斯的助手，多年里，他走遍了世界，为克莱多斯寻找各种仪式使用的秘宝。克莱多斯给汉斯的奖赏是，在一个宿命之日，砍下了他的脑袋，并通过秘传仪式把这个半兽人的颅骨化为这个富蕴力量的头盔。忠诚的助手汉斯向他的主人献出了他的最后秘宝。~
@90510 = ~王者~
@90511 = ~这顶青铜头盔最后是由一位不太有名的英雄佩戴的，他带着一位十字军闯入了幽暗地域。他的目标居然是……消灭黑暗精灵。他的任务当然是很悲惨地失败了，最后被埋在了乱葬岗。他的头盔被杀死他的那名黑暗精灵当作战利品掳走了。~
@90512 = ~白金盔~
@90513 = ~这顶头盔拥有操纵电能的力量。它可以吸收和释放能量，不过却难以掌控，但是一旦能够正确的使用，便会威力无穷。~
@90514 = ~荆棘之冠~
@90515 = ~一个无名的恶魔用他杀死的异界神侍的血肉做成了这个令人毛骨悚然的头盔。那个异界神侍虽然死了很久，可他的血液还在流动。~
@90516 = ~次级艾恩石：蓝色~
@90517 = ~这颗无瑕的宝石散发出强力的魔法光芒。这种宝石魔力的本质仍然是一个谜。~
@90518 = ~众所周知，艾恩石的颜色不同，它所拥有的能力也不一样。启动以后，它们会绕着持有者的头部不停地旋转。每次只能启动1个次级艾恩石。蓝色艾恩石启动以后，可以增加2点感知。~
@90519 = ~次级艾恩石：深红色~
@90520 = ~众所周知，艾恩石的颜色不同，它所拥有的能力也不一样。启动以后，它们会绕着持有者的头部不停地旋转。每次只能启动1个次级艾恩石。深红色艾恩石启动以后，可以增加2点敏捷。~
@90521 = ~次级艾恩石：灰玫瑰色~
@90522 = ~众所周知，艾恩石的颜色不同，它所拥有的能力也不一样。启动以后，它们会绕着持有者的头部不停地旋转。每次只能启动1个次级艾恩石。灰玫瑰色艾恩石启动以后，可以增加1点AC。~
@90523 = ~次级艾恩石：淡灰蓝色~
@90524 = ~众所周知，艾恩石的颜色不同，它所拥有的能力也不一样。启动以后，它们会绕着持有者的头部不停地旋转。每次只能启动1个次级艾恩石。淡灰蓝色艾恩石启动以后，可以增加2点力量。~
@90525 = ~次级艾恩石：粉红和绿色~
@90526 = ~众所周知，艾恩石的颜色不同，它所拥有的能力也不一样。启动以后，它们会绕着持有者的头部不停地旋转。每次只能启动1个次级艾恩石。粉红和绿色艾恩石启动以后，可以增加2点魅力。~
@90527 = ~次级艾恩石：粉红色~
@90528 = ~众所周知，艾恩石的颜色不同，它所拥有的能力也不一样。启动以后，它们会绕着持有者的头部不停地旋转。每次只能启动1个次级艾恩石。粉红色艾恩石启动以后，可以增加2点体质。~
@90529 = ~次级艾恩石：猩红和蓝色~
@90530 = ~众所周知，艾恩石的颜色不同，它所拥有的能力也不一样。启动以后，它们会绕着持有者的头部不停地旋转。每次只能启动1个次级艾恩石。猩红和蓝色艾恩石启动以后，可以增加2点智力。~
@90531 = ~精金头盔~
@90532 = ~精金全身甲~
@90533 = ~眼魔属性~
@90534 = ~这是某种施法者用来抄录法术的空白卷轴。拥有抄录卷轴专长的施法者可以对此卷轴施展某个法术，将该法术抄录到卷轴上。~
@90535 = ~魔法药瓶~
@90536 = ~精金块~
@90537 = ~这种相当稀少的金属只能在地底深处才能找到，它和那些矿工的皮肤一样乌黑。~
@90538 = ~布卷~
@90539 = ~这卷布足以做一套衣服了。~
@90540 = ~铁块~
@90541 = ~把铁烧熔然后再浇铸成型，就可以制作成常见的武器和护甲了。~
@90542 = ~铁木板~
@90543 = ~这种坚硬而致密的木材通常用来制作盾牌、木棍和其他物品。~
@90544 = ~晒好的皮革可以用来制作轻甲或是弓弦之类的武器部件。~
@90545 = ~秘银块~
@90546 = ~秘银虽然轻，但是很坚硬，最好的武器和护甲通常都是用秘银制作的。~
@90547 = ~橡木板~
@90548 = ~橡木是一种非常结实耐用的木材，可以用来制作木棒一类的武器或是弩一类武器的主要部分。~
@90549 = ~钢块~
@90550 = ~钢是比铁要硬得多的一种合金。大部分武器和护甲的部件都是用它制作的。~
@90551 = ~传奇吸血鬼啮咬~
@90552 = ~龙巫妖属性~
@90553 = ~拟态怪属性~
@90554 = ~复苏君王属性~
@90555 = ~传奇吸血鬼属性~
@90556 = ~巴特祖属性~
@90557 = ~次级半神巫妖属性~
@90558 = ~半神巫妖属性~
@90559 = ~蛛化精灵属性~
@90560 = ~夺心魔长老属性~
@90561 = ~欲魔属性~
@90562 = ~挥击1d6+4（+1d6强酸+麻痹）~
@90563 = ~超大铁魔像属性~
@90564 = ~狩魔蛛属性~
@90565 = ~传奇蛛化精灵属性~
@90566 = ~深渊洛斯兽属性~
@90567 = ~火矮人属性~
@90568 = ~夺心魔属性~
@90569 = ~慑心魔属性~
@90570 = ~深狱炼魔的物品~
@90571 = ~秘银魔像属性~
@90572 = ~精金魔像属性~
@90573 = ~虹彩龙属性~
@90574 = ~史拉白蟾属性~
@90575 = ~史拉黑蟾属性~
@90576 = ~幽影龙属性~
@90577 = ~蜘蛛魔属性~
@90578 = ~斯涅布力属性~
@90579 = ~蝙蝠魔宠HD25属性~
@90580 = ~蝙蝠魔宠HD30属性~
@90581 = ~火魔蝠魔宠HD25属性~
@90582 = ~火魔蝠魔宠HD30属性~
@90583 = ~巨型蜘蛛动物伙伴HD15属性~
@90584 = ~鹰动物伙伴HD20属性~
@90585 = ~鹰动物伙伴HD30属性~
@90586 = ~冰魔蝠魔宠HD25属性~
@90587 = ~冰魔蝠魔宠HD30属性~
@90588 = ~小魔鬼魔宠HD25属性~
@90589 = ~小魔鬼魔宠HD30属性~
@90590 = ~鹰动物伙伴HD35属性~
