@97828 = ~“你能告诉我有关位面的什么信息？”~
@97829 = ~“为什么他要在位面中旅行？”~
@97830 = ~“第三个谜语？我不明白……”~
@97831 = ~“异界神侍是什么？”~
@97832 = ~“这些天使是从那里来的？”~
@97833 = ~“第二个谜语？是什么意思？”~
@97834 = ~“第一个谜语？那是什么？”~
@97835 = ~“你是谁？”~
@97836 = ~“还是问些其他问题吧。”~
@97837 = ~“跟我说说这个沉睡者。”~
@97838 = ~“再见。”~
