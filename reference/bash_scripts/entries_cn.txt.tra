@97619 = ~“既然你问了，我就会回答的。记好了，这是沉睡者的第一个秘密……他是一名来自天界的异界神侍，一个善良的生物。和你我一样，他也是一名朝圣者，一直在位面间旅行。”~
@97620 = ~“很高兴遇到你这么一个好问的人。就像沉睡者教导的那样，在得到解答之前，你肯定会不停地发问。那么现在你想知道什么？”~
@97621 = ~“我是一名吉斯泽莱导师。我一生都在努力训练自己阅读他人表面意识的能力。”~
@97622 = ~“很高兴遇到你这么一个好问的人。就像沉睡者教导的那样，在得到解答之前，你肯定会不停地发问。那么现在你想知道什么？”~
@97623 = ~“很久以前，我们也曾经是人类。夺心魔建立了一个跨越诸位面的帝国，在他们恶毒的命令之下，我们当了无数个世纪的奴隶。”~
@97624 = ~“我们渐渐地适应了。我们的皮肤由于缺乏日晒而变成了灰色，为了能够抵受拷打而变得坚韧。他们控制着我们的精神并且教养我们。时间一长，我们的精神就都同化了。”~
@97625 = ~“慢慢地，我们懂得了如何防御他们的精神探测，有一小撮人因此而脱离了他们的掌控。一位名叫吉斯的英雄揭竿而起，最终推翻了他们的压迫。”~
@97626 = ~“我们和吉斯彦克人都是那些叛乱者的嫡亲后代。不过有一次发生了某件事情，导致了我们和吉斯彦克人之间的分裂。”~
@97627 = ~“吉斯彦克人主要生活在星界，而虽然有些吉斯泽莱人像我一样住在混沌海位面上的修道院里，但大部分还是在更远的地方旅行。”~
@97628 = ~“那有无数条道路：法术，入口，漩涡，雾气和阴影间的转换。不过并不是在所有的地方都适用。在卡尼亚这个地方，只有两条道：传送门和冥河分支。”~
@97629 = ~“只要和收割者进行了绑定，传送门就可以通到任何地方。但是冥河分支一直往下流，通到巴托地狱的第九重，也就是最后一层——奈瑟斯。我没去过那里，也不想去那里。”~
@97630 = ~“我不能说，那超出界限了，就像靡菲斯特用真名把他和你的意志绑定在一起那样。也许沉睡者以前知道。但是当他梦到了答案的时候，我和我的朝圣者们已经被困在这里了，就像你一样。”~
@97631 = ~“沉睡者会梦见许多事情，这时，我就能看见在他思想表面上浮现着的那些梦境。对于他的秘密，我大多数是通过梦境了解到的。”~
@97632 = ~“他的梦形成了我信仰的原则，使我和我的朝圣者们更接近我们的教化。通过他的梦境，我了解到了沉睡者的五个秘密……”~
@97633 = ~“他是谁？他从哪里来？他为什么离开？他在寻找谁？答案是什么？……所有想看到沉睡者的人必须先解开这五个秘密。”~
@97634 = ~“这个传说是从何处开始，又会到哪里结束呢？这无数的位面都是变化无穷的。这些都无法形容；他们肯定是活着的。”~
@97635 = ~“我出身的修道院位于混沌海，它漂浮在一个水球中，而水球绕着一个不断变化的大石块运转，石块上有着无尽生死往复着的森林。有什么词语能够清楚地描绘出来呢？”~
@97636 = ~“作为精神、肉体和灵魂上的大师，我们的导师教给我们吉斯泽莱人更高的智慧，使我们能够战胜敌人。尽管有些偏差，不过在你们的语言里，我们应该可以称作武僧。”~
@97637 = ~“我们吉斯泽莱人力争成为爱好和平的人，而且在努力寻找和平的过程中把自己和其他人隔绝开来。”~
@97638 = ~“但是我们的兄弟——吉斯彦克人一直在狩猎我们，而且我们也决不会原谅把我们变为奴隶的夺心魔。但是比较矛盾的一点是，如果不是因为夺心魔，我们也不会存在。”~
@97639 = ~“勉强来说……你的思想就像是一个巨大的图书馆，而我可以触摸到那些书卷的书脊。我能读出它们的标题，猜出大概的内容，但事实上并不能真的读到和记下里面的内容。”~
@97640 = ~“尽管它的能力有限，但正因为有了我珍爱的这项天赋，才能够一个标题一个标题，一道书脊一道书脊地了解到沉睡者的智慧。我就是通过这项天赋才接触到他的梦境的。”~
@97641 = ~“那有无数条道路：法术，入口，漩涡，雾气和阴影间的转换。不过并不是在所有的地方都适用。在卡尼亚这个地方，只有两条道：传送门和冥河分支。”~
@97642 = ~“只要和收割者进行了绑定，传送门就可以通到任何地方。但是冥河分支一直往下流，通到巴托地狱的第九重，也就是最后一层——奈瑟斯。我没去过那里，也不想去那里。”~
@97643 = ~“我不能说，那超出界限了，就像靡菲斯特用真名把他和你的意志绑定在一起那样。也许沉睡者以前知道。但是当他梦到了答案的时候，我和我的朝圣者们已经被困在这里了，就像你一样。”~
@97644 = ~“沉睡者会梦见许多事情，这时，我就能看见在他思想表面上浮现着的那些梦境。对于他的秘密，我大多数是通过梦境了解到的。”~
@97645 = ~“他的梦形成了我信仰的原则，使我和我的朝圣者们更接近我们的教化。通过他的梦境，我了解到了沉睡者的五个秘密……”~
@97646 = ~“他是谁？他从哪里来？他为什么离开？他在寻找谁？答案是什么？……所有想看到沉睡者的人必须先解开这五个秘密。”~
@97647 = ~“这个传说是从何处开始，又会到哪里结束呢？这无数的位面都是变化无穷的。这些都无法形容；他们肯定是活着的。”~
@97648 = ~“我出身的修道院位于混沌海，它漂浮在一个水球中，而水球绕着一个不断变化的大石块运转，石块上有着无尽生死往复着的森林。有什么词语能够清楚地描绘出来呢？”~
@97649 = ~“为什么我们这些人要远离家乡旅行到这里来？我想这可能就是沉睡者的第三个秘密。你必须要亲自来解答。”~
@97650 = ~“就像卡尼亚是许多魔鬼的家乡一样，它也是许多天使的家乡，比如从低阶的神使到强大的使徒、异界神侍乃至炽天神侍。”~
@97651 = ~“来自许多地方。有人说天使们就在我们的身边，即使在这个地方也有。而沉睡者来自哪里，是他的第二个秘密，你必须亲自解开它。”~
@97652 = ~“在新来的朝圣者能够看到沉睡者之前，他们必须要解开他的五个秘密：他是谁？他从哪里来？他为什么离开？他在寻找谁？答案是什么？”~
@97653 = ~“我叫德哈瓦娜，是一名吉斯泽莱导师，也是沉睡者的朝圣者。我旅行到他那里很多次了，每次都能得到智慧上的成长。”~
@97654 = ~“很高兴遇到你这么一个好问的人。就像沉睡者教导的那样，在得到解答之前，你肯定会不停地发问。那么现在你想知道什么？”~
@97655 = ~“既然你问了，我就会回答的。记好了，这是沉睡者的第一个秘密……他是一名来自天界的异界神侍，一个善良的生物。和你我一样，他也是一名朝圣者，一直在位面间旅行。”~
@97656 = ~“很高兴遇到你这么一个好问的人。就像沉睡者教导的那样，在得到解答之前，你肯定会不停地发问。那么现在你想知道什么？”~
