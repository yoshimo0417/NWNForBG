@97053 = ~“沉睡者？”~
@97054 = ~“也许收割者的名字就在里面……”~
@97055 = ~“你是谁？”~
@97056 = ~“因为你是邪恶的，所以被送到这个地方来？”~
@97057 = ~“现在的问题是要等到什么时候？”~
@97058 = ~“回到我其他的问题上。”~
@97059 = ~“我也想回家。”~
@97060 = ~“为什么你不能再活过来？”~
@97061 = ~“为什么要在这个地方作怪呢？那又不是活着的。”~
@97062 = ~“为什么靡菲斯特要把这些门封起来？”~
@97063 = ~“失魂者是些什么人？”~
@97064 = ~“跟我说说对抗靡菲斯特的那个灵魂的情况。”~
@97065 = ~“有什么办法能帮助她吗？~
@97066 = ~“我怎么才能帮她成为失魂者的一员？”~
@97067 = ~“公证者？那是谁？”~
@97068 = ~“公证者的向导是谁？”~
@97069 = ~“靡菲斯特正在毁灭你的灵魂？”~
@97070 = ~“回到我其他的问题上。”~
@97071 = ~“有什么办法能停止这场毁灭吗？”~
@97072 = ~“失魂者是些什么人？”~
@97073 = ~“她叫什么名字？”~
@97074 = ~“但是如果没人知道你名字的话，那这些雕刻是谁做的？”~
@97075 = ~“公证者？那是谁？”~
@97076 = ~“公证者的向导是谁？”~
@97077 = ~“跟我说说对抗靡菲斯特的那个灵魂的情况。”~
@97078 = ~“有什么办法能帮助她吗？”~
@97079 = ~“我怎么才能帮她成为失魂者的一员？”~
@97080 = ~“毁灭一个人的灵魂是什么意思？”~
@97081 = ~“托瑞尔？我正是从那里来的……”~
@97082 = ~“我在寻找沉睡者的五个秘密。”~
@97083 = ~“为什么他这么悲伤？”~
@97084 = ~这只生物似乎很高兴看到你，并且渴望继续它的搜寻。~
@97085 = ~这只小生物紧跟在你脚后，很期待地等着你把它带到正确的石柱那里去。~
@97086 = ~这只生物闪开了你的攻击，显然已经预见到了你的这个行为。它继续分辨着气味，渴望找到那根石柱。~
@97087 = ~这只生物的身体上覆盖着一层坚硬的甲壳。你擦过它一个剃刀般的边角，发现它居然划穿了那双结实的靴子，刺到你的脚里。~
@97088 = ~这只生物的身体上覆盖着一层坚硬的甲壳。它感觉这个触摸很温暖，尽管其实是非常的冷。它用鼻子拱你的手，对你表示感激。~
@97089 = ~这只奇怪的生物发出一阵尖锐的声音，然后兴奋地绕着圈跑动。它似乎很高兴你居然知道它的名字。~
@97090 = ~当提到沉睡者的名字时，这只生物兴奋地发出声响。它的头上出现了一个画面，描绘的是一个有翅膀的人倚靠在这个生物的身旁，让它取回丢出去的小木棒。~
@97091 = ~画面切换，重新聚焦，显示出五个排成一排的有标记的问题。其中第二个涌动着蓝色的光芒。~
@97092 = ~生物的头上忽然涌出许多图像。一条蛇形的生物在水里游着，在一堆极其复杂的方程式中“1+1=2”闪动着光芒，音符从闭着的嘴唇里迸出来。~
@97093 = ~这只生物似乎对于自己能帮得上忙而感到很高兴，然后它很快又开始分辨着气味，渴望找到那块石头。~
@97094 = ~这只生物似乎不太确定怎样才能更清楚地表达自己的意图。几乎是出于道歉，它形成了一幅埋藏在城市中的矩形石柱的图样来。~
@97095 = ~这只生物高兴地发出声响。它似乎很喜欢这种游戏。~
@97096 = ~这只生物坐在冰冻的地面上，耐心地等你思考。~
@97097 = ~这只生物变出了一幅图像，灰色的矩形石柱突立在城市的冰面上。在侧面好像还写着什么东西。~
@97098 = ~这只生物给你展示了一组四幅图片：一间旅者客栈，一条在水中穿行的鲨鱼，一张眨着眼睛的脸部特写，以及从一个茶托上的杯子里冒出来的热气。~
@97099 = ~这只生物给你展示了一个画面：一个死人躺在床上，旁边并肩站着两个人，第四个人只能看到腿，在及膝的马裤和同踝高的靴子之间是光着的。~
@97100 = ~这只生物给你展示了一个画面：一棵强壮的橡树，长满了树叶，一个小男孩正牵着父亲的手臂。接下来的画面聚焦在了小男孩的身上。~
@97101 = ~这只生物围着石头的基部闻了闻，很困惑的样子。它似乎不太满意，跑回原来那块石头，重新确定自己的方向。~
@97102 = ~这只生物围着石头的基部闻了闻，很困惑的样子。它似乎不太满意，等你继续前进。~
@97103 = ~这只生物围着石头的基部闻了闻。它兴奋地发出响声，感谢你把它领到正确的石头这里来。~
@97104 = ~这看起来是最后一块石头了。这个生物闻了闻它的基部，然后朝着附近的一堵冰墙走了过去。~
@97105 = ~当你盯着那灰蓝色的冰块看过去的时候，忽然发现公证者正站在你身边，满意地看着自己的作品。在那里，你发现了一个最近才刻上去的名字：“艾瑞贝丝·德·泰尔玛兰德。”~
@97106 = ~你凑近盯着那灰蓝色的冰块看过去，可以看见一个最近才刻上去的名字：“艾瑞贝丝·德·泰尔玛兰德。”~
@97107 = ~这只生物看起来非常疲惫，所以没和你争辩，但是你能感觉到它和你一样，都很高兴能够摆脱对方。它踏着缓慢沉重的步伐离开你，走进了雪地里。~
@97108 = ~这只生物看起来非常疲惫，所以没再发出什么声响，但是你能感觉到它的感激之情。它踏着缓慢沉重的步伐离开你，走进了雪地里。~
@97109 = ~这只生物形成了一幅图像，那个被冻住的女人穿过一群愤怒的灵魂，带着他们走过那些门。图像慢慢地消散了。~
@97110 = ~这只生物发出确认的声响。看起来它的任务好像完成了，所以很疲惫的样子。~
@97111 = ~现在这只生物给你展示了一组四幅图片：一件旅者客栈，一条在水中穿行的鲨鱼，一张眨着眼睛的脸部特写，以及从一个茶杯和托牒中冒出来的热气。~
@97112 = ~现在这只生物给你展示了一个画面：一个死人躺在床上，旁边并肩站着两个人，第四个人只能看到腿，在及膝的马裤和同踝高的靴子之间是光着的。~
@97113 = ~一只像小狗一样的生物在洞穴入口处来回走动，似乎受到挫折似的呜呜叫。你一靠近，它就转向你，好像在寻求你的帮助。~
@97114 = ~这只生物闪开了你的攻击，显然已经预见到了你的这个行为。它还是在洞穴入口处呜呜叫着。~
@97115 = ~这只生物的身体上覆盖着一层坚硬的甲壳。你擦过它一个剃刀般的边角，发现它居然划穿了那双结实的靴子，刺到你的脚里。~
@97116 = ~这只生物的身体上覆盖着一层坚硬的甲壳。它感觉这个触摸很温暖，尽管其实是非常的冷。尽管它还在低声呜咽，它还是用鼻子拱拱你的手，表示对你的感激。~
@97117 = ~这只生物停止了呜叫，把注意力转到你的身上。令你感到吃惊的是，它的头上浮现出了一幅图像，这昏暗的蓝光好像是从上面照下来的。~
@97118 = ~你凑近一看，发现一个女人被包在冰里面，一动不动。完全绝望的表情显示出了她受到冰冻的程度，蓝色的脸庞，冻住的嘴唇里还透出一丝气息。这个生物还在呜呜叫。~
@97119 = ~这只生物形成了一幅图像，是一面刻着无数名字的冰墙。这堵墙看起来似乎没有尽头，以一种复杂的方式迂回曲折，最后是一片空白，那里好像还能刻许多新的名字。~
@97120 = ~这幅图像变成一系列雕刻过的矩形石柱，这个生物好像是用它们来导航的。你能感觉到这只生物想去其中的一根，但是你不知道具体是哪一根。~
@97121 = ~两幅图像在这个生物的头上接起来了。第一幅是一棵长满了树叶的强壮橡树。~
@97122 = ~第二幅是一个牵着父亲手臂的小男孩。你可以看到他们之间所具有的家族共性，但是父亲并不是这幅图像的焦点。~
@97123 = ~这只生物发出满足的响声，想要离开了。它紧跟在你的脚后，等着你带它走。~
@97124 = ~这只生物似乎不太确定怎样才能更清楚地表达自己的意图。它展示给你的图像肯定告诉了你这些石柱的不同之处。你必须再靠近点去看。~
@97125 = ~又出现了一幅新的图像。那个女人的冰雕缓缓地沉入了下面的冰里，消失在茫茫冰群中。这时，你忽然感到一阵阵莫名的空虚。~
@97126 = ~这只生物激动得跳了起来，发出一阵尖锐的声响，好像是在确认你的问题。~
@97127 = ~这只生物不理会你的问题，继续在那个被拦住的洞穴入口处呜叫着。~
@97128 = ~这只奇怪的生物发出一阵尖锐的声响，激动得打起转来。它好像很高兴你知道它的名字。但是它看了看洞穴的入口，又继续发出刚才的呜叫声。~
@97129 = ~当提到沉睡者的名字时，这只生物兴奋地发出声响。它的头上出现了一个画面，描绘的是一个有翅膀的人倚靠在这个生物的身旁，让它取回丢出去的小木棒。~
@97130 = ~画面切换，重新聚焦，显示出五个排成一排的有标记的问题。其中第二个涌动着蓝色的光芒。~
@97131 = ~生物的头上忽然涌出许多图像。一条蛇形的生物在水里游着，在一堆极其复杂的方程式中“1+1=2”闪动着光芒，音符从闭着的嘴唇里迸出来。~
@97132 = ~这只生物似乎很高兴自己能帮得上忙，不过还是像刚才那样在洞穴门口继续呜呜叫着。~
@97133 = ~这只生物似乎不太确定怎样才能更清楚地表达自己的意图。几乎是出于道歉，它形成了一幅埋藏在城市中的矩形石柱的图样来。~
@97134 = ~这个声响渐渐低沉，变得愤怒起来，这只生物走向冰天雪地之中，不再理会你了。~
@97135 = ~这只生物发出尖锐的声响，渴望继续下去。~
@97136 = ~这只生物坐了下来，耐心地等着你思考问题。~
@97137 = ~这只生物看起来非常疲惫，所以没再发出什么声响。它踏着缓慢沉重的步伐离开你，走进了雪地里。~
@97138 = ~公证者——一只看起来像狗的生物在艾瑞贝丝的洞穴入口处低声呜叫。它用一种猜字谜似的投射精神影像的方式进行交流。~
@97139 = ~“好吧，那么我们继续前进。”~
@97140 = ~踢开这个生物。~
@97141 = ~爱抚这个生物。~
@97142 = ~“你是公证者吗？”~
@97143 = ~“我在寻找沉睡者的五个秘密……”~
@97144 = ~“你知道第二个秘密。告诉我。”~
@97145 = ~“谢谢。”~
@97146 = ~“我想不明白……”~
@97147 = ~“那么，这是个猜谜游戏，对吗？”~
@97148 = ~“回到我其他的问题上。”~
@97149 = ~“提示我这些石柱象征什么。”~
@97150 = ~“你还想去看哪根石柱呢？”~
@97151 = ~“完了。现在迷路了，可恶，我必须干点什么。”~
@97152 = ~“那么我们走吧。你感觉好点儿了吗？”~
@97153 = ~“你原来就认识她吗？”~
@97154 = ~“那就是那个被冻住的女人吗？”~
@97155 = ~离开。~
@97156 = ~踢开这个生物。~
@97157 = ~爱抚这个生物。~
@97158 = ~“你现在在抱怨什么？”~
@97159 = ~“怎么了，小家伙？”~
@97160 = ~“所以她会逐渐被冻死。那么大人物是谁？”~
@97161 = ~“我能帮上什么忙？”~
@97162 = ~“你想让我告诉你是哪根石柱？”~
@97163 = ~“好吧，那么我们走吧。”~
@97164 = ~“那么，这是个猜谜游戏，对吗？”~
@97165 = ~“我想不明白……”~
@97166 = ~“她怎么了？”~
@97167 = ~“她在那个洞穴里面？”~
@97168 = ~“她是谁？”~
@97169 = ~“你是公证者吗？”~
@97170 = ~“我在寻找沉睡者的五个秘密……”~
@97171 = ~“你知道第二个秘密。告诉我。”~
@97172 = ~“谢谢。”~
@97173 = ~“我想不明白……”~
@97174 = ~“蠢货……”~
@97175 = ~“那么，这是个猜谜游戏，对吗？”~
@97176 = ~“回到我其他的问题上。”~
@97177 = ~无数的冰层当中，蚀刻着许许多多的名字。其中有许多因为刻得太深，凭借着柔和的蓝光只能分辨出它们模糊的外形。~
@97178 = ~这个女人正弯腰从一小片矮树丛中把莓果摘到身旁冰面上的一个小袋子里。~
@97179 = ~“如果我真的知道收割者的真名，我还会抱着不被冻死的渺茫希望在巴托深渊里摘荨麻？”~
@97180 = ~“你是从主物质位面来的？嗯。你最好忘了这一点，因为你已经回不去了。传送门已经关上了。我们只能呆在这里，最后被冻僵或是无聊透顶而死。”~
@97181 = ~“啐。你有更好的主意？还是放弃吧，傻瓜，你被困在这里了，不可能逃出去的。”~
@97182 = ~“谁，斯维菲特？他是计划要弄醒沉睡者，但是被导师阻止了。我不太清楚细节，不过他好像没交到什么朋友。地狱本来就够糟糕了，如果没有个会讲笑话的人就更惨了。”~
@97183 = ~“你问他，我才不想要这东西。噢，我劝你不要太相信他了，尤其是提到钱的时候。在他的酒馆里，我付的金币比约定的要多许多。”~
@97184 = ~“这是个维洛克斯荨麻。它们的根扎得很深，一直延伸到冰面下的熔岩池里面，所以它的莓果储存了很多热量。这是在此地生火的唯一方法。”~
@97185 = ~“当然，但是要快点哦，这里可快要把人给冻死了。”~
@97186 = ~“酒馆老板有时候让我们用这东西付账，所以他有一些。采石场老板应该也有一些。其他的就要到它们生长的地方去找了。”~
@97187 = ~“但是就像我说的，它们喜欢热量。如果你在冰面上发现了像这一样的蒸汽裂缝，那么就很有可能发现一株正在享受这点温暖的维洛克斯荨麻。”~
@97188 = ~“如果你找到了木材，就把那些莓果在上面弄碎，热量就会把木材点着的。但是只有一颗莓果的话，还不够暖和。如果你能找到的话，我想最好还是用三颗来生火。”~
@97189 = ~“你是蠢蛋吗？这外面冷得要命，所以酒馆里肯定已经没有地方住了。你得在什么地方睡觉吧？那你就要需要生火呀。”~
@97190 = ~“呸！魔法火焰太令人捉摸不定了。这里待一下，然后马上又窜到那里去了。用来烧东西还行，但是如果你想做饭或者在外露营的话，还是需要维洛克斯莓。”~
@97191 = ~“你试过吗？”~
@97192 = ~“秘密？别拿那个来烦我，我敢肯定那都是导师编出来的瞎话。我可以跟你打赌，其实根本就没有什么沉睡者。”~
@97193 = ~“我们为了这次朝圣，变卖了所有的东西。我们从混沌海一路走来，却被永远地困在这巴托的第八层地狱。而且，既然我们都到这里了，她还是不让我们见他。”~
@97194 = ~“她说，要等我们领会到这五个秘密。嗯，我已经想出了第三个，它读起来就像是个三流的幻想小说。就跟导师梦想中那种浪漫的念头一样……”~
@97195 = ~“他为什么离开？因为他的内心已经感受不到爱了。真是废话。她编造出了沉睡者这个人物，而现在糟糕的是，她被自己创造出来的这个人物无情地打击了。”~
@97196 = ~“再见。”~
@97197 = ~“你知道收割者的真名吗？”~
@97198 = ~“我想回家，回到托瑞尔世界去。”~
@97199 = ~“那是失败者的姿态……”~
@97200 = ~“酒馆里那个会飞的家伙……你认识他吗？”~
@97201 = ~“他打算怎么叫醒沉睡者？”~
@97202 = ~“你在挖什么？”~
@97203 = ~“回到我其他的问题上。”~
@97204 = ~“我到哪里能找到这些维洛克斯莓？”~
@97205 = ~“这些莓果是怎么用的？”~
@97206 = ~“为什么你要点火？”~
@97207 = ~“魔法火焰不起作用？”~
@97208 = ~“燧石和火绒不起作用？”~
@97209 = ~“我在寻找五个秘密的答案。”~
@97210 = ~“你想说什么？”~
@97211 = ~“浪漫？”~
@97212 = ~这个脾气暴躁的女人斑驳灰白的脸上布满了焦虑的皱纹。你能看出来，她根本就不愿意呆在这个地方。~
@97213 = ~这个男人看起来非常令人讨厌。他那阴沉的表情和苍白的脸色很相配。~
@97214 = ~“如果我知道了收割者的真名，我现在还会为了不挨冻而挤在这火堆旁边吗？”~
@97215 = ~“如果我知道了收割者的真名，我还会坐在巴托地狱深处这个烟雾弥漫的酒馆里，把生命浪费在这难喝的麦酒上？”~
@97216 = ~“你是从主物质位面来的？嗯。你最好忘了这一点，因为你已经回不去了。传送门已经关上了。我们只能呆在这里，最后被冻僵或是无聊透顶而死。”~
@97217 = ~“啐。你有更好的主意？还是放弃吧，傻瓜，你被困在这里了，不可能逃出去的。”~
@97218 = ~这个吉斯泽莱人在厌烦地转过头之前愤怒地瞪了你一眼。~
@97219 = ~“白痴，你这么得意干什么？你和我们一样被困在这个冰冷的地方，挤在火堆旁边……我只是想回到混沌海而已。”~
@97220 = ~“德哈瓦娜导师来到我们的修道院，宣讲沉睡者的教义。她讲得很精彩……我们变卖了所有的财产作为来卡尼亚朝圣的经费，这样我们就能见到他了。”~
@97221 = ~“而现在传送门已经关上了，我们陷在这个地方，而导师还不让我们见那个愚蠢的沉睡者。说实话，我根本就不相信有这么个人。”~
@97222 = ~“她说朝圣是对忍耐力的一种训练。除非有人能解开沉睡者的那些秘密，否则没人能见他。不管怎么看，这都是瞎编出来的……”~
@97223 = ~“看起来我是第四个放弃的。导师想让我们知道他离开家园的原因，而我想知道为什么我们要离开家乡来这里朝圣。”~
@97224 = ~“我们的内心感受不到爱。我们生活在混沌海那单调阴沉的废土上，然后满腔热情的跟着导师。她找到了所爱的东西，我想我们也应该那样。”~
@97225 = ~“看，如果你实在是感到很好奇，就去问导师吧。我保证她会把他所有的事情都告诉你。”~
@97226 = ~“德哈瓦娜导师，她把我们卷进了这个麻烦。你可以在镇子西北角的寺庙里找到她和她珍爱的沉睡者。那地方很大，装饰得很华丽，你肯定能找到。”~
@97227 = ~“被困在第八层地狱而根本没有回去的希望，对你来说好像算不了什么，是吗？”~
@97228 = ~“那是我原属的位面。我是个混沌海人，在那里出生和长大。我的曾曾祖父修建了一座修道院，我在那里面长大的，那里相当的混乱。可是我现在再也见不到它了。”~
@97229 = ~“白痴，你这么得意干什么？你和我们一样被困在这个冷得要命的地方，把生命浪费在这烫过的麦酒上，还要忍受那个泰夫林，斯维菲特的嘲笑……”~
@97230 = ~“看起来地狱里还有个小丑。谢谢你让他结束了，伙计。我们这一大群人也正想那样干呢。”~
@97231 = ~“看起来地狱里还有个小丑。斯维菲特把我们带上这条路，然后就变得很惹人厌了。最近他和导师闹了点小矛盾，现在正沉溺于悲伤中。”~
@97232 = ~“那个爱开玩笑的家伙打算弄醒沉睡者。我提醒你，我没说他还活着，但你也别去给那个蠢货的伤口上撒盐。没关系。就让他和导师斗下去吧。”~
@97233 = ~“看，如果你实在是感到很好奇，就去问导师吧。我保证她会把他所有的事情都告诉你。”~
@97234 = ~“德哈瓦娜导师，她把我们卷进了这个麻烦。你可以在镇子西北角的寺庙里找到她和她珍爱的沉睡者。那地方很大，装饰得很华丽，你肯定能找到。”~
@97235 = ~“看，如果你实在是感到很好奇，就去问导师吧。我保证她会把他所有的事情都告诉你。”~
@97236 = ~“被困在第八层地狱而根本没有回去的希望，对你来说好像算不了什么，是吗？”~
@97237 = ~“谁，斯维菲特？他是计划要弄醒沉睡者，但是被导师阻止了。我不太清楚细节，不过他好像没交到什么朋友。地狱本来就够糟糕了，如果没有个会讲笑话的人就更惨了。”~
@97238 = ~“你问他，我才不想要这东西。噢，我劝你不要太相信他了，尤其是提到钱的时候。在他的酒馆里，我付的金币比约定的要多许多。”~
@97239 = ~“秘密？别拿那个来烦我，我敢肯定那都是导师编出来的瞎话。我可以跟你打赌，其实根本就没有什么沉睡者。”~
@97240 = ~“我们为了这次朝圣，变卖了所有的东西。我们从混沌海一路走来，却被永远地困在这巴托的第八层地狱。而且，既然我们都到这里了，她还是不让我们见他。”~
@97241 = ~“她说，要等我们领会到这五个秘密。嗯，我已经想出了第三个，它读起来就像是个三流的幻想小说。就跟导师梦想中那种浪漫的念头一样……”~
@97242 = ~“他为什么离开？因为他的内心已经感受不到爱了。真是废话。她编造出了沉睡者这个人物，而现在糟糕的是，她被自己创造出来的这个人物无情地打击了。”~
@97243 = ~普通的吉斯泽莱朝圣者，男的女的都有。虽然到处都能见到他们，不过主要还是分布在酒馆和寺庙的周围（但不在寺庙里面）。~
@97244 = ~“再见。”~
@97245 = ~“你知道收割者的真名吗？”~
@97246 = ~“我想回家，回到托瑞尔世界去。”~
@97247 = ~“那是失败者的姿态……”~
@97248 = ~“在这里很长时间了？”~
@97249 = ~“怎么这么阴沉，兄弟？”~
@97250 = ~“你来这里做什么？”~
@97251 = ~“为什么她不让你见他？”~
@97252 = ~“什么样的秘密？”~
@97253 = ~“沉睡者是谁？”~
@97254 = ~“导师？那是谁？”~
@97255 = ~“你被导师卷进什么麻烦里了吗？”~
@97256 = ~“混沌海？在哪里？”~
@97257 = ~“泰夫林？”~
@97258 = ~“为什么，你和他之间发生了什么事情吗？”~
@97259 = ~“他和导师之间发生了什么事情吗？”~
@97260 = ~“沉睡者是谁？”~
@97261 = ~“导师？那是谁？”~
@97262 = ~“沉睡者是谁？”~
@97263 = ~“你被导师卷进什么麻烦里了吗？”~
@97264 = ~“酒馆里那个会飞的家伙……你认识他吗？”~
@97265 = ~“他打算怎么叫醒沉睡者？”~
@97266 = ~“我在寻找五个秘密的答案。”~
@97267 = ~“你是什么意思？”~
@97268 = ~“浪漫？”~
@97269 = ~这个老泰夫林又拿出他那副纸牌。当你靠近的时候，他对你笑了一下。~
@97270 = ~一个老人坐在靠墙的桌子边歪嘴笑着，有时候洗洗手里的牌，那些面色阴郁的主顾偶尔会对他怒目而视。他的前额上长着两只角，其中一只有些轻微的破碎。~
@97271 = ~“你真是个白痴，我都不知道该怎么说你了。到这个份上我都有点可怜你了，再给你一次机会吧。现在跟我说实话：一个真名值多少钱？”~
@97272 = ~“不够，还不够……但还是谢谢你，我就把那当作定金了。现在跟我说实话，傻子：一个真名值多少钱？”~
@97273 = ~“不够，还不够……但还是谢谢你，我就把那当作定金了。现在跟我说实话，傻子：一个真名值多少钱？”~
@97274 = ~“不够，还不够……但还是谢谢你，我就把那当作定金了。现在跟我说实话，傻子：一个真名值多少钱？”~
@97275 = ~“不够，还不够……但还是谢谢你，我就把那当作定金了。现在跟我说实话，傻子：一个真名值多少钱？”~
@97276 = ~“对于一个一无所有的<MANWOMAN>真是说起来容易。没有才智，不懂策略，缺乏幽默感……还是留着你的金钱和财产吧。你这个家伙可真讨厌。”~
@97277 = ~“好，好。尽管我跟着这些老家伙很久了，但还不至于变得无知，我想我至少已经猜到导师的第四个秘密了。”~
@97278 = ~在重新开始之前，他慢慢地洗着手上的牌。“可以说，我和她打了一场小架。”~
@97279 = ~“我想，就算有更奇怪的事情，也会是相同的叫法。尽管我跟着这些老家伙很久了，但还不至于变得无知，我想我至少已经猜到导师的第四个秘密了。”~
@97280 = ~“好吧，这件事说来话长……很早以前，魔鬼们还没有占据卡尼亚，这里是智者们的家园。他们是学问的收集者和整理者，有人说他们现在还活在那里。”~
@97281 = ~“如果导师愿意的话，可以把这叫做她的第四个秘密，当沉睡者来到卡尼亚的时候，他实际上是来找一位特别的智者：诸界智者。”~
@97282 = ~“噢，一名老吟游诗人会四处游历，学识就是我们的专业。巴托地狱里的每一个吟游诗人都知道有关智者的一些事情。对于像我自己这样到处旅行的人来说，我对诸界智者的事情是很感兴趣的。”~
@97283 = ~“你想想：位面多么巨大，常人是难以理解的！在这个事实面前，还能想到什么其他的答案吗？我承认，沉睡者确实很聪明。他知道询问事情的‘所在’。”~
@97284 = ~“够了，白痴。智者们又不是武士，魔鬼们把他们逼到了毁灭的边缘。诸界智者知道一个秘密的地方，并且在那里藏了起来。”~
@97285 = ~“谁还能比她找到更好的地方躲起来呢？我想沉睡者曾经找到过她。种种迹象表明，为此他耗尽了精力。对不起，傻瓜。”~
@97286 = ~“噢，我已经想了很久了。至少已经足以领会到沉睡者的第四个秘密。他来这里找一个人，而我想我认识这个人。”~
@97287 = ~“沉睡者？嗯，很久以前，魔鬼们还没有占据卡尼亚，这里是智者们的家园。他们是学问的收集者和整理者，有人说他们现在还活在那里。”~
@97288 = ~“如果导师愿意的话，可以把这叫做她的第四个秘密，当沉睡者来到卡尼亚的时候，他实际上是来找一位特别的智者：诸界智者。”~
@97289 = ~“噢，你可以在这北边的神殿中靠近沉睡者的地方找到她。导师把这些愠怒的朝圣者带到这个地方来。我想他们可能根本就不懂得幽默。”~
@97290 = ~“噢，一名老吟游诗人会四处游历，学识就是我们的专业。巴托地狱里的每一个吟游诗人都知道有关智者的一些事情。对于像我自己这样到处旅行的人来说，我对诸界智者的事情是很感兴趣的。”~
@97291 = ~“你想想：位面多么巨大，常人是难以理解的！在这个事实面前，还能想到什么其他的答案吗？我承认，沉睡者确实很聪明。他知道询问事情的‘所在’。”~
@97292 = ~“够了，白痴。智者们又不是武士，魔鬼们把他们逼到了毁灭的边缘。诸界智者知道一个秘密的地方，并且在那里藏了起来。”~
@97293 = ~“谁还能比她找到更好的地方躲起来呢？我想沉睡者曾经找到过她。种种迹象表明，为此他耗尽了精力。对不起，傻瓜。”~
@97294 = ~这个长着角的人吐了口唾沫，使劲理了理手中的牌。“如果你想问有关沉睡者的问题，就去找导师。我已经洗手不干了。”~
@97295 = ~“噢，你可以在这北边的神殿中靠近沉睡者的地方找到她。导师把这些愠怒的朝圣者带到这个地方来。我想他们可能根本就不懂得幽默。”~
@97296 = ~“这只是个善意的玩笑。这些愠怒的朝圣者总是说什么‘沉睡者这’、‘沉睡者那’的。我的骨头就开始痒痒，想把那老家伙弄起来。”~
@97297 = ~“不要说了，要是导师听到风声的话，她会不高兴的。”~
@97298 = ~“噢，你可以在这北边的神殿中靠近沉睡者的地方找到她。导师把这些愠怒的朝圣者带到这个地方来。我想他们可能根本就不懂得幽默。”~
@97299 = ~“噢，一位老吟游诗人沿路收集了些小玩意。有一位印记城的乐器师制作了一个喇叭，那上面有一个和万魔殿相连的小通道……”~
@97300 = ~“把你的嘴唇放在上面，往里面吹气，你可以吹出那些疯狂地方所有的嚎叫声。我打算把它靠到他耳边……没有人能在这么刺耳的声音下睡觉，就算是沉睡者也不例外。”~
@97301 = ~“噢，那只是导师的手段而已。她把沉睡者变成了那些死板的朝圣者的信仰，而那五个秘密就成了一种入门的仪式。”~
@97302 = ~“噢，你可以在这北边的神殿中靠近沉睡者的地方找到她。导师把这些愠怒的朝圣者带到这个地方来。我想他们可能根本就不懂得幽默。”~
@97303 = ~“你真笨，你是个白痴吗？好吧，有些人就是这么笨，其他人可不会向别人解释这些事情。在位面中解释‘在哪里’是个困难的问题。”~
@97304 = ~“抬头看看，说不定通往混沌海的道路就在我们头上某个地方。又或者，如果你一直向东走的话，就能到那里。混沌海可能刚好穿过树林中的这个小洞，也可能只是一种看待事物的不同方式。”~
@97305 = ~“谁不想？看起来唯一愿意留下来的就是那些魔鬼自己了，而它们中的绝大多数也是因为被更强大的怪物所胁迫。朋友，欢迎来到亡魂之城。”~
@97306 = ~“位面可不能那样理解，白痴。你这么做真是疯了。最好的建议就是放任它们，学会接受位面的本质。当你这么做的时候，就能够变聪明点了。”~
@97307 = ~“你没长眼睛吗？酒馆里满是这种人！他们皮肤灰白，脸色阴郁，说话声低沉而且极度虔诚，那个愚蠢的女孩——导师要把他们所有人带到九渊地狱的深处去。而这一切都打着沉睡者的名号。”~
@97308 = ~这个长着角的人吐了口唾沫，使劲理了理手中的牌。“如果你想问有关沉睡者的问题，就去找导师。我已经洗手不干了。”~
@97309 = ~“这只是个善意的玩笑。这些愠怒的朝圣者总是说什么‘沉睡者这’‘沉睡者那’的。我的骨头就开始痒痒，想把那老家伙弄醒。”~
@97310 = ~“不要说了，要是导师听到风声的话，她会不高兴的。”~
@97311 = ~“噢，一位老吟游诗人沿路收集了些小玩意。有一位印记城的乐器师制作了一个喇叭，那上面有一个和万魔殿相连的小通道……”~
@97312 = ~“把你的嘴唇放在上面，往里面吹气，你可以吹出那些疯狂地方所有的嚎叫声。我打算把它靠到他耳边……没有人能在这么刺耳的声音下睡觉，就算是沉睡者也不例外。”~
@97313 = ~“噢，你可以在这北边的神殿中靠近沉睡者的地方找到她。导师把这些愠怒的朝圣者带到这个地方来。我想他们可能根本就不懂得幽默。”~
@97314 = ~“那是最近的事情。”牌局重新开始之前洗牌声暂时变慢了。“我和导师进行了一次小格斗。”~
@97315 = ~“噢，你可以在这北边的神殿中靠近沉睡者的地方找到她。导师把这些愠怒的朝圣者带到这个地方来。我想他们可能根本就不懂得幽默。”~
@97316 = ~“你没长眼睛吗？酒馆里满是这种人！他们皮肤灰白，脸色阴郁，说话声低沉而且极度虔诚，那个愚蠢的女孩——导师要把他们所有人带到九渊地狱的深处去。而这一切都打着沉睡者的名号。”~
@97317 = ~这个长着角的人吐了口唾沫，不停地摆弄着手上的牌。“如果你想问有关沉睡者的问题，就去找导师。我已经洗手不干了。”~
@97318 = ~“这只是个善意的玩笑。这些愠怒的朝圣者总是说什么‘沉睡者这’‘沉睡者那’的。我的骨头就开始痒痒，想把那老家伙弄起来。”~
@97319 = ~“不要说了，要是导师听到风声的话，她会不高兴的。”~
@97320 = ~“噢，一位老吟游诗人沿路收集了些小玩意。有一位印记城的乐器师制作了一个喇叭，那上面有一个和万魔殿相连的小通道……”~
@97321 = ~“把你的嘴唇放在上面，往里面吹气，你可以吹出那些疯狂地方所有的嚎叫声。我打算把它靠到他耳边……没有人能在这么刺耳的声音下睡觉，就算是沉睡者也不例外。”~
@97322 = ~他停止了洗牌，让这副牌顺手滑进了他的口袋里，然后又拿出了另一副。“傻子，没什么东西会是免费的，导师像猎鹰一样监视着我，所以我似乎是没有机会用它了……”~
@97323 = ~“作为这场小消遣的报偿，我可以让你拿走那个该死的东西。你有兴趣吗？”~
@97324 = ~“当然，当然。尽管问问题。头脑放清醒点。”~
@97325 = ~“好吧，我教你个小牌技。我让你洗这副牌，之后从里面抽一张出来。你可以问五个‘是或不是’的问题，然后要猜出这张牌来。”~
@97326 = ~“Ａ最小，Ｋ最大，除了我以外没有小丑，明白了吗？”~
@97327 = ~“当然了。这只是个很简单的小牌技。我让你洗这副牌，之后从里面抽一张出来。你可以问五个‘是或不是’的问题，然后要猜出这张牌来。”~
@97328 = ~“还有一件事。让我们来下赌注：把你口袋里的东西放到桌上来。我会让你知道什么时候够了。如果你赢了，你可以把除了号角之外的其他东西拿回去。要是你输了，桌上的东西就都归我了，然后我们再来一局。”~
@97329 = ~“我就只玩这东西。如果你不喜欢，就不要来玩这个游戏。如果你想通了，再来问我有关号角的事情。”~
@97330 = ~老人一把抓过你的财产，咬了咬金币，然后借着昏暗的灯光瞥了瞥其他的东西。最后，又把注意力转回到你身上……~
@97331 = ~“很完美。”他盯着你洗牌。然后自信地一笑，抽出了一张牌。~
@97332 = ~“好的，但这是懦夫的行为，傻子。”你看着这个老吟游诗人把桌上的东西都扫进自己了自己的背包里。~
@97333 = ~“行了，别再问了。继续继续，好好来猜一猜，傻瓜。你觉得这张牌是什么？”~
@97334 = ~这个泰夫林在等你提问的时候，摆弄着桌上的物品。看起来他对你下的赌注很满意。~
@97335 = ~这个老人看起来心烦意乱，对你的深思熟虑感到很厌烦。~
@97336 = ~当你在思考该问什么问题的时候，这个泰夫林的脸上露出了狡猾的笑容。~
@97337 = ~你的对手重重地叹了口气，调整了一下自己的座位。~
@97338 = ~“不。”~
@97339 = ~“不。”~
@97340 = ~“不。”~
@97341 = ~“对。”~
@97342 = ~“对。”~
@97343 = ~“对。”~
@97344 = ~“行了，别再问了。继续继续，好好来猜一猜，傻瓜。你觉得这张牌是什么？”~
@97345 = ~这个老吟游诗人小心地使自己的脸看起来毫无表情。你觉得自己并不是第一个和他玩这个游戏的人。~
@97346 = ~“错了，我的朋友。不对，不对，不对。”他把牌面朝下扣在桌子上，牌忽然烧成灰烬消失不见了。他把你的赌注扫进自己的背包里。“准备好再来一次了吗？”~
@97347 = ~他突然一阵大笑，伸手过来拍了拍你的背。“干得好，我的朋友，干得好！把桌上的东西都拿走吧，这个喇叭也拿去！你在这方面会干得很好的。”~
@97348 = ~他拍了拍手，手指间突然出现了一副新牌。他在向你眨了一眼之后，就开始忙着洗牌了。~
@97349 = ~一滴汗顺着老人的眉毛流了下来。“嘿，再来最后一盘，怎么样？”~
@97350 = ~“现在只剩两个问题了。继续吧。”~
@97351 = ~“你还剩三个问题了，好好利用。”~
@97352 = ~这个老泰夫林自己笑了笑，然后摇了摇头。“加快点速度，傻子。你还剩四个问题。”~
@97353 = ~“这么说吧，小<MANWOMAN>。那还差得远。我正在找和桌子上那5,000金币类似的东西。”~
@97354 = ~“那比我期望的5,000金币的赌注要高呢。如果你想把桌上的什么东西拿走，我不会拦你的……”~
@97355 = ~“我是来地狱里度假的，傻子。我才不会怕。”他笑得令你很放心，然后抽了一张牌出来。~
@97356 = ~“没错，我们被称作泰夫林，傻子。恶魔和魔鬼还是和平常一样，而说实话，我觉得我们大多数人都有恶魔血统。如果你理解了我说的话，你就知道，天使不会经常来这里的。”~
@97357 = ~“我……我的真名！你怎么会知道的！？啊，我觉得我的灵魂快被吸出来了……你想从我这里得到什么，你这个恶魔？”~
@97358 = ~“是……是的，当然。其他的问题！我能帮上什么忙？”~
@97359 = ~“<LADYLORD>，如果那就是你要寻找的名望，我可以给你的。阿顿·斯维菲特会从今天开始直到我死去的那一天，都为你提供吟游诗人的服务……还需要我为你做什么吗？”~
@97360 = ~“是 毁灭卡蒂思维特？好，我也要让诸神和那个该死的酒馆老板看看……”~
@97361 = ~“我赢的东西？该死，那么都拿去吧！都说来得容易，去的也快啊……你还想要些什么，<LADYLORD>？”~
@97362 = ~这个吟游诗人向你眨了眨眼，然后继续洗牌。他想对另一位顾客使眼色，显然他不想再和你多说话了。~
@97363 = ~当你接近的时候，这个老泰夫林没有再洗手中的牌，而是高声地对着你笑。~
@97364 = ~一位偶然遇见吉斯泽莱朝圣者的男性泰夫林。可以在地狱吐息酒馆里找到他。~
@97365 = ~“再见。”~
@97366 = ~“你知道收割者的真名吗？”~
@97367 = ~“它不值钱。”~
@97368 = ~“这里有10,000个金币。”~
@97369 = ~“这里有50,000个金币。”~
@97370 = ~“这里有100,000个金币。”~
@97371 = ~“这里有250,000个金币。”~
@97372 = ~“我把我所有的东西都给你。”~
@97373 = ~“你为什么要说谎，你这个小偷！”[攻击]~
@97374 = ~“我想试着领会沉睡者的五个秘密。”~
@97375 = ~“看，关于这几个秘密，你能不能帮我呢？”~
@97376 = ~“你在某些事情上和导师有相反的意见？”~
@97377 = ~“你说的是什么样的格斗？”~
@97378 = ~“这只是方便起见，仅此而已。”~
@97379 = ~“这不是什么可大可小的事情。这是信仰的问题。”~
@97380 = ~“求你了，我必须要领会这五个秘密。”~
@97381 = ~“你是怎么领悟出这个秘密的？”~
@97382 = ~“你向诸界智者询问过什么事情吗？”~
@97383 = ~“你为什么会来到这一层？”~
@97384 = ~“你和他们一块儿旅行了多久？”~
@97385 = ~“他在找谁？”~
@97386 = ~“导师是谁？”~
@97387 = ~“你是怎么领悟出这个秘密的？”~
@97388 = ~“你向诸界智者询问过什么事情吗？”~
@97389 = ~“沉睡者？”~
@97390 = ~“导师是谁？”~
@97391 = ~“洗手不干什么？”~
@97392 = ~“导师是谁？”~
@97393 = ~“你打算怎么弄醒沉睡者？”~
@97394 = ~“第四个秘密是什么？”~
@97395 = ~“导师是谁？”~
@97396 = ~“混沌海在哪里？”~
@97397 = ~“我只想要一条离开卡尼亚的路。”~
@97398 = ~“我不明白。”~
@97399 = ~“朝圣者？”~
@97400 = ~“回到我其他的问题上。”~
@97401 = ~“沉睡者？”~
@97402 = ~“洗手不干什么？”~
@97403 = ~“你打算怎么弄醒沉睡者？”~
@97404 = ~“导师是谁？”~
@97405 = ~“你的角是怎么了？”~
@97406 = ~“你角的破碎看起来还很新。”~
@97407 = ~“你说的是什么样的格斗？”~
@97408 = ~“导师是谁？”~
@97409 = ~“朝圣者？”~
@97410 = ~“沉睡者？”~
@97411 = ~“洗手不干什么？”~
@97412 = ~“你打算怎么弄醒沉睡者？”~
@97413 = ~“我能借一下你的喇叭吗？”~
@97414 = ~“现在不行。我还有几个问题。”~
@97415 = ~“好吧，告诉我怎么玩。”~
@97416 = ~“你能重复一遍玩法吗？”~
@97417 = ~“听起来挺简单。开始吧。”~
@97418 = ~“我不喜欢这个玩法。”~
@97419 = ~“当然，我会让你知道我何时下了注。”~
@97420 = ~“我不玩了。再见。”~
@97421 = ~“问题问够了吧。我要玩牌了。”~
@97422 = ~“它的牌点大于……”~
@97423 = ~“Q？”~
@97424 = ~“J？”~
@97425 = ~“10？”~
@97426 = ~“9？”~
@97427 = ~“8？”~
@97428 = ~“7？”~
@97429 = ~“6？”~
@97430 = ~“5？”~
@97431 = ~“4？”~
@97432 = ~“3？”~
@97433 = ~“2？”~
@97434 = ~“A？”~
@97435 = ~“它的牌点是……”~
@97436 = ~“K？”~
@97437 = ~“Q？”~
@97438 = ~“J？”~
@97439 = ~“10？”~
@97440 = ~“9？”~
@97441 = ~“8？”~
@97442 = ~“7？”~
@97443 = ~“6？”~
@97444 = ~“5？”~
@97445 = ~“4？”~
@97446 = ~“3？”~
@97447 = ~“2？”~
@97448 = ~“A？”~
@97449 = ~“它是哪种花色的……”~
@97450 = ~选择另外一个问题。~
@97451 = ~“方块？”~
@97452 = ~“红桃？”~
@97453 = ~“黑桃？”~
@97454 = ~“草花？”~
@97455 = ~“是一张偶数的牌吗？”~
@97456 = ~“是一张人头牌吗？”~
@97457 = ~“是一张黑色的牌吗？”~
@97458 = ~“一张K……”~
@97459 = ~“一张Q……”~
@97460 = ~“一张J……”~
@97461 = ~“一张10……”~
@97462 = ~“一张9……”~
@97463 = ~“一张8……”~
@97464 = ~“一张7……”~
@97465 = ~“一张6……”~
@97466 = ~“一张5……”~
@97467 = ~“一张4……”~
@97468 = ~“一张3……”~
@97469 = ~“一张2……”~
@97470 = ~“一张A……”~
@97471 = ~“方块。”~
@97472 = ~“红桃。”~
@97473 = ~“黑桃。”~
@97474 = ~“草花。”~
@97475 = ~“好的。你要知道，我已经换了赌注了。”~
@97476 = ~“怕了吗，老头？继续，挑一张牌。”~
@97477 = ~“我知道玩法。我会让你知道我何时下了注。”~
@97478 = ~“恶魔的血统？”~
@97479 = ~“你打算把这个地方烧光吗？”~
@97480 = ~“所以，关于你弄醒沉睡者的那个计划……”~
@97481 = ~“毁灭卡蒂思维特……”~
@97482 = ~“回到我其他的问题上。”~
@97483 = ~“写下一首关于我的传奇诗篇，让它在位面间传诵。”~
@97484 = ~“我想你该和酒馆主人打一架了。”~
@97485 = ~“把你的战利品都给我。”~
@97486 = ~离开。~
@97487 = ~“好吧。它们本身其实没什么价值，而且很容易制作。我手里总是会留些给新加入的朝圣者。”~
@97488 = ~“在吉斯泽莱人当中，各种各样的水晶是用来集中和增幅他人的思想的，使他们更容易阅读。但我不知道对你是不是也能起作用。”~
@97489 = ~“只要把它带在脖子上，就能让你接触到沉睡者。运气好的话，你还能看见他的梦境。”~
@97490 = ~导师在你靠近时露出了微笑，但她仍在闭目冥想。在你的脑海中，你感觉到她同意了你开口说话。~
@97491 = ~“在新来的朝圣者能够看到沉睡者之前，他们必须要解开他的五个秘密：他是谁？他从哪里来？他为什么离开？他在寻找谁？答案是什么？”~
@97492 = ~“所有来看沉睡者的人，都可以说是生命旅程上的朝圣者。像他一样，我们在位面间旅行，不停地寻求解答。像他一样，我们总有一天会找到的。”~
@97493 = ~“那有无数条道路：法术，入口，漩涡，雾气和阴影间的转换。不过并不是在所有的地方都适用。在卡尼亚这个地方，只有两条道：传送门和冥河分支。”~
@97494 = ~“只要和收割者进行了绑定，传送门就可以通到任何地方。但是冥河分支一直往下流，通到巴托地狱的第九重，也就是最后一层——奈瑟斯。我没去过那里，也不想去那里。”~
@97495 = ~“我不能说，那超出界限了，就像靡菲斯特用真名把他和你的意志绑定在一起那样。也许沉睡者以前知道。但是当他梦到了答案的时候，我和我的朝圣者们已经被困在这里了，就像你一样。”~
@97496 = ~“沉睡者会梦见许多事情，这时，我就能看见在他思想表面上浮现着的那些梦境。对于他的秘密，我大多数是通过梦境了解到的。”~
@97497 = ~“他的梦形成了我信仰的原则，使我和我的朝圣者们更接近我们的教化。通过他的梦境，我了解到了沉睡者的五个秘密……”~
@97498 = ~“他是谁？他从哪里来？他为什么离开？他在寻找谁？答案是什么？……所有想看到沉睡者的人必须先解开这五个秘密。”~
@97499 = ~“这个传说是从何处开始，又会到哪里结束呢？这无数的位面都是变化无穷的。这些都无法形容；他们肯定是活着的。”~
@97500 = ~“我出身的修道院位于混沌海，它漂浮在一个水球中，而水球绕着一个不断变化的大石块运转，石块上有着无尽生死往复着的森林。有什么词语能够清楚地描绘出来呢？”~
@97501 = ~“很高兴遇到你这么一个好问的人。就像沉睡者教导的那样，在得到解答之前，你肯定会不停地发问。那么现在你想知道什么？”~
@97502 = ~“我是一名吉斯泽莱导师。我一生都在努力训练自己阅读他人表面意识的能力。”~
@97503 = ~“很高兴遇到你这么一个好问的人。就像沉睡者教导的那样，在得到解答之前，你肯定会不停地发问。那么现在你想知道什么？”~
@97504 = ~“很久以前，我们也曾经是人类。夺心魔建立了一个跨越诸位面的帝国，在他们恶毒的命令之下，我们当了无数个世纪的奴隶。”~
@97505 = ~“我们渐渐地适应了。我们的皮肤由于缺乏日晒而变成了灰色，为了能够抵受拷打而变得坚韧。他们控制着我们的精神并且教养我们。时间一长，我们的精神就都同化了。”~
@97506 = ~“慢慢地，我们懂得了如何防御他们的精神探测，有一小撮人因此而脱离了他们的掌控。一位名叫吉斯的英雄揭竿而起，最终推翻了他们的压迫。”~
@97507 = ~“我们和吉斯彦克人都是那些叛乱者的嫡亲后代。不过有一次发生了某件事情，导致了我们和吉斯彦克人之间的分裂。”~
@97508 = ~“吉斯彦克人主要生活在星界，而虽然有些吉斯泽莱人像我一样住在混沌海位面上的修道院里，但大部分还是在更远的地方旅行。”~
@97509 = ~“那有无数条道路：法术，入口，漩涡，雾气和阴影间的转换。不过并不是在所有的地方都适用。在卡尼亚这个地方，只有两条道：传送门和冥河分支。”~
@97510 = ~“只要和收割者进行了绑定，传送门就可以通到任何地方。但是冥河分支一直往下流，通到巴托地狱的第九重，也就是最后一层——奈瑟斯。我没去过那里，也不想去那里。”~
@97511 = ~“我不能说，那超出界限了，就像靡菲斯特用真名把他和你的意志绑定在一起那样。也许沉睡者以前知道。但是当他梦到了答案的时候，我和我的朝圣者们已经被困在这里了，就像你一样。”~
@97512 = ~“沉睡者会梦见许多事情，这时，我就能看见在他思想表面上浮现着的那些梦境。对于他的秘密，我大多数是通过梦境了解到的。”~
@97513 = ~“他的梦形成了我信仰的原则，使我和我的朝圣者们更接近我们的教化。通过他的梦境，我了解到了沉睡者的五个秘密……”~
@97514 = ~“他是谁？他从哪里来？他为什么离开？他在寻找谁？答案是什么？……所有想看到沉睡者的人必须先解开这五个秘密。”~
@97515 = ~“这个传说是从何处开始，又会到哪里结束呢？这无数的位面都是变化无穷的。这些都无法形容；他们肯定是活着的。”~
@97516 = ~“我出身的修道院位于混沌海，它漂浮在一个水球中，而水球绕着一个不断变化的大石块运转，石块上有着无尽生死往复着的森林。有什么词语能够清楚地描绘出来呢？”~
@97517 = ~“作为精神、肉体和灵魂上的大师，我们的导师教给我们吉斯泽莱人更高的智慧，使我们能够战胜敌人。尽管有些偏差，不过在你们的语言里，我们应该可以称作武僧。”~
@97518 = ~“我们吉斯泽莱人力争成为爱好和平的人，而且在努力寻找和平的过程中把自己和其他人隔绝开来。”~
@97519 = ~“但是我们的兄弟——吉斯彦克人一直在狩猎我们，而且我们也决不会原谅把我们变为奴隶的夺心魔。但是比较矛盾的一点是，如果不是因为夺心魔，我们也不会存在。”~
@97520 = ~“勉强来说……你的思想就像是一个巨大的图书馆，而我可以触摸到那些书卷的书脊。我能读出它们的标题，猜出大概的内容，但事实上并不能真的读到和记下里面的内容。”~
@97521 = ~“尽管它的能力有限，但正因为有了我珍爱的这项天赋，才能够一个标题一个标题，一道书脊一道书脊地了解到沉睡者的智慧。我就是通过这项天赋才接触到他的梦境的。”~
@97522 = ~“那有无数条道路：法术，入口，漩涡，雾气和阴影间的转换。不过并不是在所有的地方都适用。在卡尼亚这个地方，只有两条道：传送门和冥河分支。”~
@97523 = ~“只要和收割者进行了绑定，传送门就可以通到任何地方。但是冥河分支一直往下流，通到巴托地狱的第九重，也就是最后一层——奈瑟斯。我没去过那里，也不想去那里。”~
@97524 = ~“我不能说，那超出界限了，就像靡菲斯特用真名把他和你的意志绑定在一起那样。也许沉睡者以前知道。但是当他梦到了答案的时候，我和我的朝圣者们已经被困在这里了，就像你一样。”~
@97525 = ~“沉睡者会梦见许多事情，这时，我就能看见在他思想表面上浮现着的那些梦境。对于他的秘密，我大多数是通过梦境了解到的。”~
@97526 = ~“他的梦形成了我信仰的原则，使我和我的朝圣者们更接近我们的教化。通过他的梦境，我了解到了沉睡者的五个秘密……”~
@97527 = ~“他是谁？他从哪里来？他为什么离开？他在寻找谁？答案是什么？……所有想看到沉睡者的人必须先解开这五个秘密。”~
@97528 = ~“这个传说是从何处开始，又会到哪里结束呢？这无数的位面都是变化无穷的。这些都无法形容；他们肯定是活着的。”~
@97529 = ~“我出身的修道院位于混沌海，它漂浮在一个水球中，而水球绕着一个不断变化的大石块运转，石块上有着无尽生死往复着的森林。有什么词语能够清楚地描绘出来呢？”~
@97530 = ~“为什么我们这些人要远离家乡旅行到这里来？我想这可能就是沉睡者的第三个秘密。你必须要亲自来解答。”~
@97531 = ~“就像卡尼亚是许多魔鬼的家乡一样，它也是许多天使的家乡，比如从低阶的神使到强大的使徒、异界神侍乃至炽天神侍。”~
@97532 = ~“来自许多地方。有人说天使们就在我们的身边，即使在这个地方也有。而沉睡者来自哪里，是他的第二个秘密，你必须亲自解开它。”~
@97533 = ~“在新来的朝圣者能够看到沉睡者之前，他们必须要解开他的五个秘密：他是谁？他从哪里来？他为什么离开？他在寻找谁？答案是什么？”~
@97534 = ~“很高兴遇到你这么一个好问的人。就像沉睡者教导的那样，在得到解答之前，你肯定会不停地发问。那么现在你想知道什么？”~
@97535 = ~“既然你问了，我就会回答的。记好了，这是沉睡者的第一个秘密……他是一名来自天界的异界神侍，一个善良的生物。和你我一样，他也是一名朝圣者，一直在位面间旅行。”~
@97536 = ~“很高兴遇到你这么一个好问的人。就像沉睡者教导的那样，在得到解答之前，你肯定会不停地发问。那么现在你想知道什么？”~
@97537 = ~“我是一名吉斯泽莱导师。我一生都在努力训练自己阅读他人表面意识的能力。”~
@97538 = ~“很高兴遇到你这么一个好问的人。就像沉睡者教导的那样，在得到解答之前，你肯定会不停地发问。那么现在你想知道什么？”~
@97539 = ~“很久以前，我们也曾经是人类。夺心魔建立了一个跨越诸位面的帝国，在他们恶毒的命令之下，我们当了无数个世纪的奴隶。”~
@97540 = ~“我们渐渐地适应了。我们的皮肤由于缺乏日晒而变成了灰色，为了能够抵受拷打而变得坚韧。他们控制着我们的精神并且教养我们。时间一长，我们的精神就都同化了。”~
@97541 = ~“慢慢地，我们懂得了如何防御他们的精神探测，有一小撮人因此而脱离了他们的掌控。一位名叫吉斯的英雄揭竿而起，最终推翻了他们的压迫。”~
@97542 = ~“我们和吉斯彦克人都是那些叛乱者的嫡亲后代。不过有一次发生了某件事情，导致了我们和吉斯彦克人之间的分裂。”~
@97543 = ~“吉斯彦克人主要生活在星界，而虽然有些吉斯泽莱人像我一样住在混沌海位面上的修道院里，但大部分还是在更远的地方旅行。”~
@97544 = ~“那有无数条道路：法术，入口，漩涡，雾气和阴影间的转换。不过并不是在所有的地方都适用。在卡尼亚这个地方，只有两条道：传送门和冥河分支。”~
@97545 = ~“只要和收割者进行了绑定，传送门就可以通到任何地方。但是冥河分支一直往下流，通到巴托地狱的第九重，也就是最后一层——奈瑟斯。我没去过那里，也不想去那里。”~
@97546 = ~“我不能说，那超出界限了，就像靡菲斯特用真名把他和你的意志绑定在一起那样。也许沉睡者以前知道。但是当他梦到了答案的时候，我和我的朝圣者们已经被困在这里了，就像你一样。”~
@97547 = ~“沉睡者会梦见许多事情，这时，我就能看见在他思想表面上浮现着的那些梦境。对于他的秘密，我大多数是通过梦境了解到的。”~
@97548 = ~“他的梦形成了我信仰的原则，使我和我的朝圣者们更接近我们的教化。通过他的梦境，我了解到了沉睡者的五个秘密……”~
@97549 = ~“他是谁？他从哪里来？他为什么离开？他在寻找谁？答案是什么？……所有想看到沉睡者的人必须先解开这五个秘密。”~
@97550 = ~“这个传说是从何处开始，又会到哪里结束呢？这无数的位面都是变化无穷的。这些都无法形容；他们肯定是活着的。”~
@97551 = ~“我出身的修道院位于混沌海，它漂浮在一个水球中，而水球绕着一个不断变化的大石块运转，石块上有着无尽生死往复着的森林。有什么词语能够清楚地描绘出来呢？”~
@97552 = ~“作为精神、肉体和灵魂上的大师，我们的导师教给我们吉斯泽莱人更高的智慧，使我们能够战胜敌人。尽管有些偏差，不过在你们的语言里，我们应该可以称作武僧。”~
@97553 = ~“我们吉斯泽莱人力争成为爱好和平的人，而且在努力寻找和平的过程中把自己和其他人隔绝开来。”~
@97554 = ~“但是我们的兄弟——吉斯彦克人一直在狩猎我们，而且我们也决不会原谅把我们变为奴隶的夺心魔。但是比较矛盾的一点是，如果不是因为夺心魔，我们也不会存在。”~
@97555 = ~“勉强来说……你的思想就像是一个巨大的图书馆，而我可以触摸到那些书卷的书脊。我能读出它们的标题，猜出大概的内容，但事实上并不能真的读到和记下里面的内容。”~
@97556 = ~“尽管它的能力有限，但正因为有了我珍爱的这项天赋，才能够一个标题一个标题，一道书脊一道书脊地了解到沉睡者的智慧。我就是通过这项天赋才接触到他的梦境的。”~
@97557 = ~“那有无数条道路：法术，入口，漩涡，雾气和阴影间的转换。不过并不是在所有的地方都适用。在卡尼亚这个地方，只有两条道：传送门和冥河分支。”~
@97558 = ~“只要和收割者进行了绑定，传送门就可以通到任何地方。但是冥河分支一直往下流，通到巴托地狱的第九重，也就是最后一层——奈瑟斯。我没去过那里，也不想去那里。”~
@97559 = ~“我不能说，那超出界限了，就像靡菲斯特用真名把他和你的意志绑定在一起那样。也许沉睡者以前知道。但是当他梦到了答案的时候，我和我的朝圣者们已经被困在这里了，就像你一样。”~
@97560 = ~“沉睡者会梦见许多事情，这时，我就能看见在他思想表面上浮现着的那些梦境。对于他的秘密，我大多数是通过梦境了解到的。”~
@97561 = ~“他的梦形成了我信仰的原则，使我和我的朝圣者们更接近我们的教化。通过他的梦境，我了解到了沉睡者的五个秘密……”~
@97562 = ~“他是谁？他从哪里来？他为什么离开？他在寻找谁？答案是什么？……所有想看到沉睡者的人必须先解开这五个秘密。”~
@97563 = ~“这个传说是从何处开始，又会到哪里结束呢？这无数的位面都是变化无穷的。这些都无法形容；他们肯定是活着的。”~
